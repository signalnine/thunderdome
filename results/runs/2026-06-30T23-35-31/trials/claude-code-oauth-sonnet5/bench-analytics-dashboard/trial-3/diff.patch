+import { Router, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { asyncHandler, ValidationError, NotFoundError } from '../errors';
+import { AuthenticatedRequest } from '../types';
+
+const router = Router();
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function serializeDashboard(row: DashboardRow) {
+  return { ...row, config: JSON.parse(row.config) as unknown };
+}
+
+function serializeWidget(row: WidgetRow) {
+  return { ...row, config: JSON.parse(row.config) as unknown };
+}
+
+function getOwnedDashboard(dashboardId: string, tenantId: string): DashboardRow {
+  const db = getDb();
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(dashboardId, tenantId) as DashboardRow | undefined;
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return dashboard;
+}
+
+router.post(
+  '/',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { id: ownerId, tenantId } = req.user!;
+    const { name, config } = req.body as Record<string, unknown>;
+    if (typeof name !== 'string' || name.length === 0) {
+      throw new ValidationError('name is required');
+    }
+
+    const db = getDb();
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, tenantId, name, ownerId, JSON.stringify(config ?? {}));
+
+    const dashboard = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+    res.status(201).json(serializeDashboard(dashboard));
+  })
+);
+
+router.get(
+  '/',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const db = getDb();
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC')
+      .all(tenantId) as DashboardRow[];
+    res.status(200).json(rows.map(serializeDashboard));
+  })
+);
+
+router.get(
+  '/:id',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const dashboard = getOwnedDashboard(req.params.id, tenantId);
+    const db = getDb();
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(dashboard.id) as WidgetRow[];
+    res.status(200).json({ ...serializeDashboard(dashboard), widgets: widgets.map(serializeWidget) });
+  })
+);
+
+router.patch(
+  '/:id',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const dashboard = getOwnedDashboard(req.params.id, tenantId);
+    const { name, config } = req.body as Record<string, unknown>;
+
+    const newName = typeof name === 'string' ? name : dashboard.name;
+    const newConfig = config !== undefined ? JSON.stringify(config) : dashboard.config;
+
+    const db = getDb();
+    db.prepare(
+      "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?"
+    ).run(newName, newConfig, dashboard.id);
+
+    const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(dashboard.id) as DashboardRow;
+    res.status(200).json(serializeDashboard(updated));
+  })
+);
+
+router.delete(
+  '/:id',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const dashboard = getOwnedDashboard(req.params.id, tenantId);
+    const db = getDb();
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+    res.status(204).send();
+  })
+);
+
+router.post(
+  '/:id/widgets',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const dashboard = getOwnedDashboard(req.params.id, tenantId);
+    const {
+      type,
+      config,
+      position_x: positionX,
+      position_y: positionY,
+      width,
+      height,
+    } = req.body as Record<string, unknown>;
+
+    if (typeof type !== 'string' || !WIDGET_TYPES.includes(type)) {
+      throw new ValidationError(`type must be one of ${WIDGET_TYPES.join(', ')}`);
+    }
+
+    const db = getDb();
+    const id = uuidv4();
+    db.prepare(
+      `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+    ).run(
+      id,
+      dashboard.id,
+      type,
+      JSON.stringify(config ?? {}),
+      typeof positionX === 'number' ? positionX : 0,
+      typeof positionY === 'number' ? positionY : 0,
+      typeof width === 'number' ? width : 1,
+      typeof height === 'number' ? height : 1
+    );
+
+    const widget = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+    res.status(201).json(serializeWidget(widget));
+  })
+);
+
+router.delete(
+  '/:id/widgets/:widgetId',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const dashboard = getOwnedDashboard(req.params.id, tenantId);
+    const db = getDb();
+    const result = db
+      .prepare('DELETE FROM widgets WHERE id = ? AND dashboard_id = ?')
+      .run(req.params.widgetId, dashboard.id);
+    if (result.changes === 0) {
+      throw new NotFoundError('Widget not found');
+    }
+    res.status(204).send();
+  })
+);
+
+export default router;
