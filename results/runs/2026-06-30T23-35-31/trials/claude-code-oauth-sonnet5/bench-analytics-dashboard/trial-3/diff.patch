@@ -0,0 +1,109 @@
+import { Router, Response } from 'express';
+import { getDb } from '../db';
+import { asyncHandler, ValidationError, NotFoundError } from '../errors';
+import { AuthenticatedRequest } from '../types';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function csvEscape(value: unknown): string {
+  const str = value === null || value === undefined ? '' : String(value);
+  if (/[",\n]/.test(str)) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+router.get(
+  '/events',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const format = typeof req.query.format === 'string' ? req.query.format : 'json';
+    if (format !== 'json' && format !== 'csv') {
+      throw new ValidationError('format must be either json or csv');
+    }
+
+    const db = getDb();
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+      .all(tenantId) as EventRow[];
+
+    if (format === 'json') {
+      res
+        .status(200)
+        .json(rows.map((row) => ({ ...row, properties: JSON.parse(row.properties) as unknown })));
+      return;
+    }
+
+    const columns: (keyof EventRow)[] = [
+      'id',
+      'tenant_id',
+      'name',
+      'properties',
+      'timestamp',
+      'user_id',
+      'session_id',
+    ];
+    const lines = [columns.join(',')];
+    for (const row of rows) {
+      lines.push(columns.map((col) => csvEscape(row[col])).join(','));
+    }
+
+    res.status(200).set('Content-Type', 'text/csv').send(lines.join('\n'));
+  })
+);
+
+router.get(
+  '/dashboard/:id',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const db = getDb();
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, tenantId) as DashboardRow | undefined;
+    if (!dashboard) {
+      throw new NotFoundError('Dashboard not found');
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(dashboard.id) as WidgetRow[];
+
+    res.status(200).json({
+      dashboard: { ...dashboard, config: JSON.parse(dashboard.config) as unknown },
+      widgets: widgets.map((widget) => ({ ...widget, config: JSON.parse(widget.config) as unknown })),
+    });
+  })
+);
+
+export default router;
