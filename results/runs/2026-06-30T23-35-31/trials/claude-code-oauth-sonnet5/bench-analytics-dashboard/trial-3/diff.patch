@@ -0,0 +1,146 @@
+import { Router, Response } from 'express';
+import { getDb } from '../db';
+import { asyncHandler, ValidationError } from '../errors';
+import { AuthenticatedRequest } from '../types';
+
+const router = Router();
+
+function requireString(value: unknown, field: string): string {
+  if (typeof value !== 'string' || value.length === 0) {
+    throw new ValidationError(`${field} is required`);
+  }
+  return value;
+}
+
+router.post(
+  '/count',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const { event_name: eventName, start, end } = req.body as Record<string, unknown>;
+    requireString(eventName, 'event_name');
+
+    const db = getDb();
+    let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+    const params: unknown[] = [tenantId, eventName];
+    if (typeof start === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (typeof end === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    const row = db.prepare(sql).get(...params) as { count: number };
+    res.status(200).json({ count: row.count });
+  })
+);
+
+router.post(
+  '/timeseries',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const { event_name: eventName, bucket, start, end } = req.body as Record<string, unknown>;
+    requireString(eventName, 'event_name');
+
+    const bucketFormat =
+      bucket === 'hour' ? '%Y-%m-%dT%H:00:00Z' : bucket === 'month' ? '%Y-%m-01' : '%Y-%m-%d';
+
+    const db = getDb();
+    let sql = `SELECT strftime('${bucketFormat}', timestamp) as bucket, COUNT(*) as count
+      FROM events WHERE tenant_id = ? AND name = ?`;
+    const params: unknown[] = [tenantId, eventName];
+    if (typeof start === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (typeof end === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+    sql += ' GROUP BY bucket ORDER BY bucket ASC';
+
+    const rows = db.prepare(sql).all(...params) as { bucket: string; count: number }[];
+    res.status(200).json({ data: rows });
+  })
+);
+
+router.post(
+  '/breakdown',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const { event_name: eventName, property_key: propertyKey, start, end } = req.body as Record<
+      string,
+      unknown
+    >;
+    requireString(eventName, 'event_name');
+    requireString(propertyKey, 'property_key');
+
+    const db = getDb();
+    let sql = `SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count
+      FROM events WHERE tenant_id = ? AND name = ?`;
+    const params: unknown[] = [propertyKey, tenantId, eventName];
+    if (typeof start === 'string') {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (typeof end === 'string') {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+    sql += ' GROUP BY property_value ORDER BY count DESC';
+
+    const rows = db.prepare(sql).all(...params) as { property_value: unknown; count: number }[];
+    res.status(200).json({ data: rows });
+  })
+);
+
+interface FunnelEventRow {
+  name: string;
+  session_id: string;
+}
+
+router.post(
+  '/funnel',
+  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {
+    const { tenantId } = req.user!;
+    const { steps } = req.body as { steps?: unknown };
+
+    if (!Array.isArray(steps) || steps.length === 0 || !steps.every((s) => typeof s === 'string')) {
+      throw new ValidationError('steps must be a non-empty array of event names');
+    }
+
+    const stepNames = steps as string[];
+    const db = getDb();
+    const placeholders = stepNames.map(() => '?').join(', ');
+    const rows = db
+      .prepare(
+        `SELECT name, session_id FROM events
+         WHERE tenant_id = ? AND session_id IS NOT NULL AND name IN (${placeholders})
+         ORDER BY session_id ASC, timestamp ASC, rowid ASC`
+      )
+      .all(tenantId, ...stepNames) as FunnelEventRow[];
+
+    const sessionProgress = new Map<string, number>();
+    for (const row of rows) {
+      const current = sessionProgress.get(row.session_id) ?? 0;
+      if (current < stepNames.length && row.name === stepNames[current]) {
+        sessionProgress.set(row.session_id, current + 1);
+      }
+    }
+
+    const counts = stepNames.map((_name, index) => {
+      let count = 0;
+      for (const progress of sessionProgress.values()) {
+        if (progress > index) count += 1;
+      }
+      return count;
+    });
+
+    res.status(200).json({
+      steps: stepNames.map((name, index) => ({ name, count: counts[index] })),
+    });
+  })
+);
+
+export default router;
