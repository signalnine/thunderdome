ount\n      FROM events WHERE tenant_id = ? AND name = ?`;\n    const params: unknown[] = [tenantId, eventName];\n    if (typeof start === 'string') {\n      sql += ' AND timestamp >= ?';\n      params.push(start);\n    }\n    if (typeof end === 'string') {\n      sql += ' AND timestamp <= ?';\n      params.push(end);\n    }\n    sql += ' GROUP BY bucket ORDER BY bucket ASC';\n\n    const rows = db.prepare(sql).all(...params) as { bucket: string; count: number }[];\n    res.status(200).json({ data: rows });\n  })\n);\n\nrouter.post(\n  '/breakdown',\n  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {\n    const { tenantId } = req.user!;\n    const { event_name: eventName, property_key: propertyKey, start, end } = req.body as Record<\n      string,\n      unknown\n    >;\n    requireString(eventName, 'event_name');\n    requireString(propertyKey, 'property_key');\n\n    const db = getDb();\n    let sql = `SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count\n      FROM events WHERE tenant_id = ? AND name = ?`;\n    const params: unknown[] = [propertyKey, tenantId, eventName];\n    if (typeof start === 'string') {\n      sql += ' AND timestamp >= ?';\n      params.push(start);\n    }\n    if (typeof end === 'string') {\n      sql += ' AND timestamp <= ?';\n      params.push(end);\n    }\n    sql += ' GROUP BY property_value ORDER BY count DESC';\n\n    const rows = db.prepare(sql).all(...params) as { property_value: unknown; count: number }[];\n    res.status(200).json({ data: rows });\n  })\n);\n\ninterface FunnelEventRow {\n  name: string;\n  session_id: string;\n}\n\nrouter.post(\n  '/funnel',\n  asyncHandler<AuthenticatedRequest>(async (req, res: Response) => {\n    const { tenantId } = req.user!;\n    const { steps } = req.body as { steps?: unknown };\n\n    if (!Array.isArray(steps) || steps.length === 0 || !steps.every((s) => typeof s === 'string')) {\n      throw new ValidationError('steps must be a non-empty array 