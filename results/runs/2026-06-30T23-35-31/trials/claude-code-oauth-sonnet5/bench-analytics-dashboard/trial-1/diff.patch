onfig } = req.body ?? {};\n  if (!name) {\n    throw new ValidationError('name is required');\n  }\n\n  const db = getDb();\n  const id = uuidv4();\n  db.prepare(\n    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'\n  ).run(id, user.tenantId, name, user.id, JSON.stringify(config ?? {}));\n\n  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;\n  res.status(201).json(toPublicDashboard(row));\n});\n\nrouter.get('/', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const rows = getDb()\n    .prepare('SELECT * FROM dashboards WHERE tenant_id = ?')\n    .all(user.tenantId) as DashboardRow[];\n  res.status(200).json(rows.map(toPublicDashboard));\n});\n\nrouter.get('/:id', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const dashboard = getDashboardOr404(user.tenantId, req.params.id);\n  const widgets = getDb()\n    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')\n    .all(dashboard.id) as WidgetRow[];\n  res\n    .status(200)\n    .json({ ...toPublicDashboard(dashboard), widgets: widgets.map(toPublicWidget) });\n});\n\nrouter.patch('/:id', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const dashboard = getDashboardOr404(user.tenantId, req.params.id);\n  const { name, config } = req.body ?? {};\n\n  const db = getDb();\n  db.prepare(\n    \"UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?\"\n  ).run(\n    name ?? dashboard.name,\n    config !== undefined ? JSON.stringify(config) : dashboard.config,\n    dashboard.id\n  );\n\n  const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(dashboard.id) as DashboardRow;\n  res.status(200).json(toPublicDashboard(updated));\n});\n\nrouter.delete('/:id', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const dashboard = getDashboardOr404(user.tenantId, req.params.id);\n  getDb().prepare('DELETE FROM 