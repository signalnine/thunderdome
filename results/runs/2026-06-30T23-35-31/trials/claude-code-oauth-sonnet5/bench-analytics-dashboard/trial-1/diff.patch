ost('/', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const row = insertEvent(user.tenantId, req.body ?? {});\n  res.status(201).json(toPublicEvent(row));\n});\n\nrouter.post('/batch', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const { events } = req.body ?? {};\n  if (!Array.isArray(events) || events.length === 0) {\n    throw new ValidationError('events must be a non-empty array');\n  }\n\n  const rows = events.map((event: EventInput) => insertEvent(user.tenantId, event));\n  res.status(201).json({ inserted: rows.length, events: rows.map(toPublicEvent) });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1393,"cache_read_input_tokens":79645,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1393},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"55c4d885-47e7-4783-8cb0-9c8ac9430863","uuid":"a9ed2dcf-c636-430a-8686-9675a24429bd","request_id":"req_011CcaLvVFPygRh69xzfm92E"}
