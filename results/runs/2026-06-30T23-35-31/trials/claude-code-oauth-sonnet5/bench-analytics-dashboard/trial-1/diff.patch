@@ -0,0 +1,169 @@
+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { authMiddleware, getAuthUser } from '../auth';
+import { NotFoundError, ValidationError } from '../errors';
+
+const router = Router();
+router.use(authMiddleware);
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function toPublicDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: JSON.parse(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function toPublicWidget(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: JSON.parse(row.config),
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+function getDashboardOr404(tenantId: string, id: string): DashboardRow {
+  const row = getDb()
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+  if (!row) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return row;
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const { name, config } = req.body ?? {};
+  if (!name) {
+    throw new ValidationError('name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, user.tenantId, name, user.id, JSON.stringify(config ?? {}));
+
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+  res.status(201).json(toPublicDashboard(row));
+});
+
+router.get('/', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const rows = getDb()
+    .prepare('SELECT * FROM dashboards WHERE tenant_id = ?')
+    .all(user.tenantId) as DashboardRow[];
+  res.status(200).json(rows.map(toPublicDashboard));
+});
+
+router.get('/:id', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const dashboard = getDashboardOr404(user.tenantId, req.params.id);
+  const widgets = getDb()
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+  res
+    .status(200)
+    .json({ ...toPublicDashboard(dashboard), widgets: widgets.map(toPublicWidget) });
+});
+
+router.patch('/:id', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const dashboard = getDashboardOr404(user.tenantId, req.params.id);
+  const { name, config } = req.body ?? {};
+
+  const db = getDb();
+  db.prepare(
+    "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?"
+  ).run(
+    name ?? dashboard.name,
+    config !== undefined ? JSON.stringify(config) : dashboard.config,
+    dashboard.id
+  );
+
+  const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(dashboard.id) as DashboardRow;
+  res.status(200).json(toPublicDashboard(updated));
+});
+
+router.delete('/:id', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const dashboard = getDashboardOr404(user.tenantId, req.params.id);
+  getDb().prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+  res.status(204).end();
+});
+
+router.post('/:id/widgets', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const dashboard = getDashboardOr404(user.tenantId, req.params.id);
+  const { type, config, position_x, position_y, width, height } = req.body ?? {};
+  if (!type || !WIDGET_TYPES.includes(type)) {
+    throw new ValidationError('Invalid widget type');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+  ).run(
+    id,
+    dashboard.id,
+    type,
+    JSON.stringify(config ?? {}),
+    position_x ?? 0,
+    position_y ?? 0,
+    width ?? 1,
+    height ?? 1
+  );
+
+  const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+  res.status(201).json(toPublicWidget(row));
+});
+
+router.delete('/:id/widgets/:widgetId', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const dashboard = getDashboardOr404(user.tenantId, req.params.id);
+  const result = getDb()
+    .prepare('DELETE FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .run(req.params.widgetId, dashboard.id);
+
+  if (result.changes === 0) {
+    throw new NotFoundError('Widget not found');
+  }
+  res.status(204).end();
+});
+
+export default router;
