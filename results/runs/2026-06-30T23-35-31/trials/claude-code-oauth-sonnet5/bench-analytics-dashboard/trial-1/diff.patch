 format = bucketFormat(bucket);\n  const params: unknown[] = [user.tenantId, event_name];\n  let sql = applyRange(\n    `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`,\n    params,\n    { start, end }\n  );\n  sql += ' GROUP BY bucket ORDER BY bucket';\n\n  const rows = getDb().prepare(sql).all(...params) as { bucket: string; count: number }[];\n  res.status(200).json({ data: rows });\n});\n\nrouter.post('/breakdown', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const { event_name, property_key, start, end } = req.body ?? {};\n  if (!event_name || !property_key) {\n    throw new ValidationError('event_name and property_key are required');\n  }\n\n  const params: unknown[] = [user.tenantId, event_name];\n  const sql = applyRange(\n    'SELECT properties FROM events WHERE tenant_id = ? AND name = ?',\n    params,\n    { start, end }\n  );\n  const rows = getDb().prepare(sql).all(...params) as { properties: string }[];\n\n  const counts = new Map<string, number>();\n  for (const row of rows) {\n    const props = JSON.parse(row.properties) as Record<string, unknown>;\n    const value = props[property_key];\n    if (value === undefined) continue;\n    const key = String(value);\n    counts.set(key, (counts.get(key) ?? 0) + 1);\n  }\n\n  const data = Array.from(counts.entries()).map(([property_value, count]) => ({\n    property_value,\n    count,\n  }));\n  res.status(200).json({ data });\n});\n\nrouter.post('/funnel', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const { steps, start, end } = req.body ?? {};\n  if (!Array.isArray(steps) || steps.length === 0) {\n    throw new ValidationError('steps must be a non-empty array');\n  }\n\n  const params: unknown[] = [user.tenantId];\n  const sql = applyRange('SELECT name, session_id, id FROM events WHERE tenant_id = ?', params, {\n    start,\n    end,\n  });\n  const rows = getDb().prepare(sql).all(...params) as {\n    name: string;\n    session_id: string | null;\n    id: string;\n  }[];\n\n  const sessionEvents = new Map<string, Set<string>>();\n  for (const row of rows) {\n    const key = row.session_id ?? row.id;\n    if (!sessionEvents.has(key)) {\n      sessionEvents.set(key, new Set());\n    }\n    sessionEvents.get(key)?.add(row.name);\n  }\n\n  let qualifying = new Set(sessionEvents.keys());\n  const results: { step: string; count: number }[] = [];\n  for (const step of steps as string[]) {\n    qualifying = new Set(\n      Array.from(qualifying).filter((key) => sessionEvents.get(key)?.has(step))\n    );\n    results.push({ step, count: qualifying.size });\n  }\n\n  res.status(200).json({ steps: results });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1075,"cache_read_input_tokens":81038,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1075},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"55c4d885-47e7-4783-8cb0-9c8ac9430863","uuid":"cc60ef85-fbff-4ad6-bf3e-f32b4ae41407","request_id":"req_011CcaLw7rJirMUBDeyXXZKf"}
