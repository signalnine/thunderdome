eated_at,\n    updated_at: row.updated_at,\n  };\n}\n\nfunction toPublicWidget(row: WidgetRow) {\n  return {\n    id: row.id,\n    dashboard_id: row.dashboard_id,\n    type: row.type,\n    config: JSON.parse(row.config),\n    position_x: row.position_x,\n    position_y: row.position_y,\n    width: row.width,\n    height: row.height,\n  };\n}\n\nrouter.get('/events', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const format = (req.query.format as string) ?? 'json';\n  if (format !== 'json' && format !== 'csv') {\n    throw new ValidationError('format must be \"json\" or \"csv\"');\n  }\n\n  const rows = getDb()\n    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')\n    .all(user.tenantId) as EventRow[];\n\n  if (format === 'csv') {\n    const header = 'id,tenant_id,name,properties,timestamp,user_id,session_id';\n    const lines = [header, ...rows.map(eventToCsvRow)];\n    res.status(200).set('Content-Type', 'text/csv').send(lines.join('\\n'));\n    return;\n  }\n\n  res.status(200).json(rows.map(toPublicEvent));\n});\n\nrouter.get('/dashboard/:id', (req: Request, res: Response) => {\n  const user = getAuthUser(req);\n  const db = getDb();\n  const dashboard = db\n    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')\n    .get(req.params.id, user.tenantId) as DashboardRow | undefined;\n  if (!dashboard) {\n    throw new NotFoundError('Dashboard not found');\n  }\n\n  const widgets = db\n    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')\n    .all(dashboard.id) as WidgetRow[];\n\n  res.status(200).json({\n    dashboard: toPublicDashboard(dashboard),\n    widgets: widgets.map(toPublicWidget),\n  });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2474,"cache_read_input_tokens":84001,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2474},