+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { authMiddleware, getAuthUser } from '../auth';
+import { ValidationError } from '../errors';
+
+const router = Router();
+router.use(authMiddleware);
+
+interface EventInput {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  user_id?: string;
+  session_id?: string;
+}
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function toPublicEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function insertEvent(tenantId: string, input: EventInput): EventRow {
+  if (!input || typeof input.name !== 'string' || input.name.length === 0) {
+    throw new ValidationError('Event name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  const properties = JSON.stringify(input.properties ?? {});
+  const timestamp = input.timestamp ?? new Date().toISOString();
+  const userId = input.user_id ?? null;
+  const sessionId = input.session_id ?? null;
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, input.name, properties, timestamp, userId, sessionId);
+
+  return { id, tenant_id: tenantId, name: input.name, properties, timestamp, user_id: userId, session_id: sessionId };
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const row = insertEvent(user.tenantId, req.body ?? {});
+  res.status(201).json(toPublicEvent(row));
+});
+
+router.post('/batch', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const { events } = req.body ?? {};
+  if (!Array.isArray(events) || events.length === 0) {
+    throw new ValidationError('events must be a non-empty array');
+  }
+
+  const rows = events.map((event: EventInput) => insertEvent(user.tenantId, event));
+  res.status(201).json({ inserted: rows.length, events: rows.map(toPublicEvent) });
+});
+
+export default router;
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..8c7d459
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,148 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { authMiddleware, getAuthUser } from '../auth';
+import { ValidationError } from '../errors';
+
+const router = Router();
+router.use(authMiddleware);
+
+interface RangeFilter {
+  start?: string;
+  end?: string;
+}
+
+function applyRange(sql: string, params: unknown[], filter: RangeFilter): string {
+  let result = sql;
+  if (filter.start) {
+    result += ' AND timestamp >= ?';
+    params.push(filter.start);
+  }
+  if (filter.end) {
+    result += ' AND timestamp <= ?';
+    params.push(filter.end);
+  }
+  return result;
+}
+
+function bucketFormat(bucket: unknown): string {
+  switch (bucket) {
+    case 'hour':
+      return '%Y-%m-%dT%H:00:00';
+    case 'week':
+      return '%Y-%W';
+    case 'month':
+      return '%Y-%m';
+    case 'day':
+    default:
+      return '%Y-%m-%d';
+  }
+}
+
+router.post('/count', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const { event_name, start, end } = req.body ?? {};
+  if (!event_name) {
+    throw new ValidationError('event_name is required');
+  }
+
+  const params: unknown[] = [user.tenantId, event_name];
+  const sql = applyRange(
+    'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?',
+    params,
+    { start, end }
+  );
+  const row = getDb().prepare(sql).get(...params) as { count: number };
+  res.status(200).json({ count: row.count });
+});
+
+router.post('/timeseries', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const { event_name, bucket, start, end } = req.body ?? {};
+  if (!event_name) {
+    throw new ValidationError('event_name is required');
+  }
+
+  const format = bucketFormat(bucket);
+  const params: unknown[] = [user.tenantId, event_name];
+  let sql = applyRange(
+    `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`,
+    params,
+    { start, end }
+  );
+  sql += ' GROUP BY bucket ORDER BY bucket';
+
+  const rows = getDb().prepare(sql).all(...params) as { bucket: string; count: number }[];
+  res.status(200).json({ data: rows });
+});
+
+router.post('/breakdown', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const { event_name, property_key, start, end } = req.body ?? {};
+  if (!event_name || !property_key) {
+    throw new ValidationError('event_name and property_key are required');
+  }
+
+  const params: unknown[] = [user.tenantId, event_name];
+  const sql = applyRange(
+    'SELECT properties FROM events WHERE tenant_id = ? AND name = ?',
+    params,
+    { start, end }
+  );
+  const rows = getDb().prepare(sql).all(...params) as { properties: string }[];
+
+  const counts = new Map<string, number>();
+  for (const row of rows) {
+    const props = JSON.parse(row.properties) as Record<string, unknown>;
+    const value = props[property_key];
+    if (value === undefined) continue;
+    const key = String(value);
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  }
+
+  const data = Array.from(counts.entries()).map(([property_value, count]) => ({
+    property_value,
+    count,
+  }));
+  res.status(200).json({ data });
+});
+
+router.post('/funnel', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const { steps, start, end } = req.body ?? {};
+  if (!Array.isArray(steps) || steps.length === 0) {
+    throw new ValidationError('steps must be a non-empty array');
+  }
+
+  const params: unknown[] = [user.tenantId];
+  const sql = applyRange('SELECT name, session_id, id FROM events WHERE tenant_id = ?', params, {
+    start,
+    end,
+  });
+  const rows = getDb().prepare(sql).all(...params) as {
+    name: string;
+    session_id: string | null;
+    id: string;
+  }[];
+
+  const sessionEvents = new Map<string, Set<string>>();
+  for (const row of rows) {
+    const key = row.session_id ?? row.id;
+    if (!sessionEvents.has(key)) {
+      sessionEvents.set(key, new Set());
+    }
+    sessionEvents.get(key)?.add(row.name);
+  }
+
+  let qualifying = new Set(sessionEvents.keys());
+  const results: { step: string; count: number }[] = [];
+  for (const step of steps as string[]) {
+    qualifying = new Set(
+      Array.from(qualifying).filter((key) => sessionEvents.get(key)?.has(step))
+    );
+    results.push({ step, count: qualifying.size });
+  }
+
+  res.status(200).json({ steps: results });
+});
+
+export default router;
