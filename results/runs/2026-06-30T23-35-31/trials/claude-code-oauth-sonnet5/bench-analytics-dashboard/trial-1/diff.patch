@@ -0,0 +1,139 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { authMiddleware, getAuthUser } from '../auth';
+import { NotFoundError, ValidationError } from '../errors';
+
+const router = Router();
+router.use(authMiddleware);
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function escapeCsv(value: string): string {
+  if (/[",\n]/.test(value)) {
+    return `"${value.replace(/"/g, '""')}"`;
+  }
+  return value;
+}
+
+function eventToCsvRow(row: EventRow): string {
+  return [
+    row.id,
+    row.tenant_id,
+    row.name,
+    row.properties,
+    row.timestamp,
+    row.user_id ?? '',
+    row.session_id ?? '',
+  ]
+    .map((value) => escapeCsv(String(value)))
+    .join(',');
+}
+
+function toPublicEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function toPublicDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: JSON.parse(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function toPublicWidget(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: JSON.parse(row.config),
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+router.get('/events', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const format = (req.query.format as string) ?? 'json';
+  if (format !== 'json' && format !== 'csv') {
+    throw new ValidationError('format must be "json" or "csv"');
+  }
+
+  const rows = getDb()
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+    .all(user.tenantId) as EventRow[];
+
+  if (format === 'csv') {
+    const header = 'id,tenant_id,name,properties,timestamp,user_id,session_id';
+    const lines = [header, ...rows.map(eventToCsvRow)];
+    res.status(200).set('Content-Type', 'text/csv').send(lines.join('\n'));
+    return;
+  }
+
+  res.status(200).json(rows.map(toPublicEvent));
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response) => {
+  const user = getAuthUser(req);
+  const db = getDb();
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, user.tenantId) as DashboardRow | undefined;
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: toPublicDashboard(dashboard),
+    widgets: widgets.map(toPublicWidget),
+  });
+});
+
+export default router;
