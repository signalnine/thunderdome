+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { requireUser } from '../auth';
+import { ValidationError, NotFoundError } from '../errors';
+
+const router = Router();
+router.use(requireUser);
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function toPublicDashboard(row: DashboardRow) {
+  return { ...row, config: JSON.parse(row.config) };
+}
+
+function toPublicWidget(row: WidgetRow) {
+  return { ...row, config: JSON.parse(row.config) };
+}
+
+function findDashboard(id: string, tenantId: string): DashboardRow {
+  const db = getDb();
+  const row = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+
+  if (!row) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return row;
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const { name, config } = req.body ?? {};
+
+  if (!name) {
+    throw new ValidationError('name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, req.user!.tenantId, name, req.user!.id, JSON.stringify(config ?? {}));
+
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+  res.status(201).json(toPublicDashboard(row));
+});
+
+router.get('/', (req: Request, res: Response) => {
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC')
+    .all(req.user!.tenantId) as DashboardRow[];
+
+  res.status(200).json(rows.map(toPublicDashboard));
+});
+
+router.get('/:id', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.params.id, req.user!.tenantId);
+  const db = getDb();
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({ ...toPublicDashboard(dashboard), widgets: widgets.map(toPublicWidget) });
+});
+
+router.patch('/:id', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.params.id, req.user!.tenantId);
+  const { name, config } = req.body ?? {};
+
+  const db = getDb();
+  db.prepare(
+    "UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?"
+  ).run(
+    name ?? dashboard.name,
+    config !== undefined ? JSON.stringify(config) : dashboard.config,
+    dashboard.id
+  );
+
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(dashboard.id) as DashboardRow;
+  res.status(200).json(toPublicDashboard(row));
+});
+
+router.delete('/:id', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.params.id, req.user!.tenantId);
+  const db = getDb();
+  db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(dashboard.id);
+  db.prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+  res.status(204).send();
+});
+
+router.post('/:id/widgets', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.params.id, req.user!.tenantId);
+  const { type, config, position_x: positionX, position_y: positionY, width, height } =
+    req.body ?? {};
+
+  if (!type || !WIDGET_TYPES.includes(type)) {
+    throw new ValidationError(`type must be one of: ${WIDGET_TYPES.join(', ')}`);
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+  ).run(
+    id,
+    dashboard.id,
+    type,
+    JSON.stringify(config ?? {}),
+    positionX ?? 0,
+    positionY ?? 0,
+    width ?? 1,
+    height ?? 1
+  );
+
+  const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+  res.status(201).json(toPublicWidget(row));
+});
+
+router.delete('/:id/widgets/:widgetId', (req: Request, res: Response) => {
+  const dashboard = findDashboard(req.params.id, req.user!.tenantId);
+  const db = getDb();
+  const widget = db
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(req.params.widgetId, dashboard.id) as WidgetRow | undefined;
+
+  if (!widget) {
+    throw new NotFoundError('Widget not found');
+  }
+
+  db.prepare('DELETE FROM widgets WHERE id = ?').run(widget.id);
+  res.status(204).send();
+});
+
+export default router;
