@@ -0,0 +1,42 @@
+import Database from 'better-sqlite3';
+import fs from 'fs';
+import path from 'path';
+
+let currentDb: Database.Database | null = null;
+
+function loadSchema(db: Database.Database): void {
+  db.pragma('foreign_keys = ON');
+  const schemaPath = path.join(__dirname, '..', 'schema.sql');
+  const schema = fs.readFileSync(schemaPath, 'utf-8');
+  db.exec(schema);
+}
+
+export function createTestDb(): Database.Database {
+  const db = new Database(':memory:');
+  loadSchema(db);
+  return db;
+}
+
+export function createDb(filePath: string): Database.Database {
+  const db = new Database(filePath);
+  loadSchema(db);
+  return db;
+}
+
+export function setDb(db: Database.Database): void {
+  currentDb = db;
+}
+
+export function getDb(): Database.Database {
+  if (!currentDb) {
+    throw new Error('Database not initialized. Call setDb() first.');
+  }
+  return currentDb;
+}
+
+export function closeDb(): void {
+  if (currentDb) {
+    currentDb.close();
+    currentDb = null;
+  }
+}
