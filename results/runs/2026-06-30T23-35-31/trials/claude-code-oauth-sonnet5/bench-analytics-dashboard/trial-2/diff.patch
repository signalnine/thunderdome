onse) => {\n  const { events } = req.body ?? {};\n\n  if (!Array.isArray(events) || events.length === 0) {\n    throw new ValidationError('events must be a non-empty array');\n  }\n\n  const tenantId = req.user!.tenantId;\n  const built = events.map((e: IncomingEvent) => buildEvent(e, tenantId));\n\n  const db = getDb();\n  const insertMany = db.transaction((toInsert: StoredEvent[]) => {\n    for (const event of toInsert) {\n      insertEvent(event);\n    }\n  });\n  insertMany(built);\n\n  res.status(201).json({ inserted: built.length, events: built });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1597,"cache_read_input_tokens":74855,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1597},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c1cda36c-63bd-4333-8805-cb90e7056194","uuid":"ac34abf2-381b-48a5-9581-fa8b7f9fa7cd","request_id":"req_011CcaLzrRyKQxRL8UNWf4Az"}
