+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { requireUser } from '../auth';
+import { ValidationError } from '../errors';
+
+const router = Router();
+router.use(requireUser);
+
+interface IncomingEvent {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  user_id?: string;
+  session_id?: string;
+}
+
+interface StoredEvent {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function buildEvent(input: IncomingEvent, tenantId: string): StoredEvent {
+  if (!input || typeof input.name !== 'string' || input.name.length === 0) {
+    throw new ValidationError('name is required');
+  }
+
+  return {
+    id: uuidv4(),
+    tenant_id: tenantId,
+    name: input.name,
+    properties: input.properties ?? {},
+    timestamp: input.timestamp ?? new Date().toISOString(),
+    user_id: input.user_id ?? null,
+    session_id: input.session_id ?? null,
+  };
+}
+
+function insertEvent(event: StoredEvent): void {
+  const db = getDb();
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(
+    event.id,
+    event.tenant_id,
+    event.name,
+    JSON.stringify(event.properties),
+    event.timestamp,
+    event.user_id,
+    event.session_id
+  );
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const event = buildEvent(req.body, req.user!.tenantId);
+  insertEvent(event);
+  res.status(201).json(event);
+});
+
+router.post('/batch', (req: Request, res: Response) => {
+  const { events } = req.body ?? {};
+
+  if (!Array.isArray(events) || events.length === 0) {
+    throw new ValidationError('events must be a non-empty array');
+  }
+
+  const tenantId = req.user!.tenantId;
+  const built = events.map((e: IncomingEvent) => buildEvent(e, tenantId));
+
+  const db = getDb();
+  const insertMany = db.transaction((toInsert: StoredEvent[]) => {
+    for (const event of toInsert) {
+      insertEvent(event);
+    }
+  });
+  insertMany(built);
+
+  res.status(201).json({ inserted: built.length, events: built });
+});
+
+export default router;
