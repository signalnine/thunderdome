@@ -0,0 +1,99 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { requireUser } from '../auth';
+import { ValidationError, NotFoundError } from '../errors';
+
+const router = Router();
+router.use(requireUser);
+
+const FORMATS = ['csv', 'json'];
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const EVENT_COLUMNS = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+
+function csvField(value: unknown): string {
+  const text = value === null || value === undefined ? '' : String(value);
+  return `"${text.replace(/"/g, '""')}"`;
+}
+
+function eventsToCsv(rows: EventRow[]): string {
+  const header = EVENT_COLUMNS.join(',');
+  const lines = rows.map((row) =>
+    EVENT_COLUMNS.map((col) => csvField(row[col as keyof EventRow])).join(',')
+  );
+  return [header, ...lines].join('\n');
+}
+
+router.get('/events', (req: Request, res: Response) => {
+  const format = req.query.format as string | undefined;
+
+  if (!format || !FORMATS.includes(format)) {
+    throw new ValidationError(`format must be one of: ${FORMATS.join(', ')}`);
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+    .all(req.user!.tenantId) as EventRow[];
+
+  if (format === 'csv') {
+    res.status(200).set('Content-Type', 'text/csv').send(eventsToCsv(rows));
+    return;
+  }
+
+  res.status(200).json(
+    rows.map((row) => ({ ...row, properties: JSON.parse(row.properties) }))
+  );
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response) => {
+  const db = getDb();
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, req.user!.tenantId) as DashboardRow | undefined;
+
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },
+    widgets: widgets.map((w) => ({ ...w, config: JSON.parse(w.config) })),
+  });
+});
+
+export default router;
