w new ValidationError('email and password are required');\n  }\n\n  const db = getDb();\n  const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as\n    | UserRow\n    | undefined;\n\n  if (!row || !verifyPassword(password, row.password_hash)) {\n    throw new AuthError('Invalid email or password');\n  }\n\n  const token = signToken(row.id, row.tenant_id);\n  res.status(200).json({ token, user: toPublicUser(row) });\n});\n\nrouter.get('/me', requireUser, (req: Request, res: Response) => {\n  const db = getDb();\n  const row = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as\n    | UserRow\n    | undefined;\n\n  if (!row) {\n    throw new NotFoundError('User not found');\n  }\n\n  res.status(200).json(toPublicUser(row));\n});\n\nrouter.patch('/:id/role', requireUser, (req: Request, res: Response) => {\n  const { role } = req.body ?? {};\n\n  if (!role || !ROLES.includes(role)) {\n    throw new ValidationError(`role must be one of: ${ROLES.join(', ')}`);\n  }\n\n  const db = getDb();\n  const actor = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as\n    | UserRow\n    | undefined;\n\n  if (!actor || actor.role !== 'admin') {\n    throw new ForbiddenError('Only admins can change user roles');\n  }\n\n  const target = db\n    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')\n    .get(req.params.id, actor.tenant_id) as UserRow | undefined;\n\n  if (!target) {\n    throw new NotFoundError('User not found');\n  }\n\n  db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);\n  const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;\n  res.status(200).json(toPublicUser(updated));\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":763,"cache_read_input_tokens":74092,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_