eferredHonored > bestPreferredHonored)\n    ) {\n      best = result;\n      bestPreferredHonored = preferredHonored;\n    }\n  }\n\n  return best!;\n}\n\nexport default schedule;","originalFile":"export interface Event {\n  id: string;\n  name: string;\n  duration: number;\n  attendees?: number;\n  prerequisites?: string[];\n  preferredRoom?: string;\n}\n\nexport interface Room {\n  id: string;\n  name: string;\n  capacity: number;\n}\n\nexport interface ScheduleOptions {\n  startTime: number;\n  endTime: number;\n  gap?: number;\n}\n\nexport interface Assignment {\n  eventId: string;\n  roomId: string;\n  startTime: number;\n  endTime: number;\n}\n\nexport interface ScheduleResult {\n  assignments: Assignment[];\n  unscheduled: string[];\n}\n\ninterface Booking {\n  start: number;\n  end: number;\n}\n\nfunction detectCycle(events: Event[]): void {\n  const ids = new Set(events.map((e) => e.id));\n  const adj = new Map<string, string[]>();\n  for (const e of events) {\n    adj.set(\n      e.id,\n      (e.prerequisites ?? []).filter((id) => ids.has(id)),\n    );\n  }\n\n  const WHITE = 0;\n  const GRAY = 1;\n  const BLACK = 2;\n  const color = new Map<string, number>();\n  for (const e of events) color.set(e.id, WHITE);\n\n  const path: string[] = [];\n\n  function visit(id: string): void {\n    color.set(id, GRAY);\n    path.push(id);\n    for (const dep of adj.get(id) ?? []) {\n      const depColor = color.get(dep);\n      if (depColor === GRAY) {\n        const cycleStart = path.indexOf(dep);\n        const cycle = path.slice(cycleStart).concat(dep);\n        throw new Error(`Cycle detected in event prerequisites: ${cycle.join(' -> ')}`);\n      }\n      if (depColor === WHITE) {\n        visit(dep);\n      }\n    }\n    path.pop();\n    color.set(id, BLACK);\n  }\n\n  for (const e of events) {\n    if (color.get(e.id) === WHITE) visit(e.id);\n  }\n}\n\nfunction findEarliestSlot(\n  bookings: Booking[],\n  lowerBound: number,\n  duration: number,\n  gap: number,\n  windowStart: number,\n  windowEnd: number,\n): number | null {\n  const candidates = new Set<number>();\n  const initial = Math.max(lowerBound, windowStart);\n  candidates.add(initial);\n  for (const b of bookings) {\n    const c = b.end + gap;\n    if (c >= initial) candidates.add(c);\n  }\n\n  const sorted = [...candidates].sort((a, b) => a - b);\n  for (const start of sorted) {\n    const end = start + duration;\n    if (end > windowEnd) return null;\n\n    let ok = true;\n    for (const b of bookings) {\n      if (!(start >= b.end + gap || end + gap <= b.start)) {\n        ok = false;\n        break;\n      }\n    }\n    if (ok) return start;\n  }\n  return null;\n}\n\nfunction runStrategy(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n  gap: number,\n  prereqsOf: Map<string, string[]>,\n  dependentsOf: Map<string, string[]>,\n  scorer: (e: Event) => number,\n): ScheduleResult {\n  const eventMap = new Map(events.map((e) => [e.id, e]));\n  const indegree = new Map<string, number>();\n  for (const e of events) indegree.set(e.id, prereqsOf.get(e.id)!.length);\n\n  const scheduledEnd = new Map<string, number>();\n  const roomBookings = new Map<string, Booking[]>();\n  for (const r of rooms) roomBookings.set(r.id, []);\n\n  const assignments: Assignment[] = [];\n\n  let ready: string[] = events.filter((e) => indegree.get(e.id) === 0).map((e) => e.id);\n\n  while (ready.length > 0) {\n    ready.sort((a, b) => scorer(eventMap.get(b)!) - scorer(eventMap.get(a)!) || a.localeCompare(b));\n    const id = ready.shift()!;\n    const event = eventMap.get(id)!;\n\n    const prereqs = prereqsOf.get(id)!;\n    let feasible = true;\n    let lowerBound = options.startTime;\n    for (const p of prereqs) {\n      const prereqEnd = scheduledEnd.get(p);\n      if (prereqEnd === undefined) {\n        feasible = false;\n        break;\n      }\n      lowerBound = Math.max(lowerBound, prereqEnd + gap);\n    }\n\n    if (feasible) {\n      const attendees = event.attendees ?? 1;\n      const candidateRooms = rooms.filter((r) => r.capacity >= attendees);\n      let placed: { roomId: string; start: number } | null = null;\n\n      if (event.preferredRoom) {\n        const pref = candidateRooms.find((r) => r.id === event.preferredRoom);\n        if (pref) {\n          const slot = findEarliestSlot(\n            roomBookings.get(pref.id)!,\n            lowerBound,\n            event.duration,\n            gap,\n            options.startTime,\n            options.endTime,\n          );\n          if (slot !== null) placed = { roomId: pref.id, start: slot };\n        }\n      }\n\n      if (!placed) {\n        let bestRoom: string | null = null;\n        let bestStart = Infinity;\n        let bestCapacity = Infinity;\n        for (const r of candidateRooms) {\n          const slot = findEarliestSlot(\n            roomBookings.get(r.id)!,\n            lowerBound,\n            event.duration,\n            gap,\n            options.startTime,\n            options.endTime,\n          );\n          if (slot === null) continue;\n          if (slot < bestStart || (slot === bestStart && r.capacity < bestCapacity)) {\n            bestStart = slot;\n            bestRoom = r.id;\n            bestCapacity = r.capacity;\n          }\n        }\n        if (bestRoom !== null) placed = { roomId: bestRoom, start: bestStart };\n      }\n\n      if (placed) {\n        const end = placed.start + event.duration;\n        const bookings = roomBookings.get(placed.roomId)!;\n        bookings.push({ start: placed.start, end });\n        bookings.sort((a, b) => a.start - b.start);\n        scheduledEnd.set(id, end);\n        assignments.push({ eventId: id, roomId: placed.roomId, startTime: placed.start, endTime: end });\n      }\n    }\n\n    for (const dep of dependentsOf.get(id) ?? []) {\n      const next = indegree.get(dep)! - 1;\n      indegree.set(dep, next);\n      if (next === 0) ready.push(dep);\n    }\n  }\n\n  const unscheduled = events.filter((e) => !scheduledEnd.has(e.id)).map((e) => e.id);\n  assignments.sort((a, b) => a.startTime - b.startTime || a.roomId.localeCompare(b.roomId));\n\n  return { assignments, unscheduled };\n}\n\nexport function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  detectCycle(events);\n\n  const gap = options.gap ?? 15;\n  const eventIds = new Set(events.map((e) => e.id));\n\n  const prereqsOf = new Map<string, string[]>();\n  for (const e of events) {\n    prereqsOf.set(e.id, (e.prerequisites ?? []).filter((id) => eventIds.has(id)));\n  }\n\n  const dependentsOf = new Map<string, string[]>();\n  for (const e of events) dependentsOf.set(e.id, []);\n  for (const e of events) {\n    for (const p of prereqsOf.get(e.id)!) {\n      dependentsOf.get(p)!.push(e.id);\n    }\n  }\n\n  const transitiveCache = new Map<string, number>();\n  function transitiveDependents(id: string): number {\n    const cached = transitiveCache.get(id);\n    if (cached !== undefined) return cached;\n    const seen = new Set<string>();\n    const stack = [...(dependentsOf.get(id) ?? [])];\n    while (stack.length) {\n      const d = stack.pop()!;\n      if (seen.has(d)) continue;\n      seen.add(d);\n      stack.push(...(dependentsOf.get(d) ?? []));\n    }\n    transitiveCache.set(id, seen.size);\n    return seen.size;\n  }\n\n  const inputIndex = new Map(events.map((e, i) => [e.id, i]));\n\n  const scorers: Array<(e: Event) => number> = [\n    (e) => transitiveDependents(e.id) * 1_000_000 - e.duration,\n    (e) => -e.duration,\n    (e) => e.duration,\n    (e) => (e.attendees ?? 1) * 1000 - e.duration,\n    (e) => -inputIndex.get(e.id)!,\n  ];\n\n  let best: ScheduleResult | null = null;\n  let bestPreferredHonored = -1;\n\n  for (const scorer of scorers) {\n    const result = runStrategy(events, rooms, options, gap, prereqsOf, dependentsOf, scorer);\n    const preferredHonored = result.assignments.reduce((count, a) => {\n      const ev = eventMapOf(events, a.eventI