dMatches -= 1;\n      }\n    }\n\n    if (!budgetExceeded) {\n      const upperBoundSkip = currentCount + remaining;\n      if (upperBoundSkip >= bestCount) {\n        recurse(idx + 1);\n      }\n    }\n  }\n\n  recurse(0);\n\n  return {\n    assignments: bestAssignments,\n    unscheduled: bestUnscheduled,\n  };\n}\n","structuredPatch":[{"oldStart":129,"oldLines":15,"newStart":129,"newLines":12,"lines":["     const attendees = event.attendees ?? DEFAULT_ATTENDEES;","     const prereqs = event.prerequisites ?? [];"," ","-    const missingPrereq = prereqs.some((p) => eventMap.has(p) === false ? true : false);","-    const unresolvablePrereq = prereqs.some((p) => !eventMap.has(p));","-    const allKnownPrereqsScheduled = prereqs","-      .filter((p) => eventMap.has(p))","-      .every((p) => scheduled.has(p));","+    // A prerequisite referencing an unknown event id can never be satisfied,","+    // so the event can never be scheduled.","+    const hasUnresolvablePrereq = prereqs.some((p) => !eventMap.has(p));","+    const allPrereqsScheduled = prereqs.every((p) => !eventMap.has(p) || scheduled.has(p));","+    const canAttempt = !hasUnresolvablePrereq && allPrereqsScheduled;"," ","-    const canAttempt = !unresolvablePrereq && allKnownPrereqsScheduled;","-    void missingPrereq;","-","     if (canAttempt) {","       let earliestStart = options.startTime;","       for (const p of prereqs) {"]}],"userModified":false,"replaceAll":false}}
