+++ b/src/scheduler.ts
@@ -0,0 +1,212 @@
+import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+// Bounds the branch-and-bound search so pathological inputs can't hang the
+// process; once exhausted the search unwinds and returns the best solution
+// found so far rather than continuing to explore.
+const NODE_BUDGET = 200_000;
+
+interface Booking {
+  eventId: string;
+  startTime: number;
+  endTime: number;
+}
+
+interface RoomCandidate {
+  roomId: string;
+  startTime: number;
+  endTime: number;
+  isPreferred: boolean;
+}
+
+/**
+ * Topologically orders events so prerequisites always precede dependents.
+ * Throws if the prerequisite graph contains a cycle, including self-references.
+ */
+function topologicalOrder(events: Event[]): string[] {
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  const color = new Map<string, 0 | 1 | 2>(events.map((e) => [e.id, 0]));
+  const order: string[] = [];
+
+  function visit(id: string, path: string[]): void {
+    color.set(id, 1);
+    const event = eventMap.get(id);
+    for (const dep of event?.prerequisites ?? []) {
+      if (!eventMap.has(dep)) continue; // unknown prerequisite handled at scheduling time
+      const depColor = color.get(dep);
+      if (depColor === 1) {
+        throw new Error(
+          `Cycle detected in event prerequisites: ${[...path, dep].join(' -> ')}`,
+        );
+      }
+      if (depColor === 0) visit(dep, [...path, dep]);
+    }
+    color.set(id, 2);
+    order.push(id);
+  }
+
+  for (const event of events) {
+    if (color.get(event.id) === 0) visit(event.id, [event.id]);
+  }
+
+  return order;
+}
+
+/**
+ * Earliest-fit candidate start times within a single room's existing bookings.
+ * Trying only the earliest start in each free gap loses no optimality for a
+ * single resource (shifting a job earlier within its feasible window never
+ * blocks a placement that a later start would have allowed) while keeping the
+ * branching factor per room bounded by the number of existing bookings.
+ */
+function candidateStartsForRoom(
+  bookings: Booking[],
+  earliestStart: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+): number[] {
+  const sorted = [...bookings].sort((a, b) => a.startTime - b.startTime);
+  const candidates: number[] = [];
+  let cursor = earliestStart;
+
+  for (const booking of sorted) {
+    if (cursor + duration <= booking.startTime - gap && cursor + duration <= windowEnd) {
+      candidates.push(cursor);
+    }
+    cursor = Math.max(cursor, booking.endTime + gap);
+  }
+
+  if (cursor + duration <= windowEnd) {
+    candidates.push(cursor);
+  }
+
+  return candidates;
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const order = topologicalOrder(events);
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+
+  const roomBookings = new Map<string, Booking[]>(rooms.map((r) => [r.id, []]));
+  const scheduled = new Map<string, Assignment>();
+
+  let currentCount = 0;
+  let currentPreferredMatches = 0;
+  let bestCount = -1;
+  let bestPreferredMatches = -1;
+  let bestAssignments: Assignment[] = [];
+  let bestUnscheduled: string[] = [];
+  let nodeCount = 0;
+  let budgetExceeded = false;
+
+  function recordIfBetter(): void {
+    if (
+      currentCount > bestCount ||
+      (currentCount === bestCount && currentPreferredMatches > bestPreferredMatches)
+    ) {
+      bestCount = currentCount;
+      bestPreferredMatches = currentPreferredMatches;
+      bestAssignments = Array.from(scheduled.values()).map((a) => ({ ...a }));
+      bestUnscheduled = order.filter((id) => !scheduled.has(id));
+    }
+  }
+
+  function recurse(idx: number): void {
+    nodeCount += 1;
+    if (nodeCount > NODE_BUDGET) budgetExceeded = true;
+
+    if (idx === order.length || budgetExceeded) {
+      recordIfBetter();
+      return;
+    }
+
+    const remaining = order.length - idx - 1;
+    const eventId = order[idx];
+    const event = eventMap.get(eventId)!;
+    const attendees = event.attendees ?? DEFAULT_ATTENDEES;
+    const prereqs = event.prerequisites ?? [];
+
+    // A prerequisite referencing an unknown event id can never be satisfied,
+    // so the event can never be scheduled.
+    const hasUnresolvablePrereq = prereqs.some((p) => !eventMap.has(p));
+    const allPrereqsScheduled = prereqs.every((p) => !eventMap.has(p) || scheduled.has(p));
+    const canAttempt = !hasUnresolvablePrereq && allPrereqsScheduled;
+
+    if (canAttempt) {
+      let earliestStart = options.startTime;
+      for (const p of prereqs) {
+        const prereqAssignment = scheduled.get(p);
+        if (prereqAssignment) {
+          earliestStart = Math.max(earliestStart, prereqAssignment.endTime + gap);
+        }
+      }
+
+      const roomOrder = rooms
+        .filter((r) => r.capacity >= attendees)
+        .sort((a, b) => {
+          const aPreferred = a.id === event.preferredRoom ? 0 : 1;
+          const bPreferred = b.id === event.preferredRoom ? 0 : 1;
+          if (aPreferred !== bPreferred) return aPreferred - bPreferred;
+          if (a.capacity !== b.capacity) return a.capacity - b.capacity;
+          return a.id.localeCompare(b.id);
+        });
+
+      const branches: RoomCandidate[] = [];
+      for (const room of roomOrder) {
+        const bookings = roomBookings.get(room.id) ?? [];
+        const starts = candidateStartsForRoom(bookings, earliestStart, event.duration, gap, options.endTime);
+        for (const start of starts) {
+          branches.push({
+            roomId: room.id,
+            startTime: start,
+            endTime: start + event.duration,
+            isPreferred: room.id === event.preferredRoom,
+          });
+        }
+      }
+
+      for (const branch of branches) {
+        if (budgetExceeded) break;
+        const upperBound = currentCount + 1 + remaining;
+        if (upperBound < bestCount) continue;
+
+        const bookings = roomBookings.get(branch.roomId)!;
+        const assignment: Assignment = {
+          eventId,
+          roomId: branch.roomId,
+          startTime: branch.startTime,
+          endTime: branch.endTime,
+        };
+
+        bookings.push({ eventId, startTime: branch.startTime, endTime: branch.endTime });
+        scheduled.set(eventId, assignment);
+        currentCount += 1;
+        if (branch.isPreferred) currentPreferredMatches += 1;
+
+        recurse(idx + 1);
+
+        bookings.pop();
+        scheduled.delete(eventId);
+        currentCount -= 1;
+        if (branch.isPreferred) currentPreferredMatches -= 1;
+      }
+    }
+
+    if (!budgetExceeded) {
+      const upperBoundSkip = currentCount + remaining;
+      if (upperBoundSkip >= bestCount) {
+        recurse(idx + 1);
+      }
+    }
+  }
+
+  recurse(0);
+
+  return {
+    assignments: bestAssignments,
+    unscheduled: bestUnscheduled,
+  };
+}
