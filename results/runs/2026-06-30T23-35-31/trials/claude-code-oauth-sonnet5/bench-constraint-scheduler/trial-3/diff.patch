+import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+function assertNoCycles(events: Event[]): void {
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Map<string, number>();
+  events.forEach((e) => color.set(e.id, WHITE));
+
+  const visit = (id: string, stack: string[]): void => {
+    color.set(id, GRAY);
+    const event = byId.get(id);
+    for (const prereqId of event?.prerequisites ?? []) {
+      if (!byId.has(prereqId)) continue; // dangling reference, not a cycle
+      const c = color.get(prereqId);
+      if (c === GRAY) {
+        const cycleStart = stack.indexOf(prereqId);
+        const cyclePath = stack.slice(cycleStart === -1 ? 0 : cycleStart).concat(prereqId);
+        throw new Error(`Prerequisite cycle detected: ${cyclePath.join(' -> ')}`);
+      }
+      if (c === WHITE) {
+        visit(prereqId, [...stack, prereqId]);
+      }
+    }
+    color.set(id, BLACK);
+  };
+
+  for (const event of events) {
+    if (color.get(event.id) === WHITE) {
+      visit(event.id, [event.id]);
+    }
+  }
+}
+
+type Comparator = (a: Event, b: Event) => number;
+
+function buildComparators(events: Event[], rooms: Room[]): Comparator[] {
+  const indexOf = new Map(events.map((e, i) => [e.id, i]));
+  const dependentsCount = new Map<string, number>();
+  events.forEach((e) => dependentsCount.set(e.id, 0));
+  events.forEach((e) => {
+    for (const p of e.prerequisites ?? []) {
+      if (dependentsCount.has(p)) {
+        dependentsCount.set(p, (dependentsCount.get(p) ?? 0) + 1);
+      }
+    }
+  });
+  const compatibleRoomCount = new Map<string, number>();
+  events.forEach((e) => {
+    const attendees = e.attendees ?? 1;
+    compatibleRoomCount.set(
+      e.id,
+      rooms.filter((r) => r.capacity >= attendees).length,
+    );
+  });
+
+  const byIndex: Comparator = (a, b) => (indexOf.get(a.id) ?? 0) - (indexOf.get(b.id) ?? 0);
+
+  return [
+    byIndex,
+    (a, b) => a.duration - b.duration || byIndex(a, b),
+    (a, b) => b.duration - a.duration || byIndex(a, b),
+    (a, b) => (a.attendees ?? 1) - (b.attendees ?? 1) || byIndex(a, b),
+    (a, b) =>
+      (compatibleRoomCount.get(a.id) ?? 0) - (compatibleRoomCount.get(b.id) ?? 0) ||
+      (dependentsCount.get(b.id) ?? 0) - (dependentsCount.get(a.id) ?? 0) ||
+      byIndex(a, b),
+    (a, b) =>
+      (dependentsCount.get(b.id) ?? 0) - (dependentsCount.get(a.id) ?? 0) || byIndex(a, b),
+  ];
+}
+
+function topologicalOrder(events: Event[], compare: Comparator): Event[] {
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  events.forEach((e) => {
+    indegree.set(e.id, 0);
+    dependents.set(e.id, []);
+  });
+  events.forEach((e) => {
+    for (const p of e.prerequisites ?? []) {
+      if (!byId.has(p)) continue;
+      indegree.set(e.id, (indegree.get(e.id) ?? 0) + 1);
+      dependents.get(p)?.push(e.id);
+    }
+  });
+
+  const ready = events.filter((e) => indegree.get(e.id) === 0);
+  const order: Event[] = [];
+
+  while (ready.length > 0) {
+    ready.sort(compare);
+    const next = ready.shift() as Event;
+    order.push(next);
+    for (const depId of dependents.get(next.id) ?? []) {
+      const remaining = (indegree.get(depId) ?? 0) - 1;
+      indegree.set(depId, remaining);
+      if (remaining === 0) {
+        const depEvent = byId.get(depId);
+        if (depEvent) ready.push(depEvent);
+      }
+    }
+  }
+
+  return order;
+}
+
+function earliestFeasibleStart(
+  bookings: Assignment[],
+  earliestStart: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+): number | null {
+  let current = earliestStart;
+  for (const booking of bookings) {
+    if (current + duration + gap <= booking.startTime) {
+      break;
+    }
+    current = Math.max(current, booking.endTime + gap);
+  }
+  if (current + duration <= windowEnd) {
+    return current;
+  }
+  return null;
+}
+
+function insertSorted(bookings: Assignment[], assignment: Assignment): void {
+  const idx = bookings.findIndex((b) => b.startTime > assignment.startTime);
+  if (idx === -1) {
+    bookings.push(assignment);
+  } else {
+    bookings.splice(idx, 0, assignment);
+  }
+}
+
+function runGreedy(
+  order: Event[],
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const gap = options.gap ?? 15;
+  const roomBookings = new Map<string, Assignment[]>();
+  rooms.forEach((r) => roomBookings.set(r.id, []));
+  const scheduled = new Map<string, Assignment>();
+  const unscheduled: string[] = [];
+
+  for (const event of order) {
+    const prereqIds = event.prerequisites ?? [];
+    let blocked = false;
+    let earliestStart = options.startTime;
+    for (const prereqId of prereqIds) {
+      if (!byId.has(prereqId)) {
+        blocked = true;
+        break;
+      }
+      const prereqAssignment = scheduled.get(prereqId);
+      if (!prereqAssignment) {
+        blocked = true;
+        break;
+      }
+      earliestStart = Math.max(earliestStart, prereqAssignment.endTime + gap);
+    }
+
+    if (blocked) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    const attendees = event.attendees ?? 1;
+    const candidateRooms = rooms.filter((r) => r.capacity >= attendees);
+    if (candidateRooms.length === 0) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    let chosenRoomId: string | null = null;
+    let chosenStart: number | null = null;
+
+    if (event.preferredRoom && candidateRooms.some((r) => r.id === event.preferredRoom)) {
+      const bookings = roomBookings.get(event.preferredRoom) ?? [];
+      const start = earliestFeasibleStart(bookings, earliestStart, event.duration, gap, options.endTime);
+      if (start !== null) {
+        chosenRoomId = event.preferredRoom;
+        chosenStart = start;
+      }
+    }
+
+    if (chosenRoomId === null) {
+      for (const room of candidateRooms) {
+        const bookings = roomBookings.get(room.id) ?? [];
+        const start = earliestFeasibleStart(bookings, earliestStart, event.duration, gap, options.endTime);
+        if (start !== null && (chosenStart === null || start < chosenStart)) {
+          chosenStart = start;
+          chosenRoomId = room.id;
+        }
+      }
+    }
+
+    if (chosenRoomId === null || chosenStart === null) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    const assignment: Assignment = {
+      eventId: event.id,
+      roomId: chosenRoomId,
+      startTime: chosenStart,
+      endTime: chosenStart + event.duration,
+    };
+    scheduled.set(event.id, assignment);
+    insertSorted(roomBookings.get(chosenRoomId) ?? [], assignment);
+  }
+
+  return {
+    assignments: Array.from(scheduled.values()).sort((a, b) => a.startTime - b.startTime),
+    unscheduled,
+  };
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  assertNoCycles(events);
+
+  if (events.length === 0) {
+    return { assignments: [], unscheduled: [] };
+  }
+
+  const comparators = buildComparators(events, rooms);
+
+  let best: ScheduleResult | null = null;
+  for (const compare of comparators) {
+    const order = topologicalOrder(events, compare);
+    const result = runGreedy(order, events, rooms, options);
+    if (!best || result.assignments.length > best.assignments.length) {
+      best = result;
+    }
+  }
+
+  return best as ScheduleResult;
+}
