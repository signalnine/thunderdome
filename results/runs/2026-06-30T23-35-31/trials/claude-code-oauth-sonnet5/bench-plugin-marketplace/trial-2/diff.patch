+import vm from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+function runSandboxed(code: string, timeoutMs: number, context: Record<string, unknown>): SandboxResult {
+  const start = process.hrtime.bigint();
+  const memBefore = process.memoryUsage().heapUsed;
+
+  try {
+    const sandbox = vm.createContext({ ...context });
+    const wrapped = `(function() {\n${code}\n})()`;
+    const script = new vm.Script(wrapped);
+    const output = script.runInContext(sandbox, { timeout: timeoutMs });
+    const durationMs = Number(process.hrtime.bigint() - start) / 1e6;
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: true,
+      output,
+      duration: durationMs,
+      memoryUsed: Math.max(0, memAfter - memBefore),
+    };
+  } catch (err) {
+    const durationMs = Number(process.hrtime.bigint() - start) / 1e6;
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: false,
+      output: undefined,
+      duration: durationMs,
+      memoryUsed: Math.max(0, memAfter - memBefore),
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  async function execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
