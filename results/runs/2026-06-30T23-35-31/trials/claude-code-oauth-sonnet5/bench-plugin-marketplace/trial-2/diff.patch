+import type { DepsService, DependencyNode, RegistryService } from '../types.js';
+
+export function createDepsService(): DepsService {
+  function buildTree(name: string, registry: RegistryService, ancestors: Set<string> = new Set()): DependencyNode {
+    const manifest = registry.get(name);
+    const version = manifest?.version ?? 'unknown';
+    const depNames = manifest ? Object.keys(manifest.dependencies) : [];
+    const nextAncestors = new Set(ancestors).add(name);
+
+    const dependencies: DependencyNode[] = [];
+    for (const depName of depNames) {
+      if (nextAncestors.has(depName)) continue;
+      dependencies.push(buildTree(depName, registry, nextAncestors));
+    }
+
+    return { name, version, dependencies };
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const visited = new Set<string>();
+    const stack: string[] = [];
+    const onStack = new Set<string>();
+
+    function visit(node: string): void {
+      visited.add(node);
+      stack.push(node);
+      onStack.add(node);
+
+      const manifest = registry.get(node);
+      const depNames = manifest ? Object.keys(manifest.dependencies) : [];
+      for (const dep of depNames) {
+        if (onStack.has(dep)) {
+          const cycleStart = stack.indexOf(dep);
+          cycles.push(stack.slice(cycleStart));
+        } else if (!visited.has(dep)) {
+          visit(dep);
+        }
+      }
+
+      stack.pop();
+      onStack.delete(node);
+    }
+
+    visit(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const visited = new Set<string>();
+    const onStack = new Set<string>();
+    const order: string[] = [];
+
+    function visit(node: string): void {
+      if (visited.has(node)) return;
+      visited.add(node);
+      onStack.add(node);
+
+      const manifest = registry.get(node);
+      const depNames = manifest ? Object.keys(manifest.dependencies) : [];
+      for (const dep of depNames) {
+        if (!onStack.has(dep)) {
+          visit(dep);
+        }
+      }
+
+      onStack.delete(node);
+      order.push(node);
+    }
+
+    visit(name);
+    return order;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    const sorted = topologicalSort(name, registry);
+    return sorted.filter((n) => n !== name);
+  }
+
+  function hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  return { buildTree, detectCycles, topologicalSort, flattenDependencies, hasCircularDependency };
+}
