+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+function dependencyNamesOf(registry: RegistryService, name: string): string[] {
+  const manifest = registry.get(name);
+  return manifest ? Object.keys(manifest.dependencies) : [];
+}
+
+function detectCyclesImpl(name: string, registry: RegistryService): string[][] | null {
+  const cycles: string[][] = [];
+  const visited = new Set<string>();
+  const stack: string[] = [];
+  const onStack = new Set<string>();
+
+  function dfs(node: string): void {
+    if (onStack.has(node)) {
+      const idx = stack.indexOf(node);
+      cycles.push([...stack.slice(idx), node]);
+      return;
+    }
+    if (visited.has(node)) {
+      return;
+    }
+    stack.push(node);
+    onStack.add(node);
+    for (const dep of dependencyNamesOf(registry, node)) {
+      dfs(dep);
+    }
+    stack.pop();
+    onStack.delete(node);
+    visited.add(node);
+  }
+
+  dfs(name);
+  return cycles.length > 0 ? cycles : null;
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      function build(node: string, ancestors: Set<string>): DependencyNode {
+        const manifest = registry.get(node);
+        const version = manifest ? manifest.version : '';
+        const tree: DependencyNode = { name: node, version, dependencies: [] };
+
+        if (ancestors.has(node) || !manifest) {
+          return tree;
+        }
+
+        const nextAncestors = new Set(ancestors);
+        nextAncestors.add(node);
+        for (const depName of Object.keys(manifest.dependencies)) {
+          tree.dependencies.push(build(depName, nextAncestors));
+        }
+        return tree;
+      }
+
+      return build(name, new Set());
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      return detectCyclesImpl(name, registry);
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const result: string[] = [];
+
+      function visit(node: string): void {
+        if (visited.has(node)) {
+          return;
+        }
+        visited.add(node);
+        for (const dep of dependencyNamesOf(registry, node)) {
+          visit(dep);
+        }
+        result.push(node);
+      }
+
+      visit(name);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const result = new Set<string>();
+
+      function visit(node: string): void {
+        for (const dep of dependencyNamesOf(registry, node)) {
+          if (!result.has(dep)) {
+            result.add(dep);
+            visit(dep);
+          }
+        }
+      }
+
+      visit(name);
+      return Array.from(result);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return detectCyclesImpl(name, registry) !== null;
+    },
+  };
+}
