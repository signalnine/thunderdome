+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+function getDependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  if (!manifest) {
+    return [];
+  }
+  return Object.keys(manifest.dependencies);
+}
+
+function buildTreeRecursive(
+  name: string,
+  registry: RegistryService,
+  visiting: Set<string>
+): DependencyNode {
+  const manifest = registry.get(name);
+  const version = manifest?.version ?? 'unknown';
+
+  if (visiting.has(name)) {
+    return { name, version, dependencies: [] };
+  }
+
+  const nextVisiting = new Set(visiting);
+  nextVisiting.add(name);
+
+  const dependencies = getDependencyNames(name, registry)
+    .filter(depName => registry.get(depName) !== null)
+    .map(depName => buildTreeRecursive(depName, registry, nextVisiting));
+
+  return { name, version, dependencies };
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return buildTreeRecursive(name, registry, new Set());
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles: string[][] = [];
+      const visited = new Set<string>();
+      const stack: string[] = [];
+      const onStack = new Set<string>();
+
+      function dfs(node: string): void {
+        if (onStack.has(node)) {
+          const cycleStart = stack.indexOf(node);
+          cycles.push(stack.slice(cycleStart).concat(node));
+          return;
+        }
+        if (visited.has(node)) {
+          return;
+        }
+        visited.add(node);
+        onStack.add(node);
+        stack.push(node);
+
+        for (const depName of getDependencyNames(node, registry)) {
+          if (registry.get(depName) !== null) {
+            dfs(depName);
+          }
+        }
+
+        stack.pop();
+        onStack.delete(node);
+      }
+
+      dfs(name);
+
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const order: string[] = [];
+      const onStack = new Set<string>();
+
+      function visit(node: string): void {
+        if (visited.has(node) || onStack.has(node)) {
+          return;
+        }
+        onStack.add(node);
+
+        for (const depName of getDependencyNames(node, registry)) {
+          if (registry.get(depName) !== null) {
+            visit(depName);
+          }
+        }
+
+        onStack.delete(node);
+        visited.add(node);
+        order.push(node);
+      }
+
+      visit(name);
+
+      return order;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const result: string[] = [];
+
+      function visit(node: string): void {
+        for (const depName of getDependencyNames(node, registry)) {
+          if (visited.has(depName) || registry.get(depName) === null) {
+            continue;
+          }
+          visited.add(depName);
+          result.push(depName);
+          visit(depName);
+        }
+      }
+
+      visit(name);
+
+      return result;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return this.detectCycles(name, registry) !== null;
+    },
+  };
+}
