@@ -0,0 +1,40 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+const ASSET_ATTR_REGEX = /(src|href)="([^"]+)"/g;
+const ABSOLUTE_URL_REGEX = /^(?:[a-z][a-z0-9+.-]*:)?\/\//i;
+
+function isAlreadyRewritten(url: string): boolean {
+  return url.startsWith('/assets/');
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx): ContentFile => {
+        const manifest = (ctx.data.get('asset-manifest') as AssetManifest | undefined) ?? { assets: [] };
+
+        const content = file.content.replace(ASSET_ATTR_REGEX, (match, attr: string, url: string) => {
+          if (ABSOLUTE_URL_REGEX.test(url) || isAlreadyRewritten(url)) {
+            return match;
+          }
+          const filename = url.replace(/^\.\//, '').split('/').pop() as string;
+          if (!manifest.assets.includes(filename)) {
+            manifest.assets.push(filename);
+          }
+          return `${attr}="/assets/${filename}"`;
+        });
+
+        ctx.data.set('asset-manifest', manifest);
+
+        return { ...file, content };
+      },
+    },
+  };
+}
