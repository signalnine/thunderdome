+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+const ADMONITION_REGEX = /:::(note|warning|tip)\n([\s\S]*?)\n:::/g;
+const FOOTNOTE_DEF_REGEX = /^\[\^(\w+)\]:\s*(.+)$/gm;
+const FOOTNOTE_REF_REGEX = /\[\^(\w+)\]/g;
+
+function extractFootnotes(content: string): { content: string; footnotes: Map<string, string> } {
+  const footnotes = new Map<string, string>();
+  const stripped = content.replace(FOOTNOTE_DEF_REGEX, (_match, id: string, text: string) => {
+    footnotes.set(id, text.trim());
+    return '';
+  });
+  return { content: stripped, footnotes };
+}
+
+function renderAdmonitions(content: string): string {
+  return content.replace(ADMONITION_REGEX, (_match, type: string, body: string) => {
+    const inner = marked.parse(body.trim(), { async: false });
+    return `<div class="admonition admonition-${type}">\n${inner}\n</div>`;
+  });
+}
+
+function renderFootnoteRefs(content: string): string {
+  return content.replace(FOOTNOTE_REF_REGEX, (_match, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`);
+}
+
+function renderFootnoteSection(footnotes: Map<string, string>): string {
+  if (footnotes.size === 0) return '';
+  const items = [...footnotes.entries()]
+    .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const { content: withoutFootnoteDefs, footnotes } = extractFootnotes(file.content);
+        const withAdmonitions = renderAdmonitions(withoutFootnoteDefs);
+        const withFootnoteRefs = renderFootnoteRefs(withAdmonitions);
+        const html = marked.parse(withFootnoteRefs, { async: false });
+        const footnoteSection = renderFootnoteSection(footnotes);
+        return { ...file, content: html + footnoteSection };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..bee5a1e
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,70 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function buildTagsBySlug(ctx: BuildContext): Map<string, string[]> {
+  const tagsBySlug = new Map<string, string[]>();
+  const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+  if (!tagMap) return tagsBySlug;
+  for (const [tag, files] of tagMap) {
+    for (const file of files) {
+      const tags = tagsBySlug.get(file.slug) ?? [];
+      tags.push(tag);
+      tagsBySlug.set(file.slug, tags);
+    }
+  }
+  return tagsBySlug;
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext, tags: string[]): string {
+  const link = `${ctx.config.baseUrl}/${file.slug}.html`;
+  const pubDate = file.date ? `\n      <pubDate>${new Date(file.date).toUTCString()}</pubDate>` : '';
+  const categories = tags.map((tag) => `\n      <category>${escapeXml(tag)}</category>`).join('');
+  return `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${link}</link>
+      <guid>${link}</guid>${pubDate}${categories}
+      <description><![CDATA[${file.content}]]></description>
+    </item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const tagsBySlug = buildTagsBySlug(ctx);
+        const sorted = [...ctx.files].sort((a, b) => {
+          const dateA = a.date ? Date.parse(a.date) : -Infinity;
+          const dateB = b.date ? Date.parse(b.date) : -Infinity;
+          return dateB - dateA;
+        });
+
+        const items = sorted
+          .map((file) => renderItem(file, ctx, tagsBySlug.get(file.slug) ?? []))
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${ctx.config.baseUrl}</link>
+    <description>${escapeXml(ctx.config.title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
