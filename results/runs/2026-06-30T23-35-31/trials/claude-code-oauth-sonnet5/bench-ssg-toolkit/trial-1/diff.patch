@@ -0,0 +1,36 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+const ASSET_REF_RE = /(src|href)="\.\/([^"]+)"/g;
+
+interface AssetManifest {
+  assets: string[];
+}
+
+const ASSET_SET_KEY = 'asset-pipeline-discovered';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        let assets = ctx.data.get(ASSET_SET_KEY) as Set<string> | undefined;
+        if (!assets) {
+          assets = new Set<string>();
+          ctx.data.set(ASSET_SET_KEY, assets);
+        }
+
+        const content = file.content.replace(ASSET_REF_RE, (_match, attr: string, rel: string) => {
+          assets!.add(rel);
+          return `${attr}="/assets/${rel}"`;
+        });
+
+        const manifest: AssetManifest = { assets: Array.from(assets) };
+        ctx.data.set('asset-manifest', manifest);
+
+        return { ...file, content };
+      },
+    },
+  };
+}
