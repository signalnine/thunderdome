+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const link = `${baseUrl}/${file.slug}.html`;
+  const pubDate = file.date ? `<pubDate>${new Date(file.date).toUTCString()}</pubDate>` : '';
+  const categories = (file.tags ?? []).map((tag) => `<category>${escapeXml(tag)}</category>`).join('');
+  return `<item><title>${escapeXml(file.title)}</title><link>${link}</link>${pubDate}${categories}<description><![CDATA[${file.content}]]></description></item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const sorted = [...ctx.files].sort((a, b) => {
+          const aTime = a.date ? new Date(a.date).getTime() : -Infinity;
+          const bTime = b.date ? new Date(b.date).getTime() : -Infinity;
+          return bTime - aTime;
+        });
+        const items = sorted.map((file) => renderItem(file, ctx.config.baseUrl)).join('');
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0"><channel><title>${escapeXml(ctx.config.title)}</title><link>${ctx.config.baseUrl}</link>${items}</channel></rss>`;
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
