--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,50 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function buildTagPage(tag: string, files: ContentFile[]): string {
+  const items = files
+    .map((file) => `<li><a href="/${file.slug}.html">${file.title}</a></li>`)
+    .join('');
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tag: ${tag}</title>
+</head>
+<body>
+  <h1>Tag: ${tag}</h1>
+  <ul>${items}</ul>
+</body>
+</html>`;
+}
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        const tagMap = new Map<string, ContentFile[]>();
+        for (const file of ctx.files) {
+          for (const rawTag of file.tags ?? []) {
+            const tag = rawTag.toLowerCase();
+            const existing = tagMap.get(tag);
+            if (existing) {
+              existing.push(file);
+            } else {
+              tagMap.set(tag, [file]);
+            }
+          }
+        }
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+      afterBuild: (ctx: BuildContext): void => {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        if (!tagMap) return;
+        for (const [tag, files] of tagMap) {
+          ctx.output.set(`tags/${tag}.html`, buildTagPage(tag, files));
+        }
+      },
+    },
+  };
+}
