--- /dev/null
+++ b/src/plugins/syntax-highlight.ts
@@ -0,0 +1,22 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+const CODE_BLOCK_RE = /<pre><code class="language-(\w+)">([\s\S]*?)<\/code><\/pre>/g;
+
+function highlight(content: string): string {
+  return content.replace(CODE_BLOCK_RE, (_match, lang: string, code: string) => {
+    return `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`;
+  });
+}
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        return { ...file, content: highlight(file.content) };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
