@@ -0,0 +1,85 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+const FOOTNOTE_DEF_RE = /^\[\^([^\]]+)\]:\s*(.+)$/gm;
+const FOOTNOTE_REF_RE = /\[\^([^\]]+)\]/g;
+const ADMONITION_RE = /:::(\w+)\n([\s\S]*?)\n:::/g;
+
+function footnotePlaceholder(id: string): string {
+  return `XFOOTNOTEREFX${Buffer.from(id).toString('hex')}XENDX`;
+}
+
+function admonitionPlaceholder(index: number): string {
+  return `XADMONITIONBLOCKX${index}XENDX`;
+}
+
+function renderMarkdown(raw: string): string {
+  let content = raw;
+
+  const footnoteDefs = new Map<string, string>();
+  content = content.replace(FOOTNOTE_DEF_RE, (_match, id: string, text: string) => {
+    footnoteDefs.set(id, text.trim());
+    return '';
+  });
+
+  content = content.replace(FOOTNOTE_REF_RE, (_match, id: string) => footnotePlaceholder(id));
+
+  const admonitions: string[] = [];
+  content = content.replace(ADMONITION_RE, (_match, type: string, body: string) => {
+    const index = admonitions.length;
+    const inner = marked.parse(body.trim()) as string;
+    admonitions.push(`<div class="admonition admonition-${type}">\n${inner.trim()}\n</div>`);
+    return admonitionPlaceholder(index);
+  });
+
+  let html = marked.parse(content) as string;
+
+  html = html.replace(/<p>\s*XADMONITIONBLOCKX(\d+)XENDX\s*<\/p>/g, (_match, idx: string) => {
+    return admonitions[Number(idx)] ?? '';
+  });
+  html = html.replace(/XADMONITIONBLOCKX(\d+)XENDX/g, (_match, idx: string) => {
+    return admonitions[Number(idx)] ?? '';
+  });
+
+  const footnoteOrder: string[] = [];
+  const footnoteNumbers = new Map<string, number>();
+  html = html.replace(/XFOOTNOTEREFX([0-9a-f]+)XENDX/g, (_match, hex: string) => {
+    const id = Buffer.from(hex, 'hex').toString('utf8');
+    let num = footnoteNumbers.get(id);
+    if (num === undefined) {
+      num = footnoteOrder.length + 1;
+      footnoteNumbers.set(id, num);
+      footnoteOrder.push(id);
+    }
+    return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+  });
+
+  if (footnoteOrder.length > 0) {
+    const items = footnoteOrder
+      .map((id) => {
+        const num = footnoteNumbers.get(id);
+        const text = footnoteDefs.get(id) ?? '';
+        return `<li id="fn-${num}">${text}</li>`;
+      })
+      .join('');
+    html += `<section class="footnotes">\n<ol>${items}</ol>\n</section>`;
+  }
+
+  return html;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        return {
+          ...file,
+          content: renderMarkdown(file.content),
+        };
+      },
+    },
+  };
+}
