@@ -0,0 +1,47 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+interface AssetManifest {
+  assets: string[];
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assetPaths = manifest ? manifest.assets : [];
+        const assetRoutes: DevServerRoute[] = assetPaths.map((asset) => ({
+          path: `/assets/${asset}`,
+          handler: 'asset',
+        }));
+        const staticRoutes: DevServerRoute[] = Array.from(ctx.output.keys())
+          .filter((key) => key.endsWith('.html'))
+          .map((key) => ({ path: `/${key}`, handler: 'static' }));
+        const searchIndexPath = ctx.output.has('search-index.json') ? '/search-index.json' : '';
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes: [...staticRoutes, ...assetRoutes],
+          assetPaths,
+          searchIndexPath,
+        };
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
