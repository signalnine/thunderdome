diff --git a/src/plugins/asset-pipeline.ts b/src/plugins/asset-pipeline.ts
new file mode 100644
index 0000000..d1e578d
--- /dev/null
+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,37 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+function isRewritable(value: string): boolean {
+  return !/^([a-z]+:)?\/\//i.test(value) && !value.startsWith('/');
+}
+
+function rewriteAssets(content: string, manifest: AssetManifest): string {
+  return content.replace(/(src|href)="([^"]+)"/g, (match, attr: string, value: string) => {
+    if (!isRewritable(value)) return match;
+    const relativePath = value.replace(/^\.\//, '');
+    manifest.assets.push(relativePath);
+    return `${attr}="/assets/${relativePath}"`;
+  });
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        let manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        if (!manifest) {
+          manifest = { assets: [] };
+          ctx.data.set('asset-manifest', manifest);
+        }
+        const content = rewriteAssets(file.content, manifest);
+        return { ...file, content };
+      },
+    },
+  };
+}
