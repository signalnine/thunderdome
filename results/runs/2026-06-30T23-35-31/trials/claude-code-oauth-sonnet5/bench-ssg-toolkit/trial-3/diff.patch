@@ -0,0 +1,22 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+const CODE_BLOCK_RE = /<pre><code class="language-([\w-]+)">([\s\S]*?)<\/code><\/pre>/g;
+
+function highlight(content: string): string {
+  return content.replace(CODE_BLOCK_RE, (_match, lang: string, code: string) => {
+    return `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`;
+  });
+}
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        return { ...file, content: highlight(file.content) };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
index 0000000..1b25c05
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,55 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function buildTagMap(files: ContentFile[]): Map<string, ContentFile[]> {
+  const tagMap = new Map<string, ContentFile[]>();
+  for (const file of files) {
+    for (const rawTag of file.tags || []) {
+      const tag = rawTag.toLowerCase();
+      const existing = tagMap.get(tag);
+      if (existing) {
+        existing.push(file);
+      } else {
+        tagMap.set(tag, [file]);
+      }
+    }
+  }
+  return tagMap;
+}
+
+function renderTagPage(tag: string, files: ContentFile[]): string {
+  const items = files
+    .map(file => `<li><a href="/${file.slug}.html">${file.title}</a></li>`)
+    .join('\n');
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tag: ${tag}</title>
+</head>
+<body>
+  <h1>Tag: ${tag}</h1>
+  <ul>
+${items}
+  </ul>
+</body>
+</html>`;
+}
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx: BuildContext): void => {
+        ctx.data.set('taxonomy-tags', buildTagMap(ctx.files));
+      },
+      afterBuild: (ctx: BuildContext): void => {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;
+        for (const [tag, files] of tagMap) {
+          ctx.output.set(`tags/${tag}.html`, renderTagPage(tag, files));
+        }
+      },
+    },
+  };
+}
