+++ b/src/plugins/dev-server.ts
@@ -0,0 +1,50 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+const NON_CONTENT_OUTPUTS = new Set(['search-index.json', 'sitemap.xml', 'feed.xml']);
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assetPaths = manifest?.assets ?? [];
+
+        const routes: DevServerRoute[] = [];
+        for (const assetPath of assetPaths) {
+          routes.push({ path: `/assets/${assetPath}`, handler: 'asset' });
+        }
+        for (const outputPath of ctx.output.keys()) {
+          if (NON_CONTENT_OUTPUTS.has(outputPath)) continue;
+          routes.push({ path: `/${outputPath}`, handler: 'static' });
+        }
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath: ctx.output.has('search-index.json') ? '/search-index.json' : '',
+        };
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
new file mode 100644
index 0000000..ebe8d5d
--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,75 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  label: string;
+  text: string;
+}
+
+const ADMONITION_TYPES = ['note', 'warning', 'tip'];
+
+function extractAdmonitions(content: string): { content: string; placeholders: Map<string, string> } {
+  const placeholders = new Map<string, string>();
+  let index = 0;
+  const typePattern = ADMONITION_TYPES.join('|');
+  const admonitionRe = new RegExp(`:::(${typePattern})\\n([\\s\\S]*?)\\n:::`, 'g');
+  const replaced = content.replace(admonitionRe, (_match, type: string, body: string) => {
+    const placeholder = `@@ADMONITION_${index++}@@`;
+    const innerHtml = marked.parse(body.trim(), { async: false }) as string;
+    placeholders.set(placeholder, `<div class="admonition admonition-${type}">\n${innerHtml.trim()}\n</div>`);
+    return placeholder;
+  });
+  return { content: replaced, placeholders };
+}
+
+function extractFootnotes(content: string): { content: string; footnotes: Footnote[] } {
+  const footnotes: Footnote[] = [];
+  const definitionRe = /^\[\^([^\]]+)\]:\s*(.*)$/gm;
+  const stripped = content.replace(definitionRe, (_match, label: string, text: string) => {
+    footnotes.push({ label, text: text.trim() });
+    return '';
+  });
+  return { content: stripped, footnotes };
+}
+
+function renderFootnoteRefs(html: string): string {
+  return html.replace(/\[\^([^\]]+)\]/g, (_match, label: string) => {
+    return `<sup><a href="#fn-${label}">${label}</a></sup>`;
+  });
+}
+
+function renderFootnoteSection(footnotes: Footnote[]): string {
+  if (footnotes.length === 0) return '';
+  const items = footnotes.map(fn => `<li id="fn-${fn.label}">${fn.text}</li>`).join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+function applyPlaceholders(html: string, placeholders: Map<string, string>): string {
+  let result = html;
+  for (const [placeholder, replacement] of placeholders) {
+    result = result.replace(`<p>${placeholder}</p>`, replacement);
+    result = result.replace(placeholder, replacement);
+  }
+  return result;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const { content: withoutDefinitions, footnotes } = extractFootnotes(file.content);
+        const { content: withoutAdmonitions, placeholders } = extractAdmonitions(withoutDefinitions);
+
+        let html = marked.parse(withoutAdmonitions, { async: false }) as string;
+        html = applyPlaceholders(html, placeholders);
+        html = renderFootnoteRefs(html);
+        html += renderFootnoteSection(footnotes);
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..2d7efb2
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,50 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const link = `${baseUrl}/${file.slug}.html`;
+  const pubDate = file.date ? `\n<pubDate>${new Date(file.date).toUTCString()}</pubDate>` : '';
+  const categories = (file.tags || []).map(tag => `\n<category>${escapeXml(tag)}</category>`).join('');
+  return `<item>
+<title>${escapeXml(file.title)}</title>
+<link>${link}</link>
+<guid>${link}</guid>${pubDate}${categories}
+<description><![CDATA[${file.content}]]></description>
+</item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { config } = ctx;
+        const sorted = [...ctx.files].sort((a, b) => {
+          const aTime = a.date ? new Date(a.date).getTime() : 0;
+          const bTime = b.date ? new Date(b.date).getTime() : 0;
+          return bTime - aTime;
+        });
+        const items = sorted.map(file => renderItem(file, config.baseUrl)).join('\n');
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+<title>${escapeXml(config.title)}</title>
+<link>${config.baseUrl}</link>
+<description>${escapeXml(config.title)}</description>
+${items}
+</channel>
+</rss>`;
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
