er.id, folder);\n    recordActivity(store, {\n      action: 'folder.create',\n      actorId: userId,\n      resourceType: 'folder',\n      resourceId: folder.id,\n    });\n    res.status(201).json(serializeFolder(folder));\n  });\n\n  router.get('/folders', (req, res) => {\n    const userId = req.userId as string;\n    const visible = Array.from(store.folders.values()).filter((folder) =>\n      roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'viewer'),\n    );\n    res.status(200).json(visible.map(serializeFolder));\n  });\n\n  router.get('/folders/:id', (req, res) => {\n    const userId = req.userId as string;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'viewer')) {\n      res.status(403).json({ error: 'insufficient permission' });\n      return;\n    }\n    res.status(200).json(serializeFolder(folder));\n  });\n\n  router.get('/folders/:id/children', (req, res) => {\n    const userId = req.userId as string;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'viewer')) {\n      res.status(403).json({ error: 'insufficient permission' });\n      return;\n    }\n    const subfolders = Array.from(store.folders.values()).filter((f) => f.parentId === folder.id);\n    const documents = Array.from(store.documents.values()).filter((d) => d.folderId === folder.id);\n    res.status(200).json({ folders: subfolders.map(serializeFolder), documents });\n  });\n\n  const updateFolder: import('express').RequestHandler = (req, res) => {\n    const userId = req.userId as string;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'editor')) {\n      res.status(403).json({ error: 'insufficient permission' });\n      return;\n    }\n    const { name, parentId } = req.body ?? {};\n    if (name !== undefined) {\n      if (typeof name !== 'string' || !name.trim()) {\n        res.status(400).json({ error: 'name must be a non-empty string' });\n        return;\n      }\n      folder.name = name.trim();\n    }\n    if (parentId !== undefined) {\n      if (parentId === null) {\n        folder.parentId = null;\n      } else {\n        if (typeof parentId !== 'string') {\n          res.status(400).json({ error: 'parentId must be a string or null' });\n          return;\n        }\n        if (parentId === folder.id || isDescendantFolder(store, parentId, folder.id)) {\n          res.status(400).json({ error: 'cannot move folder into itself or a descendant' });\n          return;\n        }\n        const newParent = store.folders.get(parentId);\n        if (!newParent) {\n          res.status(404).json({ error: 'parent folder not found' });\n          return;\n        }\n        if (!roleAtLeast(getEffectiveFolderRole(store, userId, parentId), 'editor')) {\n          res.status(403).json({ error: 'insufficient permission on target parent folder' });\n          return;\n        }\n        folder.parentId = parentId;\n      }\n    }\n    folder.updatedAt = new Date().toISOString();\n    recordActivity(store, {\n      action: 'folder.update',\n      actorId: userId,\n      resourceType: 'folder',\n      resourceId: folder.id,\n    });\n    res.status(200).json(serializeFolder(folder));\n  };\n\n  router.patch('/folders/:id', updateFolder);\n  router.put('/folders/:id', updateFolder);\n\n  router.delete('/folders/:id', (req, res) => {\n    const userId = req.userId as string;\n    const folder = store.folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'folder not found' });\n      return;\n    }\n    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'owner')) {\n      res.status(403).json({ error: 'insufficient permission' });\n      return;\n    }\n\n    const foldersToDelete: string[] = [];\n    const stack = [folder.id];\n    while (stack.length) {\n      const current = stack.pop() as string;\n      foldersToDelete.push(current);\n      for (const f of store.folders.values()) {\n        if (f.parentId === current) stack.push(f.id);\n      }\n    }\n    const folderSet = new Set(foldersToDelete);\n    for (const doc of Array.from(store.documents.values())) {\n      if (folderSet.has(doc.folderId)) {\n        store.documents.delete(doc.id);\n        store.shares.delete(`document:${doc.id}`);\n      }\n    }\n    for (const fid of foldersToDelete) {\n      store.folders.delete(fid);\n      store.shares.delete(`folder:${fid}`);\n    }\n\n    recordActivity(store, {\n      action: 'folder.delete',\n      actorId: userId,\n      resourceType: 'folder',\n      resourceId: folder.id,\n      details: { cascadedFolderCount: foldersToDelete.length - 1 },\n    });\n    res.status(204).send();\n  });\n\n  return router;\n}\n","numLines":199,"startLine":1,"totalLines":199}}}
