@@ -0,0 +1,20 @@
+import type { NextFunction, Request, Response } from 'express';
+import type { Store } from './store.js';
+
+export function createRequireAuth(store: Store) {
+  return function requireAuth(req: Request, res: Response, next: NextFunction): void {
+    const header = req.headers.authorization;
+    if (!header || !header.startsWith('Bearer ')) {
+      res.status(401).json({ error: 'Missing or invalid Authorization header' });
+      return;
+    }
+    const token = header.slice('Bearer '.length).trim();
+    const userId = store.tokens.get(token);
+    if (!userId || !store.users.has(userId)) {
+      res.status(401).json({ error: 'Invalid or expired token' });
+      return;
+    }
+    req.userId = userId;
+    next();
+  };
+}
diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..db4aa4e
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,75 @@
+import type { Store } from './store.js';
+import type { Document, Folder, Role } from './types.js';
+
+const ROLE_RANK: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export function roleAtLeast(role: Role | null, min: Role): boolean {
+  if (!role) return false;
+  return ROLE_RANK[role] >= ROLE_RANK[min];
+}
+
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+export function isValidRole(value: unknown): value is Role {
+  return value === 'viewer' || value === 'editor' || value === 'owner';
+}
+
+function getFolderChain(store: Store, folderId: string): Folder[] {
+  const chain: Folder[] = [];
+  const seen = new Set<string>();
+  let current: Folder | undefined = store.folders.get(folderId);
+  while (current && !seen.has(current.id)) {
+    chain.push(current);
+    seen.add(current.id);
+    current = current.parentId ? store.folders.get(current.parentId) : undefined;
+  }
+  return chain;
+}
+
+export function getEffectiveFolderRole(store: Store, userId: string, folderId: string): Role | null {
+  const chain = getFolderChain(store, folderId);
+  let best: Role | null = null;
+  for (const folder of chain) {
+    if (folder.ownerId === userId) {
+      best = maxRole(best, 'owner');
+    }
+    const shared = store.shares.get(`folder:${folder.id}`)?.get(userId);
+    if (shared) {
+      best = maxRole(best, shared);
+    }
+  }
+  return best;
+}
+
+export function getEffectiveDocumentRole(store: Store, userId: string, doc: Document): Role | null {
+  let best: Role | null = null;
+  if (doc.ownerId === userId) {
+    best = maxRole(best, 'owner');
+  }
+  const shared = store.shares.get(`document:${doc.id}`)?.get(userId);
+  if (shared) {
+    best = maxRole(best, shared);
+  }
+  const folderRole = getEffectiveFolderRole(store, userId, doc.folderId);
+  best = maxRole(best, folderRole);
+  return best;
+}
+
+export function isDescendantFolder(store: Store, candidateId: string, ancestorId: string): boolean {
+  let current = store.folders.get(candidateId);
+  const seen = new Set<string>();
+  while (current && current.parentId && !seen.has(current.id)) {
+    seen.add(current.id);
+    if (current.parentId === ancestorId) return true;
+    current = store.folders.get(current.parentId);
+  }
+  return false;
+}
