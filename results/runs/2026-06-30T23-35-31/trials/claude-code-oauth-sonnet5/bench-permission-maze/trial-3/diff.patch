+import { Router } from 'express';
+import { getVisibleActivity } from '../activity.js';
+import { createRequireAuth } from '../middleware.js';
+import type { Store } from '../store.js';
+import type { ResourceType } from '../types.js';
+
+export function createActivityRouter(store: Store): Router {
+  const router = Router();
+  const requireAuth = createRequireAuth(store);
+  router.use(requireAuth);
+
+  router.get('/activity', (req, res) => {
+    const userId = req.userId as string;
+    const { resourceType, resourceId } = req.query;
+    const filters: { resourceType?: ResourceType; resourceId?: string } = {};
+    if (resourceType === 'folder' || resourceType === 'document') {
+      filters.resourceType = resourceType;
+    }
+    if (typeof resourceId === 'string' && resourceId) {
+      filters.resourceId = resourceId;
+    }
+    const entries = getVisibleActivity(store, userId, filters);
+    res.status(200).json(entries);
+  });
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..09d97bb
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,62 @@
+import type { Request, Response, Router } from 'express';
+import { Router as createRouter } from 'express';
+import { generateSalt, generateToken, hashPassword, verifyPassword } from '../auth.js';
+import type { Store } from '../store.js';
+import type { PublicUser } from '../types.js';
+
+function toPublicUser(user: { id: string; username: string }): PublicUser {
+  return { id: user.id, username: user.username };
+}
+
+export function createAuthRouter(store: Store): Router {
+  const router = createRouter();
+
+  function register(req: Request, res: Response): void {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || !username.trim() || typeof password !== 'string' || !password) {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const normalized = username.trim();
+    if (store.usernameToId.has(normalized)) {
+      res.status(400).json({ error: 'username already taken' });
+      return;
+    }
+    const salt = generateSalt();
+    const id = store.nextId('user');
+    const user = {
+      id,
+      username: normalized,
+      passwordHash: hashPassword(password, salt),
+      salt,
+      createdAt: new Date().toISOString(),
+    };
+    store.users.set(id, user);
+    store.usernameToId.set(normalized, id);
+    res.status(201).json({ user: toPublicUser(user) });
+  }
+
+  function login(req: Request, res: Response): void {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const userId = store.usernameToId.get(username.trim());
+    const user = userId ? store.users.get(userId) : undefined;
+    if (!user || !verifyPassword(password, user.salt, user.passwordHash)) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const token = generateToken();
+    store.tokens.set(token, user.id);
+    res.status(200).json({ token, user: toPublicUser(user) });
+  }
+
+  router.post('/auth/register', register);
+  router.post('/users', register);
+  router.post('/auth/login', login);
+  router.post('/login', login);
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..1801dc8
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,154 @@
+import type { RequestHandler } from 'express';
+import { Router } from 'express';
+import { recordActivity } from '../activity.js';
+import { createRequireAuth } from '../middleware.js';
+import { getEffectiveDocumentRole, getEffectiveFolderRole, roleAtLeast } from '../permissions.js';
+import type { Store } from '../store.js';
+import type { Document } from '../types.js';
+
+function serializeDocument(doc: Document): Document {
+  return { ...doc };
+}
+
+export function createDocumentRouter(store: Store): Router {
+  const router = Router();
+  const requireAuth = createRequireAuth(store);
+  router.use(requireAuth);
+
+  const createDocument: RequestHandler = (req, res) => {
+    const userId = req.userId as string;
+    const folderId = req.body?.folderId ?? req.params.folderId;
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || !title.trim()) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (typeof folderId !== 'string' || !folderId) {
+      res.status(400).json({ error: 'folderId is required' });
+      return;
+    }
+    const folder = store.folders.get(folderId);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folderId), 'editor')) {
+      res.status(403).json({ error: 'insufficient permission on folder' });
+      return;
+    }
+    const now = new Date().toISOString();
+    const doc: Document = {
+      id: store.nextId('document'),
+      title: title.trim(),
+      content: typeof content === 'string' ? content : '',
+      folderId,
+      ownerId: userId,
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.documents.set(doc.id, doc);
+    recordActivity(store, {
+      action: 'document.create',
+      actorId: userId,
+      resourceType: 'document',
+      resourceId: doc.id,
+    });
+    res.status(201).json(serializeDocument(doc));
+  };
+
+  router.post('/documents', createDocument);
+  router.post('/folders/:folderId/documents', createDocument);
+
+  router.get('/documents/:id', (req, res) => {
+    const userId = req.userId as string;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveDocumentRole(store, userId, doc), 'viewer')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    res.status(200).json(serializeDocument(doc));
+  });
+
+  const updateDocument: RequestHandler = (req, res) => {
+    const userId = req.userId as string;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveDocumentRole(store, userId, doc), 'editor')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    const { title, content, folderId } = req.body ?? {};
+    if (title !== undefined) {
+      if (typeof title !== 'string' || !title.trim()) {
+        res.status(400).json({ error: 'title must be a non-empty string' });
+        return;
+      }
+      doc.title = title.trim();
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') {
+        res.status(400).json({ error: 'content must be a string' });
+        return;
+      }
+      doc.content = content;
+    }
+    if (folderId !== undefined) {
+      if (typeof folderId !== 'string' || !folderId) {
+        res.status(400).json({ error: 'folderId must be a string' });
+        return;
+      }
+      const targetFolder = store.folders.get(folderId);
+      if (!targetFolder) {
+        res.status(404).json({ error: 'target folder not found' });
+        return;
+      }
+      if (!roleAtLeast(getEffectiveFolderRole(store, userId, folderId), 'editor')) {
+        res.status(403).json({ error: 'insufficient permission on target folder' });
+        return;
+      }
+      doc.folderId = folderId;
+    }
+    doc.updatedAt = new Date().toISOString();
+    recordActivity(store, {
+      action: 'document.update',
+      actorId: userId,
+      resourceType: 'document',
+      resourceId: doc.id,
+    });
+    res.status(200).json(serializeDocument(doc));
+  };
+
+  router.patch('/documents/:id', updateDocument);
+  router.put('/documents/:id', updateDocument);
+
+  router.delete('/documents/:id', (req, res) => {
+    const userId = req.userId as string;
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveDocumentRole(store, userId, doc), 'owner')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    store.documents.delete(doc.id);
+    store.shares.delete(`document:${doc.id}`);
+    recordActivity(store, {
+      action: 'document.delete',
+      actorId: userId,
+      resourceType: 'document',
+      resourceId: doc.id,
+    });
+    res.status(204).send();
+  });
+
+  return router;
+}
