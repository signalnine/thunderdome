diff --git a/src/activity.ts b/src/activity.ts
new file mode 100644
index 0000000..3a47dbd
--- /dev/null
+++ b/src/activity.ts
@@ -0,0 +1,50 @@
+import type { Store } from './store.js';
+import { getEffectiveDocumentRole, getEffectiveFolderRole, roleAtLeast } from './permissions.js';
+import type { ActivityEntry, ResourceType } from './types.js';
+
+export function recordActivity(
+  store: Store,
+  entry: {
+    action: string;
+    actorId: string;
+    resourceType: ResourceType;
+    resourceId: string;
+    details?: Record<string, unknown>;
+  },
+): ActivityEntry {
+  const record: ActivityEntry = {
+    id: store.nextId('activity'),
+    action: entry.action,
+    actorId: entry.actorId,
+    resourceType: entry.resourceType,
+    resourceId: entry.resourceId,
+    timestamp: new Date().toISOString(),
+    ...(entry.details ? { details: entry.details } : {}),
+  };
+  store.activity.push(record);
+  return record;
+}
+
+function canViewResource(store: Store, userId: string, resourceType: ResourceType, resourceId: string): boolean {
+  if (resourceType === 'folder') {
+    return roleAtLeast(getEffectiveFolderRole(store, userId, resourceId), 'viewer') && store.folders.has(resourceId);
+  }
+  const doc = store.documents.get(resourceId);
+  if (!doc) return false;
+  return roleAtLeast(getEffectiveDocumentRole(store, userId, doc), 'viewer');
+}
+
+export function getVisibleActivity(
+  store: Store,
+  userId: string,
+  filters: { resourceType?: ResourceType; resourceId?: string } = {},
+): ActivityEntry[] {
+  return store.activity
+    .filter((entry) => {
+      if (filters.resourceType && entry.resourceType !== filters.resourceType) return false;
+      if (filters.resourceId && entry.resourceId !== filters.resourceId) return false;
+      if (entry.actorId === userId) return true;
+      return canViewResource(store, userId, entry.resourceType, entry.resourceId);
+    })
+    .sort((a, b) => (a.timestamp < b.timestamp ? 1 : -1));
+}
