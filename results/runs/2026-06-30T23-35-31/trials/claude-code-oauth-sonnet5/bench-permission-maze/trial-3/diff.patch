@@ -0,0 +1,198 @@
+import { Router } from 'express';
+import { recordActivity } from '../activity.js';
+import { createRequireAuth } from '../middleware.js';
+import { getEffectiveFolderRole, isDescendantFolder, roleAtLeast } from '../permissions.js';
+import type { Store } from '../store.js';
+import type { Folder } from '../types.js';
+
+function serializeFolder(folder: Folder): Folder {
+  return { ...folder };
+}
+
+export function createFolderRouter(store: Store): Router {
+  const router = Router();
+  const requireAuth = createRequireAuth(store);
+  router.use(requireAuth);
+
+  router.post('/folders', (req, res) => {
+    const userId = req.userId as string;
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || !name.trim()) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    let normalizedParentId: string | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string') {
+        res.status(400).json({ error: 'parentId must be a string' });
+        return;
+      }
+      const parent = store.folders.get(parentId);
+      if (!parent) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      if (!roleAtLeast(getEffectiveFolderRole(store, userId, parentId), 'editor')) {
+        res.status(403).json({ error: 'insufficient permission on parent folder' });
+        return;
+      }
+      normalizedParentId = parentId;
+    }
+    const now = new Date().toISOString();
+    const folder: Folder = {
+      id: store.nextId('folder'),
+      name: name.trim(),
+      parentId: normalizedParentId,
+      ownerId: userId,
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.folders.set(folder.id, folder);
+    recordActivity(store, {
+      action: 'folder.create',
+      actorId: userId,
+      resourceType: 'folder',
+      resourceId: folder.id,
+    });
+    res.status(201).json(serializeFolder(folder));
+  });
+
+  router.get('/folders', (req, res) => {
+    const userId = req.userId as string;
+    const visible = Array.from(store.folders.values()).filter((folder) =>
+      roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'viewer'),
+    );
+    res.status(200).json(visible.map(serializeFolder));
+  });
+
+  router.get('/folders/:id', (req, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'viewer')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    res.status(200).json(serializeFolder(folder));
+  });
+
+  router.get('/folders/:id/children', (req, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'viewer')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    const subfolders = Array.from(store.folders.values()).filter((f) => f.parentId === folder.id);
+    const documents = Array.from(store.documents.values()).filter((d) => d.folderId === folder.id);
+    res.status(200).json({ folders: subfolders.map(serializeFolder), documents });
+  });
+
+  const updateFolder: import('express').RequestHandler = (req, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'editor')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    const { name, parentId } = req.body ?? {};
+    if (name !== undefined) {
+      if (typeof name !== 'string' || !name.trim()) {
+        res.status(400).json({ error: 'name must be a non-empty string' });
+        return;
+      }
+      folder.name = name.trim();
+    }
+    if (parentId !== undefined) {
+      if (parentId === null) {
+        folder.parentId = null;
+      } else {
+        if (typeof parentId !== 'string') {
+          res.status(400).json({ error: 'parentId must be a string or null' });
+          return;
+        }
+        if (parentId === folder.id || isDescendantFolder(store, parentId, folder.id)) {
+          res.status(400).json({ error: 'cannot move folder into itself or a descendant' });
+          return;
+        }
+        const newParent = store.folders.get(parentId);
+        if (!newParent) {
+          res.status(404).json({ error: 'parent folder not found' });
+          return;
+        }
+        if (!roleAtLeast(getEffectiveFolderRole(store, userId, parentId), 'editor')) {
+          res.status(403).json({ error: 'insufficient permission on target parent folder' });
+          return;
+        }
+        folder.parentId = parentId;
+      }
+    }
+    folder.updatedAt = new Date().toISOString();
+    recordActivity(store, {
+      action: 'folder.update',
+      actorId: userId,
+      resourceType: 'folder',
+      resourceId: folder.id,
+    });
+    res.status(200).json(serializeFolder(folder));
+  };
+
+  router.patch('/folders/:id', updateFolder);
+  router.put('/folders/:id', updateFolder);
+
+  router.delete('/folders/:id', (req, res) => {
+    const userId = req.userId as string;
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!roleAtLeast(getEffectiveFolderRole(store, userId, folder.id), 'owner')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+
+    const foldersToDelete: string[] = [];
+    const stack = [folder.id];
+    while (stack.length) {
+      const current = stack.pop() as string;
+      foldersToDelete.push(current);
+      for (const f of store.folders.values()) {
+        if (f.parentId === current) stack.push(f.id);
+      }
+    }
+    const folderSet = new Set(foldersToDelete);
+    for (const doc of Array.from(store.documents.values())) {
+      if (folderSet.has(doc.folderId)) {
+        store.documents.delete(doc.id);
+        store.shares.delete(`document:${doc.id}`);
+      }
+    }
+    for (const fid of foldersToDelete) {
+      store.folders.delete(fid);
+      store.shares.delete(`folder:${fid}`);
+    }
+
+    recordActivity(store, {
+      action: 'folder.delete',
+      actorId: userId,
+      resourceType: 'folder',
+      resourceId: folder.id,
+      details: { cascadedFolderCount: foldersToDelete.length - 1 },
+    });
+    res.status(204).send();
+  });
+
+  return router;
+}
diff --git a/src/routes/share.ts b/src/routes/share.ts
new file mode 100644
index 0000000..9782a37
--- /dev/null
+++ b/src/routes/share.ts
@@ -0,0 +1,150 @@
+import type { Request, RequestHandler, Response } from 'express';
+import { Router } from 'express';
+import { recordActivity } from '../activity.js';
+import { createRequireAuth } from '../middleware.js';
+import {
+  getEffectiveDocumentRole,
+  getEffectiveFolderRole,
+  isValidRole,
+  roleAtLeast,
+} from '../permissions.js';
+import type { Store } from '../store.js';
+import type { ResourceType, Role } from '../types.js';
+
+function resolveTargetUser(store: Store, body: Record<string, unknown>) {
+  if (typeof body.userId === 'string' && body.userId) {
+    return store.users.get(body.userId);
+  }
+  if (typeof body.username === 'string' && body.username) {
+    const id = store.usernameToId.get(body.username.trim());
+    return id ? store.users.get(id) : undefined;
+  }
+  return undefined;
+}
+
+function resourceExists(store: Store, resourceType: ResourceType, resourceId: string): boolean {
+  return resourceType === 'folder' ? store.folders.has(resourceId) : store.documents.has(resourceId);
+}
+
+function getRequesterRole(store: Store, userId: string, resourceType: ResourceType, resourceId: string): Role | null {
+  if (resourceType === 'folder') {
+    return getEffectiveFolderRole(store, userId, resourceId);
+  }
+  const doc = store.documents.get(resourceId);
+  if (!doc) return null;
+  return getEffectiveDocumentRole(store, userId, doc);
+}
+
+export function createShareRouter(store: Store): Router {
+  const router = Router();
+  const requireAuth = createRequireAuth(store);
+  router.use(requireAuth);
+
+  function grantShare(resourceType: ResourceType, resourceId: string, req: Request, res: Response): void {
+    const userId = req.userId as string;
+    if (!resourceExists(store, resourceType, resourceId)) {
+      res.status(404).json({ error: `${resourceType} not found` });
+      return;
+    }
+    const { role } = req.body ?? {};
+    if (!isValidRole(role)) {
+      res.status(400).json({ error: 'role must be one of viewer, editor, owner' });
+      return;
+    }
+    const requesterRole = getRequesterRole(store, userId, resourceType, resourceId);
+    if (!roleAtLeast(requesterRole, 'editor')) {
+      res.status(403).json({ error: 'insufficient permission to share this resource' });
+      return;
+    }
+    if (role === 'owner' && requesterRole !== 'owner') {
+      res.status(403).json({ error: 'only an owner can grant owner role' });
+      return;
+    }
+    const targetUser = resolveTargetUser(store, req.body ?? {});
+    if (!targetUser) {
+      res.status(404).json({ error: 'target user not found' });
+      return;
+    }
+    store.getShareMap(resourceType, resourceId).set(targetUser.id, role);
+    recordActivity(store, {
+      action: 'share.grant',
+      actorId: userId,
+      resourceType,
+      resourceId,
+      details: { targetUserId: targetUser.id, role },
+    });
+    res.status(200).json({ resourceType, resourceId, userId: targetUser.id, role });
+  }
+
+  function revokeShare(resourceType: ResourceType, resourceId: string, targetUserId: string, req: Request, res: Response): void {
+    const userId = req.userId as string;
+    if (!resourceExists(store, resourceType, resourceId)) {
+      res.status(404).json({ error: `${resourceType} not found` });
+      return;
+    }
+    const requesterRole = getRequesterRole(store, userId, resourceType, resourceId);
+    if (!roleAtLeast(requesterRole, 'owner')) {
+      res.status(403).json({ error: 'only an owner can revoke shares' });
+      return;
+    }
+    const shareMap = store.getShareMap(resourceType, resourceId);
+    if (!shareMap.has(targetUserId)) {
+      res.status(404).json({ error: 'share not found' });
+      return;
+    }
+    shareMap.delete(targetUserId);
+    recordActivity(store, {
+      action: 'share.revoke',
+      actorId: userId,
+      resourceType,
+      resourceId,
+      details: { targetUserId },
+    });
+    res.status(204).send();
+  }
+
+  function listShares(resourceType: ResourceType, resourceId: string, req: Request, res: Response): void {
+    const userId = req.userId as string;
+    if (!resourceExists(store, resourceType, resourceId)) {
+      res.status(404).json({ error: `${resourceType} not found` });
+      return;
+    }
+    if (!roleAtLeast(getRequesterRole(store, userId, resourceType, resourceId), 'editor')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    const shares = store.listShares(resourceType, resourceId).map((s) => ({
+      userId: s.userId,
+      username: store.users.get(s.userId)?.username,
+      role: s.role,
+    }));
+    res.status(200).json(shares);
+  }
+
+  const shareFolder: RequestHandler = (req, res) => grantShare('folder', req.params.id, req, res);
+  const shareDocument: RequestHandler = (req, res) => grantShare('document', req.params.id, req, res);
+
+  router.post('/folders/:id/share', shareFolder);
+  router.post('/documents/:id/share', shareDocument);
+
+  router.get('/folders/:id/shares', (req, res) => listShares('folder', req.params.id, req, res));
+  router.get('/documents/:id/shares', (req, res) => listShares('document', req.params.id, req, res));
+
+  router.delete('/folders/:id/share/:userId', (req, res) =>
+    revokeShare('folder', req.params.id, req.params.userId, req, res),
+  );
+  router.delete('/documents/:id/share/:userId', (req, res) =>
+    revokeShare('document', req.params.id, req.params.userId, req, res),
+  );
+
+  router.post('/share', (req, res) => {
+    const { resourceType, resourceId } = req.body ?? {};
+    if ((resourceType !== 'folder' && resourceType !== 'document') || typeof resourceId !== 'string' || !resourceId) {
+      res.status(400).json({ error: 'resourceType (folder|document) and resourceId are required' });
+      return;
+    }
+    grantShare(resourceType, resourceId, req, res);
+  });
+
+  return router;
+}
