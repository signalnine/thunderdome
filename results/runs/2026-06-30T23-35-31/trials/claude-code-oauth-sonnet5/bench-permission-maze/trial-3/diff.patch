ke shares' });\n      return;\n    }\n    const shareMap = store.getShareMap(resourceType, resourceId);\n    if (!shareMap.has(targetUserId)) {\n      res.status(404).json({ error: 'share not found' });\n      return;\n    }\n    shareMap.delete(targetUserId);\n    recordActivity(store, {\n      action: 'share.revoke',\n      actorId: userId,\n      resourceType,\n      resourceId,\n      details: { targetUserId },\n    });\n    res.status(204).send();\n  }\n\n  function listShares(resourceType: ResourceType, resourceId: string, req: Request, res: Response): void {\n    const userId = req.userId as string;\n    if (!resourceExists(store, resourceType, resourceId)) {\n      res.status(404).json({ error: `${resourceType} not found` });\n      return;\n    }\n    if (!roleAtLeast(getRequesterRole(store, userId, resourceType, resourceId), 'editor')) {\n      res.status(403).json({ error: 'insufficient permission' });\n      return;\n    }\n    const shares = store.listShares(resourceType, resourceId).map((s) => ({\n      userId: s.userId,\n      username: store.users.get(s.userId)?.username,\n      role: s.role,\n    }));\n    res.status(200).json(shares);\n  }\n\n  const shareFolder: RequestHandler = (req, res) => grantShare('folder', req.params.id, req, res);\n  const shareDocument: RequestHandler = (req, res) => grantShare('document', req.params.id, req, res);\n\n  router.post('/folders/:id/share', shareFolder);\n  router.post('/documents/:id/share', shareDocument);\n\n  router.get('/folders/:id/shares', (req, res) => listShares('folder', req.params.id, req, res));\n  router.get('/documents/:id/shares', (req, res) => listShares('document', req.params.id, req, res));\n\n  router.delete('/folders/:id/share/:userId', (req, res) =>\n    revokeShare('folder', req.params.id, req.params.userId, req, res),\n  );\n  router.delete('/documents/:id/share/:userId', (req, res) =>\n    revokeShare('document', req.params.id, req.params.userId, req, res),\n  );\n\n  router.post('/share', (req, res) => {\n    const { resourceType, resourceId } = req.body ?? {};\n    if ((resourceType !== 'folder' && resourceType !== 'document') || typeof resourceId !== 'string' || !resourceId) {\n      res.status(400).json({ error: 'resourceType (folder|document) and resourceId are required' });\n      return;\n    }\n    grantShare(resourceType, resourceId, req, res);\n  });\n\n  return router;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
