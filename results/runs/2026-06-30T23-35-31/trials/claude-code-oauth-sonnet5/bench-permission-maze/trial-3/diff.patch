@@ -0,0 +1,36 @@
+import crypto from 'node:crypto';
+import type { ActivityEntry, Document, Folder, Role, User } from './types.js';
+
+export function shareKey(resourceType: 'folder' | 'document', resourceId: string): string {
+  return `${resourceType}:${resourceId}`;
+}
+
+export class Store {
+  users = new Map<string, User>();
+  usernameToId = new Map<string, string>();
+  tokens = new Map<string, string>();
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  shares = new Map<string, Map<string, Role>>();
+  activity: ActivityEntry[] = [];
+
+  nextId(prefix: string): string {
+    return `${prefix}_${crypto.randomUUID()}`;
+  }
+
+  getShareMap(resourceType: 'folder' | 'document', resourceId: string): Map<string, Role> {
+    const key = shareKey(resourceType, resourceId);
+    let map = this.shares.get(key);
+    if (!map) {
+      map = new Map();
+      this.shares.set(key, map);
+    }
+    return map;
+  }
+
+  listShares(resourceType: 'folder' | 'document', resourceId: string): Array<{ userId: string; role: Role }> {
+    const map = this.shares.get(shareKey(resourceType, resourceId));
+    if (!map) return [];
+    return Array.from(map.entries()).map(([userId, role]) => ({ userId, role }));
+  }
+}
