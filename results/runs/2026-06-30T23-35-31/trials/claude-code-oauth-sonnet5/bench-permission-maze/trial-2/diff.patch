@@ -0,0 +1,61 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+}
+
+export interface Session {
+  token: string;
+  userId: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export type ResourceType = 'folder' | 'document';
+
+export interface ShareGrant {
+  resourceType: ResourceType;
+  resourceId: string;
+  userId: string;
+  role: Role;
+}
+
+export type ActivityAction =
+  | 'folder.create'
+  | 'folder.update'
+  | 'folder.delete'
+  | 'document.create'
+  | 'document.update'
+  | 'document.delete'
+  | 'share.create'
+  | 'share.update'
+  | 'share.revoke';
+
+export interface ActivityEntry {
+  id: string;
+  action: ActivityAction;
+  actorId: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  timestamp: string;
+  details?: Record<string, unknown>;
+}
