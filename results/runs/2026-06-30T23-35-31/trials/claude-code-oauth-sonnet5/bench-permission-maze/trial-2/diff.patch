esource.id, requesterId);\n    if (!hasAtLeast(requesterRole, 'editor')) {\n      res.status(403).json({ error: 'insufficient permission to share this resource' });\n      return;\n    }\n\n    const { userId: targetUserId, role } = req.body ?? {};\n    if (typeof targetUserId !== 'string' || !store.users.has(targetUserId)) {\n      res.status(400).json({ error: 'userId must reference an existing user' });\n      return;\n    }\n    if (typeof role !== 'string' || !VALID_ROLES.includes(role as Role)) {\n      res.status(400).json({ error: `role must be one of ${VALID_ROLES.join(', ')}` });\n      return;\n    }\n\n    const existing = store.findShare(resourceType, resource.id, targetUserId);\n\n    if (requesterRole !== 'owner') {\n      if (role === 'owner') {\n        res.status(403).json({ error: 'only an owner can grant the owner role' });\n        return;\n      }\n      if (existing) {\n        res.status(403).json({ error: 'only an owner can modify an existing share' });\n        return;\n      }\n    }\n\n    if (existing) {\n      existing.role = role as Role;\n      logActivity(store, 'share.update', requesterId, resourceType, resource.id, {\n        targetUserId,\n        role,\n      });\n      res.status(200).json(existing);\n      return;\n    }\n\n    const grant = { resourceType, resourceId: resource.id, userId: targetUserId, role: role as Role };\n    store.shares.push(grant);\n    logActivity(store, 'share.create', requesterId, resourceType, resource.id, {\n      targetUserId,\n      role,\n    });\n    res.status(201).json(grant);\n  });\n\n  router.get('/:resourceType/:id/share', (req: AuthedRequest, res: Response) => {\n    const resourceType = req.params.resourceType as ResourceType;\n    if (!VALID_RESOURCE_TYPES.includes(resourceType)) {\n      res.status(400).json({ error: 'resourceType must be folder or document' });\n      return;\n    }\n    const resource = getResource(store, resourceType, req.params.id);\n    if (!resource) {\n      res