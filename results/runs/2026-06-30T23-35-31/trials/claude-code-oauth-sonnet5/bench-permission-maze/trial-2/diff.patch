+import { describe, it, expect, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+
+async function registerAndLogin(app: Express, username: string, password = 'password123') {
+  await request(app).post('/auth/register').send({ username, password }).expect(201);
+  const res = await request(app).post('/auth/login').send({ username, password }).expect(200);
+  return { token: res.body.token as string, userId: res.body.userId as string };
+}
+
+describe('auth', () => {
+  let app: Express;
+  beforeEach(() => {
+    app = createApp();
+  });
+
+  it('registers a new user', async () => {
+    const res = await request(app)
+      .post('/auth/register')
+      .send({ username: 'alice', password: 'secret1' })
+      .expect(201);
+    expect(res.body.username).toBe('alice');
+    expect(res.body.id).toBeDefined();
+    expect(res.body.password).toBeUndefined();
+    expect(res.body.passwordHash).toBeUndefined();
+  });
+
+  it('rejects duplicate usernames', async () => {
+    await request(app).post('/auth/register').send({ username: 'bob', password: 'x' }).expect(201);
+    await request(app).post('/auth/register').send({ username: 'bob', password: 'y' }).expect(409);
+  });
+
+  it('rejects registration with missing fields', async () => {
+    await request(app).post('/auth/register').send({ username: 'nopass' }).expect(400);
+    await request(app).post('/auth/register').send({ password: 'nouser' }).expect(400);
+  });
+
+  it('logs in and returns a token', async () => {
+    await request(app).post('/auth/register').send({ username: 'carol', password: 'secret1' }).expect(201);
+    const res = await request(app)
+      .post('/auth/login')
+      .send({ username: 'carol', password: 'secret1' })
+      .expect(200);
+    expect(res.body.token).toBeDefined();
+    expect(res.body.userId).toBeDefined();
+  });
+
+  it('rejects invalid login credentials', async () => {
+    await request(app).post('/auth/register').send({ username: 'dave', password: 'secret1' }).expect(201);
+    await request(app).post('/auth/login').send({ username: 'dave', password: 'wrong' }).expect(401);
+    await request(app).post('/auth/login').send({ username: 'ghost', password: 'wrong' }).expect(401);
+  });
+
+  it('rejects requests without a token', async () => {
+    await request(app).post('/folders').send({ name: 'x' }).expect(401);
+  });
+
+  it('rejects requests with an invalid token', async () => {
+    await request(app)
+      .post('/folders')
+      .set('Authorization', 'Bearer not-a-real-token')
+      .send({ name: 'x' })
+      .expect(401);
+  });
+});
+
+describe('folders', () => {
+  let app: Express;
+  let alice: { token: string; userId: string };
+
+  beforeEach(async () => {
+    app = createApp();
+    alice = await registerAndLogin(app, 'alice');
+  });
+
+  it('creates a root folder', async () => {
+    const res = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Root' })
+      .expect(201);
+    expect(res.body.name).toBe('Root');
+    expect(res.body.parentId).toBeNull();
+    expect(res.body.ownerId).toBe(alice.userId);
+  });
+
+  it('creates nested folders', async () => {
+    const parent = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Parent' })
+      .expect(201);
+    const child = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Child', parentId: parent.body.id })
+      .expect(201);
+    expect(child.body.parentId).toBe(parent.body.id);
+  });
+
+  it('404s when creating with a nonexistent parent', async () => {
+    await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Orphan', parentId: 'folder_nonexistent' })
+      .expect(404);
+  });
+
+  it('rejects folder creation with empty name', async () => {
+    await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: '' })
+      .expect(400);
+  });
+
+  it('gets a folder by id', async () => {
+    const created = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Docs' })
+      .expect(201);
+    const res = await request(app)
+      .get(`/folders/${created.body.id}`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .expect(200);
+    expect(res.body.id).toBe(created.body.id);
+    expect(res.body.effectiveRole).toBe('owner');
+  });
+
+  it('404s for a nonexistent folder', async () => {
+    await request(app)
+      .get('/folders/folder_nonexistent')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .expect(404);
+  });
+
+  it('updates a folder', async () => {
+    const created = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Old' })
+      .expect(201);
+    const res = await request(app)
+      .patch(`/folders/${created.body.id}`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'New' })
+      .expect(200);
+    expect(res.body.name).toBe('New');
+  });
+
+  it('prevents moving a folder into its own descendant', async () => {
+    const parent = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Parent' })
+      .expect(201);
+    const child = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Child', parentId: parent.body.id })
+      .expect(201);
+    await request(app)
+      .patch(`/folders/${parent.body.id}`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ parentId: child.body.id })
+      .expect(400);
+  });
+
+  it('deletes an empty folder', async () => {
+    const created = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'ToDelete' })
+      .expect(201);
+    await request(app)
+      .delete(`/folders/${created.body.id}`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .expect(204);
+    await request(app)
+      .get(`/folders/${created.body.id}`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .expect(404);
+  });
+
+  it('refuses to delete a folder containing documents', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'HasDocs' })
