diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..d9422ae
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,63 @@
+import type { Store } from './store.js';
+import type { Role } from './types.js';
+
+const ROLE_RANK: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export function roleRank(role: Role): number {
+  return ROLE_RANK[role];
+}
+
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return roleRank(a) >= roleRank(b) ? a : b;
+}
+
+export function hasAtLeast(role: Role | null, required: Role): boolean {
+  if (!role) return false;
+  return roleRank(role) >= roleRank(required);
+}
+
+export function getEffectiveFolderRole(
+  store: Store,
+  folderId: string,
+  userId: string,
+): Role | null {
+  const folder = store.folders.get(folderId);
+  if (!folder) return null;
+
+  let best: Role | null = folder.ownerId === userId ? 'owner' : null;
+
+  const share = store.findShare('folder', folderId, userId);
+  if (share) best = maxRole(best, share.role);
+
+  if (folder.parentId) {
+    const parentRole = getEffectiveFolderRole(store, folder.parentId, userId);
+    best = maxRole(best, parentRole);
+  }
+
+  return best;
+}
+
+export function getEffectiveDocumentRole(
+  store: Store,
+  documentId: string,
+  userId: string,
+): Role | null {
+  const doc = store.documents.get(documentId);
+  if (!doc) return null;
+
+  let best: Role | null = doc.ownerId === userId ? 'owner' : null;
+
+  const share = store.findShare('document', documentId, userId);
+  if (share) best = maxRole(best, share.role);
+
+  const folderRole = getEffectiveFolderRole(store, doc.folderId, userId);
+  best = maxRole(best, folderRole);
+
+  return best;
+}
diff --git a/src/routes/activity.ts b/src/routes/activity.ts
new file mode 100644
index 0000000..5c8058b
--- /dev/null
+++ b/src/routes/activity.ts
@@ -0,0 +1,46 @@
+import { Router } from 'express';
+import type { Response } from 'express';
+import type { Store } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { authMiddleware } from '../auth.js';
+import { getEffectiveDocumentRole, getEffectiveFolderRole, hasAtLeast } from '../permissions.js';
+import type { ActivityEntry } from '../types.js';
+
+function isVisible(store: Store, entry: ActivityEntry, userId: string): boolean {
+  if (entry.actorId === userId) return true;
+  const role =
+    entry.resourceType === 'folder'
+      ? getEffectiveFolderRole(store, entry.resourceId, userId)
+      : getEffectiveDocumentRole(store, entry.resourceId, userId);
+  return hasAtLeast(role, 'viewer');
+}
+
+export function createActivityRouter(store: Store): Router {
+  const router = Router();
+  router.use(authMiddleware(store));
+
+  router.get('/activity', (req: AuthedRequest, res: Response) => {
+    const userId = req.user!.id;
+    const { resourceType, resourceId, actorId, action } = req.query;
+
+    let entries = store.activity.filter((entry) => isVisible(store, entry, userId));
+
+    if (typeof resourceType === 'string') {
+      entries = entries.filter((e) => e.resourceType === resourceType);
+    }
+    if (typeof resourceId === 'string') {
+      entries = entries.filter((e) => e.resourceId === resourceId);
+    }
+    if (typeof actorId === 'string') {
+      entries = entries.filter((e) => e.actorId === actorId);
+    }
+    if (typeof action === 'string') {
+      entries = entries.filter((e) => e.action === action);
+    }
+
+    entries = [...entries].sort((a, b) => b.timestamp.localeCompare(a.timestamp));
+    res.status(200).json(entries);
+  });
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..ea83ac4
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,50 @@
+import { Router } from 'express';
+import type { Store } from '../store.js';
+import { generateId } from '../store.js';
+import { hashPassword, verifyPassword, createToken } from '../auth.js';
+
+export function createAuthRouter(store: Store): Router {
+  const router = Router();
+
+  router.post('/auth/register', (req, res) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || username.trim() === '') {
+      res.status(400).json({ error: 'username is required' });
+      return;
+    }
+    if (typeof password !== 'string' || password.length === 0) {
+      res.status(400).json({ error: 'password is required' });
+      return;
+    }
+    if (store.usersByUsername.has(username)) {
+      res.status(409).json({ error: 'username already taken' });
+      return;
+    }
+    const user = {
+      id: generateId('user'),
+      username,
+      passwordHash: hashPassword(password),
+    };
+    store.users.set(user.id, user);
+    store.usersByUsername.set(username, user);
+    res.status(201).json({ id: user.id, username: user.username });
+  });
+
+  router.post('/auth/login', (req, res) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const user = store.usersByUsername.get(username);
+    if (!user || !verifyPassword(password, user.passwordHash)) {
+      res.status(401).json({ error: 'invalid credentials' });
+      return;
+    }
+    const token = createToken();
+    store.sessions.set(token, { token, userId: user.id });
+    res.status(200).json({ token, userId: user.id });
+  });
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..db32033
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,138 @@
+import { Router } from 'express';
+import type { Response } from 'express';
+import type { Store } from '../store.js';
+import { generateId } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { authMiddleware } from '../auth.js';
+import {
+  getEffectiveDocumentRole,
+  getEffectiveFolderRole,
+  hasAtLeast,
+} from '../permissions.js';
+import { logActivity } from '../activity.js';
+import type { Document } from '../types.js';
+
+export function createDocumentsRouter(store: Store): Router {
+  const router = Router();
+  router.use(authMiddleware(store));
+
+  router.post('/folders/:folderId/documents', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.folderId);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    const userId = req.user!.id;
+    if (!hasAtLeast(getEffectiveFolderRole(store, folder.id, userId), 'editor')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.trim() === '') {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (content !== undefined && typeof content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+
+    const now = new Date().toISOString();
+    const doc: Document = {
+      id: generateId('doc'),
+      title,
+      content: content ?? '',
+      folderId: folder.id,
+      ownerId: userId,
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.documents.set(doc.id, doc);
+    logActivity(store, 'document.create', userId, 'document', doc.id);
+    res.status(201).json(doc);
+  });
+
+  router.get('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    const role = getEffectiveDocumentRole(store, doc.id, req.user!.id);
+    if (!hasAtLeast(role, 'viewer')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    res.status(200).json({ ...doc, effectiveRole: role });
+  });
+
+  router.patch('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    const userId = req.user!.id;
+    const role = getEffectiveDocumentRole(store, doc.id, userId);
+    if (!hasAtLeast(role, 'editor')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+
+    const { title, content, folderId } = req.body ?? {};
+    if (title !== undefined) {
+      if (typeof title !== 'string' || title.trim() === '') {
+        res.status(400).json({ error: 'title must be a non-empty string' });
+        return;
+      }
+      doc.title = title;
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') {
+        res.status(400).json({ error: 'content must be a string' });
+        return;
+      }
+      doc.content = content;
+    }
+    if (folderId !== undefined) {
+      if (typeof folderId !== 'string') {
+        res.status(400).json({ error: 'folderId must be a string' });
+        return;
+      }
+      const targetFolder = store.folders.get(folderId);
+      if (!targetFolder) {
+        res.status(404).json({ error: 'target folder not found' });
+        return;
+      }
+      if (!hasAtLeast(getEffectiveFolderRole(store, folderId, userId), 'editor')) {
+        res.status(403).json({ error: 'insufficient permission on target folder' });
+        return;
+      }
+      doc.folderId = folderId;
+    }
+    doc.updatedAt = new Date().toISOString();
+    logActivity(store, 'document.update', userId, 'document', doc.id);
+    res.status(200).json(doc);
+  });
+
+  router.delete('/documents/:id', (req: AuthedRequest, res: Response) => {
+    const doc = store.documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    const userId = req.user!.id;
+    const role = getEffectiveDocumentRole(store, doc.id, userId);
+    if (!hasAtLeast(role, 'owner')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    store.documents.delete(doc.id);
+    store.removeSharesForResource('document', doc.id);
+    logActivity(store, 'document.delete', userId, 'document', doc.id);
+    res.status(204).send();
+  });
+
+  return router;
+}
diff --git a/src/routes/folders.ts b/src/routes/folders.ts
new file mode 100644
index 0000000..c28af54
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,178 @@
+import { Router } from 'express';
+import type { Response } from 'express';
+import type { Store } from '../store.js';
+import { generateId } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { authMiddleware } from '../auth.js';
+import { getEffectiveFolderRole, hasAtLeast } from '../permissions.js';
+import { logActivity } from '../activity.js';
+import type { Folder } from '../types.js';
+
+function wouldCreateCycle(store: Store, folderId: string, newParentId: string): boolean {
+  let current: string | null = newParentId;
+  while (current) {
+    if (current === folderId) return true;
+    const parent: Folder | undefined = store.folders.get(current);
+    current = parent ? parent.parentId : null;
+  }
+  return false;
+}
+
+export function createFoldersRouter(store: Store): Router {
+  const router = Router();
+  router.use(authMiddleware(store));
+
+  router.post('/folders', (req: AuthedRequest, res: Response) => {
+    const { name, parentId } = req.body ?? {};
+    const userId = req.user!.id;
+
+    if (typeof name !== 'string' || name.trim() === '') {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+
+    let resolvedParentId: string | null = null;
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string') {
+        res.status(400).json({ error: 'parentId must be a string' });
+        return;
+      }
+      const parent = store.folders.get(parentId);
+      if (!parent) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      if (!hasAtLeast(getEffectiveFolderRole(store, parentId, userId), 'editor')) {
+        res.status(403).json({ error: 'insufficient permission on parent folder' });
+        return;
+      }
+      resolvedParentId = parentId;
+    }
+
+    const now = new Date().toISOString();
+    const folder: Folder = {
+      id: generateId('folder'),
+      name,
+      parentId: resolvedParentId,
+      ownerId: userId,
+      createdAt: now,
+      updatedAt: now,
+    };
+    store.folders.set(folder.id, folder);
+    logActivity(store, 'folder.create', userId, 'folder', folder.id);
+    res.status(201).json(folder);
+  });
+
+  router.get('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    const role = getEffectiveFolderRole(store, folder.id, req.user!.id);
+    if (!hasAtLeast(role, 'viewer')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    res.status(200).json({ ...folder, effectiveRole: role });
+  });
+
+  router.patch('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    const userId = req.user!.id;
+    const role = getEffectiveFolderRole(store, folder.id, userId);
+    if (!hasAtLeast(role, 'editor')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+
+    const { name, parentId } = req.body ?? {};
+    if (name !== undefined) {
+      if (typeof name !== 'string' || name.trim() === '') {
+        res.status(400).json({ error: 'name must be a non-empty string' });
+        return;
+      }
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId === null) {
+        folder.parentId = null;
+      } else {
+        if (typeof parentId !== 'string') {
+          res.status(400).json({ error: 'parentId must be a string or null' });
+          return;
+        }
+        const parent = store.folders.get(parentId);
+        if (!parent) {
+          res.status(404).json({ error: 'parent folder not found' });
+          return;
+        }
+        if (!hasAtLeast(getEffectiveFolderRole(store, parentId, userId), 'editor')) {
+          res.status(403).json({ error: 'insufficient permission on parent folder' });
+          return;
+        }
+        if (wouldCreateCycle(store, folder.id, parentId)) {
+          res.status(400).json({ error: 'cannot move folder into its own descendant' });
+          return;
+        }
+        folder.parentId = parentId;
+      }
+    }
+    folder.updatedAt = new Date().toISOString();
+    logActivity(store, 'folder.update', userId, 'folder', folder.id);
+    res.status(200).json(folder);
+  });
+
+  router.delete('/folders/:id', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    const userId = req.user!.id;
+    const role = getEffectiveFolderRole(store, folder.id, userId);
+    if (!hasAtLeast(role, 'owner')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+
+    const childFolderIds = [...store.folders.values()]
+      .filter((f) => f.parentId === folder.id)
+      .map((f) => f.id);
+    if (childFolderIds.length > 0) {
+      res.status(400).json({ error: 'folder has subfolders; delete them first' });
+      return;
+    }
+    const docsInFolder = [...store.documents.values()].filter((d) => d.folderId === folder.id);
+    if (docsInFolder.length > 0) {
+      res.status(400).json({ error: 'folder has documents; delete them first' });
+      return;
+    }
+
+    store.folders.delete(folder.id);
+    store.removeSharesForResource('folder', folder.id);
+    logActivity(store, 'folder.delete', userId, 'folder', folder.id);
+    res.status(204).send();
+  });
+
+  router.get('/folders/:id/documents', (req: AuthedRequest, res: Response) => {
+    const folder = store.folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    const role = getEffectiveFolderRole(store, folder.id, req.user!.id);
+    if (!hasAtLeast(role, 'viewer')) {
+      res.status(403).json({ error: 'insufficient permission' });
+      return;
+    }
+    const docs = [...store.documents.values()].filter((d) => d.folderId === folder.id);
+    res.status(200).json(docs);
+  });
+
+  return router;
+}
diff --git a/src/routes/share.ts b/src/routes/share.ts
new file mode 100644
