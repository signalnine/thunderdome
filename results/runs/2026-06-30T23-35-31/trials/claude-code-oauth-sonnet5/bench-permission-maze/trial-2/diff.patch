@@ -0,0 +1,142 @@
+import { Router } from 'express';
+import type { Response } from 'express';
+import type { Store } from '../store.js';
+import type { AuthedRequest } from '../auth.js';
+import { authMiddleware } from '../auth.js';
+import { getEffectiveDocumentRole, getEffectiveFolderRole, hasAtLeast } from '../permissions.js';
+import { logActivity } from '../activity.js';
+import type { ResourceType, Role } from '../types.js';
+
+const VALID_ROLES: Role[] = ['viewer', 'editor', 'owner'];
+const VALID_RESOURCE_TYPES: ResourceType[] = ['folder', 'document'];
+
+function getResource(store: Store, resourceType: ResourceType, id: string) {
+  return resourceType === 'folder' ? store.folders.get(id) : store.documents.get(id);
+}
+
+function getEffectiveRole(
+  store: Store,
+  resourceType: ResourceType,
+  id: string,
+  userId: string,
+): Role | null {
+  return resourceType === 'folder'
+    ? getEffectiveFolderRole(store, id, userId)
+    : getEffectiveDocumentRole(store, id, userId);
+}
+
+export function createShareRouter(store: Store): Router {
+  const router = Router();
+  router.use(authMiddleware(store));
+
+  router.post('/:resourceType/:id/share', (req: AuthedRequest, res: Response) => {
+    const resourceType = req.params.resourceType as ResourceType;
+    if (!VALID_RESOURCE_TYPES.includes(resourceType)) {
+      res.status(400).json({ error: 'resourceType must be folder or document' });
+      return;
+    }
+    const resource = getResource(store, resourceType, req.params.id);
+    if (!resource) {
+      res.status(404).json({ error: `${resourceType} not found` });
+      return;
+    }
+
+    const requesterId = req.user!.id;
+    const requesterRole = getEffectiveRole(store, resourceType, resource.id, requesterId);
+    if (!hasAtLeast(requesterRole, 'editor')) {
+      res.status(403).json({ error: 'insufficient permission to share this resource' });
+      return;
+    }
+
+    const { userId: targetUserId, role } = req.body ?? {};
+    if (typeof targetUserId !== 'string' || !store.users.has(targetUserId)) {
+      res.status(400).json({ error: 'userId must reference an existing user' });
+      return;
+    }
+    if (typeof role !== 'string' || !VALID_ROLES.includes(role as Role)) {
+      res.status(400).json({ error: `role must be one of ${VALID_ROLES.join(', ')}` });
+      return;
+    }
+
+    const existing = store.findShare(resourceType, resource.id, targetUserId);
+
+    if (requesterRole !== 'owner') {
+      if (role === 'owner') {
+        res.status(403).json({ error: 'only an owner can grant the owner role' });
+        return;
+      }
+      if (existing) {
+        res.status(403).json({ error: 'only an owner can modify an existing share' });
+        return;
+      }
+    }
+
+    if (existing) {
+      existing.role = role as Role;
+      logActivity(store, 'share.update', requesterId, resourceType, resource.id, {
+        targetUserId,
+        role,
+      });
+      res.status(200).json(existing);
+      return;
+    }
+
+    const grant = { resourceType, resourceId: resource.id, userId: targetUserId, role: role as Role };
+    store.shares.push(grant);
+    logActivity(store, 'share.create', requesterId, resourceType, resource.id, {
+      targetUserId,
+      role,
+    });
+    res.status(201).json(grant);
+  });
+
+  router.get('/:resourceType/:id/share', (req: AuthedRequest, res: Response) => {
+    const resourceType = req.params.resourceType as ResourceType;
+    if (!VALID_RESOURCE_TYPES.includes(resourceType)) {
+      res.status(400).json({ error: 'resourceType must be folder or document' });
+      return;
+    }
+    const resource = getResource(store, resourceType, req.params.id);
+    if (!resource) {
+      res.status(404).json({ error: `${resourceType} not found` });
+      return;
+    }
+    const requesterRole = getEffectiveRole(store, resourceType, resource.id, req.user!.id);
+    if (!hasAtLeast(requesterRole, 'editor')) {
+      res.status(403).json({ error: 'insufficient permission to view shares' });
+      return;
+    }
+    res.status(200).json(store.sharesFor(resourceType, resource.id));
+  });
+
+  router.delete('/:resourceType/:id/share/:userId', (req: AuthedRequest, res: Response) => {
+    const resourceType = req.params.resourceType as ResourceType;
+    if (!VALID_RESOURCE_TYPES.includes(resourceType)) {
+      res.status(400).json({ error: 'resourceType must be folder or document' });
+      return;
+    }
+    const resource = getResource(store, resourceType, req.params.id);
+    if (!resource) {
+      res.status(404).json({ error: `${resourceType} not found` });
+      return;
+    }
+    const requesterId = req.user!.id;
+    const requesterRole = getEffectiveRole(store, resourceType, resource.id, requesterId);
+    if (!hasAtLeast(requesterRole, 'owner')) {
+      res.status(403).json({ error: 'only an owner can revoke shares' });
+      return;
+    }
+    const targetUserId = req.params.userId;
+    const removed = store.removeShare(resourceType, resource.id, targetUserId);
+    if (!removed) {
+      res.status(404).json({ error: 'share not found' });
+      return;
+    }
+    logActivity(store, 'share.revoke', requesterId, resourceType, resource.id, {
+      targetUserId,
+    });
+    res.status(204).send();
+  });
+
+  return router;
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..fc0887c
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,56 @@
+import type {
+  User,
+  Session,
+  Folder,
+  Document,
+  ShareGrant,
+  ActivityEntry,
+  ResourceType,
+} from './types.js';
+
+import { randomUUID } from 'node:crypto';
+
+export function generateId(prefix: string): string {
+  return `${prefix}_${randomUUID()}`;
+}
+
+export class Store {
+  users = new Map<string, User>();
+  usersByUsername = new Map<string, User>();
+  sessions = new Map<string, Session>();
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+  shares: ShareGrant[] = [];
+  activity: ActivityEntry[] = [];
+
+  sharesFor(resourceType: ResourceType, resourceId: string): ShareGrant[] {
+    return this.shares.filter(
+      (s) => s.resourceType === resourceType && s.resourceId === resourceId,
+    );
+  }
+
+  findShare(resourceType: ResourceType, resourceId: string, userId: string): ShareGrant | undefined {
+    return this.shares.find(
+      (s) => s.resourceType === resourceType && s.resourceId === resourceId && s.userId === userId,
+    );
+  }
+
+  removeShare(resourceType: ResourceType, resourceId: string, userId: string): boolean {
+    const idx = this.shares.findIndex(
+      (s) => s.resourceType === resourceType && s.resourceId === resourceId && s.userId === userId,
+    );
+    if (idx === -1) return false;
+    this.shares.splice(idx, 1);
+    return true;
+  }
+
+  removeSharesForResource(resourceType: ResourceType, resourceId: string): void {
+    this.shares = this.shares.filter(
+      (s) => !(s.resourceType === resourceType && s.resourceId === resourceId),
+    );
+  }
+}
+
+export function createStore(): Store {
+  return new Store();
+}
