)\n      .send({ title: 'NestedDoc', content: 'x' })\n      .expect(201);\n\n    await request(app)\n      .post(`/folder/${folderId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'viewer' })\n      .expect(201);\n\n    await request(app)\n      .get(`/documents/${nestedDoc.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .expect(200);\n    await request(app)\n      .get(`/folders/${child.body.id}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .expect(200);\n  });\n\n  it('applies the most permissive role when granted through multiple paths', async () => {\n    await request(app)\n      .post(`/folder/${folderId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'viewer' })\n      .expect(201);\n    await request(app)\n      .post(`/document/${docId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'editor' })\n      .expect(201);\n\n    const res = await request(app)\n      .get(`/documents/${docId}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .expect(200);\n    expect(res.body.effectiveRole).toBe('editor');\n  });\n\n  it('prevents an editor from granting the owner role', async () => {\n    await request(app)\n      .post(`/document/${docId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'editor' })\n      .expect(201);\n    const carol = await registerAndLogin(app, 'carol');\n    await request(app)\n      .post(`/document/${docId}/share`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .send({ userId: carol.userId, role: 'owner' })\n      .expect(403);\n  });\n\n  it('allows the owner to revoke a share', async () => {\n    await request(app)\n      .post(`/document/${docId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'viewer' })\n      .expect(201);\n    await request(app)\n      .delete(`/document/${docId}/share/${bob.userId}`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .expect(204);\n    await request(app)\n      .get(`/documents/${docId}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .expect(403);\n  });\n\n  it('prevents a non-owner from revoking a share', async () => {\n    await request(app)\n      .post(`/document/${docId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'editor' })\n      .expect(201);\n    const carol = await registerAndLogin(app, 'carol');\n    await request(app)\n      .post(`/document/${docId}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: carol.userId, role: 'viewer' })\n      .expect(201);\n    await request(app)\n      .delete(`/document/${docId}/share/${carol.userId}`)\n      .set('Authorization', `Bearer ${bob.token}`)\n      .expect(403);\n  });\n});\n\ndescribe('activity log', () => {\n  let app: Express;\n  let alice: { token: string; userId: string };\n  let bob: { token: string; userId: string };\n\n  beforeEach(async () => {\n    app = createApp();\n    alice = await registerAndLogin(app, 'alice');\n    bob = await registerAndLogin(app, 'bob');\n  });\n\n  it('records folder and document creation events', async () => {\n    const folder = await request(app)\n      .post('/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'F1' })\n      .expect(201);\n    await request(app)\n      .post(`/folders/${folder.body.id}/documents`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ title: 'D1', content: 'x' })\n      .expect(201);\n\n    const res = await request(app)\n      .get('/activity')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .expect(200);\n\n    const actions = res.body.map((e: { action: string }) => e.action);\n    expect(actions).toContain('folder.create');\n    expect(actions).toContain('document.create');\n  });\n\n  it('records sharing events', async () => {\n    const folder = await request(app)\n      .post('/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'F1' })\n      .expect(201);\n    await request(app)\n      .post(`/folder/${folder.body.id}/share`)\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ userId: bob.userId, role: 'viewer' })\n      .expect(201);\n\n    const res = await request(app)\n      .get('/activity')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .expect(200);\n    const shareEntry = res.body.find((e: { action: string }) => e.action === 'share.create');\n    expect(shareEntry).toBeDefined();\n    expect(shareEntry.actorId).toBe(alice.userId);\n  });\n\n  it('does not show unrelated private activity to other users', async () => {\n    const folder = await request(app)\n      .post('/folders')\n      .set('Authorization', `Bearer ${alice.token}`)\n      .send({ name: 'Private' })\n      .expect(201);\n\n    const res = await request(app)\n      .get('/activity')\n      .set('Authorization', `Bearer ${bob.token}`)\n      .expect(200);\n    const entry = res.body.find((e: { resourceId: string }) => e.resourceId === folder.body.id);\n    expect(entry).toBeUndefined();\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
