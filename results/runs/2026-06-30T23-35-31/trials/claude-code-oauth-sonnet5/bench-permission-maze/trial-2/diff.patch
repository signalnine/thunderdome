+describe('sharing and permission inheritance', () => {
+  let app: Express;
+  let alice: { token: string; userId: string };
+  let bob: { token: string; userId: string };
+  let folderId: string;
+  let docId: string;
+
+  beforeEach(async () => {
+    app = createApp();
+    alice = await registerAndLogin(app, 'alice');
+    bob = await registerAndLogin(app, 'bob');
+    const folder = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Shared' })
+      .expect(201);
+    folderId = folder.body.id;
+    const doc = await request(app)
+      .post(`/folders/${folderId}/documents`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ title: 'Doc', content: 'v1' })
+      .expect(201);
+    docId = doc.body.id;
+  });
+
+  it('grants direct viewer access to a document', async () => {
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'viewer' })
+      .expect(201);
+
+    await request(app)
+      .get(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(200);
+
+    await request(app)
+      .patch(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .send({ content: 'hacked' })
+      .expect(403);
+  });
+
+  it('grants editor access allowing modification', async () => {
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'editor' })
+      .expect(201);
+
+    await request(app)
+      .patch(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .send({ content: 'edited by bob' })
+      .expect(200);
+
+    await request(app)
+      .delete(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(403);
+  });
+
+  it('inherits folder share permissions on documents within it', async () => {
+    await request(app)
+      .post(`/folder/${folderId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'editor' })
+      .expect(201);
+
+    const res = await request(app)
+      .get(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(200);
+    expect(res.body.effectiveRole).toBe('editor');
+
+    await request(app)
+      .patch(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .send({ content: 'via folder share' })
+      .expect(200);
+  });
+
+  it('inherits permissions through nested folders', async () => {
+    const child = await request(app)
+      .post('/folders')
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ name: 'Nested', parentId: folderId })
+      .expect(201);
+    const nestedDoc = await request(app)
+      .post(`/folders/${child.body.id}/documents`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ title: 'NestedDoc', content: 'x' })
+      .expect(201);
+
+    await request(app)
+      .post(`/folder/${folderId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'viewer' })
+      .expect(201);
+
+    await request(app)
+      .get(`/documents/${nestedDoc.body.id}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(200);
+    await request(app)
+      .get(`/folders/${child.body.id}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(200);
+  });
+
+  it('applies the most permissive role when granted through multiple paths', async () => {
+    await request(app)
+      .post(`/folder/${folderId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'viewer' })
+      .expect(201);
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'editor' })
+      .expect(201);
+
+    const res = await request(app)
+      .get(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(200);
+    expect(res.body.effectiveRole).toBe('editor');
+  });
+
+  it('prevents an editor from granting the owner role', async () => {
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'editor' })
+      .expect(201);
+    const carol = await registerAndLogin(app, 'carol');
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .send({ userId: carol.userId, role: 'owner' })
+      .expect(403);
+  });
+
+  it('allows the owner to revoke a share', async () => {
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'viewer' })
+      .expect(201);
+    await request(app)
+      .delete(`/document/${docId}/share/${bob.userId}`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .expect(204);
+    await request(app)
+      .get(`/documents/${docId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(403);
+  });
+
+  it('prevents a non-owner from revoking a share', async () => {
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: bob.userId, role: 'editor' })
+      .expect(201);
+    const carol = await registerAndLogin(app, 'carol');
+    await request(app)
+      .post(`/document/${docId}/share`)
+      .set('Authorization', `Bearer ${alice.token}`)
+      .send({ userId: carol.userId, role: 'viewer' })
+      .expect(201);
+    await request(app)
+      .delete(`/document/${docId}/share/${carol.userId}`)
+      .set('Authorization', `Bearer ${bob.token}`)
+      .expect(403);
+  });
+});
