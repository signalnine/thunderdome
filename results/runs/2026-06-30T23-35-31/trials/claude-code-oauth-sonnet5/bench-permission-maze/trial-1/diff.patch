ild = await request(a)\n      .post('/folders')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Child', parentId: root.body.id });\n    const doc = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ title: 'Doc', content: 'hi', folderId: child.body.id });\n\n    await request(a).delete(`/folders/${root.body.id}`).set('Authorization', `Bearer ${token}`).expect(204);\n\n    await request(a).get(`/folders/${child.body.id}`).set('Authorization', `Bearer ${token}`).expect(404);\n    await request(a).get(`/documents/${doc.body.id}`).set('Authorization', `Bearer ${token}`).expect(404);\n  });\n});\n\ndescribe('documents', () => {\n  let a: ReturnType<typeof app>;\n  let token: string;\n  let folderId: string;\n\n  beforeEach(async () => {\n    a = app();\n    token = await registerAndLogin(a, 'alice');\n    const folder = await request(a)\n      .post('/folders')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Root' });\n    folderId = folder.body.id;\n  });\n\n  it('creates a document inside a folder', async () => {\n    const res = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ title: 'Doc', content: 'body', folderId });\n    expect(res.status).toBe(201);\n    expect(res.body.title).toBe('Doc');\n    expect(res.body.role).toBe('owner');\n  });\n\n  it('requires editor access on the folder to create a document', async () => {\n    const bobToken = await registerAndLogin(a, 'bob');\n    const res = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ title: 'Doc', content: 'body', folderId });\n    expect(res.status).toBe(403);\n  });\n\n  it('updates and deletes a document', async () => {\n    const created = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ title: 'Doc', content: 'body', folderId });\n\n    const updated = await request(a)\n      .put(`/documents/${created.body.id}`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ content: 'updated body' });\n    expect(updated.status).toBe(200);\n    expect(updated.body.content).toBe('updated body');\n\n    await request(a).delete(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`).expect(204);\n    await request(a).get(`/documents/${created.body.id}`).set('Authorization', `Bearer ${token}`).expect(404);\n  });\n});\n\ndescribe('sharing and effective permissions', () => {\n  let a: ReturnType<typeof app>;\n  let aliceToken: string;\n  let bobToken: string;\n  let folderId: string;\n  let docId: string;\n\n  beforeEach(async () => {\n    a = app();\n    aliceToken = await registerAndLogin(a, 'alice');\n    bobToken = await registerAndLogin(a, 'bob');\n\n    const folder = await request(a)\n      .post('/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Root' });\n    folderId = folder.body.id;\n\n    const doc = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Doc', content: 'body', folderId });\n    docId = doc.body.id;\n  });\n\n  it('denies access to a document with no share', async () => {\n    const res = await request(a).get(`/documents/${docId}`).set('Authorization', `Bearer ${bobToken}`);\n    expect(res.status).toBe(403);\n  });\n\n  it('grants viewer access via direct document share', async () => {\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'viewer' })\n      .expect(200);\n\n    const res = await request(a).get(`/documents/${docId}`).set('Authorization', `Bearer ${bobToken}`);\n    expect(res.status).toBe(200);\n    expect(res.body.role).toBe('viewer');\n\n    const editAttempt = await request(a)\n      .put(`/documents/${docId}`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ content: 'hacked' });\n    expect(editAttempt.status).toBe(403);\n  });\n\n  it('grants access to a document via folder share (inheritance)', async () => {\n    await request(a)\n      .post(`/folders/${folderId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'editor' })\n      .expect(200);\n\n    const res = await request(a).get(`/documents/${docId}`).set('Authorization', `Bearer ${bobToken}`);\n    expect(res.status).toBe(200);\n    expect(res.body.role).toBe('editor');\n\n    const editAttempt = await request(a)\n      .put(`/documents/${docId}`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ content: 'edited by bob' });\n    expect(editAttempt.status).toBe(200);\n  });\n\n  it('grants access via a nested folder chain', async () => {\n    const child = await request(a)\n      .post('/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Child', parentId: folderId });\n    const nestedDoc = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Nested Doc', content: 'x', folderId: child.body.id });\n\n    await request(a)\n      .post(`/folders/${folderId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'viewer' })\n      .expect(200);\n\n    const res = await request(a)\n      .get(`/documents/${nestedDoc.body.id}`)\n      .set('Authorization', `Bearer ${bobToken}`);\n    expect(res.status).toBe(200);\n    expect(res.body.role).toBe('viewer');\n  });\n\n  it('takes the most permissive role across multiple grant paths', async () => {\n    await request(a)\n      .post(`/folders/${folderId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'viewer' })\n      .expect(200);\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'editor' })\n      .expect(200);\n\n    const res = await request(a).get(`/documents/${docId}`).set('Authorization', `Bearer ${bobToken}`);\n    expect(res.body.role).toBe('editor');\n\n    const editAttempt = await request(a)\n      .put(`/documents/${docId}`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ content: 'edited' });\n    expect(editAttempt.status).toBe(200);\n  });\n\n  it('prevents a viewer from sharing the resource further', async () => {\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'viewer' })\n      .expect(200);\n\n    const carolToken = await registerAndLogin(a, 'carol');\n    const res = await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ username: 'carol', role: 'viewer' });\n    expect(res.status).toBe(403);\n    void carolToken;\n  });\n\n  it('allows an editor to share but not grant owner role', async () => {\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'editor' })\n      .expect(200);\n\n    await registerAndLogin(a, 'carol');\n    const shareAsEditor = await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ username: 'carol', role: 'viewer' });\n    expect(shareAsEditor.status).toBe(200);\n\n    const grantOwner = await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${bobToken}`)\n      .send({ username: 'carol', role: 'owner' });\n    expect(grantOwner.status).toBe(403);\n  });\n\n  it('only an owner can delete a document', async () => {\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n    