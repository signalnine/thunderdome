+++ b/src/types.ts
@@ -0,0 +1,66 @@
+export type Role = 'viewer' | 'editor' | 'owner';
+
+export const ROLE_RANK: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export function isRole(value: unknown): value is Role {
+  return value === 'viewer' || value === 'editor' || value === 'owner';
+}
+
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+export interface User {
+  id: string;
+  username: string;
+  passwordHash: string;
+  passwordSalt: string;
+  createdAt: string;
+}
+
+export interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+  updatedAt: string;
+}
+
+export type ResourceType = 'folder' | 'document';
+
+export type ActivityAction =
+  | 'folder.create'
+  | 'folder.update'
+  | 'folder.delete'
+  | 'folder.share'
+  | 'document.create'
+  | 'document.update'
+  | 'document.delete'
+  | 'document.share';
+
+export interface ActivityEntry {
+  id: string;
+  action: ActivityAction;
+  userId: string;
+  resourceType: ResourceType;
+  resourceId: string;
+  timestamp: string;
+  details?: Record<string, unknown>;
+}
