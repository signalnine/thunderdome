e, userId, type, req.params.id, 'editor');\n\n      const shares = store.getSharesFor(type, req.params.id);\n      const result = Array.from(shares.entries()).map(([sharedUserId, role]) => ({\n        userId: sharedUserId,\n        username: store.users.get(sharedUserId)?.username,\n        role,\n      }));\n      res.status(200).json(result);\n    }),\n  );\n\n  router.post(\n    '/:resourceType/:id/share',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const type = resolveResourceType(req.params.resourceType);\n      const id = req.params.id;\n\n      if (type === 'folder') {\n        requireFolder(store, id);\n      } else {\n        requireDocument(store, id);\n      }\n\n      requireAccess(store, userId, type, id, 'editor');\n\n      const { username, role } = req.body as { username?: unknown; role?: unknown };\n      if (typeof username !== 'string' || username.length === 0) {\n        throw new BadRequestError('username is required');\n      }\n      if (!isRole(role)) {\n        throw new BadRequestError('role must be one of viewer, editor, owner');\n      }\n\n      const targetUserId = store.usersByUsername.get(username);\n      if (!targetUserId) {\n        throw new NotFoundError('User not found');\n      }\n      if (targetUserId === userId) {\n        throw new ForbiddenError('cannot change your own access level');\n      }\n\n      const requesterRole = getEffectiveRole(store, userId, type, id);\n      if (role === 'owner' && requesterRole !== 'owner') {\n        throw new ForbiddenError('Only an owner can grant owner access');\n      }\n\n      const shares = store.getSharesFor(type, id);\n      shares.set(targetUserId, role);\n\n      store.logActivity({\n        action: type === 'folder' ? 'folder.share' : 'document.share',\n        userId,\n        resourceType: type,\n        resourceId: id,\n        details: { targetUserId, role },\n      });\n\n      res.status(200).json({ userId: targetUserId, username, role });\n    }),\n  );\n\n  router.delete(\n    '/:resourceType/:id/share/:username',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const type = resolveResourceType(req.params.resourceType);\n      const id = req.params.id;\n\n      requireAccess(store, userId, type, id, 'editor');\n\n      const targetUserId = store.usersByUsername.get(req.params.username);\n      if (!targetUserId) {\n        throw new NotFoundError('User not found');\n      }\n\n      const shares = store.getSharesFor(type, id);\n      const existingRole = shares.get(targetUserId);\n      if (existingRole === 'owner') {\n        const requesterRole = getEffectiveRole(store, userId, type, id);\n        if (requesterRole !== 'owner') {\n          throw new ForbiddenError('Only an owner can revoke owner access');\n        }\n      }\n\n      shares.delete(targetUserId);\n      res.status(204).send();\n    }),\n  );\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1906,"cache_read_input_tokens":52241,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1906},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1092221-4af0-4c6c-b5f8-a96c2882ef32","uuid":"9d3fc985-cef2-4c40-8efd-bc0111643fc5","request_id":"req_011CcaNWPfc522PVGnCqmBVv"}
