n  let a: ReturnType<typeof app>;\n  let aliceToken: string;\n  let bobToken: string;\n  let folderId: string;\n  let docId: string;\n\n  beforeEach(async () => {\n    a = app();\n    aliceToken = await registerAndLogin(a, 'alice');\n    bobToken = await registerAndLogin(a, 'bob');\n\n    const folder = await request(a)\n      .post('/folders')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ name: 'Root' });\n    folderId = folder.body.id;\n\n    const doc = await request(a)\n      .post('/documents')\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ title: 'Doc', content: 'body', folderId });\n    docId = doc.body.id;\n  });\n\n  it('records creation, update, and share events', async () => {\n    await request(a)\n      .put(`/documents/${docId}`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ content: 'v2' })\n      .expect(200);\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'viewer' })\n      .expect(200);\n\n    const res = await request(a).get('/activity').set('Authorization', `Bearer ${aliceToken}`);\n    expect(res.status).toBe(200);\n    const actions = res.body.map((e: { action: string }) => e.action);\n    expect(actions).toContain('folder.create');\n    expect(actions).toContain('document.create');\n    expect(actions).toContain('document.update');\n    expect(actions).toContain('document.share');\n  });\n\n  it('hides activity for resources the user cannot access', async () => {\n    const res = await request(a).get('/activity').set('Authorization', `Bearer ${bobToken}`);\n    expect(res.status).toBe(200);\n    expect(res.body).toEqual([]);\n  });\n\n  it('reveals activity once access is granted', async () => {\n    await request(a)\n      .post(`/documents/${docId}/share`)\n      .set('Authorization', `Bearer ${aliceToken}`)\n      .send({ username: 'bob', role: 'viewer' })\n      .expect