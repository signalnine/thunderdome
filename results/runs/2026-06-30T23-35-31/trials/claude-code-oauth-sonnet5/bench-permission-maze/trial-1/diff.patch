new file mode 100644
index 0000000..f948360
--- /dev/null
+++ b/src/routes/share.ts
@@ -0,0 +1,143 @@
+import { Router } from 'express';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { BadRequestError, ForbiddenError, NotFoundError } from '../errors.js';
+import {
+  getDocumentEffectiveRole,
+  getFolderEffectiveRole,
+  requireDocument,
+  requireDocumentRole,
+  requireFolder,
+  requireFolderRole,
+} from '../permissions.js';
+import type { Store } from '../store.js';
+import { isRole } from '../types.js';
+import type { ResourceType, Role } from '../types.js';
+import { asyncHandler } from '../utils.js';
+
+const PATH_TO_TYPE: Record<string, ResourceType> = {
+  folders: 'folder',
+  documents: 'document',
+};
+
+function resolveResourceType(param: string): ResourceType {
+  const type = PATH_TO_TYPE[param];
+  if (!type) throw new NotFoundError('Unknown resource type');
+  return type;
+}
+
+function requireAccess(store: Store, userId: string, type: ResourceType, id: string, minimum: Role) {
+  if (type === 'folder') {
+    return requireFolderRole(store, userId, id, minimum);
+  }
+  return requireDocumentRole(store, userId, id, minimum);
+}
+
+function getEffectiveRole(store: Store, userId: string, type: ResourceType, id: string): Role | null {
+  return type === 'folder'
+    ? getFolderEffectiveRole(store, userId, id)
+    : getDocumentEffectiveRole(store, userId, id);
+}
+
+export function createShareRouter(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.get(
+    '/:resourceType/:id/shares',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const type = resolveResourceType(req.params.resourceType);
+      requireAccess(store, userId, type, req.params.id, 'editor');
+
+      const shares = store.getSharesFor(type, req.params.id);
+      const result = Array.from(shares.entries()).map(([sharedUserId, role]) => ({
+        userId: sharedUserId,
+        username: store.users.get(sharedUserId)?.username,
+        role,
+      }));
+      res.status(200).json(result);
+    }),
+  );
+
+  router.post(
+    '/:resourceType/:id/share',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const type = resolveResourceType(req.params.resourceType);
+      const id = req.params.id;
+
+      if (type === 'folder') {
+        requireFolder(store, id);
+      } else {
+        requireDocument(store, id);
+      }
+
+      requireAccess(store, userId, type, id, 'editor');
+
+      const { username, role } = req.body as { username?: unknown; role?: unknown };
+      if (typeof username !== 'string' || username.length === 0) {
+        throw new BadRequestError('username is required');
+      }
+      if (!isRole(role)) {
+        throw new BadRequestError('role must be one of viewer, editor, owner');
+      }
+
+      const targetUserId = store.usersByUsername.get(username);
+      if (!targetUserId) {
+        throw new NotFoundError('User not found');
+      }
+      if (targetUserId === userId) {
+        throw new ForbiddenError('cannot change your own access level');
+      }
+
+      const requesterRole = getEffectiveRole(store, userId, type, id);
+      if (role === 'owner' && requesterRole !== 'owner') {
+        throw new ForbiddenError('Only an owner can grant owner access');
+      }
+
+      const shares = store.getSharesFor(type, id);
+      shares.set(targetUserId, role);
+
+      store.logActivity({
+        action: type === 'folder' ? 'folder.share' : 'document.share',
+        userId,
+        resourceType: type,
+        resourceId: id,
+        details: { targetUserId, role },
+      });
+
+      res.status(200).json({ userId: targetUserId, username, role });
+    }),
+  );
+
+  router.delete(
+    '/:resourceType/:id/share/:username',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const type = resolveResourceType(req.params.resourceType);
+      const id = req.params.id;
+
+      requireAccess(store, userId, type, id, 'editor');
+
+      const targetUserId = store.usersByUsername.get(req.params.username);
+      if (!targetUserId) {
+        throw new NotFoundError('User not found');
+      }
+
+      const shares = store.getSharesFor(type, id);
+      const existingRole = shares.get(targetUserId);
+      if (existingRole === 'owner') {
+        const requesterRole = getEffectiveRole(store, userId, type, id);
+        if (requesterRole !== 'owner') {
+          throw new ForbiddenError('Only an owner can revoke owner access');
+        }
+      }
+
+      shares.delete(targetUserId);
+      res.status(204).send();
+    }),
+  );
+
+  return router;
+}
