@@ -0,0 +1,495 @@
+import request from 'supertest';
+import { beforeEach, describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+
+function app() {
+  return createApp();
+}
+
+async function registerAndLogin(a: ReturnType<typeof app>, username: string, password = 'pw123456') {
+  await request(a).post('/auth/register').send({ username, password }).expect(201);
+  const res = await request(a).post('/auth/login').send({ username, password }).expect(200);
+  return res.body.token as string;
+}
+
+describe('auth', () => {
+  let a: ReturnType<typeof app>;
+  beforeEach(() => {
+    a = app();
+  });
+
+  it('registers a new user', async () => {
+    const res = await request(a).post('/auth/register').send({ username: 'alice', password: 'secret' });
+    expect(res.status).toBe(201);
+    expect(res.body.username).toBe('alice');
+    expect(res.body.passwordHash).toBeUndefined();
+  });
+
+  it('rejects duplicate usernames', async () => {
+    await request(a).post('/auth/register').send({ username: 'alice', password: 'secret' }).expect(201);
+    const res = await request(a).post('/auth/register').send({ username: 'alice', password: 'other' });
+    expect(res.status).toBe(409);
+  });
+
+  it('rejects registration missing fields', async () => {
+    const res = await request(a).post('/auth/register').send({ username: 'alice' });
+    expect(res.status).toBe(400);
+  });
+
+  it('logs in and returns a token', async () => {
+    await request(a).post('/auth/register').send({ username: 'alice', password: 'secret' }).expect(201);
+    const res = await request(a).post('/auth/login').send({ username: 'alice', password: 'secret' });
+    expect(res.status).toBe(200);
+    expect(typeof res.body.token).toBe('string');
+  });
+
+  it('rejects bad login credentials', async () => {
+    await request(a).post('/auth/register').send({ username: 'alice', password: 'secret' }).expect(201);
+    const res = await request(a).post('/auth/login').send({ username: 'alice', password: 'wrong' });
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects requests with no token', async () => {
+    const res = await request(a).get('/folders');
+    expect(res.status).toBe(401);
+  });
+
+  it('rejects requests with an invalid token', async () => {
+    const res = await request(a).get('/folders').set('Authorization', 'Bearer garbage');
+    expect(res.status).toBe(401);
+  });
+});
+
+describe('folders', () => {
+  let a: ReturnType<typeof app>;
+  let token: string;
+
+  beforeEach(async () => {
+    a = app();
+    token = await registerAndLogin(a, 'alice');
+  });
+
+  it('creates a root folder', async () => {
+    const res = await request(a)
+      .post('/folders')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ name: 'Root' });
+    expect(res.status).toBe(201);
+    expect(res.body.name).toBe('Root');
+    expect(res.body.parentId).toBeNull();
+    expect(res.body.role).toBe('owner');
+  });
+
+  it('creates a nested folder', async () => {
+    const root = await request(a)
+      .post('/folders')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ name: 'Root' });
+    const child = await request(a)
+      .post('/folders')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ name: 'Child', parentId: root.body.id });
+    expect(child.status).toBe(201);
+    expect(child.body.parentId).toBe(root.body.id);
+  });
+
+  it('rejects nested folder creation without name', async () => {
+    const res = await request(a).post('/folders').set('Authorization', `Bearer ${token}`).send({});
+    expect(res.status).toBe(400);
+  });
+
+  it('404s on unknown parent folder', async () => {
+    const res = await request(a)
+      .post('/folders')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ name: 'Child', parentId: 'nonexistent' });
+    expect(res.status).toBe(404);
+  });
+
+  it('updates and deletes a folder', async () => {
+    const created = await request(a)
+      .post('/folders')
+      .set('Authorization', `Bearer ${token}`)
+      .send({ name: 'Root' });
