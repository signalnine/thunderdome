eFoldersRouter(store: Store): Router {\n  const router = Router();\n  router.use(requireAuth(store));\n\n  router.get(\n    '/',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const accessible = Array.from(store.folders.values()).filter(\n        (folder) => getFolderEffectiveRole(store, userId, folder.id) !== null,\n      );\n      res.status(200).json(accessible.map((folder) => serializeFolder(store, userId, folder)));\n    }),\n  );\n\n  router.post(\n    '/',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const { name, parentId } = req.body as { name?: unknown; parentId?: unknown };\n\n      if (typeof name !== 'string' || name.trim().length === 0) {\n        throw new BadRequestError('name is required');\n      }\n      if (parentId !== undefined && parentId !== null && typeof parentId !== 'string') {\n        throw new BadRequestError('parentId must be a string');\n      }\n\n      if (parentId) {\n        requireFolderRole(store, userId, parentId, 'editor');\n      }\n\n      const id = store.nextId();\n      const timestamp = store.now();\n      const folder: Folder = {\n        id,\n        name,\n        parentId: (parentId as string | undefined) ?? null,\n        ownerId: userId,\n        createdAt: timestamp,\n        updatedAt: timestamp,\n      };\n      store.folders.set(id, folder);\n      store.logActivity({\n        action: 'folder.create',\n        userId,\n        resourceType: 'folder',\n        resourceId: id,\n      });\n\n      res.status(201).json(serializeFolder(store, userId, folder));\n    }),\n  );\n\n  router.get(\n    '/:id',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const folder = requireFolderRole(store, userId, req.params.id, 'viewer');\n      res.status(200).json(serializeFolder(store, userId, folder));\n    }),\n  );\n\n  router.put(\n    '/:id',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const folder = requireFolderRole(store, userId, req.params.id, 'editor');\n      const { name, parentId } = req.body as { name?: unknown; parentId?: unknown };\n\n      if (name !== undefined) {\n        if (typeof name !== 'string' || name.trim().length === 0) {\n          throw new BadRequestError('name must be a non-empty string');\n        }\n        folder.name = name;\n      }\n\n      if (parentId !== undefined) {\n        if (parentId !== null && typeof parentId !== 'string') {\n          throw new BadRequestError('parentId must be a string or null');\n        }\n        if (parentId === folder.id) {\n          throw new BadRequestError('a folder cannot be its own parent');\n        }\n        if (parentId) {\n          requireFolder(store, parentId);\n          requireFolderRole(store, userId, parentId, 'editor');\n          if (isDescendant(store, folder.id, parentId)) {\n            throw new BadRequestError('cannot move a folder into its own descendant');\n          }\n        }\n        folder.parentId = parentId;\n      }\n\n      folder.updatedAt = store.now();\n      store.logActivity({\n        action: 'folder.update',\n        userId,\n        resourceType: 'folder',\n        resourceId: folder.id,\n      });\n\n      res.status(200).json(serializeFolder(store, userId, folder));\n    }),\n  );\n\n  router.delete(\n    '/:id',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const folder = requireFolderRole(store, userId, req.params.id, 'owner');\n\n      const idsToDelete = collectSubtreeIds(store, folder.id);\n      for (const id of idsToDelete) {\n        for (const [docId, doc] of store.documents) {\n          if (doc.folderId === id) {\n            store.documents.delete(docId);\n            store.documentShares.delete(docId);\n          }\n        }\n        store.folders.delete(id);\n        store.folderShares.delete(id);\n      }\n\n      store.logActivity({\n        action: 'folder.delete',\n        userId,\n        resourceType: 'folder',\n        resourceId: folder.id,\n      });\n\n      res.status(204).send();\n    }),\n  );\n\n  return router;\n}\n\nexport { isDescendant };\n\nexport function assertNotSelfShare(userId: string, targetUserId: string): void {\n  if (userId === targetUserId) {\n    throw new ForbiddenError('cannot change your own access level');\n  }\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":482,"cache_read_input_tokens":47841,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":482},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1092221-4af0-4c6c-b5f8-a96c2882ef32","uuid":"d3374176-783d-47c5-a692-8f4ad1e18270","request_id":"req_011CcaNSvk266nLmDBQmxTSx"}
