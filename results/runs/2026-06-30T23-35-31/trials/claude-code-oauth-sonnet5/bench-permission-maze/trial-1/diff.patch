@@ -0,0 +1,44 @@
+import { randomUUID } from 'node:crypto';
+import type { ActivityEntry, Document, Folder, ResourceType, Role, User } from './types.js';
+
+export class Store {
+  users = new Map<string, User>();
+  usersByUsername = new Map<string, string>();
+  tokens = new Map<string, string>();
+
+  folders = new Map<string, Folder>();
+  documents = new Map<string, Document>();
+
+  folderShares = new Map<string, Map<string, Role>>();
+  documentShares = new Map<string, Map<string, Role>>();
+
+  activity: ActivityEntry[] = [];
+
+  nextId(): string {
+    return randomUUID();
+  }
+
+  now(): string {
+    return new Date().toISOString();
+  }
+
+  getSharesFor(type: ResourceType, id: string): Map<string, Role> {
+    const map = type === 'folder' ? this.folderShares : this.documentShares;
+    let shares = map.get(id);
+    if (!shares) {
+      shares = new Map<string, Role>();
+      map.set(id, shares);
+    }
+    return shares;
+  }
+
+  logActivity(entry: Omit<ActivityEntry, 'id' | 'timestamp'>): ActivityEntry {
+    const full: ActivityEntry = {
+      ...entry,
+      id: this.nextId(),
+      timestamp: this.now(),
+    };
+    this.activity.push(full);
+    return full;
+  }
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
