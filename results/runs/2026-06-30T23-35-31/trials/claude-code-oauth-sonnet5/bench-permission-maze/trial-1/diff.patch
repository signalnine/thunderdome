+import { Router } from 'express';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { BadRequestError } from '../errors.js';
+import { getDocumentEffectiveRole, requireDocumentRole, requireFolderRole } from '../permissions.js';
+import type { Store } from '../store.js';
+import type { Document } from '../types.js';
+import { asyncHandler } from '../utils.js';
+
+function serializeDocument(store: Store, userId: string, document: Document) {
+  return {
+    id: document.id,
+    title: document.title,
+    content: document.content,
+    folderId: document.folderId,
+    ownerId: document.ownerId,
+    createdAt: document.createdAt,
+    updatedAt: document.updatedAt,
+    role: getDocumentEffectiveRole(store, userId, document.id),
+  };
+}
+
+export function createDocumentsRouter(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.get(
+    '/',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const { folderId } = req.query as { folderId?: string };
+      let documents = Array.from(store.documents.values());
+      if (folderId) {
+        documents = documents.filter((doc) => doc.folderId === folderId);
+      }
+      const accessible = documents.filter(
+        (doc) => getDocumentEffectiveRole(store, userId, doc.id) !== null,
+      );
+      res.status(200).json(accessible.map((doc) => serializeDocument(store, userId, doc)));
+    }),
+  );
+
+  router.post(
+    '/',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const { title, content, folderId } = req.body as {
+        title?: unknown;
+        content?: unknown;
+        folderId?: unknown;
+      };
+
+      if (typeof title !== 'string' || title.trim().length === 0) {
+        throw new BadRequestError('title is required');
+      }
+      if (content !== undefined && typeof content !== 'string') {
+        throw new BadRequestError('content must be a string');
+      }
+      if (typeof folderId !== 'string' || folderId.length === 0) {
+        throw new BadRequestError('folderId is required');
+      }
+
+      requireFolderRole(store, userId, folderId, 'editor');
+
+      const id = store.nextId();
+      const timestamp = store.now();
+      const document: Document = {
+        id,
+        title,
+        content: (content as string | undefined) ?? '',
+        folderId,
+        ownerId: userId,
+        createdAt: timestamp,
+        updatedAt: timestamp,
+      };
+      store.documents.set(id, document);
+      store.logActivity({
+        action: 'document.create',
+        userId,
+        resourceType: 'document',
+        resourceId: id,
+      });
+
+      res.status(201).json(serializeDocument(store, userId, document));
+    }),
+  );
+
+  router.get(
+    '/:id',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const document = requireDocumentRole(store, userId, req.params.id, 'viewer');
+      res.status(200).json(serializeDocument(store, userId, document));
+    }),
+  );
+
+  router.put(
+    '/:id',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const document = requireDocumentRole(store, userId, req.params.id, 'editor');
+      const { title, content, folderId } = req.body as {
+        title?: unknown;
+        content?: unknown;
+        folderId?: unknown;
+      };
+
+      if (title !== undefined) {
+        if (typeof title !== 'string' || title.trim().length === 0) {
+          throw new BadRequestError('title must be a non-empty string');
+        }
+        document.title = title;
+      }
+
+      if (content !== undefined) {
+        if (typeof content !== 'string') {
+          throw new BadRequestError('content must be a string');
+        }
+        document.content = content;
+      }
+
+      if (folderId !== undefined) {
+        if (typeof folderId !== 'string' || folderId.length === 0) {
+          throw new BadRequestError('folderId must be a non-empty string');
+        }
+        requireFolderRole(store, userId, folderId, 'editor');
+        document.folderId = folderId;
+      }
+
+      document.updatedAt = store.now();
+      store.logActivity({
+        action: 'document.update',
+        userId,
+        resourceType: 'document',
+        resourceId: document.id,
+      });
+
+      res.status(200).json(serializeDocument(store, userId, document));
+    }),
+  );
+
+  router.delete(
+    '/:id',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const document = requireDocumentRole(store, userId, req.params.id, 'owner');
+
+      store.documents.delete(document.id);
+      store.documentShares.delete(document.id);
+
+      store.logActivity({
+        action: 'document.delete',
+        userId,
+        resourceType: 'document',
+        resourceId: document.id,
+      });
+
+      res.status(204).send();
+    }),
+  );
+
+  return router;
+}
diff --git a/src/routes/folders.ts b/src/routes/folders.ts
new file mode 100644
index 0000000..a240c74
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,191 @@
+import { Router } from 'express';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { BadRequestError } from '../errors.js';
+import {
+  getFolderEffectiveRole,
+  requireFolder,
+  requireFolderRole,
+} from '../permissions.js';
+import type { Store } from '../store.js';
+import type { Folder } from '../types.js';
+import { asyncHandler } from '../utils.js';
+
+function serializeFolder(store: Store, userId: string, folder: Folder) {
+  return {
+    id: folder.id,
+    name: folder.name,
+    parentId: folder.parentId,
+    ownerId: folder.ownerId,
+    createdAt: folder.createdAt,
+    updatedAt: folder.updatedAt,
+    role: getFolderEffectiveRole(store, userId, folder.id),
+  };
+}
+
+function isDescendant(store: Store, ancestorId: string, folderId: string): boolean {
+  let current = store.folders.get(folderId);
+  while (current?.parentId) {
+    if (current.parentId === ancestorId) return true;
+    current = store.folders.get(current.parentId);
+  }
+  return false;
+}
+
+function collectSubtreeIds(store: Store, rootId: string): string[] {
+  const childrenByParent = new Map<string, string[]>();
+  for (const folder of store.folders.values()) {
+    if (!folder.parentId) continue;
+    const siblings = childrenByParent.get(folder.parentId) ?? [];
+    siblings.push(folder.id);
+    childrenByParent.set(folder.parentId, siblings);
+  }
+
+  const result: string[] = [];
+  const queue = [rootId];
+  while (queue.length > 0) {
+    const id = queue.shift() as string;
+    result.push(id);
+    const children = childrenByParent.get(id) ?? [];
+    queue.push(...children);
+  }
+  return result;
+}
+
+export function createFoldersRouter(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.get(
+    '/',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const accessible = Array.from(store.folders.values()).filter(
+        (folder) => getFolderEffectiveRole(store, userId, folder.id) !== null,
+      );
+      res.status(200).json(accessible.map((folder) => serializeFolder(store, userId, folder)));
+    }),
+  );
+
+  router.post(
+    '/',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const { name, parentId } = req.body as { name?: unknown; parentId?: unknown };
+
+      if (typeof name !== 'string' || name.trim().length === 0) {
+        throw new BadRequestError('name is required');
+      }
+      if (parentId !== undefined && parentId !== null && typeof parentId !== 'string') {
+        throw new BadRequestError('parentId must be a string');
+      }
+
+      if (parentId) {
+        requireFolderRole(store, userId, parentId, 'editor');
+      }
+
+      const id = store.nextId();
+      const timestamp = store.now();
+      const folder: Folder = {
+        id,
+        name,
+        parentId: (parentId as string | undefined) ?? null,
+        ownerId: userId,
+        createdAt: timestamp,
+        updatedAt: timestamp,
+      };
+      store.folders.set(id, folder);
+      store.logActivity({
+        action: 'folder.create',
+        userId,
+        resourceType: 'folder',
+        resourceId: id,
+      });
+
+      res.status(201).json(serializeFolder(store, userId, folder));
+    }),
+  );
+
+  router.get(
+    '/:id',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const folder = requireFolderRole(store, userId, req.params.id, 'viewer');
+      res.status(200).json(serializeFolder(store, userId, folder));
+    }),
+  );
+
+  router.put(
+    '/:id',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const folder = requireFolderRole(store, userId, req.params.id, 'editor');
+      const { name, parentId } = req.body as { name?: unknown; parentId?: unknown };
+
+      if (name !== undefined) {
+        if (typeof name !== 'string' || name.trim().length === 0) {
+          throw new BadRequestError('name must be a non-empty string');
+        }
+        folder.name = name;
+      }
+
+      if (parentId !== undefined) {
+        if (parentId !== null && typeof parentId !== 'string') {
+          throw new BadRequestError('parentId must be a string or null');
+        }
+        if (parentId === folder.id) {
+          throw new BadRequestError('a folder cannot be its own parent');
+        }
+        if (parentId) {
+          requireFolder(store, parentId);
+          requireFolderRole(store, userId, parentId, 'editor');
+          if (isDescendant(store, folder.id, parentId)) {
+            throw new BadRequestError('cannot move a folder into its own descendant');
+          }
+        }
+        folder.parentId = parentId;
+      }
+
+      folder.updatedAt = store.now();
+      store.logActivity({
+        action: 'folder.update',
+        userId,
+        resourceType: 'folder',
+        resourceId: folder.id,
+      });
+
+      res.status(200).json(serializeFolder(store, userId, folder));
+    }),
+  );
+
+  router.delete(
+    '/:id',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const folder = requireFolderRole(store, userId, req.params.id, 'owner');
+
+      const idsToDelete = collectSubtreeIds(store, folder.id);
+      for (const id of idsToDelete) {
+        for (const [docId, doc] of store.documents) {
+          if (doc.folderId === id) {
+            store.documents.delete(docId);
+            store.documentShares.delete(docId);
+          }
+        }
+        store.folders.delete(id);
+        store.folderShares.delete(id);
+      }
+
+      store.logActivity({
+        action: 'folder.delete',
+        userId,
+        resourceType: 'folder',
+        resourceId: folder.id,
+      });
+
+      res.status(204).send();
+    }),
+  );
+
+  return router;
+}
