 title?: unknown;\n        content?: unknown;\n        folderId?: unknown;\n      };\n\n      if (typeof title !== 'string' || title.trim().length === 0) {\n        throw new BadRequestError('title is required');\n      }\n      if (content !== undefined && typeof content !== 'string') {\n        throw new BadRequestError('content must be a string');\n      }\n      if (typeof folderId !== 'string' || folderId.length === 0) {\n        throw new BadRequestError('folderId is required');\n      }\n\n      requireFolderRole(store, userId, folderId, 'editor');\n\n      const id = store.nextId();\n      const timestamp = store.now();\n      const document: Document = {\n        id,\n        title,\n        content: (content as string | undefined) ?? '',\n        folderId,\n        ownerId: userId,\n        createdAt: timestamp,\n        updatedAt: timestamp,\n      };\n      store.documents.set(id, document);\n      store.logActivity({\n        action: 'document.create',\n        userId,\n        resourceType: 'document',\n        resourceId: id,\n      });\n\n      res.status(201).json(serializeDocument(store, userId, document));\n    }),\n  );\n\n  router.get(\n    '/:id',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const document = requireDocumentRole(store, userId, req.params.id, 'viewer');\n      res.status(200).json(serializeDocument(store, userId, document));\n    }),\n  );\n\n  router.put(\n    '/:id',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const document = requireDocumentRole(store, userId, req.params.id, 'editor');\n      const { title, content, folderId } = req.body as {\n        title?: unknown;\n        content?: unknown;\n        folderId?: unknown;\n      };\n\n      if (title !== undefined) {\n        if (typeof title !== 'string' || title.trim().length === 0) {\n          throw new BadRequestError('title must be a non-empty string');\n        }\n        document.title = title;\n      }\n\n      if (content !== undefined) {\n        if (typeof content !== 'string') {\n          throw new BadRequestError('content must be a string');\n        }\n        document.content = content;\n      }\n\n      if (folderId !== undefined) {\n        if (typeof folderId !== 'string' || folderId.length === 0) {\n          throw new BadRequestError('folderId must be a non-empty string');\n        }\n        requireFolderRole(store, userId, folderId, 'editor');\n        document.folderId = folderId;\n      }\n\n      document.updatedAt = store.now();\n      store.logActivity({\n        action: 'document.update',\n        userId,\n        resourceType: 'document',\n        resourceId: document.id,\n      });\n\n      res.status(200).json(serializeDocument(store, userId, document));\n    }),\n  );\n\n  router.delete(\n    '/:id',\n    asyncHandler(async (req: AuthedRequest, res) => {\n      const userId = req.userId as string;\n      const document = requireDocumentRole(store, userId, req.params.id, 'owner');\n\n      store.documents.delete(document.id);\n      store.documentShares.delete(document.id);\n\n      store.logActivity({\n        action: 'document.delete',\n        userId,\n        resourceType: 'document',\n        resourceId: document.id,\n      });\n\n      res.status(204).send();\n    }),\n  );\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":306,"cache_read_input_tokens":51935,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":306},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1092221-4af0-4c6c-b5f8-a96c2882ef32","uuid":"81747c7f-d3c3-479d-9959-680c254901cf","request_id":"req_011CcaNVRVxKCjUoq33oPCw6"}
