diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..361563d
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,70 @@
+import { ForbiddenError, NotFoundError } from './errors.js';
+import type { Store } from './store.js';
+import { maxRole, ROLE_RANK } from './types.js';
+import type { Document, Folder, Role } from './types.js';
+
+export function getFolderEffectiveRole(store: Store, userId: string, folderId: string): Role | null {
+  const folder = store.folders.get(folderId);
+  if (!folder) return null;
+
+  let best: Role | null = folder.ownerId === userId ? 'owner' : null;
+
+  const shareRole = store.folderShares.get(folderId)?.get(userId) ?? null;
+  best = maxRole(best, shareRole);
+
+  if (folder.parentId) {
+    const parentRole = getFolderEffectiveRole(store, userId, folder.parentId);
+    best = maxRole(best, parentRole);
+  }
+
+  return best;
+}
+
+export function getDocumentEffectiveRole(store: Store, userId: string, documentId: string): Role | null {
+  const document = store.documents.get(documentId);
+  if (!document) return null;
+
+  let best: Role | null = document.ownerId === userId ? 'owner' : null;
+
+  const shareRole = store.documentShares.get(documentId)?.get(userId) ?? null;
+  best = maxRole(best, shareRole);
+
+  const folderRole = getFolderEffectiveRole(store, userId, document.folderId);
+  best = maxRole(best, folderRole);
+
+  return best;
+}
+
+export function requireFolder(store: Store, folderId: string): Folder {
+  const folder = store.folders.get(folderId);
+  if (!folder) throw new NotFoundError('Folder not found');
+  return folder;
+}
+
+export function requireDocument(store: Store, documentId: string): Document {
+  const document = store.documents.get(documentId);
+  if (!document) throw new NotFoundError('Document not found');
+  return document;
+}
+
+function hasRank(role: Role | null, minimum: Role): boolean {
+  return role !== null && ROLE_RANK[role] >= ROLE_RANK[minimum];
+}
+
+export function requireFolderRole(store: Store, userId: string, folderId: string, minimum: Role): Folder {
+  const folder = requireFolder(store, folderId);
+  const role = getFolderEffectiveRole(store, userId, folderId);
+  if (!hasRank(role, minimum)) {
+    throw new ForbiddenError(`Requires ${minimum} access to folder`);
+  }
+  return folder;
+}
+
+export function requireDocumentRole(store: Store, userId: string, documentId: string, minimum: Role): Document {
+  const document = requireDocument(store, documentId);
+  const role = getDocumentEffectiveRole(store, userId, documentId);
+  if (!hasRank(role, minimum)) {
+    throw new ForbiddenError(`Requires ${minimum} access to document`);
+  }
+  return document;
+}
diff --git a/src/routes/activity.ts b/src/routes/activity.ts
new file mode 100644
index 0000000..bf964f5
--- /dev/null
+++ b/src/routes/activity.ts
@@ -0,0 +1,33 @@
+import { Router } from 'express';
+import type { AuthedRequest } from '../auth.js';
+import { requireAuth } from '../auth.js';
+import { getDocumentEffectiveRole, getFolderEffectiveRole } from '../permissions.js';
+import type { Store } from '../store.js';
+import { asyncHandler } from '../utils.js';
+
+export function createActivityRouter(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.get(
+    '/',
+    asyncHandler(async (req: AuthedRequest, res) => {
+      const userId = req.userId as string;
+      const { resourceId } = req.query as { resourceId?: string };
+
+      const visible = store.activity.filter((entry) => {
+        if (resourceId && entry.resourceId !== resourceId) return false;
+        if (entry.userId === userId) return true;
+        const role =
+          entry.resourceType === 'folder'
+            ? getFolderEffectiveRole(store, userId, entry.resourceId)
+            : getDocumentEffectiveRole(store, userId, entry.resourceId);
+        return role !== null;
+      });
+
+      res.status(200).json(visible.slice().reverse());
+    }),
+  );
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..92e4943
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,62 @@
+import { Router } from 'express';
+import { createToken, hashPassword, verifyPassword } from '../auth.js';
+import { BadRequestError, ConflictError, UnauthorizedError } from '../errors.js';
+import type { Store } from '../store.js';
+import { asyncHandler } from '../utils.js';
+
+export function createAuthRouter(store: Store): Router {
+  const router = Router();
+
+  router.post(
+    '/register',
+    asyncHandler(async (req, res) => {
+      const { username, password } = req.body as { username?: unknown; password?: unknown };
+      if (typeof username !== 'string' || username.trim().length === 0) {
+        throw new BadRequestError('username is required');
+      }
+      if (typeof password !== 'string' || password.length === 0) {
+        throw new BadRequestError('password is required');
+      }
+      if (store.usersByUsername.has(username)) {
+        throw new ConflictError('username already exists');
+      }
+
+      const { hash, salt } = hashPassword(password);
+      const id = store.nextId();
+      const user = {
+        id,
+        username,
+        passwordHash: hash,
+        passwordSalt: salt,
+        createdAt: store.now(),
+      };
+      store.users.set(id, user);
+      store.usersByUsername.set(username, id);
+
+      res.status(201).json({ id: user.id, username: user.username, createdAt: user.createdAt });
+    }),
+  );
+
+  router.post(
+    '/login',
+    asyncHandler(async (req, res) => {
+      const { username, password } = req.body as { username?: unknown; password?: unknown };
+      if (typeof username !== 'string' || typeof password !== 'string') {
+        throw new BadRequestError('username and password are required');
+      }
+
+      const userId = store.usersByUsername.get(username);
+      const user = userId ? store.users.get(userId) : undefined;
+      if (!user || !verifyPassword(password, user.passwordSalt, user.passwordHash)) {
+        throw new UnauthorizedError('Invalid username or password');
+      }
+
+      const token = createToken();
+      store.tokens.set(token, user.id);
+
+      res.status(200).json({ token, userId: user.id, username: user.username });
+    }),
+  );
+
+  return router;
+}
