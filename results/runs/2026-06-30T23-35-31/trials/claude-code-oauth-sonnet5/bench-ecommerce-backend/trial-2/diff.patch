@@ -0,0 +1,61 @@
+import { EventBus } from '../bus.js';
+import {
+  NotificationService,
+  Events,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribed = new Set<string>();
+  const notifications = new Map<string, Notification[]>();
+  const orderUsers = new Map<string, string>();
+
+  function notify(userId: string, type: string, message: string): void {
+    if (!subscribed.has(userId)) return;
+    const notification: Notification = { type, message, timestamp: Date.now() };
+    const list = notifications.get(userId) ?? [];
+    list.push(notification);
+    notifications.set(userId, list);
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type, message });
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const event = payload as OrderCreatedEvent;
+    orderUsers.set(event.orderId, event.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const event = payload as OrderStatusChangedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (!userId) return;
+    notify(userId, 'order_status', `Order ${event.orderId} status changed to ${event.status}`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const event = payload as PaymentProcessedEvent;
+    const userId = orderUsers.get(event.orderId);
+    if (!userId) return;
+    notify(userId, 'payment', `Payment for order ${event.orderId} ${event.status}`);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribed.add(userId);
+      if (!notifications.has(userId)) {
+        notifications.set(userId, []);
+      }
+    },
+
+    getNotifications(userId: string) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
