@@ -0,0 +1,69 @@
+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { CartService, Events } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitUpdate(cart: Cart): void {
+    void bus.emit(Events.CART_UPDATED, { cartId: cart.id, userId: cart.userId, items: cart.items });
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = uuidv4();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const item = cart.items.find((i) => i.productId === productId);
+      if (item) {
+        item.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = cart.items.filter((i) => i.productId !== productId);
+      emitUpdate(cart);
+    },
+
+    getCart(cartId: string) {
+      return carts.get(cartId) ?? null;
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = [];
+      emitUpdate(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const item = cart.items.find((i) => i.productId === productId);
+      if (!item) return;
+      item.quantity = quantity;
+      emitUpdate(cart);
+    },
+  };
+}
