+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0132X5Po8pMi4ZKaSL13dk3q","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach } from 'vitest';\n2\timport { createHash } from 'crypto';\n3\timport { readFileSync, readdirSync } from 'fs';\n4\timport { resolve, dirname } from 'path';\n5\timport { fileURLToPath } from 'url';\n6\timport { EventBus } from '../src/bus.js';\n7\timport { Events, OrderStatus, PaymentStatus } from '../src/types.js';\n8\timport { createCatalogService } from '../src/catalog/index.js';\n9\timport { createInventoryService } from '../src/inventory/index.js';\n10\timport { createCartService } from '../src/cart/index.js';\n11\timport { createPricingService } from '../src/pricing/index.js';\n12\timport { createOrderService } from '../src/orders/index.js';\n13\timport { createPaymentService } from '../src/payment/index.js';\n14\timport { createNotificationService } from '../src/notifications/index.js';\n15\timport { createAnalyticsService } from '../src/analytics/index.js';\n16\t\n17\tconst __filename = fileURLToPath(import.meta.url);\n18\tconst __dirname = dirname(__filename);\n19\tconst srcDir = resolve(__dirname, '..', 'src');\n20\t\n21\tfunction sha256(filePath: string): string {\n22\t  const content = readFileSync(filePath, 'utf-8');\n23\t  return createHash('sha256').update(content).digest('hex');\n24\t}\n25\t\n26\tdescribe('Integration Tests', () => {\n27\t  let bus: EventBus;\n28\t  let catalog: ReturnType<typeof createCatalogService>;\n29\t  let inventory: ReturnType<typeof createInventoryService>;\n30\t  let cart: ReturnType<typeof createCartService>;\n31\t  let pricing: ReturnType<typeof createPricingService>;\n32\t  let orders: ReturnType<typeof createOrderService>;\n33\t  let payment: ReturnType<typeof createPaymentService>;\n34\t  let notifications: ReturnType<typeof createNotificationService>;\n35\t  let analytics: ReturnType<typeof createAnalyticsService>;\n36\t\n37\t  beforeEach(() => {\n38\t    bus = new EventBus();\n39\t    catalog = createCatalogService(bus);\n40\t    inventory = createInventoryService(bus);\n41\t    cart = createCartService(bus);\n42\t    pricing = createPricingService(bus);\n43\t    orders = createOrderService(bus);\n44\t    payment = createPaymentService(bus);\n45\t    notifications = createNotificationService(bus);\n46\t    analytics = createAnalyticsService(bus);\n47\t  });\n48\t\n49\t  // 1-3: Product catalog CRUD through bus events\n50\t  it('1. should create a product and emit product:created event', () => {\n51\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n52\t    expect(id).toBeDefined();\n53\t    const log = bus.getLog();\n54\t    const createEvents = log.filter(e => e.event === Events.PRODUCT_CREATED);\n55\t    expect(createEvents).toHaveLength(1);\n56\t    const payload = createEvents[0].payload as { productId: string; name: string };\n57\t    expect(payload.productId).toBe(id);\n58\t    expect(payload.name).toBe('Laptop');\n59\t  });\n60\t\n61\t  it('2. should update a product and retrieve updated data', () => {\n62\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n63\t    catalog.updateProduct(id, { price: 899.99, name: 'Gaming Laptop' });\n64\t    const product = catalog.getProduct(id);\n65\t    expect(product!.price).toBe(899.99);\n66\t    expect(product!.name).toBe('Gaming Laptop');\n67\t  });\n68\t\n69\t  it('3. should remove a product and confirm deletion', () => {\n70\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n71\t    expect(catalog.removeProduct(id)).toBe(true);\n72\t    expect(catalog.getProduct(id)).toBeNull();\n73\t    expect(catalog.listProducts()).toHaveLength(0);\n74\t  });\n75\t\n76\t  // 4-5: Inventory management with stock events\n77\t  it('4. should set stock and emit inventory:updated event', () => {\n78\t    inventory.setStock('p1', 100);\n79\t    const log = bus.getLog();\n80\t    const invEvents = log.filter(e => e.event === Events.INVENTORY_UPDATED);\n81\t    expect(invEvents.length).toBeGreaterThanOrEqual(1);\n82\t    const payload = invEvents[0].payload as { productId: string; quantity: number };\n83\t    expect(payload.productId).toBe('p1');\n84\t    expect(payload.quantity).toBe(100);\n85\t  });\n86\t\n87\t  it('5. should reserve stock and reflect updated quantity', () => {\n88\t    inventory.setStock('p1', 10);\n89\t    const reserved = inventory.reserve('p1', 3);\n90\t    expect(reserved).toBe(true);\n91\t    expect(inventory.getStock('p1')).toBe(7);\n92\t\n93\t    const failedReserve = inventory.reserve('p1', 100);\n94\t    expect(failedReserve).toBe(false);\n95\t    expect(inventory.getStock('p1')).toBe(7);\n96\t  });\n97\t\n98\t  // 6-7: Cart operations emitting cart events\n99\t  it('6. should add items to cart and emit cart:updated event', () => {\n100\t    const cartId = cart.createCart('user1');\n101\t    cart.addItem(cartId, 'p1', 2);\n102\t    const log = bus.getLog();\n103\t    const cartEvents = log.filter(e => e.event === Events.CART_UPDATED);\n104\t    expect(cartEvents).toHaveLength(1);\n105\t    const payload = cartEvents[0].payload as { cartId: string; items: Array<{ productId: string; quantity: number }> };\n106\t    expect(payload.cartId).toBe(cartId);\n107\t    expect(payload.items).toHaveLength(1);\n108\t  });\n109\t\n110\t  it('7. should update cart quantity and reflect in cart data', () => {\n111\t    const cartId = cart.createCart('user1');\n112\t    cart.addItem(cartId, 'p1', 2);\n113\t    cart.updateQuantity(cartId, 'p1', 5);\n114\t    const c = cart.getCart(cartId);\n115\t    expect(c!.items[0].quantity).toBe(5);\n116\t  });\n117\t\n118\t  // 8-9: Pricing calculation with discount codes\n119\t  it('8. should calculate price with tax (10%)', () => {\n120\t    const result = pricing.calculateTotal([\n121\t      { productId: 'p1', quantity: 2, price: 50 },\n122\t    ]);\n123\t    expect(result.subtotal).toBe(100);\n124\t    expect(result.tax).toBe(10);\n125\t    expect(result.total).toBe(110);\n126\t  });\n127\t\n128\t  it('9. should apply discount code and compute correct total', () => {\n129\t    pricing.addDiscountCode('SAVE20', 20);\n130\t    const result = pricing.calculateTotal(\n131\t      [{ productId: 'p1', quantity: 1, price: 200 }],\n132\t      'SAVE20',\n133\t    );\n134\t    expect(result.subtotal).toBe(200);\n135\t    expect(result.discount).toBe(40);\n136\t    // After discount: 160, tax: 16, total: 176\n137\t    expect(result.tax).toBe(16);\n138\t    expect(result.total).toBe(176);\n139\t  });\n140\t\n141\t  // 10-12: Order creation and status transitions\n142\t  it('10. should create an order with PENDING status', () => {\n143\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n144\t    const order = orders.getOrder(orderId);\n145\t    expect(order!.status).toBe(OrderStatus.PENDING);\n146\t    expect(order!.total).toBe(150);\n147\t  });\n148\t\n149\t  it('11. should transition order through status states', () => {\n150\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n151\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n152\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n153\t\n154\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n155\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.SHIPPED);\n156\t\n157\t    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n158\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.DELIVERED);\n159\t  });\n160\t\n161\t  it('12. should emit order:status_changed events with correct previous status', () => {\n162\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n163\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n164\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n165\t\n166\t    const log = bus.getLog();\n167\t    const statusEvents = log.filter(e => e.event === Events.ORDER_STATUS_CHANGED);\n168\t    expect(statusEvents).toHaveLength(2);\n169\t\n170\t    const first = statusEvents[0].payload as { previousStatus: string; status: string };\n171\t    expect(first.previousStatus).toBe(OrderStatus.PENDING);\n172\t    expect(first.status).toBe(OrderStatus.CONFIRMED);\n173\t\n174\t    const second = statusEvents[1].payload as { previousStatus: string; status: string };\n175\t    expect(second.previousStatus).toBe(OrderStatus.CONFIRMED);\n176\t    expect(second.status).toBe(OrderStatus.SHIPPED);\n177\t  });\n178\t\n179\t  // 13-14: Payment processing (success and failure)\n180\t  it('13. should process payment successfully and emit event', async () => {\n181\t    const result = await payment.processPayment('order1', 99.99);\n182\t    expect(result.status).toBe(PaymentStatus.SUCCESS);\n183\t    expect(result.transactionId).toBeDefined();\n184\t\n185\t    const log = bus.getLog();\n186\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n187\t    expect(payEvents).toHaveLength(1);\n188\t  });\n189\t\n190\t  it('14. should handle payment failure and emit failure event', async () => {\n191\t    const failPayment = createPaymentService(bus, { simulateFailure: true });\n192\t    const result = await failPayment.processPayment('order1', 99.99);\n193\t    expect(result.status).toBe(PaymentStatus.FAILED);\n194\t\n195\t    const log = bus.getLog();\n196\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n197\t    const failEvent = payEvents.find(e => (e.payload as { status: string }).status === PaymentStatus.FAILED);\n198\t    expect(failEvent).toBeDefined();\n199\t  });\n200\t\n201\t  // 15-16: Notifications generated for order events\n202\t  it('15. should send notification on order status change', async () => {\n203\t    notifications.subscribe('user1');\n204\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n205\t\n206\t    // Wait for event propagation\n207\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n208\t\n209\t    // Give async handlers a tick to resolve\n210\t    await new Promise(resolve => setTimeout(resolve, 10));\n211\t\n212\t    const notifs = notifications.getNotifications('user1');\n213\t    expect(notifs.length).toBeGreaterThanOrEqual(1);\n214\t    expect(notifs.some(n => n.type === 'order_status')).toBe(true);\n215\t  });\n216\t\n217\t  it('16. should send notification on payment processed', async () => {\n218\t    notifications.subscribe('user1');\n219\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n220\t\n221\t    await payment.processPayment(orderId, 100);\n222\t\n223\t    await new Promise(resolve => setTimeout(resolve, 10));\n224\t\n225\t    const notifs = notifications.getNotifications('user1');\n226\t    expect(notifs.some(n => n.type === 'payment')).toBe(true);\n227\t  });\n228\t\n229\t  // 17-18: Analytics tracking events and computing metrics\n230\t  it('17. should track event counts through the bus', async () => {\n231\t    catalog.createProduct('Widget', 10, 'gadgets');\n232\t    catalog.createProduct('Gizmo', 20, 'gadgets');\n233\t\n234\t    // Wait for async propagation\n235\t    await new Promise(resolve => setTimeout(resolve, 10));\n236\t\n237\t    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n238\t  });\n239\t\n240\t  it('18. should track revenue from successful payments', async () => {\n241\t    const orderId = orders.createOrder('user1', 'cart1', 250);\n242\t    await payment.processPayment(orderId, 250);\n243\t\n244\t    expect(analytics.getRevenue()).toBe(250);\n245\t  });\n246\t\n247\t  // 19: Full checkout flow\n248\t  it('19. should complete full checkout flow end-to-end', async () => {\n249\t    // Subscribe for notifications\n250\t    notifications.subscribe('user1');\n251\t\n252\t    // Create product\n253\t    const productId = catalog.createProduct('Premium Widget', 49.99, 'gadgets');\n254\t    expect(catalog.getProduct(productId)).not.toBeNull();\n255\t\n256\t    // Set stock\n257\t    inventory.setSt