us.SUCCESS) return;\n    const total = orderTotals.get(event.orderId) ?? 0;\n    revenue += total;\n  });\n\n  return {\n    getEventCount(eventType: string): number {\n      return eventCounts.get(eventType) ?? 0;\n    },\n\n    getRevenue(): number {\n      return revenue;\n    },\n\n    getConversionRate(): number {\n      if (cartIds.size === 0) return 0;\n      return orderCount / cartIds.size;\n    },\n\n    getTopProducts(limit: number) {\n      return [...productOrderCounts.entries()]\n        .map(([productId, count]) => ({ productId, count }))\n        .sort((a, b) => b.count - a.count)\n        .slice(0, limit);\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":964,"cache_read_input_tokens":68764,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":964},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d7a165db-4c5c-4516-918c-2d2a4d008694","uuid":"f52e9438-57a3-4ee7-928b-d54e8e4c185b","request_id":"req_011CcaMQQfqr8uTYHtJXbcbU"}
