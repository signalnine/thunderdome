@@ -0,0 +1,67 @@
+import { randomUUID } from 'crypto';
+import type { EventBus } from '../bus.js';
+import { Events, type CartService } from '../types.js';
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: Map<string, number>;
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitUpdate(cart: Cart): void {
+    void bus.emit(Events.CART_UPDATED, {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity })),
+    });
+  }
+
+  return {
+    createCart(userId) {
+      const id = randomUUID();
+      carts.set(id, { id, userId, items: new Map() });
+      return id;
+    },
+
+    addItem(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.set(productId, (cart.items.get(productId) ?? 0) + quantity);
+      emitUpdate(cart);
+    },
+
+    removeItem(cartId, productId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.delete(productId);
+      emitUpdate(cart);
+    },
+
+    getCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return {
+        id: cart.id,
+        userId: cart.userId,
+        items: Array.from(cart.items.entries()).map(([productId, quantity]) => ({ productId, quantity })),
+      };
+    },
+
+    clearCart(cartId) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.clear();
+      emitUpdate(cart);
+    },
+
+    updateQuantity(cartId, productId, quantity) {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items.set(productId, quantity);
+      emitUpdate(cart);
+    },
+  };
+}
