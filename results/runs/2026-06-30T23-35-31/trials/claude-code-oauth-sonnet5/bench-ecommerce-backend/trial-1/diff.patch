ctId, (productOrderCounts.get(item.productId) ?? 0) + item.quantity);\n    }\n  });\n\n  bus.on(Events.PAYMENT_PROCESSED, (payload) => {\n    const { orderId, status } = payload as PaymentProcessedEvent;\n    if (status === PaymentStatus.SUCCESS) {\n      revenue += orderTotals.get(orderId) ?? 0;\n    }\n  });\n\n  return {\n    getEventCount(eventType) {\n      return eventCounts.get(eventType) ?? 0;\n    },\n\n    getRevenue() {\n      return revenue;\n    },\n\n    getConversionRate() {\n      return cartIds.size === 0 ? 0 : orderCount / cartIds.size;\n    },\n\n    getTopProducts(limit) {\n      return Array.from(productOrderCounts.entries())\n        .map(([productId, count]) => ({ productId, count }))\n        .sort((a, b) => b.count - a.count)\n        .slice(0, limit);\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":843,"cache_read_input_tokens":69958,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":843},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4d7347c0-d2bf-4e03-ab87-ea58ed341e77","uuid":"76c92895-4182-43e0-80e8-de4d62af3a04","request_id":"req_011CcaMMxJmjd5e6xrPchNGG"}
