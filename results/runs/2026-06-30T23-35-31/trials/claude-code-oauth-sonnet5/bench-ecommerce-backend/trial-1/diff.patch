+++ b/src/payment/index.ts
@@ -0,0 +1,48 @@
+import { randomUUID } from 'crypto';
+import type { EventBus } from '../bus.js';
+import { Events, PaymentStatus, type PaymentService } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+interface Transaction {
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const transactions = new Map<string, Transaction>();
+
+  return {
+    async processPayment(orderId, amount) {
+      if (options.simulateTimeout) {
+        const error = 'Payment processing timed out';
+        await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.TIMEOUT, error });
+        return { status: PaymentStatus.TIMEOUT, error };
+      }
+
+      if (options.simulateFailure) {
+        const error = 'Payment was declined';
+        await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.FAILED, error });
+        return { status: PaymentStatus.FAILED, error };
+      }
+
+      const transactionId = randomUUID();
+      transactions.set(transactionId, { orderId, amount, refunded: false });
+      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.SUCCESS, transactionId });
+      return { status: PaymentStatus.SUCCESS, transactionId };
+    },
+
+    async refund(transactionId) {
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.refunded) {
+        return false;
+      }
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
