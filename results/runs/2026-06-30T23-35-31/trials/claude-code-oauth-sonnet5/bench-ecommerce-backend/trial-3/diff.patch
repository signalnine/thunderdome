\n38\t    bus = new EventBus();\n39\t    catalog = createCatalogService(bus);\n40\t    inventory = createInventoryService(bus);\n41\t    cart = createCartService(bus);\n42\t    pricing = createPricingService(bus);\n43\t    orders = createOrderService(bus);\n44\t    payment = createPaymentService(bus);\n45\t    notifications = createNotificationService(bus);\n46\t    analytics = createAnalyticsService(bus);\n47\t  });\n48\t\n49\t  // 1-3: Product catalog CRUD through bus events\n50\t  it('1. should create a product and emit product:created event', () => {\n51\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n52\t    expect(id).toBeDefined();\n53\t    const log = bus.getLog();\n54\t    const createEvents = log.filter(e => e.event === Events.PRODUCT_CREATED);\n55\t    expect(createEvents).toHaveLength(1);\n56\t    const payload = createEvents[0].payload as { productId: string; name: string };\n57\t    expect(payload.productId).toBe(id);\n58\t    expect(payload.name).toBe('Laptop');\n59\t  });\n60\t\n61\t  it('2. should update a product and retrieve updated data', () => {\n62\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n63\t    catalog.updateProduct(id, { price: 899.99, name: 'Gaming Laptop' });\n64\t    const product = catalog.getProduct(id);\n65\t    expect(product!.price).toBe(899.99);\n66\t    expect(product!.name).toBe('Gaming Laptop');\n67\t  });\n68\t\n69\t  it('3. should remove a product and confirm deletion', () => {\n70\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n71\t    expect(catalog.removeProduct(id)).toBe(true);\n72\t    expect(catalog.getProduct(id)).toBeNull();\n73\t    expect(catalog.listProducts()).toHaveLength(0);\n74\t  });\n75\t\n76\t  // 4-5: Inventory management with stock events\n77\t  it('4. should set stock and emit inventory:updated event', () => {\n78\t    inventory.setStock('p1', 100);\n79\t    const log = bus.getLog();\n80\t    const invEvents = log.filter(e => 