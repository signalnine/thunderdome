index 0000000..1d5ecbb
--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,60 @@
+import { EventBus } from '../bus.js';
+import {
+  Events,
+  NotificationService,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Notification[]>();
+  const orderUserMap = new Map<string, string>();
+
+  function notify(userId: string, type: string, message: string): void {
+    if (!subscribers.has(userId)) return;
+    const list = notifications.get(userId) ?? [];
+    list.push({ type, message, timestamp: Date.now() });
+    notifications.set(userId, list);
+    void bus.emit(Events.NOTIFICATION_SENT, { userId, type, message });
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const p = payload as OrderCreatedEvent;
+    orderUserMap.set(p.orderId, p.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const p = payload as OrderStatusChangedEvent;
+    const userId = orderUserMap.get(p.orderId);
+    if (!userId) return;
+    notify(userId, 'order_status', `Order ${p.orderId} status changed to ${p.status}`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const p = payload as PaymentProcessedEvent;
+    const userId = orderUserMap.get(p.orderId);
+    if (!userId) return;
+    notify(userId, 'payment', `Payment for order ${p.orderId} ${p.status}`);
+  });
+
+  return {
+    subscribe(userId) {
+      subscribers.add(userId);
+      if (!notifications.has(userId)) {
+        notifications.set(userId, []);
+      }
+    },
+
+    getNotifications(userId) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
