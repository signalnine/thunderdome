+++ b/src/analytics/index.ts
@@ -0,0 +1,76 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  CartUpdatedEvent,
+  Events,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const cartItemsMap = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  let revenue = 0;
+  let orderCount = 0;
+
+  function track(eventType: string): void {
+    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+  }
+
+  for (const eventName of Object.values(Events)) {
+    bus.on(eventName, () => track(eventName));
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const p = payload as CartUpdatedEvent;
+    cartItemsMap.set(p.cartId, p.items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const p = payload as OrderCreatedEvent;
+    orderCount += 1;
+    orderTotals.set(p.orderId, p.total);
+    const items = cartItemsMap.get(p.cartId);
+    if (items) {
+      for (const item of items) {
+        productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+      }
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const p = payload as PaymentProcessedEvent;
+    if (p.status === PaymentStatus.SUCCESS) {
+      const total = orderTotals.get(p.orderId);
+      if (total !== undefined) {
+        revenue += total;
+      }
+    }
+  });
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      const cartCount = cartItemsMap.size;
+      if (cartCount === 0) return 0;
+      return orderCount / cartCount;
+    },
+
+    getTopProducts(limit) {
+      return Array.from(productCounts.entries())
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
