@@ -0,0 +1,51 @@
+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { Events, PaymentService, PaymentStatus } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const transactions = new Map<string, Transaction>();
+
+  return {
+    async processPayment(orderId, amount) {
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (options.simulateTimeout) {
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      } else if (options.simulateFailure) {
+        result = { status: PaymentStatus.FAILED, error: 'Payment declined' };
+      } else {
+        const transactionId = uuidv4();
+        transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      }
+
+      await bus.emit(Events.PAYMENT_PROCESSED, {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      });
+
+      return result;
+    },
+
+    async refund(transactionId) {
+      const tx = transactions.get(transactionId);
+      if (!tx || tx.refunded) return false;
+      tx.refunded = true;
+      return true;
+    },
+  };
+}
diff --git a/src/pricing/index.ts b/src/pricing/index.ts
