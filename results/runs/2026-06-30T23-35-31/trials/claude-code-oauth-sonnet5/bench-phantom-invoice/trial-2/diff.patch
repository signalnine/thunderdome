+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011hu2cmfxWAFgtPtwFrcp1o","type":"tool_result","content":"1\timport type Database from 'better-sqlite3';\n2\timport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n3\t\n4\t/**\n5\t * Generate a monthly revenue report for a given year.\n6\t * Groups invoices by their UTC month and aggregates totals.\n7\t */\n8\texport function getMonthlyReport(\n9\t  db: Database.Database,\n10\t  year: number,\n11\t): InvoiceSummary[] {\n12\t  const startDate = `${year}-01-01`;\n13\t  const endDate = `${year}-12-31`;\n14\t\n15\t  const stmt = db.prepare(`\n16\t    SELECT * FROM invoices\n17\t    WHERE date >= ? AND date <= ?\n18\t    ORDER BY date ASC\n19\t  `);\n20\t\n21\t  const invoices = stmt.all(startDate, endDate) as Invoice[];\n22\t\n23\t  // Group invoices by month\n24\t  const monthlyMap = new Map<number, { count: number; total: number }>();\n25\t\n26\t  for (const inv of invoices) {\n27\t    const d = new Date(inv.date + 'T00:00:00Z');\n28\t    const month = d.getMonth() + 1; // 1-indexed\n29\t\n30\t    const current = monthlyMap.get(month) || { count: 0, total: 0 };\n31\t    current.count += 1;\n32\t    current.total += inv.total;\n33\t    monthlyMap.set(month, current);\n34\t  }\n35\t\n36\t  // Convert to array of summaries\n37\t  const summaries: InvoiceSummary[] = [];\n38\t  for (const [month, data] of monthlyMap) {\n39\t    summaries.push({\n40\t      month,\n41\t      year,\n42\t      count: data.count,\n43\t      total_revenue: Math.round(data.total * 100) / 100,\n44\t    });\n45\t  }\n46\t\n47\t  return summaries.sort((a, b) => a.month - b.month);\n48\t}\n49\t\n50\t/**\n51\t * Generate a report for a specific customer.\n52\t */\n53\texport function getCustomerReport(\n54\t  db: Database.Database,\n55\t  customerId: string,\n56\t): CustomerReport {\n57\t  const stmt = db.prepare(`\n58\t    SELECT * FROM invoices\n59\t    WHERE customer_id = ?\n60\t  `);\n61\t\n62\t  const invoices = stmt.all(customerId) as Invoice[];\n63\t\n64\t  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n65\t\n66\t  return {\n67\t    customer_id: customerId,\n68\t    invoice_count: invoices.length,\n69\t    total_spent: Math.round(totalSpent * 100) / 100,\n70\t    average_invoice: invoices.length > 0\n71\t      ? Math.round((totalSpent / invoices.length) * 100) / 100\n72\t      : 0,\n73\t  };\n74\t}\n75\t\n76\t/**\n77\t * Get total revenue for a date period.\n78\t */\n79\texport function getRevenueByPeriod(\n80\t  db: Database.Database,\n81\t  start: string,\n82\t  end: string,\n83\t): { total: number; count: number } {\n84\t  const stmt = db.prepare(`\n85\t    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n86\t    FROM invoices\n87\t    WHERE date >= ? AND date <= ?\n88\t  `);\n89\t\n90\t  const result = stmt.get(start, end) as { total: number; count: number };\n91\t  return {\n92\t    total: Math.round(result.total * 100) / 100,\n93\t    count: result.count,\n94\t  };\n95\t}\n96\t"}]},"parent_tool_use_id":null,"session_id":"e0dc9110-b20f-431b-9f5a-6e2cf4e01a18","uuid":"167c9f1c-d403-4db5-8d59-42e4d804c196","timestamp":"2026-06-30T23:41:17.480Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/services/reporting.ts","content":"import type Database from 'better-sqlite3';\nimport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n\n/**\n * Generate a monthly revenue report for a given year.\n * Groups invoices by their UTC month and aggregates totals.\n */\nexport function getMonthlyReport(\n  db: Database.Database,\n  year: number,\n): InvoiceSummary[] {\n  const startDate = `${year}-01-01`;\n  const endDate = `${year}-12-31`;\n\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE date >= ? AND date <= ?\n    ORDER BY date ASC\n  `);\n\n  const invoices = stmt.all(startDate, endDate) as Invoice[];\n\n  // Group invoices by month\n  const monthlyMap = new Map<number, { count: number; total: number }>();\n\n  for (const inv of invoices) {\n    const d = new Date(inv.date + 'T00:00:00Z');\n    const month = d.getMonth() + 1; // 1-indexed\n\n    const current = monthlyMap.get(month) || { count: 0, total: 0 };\n    current.count += 1;\n    current.total += inv.total;\n    monthlyMap.set(month, current);\n  }\n\n  // Convert to array of summaries\n  const summaries: InvoiceSummary[] = [];\n  for (const [month, data] of monthlyMap) {\n    summaries.push({\n      month,\n      year,\n      count: data.count,\n      total_revenue: Math.round(data.total * 100) / 100,\n    });\n  }\n\n  return summaries.sort((a, b) => a.month - b.month);\n}\n\n/**\n * Generate a report for a specific customer.\n */\nexport function getCustomerReport(\n  db: Database.Database,\n  customerId: string,\n): CustomerReport {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE customer_id = ?\n  `);\n\n  const invoices = stmt.all(customerId) as Invoice[];\n\n  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n\n  return {\n    customer_id: customerId,\n    invoice_count: invoices.length,\n    total_spent: Math.round(totalSpent * 100) / 100,\n    average_invoice: invoices.length > 0\n      ? Math.round((totalSpent / invoices.length) * 100) / 100\n      : 0,\n  };\n}\n\n/**\n * Get total revenue for a date period.\n */\nexport function getRevenueByPeriod(\n  db: Database.Database,\n  start: string,\n  end: string,\n): { total: number; count: number } {\n  const stmt = db.prepare(`\n    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n    FROM invoices\n    WHERE date >= ? AND date <= ?\n  `);\n\n  const result = stmt.get(start, end) as { total: number; count: number };\n  return {\n    total: Math.round(result.total * 100) / 100,\n    count: result.count,\n  };\n}\n","numLines":96,"startLine":1,"totalLines":96}}}
