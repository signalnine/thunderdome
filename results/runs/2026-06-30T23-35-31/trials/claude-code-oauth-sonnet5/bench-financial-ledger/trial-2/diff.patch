er.postEntry(\n169\t        'Sale 1',\n170\t        [{ account: 'Cash', amount: 100 }],\n171\t        [{ account: 'Revenue', amount: 100 }]\n172\t      );\n173\t      ledger.postEntry(\n174\t        'Expense',\n175\t        [{ account: 'Expenses', amount: 30 }],\n176\t        [{ account: 'Cash', amount: 30 }]\n177\t      );\n178\t      expect(ledger.getBalance('Cash')).toBe(70);\n179\t    });\n180\t\n181\t    it('throws for unknown account', () => {\n182\t      expect(() => ledger.getBalance('Nonexistent')).toThrow(/not found/i);\n183\t    });\n184\t\n185\t    it('returns correct expense balance', () => {\n186\t      ledger.postEntry(\n187\t        'Rent',\n188\t        [{ account: 'Expenses', amount: 500 }],\n189\t        [{ account: 'Cash', amount: 500 }]\n190\t      );\n191\t      expect(ledger.getBalance('Expenses')).toBe(500);\n192\t    });\n193\t\n194\t    it('returns positive balance for liability with credits', () => {\n195\t      ledger.postEntry(\n196\t        'Loan received',\n197\t        [{ account: 'Cash', amount: 1000 }],\n198\t        [{ account: 'AP', amount: 1000 }]\n199\t      );\n200\t      // Liabilities have credit-normal balance — credited AP should show positive\n201\t      expect(ledger.getBalance('AP')).toBe(1000);\n202\t    });\n203\t  });\n204\t\n205\t  // ===== Trial Balance (4 tests, 3 pass) =====\n206\t\n207\t  describe('getTrialBalance', () => {\n208\t    beforeEach(() => {\n209\t      ledger.createAccount('Cash', 'asset');\n210\t      ledger.createAccount('Revenue', 'revenue');\n211\t      ledger.createAccount('Expenses', 'expense');\n212\t    });\n213\t\n214\t    it('returns empty trial balance', () => {\n215\t      const tb = ledger.getTrialBalance();\n216\t      expect(tb).toHaveLength(3);\n217\t      expect(tb.every(e => e.debit === 0 && e.credit === 0)).toBe(true);\n218\t    });\n219\t\n220\t    it('includes all accounts', () => {\n221\t      const tb = ledger.getTrialBalance();\n222\t      const names = tb.map(e => e.account).s