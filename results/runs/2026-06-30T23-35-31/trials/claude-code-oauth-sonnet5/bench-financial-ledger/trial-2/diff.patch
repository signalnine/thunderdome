      if (endDate && entry.date.getTime() > endDate.getTime()) continue;\n\n      let debit = 0;\n      let credit = 0;\n\n      for (const d of entry.debits) {\n        if (d.account === accountName) debit += d.amount;\n      }\n      for (const c of entry.credits) {\n        if (c.account === accountName) credit += c.amount;\n      }\n\n      if (debit === 0 && credit === 0) continue;\n\n      runningBalance += this.isDebitNormal(account.type) ? debit - credit : credit - debit;\n\n      lines.push({\n        date: entry.date,\n        description: entry.description,\n        debit,\n        credit,\n        balance: runningBalance,\n      });\n    }\n\n    return lines;\n  }\n\n  splitEntry(\n    description: string,\n    fromAccount: string,\n    toAccounts: LineItem[],\n    totalAmount: number,\n    date?: Date\n  ): JournalEntry {\n    if (!this.accounts.has(fromAccount)) {\n      throw new Error(`Account not found: ${fromAccount}`);\n    }\n\n    const debits: LineItem[] = [{ account: fromAccount, amount: totalAmount }];\n    const credits: LineItem[] = toAccounts.map(ta => ({\n      account: ta.account,\n      amount: ta.amount,\n    }));\n\n    return this.postEntry(description, debits, credits, date);\n  }\n\n  getAccountsByType(type: AccountType): Account[] {\n    const result: Account[] = [];\n    for (const account of this.accounts.values()) {\n      if (account.type === type) result.push({ ...account });\n    }\n    return result;\n  }\n\n  getProfitAndLoss(startDate?: Date, endDate?: Date): ProfitAndLoss {\n    let revenue = 0;\n    let expenses = 0;\n\n    for (const entry of this.entries) {\n      if (startDate && entry.date < startDate) continue;\n      if (endDate && entry.date > endDate) continue;\n\n      for (const c of entry.credits) {\n        const acct = this.accounts.get(c.account);\n        if (acct?.type === 'revenue') revenue -= c.amount;\n      }\n\n      for (const d of entry.debits) {\n        const acct = this.accounts.get(d.account)