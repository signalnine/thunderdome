ems WHERE invoice_id = ?');\n  const line_items = itemsStmt.all(id) as LineItem[];\n\n  return { ...invoice, line_items };\n}\n\n/**\n * Create a new invoice with line items.\n */\nexport function createInvoice(\n  db: Database.Database,\n  data: Invoice & { line_items?: LineItem[] },\n): number {\n  const insertInvoice = db.prepare(`\n    INSERT INTO invoices (customer_id, date, subtotal, discount_rate, tax_rate, total, status)\n    VALUES (?, ?, ?, ?, ?, ?, ?)\n  `);\n\n  const insertLineItem = db.prepare(`\n    INSERT INTO line_items (invoice_id, description, quantity, unit_price)\n    VALUES (?, ?, ?, ?)\n  `);\n\n  const result = insertInvoice.run(\n    data.customer_id,\n    data.date,\n    data.subtotal,\n    data.discount_rate,\n    data.tax_rate,\n    data.total,\n    data.status || 'draft',\n  );\n\n  const invoiceId = result.lastInsertRowid as number;\n\n  if (data.line_items) {\n    for (const item of data.line_items) {\n      insertLineItem.run(invoiceId, item.description, item.quantity, item.unit_price);\n    }\n  }\n\n  return invoiceId;\n}\n\n/**\n * Retrieve all invoices for a specific customer.\n */\nexport function getInvoicesByCustomer(\n  db: Database.Database,\n  customerId: string,\n): Invoice[] {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE customer_id = ?\n    ORDER BY date ASC\n  `);\n  return stmt.all(customerId) as Invoice[];\n}\n","numLines":90,"startLine":1,"totalLines":90}}}
