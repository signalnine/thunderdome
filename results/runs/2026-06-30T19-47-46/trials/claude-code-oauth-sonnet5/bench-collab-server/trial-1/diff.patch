+import { randomUUID } from 'node:crypto';
+import { WebSocket, type WebSocketServer } from 'ws';
+import type Database from 'better-sqlite3';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Document, Operation } from './models.js';
+
+interface Room {
+  version: number;
+  content: string;
+  /** history[i] is the operation that transitions version i -> i + 1 */
+  history: Operation[];
+  /** contentHistory[i] is the document content at version i */
+  contentHistory: string[];
+  clients: Set<WebSocket>;
+}
+
+interface VersionRow {
+  version: number;
+  content: string;
+  operation: string | null;
+}
+
+interface IncomingMessage {
+  type?: string;
+  operation?: unknown;
+  version?: number;
+}
+
+function loadRoom(db: Database.Database, docId: string, fallbackContent: string): Room {
+  const versionRows = db
+    .prepare('SELECT version, content, operation FROM versions WHERE document_id = ? ORDER BY version ASC')
+    .all(docId) as VersionRow[];
+
+  const contentHistory: string[] = [];
+  const history: Operation[] = [];
+
+  for (const row of versionRows) {
+    contentHistory[row.version] = row.content;
+    if (row.operation) {
+      history[row.version - 1] = JSON.parse(row.operation) as Operation;
+    }
+  }
+
+  const latest = versionRows[versionRows.length - 1];
+  return {
+    version: latest ? latest.version : 0,
+    content: latest ? latest.content : fallbackContent,
+    history,
+    contentHistory: contentHistory.length > 0 ? contentHistory : [fallbackContent],
+    clients: new Set(),
+  };
+}
+
+export function setupWebSocket(wss: WebSocketServer, db: Database.Database): void {
+  const rooms = new Map<string, Room>();
+
+  wss.on('connection', (ws: WebSocket, request) => {
+    const url = new URL(request.url ?? '/', 'http://localhost');
+    const docId = decodeURIComponent(url.pathname.slice(1));
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Document | undefined;
+    if (!doc) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));
+      ws.close();
+      return;
+    }
+
+    let room = rooms.get(docId);
+    if (!room) {
+      room = loadRoom(db, docId, doc.content);
+      rooms.set(docId, room);
+    }
+    const currentRoom = room;
+
+    currentRoom.clients.add(ws);
+    const connectionId = randomUUID();
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    ws.send(JSON.stringify({ type: 'sync', content: currentRoom.content, version: currentRoom.version }));
+
+    ws.on('message', (data) => {
+      let msg: IncomingMessage;
+      try {
+        msg = JSON.parse(data.toString()) as IncomingMessage;
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'Malformed JSON' }));
+        return;
+      }
+
+      if (msg.type !== 'operation' || typeof msg.operation !== 'object' || msg.operation === null) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid message type' }));
+        return;
+      }
+
+      const baseVersion =
+        typeof msg.version === 'number' && msg.version >= 0 && msg.version <= currentRoom.version
+          ? msg.version
+          : currentRoom.version;
+
+      const baseContentLength = currentRoom.contentHistory[baseVersion]?.length ?? currentRoom.content.length;
+
+      if (!validateOperation(msg.operation, baseContentLength)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation' }));
+        return;
+      }
+
+      let op: Operation = msg.operation;
+      for (let v = baseVersion; v < currentRoom.version; v++) {
+        op = transformOperation(op, currentRoom.history[v]);
+      }
+
+      if (!validateOperation(op, currentRoom.content.length)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Operation out of bounds after transform' }));
+        return;
+      }
+
+      const newContent = applyOperation(currentRoom.content, op);
+      const newVersion = currentRoom.version + 1;
+
+      db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(
+        docId,
+        newVersion,
+        newContent,
+        JSON.stringify(op)
+      );
+      db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        newContent,
+        docId
+      );
+
+      currentRoom.history[currentRoom.version] = op;
+      currentRoom.content = newContent;
+      currentRoom.version = newVersion;
+      currentRoom.contentHistory[newVersion] = newContent;
+
+      ws.send(JSON.stringify({ type: 'ack', version: newVersion }));
+
+      for (const client of currentRoom.clients) {
+        if (client !== ws && client.readyState === WebSocket.OPEN) {
+          client.send(JSON.stringify({ type: 'operation', operation: op, version: newVersion }));
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      currentRoom.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  });
+}
