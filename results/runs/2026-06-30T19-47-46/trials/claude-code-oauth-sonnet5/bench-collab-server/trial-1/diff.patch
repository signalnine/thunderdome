+import type { DeleteOperation, InsertOperation, Operation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+function transformInsertInsert(op1: InsertOperation, op2: InsertOperation): InsertOperation {
+  if (op1.position <= op2.position) {
+    return op1;
+  }
+  return { ...op1, position: op1.position + op2.text.length };
+}
+
+function transformInsertDelete(op1: InsertOperation, op2: DeleteOperation): InsertOperation {
+  if (op1.position <= op2.position) {
+    return op1;
+  }
+  if (op1.position >= op2.position + op2.count) {
+    return { ...op1, position: op1.position - op2.count };
+  }
+  return { ...op1, position: op2.position };
+}
+
+function transformDeleteInsert(op1: DeleteOperation, op2: InsertOperation): DeleteOperation {
+  if (op2.position <= op1.position) {
+    return { ...op1, position: op1.position + op2.text.length };
+  }
+  if (op2.position >= op1.position + op1.count) {
+    return op1;
+  }
+  // The insert lands inside the range being deleted; extend the delete to cover it too.
+  return { ...op1, count: op1.count + op2.text.length };
+}
+
+function transformDeleteDelete(op1: DeleteOperation, op2: DeleteOperation): DeleteOperation {
+  const start1 = op1.position;
+  const end1 = op1.position + op1.count;
+  const start2 = op2.position;
+  const end2 = op2.position + op2.count;
+
+  if (start1 >= end2) {
+    return { ...op1, position: op1.position - op2.count };
+  }
+  if (end1 <= start2) {
+    return op1;
+  }
+  const overlap = Math.min(end1, end2) - Math.max(start1, start2);
+  const newCount = Math.max(0, op1.count - overlap);
+  const newPosition = start1 <= start2 ? start1 : start2;
+  return { ...op1, position: newPosition, count: newCount };
+}
+
+/** Transform op1 so it can be applied after op2 has already been applied. */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert') {
+    return op2.type === 'insert' ? transformInsertInsert(op1, op2) : transformInsertDelete(op1, op2);
+  }
+  return op2.type === 'insert' ? transformDeleteInsert(op1, op2) : transformDeleteDelete(op1, op2);
+}
+
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (typeof op !== 'object' || op === null) return false;
+  const candidate = op as Record<string, unknown>;
+
+  if (candidate.type === 'insert') {
+    if (typeof candidate.position !== 'number' || typeof candidate.text !== 'string') return false;
+    if (!Number.isInteger(candidate.position)) return false;
+    if (candidate.position < 0 || candidate.position > contentLength) return false;
+    return true;
+  }
+
+  if (candidate.type === 'delete') {
+    if (typeof candidate.position !== 'number' || typeof candidate.count !== 'number') return false;
+    if (!Number.isInteger(candidate.position) || !Number.isInteger(candidate.count)) return false;
+    if (candidate.position < 0 || candidate.count < 0) return false;
+    if (candidate.position + candidate.count > contentLength) return false;
+    return true;
+  }
+
+  return false;
+}
