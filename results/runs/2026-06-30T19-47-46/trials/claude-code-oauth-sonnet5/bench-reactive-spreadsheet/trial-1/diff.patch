+import { describe, expect, it } from 'vitest';
+import { addressToString, colToIndex, expandRange, indexToCol, normalizeCellRef, parseCellRef } from './cellRef.js';
+
+describe('colToIndex / indexToCol', () => {
+  it('converts single letters', () => {
+    expect(colToIndex('A')).toBe(1);
+    expect(colToIndex('Z')).toBe(26);
+  });
+
+  it('converts double letters', () => {
+    expect(colToIndex('AA')).toBe(27);
+    expect(colToIndex('AZ')).toBe(52);
+    expect(colToIndex('BA')).toBe(53);
+  });
+
+  it('round-trips through indexToCol', () => {
+    for (const n of [1, 2, 26, 27, 52, 53, 100, 702, 703]) {
+      expect(colToIndex(indexToCol(n))).toBe(n);
+    }
+  });
+
+  it('is case-insensitive', () => {
+    expect(colToIndex('a')).toBe(1);
+    expect(colToIndex('aa')).toBe(27);
+  });
+});
+
+describe('parseCellRef', () => {
+  it('parses simple refs', () => {
+    expect(parseCellRef('A1')).toEqual({ col: 1, row: 1 });
+    expect(parseCellRef('B2')).toEqual({ col: 2, row: 2 });
+    expect(parseCellRef('Z100')).toEqual({ col: 26, row: 100 });
+    expect(parseCellRef('AA1')).toEqual({ col: 27, row: 1 });
+  });
+
+  it('throws on invalid refs', () => {
+    expect(() => parseCellRef('1A')).toThrow();
+    expect(() => parseCellRef('A')).toThrow();
+    expect(() => parseCellRef('A0')).toThrow();
+    expect(() => parseCellRef('')).toThrow();
+    expect(() => parseCellRef('A-1')).toThrow();
+  });
+});
+
+describe('normalizeCellRef', () => {
+  it('uppercases letters', () => {
+    expect(normalizeCellRef('a1')).toBe('A1');
+    expect(normalizeCellRef('aa12')).toBe('AA12');
+  });
+});
+
+describe('addressToString', () => {
+  it('formats addresses back to refs', () => {
+    expect(addressToString({ col: 1, row: 1 })).toBe('A1');
+    expect(addressToString({ col: 27, row: 5 })).toBe('AA5');
+  });
+});
+
+describe('expandRange', () => {
+  it('expands a column range', () => {
+    expect(expandRange('A1', 'A3')).toEqual(['A1', 'A2', 'A3']);
+  });
+
+  it('expands a row range', () => {
+    expect(expandRange('A1', 'C1')).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands a block range row-major', () => {
+    expect(expandRange('A1', 'B2')).toEqual(['A1', 'B1', 'A2', 'B2']);
+  });
+
+  it('handles reversed corners', () => {
+    expect(expandRange('B2', 'A1')).toEqual(['A1', 'B1', 'A2', 'B2']);
+  });
+
+  it('handles a single cell range', () => {
+    expect(expandRange('A1', 'A1')).toEqual(['A1']);
+  });
+});
diff --git a/src/cellRef.ts b/src/cellRef.ts
new file mode 100644
index 0000000..373ed7c
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,72 @@
+export interface CellAddress {
+  col: number; // 1-based: A=1, B=2, ... Z=26, AA=27, ...
+  row: number; // 1-based
+}
+
+const CELL_REF_PATTERN = /^([A-Za-z]+)([0-9]+)$/;
+
+export function colToIndex(col: string): number {
+  let result = 0;
+  for (const ch of col.toUpperCase()) {
+    const code = ch.charCodeAt(0) - 64; // 'A' -> 1
+    if (code < 1 || code > 26) {
+      throw new Error(`Invalid column letters: ${col}`);
+    }
+    result = result * 26 + code;
+  }
+  return result;
+}
+
+export function indexToCol(index: number): string {
+  let n = index;
+  let result = '';
+  while (n > 0) {
+    const remainder = (n - 1) % 26;
+    result = String.fromCharCode(65 + remainder) + result;
+    n = Math.floor((n - 1) / 26);
+  }
+  return result;
+}
+
+export function parseCellRef(ref: string): CellAddress {
+  const match = CELL_REF_PATTERN.exec(ref.trim());
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const [, colStr, rowStr] = match;
+  const row = parseInt(rowStr, 10);
+  if (row < 1) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return { col: colToIndex(colStr), row };
+}
+
+export function isCellRef(s: string): boolean {
+  return CELL_REF_PATTERN.test(s.trim());
+}
+
+export function addressToString(addr: CellAddress): string {
+  return `${indexToCol(addr.col)}${addr.row}`;
+}
+
+export function normalizeCellRef(ref: string): string {
+  return addressToString(parseCellRef(ref));
+}
+
+/** Expands a range "start:end" into an ordered list of normalized cell refs, row-major. */
+export function expandRange(start: string, end: string): string[] {
+  const a = parseCellRef(start);
+  const b = parseCellRef(end);
+  const minCol = Math.min(a.col, b.col);
+  const maxCol = Math.max(a.col, b.col);
+  const minRow = Math.min(a.row, b.row);
+  const maxRow = Math.max(a.row, b.row);
+
+  const refs: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      refs.push(addressToString({ col, row }));
+    }
+  }
+  return refs;
+}
