@@ -0,0 +1,155 @@
+export type TokenType =
+  | 'NUMBER'
+  | 'STRING'
+  | 'CELL_REF'
+  | 'IDENT'
+  | 'BOOLEAN'
+  | 'PLUS'
+  | 'MINUS'
+  | 'STAR'
+  | 'SLASH'
+  | 'LPAREN'
+  | 'RPAREN'
+  | 'COMMA'
+  | 'COLON'
+  | 'GT'
+  | 'LT'
+  | 'GTE'
+  | 'LTE'
+  | 'EQ'
+  | 'NEQ'
+  | 'EOF';
+
+export interface Token {
+  type: TokenType;
+  value: string;
+}
+
+const CELL_REF_TOKEN_PATTERN = /^[A-Za-z]+[0-9]+$/;
+
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  const len = input.length;
+
+  while (i < len) {
+    const ch = input[i];
+
+    if (/\s/.test(ch)) {
+      i++;
+      continue;
+    }
+
+    if (ch === '"') {
+      let j = i + 1;
+      let str = '';
+      while (j < len && input[j] !== '"') {
+        if (input[j] === '\\' && j + 1 < len && input[j + 1] === '"') {
+          str += '"';
+          j += 2;
+        } else {
+          str += input[j];
+          j++;
+        }
+      }
+      if (j >= len) {
+        throw new Error(`Unterminated string literal in formula: ${input}`);
+      }
+      tokens.push({ type: 'STRING', value: str });
+      i = j + 1;
+      continue;
+    }
+
+    if (/[0-9]/.test(ch) || (ch === '.' && /[0-9]/.test(input[i + 1] ?? ''))) {
+      let j = i;
+      while (j < len && /[0-9]/.test(input[j])) j++;
+      if (input[j] === '.') {
+        j++;
+        while (j < len && /[0-9]/.test(input[j])) j++;
+      }
+      tokens.push({ type: 'NUMBER', value: input.slice(i, j) });
+      i = j;
+      continue;
+    }
+
+    if (/[A-Za-z]/.test(ch)) {
+      let j = i;
+      while (j < len && /[A-Za-z0-9]/.test(input[j])) j++;
+      const word = input.slice(i, j);
+      if (/^(TRUE|FALSE)$/i.test(word)) {
+        tokens.push({ type: 'BOOLEAN', value: word.toUpperCase() });
+      } else if (CELL_REF_TOKEN_PATTERN.test(word)) {
+        tokens.push({ type: 'CELL_REF', value: word.toUpperCase() });
+      } else {
+        tokens.push({ type: 'IDENT', value: word.toUpperCase() });
+      }
+      i = j;
+      continue;
+    }
+
+    switch (ch) {
+      case '+':
+        tokens.push({ type: 'PLUS', value: ch });
+        i++;
+        continue;
+      case '-':
+        tokens.push({ type: 'MINUS', value: ch });
+        i++;
+        continue;
+      case '*':
+        tokens.push({ type: 'STAR', value: ch });
+        i++;
+        continue;
+      case '/':
+        tokens.push({ type: 'SLASH', value: ch });
+        i++;
+        continue;
+      case '(':
+        tokens.push({ type: 'LPAREN', value: ch });
+        i++;
+        continue;
+      case ')':
+        tokens.push({ type: 'RPAREN', value: ch });
+        i++;
+        continue;
+      case ',':
+        tokens.push({ type: 'COMMA', value: ch });
+        i++;
+        continue;
+      case ':':
+        tokens.push({ type: 'COLON', value: ch });
+        i++;
+        continue;
+      case '>':
+        if (input[i + 1] === '=') {
+          tokens.push({ type: 'GTE', value: '>=' });
+          i += 2;
+        } else {
+          tokens.push({ type: 'GT', value: '>' });
+          i++;
+        }
+        continue;
+      case '<':
+        if (input[i + 1] === '=') {
+          tokens.push({ type: 'LTE', value: '<=' });
+          i += 2;
+        } else if (input[i + 1] === '>') {
+          tokens.push({ type: 'NEQ', value: '<>' });
+          i += 2;
+        } else {
+          tokens.push({ type: 'LT', value: '<' });
+          i++;
+        }
+        continue;
+      case '=':
+        tokens.push({ type: 'EQ', value: '=' });
+        i++;
+        continue;
+      default:
+        throw new Error(`Unexpected character '${ch}' in formula: ${input}`);
+    }
+  }
+
+  tokens.push({ type: 'EOF', value: '' });
+  return tokens;
+}
diff --git a/src/parser.ts b/src/parser.ts
new file mode 100644
index 0000000..76614d1
--- /dev/null
+++ b/src/parser.ts
@@ -0,0 +1,140 @@
+import type { Expr } from './ast.js';
+import { tokenize, type Token, type TokenType } from './lexer.js';
+
+const COMPARISON_TYPES: TokenType[] = ['GT', 'LT', 'GTE', 'LTE', 'EQ', 'NEQ'];
+
+class Parser {
+  private tokens: Token[];
+  private pos = 0;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private advance(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: TokenType): Token {
+    const token = this.peek();
+    if (token.type !== type) {
+      throw new Error(`Expected ${type} but got ${token.type} ('${token.value}')`);
+    }
+    return this.advance();
+  }
+
+  parse(): Expr {
+    const expr = this.parseExpression();
+    this.expect('EOF');
+    return expr;
+  }
+
+  private parseExpression(): Expr {
+    return this.parseComparison();
+  }
+
+  private parseComparison(): Expr {
+    let left = this.parseAdditive();
+    while (COMPARISON_TYPES.includes(this.peek().type)) {
+      const op = this.advance().value;
+      const right = this.parseAdditive();
+      left = { type: 'BinaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): Expr {
+    let left = this.parseMultiplicative();
+    while (this.peek().type === 'PLUS' || this.peek().type === 'MINUS') {
+      const op = this.advance().value;
+      const right = this.parseMultiplicative();
+      left = { type: 'BinaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): Expr {
+    let left = this.parseUnary();
+    while (this.peek().type === 'STAR' || this.peek().type === 'SLASH') {
+      const op = this.advance().value;
+      const right = this.parseUnary();
+      left = { type: 'BinaryOp', op, left, right };
+    }
+    return left;
+  }
+
+  private parseUnary(): Expr {
+    if (this.peek().type === 'MINUS') {
+      this.advance();
+      const operand = this.parseUnary();
+      return { type: 'UnaryOp', op: '-', operand };
+    }
+    if (this.peek().type === 'PLUS') {
+      this.advance();
+      return this.parseUnary();
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Expr {
+    const token = this.peek();
+
+    if (token.type === 'NUMBER') {
+      this.advance();
+      return { type: 'Number', value: parseFloat(token.value) };
+    }
+
+    if (token.type === 'STRING') {
+      this.advance();
+      return { type: 'String', value: token.value };
+    }
+
+    if (token.type === 'BOOLEAN') {
+      this.advance();
+      return { type: 'Boolean', value: token.value === 'TRUE' };
+    }
+
+    if (token.type === 'LPAREN') {
+      this.advance();
+      const expr = this.parseExpression();
+      this.expect('RPAREN');
+      return expr;
+    }
+
+    if (token.type === 'CELL_REF') {
+      this.advance();
+      if (this.peek().type === 'COLON') {
+        this.advance();
+        const end = this.expect('CELL_REF');
+        return { type: 'Range', start: token.value, end: end.value };
+      }
+      return { type: 'CellRef', ref: token.value };
+    }
+
+    if (token.type === 'IDENT') {
+      this.advance();
+      this.expect('LPAREN');
+      const args: Expr[] = [];
+      if (this.peek().type !== 'RPAREN') {
+        args.push(this.parseExpression());
+        while (this.peek().type === 'COMMA') {
+          this.advance();
+          args.push(this.parseExpression());
+        }
+      }
+      this.expect('RPAREN');
+      return { type: 'FunctionCall', name: token.value, args };
+    }
+
+    throw new Error(`Unexpected token '${token.value || token.type}' in formula`);
+  }
+}
+
+export function parseFormula(formulaText: string): Expr {
+  const tokens = tokenize(formulaText);
+  return new Parser(tokens).parse();
+}
