+export type FormulaErrorCode = 'DIV0' | 'VALUE' | 'NAME' | 'REF';
+
+const ERROR_DISPLAY: Record<FormulaErrorCode, string> = {
+  DIV0: '#DIV/0!',
+  VALUE: '#VALUE!',
+  NAME: '#NAME?',
+  REF: '#REF!',
+};
+
+export class FormulaError extends Error {
+  code: FormulaErrorCode;
+
+  constructor(code: FormulaErrorCode, message?: string) {
+    super(message ?? ERROR_DISPLAY[code]);
+    this.code = code;
+    this.name = 'FormulaError';
+  }
+
+  get display(): string {
+    return ERROR_DISPLAY[this.code];
+  }
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..2b8116f
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,139 @@
+import type { CellValue, Expr } from './ast.js';
+import { expandRange } from './cellRef.js';
+import { FormulaError } from './errors.js';
+
+export interface EvalContext {
+  getCellValue(ref: string): CellValue | null;
+}
+
+function toNumber(value: CellValue): number {
+  if (typeof value === 'number') return value;
+  throw new FormulaError('VALUE', `Expected a number but got ${typeof value}`);
+}
+
+function toBoolean(value: CellValue): boolean {
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  return value.length > 0;
+}
+
+function valuesEqual(a: CellValue, b: CellValue): boolean {
+  return typeof a === typeof b && a === b;
+}
+
+export function evaluateExpr(node: Expr, ctx: EvalContext): CellValue {
+  switch (node.type) {
+    case 'Number':
+      return node.value;
+    case 'String':
+      return node.value;
+    case 'Boolean':
+      return node.value;
+    case 'CellRef':
+      return ctx.getCellValue(node.ref) ?? 0;
+    case 'Range':
+      throw new FormulaError('VALUE', 'A range cannot be used as a scalar value');
+    case 'UnaryOp': {
+      const operand = toNumber(evaluateExpr(node.operand, ctx));
+      return -operand;
+    }
+    case 'BinaryOp':
+      return evaluateBinaryOp(node.op, node.left, node.right, ctx);
+    case 'FunctionCall':
+      return evaluateFunctionCall(node.name, node.args, ctx);
+    default: {
+      const exhaustive: never = node;
+      throw new Error(`Unknown expression node: ${JSON.stringify(exhaustive)}`);
+    }
+  }
+}
+
+function evaluateBinaryOp(op: string, leftNode: Expr, rightNode: Expr, ctx: EvalContext): CellValue {
+  const left = evaluateExpr(leftNode, ctx);
+  const right = evaluateExpr(rightNode, ctx);
+
+  switch (op) {
+    case '+':
+      return toNumber(left) + toNumber(right);
+    case '-':
+      return toNumber(left) - toNumber(right);
+    case '*':
+      return toNumber(left) * toNumber(right);
+    case '/': {
+      const divisor = toNumber(right);
+      if (divisor === 0) throw new FormulaError('DIV0');
+      return toNumber(left) / divisor;
+    }
+    case '=':
+      return valuesEqual(left, right);
+    case '<>':
+      return !valuesEqual(left, right);
+    case '>':
+    case '<':
+    case '>=':
+    case '<=':
+      if (typeof left !== typeof right) {
+        throw new FormulaError('VALUE', `Cannot compare ${typeof left} with ${typeof right}`);
+      }
+      switch (op) {
+        case '>':
+          return left > right;
+        case '<':
+          return left < right;
+        case '>=':
+          return left >= right;
+        case '<=':
+          return left <= right;
+      }
+      break;
+  }
+  throw new Error(`Unknown operator: ${op}`);
+}
+
+/** Collects numeric values from a function argument, expanding ranges and skipping non-numeric cells. */
+function collectNumbers(args: Expr[], ctx: EvalContext): number[] {
+  const numbers: number[] = [];
+  for (const arg of args) {
+    if (arg.type === 'Range') {
+      for (const ref of expandRange(arg.start, arg.end)) {
+        const value = ctx.getCellValue(ref);
+        if (typeof value === 'number') numbers.push(value);
+      }
+    } else {
+      const value = evaluateExpr(arg, ctx);
+      if (typeof value === 'number') numbers.push(value);
+    }
+  }
+  return numbers;
+}
+
+function evaluateFunctionCall(name: string, args: Expr[], ctx: EvalContext): CellValue {
+  switch (name) {
+    case 'SUM':
+      return collectNumbers(args, ctx).reduce((sum, n) => sum + n, 0);
+    case 'AVERAGE': {
+      const numbers = collectNumbers(args, ctx);
+      if (numbers.length === 0) throw new FormulaError('DIV0');
+      return numbers.reduce((sum, n) => sum + n, 0) / numbers.length;
+    }
+    case 'MIN': {
+      const numbers = collectNumbers(args, ctx);
+      return numbers.length === 0 ? 0 : Math.min(...numbers);
+    }
+    case 'MAX': {
+      const numbers = collectNumbers(args, ctx);
+      return numbers.length === 0 ? 0 : Math.max(...numbers);
+    }
+    case 'COUNT':
+      return collectNumbers(args, ctx).length;
+    case 'IF': {
+      if (args.length !== 3) {
+        throw new FormulaError('VALUE', 'IF requires exactly 3 arguments');
+      }
+      const condition = toBoolean(evaluateExpr(args[0], ctx));
+      return condition ? evaluateExpr(args[1], ctx) : evaluateExpr(args[2], ctx);
+    }
+    default:
+      throw new FormulaError('NAME', `Unknown function: ${name}`);
+  }
+}
