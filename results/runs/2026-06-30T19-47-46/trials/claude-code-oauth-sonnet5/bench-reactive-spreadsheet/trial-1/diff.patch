--- /dev/null
+++ b/src/spreadsheet.ts
@@ -0,0 +1,193 @@
+import type { CellValue, Expr } from './ast.js';
+import { normalizeCellRef } from './cellRef.js';
+import { extractDependencies } from './dependencies.js';
+import { evaluateExpr } from './evaluator.js';
+import { FormulaError } from './errors.js';
+import { parseFormula } from './parser.js';
+
+interface CellRecord {
+  /** Literal value when this cell is not a formula; null when it holds a formula. */
+  literal: CellValue | null;
+  /** Raw formula text including the leading '=', or null for literal cells. */
+  formula: string | null;
+  ast: Expr | null;
+  /** Normalized refs of cells this cell's formula reads from. */
+  deps: Set<string>;
+  /** Cached computed value (or an error display string, e.g. "#DIV/0!"). */
+  value: CellValue;
+}
+
+function formatNumber(n: number): string {
+  if (!Number.isFinite(n)) return String(n);
+  const rounded = Math.round(n * 1e10) / 1e10;
+  return String(rounded);
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, CellRecord>();
+  /** ref -> set of cells whose formulas depend on ref */
+  private dependents = new Map<string, Set<string>>();
+
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cell);
+
+    if (typeof value === 'string' && value.startsWith('=')) {
+      const ast = parseFormula(value.slice(1));
+      const newDeps = extractDependencies(ast);
+
+      for (const dep of newDeps) {
+        if (this.dependsOn(dep, ref)) {
+          throw new Error(`Circular reference detected: setting ${ref} would create a cycle`);
+        }
+      }
+
+      this.unlink(ref);
+      const record = this.getOrCreateRecord(ref);
+      record.formula = value;
+      record.ast = ast;
+      record.deps = newDeps;
+      record.literal = null;
+      this.link(ref, newDeps);
+    } else {
+      this.unlink(ref);
+      const record = this.getOrCreateRecord(ref);
+      record.formula = null;
+      record.ast = null;
+      record.deps = new Set();
+      record.literal = value;
+    }
+
+    this.recomputeAndPropagate(ref);
+  }
+
+  get(cell: string): string | number | boolean | null {
+    const ref = normalizeCellRef(cell);
+    const record = this.cells.get(ref);
+    return record ? record.value : null;
+  }
+
+  getDisplay(cell: string): string {
+    const value = this.get(cell);
+    if (value === null) return '';
+    if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+    if (typeof value === 'number') return formatNumber(value);
+    return value;
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [ref, record] of this.cells) {
+      result.set(ref, record.value);
+    }
+    return result;
+  }
+
+  private getOrCreateRecord(ref: string): CellRecord {
+    let record = this.cells.get(ref);
+    if (!record) {
+      record = { literal: null, formula: null, ast: null, deps: new Set(), value: '' };
+      this.cells.set(ref, record);
+    }
+    return record;
+  }
+
+  /** Returns true if `from` depends, directly or transitively, on `target`. */
+  private dependsOn(from: string, target: string): boolean {
+    const visited = new Set<string>();
+    const stack = [from];
+    while (stack.length > 0) {
+      const cur = stack.pop() as string;
+      if (cur === target) return true;
+      if (visited.has(cur)) continue;
+      visited.add(cur);
+      const deps = this.cells.get(cur)?.deps;
+      if (deps) {
+        for (const d of deps) stack.push(d);
+      }
+    }
+    return false;
+  }
+
+  private unlink(ref: string): void {
+    const record = this.cells.get(ref);
+    if (!record) return;
+    for (const dep of record.deps) {
+      this.dependents.get(dep)?.delete(ref);
+    }
+  }
+
+  private link(ref: string, deps: Set<string>): void {
+    for (const dep of deps) {
+      let set = this.dependents.get(dep);
+      if (!set) {
+        set = new Set();
+        this.dependents.set(dep, set);
+      }
+      set.add(ref);
+    }
+  }
+
+  private recomputeAndPropagate(ref: string): void {
+    this.recomputeCell(ref);
+    for (const dependent of this.topoOrderForDependents(ref)) {
+      this.recomputeCell(dependent);
+    }
+  }
+
+  private recomputeCell(ref: string): void {
+    const record = this.cells.get(ref);
+    if (!record) return;
+
+    if (record.ast) {
+      try {
+        record.value = evaluateExpr(record.ast, {
+          getCellValue: (r) => this.cells.get(r)?.value ?? null,
+        });
+      } catch (err) {
+        record.value = err instanceof FormulaError ? err.display : '#ERROR!';
+      }
+    } else {
+      record.value = record.literal ?? '';
+    }
+  }
+
+  /** Computes a topological order over all transitive dependents of `start` (excluding `start`). */
+  private topoOrderForDependents(start: string): string[] {
+    const affected = new Set<string>();
+    const stack = [start];
+    while (stack.length > 0) {
+      const cur = stack.pop() as string;
+      for (const d of this.dependents.get(cur) ?? []) {
+        if (!affected.has(d)) {
+          affected.add(d);
+          stack.push(d);
+        }
+      }
+    }
+    if (affected.size === 0) return [];
+
+    const indegree = new Map<string, number>();
+    for (const node of affected) {
+      const deps = this.cells.get(node)?.deps ?? new Set<string>();
+      let count = 0;
+      for (const d of deps) {
+        if (affected.has(d)) count++;
+      }
+      indegree.set(node, count);
+    }
+
+    const queue: string[] = [...affected].filter((n) => indegree.get(n) === 0);
+    const order: string[] = [];
+    while (queue.length > 0) {
+      const n = queue.shift() as string;
+      order.push(n);
+      for (const m of this.dependents.get(n) ?? []) {
+        if (!affected.has(m)) continue;
+        const next = (indegree.get(m) ?? 0) - 1;
+        indegree.set(m, next);
+        if (next === 0) queue.push(m);
+      }
+    }
+    return order;
+  }
+}
