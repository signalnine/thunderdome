selects the correct branch', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 50);\n    sheet.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('big');\n\n    sheet.set('A1', 10);\n    expect(sheet.get('C1')).toBe('small');\n  });\n\n  it('IF supports all comparison operators', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=IF(A1=5, 1, 0)');\n    sheet.set('B2', '=IF(A1<>5, 1, 0)');\n    sheet.set('B3', '=IF(A1>=5, 1, 0)');\n    sheet.set('B4', '=IF(A1<=4, 1, 0)');\n    expect(sheet.get('B1')).toBe(1);\n    expect(sheet.get('B2')).toBe(0);\n    expect(sheet.get('B3')).toBe(1);\n    expect(sheet.get('B4')).toBe(0);\n  });\n\n  it('IF only evaluates the taken branch', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=IF(A1>0, 42, 1/0)');\n    expect(sheet.get('B1')).toBe(42);\n  });\n\n  it('IF can nest and combine with arithmetic', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 75);\n    sheet.set('B1', '=IF(A1>=90, \"A\", IF(A1>=70, \"B\", \"C\"))');\n    expect(sheet.get('B1')).toBe('B');\n  });\n\n  it('functions react reactively through dependents', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('B1', '=SUM(A1:A2)');\n    sheet.set('C1', '=IF(B1>50, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('small');\n\n    sheet.set('A1', 100);\n    expect(sheet.get('B1')).toBe(120);\n    expect(sheet.get('C1')).toBe('big');\n  });\n});\n\ndescribe('errors in formulas', () => {\n  it('produces a #DIV/0! error for division by zero', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=1/0');\n    expect(sheet.get('A1')).toBe('#DIV/0!');\n    expect(sheet.getDisplay('A1')).toBe('#DIV/0!');\n  });\n\n  it('produces a #VALUE! error for type mismatches', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 'hello');\n  