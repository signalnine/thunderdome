+++ b/src/dependencies.ts
@@ -0,0 +1,33 @@
+import type { Expr } from './ast.js';
+import { expandRange, normalizeCellRef } from './cellRef.js';
+
+/** Walks a formula AST and returns the set of normalized cell refs it reads from. */
+export function extractDependencies(node: Expr): Set<string> {
+  const deps = new Set<string>();
+
+  function visit(n: Expr): void {
+    switch (n.type) {
+      case 'CellRef':
+        deps.add(normalizeCellRef(n.ref));
+        break;
+      case 'Range':
+        for (const ref of expandRange(n.start, n.end)) deps.add(ref);
+        break;
+      case 'UnaryOp':
+        visit(n.operand);
+        break;
+      case 'BinaryOp':
+        visit(n.left);
+        visit(n.right);
+        break;
+      case 'FunctionCall':
+        for (const arg of n.args) visit(arg);
+        break;
+      default:
+        break;
+    }
+  }
+
+  visit(node);
+  return deps;
+}
