+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,41 @@
+import { Plugin } from '../core/types.js';
+
+const ASSET_URL_RE = /(src|href)="([^"]+)"/g;
+
+function isRelativeAsset(url: string): boolean {
+  return (
+    !/^[a-z][a-z0-9+.-]*:/i.test(url) &&
+    !url.startsWith('/') &&
+    !url.startsWith('//') &&
+    !url.startsWith('#')
+  );
+}
+
+interface AssetManifest {
+  assets: string[];
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file, ctx) => {
+        const existing = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assets = new Set<string>(existing?.assets ?? []);
+
+        const content = file.content.replace(ASSET_URL_RE, (match, attr: string, url: string) => {
+          if (!isRelativeAsset(url)) return match;
+          const filename = url.replace(/^\.\//, '');
+          assets.add(filename);
+          return `${attr}="/assets/${filename}"`;
+        });
+
+        ctx.data.set('asset-manifest', { assets: [...assets] });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/dev-server.ts b/src/plugins/dev-server.ts
new file mode 100644
index 0000000..93c608b
--- /dev/null
+++ b/src/plugins/dev-server.ts
@@ -0,0 +1,35 @@
+import { Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx) => {
+        const manifest = ctx.data.get('asset-manifest') as AssetManifest | undefined;
+        const assetPaths = manifest?.assets ?? [];
+
+        const routes: Array<{ path: string; handler: string }> = [];
+        for (const key of ctx.output.keys()) {
+          if (key === 'search-index.json') continue;
+          routes.push({ path: `/${key}`, handler: 'static' });
+        }
+        for (const asset of assetPaths) {
+          routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+        }
+
+        ctx.data.set('dev-server-config', {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath: ctx.output.has('search-index.json') ? '/search-index.json' : '',
+        });
+      },
+    },
+  };
+}
