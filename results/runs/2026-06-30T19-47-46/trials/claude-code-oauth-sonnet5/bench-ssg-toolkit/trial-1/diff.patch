+
+const FOOTNOTE_DEF_RE = /^\[\^([^\]]+)\]:\s*(.*)$/gm;
+const FOOTNOTE_REF_RE = /\[\^([^\]]+)\](?!:)/g;
+const ADMONITION_RE = /:::(\w+)\s*\n([\s\S]*?)\n:::/g;
+
+function extractFootnotes(content: string): { body: string; footnotes: Map<string, string> } {
+  const footnotes = new Map<string, string>();
+  const body = content.replace(FOOTNOTE_DEF_RE, (_match, id: string, text: string) => {
+    footnotes.set(id, text.trim());
+    return '';
+  });
+  return { body, footnotes };
+}
+
+function applyFootnoteRefs(content: string): string {
+  return content.replace(FOOTNOTE_REF_RE, (_match, id: string) => {
+    return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+  });
+}
+
+function renderAdmonitions(content: string): string {
+  return content.replace(ADMONITION_RE, (_match, type: string, body: string) => {
+    const inner = marked.parse(body.trim(), { async: false }) as string;
+    return `<div class="admonition admonition-${type}">\n${inner}</div>`;
+  });
+}
+
+function renderFootnoteSection(footnotes: Map<string, string>): string {
+  if (footnotes.size === 0) return '';
+  const items = [...footnotes.entries()]
+    .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        const { body, footnotes } = extractFootnotes(file.content);
+        const withRefs = applyFootnoteRefs(body);
+        const withAdmonitions = renderAdmonitions(withRefs);
+        const html = marked.parse(withAdmonitions, { async: false }) as string;
+        const footnoteSection = renderFootnoteSection(footnotes);
+        return {
+          ...file,
+          content: html + footnoteSection,
+        };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..46d4ce5
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,52 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function dateScore(date: string | undefined): number {
+  if (!date) return -Infinity;
+  const parsed = Date.parse(date);
+  return Number.isNaN(parsed) ? -Infinity : parsed;
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const link = `${baseUrl}/${file.slug}.html`;
+  const categories = (file.tags ?? []).map((tag) => `      <category>${escapeXml(tag)}</category>`).join('\n');
+  const pubDate = file.date ? `      <pubDate>${new Date(file.date).toUTCString()}</pubDate>\n` : '';
+  return `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${link}</link>
+      <guid>${link}</guid>
+${pubDate}      <description><![CDATA[${file.content}]]></description>
+${categories ? categories + '\n' : ''}    </item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx) => {
+        const sorted = [...ctx.files].sort((a, b) => dateScore(b.date) - dateScore(a.date));
+        const items = sorted.map((file) => renderItem(file, ctx.config.baseUrl)).join('\n');
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${ctx.config.baseUrl}</link>
+    <description>${escapeXml(ctx.config.title)}</description>
+${items}
+  </channel>
+</rss>`;
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
