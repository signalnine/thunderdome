+import { Plugin } from '../core/types.js';
+
+const CODE_BLOCK_RE = /<pre><code class="language-([\w-]+)">([\s\S]*?)<\/code><\/pre>/g;
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        const content = file.content.replace(
+          CODE_BLOCK_RE,
+          (_match, lang: string, code: string) =>
+            `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`
+        );
+        return { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
index 0000000..6fa8cfa
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,48 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild: (ctx) => {
+        const tagMap = new Map<string, ContentFile[]>();
+        for (const file of ctx.files) {
+          for (const rawTag of file.tags ?? []) {
+            const tag = rawTag.toLowerCase();
+            const existing = tagMap.get(tag);
+            if (existing) {
+              existing.push(file);
+            } else {
+              tagMap.set(tag, [file]);
+            }
+          }
+        }
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+      afterBuild: (ctx) => {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;
+        for (const [tag, files] of tagMap) {
+          const items = files
+            .map((file) => `<li><a href="/${file.slug}.html">${file.title}</a></li>`)
+            .join('\n');
+          const html = `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>Tag: ${tag}</title>
+</head>
+<body>
+  <h1>Tag: ${tag}</h1>
+  <ul>
+${items}
+  </ul>
+</body>
+</html>`;
+          ctx.output.set(`tags/${tag}.html`, html);
+        }
+      },
+    },
+  };
+}
