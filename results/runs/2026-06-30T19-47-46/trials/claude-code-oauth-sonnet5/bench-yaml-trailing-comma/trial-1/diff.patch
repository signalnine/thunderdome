E_DOUBLE\n155\t        expect(\n156\t          doc\n157\t            .toString(opt)\n158\t            .split('\\n')\n159\t            .map(line => line.length)\n160\t        ).toMatchObject([20, 20, 20, 20, 0])\n161\t      })\n162\t\n163\t      test('long line in sequence', () => {\n164\t        const foo = 'fuzz'.repeat(16)\n165\t        const doc = new YAML.Document<YAML.YAMLSeq<YAML.Scalar>, false>([foo], {\n166\t          version\n167\t        })\n168\t        for (const node of doc.value.items) node.type = Scalar.QUOTE_DOUBLE\n169\t        expect(\n170\t          doc\n171\t            .toString(opt)\n172\t            .split('\\n')\n173\t            .map(line => line.length)\n174\t        ).toMatchObject([20, 20, 20, 17, 0])\n175\t      })\n176\t\n177\t      test('long line in sequence in map', () => {\n178\t        const foo = 'fuzz'.repeat(16)\n179\t        const doc = new YAML.Document<\n180\t          YAML.YAMLMap<YAML.Scalar, YAML.YAMLSeq<YAML.Scalar>>,\n181\t          false\n182\t        >({ foo: [foo] }, { version })\n183\t        const seq = doc.value.items[0].value!\n184\t        for (const node of seq.items) node.type = Scalar.QUOTE_DOUBLE\n185\t        expect(\n186\t          doc\n187\t            .toString(opt)\n188\t            .split('\\n')\n189\t            .map(line => line.length)\n190\t        ).toMatchObject([4, 20, 20, 20, 20, 10, 0])\n191\t      })\n192\t\n193\t      test('Keep pipe when empty block literal is given', () => {\n194\t        const doc = YAML.parseDocument('|-')\n195\t        expect(String(doc)).toBe('|\\n\\n')\n196\t      })\n197\t\n198\t      test('Keep pipe when pipe is provided', () => {\n199\t        const doc = YAML.parseDocument('|')\n200\t        expect(String(doc)).toBe('|\\n\\n')\n201\t      })\n202\t    })\n203\t  })\n204\t}\n205\t\n206\tdescribe('timestamp-like string (YAML 1.1)', () => {\n207\t  for (const [name, str] of [\n208\t    ['canonical', '2001-12-15T02:59:43.1Z'],\n209\t    ['validIso8601', '2001-12-14t21:59:43.10-05:00'],\n210\t    ['spaceSeparated', '2001-12-14 21:59:43.10 -5'],\n211\t    ['noTimeZone', '2001-12-15 2:59:43.10']\n212\t  ]) {\n213\t    test(name, () => {\n214\t      const res = YAML.stringify(str, { version: '1.1' })\n215\t      expect(res).toBe(`\"${str}\"\\n`)\n216\t      expect(YAML.parse(res, { version: '1.1' })).toBe(str)\n217\t    })\n218\t  }\n219\t})\n220\t\n221\t// https://github.com/tc39/proposal-well-formed-stringify\n222\tdescribe('unpaired surrogate pairs of Unicode code points', () => {\n223\t  test('𝌆', () => {\n224\t    expect(YAML.stringify('𝌆')).toBe('𝌆\\n')\n225\t  })\n226\t  test('\\uD834\\uDF06', () => {\n227\t    expect(YAML.stringify('\\uD834\\uDF06')).toBe('𝌆\\n')\n228\t  })\n229\t  test('😀', () => {\n230\t    expect(YAML.stringify('😀')).toBe('😀\\n')\n231\t  })\n232\t  test('\\uD83D\\uDE00', () => {\n233\t    expect(YAML.stringify('\\uD83D\\uDE00')).toBe('😀\\n')\n234\t  })\n235\t  test('\\uDF06\\uD834', () => {\n236\t    expect(YAML.stringify('\\uDF06\\uD834')).toBe('\"\\\\udf06\\\\ud834\"\\n')\n237\t  })\n238\t  test('\\uDEAD', () => {\n239\t    expect(YAML.stringify('\\uDEAD')).toBe('\"\\\\udead\"\\n')\n240\t  })\n241\t})\n242\t\n243\tdescribe('circular references', () => {\n244\t  test('parent at root', () => {\n245\t    const map: any = { foo: 'bar' }\n246\t    map.map = map\n247\t    expect(YAML.stringify(map)).toBe(`&a1\n248\tfoo: bar\n249\tmap: *a1\\n`)\n250\t  })\n251\t\n252\t  test('ancestor at root', () => {\n253\t    const baz: any = {}\n254\t    const map = { foo: { bar: { baz } } }\n255\t    baz.map = map\n256\t    expect(YAML.stringify(map)).toBe(`&a1\n257\tfoo:\n258\t  bar:\n259\t    baz:\n260\t      map: *a1\\n`)\n261\t  })\n262\t\n263\t  test('sibling sequences', () => {\n264\t    const one = ['one']\n265\t    const two = ['two']\n266\t    const seq = [one, two, one, one, two]\n267\t    expect(YAML.stringify(seq)).toBe(`- &a1\n268\t  - one\n269\t- &a2\n270\t  - two\n271\t- *a1\n272\t- *a1\n273\t- *a2\\n`)\n274\t  })\n275\t\n276\t  test('further relatives', () => {\n277\t    const baz = { a: 1 }\n278\t    const seq = [{ foo: { bar: { baz } } }, { fe: { fi: { fo: { baz } } } }]\n279\t    expect(YAML.stringify(seq)).toBe(`- foo:\n280\t    bar:\n281\t      baz: &a1\n282\t        a: 1\n283\t- fe:\n284\t    fi:\n285\t      fo:\n286\t        baz: *a1\\n`)\n287\t  })\n288\t\n289\t  test('only match objects', () => {\n290\t    const date = new Date('2001-12-15T02:59:43.1Z')\n291\t    const seq = ['a', 'a', 1, 1, true, true, date, date]\n292\t    expect(YAML.stringify(seq, { anchorPrefix: 'foo', version: '1.1' }))\n293\t      .toBe(`- a\n294\t- a\n295\t- 1\n296\t- 1\n297\t- true\n298\t- true\n299\t- &foo1 2001-12-15T02:59:43.100Z\n300\t- *foo1\\n`)\n301\t  })\n302\t\n303\t  test('do not match nulls', () => {\n304\t    const set = { a: null, b: null }\n305\t    expect(YAML.stringify(set)).toBe('a: null\\nb: null\\n')\n306\t  })\n307\t})\n308\t\n309\ttest('array', () => {\n310\t  const array = [3, ['four', 5]]\n311\t  const str = YAML.stringify(array)\n312\t  expect(str).toBe(\n313\t    `- 3\n314\t- - four\n315\t  - 5\\n`\n316\t  )\n317\t})\n318\t\n319\tdescribe('maps', () => {\n320\t  test('JS Object', () => {\n321\t    const object = { x: 3, y: [4], z: { w: 'five', v: 6 } }\n322\t    const str = YAML.stringify(object)\n323\t    expect(str).toBe(\n324\t      `x: 3\n325\ty:\n326\t  - 4\n327\tz:\n328\t  w: five\n329\t  v: 6\\n`\n330\t    )\n331\t  })\n332\t\n333\t  test('Map with non-Pair item', () => {\n334\t    const doc = new YAML.Document<YAML.YAMLMap, false>({ x: 3, y: 4 })\n335\t    expect(String(doc)).toBe('x: 3\\ny: 4\\n')\n336\t    // @ts-expect-error This should fail.\n337\t    doc.value.items.push('TEST')\n338\t    expect(() => String(doc)).toThrow(/^Map items must all be pairs.*TEST/)\n339\t  })\n340\t\n341\t  test('Keep block scalar types for keys', () => {\n342\t    const doc = YAML.parseDocument('? >+ #comment\\n foo\\n\\n: bar')\n343\t    expect(String(doc)).toBe('? >+ #comment\\n  foo\\n\\n: bar\\n')\n344\t  })\n345\t\n346\t  test('Document as key', () => {\n347\t    const doc = new YAML.Document({ a: 1 })\n348\t    doc.set(new YAML.Document({ b: 2, c: 3 }), null)\n349\t    expect(String(doc)).toBe('a: 1\\n? b: 2\\n  c: 3\\n')\n350\t  })\n351\t\n352\t  test('plain key containing flow indicators', () => {\n353\t    const doc = YAML.parseDocument('foo[{}]: bar')\n354\t    expect(doc.toString()).toBe('foo[{}]: bar\\n')\n355\t  })\n356\t\n357\t  describe('No extra whitespace for empty values', () => {\n358\t    const getDoc = () =>\n359\t      new YAML.Document<YAML.YAMLMap, false>({\n360\t        a: null,\n361\t        b: null\n362\t      })\n363\t\n364\t    test('Block map, no comments', () => {\n365\t      expect(getDoc().toString({ nullStr: '' })).toBe('a:\\nb:\\n')\n366\t    })\n367\t\n368\t    test('Block map, with key.comment', () => {\n369\t      const doc = getDoc()\n370\t      doc.set('a', new Scalar(null))\n371\t      doc.value.items[0].key.comment = 'c'\n372\t      expect(doc.toString({ nullStr: '' })).toBe('a: #c\\nb:\\n')\n373\t    })\n374\t\n375\t    test('Block map, with value.commentBefore', () => {\n376\t      const doc = getDoc()\n377\t      doc.set('a', new Scalar(null))\n378\t      doc.get('a').commentBefore = 'c'\n379\t      expect(doc.toString({ nullStr: '' })).toBe('a:\\n  #c\\nb:\\n')\n380\t    })\n381\t\n382\t    test('Flow map, no comments', () => {\n383\t      const doc = getDoc()\n384\t      doc.value.flow = true\n385\t      expect(doc.toString({ nullStr: '' })).toBe('{ a:, b: }\\n')\n386\t    })\n387\t\n388\t    test('Flow map, with key.comment', () => {\n389\t      const doc = getDoc()\n390\t      doc.value.flow = true\n391\t      doc.value.items[0].key.comment = 'c'\n392\t      expect(doc.toString({ nullStr: '' })).toBe('{\\n  a:, #c\\n  b:\\n}\\n')\n393\t    })\n394\t\n395\t    test('Flow map, with value.commentBefore', () => {\n396\t      const doc = getDoc()\n397\t      doc.value.flow = true\n398\t      doc.set('a', new Scalar(null))\n399\t      doc.get('a').commentBefore = 'c'\n400\t      expect(doc.toString({ nullStr: '' })).toBe(\n401\t        '{\\n  a:\\n    #c\\n    ,\\n  b:\\n}\\n'\n402\t      )\n403\t    })\n404\t\n405\t    test('Single newline after key with empty value', () => {\n406\t      const src = source`\n407\t      map:\n408\t        item:\n409\t\n410\t      anothermap:\n411\t        anotheritem:\n412\t\n413\t      `\n414\t      const doc = YAML.parseDocument(src)\n415\t      expect(String(doc)).toBe(src)\n416\t    })\n417\t  })\n418\t\n419\t  describe('properties on collections in block mapping', () => {\n420\t    test('explicit tag on block sequence', () => {\n421\t      const src = source`\n422\t        key: !tag\n423\t          - one\n424\t          - two\n425\t      `\n426\t      const doc = YAML.parseDocument(src)\n427\t      expect(String(doc)).toBe(src)\n428\t    })\n429\t    test('explicit tag on block mapping', () => {\n430\t      const src = source`\n431\t        key: !tag\n432\t          one: 1\n433\t          two: 2\n434\t      `\n435\t      const doc = YAML.parseDocument(src)\n436\t      expect(String(doc)).toBe(src)\n437\t    })\n438\t    test('single-line comment on block sequence', () => {\n439\t      const src = source`\n440\t        key: #comment\n441\t          - one\n442\t          - two\n443\t      `\n444\t      const doc = YAML.parseDocument(src)\n445\t      expect(String(doc)).toBe(source`\n446\t        key:\n447\t          #comment\n448\t          - one\n449\t          - two\n450\t      `)\n451\t    })\n452\t    test('single-line comment and explicit tag on block sequence', () => {\n453\t      const src = source`\n454\t        key: #comment\n455\t          !tag\n456\t          - one\n457\t          - two\n458\t      `\n459\t      const doc = YAML.parseDocument(src)\n460\t      expect(String(doc)).toBe(source`\n461\t        key:\n462\t          #comment\n463\t          !tag\n464\t          - one\n465\t          - two\n466\t      `)\n467\t    })\n468\t    test('explicit tag and comment on block sequence', () => {\n469\t      const src = source`\n470\t        key: !tag\n471\t          #comment\n472\t          - one\n473\t          - two\n474\t      `\n475\t      const doc = YAML.parseDocument(src)\n476\t      expect(String(doc)).toBe(source`\n477\t        key:\n478\t          #comment\n479\t          !tag\n480\t          - one\n481\t          - two\n482\t      `)\n483\t    })\n484\t    test('anchor on block sequence', () => {\n485\t      const src = source`\n486\t        key: &anchor\n487\t          - one\n488\t          - two\n489\t      `\n490\t      const doc = YAML.parseDocument(src)\n491\t      expect(String(doc)).toBe(src)\n492\t    })\n493\t    test('anchor and explicit tag on block sequence', () => {\n494\t      const src = source`\n495\t        key: &anchor !tag\n496\t          - one\n497\t          - two\n498\t      `\n499\t      const doc = YAML.parseDocument(src)\n500\t      expect(String(doc)).toBe(src)\n501\t    })\n502\t    test('explicit tag on empty mapping', () => {\n503\t      const doc = new YAML.Document<YAML.DocValue, false>({ key: {} })\n504\t      doc.get('key').tag = '!tag'\n505\t      expect(String(doc)).toBe(source`\n506\t        key: !tag {}\n507\t      `)\n508\t    })\n509\t    test('explicit tag on single-line flow mapping', () => {\n510\t      const src = source`\n511\t        key: !tag { one: 1, two: 2 }\n512\t      `\n513\t      const doc = YAML.parseDocument(src)\n514\t      expect(String(doc)).toBe(src)\n515\t    })\n516\t    test('explicit tag on multi-line flow mapping', () => {\n517\t      const src = source`\n518\t        key: !tag {\n519\t          one: aaaaaaaaaa,\n520\t          two: bbbbbbbbbb,\n521\t          three: cccccccccc,\n522\t          four: dddddddddd,\n523\t          five: eeeeeeeeee\n524\t        }\n525\t      `\n526\t      const doc = YAML.parseDocument(src)\n527\t      expect(String(doc)).toBe(source`\n528\t        key:\n529\t          !tag {\n530\t            one: aaaaaaaaaa,\n531\t            two: bbbbbbbbbb,\n532\t            three: cccccccccc,\n533\t            four: dddddddddd,\n534\t            five: eeeeeeeeee\n535\t          }\n536\t      `)\n537\t    })\n538\t    test('explicit tag on explicit-value block sequence', () => {\n539\t      const src = source`\n540\t        ? [ key ]\n541\t        : !tag\n542\t          - one\n543\t          - two\n544\t      `\n545\t      const doc = YAML.parseDocument(src)\n546\t      expect(String(doc)).toBe(src)\n547\t    })\n548\t  })\n549\t})\n550\t\n551\ttest('Quoting colons (#43)', () => {\n552\t  const doc = new YAML.Document({ key: ':' })\n553\t  const str = String(doc)\n554\t  expect(() => YAML.parse(str)).not.toThrow()\n555\t  expect(str).toBe('key: \":\"\\n')\n556\t})\n557\t\n558\ttest('Quoting item markers (#52)', () => {\n559\t  const doc = new YAML.Document({ key: '-' })\n560\t  const str = String(doc)\n561\t  expect(() => YAML.parse(str)).not.toThrow()\n562\t  expect(str).toBe('key: \"-\"\\n')\n563\t  doc.value = doc.createNode({ key: '?' })\n564\t  const str2 = String(doc)\n565\t  expect(() => YAML.parse(str2)).not.toThrow()\n566\t  expect(str2).toBe('key: \"?\"\\n')\n567\t})\n568\t\n569\ttest('reserved names', () => {\n570\t  const str = YAML.stringify({ comment: 'foo' })\n571\t  expect(str).toBe('comment: foo\\n')\n572\t})\n573\t\n574\tdescribe('Collection pairs with single-line flow collections (#85)', () => {\n575\t  test('reported', () => {\n576\t    const str = `testArray: []\\ntestObject: {}\\ntestArray2: [ \"hello\" ]\\n`\n577\t    const doc = YAML.parseDocument(str)\n578\t    expect(String(doc)).toBe(str)\n579\t  })\n580\t\n581\t  test('multiline flow collection', () => {\n582\t    const str = `foo: [ bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar, bar ]`\n583\t    const doc = YAML.parseDocument(str)\n584\t    const str2 = String(doc)\n585\t    expect(str2).toMatch(/^foo:\\n {2}\\[\\n {4}bar/)\n586\t    expect(YAML.parse(str2)).toMatchObject(doc.toJS())\n587\t  })\n588\t})\n589\t\n590\ttest('set(object) in collection (#87)', () => {\n591\t  const doc = YAML.parseDocument('test: x')\n592\t  doc.set('test', { a: 'test' })\n593\t  expect(String(doc)).toBe('test:\\n  a: test\\n')\n594\t})\n595\t\n596\tdescribe('Custom null/bool string representations', () => {\n597\t  test('tilde null', () => {\n598\t    const doc = YAML.parse('a: null')\n599\t    const str = YAML.stringify(doc, { nullStr: '~', simpleKeys: true })\n600\t    expect(str).toBe('a: ~\\n')\n601\t    expect(YAML.parse(str)).toEqual({ a: null })\n602\t  })\n603\t\n604\t  test('empty string null', () => {\n605\t    const doc = YAML.parse('a: null')\n606\t    const str = YAML.stringify(doc, { nullStr: '', simpleKeys: true })\n607\t    expect(str).toBe('a:\\n')\n608\t    expect(YAML.parse(str)).toEqual({ a: null })\n609\t  })\n610\t\n611\t  test('empty string camelBool', () => {\n612\t    const doc = YAML.parse('[true, false]')\n613\t    const str = YAML.stringify(doc, { trueStr: 'True', falseStr: 'False' })\n614\t    expect(str).toBe('- True\\n- False\\n')\n615\t    expect(YAML.parse(str)).toEqual([true, false])\n616\t  })\n617\t\n618\t  test('empty string upperBool', () => {\n619\t    const doc = YAML.parse('[true, false]')\n620\t    const str = YAML.stringify(doc, { trueStr: 'TRUE', falseStr: 'FALSE' })\n621\t    expect(str).toBe('- TRUE\\n- FALSE\\n')\n622\t    expect(YAML.parse(str)).toEqual([true, false])\n623\t  })\n624\t})\n625\t\n626\tdescribe('scalar styles', () => {\n627\t  test('null Scalar styles', () => {\n628\t    const doc = YAML.parseDocument('[ null, Null, NULL, ~ ]')\n629\t    expect(String(doc)).toBe('[ null, Null, NULL, ~ ]\\n')\n630\t  })\n631\t\n632\t  test('bool Scalar styles on core', () => {\n633\t    const doc = YAML.parseDocument(\n634\t      '[ true, false, True, False, TRUE, FALSE, on, off, y, n ]'\n635\t    )\n636\t    const str = `[\n637\t  true,\n638\t  false,\n639\t  True,\n640\t  False,\n641\t  TRUE,\n642\t  FALSE,\n643\t  on,\n644\t  off,\n645\t  y,\n646\t  n\n647\t]\\n`\n648\t    expect(doc.toString({ lineWidth: 1 })).toBe(str)\n649\t    expect(YAML.parse(str)).toEqual([\n650\t      true,\n651\t      false,\n652\t      true,\n653\t      false,\n654\t      true,\n655\t      false,\n656\t      'on',\n657\t      'off',\n658\t      'y',\n659\t      'n'\n660\t    ])\n661\t  })\n662\t\n663\t  test('bool Scalar styles on YAML1.1', () => {\n664\t    const doc = YAML.parseDocument(\n665\t      '[ n, N, NO, no, No, False, false, FALSE, FALse, Off, off, OFF, OfF, y, Y, Yes, yes, YES, true, True, TRUE, ON, on, On ]',\n666\t      { schema: 'yaml-1.1' }\n667\t    )\n668\t    const str = `[\n669\t  n,\n670\t  N,\n671\t  NO,\n672\t  no,\n673\t  No,\n674\t  False,\n675\t  false,\n676\t  FALSE,\n677\t  FALse,\n678\t  Off,\n679\t  off,\n680\t  OFF,\n681\t  OfF,\n682\t  y,\n683\t  Y,\n684\t  Yes,\n685\t  yes,\n686\t  YES,\n687\t  true,\n688\t  True,\n689\t  TRUE,\n690\t  ON,\n691\t  on,\n692\t  On\n693\t]\\n`\n694\t    expect(String(doc)).toBe(str)\n695\t    expect(YAML.parse(str, { schema: 'yaml-1.1' })).toEqual([\n696\t      false,\n697\t      false,\n698\t      false,\n699\t      false,\n700\t      false,\n701\t      false,\n702\t      false,\n703\t      false,\n704\t      'FALse',\n705\t      false,\n706\t      false,\n707\t      false,\n708\t      'OfF',\n709\t      true,\n710\t      true,\n711\t      true,\n712\t      true,\n713\t      true,\n714\t      true,\n715\t      true,\n716\t      true,\n717\t      true,\n718\t      true,\n719\t      true\n720\t    ])\n721\t  })\n722\t})\n723\t\n724\tdescribe('simple keys', () => {\n725\t  test('key with no value', () => {\n726\t    const doc = YAML.parseDocument('? ~')\n727\t    expect(doc.toString()).toBe('~: null\\n')\n728\t    expect(doc.toString({ simpleKeys: true })).toBe('~: null\\n')\n729\t  })\n730\t\n731\t  test('key with block scalar value', () => {\n732\t    const doc = YAML.parseDocument<any>('foo: bar')\n733\t    doc.value.items[0].key.type = 'BLOCK_LITERAL'\n734\t    expect(doc.toString()).toBe('? |-\\n  foo\\n: bar\\n')\n735\t    expect(doc.toString({ simpleKeys: true })).toBe('\"foo\": bar\\n')\n736\t  })\n737\t\n738\t  test('key with comment', () => {\n739\t    const doc = YAML.parseDocument<any>('foo: bar')\n740\t    doc.value.items[0].key.comment = 'FOO'\n741\t    expect(doc.toString()).toBe('foo: #FOO\\n  bar\\n')\n742\t    expect(() => doc.toString({ simpleKeys: true })).toThrow(\n743\t      /With simple keys, key nodes cannot have comments/\n744\t    )\n745\t  })\n746\t\n747\t  test('key with collection value', () => {\n748\t    const doc = YAML.parseDocument('[foo]: bar')\n749\t    expect(doc.toString()).toBe('? [ foo ]\\n: bar\\n')\n750\t    expect(() => doc.toString({ simpleKeys: true })).toThrow(\n751\t      /With simple keys, collection cannot be used as a key value/\n752\t    )\n753\t  })\n754\t\n755\t  test('key value length > 1024', () => {\n756\t    const str = `\n757\t    ? ${new Array(1026).join('a')}\n758\t    : longkey`\n759\t    const doc = YAML.parseDocument(str)\n760\t    expect(doc.toString()).toBe(`? ${new Array(1026).join('a')}\\n: longkey\\n`)\n761\t    expect(() => doc.toString({ simpleKeys: true })).toThrow(\n762\t      /With simple keys, single line scalar must not span more than 1024 characters/\n763\t    )\n764\t  })\n765\t})\n766\t\n767\ttest('YAML node inside object (#128)', () => {\n768\t  const doc = new YAML.Document()\n769\t  const seq = doc.createNode(['a'])\n770\t  seq.commentBefore = 'sc'\n771\t  const map = doc.createNode({ foo: 'bar', seq })\n772\t  map.commentBefore = 'mc'\n773\t  const obj = { array: [1], map }\n774\t  expect(YAML.stringify(obj)).toBe(source`\n775\t    array:\n776\t      - 1\n777\t    map:\n778\t      #mc\n779\t      foo: bar\n780\t      seq:\n781\t        #sc\n782\t        - a\n783\t  `)\n784\t})\n785\t\n786\tdescribe('sortMapEntries', () => {\n787\t  const obj = { b: 2, a: 1, c: 3 }\n788\t  test('sortMapEntries: undefined', () => {\n789\t    expect(YAML.stringify(obj)).toBe('b: 2\\na: 1\\nc: 3\\n')\n790\t  })\n791\t  test('sortMapEntries: true', () => {\n792\t    expect(YAML.stringify(obj, { sortMapEntries: true })).toBe(\n793\t      'a: 1\\nb: 2\\nc: 3\\n'\n794\t    )\n795\t  })\n796\t  test('sortMapEntries: function', () => {\n797\t    const sortMapEntries = (a: any, b: any) =>\n798\t      a.key < b.key ? 1 : a.key > b.key ? -1 : 0\n799\t    expect(YAML.stringify(obj, { sortMapEntries })).toBe('c: 3\\nb: 2\\na: 1\\n')\n800\t  })\n801\t  test('doc.add', () => {\n802\t    const doc = new YAML.Document(obj, { sortMapEntries: true })\n803\t    doc.add(doc.createPair('bb', 4))\n804\t    expect(String(doc)).toBe('a: 1\\nb: 2\\nbb: 4\\nc: 3\\n')\n805\t  })\n806\t  test('doc.set', () => {\n807\t    const doc = new YAML.Document(obj, { sortMapEntries: true })\n808\t    doc.set('bb', 4)\n809\t    expect(String(doc)).toBe('a: 1\\nb: 2\\nbb: 4\\nc: 3\\n')\n810\t  })\n811\t})\n812\t\n813\tdescribe('custom indent', () => {\n814\t  let obj: unknown\n815\t  beforeEach(() => {\n816\t    const doc = new YAML.Document()\n817\t    const seq = doc.createNode(['a'])\n818\t    seq.commentBefore = 'sc'\n819\t    const map = doc.createNode({ foo: 'bar', seq })\n820\t    map.commentBefore = 'mc'\n821\t    obj = { array: [{ a: 1, b: 2 }], map }\n822\t  })\n823\t\n824\t  test('indent: 0', () => {\n825\t    expect(() => YAML.stringify(obj, { indent: 0 })).toThrow(\n826\t      /must be a positive integer/\n827\t    )\n828\t  })\n829\t\n830\t  test('indent: 1', () => {\n831\t    expect(YAML.stringify(obj, { indent: 1 })).toBe(source`\n832\t      array:\n833\t       - a: 1\n834\t         b: 2\n835\t      map:\n836\t       #mc\n837\t       foo: bar\n838\t       seq:\n839\t        #sc\n840\t        - a\n841\t    `)\n842\t  })\n843\t\n844\t  test('indent: 4', () => {\n845\t    expect(YAML.stringify(obj, { indent: 4 })).toBe(source`\n846\t      array:\n847\t          - a: 1\n848\t            b: 2\n849\t      map:\n850\t          #mc\n851\t          foo: bar\n852\t          seq:\n853\t              #sc\n854\t              - a\n855\t    `)\n856\t  })\n857\t})\n858\t\n859\tdescribe('indentSeq: false', () => {\n860\t  let obj: unknown\n861\t  beforeEach(() => {\n862\t    const seq = new YAML.Document().createNode(['a'])\n863\t    seq.commentBefore = 'sc'\n864\t    obj = { array: [{ a: 1, b: 2 }], map: { seq } }\n865\t  })\n866\t\n867\t  test('indent: 1', () => {\n868\t    expect(YAML.stringify(obj, { indent: 1, indentSeq: false })).toBe(source`\n869\t      array:\n870\t       - a: 1\n871\t         b: 2\n872\t      map:\n873\t       seq:\n874\t        #sc\n875\t        - a\n876\t    `)\n877\t  })\n878\t\n879\t  test('indent: 2', () => {\n880\t    expect(YAML.stringify(obj, { indent: 2, indentSeq: false })).toBe(source`\n881\t      array:\n882\t      - a: 1\n883\t        b: 2\n884\t      map:\n885\t        seq:\n886\t        #sc\n887\t        - a\n888\t    `)\n889\t  })\n890\t\n891\t  test('indent: 4', () => {\n892\t    expect(YAML.stringify(obj, { indent: 4, indentSeq: false })).toBe(source`\n893\t      array:\n894\t        - a: 1\n895\t          b: 2\n896\t      map:\n897\t          seq:\n898\t            #sc\n899\t            - a\n900\t    `)\n901\t  })\n902\t})\n903\t\n904\tdescribe('lineWidth', () => {\n905\t  const doc = YAML.parseDocument(\n906\t    \"[ 'Sed', 'ut', 'perspiciatis', 'unde', 'omnis', 'iste', 'natus', 'error', 'sit', 'voluptatem', 'accusantium', 'doloremque', 'laudantium,', 'totam' ]\"\n907\t  )\n908\t\n909\t  test('limit to 80 with overlong flow collection', () => {\n910\t    expect(doc.toString({ lineWidth: 80 })).toBe(`[\n911\t  'Sed',\n912\t  'ut',\n913\t  'perspiciatis',\n914\t  'unde',\n915\t  'omnis',\n916\t  'iste',\n917\t  'natus',\n918\t  'error',\n919\t  'sit',\n920\t  'voluptatem',\n921\t  'accusantium',\n922\t  'doloremque',\n923\t  'laudantium,',\n924\t  'totam'\n925\t]\n926\t`)\n927\t  })\n928\t\n929\t  test('limit > flow collection length', () => {\n930\t    expect(doc.toString({ lineWidth: 162 })).toBe(\n931\t      \"[ 'Sed', 'ut', 'perspiciatis', 'unde', 'omnis', 'iste', 'natus', 'error', 'sit', 'voluptatem', 'accusantium', 'doloremque', 'laudantium,', 'totam' ]\\n\"\n932\t    )\n933\t  })\n934\t\n935\t  test('less than minContentWidth (#562)', () => {\n936\t    const doc = YAML.parseDocument('>\\ntest test test test test')\n937\t    expect(doc.toString({ lineWidth: 18, minContentWidth: 20 })).toBe(\n938\t      '>\\ntest test test\\ntest test\\n'\n939\t    )\n940\t  })\n941\t})\n942\t\n943\tdescribe('collectionStyle', () => {\n944\t  test('collectionStyle: undefined', () => {\n945\t    const doc = new YAML.Document<YAML.YAMLMap, false>({ foo: ['bar'] })\n946\t    expect(doc.toString()).toBe('foo:\\n  - bar\\n')\n947\t\n948\t    doc.value.flow = false\n949\t    doc.get('foo').flow = true\n950\t    expect(doc.toString()).toBe('foo: [ bar ]\\n')\n951\t\n952\t    doc.value.flow = true\n953\t    doc.get('foo').flow = false\n954\t    expect(doc.toString()).toBe('{ foo: [ bar ] }\\n')\n955\t  })\n956\t\n957\t  test(\"collectionStyle: 'any'\", () => {\n958\t    const doc = new YAML.Document<YAML.YAMLMap, false>({ foo: ['bar'] })\n959\t    expect(doc.toString({ collectionStyle: 'any' })).toBe('foo:\\n  - bar\\n')\n960\t\n961\t    doc.value.flow = false\n962\t    doc.get('foo').flow = true\n963\t    expect(doc.toString({ collectionStyle: 'any' })).toBe('foo: [ bar ]\\n')\n964\t\n965\t    doc.value.flow = true\n966\t    doc.get('foo').flow = false\n967\t    expect(doc.toString({ collectionStyle: 'any' })).toBe('{ foo: [ bar ] }\\n')\n968\t  })\n969\t\n970\t  test(\"collectionStyle: 'block'\", () => {\n971\t    const doc = new YAML.Document<YAML.YAMLMap, false>({ foo: ['bar'] })\n972\t    expect(doc.toString({ collectionStyle: 'block' })).toBe('foo:\\n  - bar\\n')\n973\t\n974\t    doc.value.flow = false\n975\t    doc.get('foo').flow = true\n976\t    expect(doc.toString({ collectionStyle: 'block' })).toBe('foo:\\n  - bar\\n')\n977\t\n978\t    doc.value.flow = true\n979\t    doc.get('foo').flow = false\n980\t    expect(doc.toString({ collectionStyle: 'block' })).toBe('foo:\\n  - bar\\n')\n981\t  })\n982\t\n983\t  test(\"collectionStyle: 'flow'\", () => {\n984\t    const doc = new YAML.Document<YAML.YAMLMap, false>({ foo: ['bar'] })\n985\t    expect(doc.toString({ collectionStyle: 'flow' })).toBe('{ foo: [ bar ] }\\n')\n986\t\n987\t    doc.get('foo').flow = true\n988\t    expect(doc.toString({ collectionStyle: 'flow' })).toBe('{ foo: [ bar ] }\\n')\n989\t\n990\t    doc.value.flow = true\n991\t    doc.get('foo').flow = false\n992\t    expect(doc.toString({ collectionStyle: 'flow' })).toBe('{ foo: [ bar ] }\\n')\n993\t  })\n994\t})\n995\t\n996\tdescribe('Scalar options', () => {\n997\t  describe('defaultStringType & defaultKeyType', () => {\n998\t    test('PLAIN, PLAIN', () => {\n999\t      const opt = {\n1000\t        defaultStringType: Scalar.PLAIN,\n1001\t        defaultKeyType: Scalar.PLAIN\n1002\t      } as const\n1003\t      expect(YAML.stringify({ foo: 'bar' }, opt)).toBe('foo: bar\\n')\n1004\t    })\n1005\t\n1006\t    test('BLOCK_FOLDED, BLOCK_FOLDED', () => {\n1007\t      const opt = {\n1008\t        defaultStringType: Scalar.BLOCK_FOLDED,\n1009\t        defaultKeyType: Scalar.BLOCK_FOLDED\n1010\t      } as const\n1011\t      expect(YAML.stringify({ foo: 'bar' }, opt)).toBe('\"foo\": |-\\n  bar\\n')\n1012\t    })\n1013\t\n1014\t    test('QUOTE_DOUBLE, PLAIN', () => {\n1015\t      const opt = {\n1016\t        defaultStringType: Scalar.QUOTE_DOUBLE,\n1017\t        defaultKeyType: Scalar.PLAIN\n1018\t      } as const\n1019\t      expect(YAML.stringify({ foo: 'bar' }, opt)).toBe('foo: \"bar\"\\n')\n1020\t    })\n1021\t\n1022\t    test('QUOTE_DOUBLE, QUOTE_SINGLE', () => {\n1023\t      const opt = {\n1024\t        defaultStringType: Scalar.QUOTE_DOUBLE,\n1025\t        defaultKeyType: Scalar.QUOTE_SINGLE\n1026\t      } as const\n1027\t      expect(YAML.stringify({ foo: 'bar' }, opt)).toBe('\\'foo\\': \"bar\"\\n')\n1028\t    })\n1029\t\n1030\t    test('QUOTE_DOUBLE, null', () => {\n1031\t      const opt = {\n1032\t        defaultStringType: Scalar.QUOTE_DOUBLE,\n1033\t        defaultKeyType: null\n1034\t      } as const\n1035\t      expect(YAML.stringify({ foo: 'bar' }, opt)).toBe('\"foo\": \"bar\"\\n')\n1036\t    })\n1037\t\n1038\t    test('Use defaultStringType for explicit keys', () => {\n1039\t      const opt = {\n1040\t        blockQuote: false,\n1041\t        defaultStringType: Scalar.QUOTE_DOUBLE,\n1042\t        defaultKeyType: Scalar.QUOTE_SINGLE\n1043\t      } as const\n1044\t      const doc = new YAML.Document<YAML.YAMLMap, false>({ foo: null })\n1045\t      const key = doc.value.items[0].key as Scalar\n1046\t      key.type = Scalar.BLOCK_LITERAL\n1047\t      expect(doc.toString(opt)).toBe('? \"foo\"\\n')\n1048\t    })\n1049\t  })\n1050\t\n1051\t  for (const { singleQuote, numeric, upgrade, parsed } of [\n1052\t    {\n1053\t      singleQuote: null,\n1054\t      numeric: '\"123\"\\n',\n1055\t      upgrade: '\"foo #bar\"\\n',\n1056\t      parsed: \"'foo'\\n\"\n1057\t    },\n1058\t    {\n1059\t      singleQuote: false,\n1060\t      numeric: '\"123\"\\n',\n1061\t      upgrade: '\"foo #bar\"\\n',\n1062\t      parsed: '\"foo\"\\n'\n1063\t    },\n1064\t    {\n1065\t      singleQuote: true,\n1066\t      numeric: \"'123'\\n\",\n1067\t      upgrade: \"'foo #bar'\\n\",\n1068\t      parsed: \"'foo'\\n\"\n1069\t    }\n1070\t  ]) {\n1071\t    describe(`singleQuote: ${singleQuote}`, () => {\n1072\t      const opt = { singleQuote }\n1073\t\n1074\t      test('plain', () => {\n1075\t        expect(YAML.stringify('foo bar', opt)).toBe('foo bar\\n')\n1076\t      })\n1077\t\n1078\t      test('contains double-quote', () => {\n1079\t        expect(YAML.stringify('foo: \"bar\"', opt)).toBe(\n1080\t          singleQuote === false ? `\"foo: \\\\\"bar\\\\\"\"\\n` : `'foo: \"bar\"'\\n`\n1081\t        )\n1082\t 