ore(ctx, lines, item.commentBefore, chompKeep)\n53\t      if (item.comment) comment = item.comment\n54\t    }\n55\t\n56\t    chompKeep = false\n57\t    let str = stringify(\n58\t      item,\n59\t      itemCtx,\n60\t      () => (comment = null),\n61\t      () => (chompKeep = true)\n62\t    )\n63\t    if (comment) str += lineComment(str, itemIndent, commentString(comment))\n64\t    if (chompKeep && comment) chompKeep = false\n65\t    lines.push(blockItemPrefix + str)\n66\t  }\n67\t\n68\t  let str: string\n69\t  if (lines.length === 0) {\n70\t    str = flowChars.start + flowChars.end\n71\t  } else {\n72\t    str = lines[0]\n73\t    for (let i = 1; i < lines.length; ++i) {\n74\t      const line = lines[i]\n75\t      str += line ? `\\n${indent}${line}` : '\\n'\n76\t    }\n77\t  }\n78\t\n79\t  if (comment) {\n80\t    str += '\\n' + indentComment(commentString(comment), indent)\n81\t    if (onComment) onComment()\n82\t  } else if (chompKeep && onChompKeep) onChompKeep()\n83\t\n84\t  return str\n85\t}\n86\t\n87\tfunction stringifyFlowCollection(\n88\t  { items }: Readonly<Collection>,\n89\t  ctx: StringifyContext,\n90\t  { flowChars, itemIndent }: StringifyCollectionOptions\n91\t) {\n92\t  const {\n93\t    indent,\n94\t    indentStep,\n95\t    flowCollectionPadding: fcPadding,\n96\t    options: { commentString }\n97\t  } = ctx\n98\t  itemIndent += indentStep\n99\t  const itemCtx = Object.assign({}, ctx, {\n100\t    indent: itemIndent,\n101\t    inFlow: true,\n102\t    type: null\n103\t  })\n104\t\n105\t  let reqNewline = false\n106\t  let linesAtValue = 0\n107\t  const lines: string[] = []\n108\t  for (let i = 0; i < items.length; ++i) {\n109\t    const item = items[i]\n110\t    let comment: string | null = null\n111\t    if (item instanceof Pair) {\n112\t      const ik = item.key\n113\t      if (ik.spaceBefore) lines.push('')\n114\t      addCommentBefore(ctx, lines, ik.commentBefore, false)\n115\t      if (ik.comment) reqNewline = true\n116\t\n117\t      const iv = item.va