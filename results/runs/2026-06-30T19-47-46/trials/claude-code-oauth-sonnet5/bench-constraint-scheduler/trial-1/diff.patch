erred.id, start: booking.start, end: booking.end };\n      }\n    }\n  }\n\n  let best: { room: Room; slot: number } | null = null;\n  for (const room of candidateRooms) {\n    if (room.id === event.preferredRoom) continue;\n    const bookings = roomBookings.get(room.id)!;\n    const slot = findSlot(bookings, earliestStart, event.duration, gap, windowEnd);\n    if (slot === null) continue;\n    if (\n      best === null ||\n      slot < best.slot ||\n      (slot === best.slot && room.capacity < best.room.capacity)\n    ) {\n      best = { room, slot };\n    }\n  }\n  if (best === null) return null;\n\n  const bookings = roomBookings.get(best.room.id)!;\n  const booking = { start: best.slot, end: best.slot + event.duration };\n  insertBooking(bookings, booking);\n  return { roomId: best.room.id, start: booking.start, end: booking.end };\n}\n\nexport function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  validateNoCycles(events);\n\n  const gap = options.gap ?? DEFAULT_GAP;\n  const { startTime, endTime } = options;\n\n  const eventMap = new Map(events.map((e) => [e.id, e]));\n  const dependents = new Map<string, string[]>();\n  const remainingPrereqs = new Map<string, Set<string>>();\n  const unsatisfiable = new Set<string>();\n\n  for (const event of events) {\n    const prereqs = event.prerequisites ?? [];\n    const validPrereqs = new Set<string>();\n    for (const prereqId of prereqs) {\n      if (prereqId === event.id) continue; // caught by cycle validation already\n      if (!eventMap.has(prereqId)) {\n        unsatisfiable.add(event.id);\n        continue;\n      }\n      validPrereqs.add(prereqId);\n      if (!dependents.has(prereqId)) dependents.set(prereqId, []);\n      dependents.get(prereqId)!.push(event.id);\n    }\n    remainingPrereqs.set(event.id, validPrereqs);\n  }\n\n  const roomBookings = new Map<string, Booking[]>(rooms.map((r) => [r.id, []]));\n  const scheduledEnd = new Map<string, { end: number }>();\