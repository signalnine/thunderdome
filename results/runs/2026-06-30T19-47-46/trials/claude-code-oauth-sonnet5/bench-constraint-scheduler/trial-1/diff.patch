diff --git a/src/scheduler.ts b/src/scheduler.ts
new file mode 100644
index 0000000..f735b4c
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,225 @@
+import type { Event, Room, ScheduleOptions, ScheduleResult, Assignment } from './types.js';
+
+const DEFAULT_GAP = 15;
+
+/**
+ * Throws if the prerequisite graph (including self-references) contains a cycle.
+ * References to non-existent event IDs are ignored here; they are treated as
+ * permanently-unsatisfiable prerequisites during scheduling instead.
+ */
+function validateNoCycles(events: Event[]): void {
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  const UNVISITED = 0;
+  const VISITING = 1;
+  const DONE = 2;
+  const state = new Map<string, 0 | 1 | 2>();
+
+  function visit(id: string): void {
+    state.set(id, VISITING);
+    const event = eventMap.get(id);
+    for (const prereqId of event?.prerequisites ?? []) {
+      if (prereqId === id) {
+        throw new Error(`Prerequisite cycle detected: event "${id}" depends on itself`);
+      }
+      if (!eventMap.has(prereqId)) continue;
+      const prereqState = state.get(prereqId) ?? UNVISITED;
+      if (prereqState === VISITING) {
+        throw new Error(`Prerequisite cycle detected involving event "${id}" and "${prereqId}"`);
+      }
+      if (prereqState === UNVISITED) {
+        visit(prereqId);
+      }
+    }
+    state.set(id, DONE);
+  }
+
+  for (const event of events) {
+    if ((state.get(event.id) ?? UNVISITED) === UNVISITED) {
+      visit(event.id);
+    }
+  }
+}
+
+interface Booking {
+  start: number;
+  end: number;
+}
+
+/**
+ * Finds the earliest start time >= earliestStart at which a block of `duration`
+ * minutes fits into `bookings` (sorted ascending by start) while respecting
+ * `gap` minutes of separation from neighboring bookings, and ending by `windowEnd`.
+ */
+function findSlot(
+  bookings: Booking[],
+  earliestStart: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+): number | null {
+  let candidate = earliestStart;
+  for (const booking of bookings) {
+    if (candidate + duration + gap <= booking.start) {
+      break;
+    }
+    candidate = Math.max(candidate, booking.end + gap);
+  }
+  if (candidate + duration > windowEnd) return null;
+  return candidate;
+}
+
+function insertBooking(bookings: Booking[], booking: Booking): void {
+  const idx = bookings.findIndex((b) => b.start > booking.start);
+  if (idx === -1) bookings.push(booking);
+  else bookings.splice(idx, 0, booking);
+}
+
+interface Placement {
+  roomId: string;
+  start: number;
+  end: number;
+}
+
+function placeEvent(
+  event: Event,
+  rooms: Room[],
+  roomBookings: Map<string, Booking[]>,
+  earliestStart: number,
+  windowEnd: number,
+  gap: number,
+): Placement | null {
+  const attendees = event.attendees ?? 1;
+  const candidateRooms = rooms.filter((r) => r.capacity >= attendees);
+  if (candidateRooms.length === 0) return null;
+
+  if (event.preferredRoom) {
+    const preferred = candidateRooms.find((r) => r.id === event.preferredRoom);
+    if (preferred) {
+      const bookings = roomBookings.get(preferred.id)!;
+      const slot = findSlot(bookings, earliestStart, event.duration, gap, windowEnd);
+      if (slot !== null) {
+        const booking = { start: slot, end: slot + event.duration };
+        insertBooking(bookings, booking);
+        return { roomId: preferred.id, start: booking.start, end: booking.end };
+      }
+    }
+  }
+
+  let best: { room: Room; slot: number } | null = null;
+  for (const room of candidateRooms) {
+    if (room.id === event.preferredRoom) continue;
+    const bookings = roomBookings.get(room.id)!;
+    const slot = findSlot(bookings, earliestStart, event.duration, gap, windowEnd);
+    if (slot === null) continue;
+    if (
+      best === null ||
+      slot < best.slot ||
+      (slot === best.slot && room.capacity < best.room.capacity)
+    ) {
+      best = { room, slot };
+    }
+  }
+  if (best === null) return null;
+
+  const bookings = roomBookings.get(best.room.id)!;
+  const booking = { start: best.slot, end: best.slot + event.duration };
+  insertBooking(bookings, booking);
+  return { roomId: best.room.id, start: booking.start, end: booking.end };
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  validateNoCycles(events);
+
+  const gap = options.gap ?? DEFAULT_GAP;
+  const { startTime, endTime } = options;
+
+  const eventMap = new Map(events.map((e) => [e.id, e]));
+  const dependents = new Map<string, string[]>();
+  const remainingPrereqs = new Map<string, Set<string>>();
+  const unsatisfiable = new Set<string>();
+
+  for (const event of events) {
+    const prereqs = event.prerequisites ?? [];
+    const validPrereqs = new Set<string>();
+    for (const prereqId of prereqs) {
+      if (prereqId === event.id) continue; // caught by cycle validation already
+      if (!eventMap.has(prereqId)) {
+        unsatisfiable.add(event.id);
+        continue;
+      }
+      validPrereqs.add(prereqId);
+      if (!dependents.has(prereqId)) dependents.set(prereqId, []);
+      dependents.get(prereqId)!.push(event.id);
+    }
+    remainingPrereqs.set(event.id, validPrereqs);
+  }
+
+  const roomBookings = new Map<string, Booking[]>(rooms.map((r) => [r.id, []]));
+  const scheduledEnd = new Map<string, { end: number }>();
+  const unscheduled = new Set<string>();
+  const assignments: Assignment[] = [];
+  const processed = new Set<string>();
+
+  const ready: string[] = events.filter((e) => remainingPrereqs.get(e.id)!.size === 0).map((e) => e.id);
+
+  const heuristicCompare = (a: string, b: string): number => {
+    const ea = eventMap.get(a)!;
+    const eb = eventMap.get(b)!;
+    if (ea.duration !== eb.duration) return ea.duration - eb.duration;
+    const da = dependents.get(a)?.length ?? 0;
+    const db = dependents.get(b)?.length ?? 0;
+    if (da !== db) return db - da;
+    return a.localeCompare(b);
+  };
+
+  while (ready.length > 0) {
+    ready.sort(heuristicCompare);
+    const id = ready.shift()!;
+    if (processed.has(id)) continue;
+    processed.add(id);
+    const event = eventMap.get(id)!;
+
+    let success = false;
+    if (!unsatisfiable.has(id)) {
+      let earliestStart = startTime;
+      let prereqsResolved = true;
+      for (const prereqId of event.prerequisites ?? []) {
+        if (prereqId === id) continue;
+        const prereqResult = scheduledEnd.get(prereqId);
+        if (!prereqResult) {
+          prereqsResolved = false;
+          break;
+        }
+        earliestStart = Math.max(earliestStart, prereqResult.end + gap);
+      }
+
+      if (prereqsResolved) {
+        const placement = placeEvent(event, rooms, roomBookings, earliestStart, endTime, gap);
+        if (placement) {
+          success = true;
+          scheduledEnd.set(id, { end: placement.end });
+          assignments.push({
+            eventId: id,
+            roomId: placement.roomId,
+            startTime: placement.start,
+            endTime: placement.end,
+          });
+        }
+      }
+    }
+
+    if (!success) {
+      unscheduled.add(id);
+    }
+
+    for (const depId of dependents.get(id) ?? []) {
+      const remaining = remainingPrereqs.get(depId)!;
+      remaining.delete(id);
+      if (remaining.size === 0 && !processed.has(depId)) {
+        ready.push(depId);
+      }
+    }
+  }
+
+  return { assignments, unscheduled: Array.from(unscheduled) };
+}
diff --git a/src/types.ts b/src/types.ts
new file mode 100644
index 0000000..a6acff9
--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,32 @@
+export interface Event {
+  id: string;
+  name: string;
+  duration: number; // in minutes
+  attendees?: number; // number of people attending (default: 1)
+  prerequisites?: string[]; // event IDs that must finish before this starts
+  preferredRoom?: string; // room ID preference (hint, not hard constraint)
+}
+
+export interface Room {
+  id: string;
+  name: string;
+  capacity: number; // max attendees
+}
+
+export interface ScheduleOptions {
+  startTime: number; // minutes from midnight
+  endTime: number; // minutes from midnight
+  gap?: number; // minimum gap in minutes between events in same room (default: 15)
+}
+
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  startTime: number;
+  endTime: number;
+}
+
+export interface ScheduleResult {
+  assignments: Assignment[];
+  unscheduled: string[];
+}
