@@ -0,0 +1,116 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+function getManifestOrThrow(name: string, registry: RegistryService) {
+  const manifest = registry.get(name);
+  if (!manifest) {
+    throw new Error(`Plugin not found in registry: ${name}`);
+  }
+  return manifest;
+}
+
+function detectCyclesImpl(name: string, registry: RegistryService): string[][] | null {
+  const cycles: string[][] = [];
+  const onStack = new Set<string>();
+  const visited = new Set<string>();
+  const stack: string[] = [];
+
+  function dfs(n: string): void {
+    if (onStack.has(n)) {
+      const cycleStart = stack.indexOf(n);
+      cycles.push([...stack.slice(cycleStart), n]);
+      return;
+    }
+    if (visited.has(n)) {
+      return;
+    }
+    onStack.add(n);
+    stack.push(n);
+    const manifest = registry.get(n);
+    if (manifest) {
+      for (const depName of Object.keys(manifest.dependencies)) {
+        dfs(depName);
+      }
+    }
+    stack.pop();
+    onStack.delete(n);
+    visited.add(n);
+  }
+
+  dfs(name);
+  return cycles.length > 0 ? cycles : null;
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      function build(n: string, ancestors: Set<string>): DependencyNode {
+        const manifest = getManifestOrThrow(n, registry);
+        const node: DependencyNode = {
+          name: manifest.name,
+          version: manifest.version,
+          dependencies: [],
+        };
+        for (const depName of Object.keys(manifest.dependencies)) {
+          if (ancestors.has(depName)) {
+            continue;
+          }
+          const nextAncestors = new Set(ancestors);
+          nextAncestors.add(depName);
+          node.dependencies.push(build(depName, nextAncestors));
+        }
+        return node;
+      }
+      return build(name, new Set([name]));
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      return detectCyclesImpl(name, registry);
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const visited = new Set<string>();
+      const order: string[] = [];
+
+      function visit(n: string): void {
+        if (visited.has(n)) {
+          return;
+        }
+        visited.add(n);
+        const manifest = registry.get(n);
+        if (manifest) {
+          for (const depName of Object.keys(manifest.dependencies)) {
+            visit(depName);
+          }
+        }
+        order.push(n);
+      }
+
+      visit(name);
+      return order;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const seen = new Set<string>();
+
+      function visit(n: string): void {
+        const manifest = registry.get(n);
+        if (!manifest) {
+          return;
+        }
+        for (const depName of Object.keys(manifest.dependencies)) {
+          if (!seen.has(depName)) {
+            seen.add(depName);
+            visit(depName);
+          }
+        }
+      }
+
+      visit(name);
+      return Array.from(seen);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return detectCyclesImpl(name, registry) !== null;
+    },
+  };
+}
