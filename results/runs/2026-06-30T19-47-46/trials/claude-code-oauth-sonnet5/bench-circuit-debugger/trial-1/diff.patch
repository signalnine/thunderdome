o pure structure and need simulation-based detection.\n */\nfunction structuralSuspects(gates: Gate[], minZ: string, maxZ: string): Set<string> {\n  const byOutput = new Map<string, Gate>(gates.map((g) => [g.out, g]));\n  const suspects = new Set<string>();\n\n  const isPartialSumSource = (wire: string): boolean => {\n    const g = byOutput.get(wire);\n    return !!g && g.op === 'XOR' && isXY(g.in1) && isXY(g.in2);\n  };\n  const isCarrySource = (wire: string): boolean => {\n    const g = byOutput.get(wire);\n    if (!g) return false;\n    if (g.op === 'OR') return true;\n    if (g.op === 'AND') {\n      return (g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00');\n    }\n    return false;\n  };\n  // A bit's z-XOR and carry-propagate AND both combine a partial-sum wire\n  // with a carry wire. If the inputs don't form such a pair, prefer\n  // blaming whichever non-primary input fails to look like either role;\n  // if neither input can be blamed (e.g. both are primary x/y wires,\n  // which can never be swap targets, or both look individually plausible\n  // but mismatched), the gate's own output is the one out of place.\n  const checkCombinesWithCarry = (out: string, in1: string, in2: string): void => {\n    const validAsIs = (isPartialSumSource(in1) && isCarrySource(in2)) || (isPartialSumSource(in2) && isCarrySource(in1));\n    if (validAsIs) return;\n    let flagged = false;\n    for (const inp of [in1, in2]) {\n      if (!isXY(inp) && !isPartialSumSource(inp) && !isCarrySource(inp)) {\n        suspects.add(inp);\n        flagged = true;\n      }\n    }\n    if (!flagged) suspects.add(out);\n  };\n\n  for (const g of gates) {\n    const { op, in1, in2, out } = g;\n    const isZOut = out.startsWith('z');\n\n    if (op === 'XOR') {\n      if (isZOut) {\n        if (out !== maxZ && out !== minZ) checkCombinesWithCarry(out, in1, in2);\n      } else if (!(isXY(in1) && isXY(in2))) {\n        suspects.add(out);\n      }\n    } else if (op === '