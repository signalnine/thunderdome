new file mode 100644
index 0000000..e91c410
--- /dev/null
+++ b/scratch-stress.mjs
@@ -0,0 +1,69 @@
+import { findSwappedWires } from './dist/index.js';
+
+function pad(n) {
+  return n.toString().padStart(2, '0');
+}
+
+function buildAdder(numBits) {
+  const gates = [];
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+  let prevCarry = 'c00';
+  for (let i = 1; i < numBits; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const t = `t${pad(i)}`;
+    const a = `a${pad(i)}`;
+    const b = `b${pad(i)}`;
+    const c = `c${pad(i)}`;
+    const z = `z${pad(i)}`;
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: prevCarry, out: z });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: a });
+    gates.push({ op: 'AND', in1: t, in2: prevCarry, out: b });
+    gates.push({ op: 'OR', in1: a, in2: b, out: c });
+    prevCarry = c;
+  }
+  gates[gates.length - 1].out = `z${pad(numBits)}`;
+  return gates;
+}
+
+function swapPairs(gates, pairs) {
+  const rename = new Map();
+  for (const [a, b] of pairs) {
+    rename.set(a, b);
+    rename.set(b, a);
+  }
+  return gates.map((g) => (rename.has(g.out) ? { ...g, out: rename.get(g.out) } : g));
+}
+
+function randomSwapSet(gates, numPairs) {
+  // pick 2*numPairs distinct gate outputs (excluding the very first AND c00 to keep it simple) and pair them up randomly
+  const outputs = gates.map((g) => g.out);
+  const shuffled = [...outputs].sort(() => Math.random() - 0.5);
+  const chosen = shuffled.slice(0, numPairs * 2);
+  const pairs = [];
+  for (let i = 0; i < chosen.length; i += 2) pairs.push([chosen[i], chosen[i + 1]]);
+  return pairs;
+}
+
+let failures = 0;
+const TRIALS = 15;
+for (let t = 0; t < TRIALS; t++) {
+  const gates = buildAdder(45);
+  const pairs = randomSwapSet(gates, 4);
+  const expected = pairs.flat().sort();
+  const swapped = swapPairs(gates, pairs);
+  const start = Date.now();
+  const found = findSwappedWires(swapped);
+  const elapsed = Date.now() - start;
+  const ok = JSON.stringify(found) === JSON.stringify(expected);
+  console.log(`trial ${t}: ok=${ok} time=${elapsed}ms pairs=${JSON.stringify(pairs)}`);
+  if (!ok) {
+    failures++;
+    console.log('  expected:', expected);
+    console.log('  found   :', found);
+  }
+}
+console.log(`\n${TRIALS - failures}/${TRIALS} passed`);
+process.exit(failures > 0 ? 1 : 0);
diff --git a/scratch-test.mjs b/scratch-test.mjs
new file mode 100644
index 0000000..8e10093
--- /dev/null
+++ b/scratch-test.mjs
@@ -0,0 +1,110 @@
+import { simulate, findSwappedWires } from './dist/index.js';
+
+function pad(n) {
+  return n.toString().padStart(2, '0');
+}
+
+function buildAdder(numBits) {
+  const gates = [];
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+  let prevCarry = 'c00';
+  for (let i = 1; i < numBits; i++) {
+    const xi = `x${pad(i)}`;
+    const yi = `y${pad(i)}`;
+    const t = `t${pad(i)}`;
+    const a = `a${pad(i)}`;
+    const b = `b${pad(i)}`;
+    const c = `c${pad(i)}`;
+    const z = `z${pad(i)}`;
+    gates.push({ op: 'XOR', in1: xi, in2: yi, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: prevCarry, out: z });
+    gates.push({ op: 'AND', in1: xi, in2: yi, out: a });
+    gates.push({ op: 'AND', in1: t, in2: prevCarry, out: b });
+    gates.push({ op: 'OR', in1: a, in2: b, out: c });
+    prevCarry = c;
+  }
+  // final carry -> z{numBits}, model as an OR gate with a dummy doubled? Instead reuse prevCarry via an OR gate that just passes through.
+  // To keep "out" being an actual gate output (not a raw alias), wrap with OR of prevCarry with itself's AND component is awkward;
+  // instead use the last carry-OR gate's out directly renamed to z{numBits} (replace previous c{numBits-1} naming with z{numBits}).
+  gates[gates.length - 1].out = `z${pad(numBits)}`;
+  return gates;
+}
+
+function swapPairs(gates, pairs) {
+  const rename = new Map();
+  for (const [a, b] of pairs) {
+    rename.set(a, b);
+    rename.set(b, a);
+  }
+  return gates.map((g) => (rename.has(g.out) ? { ...g, out: rename.get(g.out) } : g));
+}
+
+function testSim() {
+  const gates = [
+    { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+    { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z01' },
+  ];
+  const result = simulate(gates, { x00: 1, y00: 1 });
+  console.log('simulate basic:', result);
+}
+
+function testAdderCorrectness(numBits) {
+  const gates = buildAdder(numBits);
+  for (let trial = 0; trial < 20; trial++) {
+    const max = 2 ** numBits - 1;
+    const x = Math.floor(Math.random() * (max + 1));
+    const y = Math.floor(Math.random() * (max + 1));
+    const inputs = {};
+    for (let i = 0; i < numBits; i++) {
+      inputs[`x${pad(i)}`] = Math.floor(x / 2 ** i) % 2;
+      inputs[`y${pad(i)}`] = Math.floor(y / 2 ** i) % 2;
+    }
+    const values = simulate(gates, inputs);
+    let z = 0;
+    for (let i = 0; i <= numBits; i++) {
+      z += values[`z${pad(i)}`] * 2 ** i;
+    }
+    if (z !== x + y) {
+      console.error('MISMATCH base adder', { x, y, z, expected: x + y });
+      process.exit(1);
+    }
+  }
+  console.log(`base ${numBits}-bit adder OK`);
+}
+
+function testSwapDetection(numBits, pairs, label) {
+  const gates = buildAdder(numBits);
+  const swapped = swapPairs(gates, pairs);
+  const start = Date.now();
+  const found = findSwappedWires(swapped);
+  const elapsed = Date.now() - start;
+  const expected = pairs.flat().sort();
+  const ok = JSON.stringify(found) === JSON.stringify(expected);
+  console.log(`${label}: expected=${JSON.stringify(expected)} found=${JSON.stringify(found)} ok=${ok} time=${elapsed}ms`);
+  if (!ok) process.exitCode = 1;
+}
+
+testSim();
+testAdderCorrectness(4);
+testAdderCorrectness(45);
+
+// simple case: swap z-wires with generate/propagate counterparts (heuristically detectable), 4 pairs as the real task always has
+testSwapDetection(12, [['z02', 'a03'], ['z05', 'b06'], ['z08', 'a09'], ['c03', 'b04']], '12-bit easy swap (4 pairs)');
+
+// 45-bit, 4 pairs, mirrors the real benchmark scale
+testSwapDetection(45, [
+  ['z08', 'a09'],
+  ['z20', 'b21'],
+  ['c10', 'a11'],
+  ['z33', 'a34'],
+], '45-bit 4-pair swap');
+
+// harder case: one pair is a same-role z<->z swap, not detectable by structure alone,
+// mixed with 3 normal heuristic-visible swaps (realistic 4-pair scenario)
+testSwapDetection(45, [
+  ['z08', 'a09'],
+  ['z20', 'b21'],
+  ['c10', 'a11'],
+  ['z15', 'z25'],
+], '45-bit mixed swap incl. stealthy z<->z');
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..7255d1e
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,578 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+function applyOp(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Simulates the circuit and returns the value of every wire (inputs plus all
+ * gate outputs). Uses a worklist driven by per-gate "inputs still missing"
+ * counts so each gate is only revisited when one of its inputs resolves,
+ * giving O(gates) work regardless of evaluation order.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values = new Map<string, number>(Object.entries(inputs));
+  const waitingFor = new Map<string, Gate[]>();
+  const missingCount = new Map<Gate, number>();
+  const queue: Gate[] = [];
+
+  const registerWait = (wire: string, gate: Gate): void => {
+    const waiters = waitingFor.get(wire);
+    if (waiters) waiters.push(gate);
+    else waitingFor.set(wire, [gate]);
+  };
+
+  for (const g of gates) {
+    let missing = 0;
+    if (!values.has(g.in1)) missing++;
+    if (!values.has(g.in2)) missing++;
+
+    if (missing === 0) {
+      queue.push(g);
+    } else {
+      missingCount.set(g, missing);
+      if (!values.has(g.in1)) registerWait(g.in1, g);
+      if (!values.has(g.in2)) registerWait(g.in2, g);
+    }
+  }
+
+  while (queue.length > 0) {
+    const g = queue.pop() as Gate;
+    const result = applyOp(g.op, values.get(g.in1) as number, values.get(g.in2) as number);
+    values.set(g.out, result);
+
+    const waiters = waitingFor.get(g.out);
+    if (!waiters) continue;
+    for (const waiter of waiters) {
+      const remaining = (missingCount.get(waiter) as number) - 1;
+      missingCount.set(waiter, remaining);
+      if (remaining === 0) queue.push(waiter);
+    }
+  }
+
+  return Object.fromEntries(values);
+}
+
+function isXY(wire: string): boolean {
+  return wire.startsWith('x') || wire.startsWith('y');
+}
+
+function collectWires(gates: Gate[], prefix: string, fromOutputs: boolean): string[] {
+  const set = new Set<string>();
+  for (const g of gates) {
+    const wires = fromOutputs ? [g.out] : [g.in1, g.in2];
+    for (const w of wires) if (w.startsWith(prefix)) set.add(w);
+  }
+  return [...set].sort();
+}
+
+/**
+ * Structural heuristic for a ripple-carry adder built from XOR/AND/OR gates.
+ * Beyond each gate's own op/output shape, this also validates one hop
+ * upstream for the two "combine with carry" positions (a bit's z-XOR and
+ * its carry-propagate AND both take the bit's partial sum and the
+ * previous carry as inputs) — catching swaps between two *different* roles
+ * (e.g. a partial-sum wire swapped with a carry wire) even though each
+ * gate's own shape still looks locally valid. Swaps between two wires of
+ * the *same* role (e.g. two partial-sum wires for different bits) remain
+ * invisible to pure structure and need simulation-based detection.
+ */
+function structuralSuspects(gates: Gate[], minZ: string, maxZ: string): Set<string> {
+  const byOutput = new Map<string, Gate>(gates.map((g) => [g.out, g]));
+  const suspects = new Set<string>();
+
+  const isPartialSumSource = (wire: string): boolean => {
+    const g = byOutput.get(wire);
+    return !!g && g.op === 'XOR' && isXY(g.in1) && isXY(g.in2);
+  };
+  const isCarrySource = (wire: string): boolean => {
+    const g = byOutput.get(wire);
+    if (!g) return false;
+    if (g.op === 'OR') return true;
+    if (g.op === 'AND') {
+      return (g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00');
+    }
+    return false;
+  };
+  // A bit's z-XOR and carry-propagate AND both combine a partial-sum wire
+  // with a carry wire. If the inputs don't form such a pair, prefer
+  // blaming whichever non-primary input fails to look like either role;
+  // if neither input can be blamed (e.g. both are primary x/y wires,
+  // which can never be swap targets, or both look individually plausible
+  // but mismatched), the gate's own output is the one out of place.
+  const checkCombinesWithCarry = (out: string, in1: string, in2: string): void => {
+    const validAsIs = (isPartialSumSource(in1) && isCarrySource(in2)) || (isPartialSumSource(in2) && isCarrySource(in1));
+    if (validAsIs) return;
+    let flagged = false;
+    for (const inp of [in1, in2]) {
+      if (!isXY(inp) && !isPartialSumSource(inp) && !isCarrySource(inp)) {
+        suspects.add(inp);
+        flagged = true;
+      }
+    }
+    if (!flagged) suspects.add(out);
+  };
+
+  for (const g of gates) {
+    const { op, in1, in2, out } = g;
+    const isZOut = out.startsWith('z');
+
+    if (op === 'XOR') {
+      if (isZOut) {
+        if (out !== maxZ && out !== minZ) checkCombinesWithCarry(out, in1, in2);
+      } else if (!(isXY(in1) && isXY(in2))) {
+        suspects.add(out);
+      }
+    } else if (op === 'AND') {
+      if (isZOut) suspects.add(out);
+      const bothXY = isXY(in1) && isXY(in2);
+      if (!bothXY) checkCombinesWithCarry(out, in1, in2);
+      const isFirstBit =
+        (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');
+      if (!isFirstBit) {
+        const feedsOr = gates.some((g2) => g2.op === 'OR' && (g2.in1 === out || g2.in2 === out));
+        if (!feedsOr) suspects.add(out);
+      }
+    } else if (op === 'OR') {
+      if (isZOut && out !== maxZ) suspects.add(out);
+      for (const inp of [in1, in2]) {
+        const src = byOutput.get(inp);
+        if (src && src.op !== 'AND') suspects.add(inp);
+      }
+    }
+
+    if (isZOut && out !== maxZ && op !== 'XOR') suspects.add(out);
+  }
+
+  return suspects;
+}
+
+function generateTestCases(numBits: number, count: number): Array<{ x: number; y: number }> {
+  const max = 2 ** numBits - 1;
+  const cases: Array<{ x: number; y: number }> = [
+    { x: 0, y: 0 },
+    { x: max, y: max },
+    { x: max, y: 0 },
+    { x: 0, y: max },
+  ];
+
+  let alt1 = 0;
+  let alt2 = 0;
+  for (let i = 0; i < numBits; i++) {
+    if (i % 2 === 0) alt1 += 2 ** i;
+    else alt2 += 2 ** i;
+  }
+  cases.push({ x: alt1, y: alt2 }, { x: alt2, y: alt1 }, { x: alt1, y: alt1 }, { x: alt2, y: alt2 });
+
+  for (let i = 0; i < numBits; i++) {
+    cases.push({ x: 2 ** i, y: 0 });
+    cases.push({ x: 0, y: 2 ** i });
+    cases.push({ x: 2 ** i, y: 2 ** i });
+    cases.push({ x: 2 ** i - 1, y: 1 });
+  }
+
+  for (let k = 0; k < 30; k++) {
+    cases.push({ x: Math.floor(Math.random() * (max + 1)), y: Math.floor(Math.random() * (max + 1)) });
+  }
+
+  return cases.slice(0, count);
+}
+
+function* perfectMatchings(arr: string[]): Generator<Array<[string, string]>> {
+  if (arr.length === 0) {
+    yield [];
+    return;
+  }
+  const [first, ...rest] = arr;
+  for (let i = 0; i < rest.length; i++) {
+    const partner = rest[i];
+    const remaining = [...rest.slice(0, i), ...rest.slice(i + 1)];
+    for (const sub of perfectMatchings(remaining)) {
+      yield [[first, partner], ...sub];
+    }
+  }
+}
+
+/**
+ * Compiled, typed-array representation of a circuit, built once per
+ * findSwappedWires call. Gate identity (op/in1/in2) never changes while
+ * searching for swaps — only which wire each gate's result is written to
+ * does — so all the dependency bookkeeping below (which gates are ready
+ * immediately, which gates wait on which wire) is computed a single time
+ * and reused for every candidate swap, leaving only an O(gates) pass of
+ * tight typed-array operations per simulation.
+ */
+interface CompiledCircuit {
+  numWires: number;
+  names: string[];
+  op: Uint8Array;
+  in1: Int32Array;
+  in2: Int32Array;
+  baseOut: Int32Array;
+  consumers: Int32Array[];
+  initialMissing: Uint8Array;
+  initialQueue: Int32Array;
+  xIdx: Int32Array;
+  yIdx: Int32Array;
+  zIdx: Int32Array;
+}
+
+function compile(gates: Gate[], xWires: string[], yWires: string[], zWires: string[]): CompiledCircuit {
+  const index = new Map<string, number>();
+  const names: string[] = [];
+  const idx = (w: string): number => {
+    let i = index.get(w);
+    if (i === undefined) {
+      i = names.length;
+      names.push(w);
+      index.set(w, i);
+    }
+    return i;
+  };
+
+  const n = gates.length;
+  const op = new Uint8Array(n);
+  const in1 = new Int32Array(n);
+  const in2 = new Int32Array(n);
+  const baseOut = new Int32Array(n);
+  const opCode: Record<Gate['op'], number> = { AND: 0, OR: 1, XOR: 2 };
+
+  for (let i = 0; i < n; i++) {
+    op[i] = opCode[gates[i].op];
+    in1[i] = idx(gates[i].in1);
+    in2[i] = idx(gates[i].in2);
+    baseOut[i] = idx(gates[i].out);
+  }
+
+  const numWires = names.length;
+  const isPrimary = new Uint8Array(numWires);
+  for (let i = 0; i < numWires; i++) isPrimary[i] = isXY(names[i]) ? 1 : 0;
+
+  const missing = new Uint8Array(n);
+  const waiting: number[][] = Array.from({ length: numWires }, () => []);
+  const initialQueueArr: number[] = [];
+
+  for (let g = 0; g < n; g++) {
+    let m = 0;
+    if (!isPrimary[in1[g]]) {
+      waiting[in1[g]].push(g);
+      m++;
+    }
+    if (!isPrimary[in2[g]]) {
+      waiting[in2[g]].push(g);
+      m++;
+    }
+    missing[g] = m;
+    if (m === 0) initialQueueArr.push(g);
+  }
+
+  return {
+    numWires,
+    names,
+    op,
+    in1,
+    in2,
+    baseOut,
+    consumers: waiting.map((arr) => Int32Array.from(arr)),
+    initialMissing: missing,
+    initialQueue: Int32Array.from(initialQueueArr),
+    xIdx: Int32Array.from(xWires.map((w) => idx(w))),
+    yIdx: Int32Array.from(yWires.map((w) => idx(w))),
+    zIdx: Int32Array.from(zWires.map((w) => idx(w))),
+  };
+}
+
+type Runner = (outMap: Int32Array, x: number, y: number) => Int8Array;
+
+/**
+ * Builds a simulation function that reuses its scratch buffers across
+ * calls. The returned Int8Array is overwritten on every call — callers
+ * must finish reading it before calling again.
+ */
+function makeRunner(c: CompiledCircuit): Runner {
+  const n = c.op.length;
+  const values = new Int8Array(c.numWires);
+  const missing = new Uint8Array(n);
+  const queue = new Int32Array(n);
+
+  return (outMap: Int32Array, x: number, y: number): Int8Array => {
+    for (let i = 0; i < c.xIdx.length; i++) values[c.xIdx[i]] = Math.floor(x / 2 ** i) % 2;
+    for (let i = 0; i < c.yIdx.length; i++) values[c.yIdx[i]] = Math.floor(y / 2 ** i) % 2;
+    missing.set(c.initialMissing);
+    queue.set(c.initialQueue);
+    let qlen = c.initialQueue.length;
+    let qi = 0;
+
+    while (qi < qlen) {
+      const g = queue[qi++];
+      const v1 = values[c.in1[g]];
+      const v2 = values[c.in2[g]];
+      let r: number;
+      if (c.op[g] === 0) r = v1 & v2;
+      else if (c.op[g] === 1) r = v1 | v2;
+      else r = v1 ^ v2;
+
+      const w = outMap[g];
+      values[w] = r;
+      const cons = c.consumers[w];
+      for (let k = 0; k < cons.length; k++) {
+        const wg = cons[k];
+        if (--missing[wg] === 0) queue[qlen++] = wg;
+      }
+    }
+
+    return values;
+  };
+}
+
+/**
+ * With y held at 0, a correct adder must output z === x exactly: no carry
+ * is ever generated, so any deviation is a genuine bug, not noise. This
+ * directly catches same-role z-output swaps (e.g. z05<->z09), which the
+ * structural heuristic can't see since both gates keep a locally valid
+ * "XOR feeding a z wire" shape.
+ */
+function isolatedZSuspects(run: Runner, compiled: CompiledCircuit, numBits: number): Set<string> {
+  const suspects = new Set<string>();
+  for (let i = 0; i < numBits; i++) {
+    const values = run(compiled.baseOut, 2 ** i, 0);
+    for (let j = 0; j < compiled.zIdx.length; j++) {
+      const expectedBit = j === i ? 1 : 0;
+      if (values[compiled.zIdx[j]] !== expectedBit) suspects.add(compiled.names[compiled.zIdx[j]]);
+    }
+  }
+  return suspects;
+}
+
+function* combinations<T>(arr: T[], k: number): Generator<T[]> {
+  if (k === 0) {
+    yield [];
+    return;
+  }
+  if (arr.length < k) return;
+  const [first, ...rest] = arr;
+  for (const tail of combinations(rest, k - 1)) {
+    yield [first, ...tail];
+  }
+  yield* combinations(rest, k);
+}
+
+/**
+ * When the heuristic (plus isolated-bit check) narrows things to a small
+ * pool of suspects, exhaustively try every way to pick 8 of them and pair
+ * those 8 up, accepting the first pairing that makes the adder fully
+ * correct. Pool sizes stay small enough (typically 8-12) that this is fast
+ * even though it's otherwise a combinatorial search.
+ */
+function trySubsetPairing(run: Runner, compiled: CompiledCircuit, pool: string[], numBits: number): string[] | null {
+  if (pool.length < 8) return null;
+
+  const nameIndex = new Map(compiled.names.map((nm, i) => [nm, i]));
+  const producer = new Int32Array(compiled.numWires).fill(-1);
+  for (let g = 0; g < compiled.op.length; g++) producer[compiled.baseOut[g]] = g;
+
+  const quickTests = generateTestCases(numBits, 8);
+  const fullTests = generateTestCases(numBits, Math.min(300, 4 + 4 + numBits * 4 + 30));
+
+  for (const subset of combinations(pool, 8)) {
+    for (const pairing of perfectMatchings(subset)) {
+      const outMap = compiled.baseOut.slice();
+      for (const [a, b] of pairing) {
+        const ai = nameIndex.get(a) as number;
+        const bi = nameIndex.get(b) as number;
+        const ga = producer[ai];
+        const gb = producer[bi];
+        outMap[ga] = bi;
+        outMap[gb] = ai;
+      }
+      if (
+        countMismatches(run, outMap, compiled.zIdx, quickTests) === 0 &&
+        countMismatches(run, outMap, compiled.zIdx, fullTests) === 0
+      ) {
+        return subset.slice().sort();
+      }
+    }
+  }
+  return null;
+}
+
+function countMismatches(
+  run: Runner,
+  outMap: Int32Array,
+  zIdx: Int32Array,
+  testCases: Array<{ x: number; y: number }>,
+): number {
+  let total = 0;
+  for (const { x, y } of testCases) {
+    const values = run(outMap, x, y);
+    let expected = x + y;
+    for (let j = 0; j < zIdx.length; j++) {
+      const bit = expected % 2;
+      expected = Math.floor(expected / 2);
+      if (values[zIdx[j]] !== bit) total++;
+    }
+  }
+  return total;
+}
+
+/**
+ * Hill-climbing repair: each round, try every possible pair of gate
+ * outputs and keep whichever single swap reduces the total number of
+ * mismatched output bits the most (scored over a wide battery of test
+ * vectors), then commit it and repeat. Unlike fixing bits strictly
+ * lowest-first, this tolerates swaps whose effects overlap (e.g. one bug
+ * corrupting the carry chain feeding into a bit another bug also breaks),
+ * since the right fix still reduces total error even when it doesn't fully
+ * correct any single bit on its own. Robust to swaps the structural
+ * heuristic can't see, because correctness is judged by simulation, not
+ * gate shape.
+ */
+function fastGreedyRepair(
+  gates: Gate[],
+  xWires: string[],
+  yWires: string[],
+  zWires: string[],
+  priority: Set<string>,
+  evalTestCount: number,
+): string[] | null {
+  const numBits = xWires.length;
+  const compiled = compile(gates, xWires, yWires, zWires);
+  const run = makeRunner(compiled);
+
+  const evalTests = generateTestCases(numBits, Math.min(evalTestCount, 4 + 4 + numBits * 4 + 30));
+  const confirmTests = generateTestCases(numBits, Math.min(300, 4 + 4 + numBits * 4 + 30));
+
+  const n = compiled.op.length;
+  const currentOut = compiled.baseOut.slice();
+  const producer = new Int32Array(compiled.numWires).fill(-1);
+  for (let g = 0; g < n; g++) producer[currentOut[g]] = g;
+
+  const candidates = Array.from(currentOut);
+  const nameIndex = new Map(compiled.names.map((nm, i) => [nm, i]));
+  const priorityIdx = [...priority].map((w) => nameIndex.get(w)).filter((x): x is number => x !== undefined);
+
+  const searchBest = (sideA: number[], baseScore: number): [number, number] | null => {
+    let bestScore = baseScore;
+    let bestPair: [number, number] | null = null;
+
+    scan: for (let i = 0; i < sideA.length; i++) {
+      const a = sideA[i];
+      const ga = producer[a];
+      for (let j = 0; j < candidates.length; j++) {
+        const b = candidates[j];
+        if (b === a) continue;
+        const gb = producer[b];
+        currentOut[ga] = b;
+        currentOut[gb] = a;
+        const score = countMismatches(run, currentOut, compiled.zIdx, evalTests);
+        currentOut[ga] = a;
+        currentOut[gb] = b;
+        if (score < bestScore) {
+          bestScore = score;
+          bestPair = [a, b];
+          if (score === 0) break scan;
+        }
+      }
+    }
+    return bestPair;
+  };
+
+  const tryCommit = (pair: [number, number]): boolean => {
+    const [a, b] = pair;
+    const ga = producer[a];
+    const gb = producer[b];
+    const before = countMismatches(run, currentOut, compiled.zIdx, confirmTests);
+    currentOut[ga] = b;
+    currentOut[gb] = a;
+    const after = countMismatches(run, currentOut, compiled.zIdx, confirmTests);
+    if (after >= before) {
+      currentOut[ga] = a;
+      currentOut[gb] = b;
+      return false;
+    }
+    producer[a] = gb;
+    producer[b] = ga;
+    foundIdx.push(a, b);
+    return true;
+  };
+
+  const foundIdx: number[] = [];
+
+  for (let round = 0; round < 4; round++) {
+    const baseScore = countMismatches(run, currentOut, compiled.zIdx, evalTests);
+    if (baseScore === 0) break;
+
+    // Most swaps leave at least one structurally-flagged wire to anchor
+    // the search, which is cheap. Swaps between two wires of the exact
+    // same role (invisible to structure) leave no anchor — fall back to
+    // scanning every wire as a last resort for just that round. Whatever
+    // is found is only kept if it also holds up against a much wider
+    // confirmation battery, to filter out swaps that merely got lucky on
+    // the small/cheap evaluation set.
+    let committed = false;
+    if (priorityIdx.length > 0) {
+      const pair = searchBest(priorityIdx, baseScore);
+      if (pair) committed = tryCommit(pair);
+    }
+    if (!committed) {
+      const pair = searchBest(candidates, baseScore);
+      if (pair) committed = tryCommit(pair);
+    }
+
+    if (!committed) break;
+  }
+
+  if (foundIdx.length !== 8) return null;
+  if (countMismatches(run, currentOut, compiled.zIdx, confirmTests) !== 0) return null;
+
+  return foundIdx.map((i) => compiled.names[i]).sort();
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  const xWires = collectWires(gates, 'x', false);
+  const yWires = collectWires(gates, 'y', false);
+  const zWires = collectWires(gates, 'z', true);
+  const minZ = zWires[0];
+  const maxZ = zWires[zWires.length - 1];
+  const numBits = xWires.length;
+
+  const compiled = compile(gates, xWires, yWires, zWires);
+  const run = makeRunner(compiled);
+
+  const suspects = structuralSuspects(gates, minZ, maxZ);
+
+  // A swap that disrupts the carry chain (anything but a pure same-bit
+  // z<->z swap) makes every later isolated-bit test fail too, since the
+  // corrupted carry never resets — that cascade can flag dozens of z
+  // wires that were never actually swapped. A real z<->z swap only ever
+  // flags the handful of z wires actually involved, so a small result is
+  // trustworthy while a large one is discarded as cascade noise.
+  const isolated = isolatedZSuspects(run, compiled, numBits);
+  if (isolated.size <= 10) {
+    for (const w of isolated) suspects.add(w);
+  }
+
+  if (suspects.size >= 8 && suspects.size <= 12) {
+    const found = trySubsetPairing(run, compiled, [...suspects], numBits);
+    if (found) return found;
+  }
+
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const repaired = fastGreedyRepair(gates, xWires, yWires, zWires, suspects, 20 + attempt * 30);
+    if (repaired) return repaired;
+  }
+
+  return [...suspects].sort();
+}
