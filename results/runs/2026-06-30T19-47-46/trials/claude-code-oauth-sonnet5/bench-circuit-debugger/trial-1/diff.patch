al search.\n */\nfunction trySubsetPairing(run: Runner, compiled: CompiledCircuit, pool: string[], numBits: number): string[] | null {\n  if (pool.length < 8) return null;\n\n  const nameIndex = new Map(compiled.names.map((nm, i) => [nm, i]));\n  const producer = new Int32Array(compiled.numWires).fill(-1);\n  for (let g = 0; g < compiled.op.length; g++) producer[compiled.baseOut[g]] = g;\n\n  const quickTests = generateTestCases(numBits, 8);\n  const fullTests = generateTestCases(numBits, Math.min(300, 4 + 4 + numBits * 4 + 30));\n\n  for (const subset of combinations(pool, 8)) {\n    for (const pairing of perfectMatchings(subset)) {\n      const outMap = compiled.baseOut.slice();\n      for (const [a, b] of pairing) {\n        const ai = nameIndex.get(a) as number;\n        const bi = nameIndex.get(b) as number;\n        const ga = producer[ai];\n        const gb = producer[bi];\n        outMap[ga] = bi;\n        outMap[gb] = ai;\n      }\n      if (\n        countMismatches(run, outMap, compiled.zIdx, quickTests) === 0 &&\n        countMismatches(run, outMap, compiled.zIdx, fullTests) === 0\n      ) {\n        return subset.slice().sort();\n      }\n    }\n  }\n  return null;\n}\n\nfunction countMismatches(","originalFile":"export interface Gate {\n  op: 'AND' | 'OR' | 'XOR';\n  in1: string;\n  in2: string;\n  out: string;\n}\n\nfunction applyOp(op: Gate['op'], a: number, b: number): number {\n  switch (op) {\n    case 'AND':\n      return a & b;\n    case 'OR':\n      return a | b;\n    case 'XOR':\n      return a ^ b;\n  }\n}\n\n/**\n * Simulates the circuit and returns the value of every wire (inputs plus all\n * gate outputs). Uses a worklist driven by per-gate \"inputs still missing\"\n * counts so each gate is only revisited when one of its inputs resolves,\n * giving O(gates) work regardless of evaluation order.\n */\nexport function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {\n  const values = new Map<string, number>(Object.entries(inputs));\n  const waitingFor = new Map<string, Gate[]>();\n  const missingCount = new Map<Gate, number>();\n  const queue: Gate[] = [];\n\n  const registerWait = (wire: string, gate: Gate): void => {\n    const waiters = waitingFor.get(wire);\n    if (waiters) waiters.push(gate);\n    else waitingFor.set(wire, [gate]);\n  };\n\n  for (const g of gates) {\n    let missing = 0;\n    if (!values.has(g.in1)) missing++;\n    if (!values.has(g.in2)) missing++;\n\n    if (missing === 0) {\n      queue.push(g);\n    } else {\n      missingCount.set(g, missing);\n      if (!values.has(g.in1)) registerWait(g.in1, g);\n      if (!values.has(g.in2)) registerWait(g.in2, g);\n    }\n  }\n\n  while (queue.length > 0) {\n    const g = queue.pop() as Gate;\n    const result = applyOp(g.op, values.get(g.in1) as number, values.get(g.in2) as number);\n    values.set(g.out, result);\n\n    const waiters = waitingFor.get(g.out);\n    if (!waiters) continue;\n    for (const waiter of waiters) {\n      const remaining = (missingCount.get(waiter) as number) - 1;\n      missingCount.set(waiter, remaining);\n      if (remaining === 0) queue.push(waiter);\n    }\n  }\n\n  return Object.fromEntries(values);\n}\n\nfunction isXY(wire: string): boolean {\n  return wire.startsWith('x') || wire.startsWith('y');\n}\n\nfunction collectWires(gates: Gate[], prefix: string, fromOutputs: boolean): string[] {\n  const set = new Set<string>();\n  for (const g of gates) {\n    const wires = fromOutputs ? [g.out] : [g.in1, g.in2];\n    for (const w of wires) if (w.startsWith(prefix)) set.add(w);\n  }\n  return [...set].sort();\n}\n\n/**\n * Structural heuristic for a ripple-carry adder built from XOR/AND/OR gates.\n * Beyond each gate's own op/output shape, this also validates one hop\n * upstream for the two \"combine with carry\" positions (a bit's z-XOR and\n * its carry-propagate AND both take the bit's partial sum and the\n * previous carry as inputs) — catching swaps between two *different* roles\n * (e.g. a partial-sum wire swapped with a carry wire) even though each\n * gate's own shape still looks locally valid. Swaps between two wires of\n * the *same* role (e.g. two partial-sum wires for different bits) remain\n * invisible to pure structure and need simulation-based detection.\n */\nfunction structuralSuspects(gates: Gate[], minZ: string, maxZ: string): Set<string> {\n  const byOutput = new Map<string, Gate>(gates.map((g) => [g.out, g]));\n  const suspects = new Set<string>();\n\n  const isPartialSumSource = (wire: string): boolean => {\n    const g = byOutput.get(wire);\n    return !!g && g.op === 'XOR' && isXY(g.in1) && isXY(g.in2);\n  };\n  const isCarrySource = (wire: string): boolean => {\n    const g = byOutput.get(wire);\n    if (!g) return false;\n    if (g.op === 'OR') return true;\n    if (g.op === 'AND') {\n      return (g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00');\n    }\n    return false;\n  };\n  const checkCombinesWithCarry = (in1: string, in2: string): void => {\n    const validAsIs = (isPartialSumSource(in1) && isCarrySource(in2)) || (isPartialSumSource(in2) && isCarrySource(in1));\n    if (validAsIs) return;\n    for (const inp of [in1, in2]) {\n      if (!isPartialSumSource(inp) && !isCarrySource(inp)) suspects.add(inp);\n    }\n    if ((isPartialSumSource(in1) || isCarrySource(in1)) && (isPartialSumSource(in2) || isCarrySource(in2))) {\n      suspects.add(in1);\n      suspects.add(in2);\n    }\n  };\n\n  for (const g of gates) {\n    const { op, in1, in2, out } = g;\n    const isZOut = out.startsWith('z');\n\n    if (op === 'XOR') {\n      if (isZOut) {\n        if (out !== maxZ && out !== minZ) checkCombinesWithCarry(in1, in2);\n      } else if (!(isXY(in1) && isXY(in2))) {\n        suspects.add(out);\n      }\n    } else if (op === 'AND') {\n      if (isZOut) suspects.add(out);\n      const bothXY = isXY(in1) && isXY(in2);\n      if (!bothXY) checkCombinesWithCarry(in1, in2);\n      const isFirstBit =\n        (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');\n      if (!isFirstBit) {\n        const feedsOr = gates.some((g2) => g2.op === 'OR' && (g2.in1 === out || g2.in2 === out));\n        if (!feedsOr) suspects.add(out);\n      }\n    } else if (op === 'OR') {\n      if (isZOut && out !== maxZ) suspects.add(out);\n      for (const inp of [in1, in2]) {\n        const src = byOutput.get(inp);\n        if (src && src.op !== 'AND') suspects.add(inp);\n      }\n    }\n\n    if (isZOut && out !== maxZ && op !== 'XOR') suspects.add(out);\n  }\n\n  return suspects;\n}\n\nfunction bitsToNumber(values: Record<string, number>, wires: string[]): number {\n  let result = 0;\n  for (let i = 0; i < wires.length; i++) {\n    result += values[wires[i]] * 2 ** i;\n  }\n  return result;\n}\n\nfunction numberToInputs(wires: string[], n: number): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < wires.length; i++) {\n    inputs[wires[i]] = Math.floor(n / 2 ** i) % 2;\n  }\n  return inputs;\n}\n\nfunction generateTestCases(numBits: number, count: number): Array<{ x: number; y: number }> {\n  const max = 2 ** numBits - 1;\n  const cases: Array<{ x: number; y: number }> = [\n    { x: 0, y: 0 },\n    { x: max, y: max },\n    { x: max, y: 0 },\n    { x: 0, y: max },\n  ];\n\n  let alt1 = 0;\n  let alt2 = 0;\n  for (let i = 0; i < numBits; i++) {\n    if (i % 2 === 0) alt1 += 2 ** i;\n    else alt2 += 2 ** i;\n  }\n  cases.push({ x: alt1, y: alt2 }, { x: alt2, y: alt1 }, { x: alt1, y: alt1 }, { x: alt2, y: alt2 });\n\n  for (let i = 0; i < numBits; i++) {\n    cases.push({ x: 2 ** i, y: 0 });\n    cases.push({ x: 0, y: 2 ** i });\n    cases.push({ x: 2 ** i, y: 2 ** i });\n    cases.push({ x: 2 ** i - 1, y: 1 });\n  }\n\n  for (let k = 0; k < 30; k++) {\n    cases.push({ x: Math.floor(Math.random() * (max + 1)), y: Math.floor(Math.random() * (max + 1)) });\n  }\n\n  return cases.slice(0, count);\n}\n\nfunction applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {\n  const rename = new Map<string, string>();\n  for (const [a, b] of pairs) {\n    rename.set(a, b);\n    rename.set(b, a);\n  }\n  return gates.map((g) => (rename.has(g.out) ? { ...g, out: rename.get(g.out) as string } : g));\n}\n\nfunction adderIsCorrect(\n  gates: Gate[],\n  xWires: string[],\n  yWires: string[],\n  zWires: string[],\n  testCases: Array<{ x: number; y: number }>,\n): boolean {\n  for (const { x, y } of testCases) {\n    const inputs = { ...numberToInputs(xWires, x), ...numberToInputs(yWires, y) };\n    const values = simulate(gates, inputs);\n    if (bitsToNumber(values, zWires) !== x + y) return false;\n  }\n  return true;\n}\n\nfunction* perfectMatchings(arr: string[]): Generator<Array<[string, string]>> {\n  if (arr.length === 0) {\n    yield [];\n    return;\n  }\n  const [first, ...rest] = arr;\n  for (let i = 0; i < rest.length; i++) {\n    const partner = rest[i];\n    const remaining = [...rest.slice(0, i), ...rest.slice(i + 1)];\n    for (const sub of perfectMatchings(remaining)) {\n      yield [[first, partner], ...sub];\n    }\n  }\n}\n\n/**\n * Compiled, typed-array representation of a circuit, built once per\n * findSwappedWires call. Gate identity (op/in1/in2) never changes while\n * searching for swaps — only which wire each gate's result is written to\n * does — so all the dependency bookkeeping below (which gates are ready\n * immediately, which gates wait on which wire) is computed a single time\n * and reused for every candidate swap, leaving only an O(gates) pass of\n * tight typed-array operations per simulation.\n */\ninterface CompiledCircuit {\n  numWires: number;\n  names: string[];\n  op: Uint8Array;\n  in1: Int32Array;\n  in2: Int32Array;\n  baseOut: Int32Array;\n  consumers: Int32Array[];\n  initialMissing: Uint8Array;\n  initialQueue: Int32Array;\n  xIdx: Int32Array;\n  yIdx: Int32Array;\n  zIdx: Int32Array;\n}\n\nfunction compile(gates: Gate[], xWires: string[], yWires: string[], zWires: string[]): CompiledCircuit {\n  const index = new Map<string, number>();\n  const names: string[] = [];\n  const idx = (w: string): number => {\n    let i = index.get(w);\n    if (i === undefined) {\n      i = names.length;\n      names.push(w);\n      index.set(w, i);\n    }\n    return i;\n  };\n\n  const n = gates.length;\n  const op = new Uint8Array(n);\n  const in1 = new Int32Array(n);\n  const in2 = new Int32Array(n);\n  const baseOut = new Int32Array(n);\n  const opCode: Record<Gate['op'], number> = { AND: 0, OR: 1, XOR: 2 };\n\n  for (let i = 0; i < n; i++) {\n    op[i] = opCode[gates[i].op];\n    in1[i] = idx(gates[i].in1);\n    in2[i] = idx(gates[i].in2);\n    baseOut[i] = idx(gates[i].out);\n  }\n\n  const numWires = names.length;\n  const isPrimary = new Uint8Array(numWires);\n  for (let i = 0; i < numWires; i++) isPrimary[i] = isXY(names[i]) ? 1 : 0;\n\n  const missing = new Uint8Array(n);\n  const waiting: number[][] = Array.from({ length: numWires }, () => []);\n  const initialQueueArr: number[] = [];\n\n  for (let g = 0; g < n; g++) {\n    let m = 0;\n    if (!isPrimary[in1[g]]) {\n      waiting[in1[g]].push(g);\n      m++;\n    }\n    if (!isPrimary[in2[g]]) {\n      waiting[in2[g]].push(g);\n      m++;\n    }\n    missing[g] = m;\n    if (m === 0) initialQueueArr.push(g);\n  }\n\n  return {\n    numWires,\n    names,\n    op,\n    in1,\n    in2,\n    baseOut,\n    consumers: waiting.map((arr) => Int32Array.from(arr)),\n    initialMissing: missing,\n    initialQueue: Int32Array.from(initialQueueArr),\n    xIdx: Int32Array.from(xWires.map((w) => idx(w))),\n    yIdx: Int32Array.from(yWires.map((w) => idx(w))),\n    zIdx: Int32Array.from(zWires.map((w) => idx(w))),\n  };\n}\n\ntype Runner = (outMap: Int32Array, x: number, y: number) => Int8Array;\n\n/**\n * Builds a simulation function that reuses its scratch buffers across\n * calls. The returned Int8Array is overwritten on every call — callers\n * must finish reading it before calling again.\n */\nfunction makeRunner(c: CompiledCircuit): Runner {\n  const n = c.op.length;\n  const values = new Int8Array(c.numWires);\n  const missing = new Uint8Array(n);\n  const queue = new Int32Array(n);\n\n  return (outMap: Int32Array, x: number, y: number): Int8Array => {\n    for (let i = 0; i < c.xIdx.length; i++) values[c.xIdx[i]] = Math.floor(x / 2 ** i) % 2;\n    for (let i = 0; i < c.yIdx.length; i++) values[c.yIdx[i]] = Math.floor(y / 2 ** i) % 2;\n    missing.set(c.initialMissing);\n    queue.set(c.initialQueue);\n    let qlen = c.initialQueue.length;\n    let qi = 0;\n\n    while (qi < qlen) {\n      const g = queue[qi++];\n      const v1 = values[c.in1[g]];\n      const v2 = values[c.in2[g]];\n      let r: number;\n      if (c.op[g] === 0) r = v1 & v2;\n      else if (c.op[g] === 1) r = v1 | v2;\n      else r = v1 ^ v2;\n\n      const w = outMap[g];\n      values[w] = r;\n      const cons = c.consumers[w];\n      for (let k = 0; k < cons.length; k++) {\n        const wg = cons[k];\n        if (--missing[wg] === 0) queue[qlen++] = wg;\n      }\n    }\n\n    return values;\n  };\n}\n\nfunction countMismatches(\n  run: Runner,\n  outMap: Int32Array,\n  zIdx: Int32Array,\n  testCases: Array<{ x: number; y: number }>,\n): number {\n  let total = 0;\n  for (const { x, y } of testCases) {\n    const values = run(outMap, x, y);\n    let expected = x + y;\n    for (let j = 0; j < zIdx.length; j++) {\n      const bit = expected % 2;\n      expected = Math.floor(expected / 2);\n      if (values[zIdx[j]] !== bit) total++;\n    }\n  }\n  return total;\n}\n\n/**\n * Hill-climbing repair: each round, try every possible pair of gate\n * outputs and keep whichever single swap reduces the total number of\n * mismatched output bits the most (scored over a wide battery of test\n * vectors), then commit it and repeat. Unlike fixing bits strictly\n * lowest-first, this tolerates swaps whose effects overlap (e.g. one bug\n * corrupting the carry chain