unts so each gate is only revisited when one of its inputs resolves,\n * giving O(gates) work regardless of evaluation order.\n */\nexport function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {\n  const values = new Map<string, number>(Object.entries(inputs));\n  const waitingFor = new Map<string, Gate[]>();\n  const missingCount = new Map<Gate, number>();\n  const queue: Gate[] = [];\n\n  const registerWait = (wire: string, gate: Gate): void => {\n    const waiters = waitingFor.get(wire);\n    if (waiters) waiters.push(gate);\n    else waitingFor.set(wire, [gate]);\n  };\n\n  for (const g of gates) {\n    let missing = 0;\n    if (!values.has(g.in1)) missing++;\n    if (!values.has(g.in2)) missing++;\n\n    if (missing === 0) {\n      queue.push(g);\n    } else {\n      missingCount.set(g, missing);\n      if (!values.has(g.in1)) registerWait(g.in1, g);\n      if (!values.has(g.in2)) registerWait(g.in2, g);\n    }\n  }\n\n  while (queue.length > 0) {\n    const g = queue.pop() as Gate;\n    const result = applyOp(g.op, values.get(g.in1) as number, values.get(g.in2) as number);\n    values.set(g.out, result);\n\n    const waiters = waitingFor.get(g.out);\n    if (!waiters) continue;\n    for (const waiter of waiters) {\n      const remaining = (missingCount.get(waiter) as number) - 1;\n      missingCount.set(waiter, remaining);\n      if (remaining === 0) queue.push(waiter);\n    }\n  }\n\n  return Object.fromEntries(values);\n}\n\nfunction isXY(wire: string): boolean {\n  return wire.startsWith('x') || wire.startsWith('y');\n}\n\nfunction collectWires(gates: Gate[], prefix: string, fromOutputs: boolean): string[] {\n  const set = new Set<string>();\n  for (const g of gates) {\n    const wires = fromOutputs ? [g.out] : [g.in1, g.in2];\n    for (const w of wires) if (w.startsWith(prefix)) set.add(w);\n  }\n  return [...set].sort();\n}\n\n/**\n * Structural heuristic for a ripple-carry adder built from XOR/AND/OR gates:\n *  - every z bit (except the final carry-out bit) must be produced by XOR\n *  - a non-z XOR must consume x/y directly (it's the \"partial sum\" gate)\n *  - an AND must feed an OR (carry generation), except the very first\n *    half-adder's AND (x00 AND y00), which feeds the next bit directly\n *  - an OR must never drive a z bit (other than the final carry-out)\n *  - an OR's inputs must themselves come from AND gates\n * Any wire violating its expected role is a suspect.\n */\nfunction structuralSuspects(gates: Gate[], maxZ: string): Set<string> {\n  const byOutput = new Map<string, Gate>(gates.map((g) => [g.out, g]));\n  const suspects = new Set<string>();\n\n  for (const g of gates) {\n    const { op, in1, in2, out } = g;\n    const isZOut = out.startsWith('z');\n\n    if (op === 'XOR') {\n      if (isZOut) {\n        if (out !== maxZ) {\n          // correct: final sum bit\n        }\n      } else if (!(isXY(in1) && isXY(in2))) {\n        suspects.add(out);\n      }\n    } else if (op === 'AND') {\n      if (isZOut) suspects.add(out);\n      const isFirstBit =\n        (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');\n      if (!isFirstBit) {\n        const feedsOr = gates.some((g2) => g2.op === 'OR' && (g2.in1 === out || g2.in2 === out));\n        if (!feedsOr) suspects.add(out);\n      }\n    } else if (op === 'OR') {\n      if (isZOut && out !== maxZ) suspects.add(out);\n      for (const inp of [in1, in2]) {\n        const src = byOutput.get(inp);\n        if (src && src.op !== 'AND') suspects.add(inp);\n      }\n    }\n\n    if (isZOut && out !== maxZ && op !== 'XOR') suspects.add(out);\n  }\n\n  return suspects;\n}\n\nfunction bitsToNumber(values: Record<string, number>, wires: string[]): number {\n  let result = 0;\n  for (let i = 0; i < wires.length; i++) {\n    result += values[wires[i]] * 2 ** i;\n  }\n  return result;\n}\n\nfunction numberToInputs(wires: string[], n: number): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < wires.length; i++) {\n    inputs[wires[i]] = Math.floor(n / 2 ** i) % 2;\n  }\n  return inputs;\n}\n\nfunction generateTestCases(numBits: number, count: number): Array<{ x: number; y: number }> {\n  const max = 2 ** numBits - 1;\n  const cases: Array<{ x: number; y: number }> = [\n    { x: 0, y: 0 },\n    { x: max, y: max },\n    { x: max, y: 0 },\n    { x: 0, y: max },\n  ];\n\n  let alt1 = 0;\n  let alt2 = 0;\n  for (let i = 0; i < numBits; i++) {\n    if (i % 2 === 0) alt1 += 2 ** i;\n    else alt2 += 2 ** i;\n  }\n  cases.push({ x: alt1, y: alt2 }, { x: alt2, y: alt1 }, { x: alt1, y: alt1 }, { x: alt2, y: alt2 });\n\n  for (let i = 0; i < numBits; i++) {\n    cases.push({ x: 2 ** i, y: 0 });\n    cases.push({ x: 0, y: 2 ** i });\n    cases.push({ x: 2 ** i, y: 2 ** i });\n    cases.push({ x: 2 ** i - 1, y: 1 });\n  }\n\n  for (let k = 0; k < 30; k++) {\n    cases.push({ x: Math.floor(Math.random() * (max + 1)), y: Math.floor(Math.random() * (max + 1)) });\n  }\n\n  return cases.slice(0, count);\n}\n\nfunction applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {\n  const rename = new Map<string, string>();\n  for (const [a, b] of pairs) {\n    rename.set(a, b);\n    rename.set(b, a);\n  }\n  return gates.map((g) => (rename.has(g.out) ? { ...g, out: rename.get(g.out) as string } : g));\n}\n\nfunction adderIsCorrect(\n  gates: Gate[],\n  xWires: string[],\n  yWires: string[],\n  zWires: string[],\n  testCases: Array<{ x: number; y: number }>,\n): boolean {\n  for (const { x, y } of testCases) {\n    const inputs = { ...numberToInputs(xWires, x), ...numberToInputs(yWires, y) };\n    const values = simulate(gates, inputs);\n    if (bitsToNumber(values, zWires) !== x + y) return false;\n  }\n  return true;\n}\n\nfunction* perfectMatchings(arr: string[]): Generator<Array<[string, string]>> {\n  if (arr.length === 0) {\n    yield [];\n    return;\n  }\n  const [first, ...rest] = arr;\n  for (let i = 0; i < rest.length; i++) {\n    const partner = rest[i];\n    const remaining = [...rest.slice(0, i), ...rest.slice(i + 1)];\n    for (const sub of perfectMatchings(remaining)) {\n      yield [[first, partner], ...sub];\n    }\n  }\n}\n\nfunction bitMatches(values: Record<string, number>, zWires: string[], bit: number, expected: number): boolean {\n  for (let j = 0; j <= bit; j++) {\n    const expectedBit = Math.floor(expected / 2 ** j) % 2;\n    if (values[zWires[j]] !== expectedBit) return false;\n  }\n  return true;\n}\n\n/**\n * Test vectors used to confirm a candidate fix for `bit`. Includes enough\n * random coverage that an unrelated (coincidental) swap is astronomically\n * unlikely to satisfy the acceptance check by chance, even when `bit` is\n * low and the check window is narrow.\n */\nfunction bitTestCases(numBits: number, bit: number): Array<{ x: number; y: number }> {\n  const max = 2 ** numBits - 1;\n  const cases: Array<{ x: number; y: number }> = [\n    { x: 2 ** bit, y: 0 },\n    { x: 0, y: 2 ** bit },\n    { x: 2 ** bit, y: 2 ** bit },\n    { x: 2 ** (bit + 1) - 1, y: 1 },\n    { x: 1, y: 2 ** (bit + 1) - 1 },\n    { x: 0, y: 0 },\n    { x: max, y: max },\n  ];\n  for (let k = 0; k < 40; k++) {\n    cases.push({ x: Math.floor(Math.random() * (max + 1)), y: Math.floor(Math.random() * (max + 1)) });\n  }\n  return cases;\n}\n\n/**\n * Finds the lowest output bit that's wrong under a broad sweep of test\n * vectors. Returns -1 if no mismatch is found (circuit already correct).\n */\nfunction findLowestBrokenBit(\n  gates: Gate[],\n  xWires: string[],\n  yWires: string[],\n  zWires: string[],\n  testCases: Array<{ x: number; y: number }>,\n): number {\n  let lowest = -1;\n  for (const { x, y } of testCases) {\n    const inputs = { ...numberToInputs(xWires, x), ...numberToInputs(yWires, y) };\n    const values = simulate(gates, inputs);\n    const expected = x + y;\n    for (let j = 0; j < zWires.length; j++) {\n      const expectedBit = Math.floor(expected / 2 ** j) % 2;\n      if (values[zWires[j]] !== expectedBit) {\n        if (lowest === -1 || j < lowest) lowest = j;\n        break;\n      }\n    }\n  }\n  return lowest;\n}\n\n/**\n * Greedy bit-by-bit repair: locate the lowest broken output bit, search for\n * a single swap (one wire structurally near that bit, paired with any wire\n * in the circuit) that fixes it without regressing lower bits, apply it,\n * and repeat. Robust against swaps the structural heuristic can't see\n * (e.g. two same-role z-output gates exchanged), since correctness is\n * checked by simulation rather than by gate shape.\n */\nfunction greedyRepair(\n  gates: Gate[],\n  xWires: string[],\n  yWires: string[],\n  zWires: string[],\n  priority: Set<string>,\n): string[] {\n  const numBits = xWires.length;\n  const allOutputs = gates.map((g) => g.out);\n  const ordered = [...priority, ...allOutputs.filter((w) => !priority.has(w))];\n\n  let current = gates;\n  const found: string[] = [];\n\n  for (let round = 0; round < 4; round++) {\n    const scan = generateTestCases(numBits, 4 + 4 + numBits * 4 + 30);\n    const badBit = findLowestBrokenBit(current, xWires, yWires, zWires, scan);\n    if (badBit === -1) break;\n\n    const candidateTests = bitTestCases(numBits, badBit);\n    const confirmTests = generateTestCases(numBits, 4 + 4 + numBits * 4 + 30);\n    let fix: [string, string] | null = null;\n\n    const passesUpToBadBit = (\n      swapped: Gate[],\n      tests: Array<{ x: number; y: number }>,\n    ): boolean => {\n      for (const { x, y } of tests) {\n        const inputs = { ...numberToInputs(xWires, x), ...numberToInputs(yWires, y) };\n        const values = simulate(swapped, inputs);\n        if (!bitMatches(values, zWires, badBit, x + y)) return false;\n      }\n      return true;\n    };\n\n    outer: for (const a of ordered) {\n      for (const b of ordered) {\n        if (a === b) continue;\n        const swapped = applySwaps(current, [[a, b]]);\n        if (passesUpToBadBit(swapped, candidateTests) && passesUpToBadBit(swapped, confirmTests)) {\n          fix = [a, b];\n          break outer;\n        }\n      }\n    }\n\n    if (!fix) break;\n    found.push(fix[0], fix[1]);\n    current = applySwaps(current, [fix]);\n  }\n\n  return found;\n}\n\nexport function findSwappedWires(gates: Gate[]): string[] {\n  const xWires = collectWires(gates, 'x', false);\n  const yWires = collectWires(gates, 'y', false);\n  const zWires = collectWires(gates, 'z', true);\n  const maxZ = zWires[zWires.length - 1];\n  const numBits = xWires.length;\n\n  const heuristicSuspects = structuralSuspects(gates, maxZ);\n\n  if (heuristicSuspects.size === 8) {\n    const quickTests = generateTestCases(numBits, 8);\n    const fullTests = generateTestCases(numBits, 4 + 4 + numBits * 4 + 30);\n    const pool = [...heuristicSuspects];\n    for (const pairing of perfectMatchings(pool)) {\n      const swapped = applySwaps(gates, pairing);\n      if (\n        adderIsCorrect(swapped, xWires, yWires, zWires, quickTests) &&\n        adderIsCorrect(swapped, xWires, yWires, zWires, fullTests)\n      ) {\n        return pool.sort();\n      }\n    }\n  }\n\n  const repaired = greedyRepair(gates, xWires, yWires, zWires, heuristicSuspects);\n  if (repaired.length === 8) return repaired.sort();\n\n  return [...heuristicSuspects].sort();\n}\n","structuredPatch":[{"oldStart":272,"oldLines":11,"newStart":272,"newLines":13,"lines":[" "," /**","  * Greedy bit-by-bit repair: locate the lowest broken output bit, search for","- * a single swap (one wire structurally near that bit, paired with any wire","- * in the circuit) that fixes it without regressing lower bits, apply it,","- * and repeat. Robust against swaps the structural heuristic can't see","- * (e.g. two same-role z-output gates exchanged), since correctness is","- * checked by simulation rather than by gate shape.","+ * a single swap (any two gate outputs) that fixes it without regressing","+ * lower bits, apply it, and repeat. A swap partner 