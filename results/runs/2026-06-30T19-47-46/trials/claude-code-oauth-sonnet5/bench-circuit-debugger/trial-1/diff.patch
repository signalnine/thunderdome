nst waiter of waiters) {\n      const remaining = (missingCount.get(waiter) as number) - 1;\n      missingCount.set(waiter, remaining);\n      if (remaining === 0) queue.push(waiter);\n    }\n  }\n\n  return Object.fromEntries(values);\n}\n\nfunction isXY(wire: string): boolean {\n  return wire.startsWith('x') || wire.startsWith('y');\n}\n\nfunction collectWires(gates: Gate[], prefix: string, fromOutputs: boolean): string[] {\n  const set = new Set<string>();\n  for (const g of gates) {\n    const wires = fromOutputs ? [g.out] : [g.in1, g.in2];\n    for (const w of wires) if (w.startsWith(prefix)) set.add(w);\n  }\n  return [...set].sort();\n}\n\n/**\n * Structural heuristic for a ripple-carry adder built from XOR/AND/OR gates:\n *  - every z bit (except the final carry-out bit) must be produced by XOR\n *  - a non-z XOR must consume x/y directly (it's the \"partial sum\" gate)\n *  - an AND must feed an OR (carry generation), except the very first\n *    half-adder's AND (x00 AND y00), which feeds the next bit directly\n *  - an OR must never drive a z bit (other than the final carry-out)\n *  - an OR's inputs must themselves come from AND gates\n * Any wire violating its expected role is a suspect.\n */\nfunction structuralSuspects(gates: Gate[], maxZ: string): Set<string> {\n  const byOutput = new Map<string, Gate>(gates.map((g) => [g.out, g]));\n  const suspects = new Set<string>();\n\n  for (const g of gates) {\n    const { op, in1, in2, out } = g;\n    const isZOut = out.startsWith('z');\n\n    if (op === 'XOR') {\n      if (isZOut) {\n        if (out !== maxZ) {\n          // correct: final sum bit\n        }\n      } else if (!(isXY(in1) && isXY(in2))) {\n        suspects.add(out);\n      }\n    } else if (op === 'AND') {\n      if (isZOut) suspects.add(out);\n      const isFirstBit =\n        (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');\n      if (!isFirstBit) {\n        const feedsOr = gates.some((g2) => g2.op === 'OR' && (g2.in1 === out || g2.in2 === out));\n        if (!feedsOr) suspects.add(out);\n      }\n    } else if (op === 'OR') {\n      if (isZOut && out !== maxZ) suspects.add(out);\n      for (const inp of [in1, in2]) {\n        const src = byOutput.get(inp);\n        if (src && src.op !== 'AND') suspects.add(inp);\n      }\n    }\n\n    if (isZOut && out !== maxZ && op !== 'XOR') suspects.add(out);\n  }\n\n  return suspects;\n}\n\nfunction bitsToNumber(values: Record<string, number>, wires: string[]): number {\n  let result = 0;\n  for (let i = 0; i < wires.length; i++) {\n    result += values[wires[i]] * 2 ** i;\n  }\n  return result;\n}\n\nfunction numberToInputs(wires: string[], n: number): Record<string, number> {\n  const inputs: Record<string, number> = {};\n  for (let i = 0; i < wires.length; i++) {\n    inputs[wires[i]] = Math.floor(n / 2 ** i) % 2;\n  }\n  return inputs;\n}\n\nfunction generateTestCases(numBits: number, count: number): Array<{ x: number; y: number }> {\n  const max = 2 ** numBits - 1;\n  const cases: Array<{ x: number; y: number }> = [\n    { x: 0, y: 0 },\n    { x: max, y: max },\n    { x: max, y: 0 },\n    { x: 0, y: max },\n  ];\n\n  let alt1 = 0;\n  let alt2 = 0;\n  for (let i = 0; i < numBits; i++) {\n    if (i % 2 === 0) alt1 += 2 ** i;\n    else alt2 += 2 ** i;\n  }\n  cases.push({ x: alt1, y: alt2 }, { x: alt2, y: alt1 }, { x: alt1, y: alt1 }, { x: alt2, y: alt2 });\n\n  for (let i = 0; i < numBits; i++) {\n    cases.push({ x: 2 ** i, y: 0 });\n    cases.push({ x: 0, y: 2 ** i });\n    cases.push({ x: 2 ** i, y: 2 ** i });\n    cases.push({ x: 2 ** i - 1, y: 1 });\n  }\n\n  for (let k = 0; k < 30; k++) {\n    cases.push({ x: Math.floor(Math.random() * (max + 1)), y: Math.floor(Math.random() * (max + 1)) });\n  }\n\n  return cases.slice(0, count);\n}\n\nfunction applySwaps(gates: Gate[], pairs: Array<[string, string]>): Gate[] {\n  const rename = new Map<string, string>();\n  for (const [a, b] of pairs) {\n    rename.set(a, b);\n    rename.set(b, a)