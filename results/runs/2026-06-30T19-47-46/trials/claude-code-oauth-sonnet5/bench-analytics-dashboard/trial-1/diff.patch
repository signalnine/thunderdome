}\n\n  const token = jwt.sign({ sub: user.id, tid: user.tenant_id }, JWT_SECRET, { expiresIn: '24h' });\n  res.status(200).json({\n    token,\n    user: { id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role },\n  });\n});\n\nrouter.get('/me', requireAuth, (req, res) => {\n  const db = getDb();\n  const user = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as UserRow | undefined;\n  if (!user) {\n    throw new NotFoundError('User not found');\n  }\n\n  res.status(200).json({ id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role });\n});\n\nrouter.patch('/:id/role', requireAuth, (req, res) => {\n  const db = getDb();\n  const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user!.id) as UserRow | undefined;\n  if (!requester || requester.role !== 'admin') {\n    throw new ForbiddenError('Admin role required');\n  }\n\n  const { role } = req.body ?? {};\n  if (typeof role !== 'string' || !VALID_ROLES.includes(role)) {\n    throw new ValidationError('Invalid role');\n  }\n\n  const target = db.prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?').get(\n    req.params.id,\n    requester.tenant_id\n  ) as UserRow | undefined;\n  if (!target) {\n    throw new NotFoundError('User not found');\n  }\n\n  db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);\n  res.status(200).json({ id: target.id, email: target.email, tenant_id: target.tenant_id, role });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":194,"cache_read_input_tokens":75730,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":194},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ae2ba782-e6ff-4a88-bdc2-975d610c9734","uuid":"e9edfb7e-dd57-4bf