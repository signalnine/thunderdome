+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { NotFoundError, ValidationError } from '../errors';
+import { DashboardRow, WidgetRow } from './types';
+
+const router = Router();
+
+const VALID_WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+function serializeDashboard(row: DashboardRow) {
+  return { ...row, config: JSON.parse(row.config) };
+}
+
+function serializeWidget(row: WidgetRow) {
+  return { ...row, config: JSON.parse(row.config) };
+}
+
+function findDashboard(dashboardId: string, tenantId: string): DashboardRow {
+  const db = getDb();
+  const row = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(dashboardId, tenantId) as DashboardRow | undefined;
+  if (!row) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return row;
+}
+
+router.post('/', (req, res) => {
+  const user = req.user!;
+  const { name, config } = req.body ?? {};
+  if (typeof name !== 'string' || name.length === 0) {
+    throw new ValidationError('name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare('INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)').run(
+    id,
+    user.tenantId,
+    name,
+    user.id,
+    JSON.stringify(config ?? {})
+  );
+
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;
+  res.status(201).json(serializeDashboard(row));
+});
+
+router.get('/', (req, res) => {
+  const user = req.user!;
+  const db = getDb();
+  const rows = db.prepare('SELECT * FROM dashboards WHERE tenant_id = ?').all(user.tenantId) as DashboardRow[];
+  res.status(200).json(rows.map(serializeDashboard));
+});
+
+router.get('/:id', (req, res) => {
+  const user = req.user!;
+  const dashboard = findDashboard(req.params.id, user.tenantId);
+  const db = getDb();
+  const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(dashboard.id) as WidgetRow[];
+  res.status(200).json({ ...serializeDashboard(dashboard), widgets: widgets.map(serializeWidget) });
+});
+
+router.patch('/:id', (req, res) => {
+  const user = req.user!;
+  const dashboard = findDashboard(req.params.id, user.tenantId);
+  const { name, config } = req.body ?? {};
+
+  const db = getDb();
+  const newName = typeof name === 'string' && name.length > 0 ? name : dashboard.name;
+  const newConfig = config !== undefined ? JSON.stringify(config) : dashboard.config;
+  db.prepare("UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?").run(
+    newName,
+    newConfig,
+    dashboard.id
+  );
+
+  const updated = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(dashboard.id) as DashboardRow;
+  res.status(200).json(serializeDashboard(updated));
+});
+
+router.delete('/:id', (req, res) => {
+  const user = req.user!;
+  const dashboard = findDashboard(req.params.id, user.tenantId);
+  const db = getDb();
+  db.prepare('DELETE FROM dashboards WHERE id = ?').run(dashboard.id);
+  res.status(204).send();
+});
+
+router.post('/:id/widgets', (req, res) => {
+  const user = req.user!;
+  const dashboard = findDashboard(req.params.id, user.tenantId);
+  const { type, config, position_x, position_y, width, height } = req.body ?? {};
+  if (typeof type !== 'string' || !VALID_WIDGET_TYPES.includes(type)) {
+    throw new ValidationError(`type must be one of ${VALID_WIDGET_TYPES.join(', ')}`);
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+  ).run(
+    id,
+    dashboard.id,
+    type,
+    JSON.stringify(config ?? {}),
+    position_x ?? 0,
+    position_y ?? 0,
+    width ?? 1,
+    height ?? 1
+  );
+
+  const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+  res.status(201).json(serializeWidget(row));
+});
+
+router.delete('/:id/widgets/:widgetId', (req, res) => {
+  const user = req.user!;
+  const dashboard = findDashboard(req.params.id, user.tenantId);
+  const db = getDb();
+  const widget = db
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(req.params.widgetId, dashboard.id);
+  if (!widget) {
+    throw new NotFoundError('Widget not found');
+  }
+
+  db.prepare('DELETE FROM widgets WHERE id = ?').run(req.params.widgetId);
+  res.status(204).send();
+});
+
+export default router;
