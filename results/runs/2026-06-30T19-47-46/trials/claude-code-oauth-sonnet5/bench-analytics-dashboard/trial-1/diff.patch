+import { Router } from 'express';
+import { getDb } from '../db';
+import { NotFoundError, ValidationError } from '../errors';
+import { DashboardRow, WidgetRow } from '../dashboards/types';
+
+const router = Router();
+
+function toCsv(rows: Record<string, unknown>[]): string {
+  if (rows.length === 0) return '';
+  const headers = Object.keys(rows[0]);
+  const escape = (value: unknown): string => {
+    const str = value === null || value === undefined ? '' : String(value);
+    if (/[",\n]/.test(str)) {
+      return `"${str.replace(/"/g, '""')}"`;
+    }
+    return str;
+  };
+
+  const lines = [headers.join(',')];
+  for (const row of rows) {
+    lines.push(headers.map((header) => escape(row[header])).join(','));
+  }
+  return lines.join('\n');
+}
+
+router.get('/events', (req, res) => {
+  const user = req.user!;
+  const format = typeof req.query.format === 'string' ? req.query.format : 'json';
+  if (format !== 'json' && format !== 'csv') {
+    throw new ValidationError('format must be json or csv');
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+    .all(user.tenantId) as Record<string, unknown>[];
+
+  if (format === 'csv') {
+    res.setHeader('Content-Type', 'text/csv');
+    res.status(200).send(toCsv(rows));
+    return;
+  }
+
+  res.status(200).json(rows);
+});
+
+router.get('/dashboard/:id', (req, res) => {
+  const user = req.user!;
+  const db = getDb();
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, user.tenantId) as DashboardRow | undefined;
+  if (!dashboard) {
+    throw new NotFoundError('Dashboard not found');
+  }
+
+  const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },
+    widgets: widgets.map((w) => ({ ...w, config: JSON.parse(w.config) })),
+  });
+});
+
+export default router;
diff --git a/src/ingest/router.ts b/src/ingest/router.ts
new file mode 100644
index 0000000..7d03b3a
--- /dev/null
+++ b/src/ingest/router.ts
@@ -0,0 +1,98 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+
+const router = Router();
+
+interface IncomingEvent {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  user_id?: unknown;
+  session_id?: unknown;
+}
+
+interface InsertedEvent {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: unknown;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function validateEvent(event: IncomingEvent): void {
+  if (!event || typeof event.name !== 'string' || event.name.length === 0) {
+    throw new ValidationError('each event requires a name');
+  }
+}
+
+function buildInsertedEvent(event: IncomingEvent, tenantId: string): InsertedEvent {
+  return {
+    id: uuidv4(),
+    tenant_id: tenantId,
+    name: event.name as string,
+    properties: event.properties ?? {},
+    timestamp: typeof event.timestamp === 'string' ? event.timestamp : new Date().toISOString(),
+    user_id: typeof event.user_id === 'string' ? event.user_id : null,
+    session_id: typeof event.session_id === 'string' ? event.session_id : null,
+  };
+}
+
+router.post('/', (req, res) => {
+  const user = req.user!;
+  const body = req.body ?? {};
+  validateEvent(body);
+
+  const event = buildInsertedEvent(body, user.tenantId);
+  const db = getDb();
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(
+    event.id,
+    event.tenant_id,
+    event.name,
+    JSON.stringify(event.properties),
+    event.timestamp,
+    event.user_id,
+    event.session_id
+  );
+
+  res.status(201).json(event);
+});
+
+router.post('/batch', (req, res) => {
+  const user = req.user!;
+  const { events } = req.body ?? {};
+  if (!Array.isArray(events) || events.length === 0) {
+    throw new ValidationError('events array is required and must not be empty');
+  }
+  events.forEach(validateEvent);
+
+  const db = getDb();
+  const insert = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  const inserted: InsertedEvent[] = events.map((e: IncomingEvent) => buildInsertedEvent(e, user.tenantId));
+  const txn = db.transaction((items: InsertedEvent[]) => {
+    for (const item of items) {
+      insert.run(
+        item.id,
+        item.tenant_id,
+        item.name,
+        JSON.stringify(item.properties),
+        item.timestamp,
+        item.user_id,
+        item.session_id
+      );
+    }
+  });
+  txn(inserted);
+
+  res.status(201).json({ inserted: inserted.length, events: inserted });
+});
+
+export default router;
