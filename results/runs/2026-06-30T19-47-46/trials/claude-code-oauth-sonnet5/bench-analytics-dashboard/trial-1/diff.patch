@@ -0,0 +1,159 @@
+import { Router } from 'express';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+
+const router = Router();
+
+const BUCKET_FORMATS: Record<string, string> = {
+  hour: '%Y-%m-%dT%H:00:00Z',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+interface QueryFilter {
+  event_name?: unknown;
+  start?: unknown;
+  end?: unknown;
+}
+
+function applyTimeRange(sql: string, params: unknown[], filter: QueryFilter): string {
+  let next = sql;
+  if (typeof filter.start === 'string') {
+    next += ' AND timestamp >= ?';
+    params.push(filter.start);
+  }
+  if (typeof filter.end === 'string') {
+    next += ' AND timestamp <= ?';
+    params.push(filter.end);
+  }
+  return next;
+}
+
+router.post('/count', (req, res) => {
+  const user = req.user!;
+  const body = req.body ?? {};
+  if (typeof body.event_name !== 'string' || body.event_name.length === 0) {
+    throw new ValidationError('event_name is required');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId, body.event_name];
+  let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+  sql = applyTimeRange(sql, params, body);
+
+  const row = db.prepare(sql).get(...params) as { count: number };
+  res.status(200).json({ count: row.count });
+});
+
+router.post('/timeseries', (req, res) => {
+  const user = req.user!;
+  const body = req.body ?? {};
+  if (typeof body.event_name !== 'string' || body.event_name.length === 0) {
+    throw new ValidationError('event_name is required');
+  }
+
+  const bucket = typeof body.bucket === 'string' ? body.bucket : 'day';
+  const format = BUCKET_FORMATS[bucket];
+  if (!format) {
+    throw new ValidationError(`invalid bucket: must be one of ${Object.keys(BUCKET_FORMATS).join(', ')}`);
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId, body.event_name];
+  let sql = `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+  sql = applyTimeRange(sql, params, body);
+  sql += ' GROUP BY bucket ORDER BY bucket';
+
+  const data = db.prepare(sql).all(...params);
+  res.status(200).json({ data });
+});
+
+router.post('/breakdown', (req, res) => {
+  const user = req.user!;
+  const body = req.body ?? {};
+  if (typeof body.event_name !== 'string' || body.event_name.length === 0) {
+    throw new ValidationError('event_name is required');
+  }
+  if (typeof body.property_key !== 'string' || body.property_key.length === 0) {
+    throw new ValidationError('property_key is required');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId, body.event_name];
+  let sql = 'SELECT properties FROM events WHERE tenant_id = ? AND name = ?';
+  sql = applyTimeRange(sql, params, body);
+
+  const rows = db.prepare(sql).all(...params) as { properties: string }[];
+  const counts = new Map<string, number>();
+  for (const row of rows) {
+    let parsed: Record<string, unknown> = {};
+    try {
+      parsed = JSON.parse(row.properties);
+    } catch {
+      // malformed properties contribute to the "unknown" bucket below
+    }
+    const value = parsed[body.property_key];
+    const key = value === undefined || value === null ? 'unknown' : String(value);
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  }
+
+  const data = Array.from(counts.entries())
+    .map(([property_value, count]) => ({ property_value, count }))
+    .sort((a, b) => b.count - a.count);
+
+  res.status(200).json({ data });
+});
+
+router.post('/funnel', (req, res) => {
+  const user = req.user!;
+  const body = req.body ?? {};
+  if (!Array.isArray(body.steps) || body.steps.length === 0) {
+    throw new ValidationError('steps array is required');
+  }
+  const steps: string[] = body.steps;
+  if (!steps.every((s) => typeof s === 'string' && s.length > 0)) {
+    throw new ValidationError('each step must be a non-empty event name');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId];
+  let sql = 'SELECT id, name, timestamp, session_id FROM events WHERE tenant_id = ? AND session_id IS NOT NULL';
+  sql = applyTimeRange(sql, params, body);
+  sql += ' ORDER BY timestamp ASC, id ASC';
+
+  const rows = db.prepare(sql).all(...params) as {
+    id: string;
+    name: string;
+    timestamp: string;
+    session_id: string;
+  }[];
+
+  const bySession = new Map<string, { name: string; timestamp: string }[]>();
+  for (const row of rows) {
+    if (!bySession.has(row.session_id)) {
+      bySession.set(row.session_id, []);
+    }
+    bySession.get(row.session_id)!.push({ name: row.name, timestamp: row.timestamp });
+  }
+
+  const stepCounts = new Array(steps.length).fill(0);
+  for (const events of bySession.values()) {
+    let cursorTime: string | null = null;
+    let stepIndex = 0;
+    for (const ev of events) {
+      if (stepIndex >= steps.length) break;
+      if (ev.name === steps[stepIndex] && (cursorTime === null || ev.timestamp >= cursorTime)) {
+        stepCounts[stepIndex] += 1;
+        cursorTime = ev.timestamp;
+        stepIndex += 1;
+      }
+    }
+  }
+
+  res.status(200).json({
+    steps: steps.map((name, i) => ({ name, count: stepCounts[i] })),
+  });
+});
+
+export default router;
