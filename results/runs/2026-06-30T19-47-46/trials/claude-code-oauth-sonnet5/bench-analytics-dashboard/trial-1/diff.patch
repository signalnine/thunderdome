us(201).json(event);\n});\n\nrouter.post('/batch', (req, res) => {\n  const user = req.user!;\n  const { events } = req.body ?? {};\n  if (!Array.isArray(events) || events.length === 0) {\n    throw new ValidationError('events array is required and must not be empty');\n  }\n  events.forEach(validateEvent);\n\n  const db = getDb();\n  const insert = db.prepare(\n    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'\n  );\n\n  const inserted: InsertedEvent[] = events.map((e: IncomingEvent) => buildInsertedEvent(e, user.tenantId));\n  const txn = db.transaction((items: InsertedEvent[]) => {\n    for (const item of items) {\n      insert.run(\n        item.id,\n        item.tenant_id,\n        item.name,\n        JSON.stringify(item.properties),\n        item.timestamp,\n        item.user_id,\n        item.session_id\n      );\n    }\n  });\n  txn(inserted);\n\n  res.status(201).json({ inserted: inserted.length, events: inserted });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1452,"cache_read_input_tokens":75924,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1452},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ae2ba782-e6ff-4a88-bdc2-975d610c9734","uuid":"6940c879-0a24-4ec5-916b-22012dffa1dd","request_id":"req_011Cca2kL6MhCwMKdY69P9fS"}
