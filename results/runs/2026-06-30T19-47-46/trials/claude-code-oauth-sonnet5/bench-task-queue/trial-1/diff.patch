edule {\n  lastRunAt: Date;\n}\n\nexport type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;\n\nexport interface ShutdownSummary {\n  completed: number;\n  cancelled: number;\n  elapsed: number;\n}\n\ntype ProgressCallback = (info: ProgressInfo) => void;\n\ninterface QueueRecord {\n  name: string;\n  tasks: Task[];\n  dlq: Task[];\n  concurrencyMax: number;\n  concurrencyCurrent: number;\n  middlewares: Middleware[];\n}\n\ntype ShutdownTracker = (taskId: string, status: TaskStatus) => void;\n\nexport class TaskQueue {\n  private queues = new Map<string, QueueRecord>();\n  private tasksById = new Map<string, Task>();\n  private sequence = 0;\n  private progress = new Map<string, ProgressInfo>();\n  private progressListeners = new Map<string, Set<ProgressCallback>>();\n  private schedules = new Map<string, InternalSchedule>();\n\n  private shuttingDown = false;\n  private shutdownPromise: Promise<ShutdownSummary> | null = null;\n  private shutdownCallbacks: Array<() => void> = [];\n  private shutdownTracker: ShutdownTracker | null = null;\n\n  // ---------------------------------------------------------------------\n  // Queue helpers\n  // ---------------------------------------------------------------------\n\n  private getOrCreateQueue(name: string): QueueRecord {\n    let queue = this.queues.get(name);\n    if (!queue) {\n      queue = {\n        name,\n        tasks: [],\n        dlq: [],\n        concurrencyMax: Infinity,\n        concurrencyCurrent: 0,\n        middlewares: [],\n      };\n      this.queues.set(name, queue);\n    }\n    return queue;\n  }\n\n  private releaseSlot(queueName: string): void {\n    const queue = this.queues.get(queueName);\n    if (queue && queue.concurrencyCurrent > 0) {\n      queue.concurrencyCurrent -= 1;\n    }\n  }\n\n  private dependenciesSatisfied(task: Task): boolean {\n    return task.dependsOn.every((id) => this.tasksById.get(id)?.status === 'completed');\n  }\n\n  private wouldCreateCycle(newTaskId: string, dependsOn: string[]): boolean {\n    const visited = new Set<string>();\n    const dfs = (current: string): boolean => {\n      if (current === newTaskId) return true;\n      if (visited.has(current)) return false;\n      visited.add(current);\n      const task = this.tasksById.get(current);\n      if (!task) return false;\n      return task.dependsOn.some((dep) => dfs(dep));\n    };\n    return dependsOn.some((dep) => dfs(dep));\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 1-4: enqueue / dequeue\n  // ---------------------------------------------------------------------\n\n  enqueue(queueName: string, payload?: unknown, options?: EnqueueOptions): Task;\n  enqueue(payload: unknown): Task;\n  enqueue(...args: unknown[]): Task {\n    if (this.shuttingDown) {\n      throw new Error('Cannot enqueue: queue is shutting down');\n    }\n\n    let queueName: string;\n    let payload: unknown;\n    let options: EnqueueOptions;\n\n    if (args.length <= 1) {\n      queueName = 'default';\n      payload = args[0];\n      options = {};\n    } else {\n      queueName = args[0] as string;\n      payload = args[1];\n      options = (args[2] as EnqueueOptions) ?? {};\n    }\n\n    const priority = options.priority ?? 5;\n    if (priority < 1 || priority > 10) {\n      throw new Error('priority must be between 1 and 10');\n    }\n\n    const maxRetries = options.maxRetries ?? 3;\n    const backoffMs = options.backoffMs ?? 1000;\n\n    let availableAt = new Date();\n    if (options.runAt) {\n      availableAt = new Date(options.runAt.getTime());\n    } else if (options.delay) {\n      availableAt = new Date(Date.now() + options.delay);\n    }\n\n    const dependsOn = options.dependsOn ? [...options.dependsOn] : [];\n    for (const depId of dependsOn) {\n      if (!this.tasksById.has(depId)) {\n        throw new Error(`Dependency task ${depId} does not exist`);\n      }\n    }\n\n    const id = randomUUID();\n    if (dependsOn.length > 0 && this.wouldCreateCycle(id, dependsOn)) {\n      throw new Error('Circular dependency detected');\n    }\n\n    const task: Task = {\n      id,\n      payload,\n      status: 'pending',\n      createdAt: new Date(),\n      priority,\n      availableAt,\n      attempts: 0,\n      maxRetries,\n      backoffMs,\n      dependsOn,\n      queueName,\n      seq: this.sequence++,\n    };\n\n    const queue = this.getOrCreateQueue(queueName);\n    queue.tasks.push(task);\n    this.tasksById.set(id, task);\n\n    return task;\n  }\n\n  dequeue(queueName = 'default'): Task | null {\n    const queue = this.queues.get(queueName);\n    if (!queue) return null;\n\n    if (queue.concurrencyCurrent >= queue.concurrencyMax) {\n      return null;\n    }\n\n    const now = Date.now();\n    const candidates = queue.tasks.filter(\n      (t) =>\n        t.status === 'pending' &&\n        t.availableAt.getTime() <= now &&\n        this.dependenciesSatisfied(t)\n    );\n\n    if (candidates.length === 0) return null;\n\n    candidates.sort((a, b) => {\n      if (a.priority !== b.priority) return a.priority - b.priority;\n      if (a.availableAt.getTime() !== b.availableAt.getTime()) {\n        return a.availableAt.getTime() - b.availableAt.getTime();\n      }\n      return a.seq - b.seq;\n    });\n\n    const chosen = candidates[0];\n    chosen.status = 'processing';\n    chosen.attempts += 1;\n    queue.concurrencyCurrent += 1;\n    return chosen;\n  }\n\n  size(queueName = 'default'): number {\n    return this.queueSize(queueName);\n  }\n\n  listQueues(): string[] {\n    return Array.from(this.queues.keys());\n  }\n\n  queueSize(queueName = 'default'): number {\n    const queue = this.queues.get(queueName);\n    if (!queue) return 0;\n    return queue.tasks.filter((t) => t.status === 'pending').length;\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 5-6: retry / DLQ\n  // ---------------------------------------------------------------------\n\n  complete(taskId: string): void {\n    const task = this.tasksById.get(taskId);\n    if (!task || task.status !== 'processing') return;\n\n    task.status = 'completed';\n    this.releaseSlot(task.queueName);\n\n    if (this.shuttingDown && this.shutdownTracker) {\n      this.shutdownTracker(taskId, 'completed');\n    }\n  }\n\n  fail(taskId: string, error?: unknown): void {\n    const task = this.tasksById.get(taskId);\n    if (!task || task.status !== 'processing') return;\n\n    task.lastError =\n      typeof error === 'string'\n        ? error\n        : error instanceof Error\n          ? error.message\n          : String(error);\n    this.releaseSlot(task.queueName);\n\n    if (task.attempts <= task.maxRetries) {\n      const delay = task.backoffMs * Math.pow(2, task.attempts - 1);\n      task.status = 'pending';\n      task.availableAt = new Date(Date.now() + delay);\n    } else {\n      task.status = 'failed';\n      task.failCount = task.attempts;\n      const queue = this.queues.get(task.queueName);\n      if (queue) {\n        queue.dlq.push(task);\n      }\n    }\n\n    if (this.shuttingDown && this.shutdownTracker) {\n      this.shutdownTracker(taskId, task.status);\n    }\n  }\n\n  getDLQ(queueName: string): Task[] {\n    const queue = this.queues.get(queueName);\n    return queue ? [...queue.dlq] : [];\n  }\n\n  retryDLQ(taskId: string): Task | null {\n    const task = this.tasksById.get(taskId);\n    if (!task) return null;\n\n    const queue = this.queues.get(task.queueName);\n    if (!queue) return null;\n\n    const idx = queue.dlq.findIndex((t) => t.id === taskId);\n    if (idx === -1) return null;\n\n    queue.dlq.splice(idx, 1);\n\n    task.attempts = 0;\n    task.status = 'pending';\n    task.availableAt = new Date();\n\n    return task;\n  }\n\n  clearDLQ(queueName: string): void {\n    const queue = this.queues.get(queueName);\n    if (queue) {\n      queue.dlq = [];\n    }\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 7: dependencies\n  // ---------------------------------------------------------------------\n\n  getDependencies(taskId: string): DependencyInfo[] {\n    const task = this.tasksById.get(taskId);\n    if (!task) return [];\n    return task.dependsOn.map((id) => ({\n      taskId: id,\n      status: this.tasksById.get(id)?.status ?? 'unknown',\n    }));\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 8: concurrency\n  // ---------------------------------------------------------------------\n\n  setConcurrency(queueName: string, limit: number): void {\n    const queue = this.getOrCreateQueue(queueName);\n    queue.concurrencyMax = limit;\n  }\n\n  getConcurrency(queueName: string): ConcurrencyInfo {\n    const queue = this.queues.get(queueName);\n    if (!queue) return { current: 0, max: Infinity };\n    return { current: queue.concurrencyCurrent, max: queue.concurrencyMax };\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 9: progress / cancellation\n  // ---------------------------------------------------------------------\n\n  updateProgress(taskId: string, percent: number, message?: string): void {\n    if (percent < 0 || percent > 100) {\n      throw new Error('progress percent must be between 0 and 100');\n    }\n    const info: ProgressInfo = { percent, message, updatedAt: new Date() };\n    this.progress.set(taskId, info);\n\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) {\n      for (const cb of listeners) cb(info);\n    }\n  }\n\n  getProgress(taskId: string): ProgressInfo | null {\n    return this.progress.get(taskId) ?? null;\n  }\n\n  onProgress(taskId: string, callback: ProgressCallback): () => void {\n    let listeners = this.progressListeners.get(taskId);\n    if (!listeners) {\n      listeners = new Set();\n      this.progressListeners.set(taskId, listeners);\n    }\n    listeners.add(callback);\n    return () => listeners!.delete(callback);\n  }\n\n  cancel(taskId: string): void {\n    const task = this.tasksById.get(taskId);\n    if (!task) return;\n    if (task.status !== 'pending' && task.status !== 'processing') return;\n\n    const wasProcessing = task.status === 'processing';\n    task.status = 'cancelled';\n    if (wasProcessing) {\n      this.releaseSlot(task.queueName);\n    }\n\n    if (this.shuttingDown && this.shutdownTracker) {\n      this.shutdownTracker(taskId, 'cancelled');\n    }\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 10: cron scheduling\n  // ---------------------------------------------------------------------\n\n  private parseCronField(field: string): (value: number) => boolean {\n    if (field === '*') {\n      return () => true;\n    }\n    if (field.startsWith('*/')) {\n      const step = parseInt(field.slice(2), 10);\n      return (value: number) => value % step === 0;\n    }\n    const fixed = parseInt(field, 10);\n    return (value: number) => value === fixed;\n  }\n\n  private nextCronOccurrence(after: Date, cronExpression: string): Date {\n    const parts = cronExpression.trim().split(/\\s+/);\n    const minuteMatcher = this.parseCronField(parts[0] ?? '*');\n    const hourMatcher = this.parseCronField(parts[1] ?? '*');\n\n    let candidate = new Date(after.getTime());\n    candidate.setSeconds(0, 0);\n    candidate = new Date(candidate.getTime() + 60000);\n\n    for (let i = 0; i < 100000; i++) {\n      if (minuteMatcher(candidate.getUTCMinutes()) && hourMatcher(candidate.getUTCHours())) {\n        return candidate;\n      }\n      candidate = new Date(candidate.getTime() + 60000);\n    }\n    throw new Error('Unable to compute next cron occurrence');\n  }\n\n  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {\n    const id = randomUUID();\n    const sched: InternalSchedule = {\n      id,\n      queueName,\n      cronExpression,\n      taskTemplate,\n      active: true,\n      lastRunAt: new Date(),\n    };\n    this.schedules.set(id, sched);\n    return sched;\n  }\n\n  unschedule(scheduleId: string): void {\n    const sched = this.schedules.get(scheduleId);\n    if (sched) sched.active = false;\n  }\n\n  listSchedules(queueName?: string): Schedule[] {\n    return Array.from(this.schedules.values()).filter(\n      (s) => s.active && (!queueName || s.queueName === queueName)\n    );\n  }\n\n  tick(): void {\n    const now = Date.now();\n    for (const sched of this.schedules.values()) {\n      if (!sched.active) continue;\n\n      let next = this.nextCronOccurrence(sched.lastRunAt, sched.cronExpression);\n      let iterations = 0;\n      while (next.getTime() <= now && iterations < 1000) {\n        this.enqueue(sched.queueName, sched.taskTemplate);\n        sched.lastRunAt = next;\n        next = this.nextCronOccurrence(sched.lastRunAt, sched.cronExpression);\n        iterations++;\n      }\n    }\n  }\n\n  // ---------------------------------------------------------------------\n  // Phase 11: middleware\n  // ---------------------------------------------------------------------\n\n  use(queueName: string, middleware: Middleware): void {\n    const queue = this.getOrCreateQueue(queueName);\n    queue.middlewares.push(middleware);\n  }\n\n  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {\n    const task = this.dequeue(queueName);\n    if (!task) return;\n\n    const queue = this.getOrCreateQueue(queueName);\n\n    const runner = async (i: number): Promise<void> => {\n      if (i < queue.middlewares.length) {\n        await queue.middlewares[i](task, () => runner(i + 1));\n      } else {\n        await handler(task);\n      }\n    };\n\n    try {\n      await runner(0);\n      this.complete(task.id);\n    } catch (err) {\n      this.fail(task.id, err instanceof Error ? err.message : String(err));\n    }\n  }\n\n  // --------------------------------