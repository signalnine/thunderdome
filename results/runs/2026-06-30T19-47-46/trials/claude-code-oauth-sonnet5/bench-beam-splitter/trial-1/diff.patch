@@ -0,0 +1,71 @@
+// Beam directions, encoded as small integers for compact state keys.
+const DOWN = 0;
+const DOWN_LEFT = 1;
+const DOWN_RIGHT = 2;
+const COL_DELTA = [0, -1, 1];
+
+function findSourceCol(grid: string[][]): number {
+  const topRow = grid[0] ?? [];
+  for (let col = 0; col < topRow.length; col++) {
+    if (topRow[col] === 'S') return col;
+  }
+  throw new Error('No source (S) found in top row of grid');
+}
+
+interface SimResult {
+  cellCount: number;
+  totalPaths: bigint;
+}
+
+// Propagates beams row by row. Beams are grouped into states of
+// (col, direction) per row, with bigint multiplicities, so splits never
+// cause exponential blowup in time or memory.
+function simulate(grid: string[][]): SimResult {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const sourceCol = findSourceCol(grid);
+
+  const visited = new Set<number>();
+  let totalPaths = 0n;
+
+  let current = new Map<number, bigint>();
+  current.set(sourceCol * 3 + DOWN, 1n);
+
+  for (let row = 0; row < rows && current.size > 0; row++) {
+    const next = new Map<number, bigint>();
+    for (const [state, ways] of current) {
+      const col = Math.floor(state / 3);
+      const dir = state % 3;
+      visited.add(row * cols + col);
+
+      const isSplitter = grid[row][col] === '^';
+      const childDirs = isSplitter ? [DOWN_LEFT, DOWN_RIGHT] : [dir];
+      for (const childDir of childDirs) {
+        const childCol = col + COL_DELTA[childDir];
+        if (childCol >= 0 && childCol < cols) {
+          const key = childCol * 3 + childDir;
+          next.set(key, (next.get(key) ?? 0n) + ways);
+        } else {
+          totalPaths += ways;
+        }
+      }
+    }
+    current = next;
+  }
+
+  // Any beams still active after the last row have stepped past the
+  // bottom edge of the grid, so they have exited.
+  for (const ways of current.values()) {
+    totalPaths += ways;
+  }
+
+  return { cellCount: visited.size, totalPaths };
+}
+
+export function countBeamCells(grid: string[][]): number {
+  return simulate(grid).cellCount;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  return simulate(grid).totalPaths;
+}
