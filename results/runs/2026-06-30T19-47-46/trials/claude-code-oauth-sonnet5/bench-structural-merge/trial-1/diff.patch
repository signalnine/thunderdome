+++ b/src/store.ts
@@ -0,0 +1,291 @@
+import { mergeDocumentContent } from './merge.js';
+import type { Conflict, DocState, DocumentStore as IDocumentStore, MergeResult, Version, VersionRecord } from './types.js';
+import { deepClone, deepEqual } from './utils.js';
+
+const MAIN_BRANCH = 'main';
+
+export class DocumentStore implements IDocumentStore {
+  private versions = new Map<string, VersionRecord[]>();
+  private branches = new Map<string, Map<string, DocState>>();
+  private currentBranch = MAIN_BRANCH;
+  private versionCounter = 0;
+
+  constructor() {
+    this.branches.set(MAIN_BRANCH, new Map());
+  }
+
+  // ---------------------------------------------------------------------
+  // Document CRUD
+  // ---------------------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const docMap = this.requireBranch(this.currentBranch);
+    const existing = docMap.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${this.currentBranch}"`);
+    }
+
+    const version = this.appendVersion(id, content, existing ? existing.headId : null);
+    docMap.set(id, { headId: version.id, deleted: false });
+  }
+
+  get(id: string): object {
+    const docMap = this.requireBranch(this.currentBranch);
+    const state = docMap.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    return deepClone(this.requireVersion(id, state.headId).content);
+  }
+
+  update(id: string, content: object): void {
+    const docMap = this.requireBranch(this.currentBranch);
+    const state = docMap.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    const version = this.appendVersion(id, content, state.headId);
+    docMap.set(id, { headId: version.id, deleted: false });
+  }
+
+  delete(id: string): void {
+    const docMap = this.requireBranch(this.currentBranch);
+    const state = docMap.get(id);
+    if (!state || state.deleted) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    docMap.set(id, { headId: state.headId, deleted: true });
+  }
+
+  // ---------------------------------------------------------------------
+  // Version history
+  // ---------------------------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const docMap = this.requireBranch(this.currentBranch);
+    const state = docMap.get(id);
+    if (!state) {
+      throw new Error(`Document "${id}" not found`);
+    }
+
+    const chain: VersionRecord[] = [];
+    let cursor: string | null = state.headId;
+    while (cursor) {
+      const version: VersionRecord = this.requireVersion(id, cursor);
+      chain.push(version);
+      cursor = version.parentId;
+    }
+    chain.reverse();
+
+    return chain.map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const list = this.versions.get(id);
+    if (!list) {
+      throw new Error(`Document "${id}" not found`);
+    }
+    const version = list.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(version.content);
+  }
+
+  // ---------------------------------------------------------------------
+  // Branching
+  // ---------------------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceMap = this.requireBranch(fromBranch ?? this.currentBranch);
+    const clone = new Map<string, DocState>();
+    for (const [docId, state] of sourceMap) {
+      clone.set(docId, { ...state });
+    }
+    this.branches.set(name, clone);
+  }
+
+  switchBranch(name: string): void {
+    this.requireBranch(name);
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return Array.from(this.branches.keys());
+  }
+
+  // ---------------------------------------------------------------------
+  // Merging
+  // ---------------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const oursMap = this.requireBranch(this.currentBranch);
+    const theirsMap = this.requireBranch(sourceBranch);
+
+    const docIds = new Set<string>([...oursMap.keys(), ...theirsMap.keys()]);
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const resultMap = new Map<string, DocState>();
+    for (const [docId, state] of oursMap) {
+      resultMap.set(docId, { ...state });
+    }
+    // New versions are only materialized into global history once we know
+    // the whole merge is conflict-free and will actually be applied.
+    const pendingVersions: { docId: string; content: object; parentId: string }[] = [];
+
+    for (const docId of docIds) {
+      const oursState = oursMap.get(docId);
+      const theirsState = theirsMap.get(docId);
+
+      const oursDeleted = !!oursState?.deleted;
+      const theirsDeleted = !!theirsState?.deleted;
+      const oursContent = oursState && !oursDeleted ? this.requireVersion(docId, oursState.headId).content : undefined;
+      const theirsContent = theirsState && !theirsDeleted ? this.requireVersion(docId, theirsState.headId).content : undefined;
+
+      // Identical outcome on both sides: nothing to do.
+      if (oursDeleted === theirsDeleted && deepEqual(oursContent, theirsContent)) {
+        if (!oursDeleted && oursContent !== undefined) {
+          merged[docId] = deepClone(oursContent);
+        }
+        continue;
+      }
+
+      const baseVersionId = this.findCommonAncestor(docId, oursState?.headId, theirsState?.headId);
+      const baseContent = baseVersionId !== undefined ? this.requireVersion(docId, baseVersionId).content : undefined;
+
+      // Doc only exists on one side (no shared history at all).
+      if (!oursState || !theirsState) {
+        if (theirsState && !theirsDeleted) {
+          merged[docId] = deepClone(theirsContent!);
+          resultMap.set(docId, { ...theirsState });
+        } else if (oursState && !oursDeleted) {
+          merged[docId] = deepClone(oursContent!);
+        }
+        continue;
+      }
+
+      const oursUnchanged = !oursDeleted && deepEqual(oursContent, baseContent);
+      const theirsUnchanged = !theirsDeleted && deepEqual(theirsContent, baseContent);
+
+      if (oursUnchanged) {
+        if (!theirsDeleted) {
+          merged[docId] = deepClone(theirsContent!);
+        }
+        resultMap.set(docId, { ...theirsState });
+        continue;
+      }
+
+      if (theirsUnchanged) {
+        if (!oursDeleted) {
+          merged[docId] = deepClone(oursContent!);
+        }
+        continue;
+      }
+
+      // Both sides diverged from base in incompatible ways.
+      if (oursDeleted || theirsDeleted) {
+        conflicts.push({
+          documentId: docId,
+          path: '',
+          base: baseContent !== undefined ? deepClone(baseContent) : null,
+          ours: oursDeleted ? null : deepClone(oursContent!),
+          theirs: theirsDeleted ? null : deepClone(theirsContent!),
+        });
+        if (!oursDeleted) {
+          merged[docId] = deepClone(oursContent!);
+        }
+        continue;
+      }
+
+      const { merged: mergedContent, conflicts: fieldConflicts } = mergeDocumentContent(
+        baseContent ?? {},
+        oursContent!,
+        theirsContent!,
+        docId,
+      );
+      merged[docId] = mergedContent;
+      conflicts.push(...fieldConflicts);
+
+      if (fieldConflicts.length === 0) {
+        pendingVersions.push({ docId, content: mergedContent, parentId: oursState.headId });
+      }
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      for (const pending of pendingVersions) {
+        const version = this.appendVersion(pending.docId, pending.content, pending.parentId);
+        resultMap.set(pending.docId, { headId: version.id, deleted: false });
+      }
+      this.branches.set(this.currentBranch, resultMap);
+    }
+
+    return { merged, conflicts, applied };
+  }
+
+  // ---------------------------------------------------------------------
+  // Internals
+  // ---------------------------------------------------------------------
+
+  private requireBranch(name: string): Map<string, DocState> {
+    const map = this.branches.get(name);
+    if (!map) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    return map;
+  }
+
+  private requireVersion(documentId: string, versionId: string): VersionRecord {
+    const version = this.versions.get(documentId)?.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" not found for document "${documentId}"`);
+    }
+    return version;
+  }
+
+  private appendVersion(documentId: string, content: object, parentId: string | null): VersionRecord {
+    const version: VersionRecord = {
+      id: `v${this.versionCounter++}`,
+      timestamp: Date.now(),
+      content: deepClone(content),
+      parentId,
+    };
+    const list = this.versions.get(documentId);
+    if (list) {
+      list.push(version);
+    } else {
+      this.versions.set(documentId, [version]);
+    }
+    return version;
+  }
+
+  /** Finds the nearest version shared by both head pointers' ancestry chains. */
+  private findCommonAncestor(
+    documentId: string,
+    oursHeadId: string | undefined,
+    theirsHeadId: string | undefined,
+  ): string | undefined {
+    if (!oursHeadId || !theirsHeadId) return undefined;
+
+    const oursAncestors = new Set<string>();
+    let cursor: string | null = oursHeadId;
+    while (cursor) {
+      oursAncestors.add(cursor);
+      cursor = this.requireVersion(documentId, cursor).parentId;
+    }
+
+    cursor = theirsHeadId;
+    while (cursor) {
+      if (oursAncestors.has(cursor)) return cursor;
+      cursor = this.requireVersion(documentId, cursor).parentId;
+    }
+    return undefined;
+  }
+}
