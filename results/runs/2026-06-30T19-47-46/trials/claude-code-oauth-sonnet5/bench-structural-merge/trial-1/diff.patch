index 0000000..73f3f03
--- /dev/null
+++ b/src/merge.ts
@@ -0,0 +1,66 @@
+import type { Conflict } from './types.js';
+import { deepEqual, isPlainObject } from './utils.js';
+
+interface ValueMergeResult {
+  value: unknown;
+  conflicts: Conflict[];
+}
+
+/**
+ * Recursively three-way merges a single value (object subtree or leaf).
+ * Both `ours` and `theirs` are walked together; `base` may be missing
+ * (e.g. a brand-new field, or a document with no common ancestor) in
+ * which case it's treated as undefined for comparison purposes.
+ */
+function mergeValue(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  documentId: string,
+  path: string,
+): ValueMergeResult {
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? base : {};
+    const keys = new Set<string>([...Object.keys(ours), ...Object.keys(theirs), ...Object.keys(baseObj)]);
+
+    const merged: Record<string, unknown> = {};
+    const conflicts: Conflict[] = [];
+
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const result = mergeValue(baseObj[key], ours[key], theirs[key], documentId, childPath);
+      if (result.value !== undefined) {
+        merged[key] = result.value;
+      }
+      conflicts.push(...result.conflicts);
+    }
+
+    return { value: merged, conflicts };
+  }
+
+  // Leaf-level (or type-mismatched) comparison.
+  if (deepEqual(ours, theirs)) {
+    return { value: ours, conflicts: [] };
+  }
+  if (deepEqual(ours, base)) {
+    return { value: theirs, conflicts: [] };
+  }
+  if (deepEqual(theirs, base)) {
+    return { value: ours, conflicts: [] };
+  }
+
+  return {
+    value: ours,
+    conflicts: [{ documentId, path, base, ours, theirs }],
+  };
+}
+
+export function mergeDocumentContent(
+  base: object,
+  ours: object,
+  theirs: object,
+  documentId: string,
+): { merged: object; conflicts: Conflict[] } {
+  const result = mergeValue(base, ours, theirs, documentId, '');
+  return { merged: result.value as object, conflicts: result.conflicts };
+}
