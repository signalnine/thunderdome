@@ -0,0 +1,84 @@
+import { EventBus } from '../bus.js';
+import {
+  AnalyticsService,
+  CartUpdatedEvent,
+  Events,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+const TRACKED_EVENTS = [
+  Events.PRODUCT_CREATED,
+  Events.INVENTORY_UPDATED,
+  Events.LOW_STOCK_ALERT,
+  Events.CART_UPDATED,
+  Events.PRICE_CALCULATED,
+  Events.ORDER_CREATED,
+  Events.ORDER_STATUS_CHANGED,
+  Events.PAYMENT_PROCESSED,
+  Events.NOTIFICATION_SENT,
+];
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const carts = new Set<string>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  let orderCount = 0;
+  let revenue = 0;
+
+  for (const event of TRACKED_EVENTS) {
+    bus.on(event, (payload) => {
+      eventCounts.set(event, (eventCounts.get(event) ?? 0) + 1);
+      void bus.emit(Events.ANALYTICS_EVENT, { event, data: payload as Record<string, unknown>, timestamp: Date.now() });
+    });
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const { cartId, items } = payload as CartUpdatedEvent;
+    carts.add(cartId);
+    cartItems.set(cartId, items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, cartId, total } = payload as OrderCreatedEvent;
+    orderCount += 1;
+    orderTotals.set(orderId, total);
+    const items = cartItems.get(cartId);
+    if (items) {
+      for (const item of items) {
+        productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+      }
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    if (status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(orderId) ?? 0;
+    }
+  });
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      return carts.size === 0 ? 0 : orderCount / carts.size;
+    },
+
+    getTopProducts(limit) {
+      return Array.from(productCounts.entries())
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
