--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,59 @@
+import { Request, Response, NextFunction } from 'express';
+import jwt from 'jsonwebtoken';
+import { unauthorized } from './errors';
+
+export const JWT_SECRET: string = process.env.JWT_SECRET || 'bench-analytics-dashboard-secret';
+export const JWT_EXPIRES_IN = '24h';
+
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+}
+
+export interface JwtPayload {
+  sub: string;
+  tid: string;
+}
+
+export function signToken(userId: string, tenantId: string): string {
+  return jwt.sign({ sub: userId, tid: tenantId }, JWT_SECRET, { expiresIn: JWT_EXPIRES_IN });
+}
+
+// Reads the auth context that was attached to the request by the auth middleware
+// (or by a test's mock auth). Throws if the request is not authenticated.
+export function getAuth(req: Request): AuthUser {
+  const user = (req as Request & { user?: AuthUser }).user;
+  if (!user || !user.id || !user.tenantId) {
+    throw unauthorized('Not authenticated');
+  }
+  return user;
+}
+
+// Routes that do not require authentication.
+const PUBLIC_ROUTES: Array<{ method: string; path: string }> = [
+  { method: 'POST', path: '/users' },
+  { method: 'POST', path: '/users/login' },
+];
+
+export function authMiddleware(req: Request, _res: Response, next: NextFunction): void {
+  if (PUBLIC_ROUTES.some((r) => r.method === req.method && r.path === req.path)) {
+    next();
+    return;
+  }
+
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    throw unauthorized('Missing or malformed Authorization header');
+  }
+
+  const token = header.slice('Bearer '.length).trim();
+  let decoded: JwtPayload;
+  try {
+    decoded = jwt.verify(token, JWT_SECRET) as JwtPayload;
+  } catch {
+    throw unauthorized('Invalid or expired token');
+  }
+
+  (req as Request & { user?: AuthUser }).user = { id: decoded.sub, tenantId: decoded.tid };
+  next();
+}
