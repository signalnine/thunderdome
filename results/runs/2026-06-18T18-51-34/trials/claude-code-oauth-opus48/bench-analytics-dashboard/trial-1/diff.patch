@@ -0,0 +1,94 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { getAuth } from '../auth';
+import { badRequest, notFound } from '../errors';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+const CSV_COLUMNS: Array<keyof EventRow> = [
+  'id',
+  'tenant_id',
+  'name',
+  'properties',
+  'timestamp',
+  'user_id',
+  'session_id',
+];
+
+function csvEscape(value: unknown): string {
+  const str = value === null || value === undefined ? '' : String(value);
+  if (/[",\n\r]/.test(str)) {
+    return `"${str.replace(/"/g, '""')}"`;
+  }
+  return str;
+}
+
+function toCsv(rows: EventRow[]): string {
+  const lines = [CSV_COLUMNS.join(',')];
+  for (const row of rows) {
+    lines.push(CSV_COLUMNS.map((col) => csvEscape(row[col])).join(','));
+  }
+  return lines.join('\n');
+}
+
+const router = Router();
+
+// GET /export/events?format=csv|json
+router.get('/events', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const format = typeof req.query.format === 'string' ? req.query.format : 'json';
+  if (format !== 'csv' && format !== 'json') {
+    throw badRequest('format must be csv or json');
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+    .all(auth.tenantId) as EventRow[];
+
+  if (format === 'csv') {
+    res.status(200).type('text/csv').send(toCsv(rows));
+    return;
+  }
+
+  res.status(200).json(
+    rows.map((row) => ({
+      ...row,
+      properties: JSON.parse(row.properties),
+    }))
+  );
+});
+
+// GET /export/dashboard/:id
+router.get('/dashboard/:id', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const db = getDb();
+
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, auth.tenantId) as
+    | { id: string; config: string; [key: string]: unknown }
+    | undefined;
+  if (!dashboard) {
+    throw notFound('Dashboard not found');
+  }
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as Array<{ config: string; [key: string]: unknown }>;
+
+  res.status(200).json({
+    dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },
+    widgets: widgets.map((w) => ({ ...w, config: JSON.parse(w.config) })),
+  });
+});
+
+export default router;
