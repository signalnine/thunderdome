+++ b/src/ingest/router.ts
@@ -0,0 +1,113 @@
+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { getAuth } from '../auth';
+import { badRequest } from '../errors';
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface EventInput {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  user_id?: unknown;
+  session_id?: unknown;
+}
+
+function serialize(row: EventRow): Record<string, unknown> {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function buildRow(input: EventInput, tenantId: string): EventRow {
+  if (typeof input.name !== 'string' || input.name.length === 0) {
+    throw badRequest('Event name is required');
+  }
+  const properties =
+    input.properties && typeof input.properties === 'object' ? input.properties : {};
+  const timestamp =
+    typeof input.timestamp === 'string' && input.timestamp.length > 0
+      ? input.timestamp
+      : new Date().toISOString();
+
+  return {
+    id: uuidv4(),
+    tenant_id: tenantId,
+    name: input.name,
+    properties: JSON.stringify(properties),
+    timestamp,
+    user_id: typeof input.user_id === 'string' ? input.user_id : null,
+    session_id: typeof input.session_id === 'string' ? input.session_id : null,
+  };
+}
+
+const router = Router();
+
+const insertSql =
+  'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)';
+
+// POST /events - ingest a single event
+router.post('/', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const db = getDb();
+  const row = buildRow(req.body ?? {}, auth.tenantId);
+
+  db.prepare(insertSql).run(
+    row.id,
+    row.tenant_id,
+    row.name,
+    row.properties,
+    row.timestamp,
+    row.user_id,
+    row.session_id
+  );
+
+  res.status(201).json(serialize(row));
+});
+
+// POST /events/batch - ingest multiple events
+router.post('/batch', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const { events } = req.body ?? {};
+  if (!Array.isArray(events) || events.length === 0) {
+    throw badRequest('events must be a non-empty array');
+  }
+
+  const db = getDb();
+  const rows = events.map((e: EventInput) => buildRow(e, auth.tenantId));
+
+  const stmt = db.prepare(insertSql);
+  const insertAll = db.transaction((items: EventRow[]) => {
+    for (const row of items) {
+      stmt.run(
+        row.id,
+        row.tenant_id,
+        row.name,
+        row.properties,
+        row.timestamp,
+        row.user_id,
+        row.session_id
+      );
+    }
+  });
+  insertAll(rows);
+
+  res.status(201).json({ inserted: rows.length, events: rows.map(serialize) });
+});
+
+export default router;
diff --git a/src/query/router.ts b/src/query/router.ts
new file mode 100644
index 0000000..27ac6c2
--- /dev/null
+++ b/src/query/router.ts
@@ -0,0 +1,169 @@
+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { getAuth } from '../auth';
+import { badRequest } from '../errors';
+
+const router = Router();
+
+// Maps a bucket name to a SQLite strftime format string.
+const BUCKET_FORMATS: Record<string, string> = {
+  hour: '%Y-%m-%dT%H:00:00',
+  day: '%Y-%m-%d',
+  week: '%Y-%W',
+  month: '%Y-%m',
+};
+
+function requireEventName(body: Record<string, unknown>): string {
+  const name = body.event_name;
+  if (typeof name !== 'string' || name.length === 0) {
+    throw badRequest('event_name is required');
+  }
+  return name;
+}
+
+// Builds an optional [start, end] timestamp filter clause + params.
+function timeRange(body: Record<string, unknown>): { clause: string; params: string[] } {
+  const params: string[] = [];
+  let clause = '';
+  if (typeof body.start === 'string') {
+    clause += ' AND timestamp >= ?';
+    params.push(body.start);
+  }
+  if (typeof body.end === 'string') {
+    clause += ' AND timestamp <= ?';
+    params.push(body.end);
+  }
+  return { clause, params };
+}
+
+// POST /query/count
+router.post('/count', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const body = (req.body ?? {}) as Record<string, unknown>;
+  const eventName = requireEventName(body);
+  const { clause, params } = timeRange(body);
+
+  const db = getDb();
+  const row = db
+    .prepare(
+      `SELECT COUNT(*) AS count FROM events WHERE tenant_id = ? AND name = ?${clause}`
+    )
+    .get(auth.tenantId, eventName, ...params) as { count: number };
+
+  res.status(200).json({ count: row.count });
+});
+
+// POST /query/timeseries
+router.post('/timeseries', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const body = (req.body ?? {}) as Record<string, unknown>;
+  const eventName = requireEventName(body);
+  const bucket = typeof body.bucket === 'string' ? body.bucket : 'day';
+  const format = BUCKET_FORMATS[bucket];
+  if (!format) {
+    throw badRequest('bucket must be one of hour, day, week, month');
+  }
+  const { clause, params } = timeRange(body);
+
+  const db = getDb();
+  const rows = db
+    .prepare(
+      `SELECT strftime('${format}', timestamp) AS bucket, COUNT(*) AS count
+       FROM events
+       WHERE tenant_id = ? AND name = ?${clause}
+       GROUP BY bucket
+       ORDER BY bucket ASC`
+    )
+    .all(auth.tenantId, eventName, ...params) as Array<{ bucket: string; count: number }>;
+
+  res.status(200).json({ bucket, data: rows });
+});
+
+// POST /query/breakdown
+router.post('/breakdown', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const body = (req.body ?? {}) as Record<string, unknown>;
+  const eventName = requireEventName(body);
+  const propertyKey = body.property_key;
+  if (typeof propertyKey !== 'string' || propertyKey.length === 0) {
+    throw badRequest('property_key is required');
+  }
+  const { clause, params } = timeRange(body);
+
+  const db = getDb();
+  const rows = db
+    .prepare(
+      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count
+       FROM events
+       WHERE tenant_id = ? AND name = ?${clause}
+       GROUP BY property_value
+       ORDER BY count DESC`
+    )
+    .all(`$.${propertyKey}`, auth.tenantId, eventName, ...params) as Array<{
+    property_value: string | null;
+    count: number;
+  }>;
+
+  res.status(200).json({ property_key: propertyKey, data: rows });
+});
+
+// POST /query/funnel
+router.post('/funnel', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const body = (req.body ?? {}) as Record<string, unknown>;
+  const steps = body.steps;
+  if (!Array.isArray(steps) || steps.length === 0 || !steps.every((s) => typeof s === 'string')) {
+    throw badRequest('steps must be a non-empty array of event names');
+  }
+  const stepNames = steps as string[];
+
+  const db = getDb();
+  const placeholders = stepNames.map(() => '?').join(', ');
+  const rows = db
+    .prepare(
+      `SELECT session_id, user_id, name, timestamp
+       FROM events
+       WHERE tenant_id = ? AND name IN (${placeholders})
+       ORDER BY timestamp ASC`
+    )
+    .all(auth.tenantId, ...stepNames) as Array<{
+    session_id: string | null;
+    user_id: string | null;
+    name: string;
+    timestamp: string;
+  }>;
+
+  // Group events by an entity (session, falling back to user) preserving order.
+  // Events with neither a session nor a user are each treated as their own entity.
+  const grouped = new Map<string, string[]>();
+  let anonCounter = 0;
+  for (const row of rows) {
+    const key = row.session_id ?? row.user_id ?? `__anon_${anonCounter++}`;
+    const list = grouped.get(key);
+    if (list) {
+      list.push(row.name);
+    } else {
+      grouped.set(key, [row.name]);
+    }
+  }
+
+  // For each entity, walk the steps greedily and record how far it progressed.
+  const counts = new Array<number>(stepNames.length).fill(0);
+  for (const names of grouped.values()) {
+    let stepIdx = 0;
+    for (const name of names) {
+      if (stepIdx < stepNames.length && name === stepNames[stepIdx]) {
+        stepIdx += 1;
+      }
+    }
+    for (let i = 0; i < stepIdx; i += 1) {
+      counts[i] += 1;
+    }
+  }
+
+  res.status(200).json({
+    steps: stepNames.map((name, i) => ({ step: name, count: counts[i] })),
+  });
+});
+
+export default router;
