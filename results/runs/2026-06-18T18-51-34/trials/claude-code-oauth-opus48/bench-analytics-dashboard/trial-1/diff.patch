ry/funnel\nrouter.post('/funnel', (req: Request, res: Response) => {\n  const auth = getAuth(req);\n  const body = (req.body ?? {}) as Record<string, unknown>;\n  const steps = body.steps;\n  if (!Array.isArray(steps) || steps.length === 0 || !steps.every((s) => typeof s === 'string')) {\n    throw badRequest('steps must be a non-empty array of event names');\n  }\n  const stepNames = steps as string[];\n\n  const db = getDb();\n  const placeholders = stepNames.map(() => '?').join(', ');\n  const rows = db\n    .prepare(\n      `SELECT session_id, user_id, name, timestamp\n       FROM events\n       WHERE tenant_id = ? AND name IN (${placeholders})\n       ORDER BY timestamp ASC`\n    )\n    .all(auth.tenantId, ...stepNames) as Array<{\n    session_id: string | null;\n    user_id: string | null;\n    name: string;\n    timestamp: string;\n  }>;\n\n  // Group events by an entity (session, falling back to user) preserving order.\n  const grouped = new Map<string, string[]>();\n  for (const row of rows) {\n    const key = row.session_id ?? row.user_id ?? row.id_fallback();\n    const list = grouped.get(key);\n    if (list) {\n      list.push(row.name);\n    } else {\n      grouped.set(key, [row.name]);\n    }\n  }\n\n  // For each entity, walk the steps greedily and record how far it progressed.\n  const counts = new Array<number>(stepNames.length).fill(0);\n  for (const names of grouped.values()) {\n    let stepIdx = 0;\n    for (const name of names) {\n      if (stepIdx < stepNames.length && name === stepNames[stepIdx]) {\n        stepIdx += 1;\n      }\n    }\n    for (let i = 0; i < stepIdx; i += 1) {\n      counts[i] += 1;\n    }\n  }\n\n  res.status(200).json({\n    steps: stepNames.map((name, i) => ({ step: name, count: counts[i] })),\n  });\n});\n\nexport default router;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
