@@ -0,0 +1,123 @@
+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import crypto from 'node:crypto';
+import { getDb } from '../db';
+import { getAuth, signToken } from '../auth';
+import { badRequest, conflict, notFound, forbidden, unauthorized } from '../errors';
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+function hashPassword(password: string): string {
+  const salt = crypto.randomBytes(16).toString('hex');
+  const derived = crypto.scryptSync(password, salt, 64).toString('hex');
+  return `${salt}:${derived}`;
+}
+
+function verifyPassword(password: string, stored: string): boolean {
+  const [salt, hash] = stored.split(':');
+  if (!salt || !hash) {
+    return false;
+  }
+  const derived = crypto.scryptSync(password, salt, 64).toString('hex');
+  const a = Buffer.from(hash, 'hex');
+  const b = Buffer.from(derived, 'hex');
+  return a.length === b.length && crypto.timingSafeEqual(a, b);
+}
+
+function publicUser(row: UserRow): Omit<UserRow, 'password_hash'> {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+const router = Router();
+
+// POST /users - register a new user
+router.post('/', (req: Request, res: Response) => {
+  const { email, password, tenant_id } = req.body ?? {};
+  if (typeof email !== 'string' || typeof password !== 'string' || typeof tenant_id !== 'string') {
+    throw badRequest('email, password and tenant_id are required');
+  }
+
+  const db = getDb();
+  const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+  if (existing) {
+    throw conflict('A user with this email already exists');
+  }
+
+  const id = uuidv4();
+  db.prepare(
+    'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+  ).run(id, email, hashPassword(password), tenant_id, 'viewer');
+
+  const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+  res.status(201).json(publicUser(row));
+});
+
+// POST /users/login - authenticate and return a JWT
+router.post('/login', (req: Request, res: Response) => {
+  const { email, password } = req.body ?? {};
+  if (typeof email !== 'string' || typeof password !== 'string') {
+    throw badRequest('email and password are required');
+  }
+
+  const db = getDb();
+  const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;
+  if (!row || !verifyPassword(password, row.password_hash)) {
+    throw unauthorized('Invalid credentials');
+  }
+
+  const token = signToken(row.id, row.tenant_id);
+  res.status(200).json({ token, user: publicUser(row) });
+});
+
+// GET /users/me - current user profile
+router.get('/me', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const db = getDb();
+  const row = db.prepare('SELECT * FROM users WHERE id = ?').get(auth.id) as UserRow | undefined;
+  if (!row) {
+    throw notFound('User not found');
+  }
+  res.status(200).json(publicUser(row));
+});
+
+// PATCH /users/:id/role - change a user's role (admin only)
+router.patch('/:id/role', (req: Request, res: Response) => {
+  const auth = getAuth(req);
+  const db = getDb();
+
+  const actor = db.prepare('SELECT * FROM users WHERE id = ?').get(auth.id) as UserRow | undefined;
+  if (!actor || actor.role !== 'admin') {
+    throw forbidden('Only admins can change user roles');
+  }
+
+  const { role } = req.body ?? {};
+  if (role !== 'admin' && role !== 'viewer' && role !== 'editor') {
+    throw badRequest('role must be one of admin, viewer, editor');
+  }
+
+  const target = db
+    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, auth.tenantId) as UserRow | undefined;
+  if (!target) {
+    throw notFound('User not found');
+  }
+
+  db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+  const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;
+  res.status(200).json(publicUser(updated));
+});
+
+export default router;
