@@ -0,0 +1,35 @@
+import Database from 'better-sqlite3';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+let currentDb: Database.Database | null = null;
+
+function loadSchema(db: Database.Database): void {
+  const schema = readFileSync(join(process.cwd(), 'schema.sql'), 'utf-8');
+  db.exec(schema);
+}
+
+export function createTestDb(): Database.Database {
+  const db = new Database(':memory:');
+  db.pragma('foreign_keys = ON');
+  loadSchema(db);
+  return db;
+}
+
+export function setDb(db: Database.Database): void {
+  currentDb = db;
+}
+
+export function getDb(): Database.Database {
+  if (!currentDb) {
+    throw new Error('Database has not been initialized. Call setDb() first.');
+  }
+  return currentDb;
+}
+
+export function closeDb(): void {
+  if (currentDb) {
+    currentDb.close();
+    currentDb = null;
+  }
+}
