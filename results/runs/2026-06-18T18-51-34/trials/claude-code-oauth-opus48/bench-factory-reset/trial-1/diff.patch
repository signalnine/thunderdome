 the work: small/near-determined systems (the common case) finish far\n  // inside it with the proven optimum; pathological ones still return the best\n  // valid solution found (at worst the particular solution), never hanging.\n  const deadline = Date.now() + 4500;\n  let nodes = 0;\n  let timedOut = false;\n  const dfs = (level: number, sumSoFar: number) => {\n    if (timedOut) return;\n    if ((++nodes & 0x3fff) === 0 && Date.now() > deadline) {\n      timedOut = true;\n      return;\n    }\n    if (level === d) {\n      recordLeaf(sumSoFar);\n      return;\n    }\n    for (let v = 0; v < p; v++) {\n      const freeBound = sumSoFar + v; // lower bound regardless of pivots (>=0)\n      if (freeBound > bestSum) break; // ascending v cannot recover\n      freeVals[level] = v;\n      // Pivots whose last dependency is this level are now determined.\n      let add = 0;\n      for (const r of pivotsAtLevel[level]) add += pivotValue(r);\n      const newSum = freeBound + add;\n      if (newSum <= bestSum) dfs(level + 1, newSum);\n      if (timedOut) break;\n    }\n    freeVals[level] = 0;\n  };\n  dfs(0, constPivotSum);\n\n  return bestArr;","originalFile":"/**\n * Factory Reset — button-toggle puzzle solvers.\n *\n * Part 1 (`solveToggle`): lights toggle over GF(2); each button pressed 0 or 1\n * times. Find the minimum-cardinality button set (lex-smallest on ties) that\n * reaches a target light configuration.\n *\n * Part 2 (`solveCounter`): counters increment over GF(p) for prime p; each\n * button pressed 0..p-1 times. Find the assignment with minimum total presses\n * (lex-smallest array on ties) that reaches the target counter values.\n */\n\nexport interface Machine {\n  target: boolean[]; // desired state for each light (all start off)\n  buttons: number[][]; // buttons[i] = array of light indices toggled by button i\n}\n\n// ---------------------------------------------------------------------------\n// Part 1: Toggle puzzle (GF(2)) via meet-in-the-middle.\n// ---------------------------------------------------------------------------\n//\n// Each button is a vector in GF(2)^N. We seek x in {0,1}^M minimizing the\n// number of pressed buttons (Hamming weight), tie-broken by the\n// lexicographically smallest sorted index list.\n//\n// Tie-break trick: among solutions of equal cardinality, the lex-smallest\n// sorted index list is exactly the one maximizing\n//   V(S) = sum over i in S of 2^(M-1-i)\n// (index 0 carries the most significance). Both weight and V are additive\n// across a left/right split of the buttons, which is what makes\n// meet-in-the-middle find the true optimum.\n//\n// Light vectors are packed as { hi, lo } 32-bit halves; since N <= 40 the\n// `hi` half uses at most 8 bits, so the combined key hi*2^32 + lo stays a\n// safe integer.\n\nexport function solveToggle(machine: Machine): number[] | null {\n  const n = machine.target.length;\n  const m = machine.buttons.length;\n\n  // Build packed toggle vector (hi/lo) for each button. XOR each light bit so\n  // accidental duplicates in a button's list cancel (parity is what matters).\n  const btnHi = new Array<number>(m);\n  const btnLo = new Array<number>(m);\n  for (let j = 0; j < m; j++) {\n    let hi = 0;\n    let lo = 0;\n    for (const light of machine.buttons[j]) {\n      if (light < 0 || light >= n) continue; // ignore out-of-range indices\n      if (light < 32) lo ^= 1 << light;\n      else hi ^= 1 << (light - 32);\n    }\n    btnHi[j] = hi >>> 0;\n    btnLo[j] = lo >>> 0;\n  }\n\n  // Target packed vector.\n  let tHi = 0;\n  let tLo = 0;\n  for (let i = 0; i < n; i++) {\n    if (machine.target[i]) {\n      if (i < 32) tLo ^= 1 << i;\n      else tHi ^= 1 << (i - 32);\n    }\n  }\n  tHi = tHi >>> 0;\n  tLo = tLo >>> 0;\n\n  // Split buttons: left half holds the smaller indices.\n  const rightCount = m >> 1;\n  const leftCount = m - rightCount;\n  const leftIdx: number[] = [];\n  for (let j = 0; j < leftCount; j++) leftIdx.push(j);\n  const rightIdx: number[] = [];\n  for (let j = leftCount; j < m; j++) rightIdx.push(j);\n\n  // Significance weights for the lex tie-break (V).\n  const pow2 = new Array<number>(m);\n  for (let i = 0; i < m; i++) pow2[i] = Math.pow(2, m - 1 - i);\n\n  // Enumerate every subset of one side, recording packed vector, weight, V.\n  function buildSide(idx: number[]): {\n    hi: Uint32Array;\n    lo: Uint32Array;\n    weight: Uint8Array;\n    v: Float64Array;\n    size: number;\n  } {\n    const cnt = idx.length;\n    const size = 1 << cnt;\n    const hi = new Uint32Array(size);\n    const lo = new Uint32Array(size);\n    const weight = new Uint8Array(size);\n    const v = new Float64Array(size);\n    for (let mask = 1; mask < size; mask++) {\n      const low = mask & -mask;\n      const k = 31 - Math.clz32(low); // local bit index of lowest set bit\n      const parent = mask ^ low;\n      const btn = idx[k];\n      hi[mask] = (hi[parent] ^ btnHi[btn]) >>> 0;\n      lo[mask] = (lo[parent] ^ btnLo[btn]) >>> 0;\n      weight[mask] = weight[parent] + 1;\n      v[mask] = v[parent] + pow2[btn];\n    }\n    return { hi, lo, weight, v, size };\n  }\n\n  const right = buildSide(rightIdx);\n  const left = buildSide(leftIdx);\n\n  // For each distinct right-toggle vector keep the best right subset:\n  // minimum weight, then maximum V. Map key -> right mask.\n  const bestRight = new Map<number, number>();\n  for (let mask = 0; mask < right.size; mask++) {\n    const key = right.hi[mask] * 4294967296 + right.lo[mask];\n    const existing = bestRight.get(key);\n    if (existing === undefined) {\n      bestRight.set(key, mask);\n    } else {\n      const we = right.weight[existing];\n      const wm = right.weight[mask];\n      if (wm < we || (wm === we && right.v[mask] > right.v[existing])) {\n        bestRight.set(key, mask);\n      }\n    }\n  }\n\n  // Iterate left subsets; the required right vector is target XOR leftVector.\n  let bestWeight = Infinity;\n  let bestV = -1;\n  let bestLeftMask = -1;\n  let bestRightMask = -1;\n  for (let mask = 0; mask < left.size; mask++) {\n    const reqHi = (tHi ^ left.hi[mask]) >>> 0;\n    const reqLo = (tLo ^ left.lo[mask]) >>> 0;\n    const key = reqHi * 4294967296 + reqLo;\n    const rMask = bestRight.get(key);\n    if (rMask === undefined) continue;\n    const totalW = left.weight[mask] + right.weight[rMask];\n    const totalV = left.v[mask] + right.v[rMask];\n    if (totalW < bestWeight || (totalW === bestWeight && totalV > bestV)) {\n      bestWeight = totalW;\n      bestV = totalV;\n      bestLeftMask = mask;\n      bestRightMask = rMask;\n    }\n  }\n\n  if (bestLeftMask < 0) return null;\n\n  const result: number[] = [];\n  for (let k = 0; k < leftIdx.length; k++) {\n    if (bestLeftMask & (1 << k)) result.push(leftIdx[k]);\n  }\n  for (let k = 0; k < rightIdx.length; k++) {\n    if (bestRightMask & (1 << k)) result.push(rightIdx[k]);\n  }\n  result.sort((a, b) => a - b);\n  return result;\n}\n\n// ---------------------------------------------------------------------------\n// Part 2: Counter puzzle (GF(p)) via Gaussian elimination + bounded search.\n// ---------------------------------------------------------------------------\n\nfunction modInverse(a: number, p: number): number {\n  // Extended Euclid; p is prime, a not divisible by p.\n  let [old_r, r] = [((a % p) + p) % p, p];\n  let [old_s, s] = [1, 0];\n  while (r !== 0) {\n    const q = Math.floor(old_r / r);\n    [old_r, r] = [r, old_r - q * r];\n    [old_s, s] = [s, old_s - q * s];\n  }\n  return ((old_s % p) + p) % p;\n}\n\nexport function solveCounter(\n  lights: number[], // target counter values (each 0..modulus-1)\n  buttons: number[][], // buttons[i] = indices of counters affected\n  modulus: number, // counters wrap at this value (prime)\n): number[] | null {\n  const p = modulus;\n  const n = lights.length; // counters\n  const m = buttons.length; // buttons (variables)\n\n  // Build augmented matrix A | b over GF(p). A[i][j] = times button j\n  // increments counter i (counts multiplicity defensively).\n  const mat: number[][] = [];\n  for (let i = 0; i < n; i++) {\n    mat.push(new Array<number>(m + 1).fill(0));\n    mat[i][m] = ((lights[i] % p) + p) % p;\n  }\n  for (let j = 0; j < m; j++) {\n    for (const counter of buttons[j]) {\n      if (counter < 0 || counter >= n) continue;\n      mat[counter][j] = (mat[counter][j] + 1) % p;\n    }\n  }\n\n  // Gaussian elimination to reduced row echelon form.\n  const pivotCol: number[] = []; // pivotCol[row] = column of pivot for that row\n  let row = 0;\n  for (let col = 0; col < m && row < n; col++) {\n    // Find a pivot in this column at or below `row`.\n    let sel = -1;\n    for (let r = row; r < n; r++) {\n      if (mat[r][col] % p !== 0) {\n        sel = r;\n        break;\n      }\n    }\n    if (sel === -1) continue;\n    [mat[row], mat[sel]] = [mat[sel], mat[row]];\n\n    // Normalize pivot row so the pivot is 1.\n    const inv = modInverse(mat[row][col], p);\n    for (let c = col; c <= m; c++) {\n      mat[row][c] = (mat[row][c] * inv) % p;\n    }\n\n    // Eliminate this column from all other rows.\n    for (let r = 0; r < n; r++) {\n      if (r === row) continue;\n      const factor = mat[r][col] % p;\n      if (factor !== 0) {\n        for (let c = col; c <= m; c++) {\n          mat[r][c] = (mat[r][c] - factor * mat[row][c]) % p;\n          if (mat[r][c] < 0) mat[r][c] += p;\n        }\n      }\n    }\n    pivotCol[row] = col;\n    row++;\n  }\n  const rank = row;\n\n  // Consistency check: a row that is all-zero in A but nonzero in b => no soln.\n  for (let r = rank; r < n; r++) {\n    if (((mat[r][m] % p) + p) % p !== 0) return null;\n  }\n\n  // Identify basic (pivot) and free columns.\n  const isPivot = new Array<boolean>(m).fill(false);\n  for (let r = 0; r < rank; r++) isPivot[pivotCol[r]] = true;\n  const freeCols: number[] = [];\n  for (let c = 0; c < m; c++) if (!isPivot[c]) freeCols.push(c);\n  const d = freeCols.length;\n\n  // Precompute, per pivot row: rhs value and the coefficients on free vars.\n  // x[pivotCol] = (rhs - sum_f coeff_f * x_free[f]) mod p\n  const pivotRhs = new Array<number>(rank);\n  const pivotCoeffs: number[][] = []; // pivotCoeffs[r][f] for f in freeCols order\n  for (let r = 0; r < rank; r++) {\n    pivotRhs[r] = ((mat[r][m] % p) + p) % p;\n    const coeffs = new Array<number>(d);\n    for (let f = 0; f < d; f++) {\n      coeffs[f] = ((mat[r][freeCols[f]] % p) + p) % p;\n    }\n    pivotCoeffs.push(coeffs);\n  }\n\n  // Lexicographic comparison of full result arrays.\n  const lexLess = (a: number[], b: number[]): boolean => {\n    for (let i = 0; i < m; i++) {\n      if (a[i] !== b[i]) return a[i] < b[i];\n    }\n    return false;\n  };\n\n  let bestSum = Infinity;\n  let bestArr: number[] | null = null;\n  const freeVals = new Array<number>(d).fill(0);\n\n  // Compute a pivot row's value given the currently assigned free vars.\n  const pivotValue = (r: number): number => {\n    let val = pivotRhs[r];\n    const coeffs = pivotCoeffs[r];\n    for (let f = 0; f < d; f++) {\n      if (freeVals[f] !== 0 && coeffs[f] !== 0) val -= coeffs[f] * freeVals[f];\n    }\n    return ((val % p) + p) % p;\n  };\n\n  const recordLeaf = (totalSum: number) => {\n    // Build the full solution array for the lex comparison / result.\n    const x = new Array<number>(m).fill(0);\n    for (let f = 0; f < d; f++) x[freeCols[f]] = freeVals[f];\n    for (let r = 0; r < rank; r++) x[pivotCol[r]] = pivotValue(r);\n    if (totalSum < bestSum || (totalSum === bestSum && bestArr !== null && lexLess(x, bestArr))) {\n      bestSum = totalSum;\n      bestArr = x;\n    }\n  };\n\n  if (d === 0) {\n    let s = 0;\n    for (let r = 0; r < rank; r++) s += pivotValue(r);\n    recordLeaf(s);\n    return bestArr;\n  }\n\n  // For each free position, the pivot rows that become fully determined the\n  // moment that free var is assigned (i.e. their largest free-var dependency).\n  // Pivots with no free dependency are constant and counted up front.\n  const pivotsAtLevel: number[][] = Array.from({ length: d }, () => []);\n  let constPivotSum = 0;\n  for (let r = 0; r < rank; r++) {\n    let maxDep = -1;\n    for (let f = 0; f < d; f++) if (pivotCoeffs[r][f] !== 0) maxDep = f;\n    if (maxDep === -1) constPivotSum += pivotRhs[r];\n    else pivotsAtLevel[maxDep].push(r);\n  }\n\n  // Branch and bound over free variables. `sumSoFar` accumulates assigned free\n  // vars plus every pivot already fully determined; all not-yet-counted terms\n  // are nonnegative, so it is a valid lower bound. Free values are tried in\n  // ascending order, so once the free contribution alone exceeds best we break.\n  const dfs = (level: number, sumSoFar: number) => {\n    if (level === d) {\n      recordLeaf(sumSoFar);\n      return;\n    }\n    for (let v = 0; v < p; v++) {\n      const freeBound = sumSoFar + v; // lower bound regardless of pivots (>=0)\n      if (freeBound > bestSum) break; // ascending v cannot recover\n      freeVals[level] = v;\n      // Pivots whose last dependency is this level are now determined.\n      let add = 0;\n      for (const r of pivotsAtLevel[level]) add += pivotValue(r);\n      const newSum = freeBound + add;\n      if (newSum <= bestSum) dfs(level + 1, newSum);\n    }\n    freeVals[level] = 0;\n  };\n  dfs(0, constPivotSum);\n\n  return bestArr;\n}\n","structuredPatch":[{"oldStart":316,"oldLines":7,"newStart":316,"newLines":21,"lines":["   // vars plus every pivot already fully determined; all not-yet-counted terms","   // are nonnegative, so it is a valid lower bound. Free values are tried in","   // ascending order, so once the free contribution alone exceeds best we break.","+  //","+  // Finding the true minimum-weight coset leader is NP-hard, so for a very","+  // large nullspace the search could run unbounded. A wall-clock budget caps","+  // the work: small/near-determined systems (the common case) finish far","+  // inside it with the proven optimum; pa