+import { describe, it, expect } from 'vitest';
+import { solveToggle, solveCounter, Machine } from './index.js';
+
+// ---- helpers ----------------------------------------------------------------
+
+function applyToggle(machine: Machine, presses: number[]): boolean[] {
+  const state = new Array<boolean>(machine.target.length).fill(false);
+  for (const b of presses) {
+    for (const light of machine.buttons[b]) state[light] = !state[light];
+  }
+  return state;
+}
+
+function eqBool(a: boolean[], b: boolean[]): boolean {
+  return a.length === b.length && a.every((v, i) => v === b[i]);
+}
+
+// Brute-force reference for toggle: returns min-weight, lex-smallest set.
+function bruteToggle(machine: Machine): number[] | null {
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << m; mask++) {
+    const presses: number[] = [];
+    for (let j = 0; j < m; j++) if (mask & (1 << j)) presses.push(j);
+    if (eqBool(applyToggle(machine, presses), machine.target)) {
+      if (best === null || presses.length < best.length) best = presses;
+      else if (presses.length === best.length) {
+        // lex compare sorted lists
+        for (let i = 0; i < presses.length; i++) {
+          if (presses[i] !== best[i]) {
+            if (presses[i] < best[i]) best = presses;
+            break;
+          }
+        }
+      }
+    }
+  }
+  return best;
+}
+
+function applyCounter(buttons: number[][], presses: number[], n: number, p: number): number[] {
+  const c = new Array<number>(n).fill(0);
+  for (let j = 0; j < buttons.length; j++) {
+    for (const counter of buttons[j]) c[counter] = (c[counter] + presses[j]) % p;
+  }
+  return c;
+}
+
+// Brute force reference for counter: min total presses, lex-smallest array.
+function bruteCounter(lights: number[], buttons: number[][], p: number): number[] | null {
+  const m = buttons.length;
+  const n = lights.length;
+  let best: number[] | null = null;
+  let bestSum = Infinity;
+  const cur = new Array<number>(m).fill(0);
+  const rec = (j: number) => {
+    if (j === m) {
+      const res = applyCounter(buttons, cur, n, p);
+      if (res.every((v, i) => v === ((lights[i] % p) + p) % p)) {
+        const s = cur.reduce((a, b) => a + b, 0);
+        if (s < bestSum) {
+          bestSum = s;
+          best = cur.slice();
+        } else if (s === bestSum && best) {
+          for (let i = 0; i < m; i++) {
+            if (cur[i] !== best[i]) {
+              if (cur[i] < best[i]) best = cur.slice();
+              break;
+            }
+          }
+        }
+      }
+      return;
+    }
+    for (let v = 0; v < p; v++) {
+      cur[j] = v;
+      rec(j + 1);
+    }
+    cur[j] = 0;
+  };
+  rec(0);
+  return best;
+}
+
+// Deterministic PRNG for reproducible random tests.
+function makeRng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (s * 1664525 + 1013904223) >>> 0;
+    return s / 4294967296;
+  };
+}
+
+// ---- Part 1: solveToggle ----------------------------------------------------
+
+describe('solveToggle', () => {
+  it('returns null for the unsatisfiable spec example', () => {
+    const machine: Machine = {
+      target: [true, true, false, true],
+      buttons: [
+        [0, 1],
+        [1, 2, 3],
+        [0, 3],
+      ],
+    };
+    expect(solveToggle(machine)).toBeNull();
+  });
+
+  it('handles empty target (press nothing)', () => {
+    const machine: Machine = { target: [false, false, false], buttons: [[0], [1, 2]] };
+    expect(solveToggle(machine)).toEqual([]);
+  });
+
+  it('finds a simple single-button solution', () => {
+    const machine: Machine = {
+      target: [true, true, false],
+      buttons: [[0, 1], [2], [0]],
+    };
+    const r = solveToggle(machine)!;
+    expect(eqBool(applyToggle(machine, r), machine.target)).toBe(true);
+    expect(r).toEqual([0]);
+  });
+
+  it('prefers fewer presses', () => {
+    // target light0 on. button0 = {0}; button1+button2 also achieve it but cost 2.
+    const machine: Machine = {
+      target: [true, false],
+      buttons: [[0], [0, 1], [1]],
+    };
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+
+  it('breaks ties lexicographically', () => {
+    // Two distinct single... construct equal-weight choices.
+    // light0 toggled by buttons 0 and 1 identically; both weight 1.
+    const machine: Machine = {
+      target: [true],
+      buttons: [[0], [0]],
+    };
+    expect(solveToggle(machine)).toEqual([0]);
+  });
+
+  it('lex tie-break favors small leading index over small trailing', () => {
+    // target = light0 & light1 on.
+    // {0,3} sets via b0={0},b3={1}; {1,2} via b1={0},b2={1}; both weight 2.
+    // lex smallest is [0,3].
+    const machine: Machine = {
+      target: [true, true],
+      buttons: [[0], [0], [1], [1]],
+    };
+    expect(solveToggle(machine)).toEqual([0, 2]);
+  });
+
+  it('matches brute force on random small instances', () => {
+    const rng = makeRng(42);
+    for (let t = 0; t < 200; t++) {
+      const n = 1 + Math.floor(rng() * 6);
+      const m = 1 + Math.floor(rng() * 12);
+      const target: boolean[] = [];
+      for (let i = 0; i < n; i++) target.push(rng() < 0.5);
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const set: number[] = [];
+        for (let i = 0; i < n; i++) if (rng() < 0.5) set.push(i);
+        buttons.push(set);
+      }
+      const machine: Machine = { target, buttons };
+      const got = solveToggle(machine);
+      const exp = bruteToggle(machine);
+      expect(got).toEqual(exp);
+      if (got) expect(eqBool(applyToggle(machine, got), target)).toBe(true);
+    }
+  });
+
+  it('handles lights beyond bit 32 (40 lights)', () => {
+    const n = 40;
+    const target = new Array<boolean>(n).fill(false);
+    target[39] = true;
+    target[33] = true;
+    const buttons: number[][] = [[39], [33], [0, 39]];
+    const r = solveToggle({ target, buttons })!;
+    expect(eqBool(applyToggle({ target, buttons }, r), target)).toBe(true);
+    expect(r).toEqual([0, 1]); // press [39] and [33]; the [0,39] button would add light 0
+  });
+});
+
+// ---- Part 2: solveCounter ---------------------------------------------------
+
+describe('solveCounter', () => {
+  it('solves a unique full-rank system', () => {
+    // 2 counters, 2 buttons, mod 5.
+    // b0 -> c0; b1 -> c1. target [3,2] => [3,2].
+    const r = solveCounter([3, 2], [[0], [1]], 5)!;
+    expect(r).toEqual([3, 2]);
+  });
+
+  it('returns null when inconsistent', () => {
+    // counter0 affected by no button but target nonzero.
+    expect(solveCounter([1, 0], [[1]], 5)).toBeNull();
+  });
+
+  it('minimizes total presses over a coset', () => {
+    // mod 5, c0 = b0 + b1. target c0 = 1.
+    // solutions: (1,0),(0,1),(2,4),... min sum=1, lex smallest [0,1]?
+    // [1,0] sum1, [0,1] sum1 -> lex smallest is [0,1].
+    const r = solveCounter([1], [[0], [0]], 5)!;
+    expect(r).toEqual([0, 1]);
+  });
+
+  it('wraps correctly (mod choice can reduce sum)', () => {
+    // mod 3: c0 = 2*b0 (b0 affects c0 twice via two entries? use buttons[0]=[0,0])
+    // Simpler: c0 = b0, target 2 => [2].
+    expect(solveCounter([2], [[0]], 3)).toEqual([2]);
+  });
+
+  it('matches brute force on random small instances', () => {
+    const primes = [2, 3, 5, 7];
+    const rng = makeRng(7);
+    for (let t = 0; t < 150; t++) {
+      const p = primes[Math.floor(rng() * primes.length)];
+      const n = 1 + Math.floor(rng() * 3);
+      const m = 1 + Math.floor(rng() * 4);
+      const lights: number[] = [];
+      for (let i = 0; i < n; i++) lights.push(Math.floor(rng() * p));
+      const buttons: number[][] = [];
+      for (let j = 0; j < m; j++) {
+        const set: number[] = [];
+        for (let i = 0; i < n; i++) if (rng() < 0.5) set.push(i);
+        buttons.push(set);
+      }
+      const got = solveCounter(lights, buttons, p);
+      const exp = bruteCounter(lights, buttons, p);
+      expect(got).toEqual(exp);
+      if (got) {
+        const res = applyCounter(buttons, got, n, p);
+        expect(res).toEqual(lights.map((v) => ((v % p) + p) % p));
+      }
+    }
+  });
+});
+
+// ---- Performance ------------------------------------------------------------
+
+describe('performance', () => {
+  it('solveToggle handles 40 buttons / 40 lights quickly', () => {
+    const rng = makeRng(123);
+    const n = 40;
+    const m = 40;
+    // Construct a solvable instance: pick a random pressed set, derive target.
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const set: number[] = [];
+      for (let i = 0; i < n; i++) if (rng() < 0.3) set.push(i);
+      buttons.push(set);
+    }
+    const pressed: number[] = [];
+    for (let j = 0; j < m; j++) if (rng() < 0.4) pressed.push(j);
+    const target = new Array<boolean>(n).fill(false);
+    for (const b of pressed) for (const l of buttons[b]) target[l] = !target[l];
+
+    const start = Date.now();
+    const r = solveToggle({ target, buttons });
+    const elapsed = Date.now() - start;
+    expect(r).not.toBeNull();
+    expect(eqBool(applyToggle({ target, buttons }, r!), target)).toBe(true);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('solveCounter handles 40/40 full-rank mod 97 quickly', () => {
+    const rng = makeRng(999);
+    const n = 40;
+    const m = 40;
+    const p = 97;
+    const buttons: number[][] = [];
+    for (let j = 0; j < m; j++) {
+      const set: number[] = [];
+      for (let i = 0; i < n; i++) if (rng() < 0.5) set.push(i);
+      buttons.push(set);
+    }
+    const presses: number[] = [];
+    for (let j = 0; j < m; j++) presses.push(Math.floor(rng() * p));
+    const lights = applyCounter(buttons, presses, n, p);
+
+    const start = Date.now();
+    const r = solveCounter(lights, buttons, p);
+    const elapsed = Date.now() - start;
+    expect(r).not.toBeNull();
+    expect(applyCounter(buttons, r!, n, p)).toEqual(lights);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
