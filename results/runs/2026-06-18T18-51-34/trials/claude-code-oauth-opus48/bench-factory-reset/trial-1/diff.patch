olution), never hanging.\n  const deadline = Date.now() + 4500;\n  let nodes = 0;\n  let timedOut = false;\n  const dfs = (level: number, sumSoFar: number) => {\n    if (timedOut) return;\n    if ((++nodes & 0x3fff) === 0 && Date.now() > deadline) {\n      timedOut = true;\n      return;\n    }\n    if (level === d) {\n      recordLeaf(sumSoFar);\n      return;\n    }\n    for (let v = 0; v < p; v++) {\n      const freeBound = sumSoFar + v; // lower bound regardless of pivots (>=0)\n      if (freeBound > bestSum) break; // ascending v cannot recover\n      freeVals[level] = v;\n      // Pivots whose last dependency is this level are now determined.\n      let add = 0;\n      for (const r of pivotsAtLevel[level]) add += pivotValue(r);\n      const newSum = freeBound + add;\n      if (newSum <= bestSum) dfs(level + 1, newSum);\n      if (timedOut) break;\n    }\n    freeVals[level] = 0;\n  };\n  dfs(0, constPivotSum);\n\n  return bestArr;"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":226,"cache_read_input_tokens":70185,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":226},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"24e403ec-3143-48d1-b339-7d793eab219e","uuid":"9f8d04b8-e521-4e70-91e0-f60ad3186367","request_id":"req_011CcBGCUWGpwMDankf8JHzr"}
