onst lines: string[] = []\n108   for (let i = 0; i < items.length; ++i) {\n109     const item = items[i]\n110     let comment: string | null = null\n111     if (item instanceof Pair) {\n112       const ik = item.key\n113       if (ik.spaceBefore) lines.push('')\n114       addCommentBefore(ctx, lines, ik.commentBefore, false)\n115       if (ik.comment) reqNewline = true\n116 \n117       const iv = item.value\n118       if (iv) {\n119         if (iv.comment) comment = iv.comment\n120         if (iv.commentBefore) reqNewline = true\n121       } else if (ik?.comment) {\n122         comment = ik.comment\n123       }\n124     } else if (item) {\n125       if (item.spaceBefore) lines.push('')\n126       addCommentBefore(ctx, lines, item.commentBefore, false)\n127       if (item.comment) comment = item.comment\n128     }\n129 \n130     if (comment) reqNewline = true\n131     let str = stringify(item, itemCtx, () => (comment = null))\n132     if (i < items.length - 1) str += ','          // <-- COMMA ADDED HERE\n133     if (comment) str += lineComment(str, itemIndent, commentString(comment))\n134     if (!reqNewline && (lines.length > linesAtValue || str.includes('\\n')))\n135       reqNewline = true\n136     lines.push(str)\n137     linesAtValue = lines.length\n138   }\n139 \n140   const { start, end } = flowChars\n141   if (lines.length === 0) {\n142     return start + end\n143   } else {\n144     if (!reqNewline) {\n145       const len = lines.reduce((sum, line) => sum + line.length + 2, 2)\n146       reqNewline = ctx.options.lineWidth > 0 && len > ctx.options.lineWidth\n147     }\n148     if (reqNewline) {\n149       let str = start\n150       for (const line of lines)\n151         str += line ? `\\n${indentStep}${indent}${line}` : '\\n'\n152       return `${str}\\n${indent}${end}`\n153     } else {\n153       return `${start}${fcPadding}${lines.join(' ')}${fcPadding}${end}`\n154     }\n155   }\n156 }\n```\n\n**Key points:**\n- **Line 132**: Comma is unconditionally adde