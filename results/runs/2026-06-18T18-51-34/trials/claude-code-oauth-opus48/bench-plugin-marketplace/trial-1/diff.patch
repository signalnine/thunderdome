diff --git a/src/deps/index.ts b/src/deps/index.ts
new file mode 100644
index 0000000..17d5ab7
--- /dev/null
+++ b/src/deps/index.ts
@@ -0,0 +1,120 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+const MAX_DEPTH = 100;
+
+function depNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  if (!manifest) {
+    return [];
+  }
+  return Object.keys(manifest.dependencies);
+}
+
+export function createDepsService(): DepsService {
+  function buildTree(
+    name: string,
+    registry: RegistryService,
+    visiting: Set<string> = new Set(),
+    depth = 0
+  ): DependencyNode {
+    const manifest = registry.get(name);
+    const version = manifest ? manifest.version : '0.0.0';
+
+    if (depth >= MAX_DEPTH || visiting.has(name)) {
+      return { name, version, dependencies: [] };
+    }
+
+    const nextVisiting = new Set(visiting);
+    nextVisiting.add(name);
+
+    const dependencies = depNames(name, registry).map((dep) =>
+      buildTree(dep, registry, nextVisiting, depth + 1)
+    );
+
+    return { name, version, dependencies };
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const stack: string[] = [];
+    const onStack = new Set<string>();
+    const visited = new Set<string>();
+
+    function dfs(node: string): void {
+      if (onStack.has(node)) {
+        const start = stack.indexOf(node);
+        cycles.push([...stack.slice(start), node]);
+        return;
+      }
+      if (visited.has(node)) {
+        return;
+      }
+      visited.add(node);
+      onStack.add(node);
+      stack.push(node);
+      for (const dep of depNames(node, registry)) {
+        dfs(dep);
+      }
+      stack.pop();
+      onStack.delete(node);
+    }
+
+    dfs(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+    const onStack = new Set<string>();
+
+    function visit(node: string): void {
+      if (visited.has(node)) {
+        return;
+      }
+      if (onStack.has(node)) {
+        throw new Error(`Circular dependency detected at "${node}"`);
+      }
+      onStack.add(node);
+      for (const dep of depNames(node, registry)) {
+        visit(dep);
+      }
+      onStack.delete(node);
+      visited.add(node);
+      result.push(node);
+    }
+
+    visit(name);
+    return result;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const seen = new Set<string>();
+
+    function visit(node: string): void {
+      for (const dep of depNames(node, registry)) {
+        if (!seen.has(dep)) {
+          seen.add(dep);
+          result.push(dep);
+          visit(dep);
+        }
+      }
+    }
+
+    visit(name);
+    return result;
+  }
+
+  function hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  return {
+    buildTree: (name, registry) => buildTree(name, registry),
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..9cece52
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,81 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+  PluginManifest,
+  ResolvedVersion,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+
+export interface InstallResult {
+  resolved: ResolvedVersion[];
+  sandboxResult: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+function validateManifest(manifest: PluginManifest): void {
+  if (!manifest || !manifest.name || !manifest.version || !manifest.entryPoint) {
+    throw new Error('Invalid manifest: name, version, and entryPoint are required');
+  }
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem();
+  const deps = createDepsService();
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+
+    async installPlugin(manifest: PluginManifest): Promise<InstallResult> {
+      // 1. Validate manifest
+      validateManifest(manifest);
+
+      // 2. Register the plugin
+      registry.register(manifest);
+
+      // 3. Resolve dependency versions from registry
+      const constraints: VersionConstraint[] = Object.entries(manifest.dependencies).map(
+        ([name, range]) => ({ name, range })
+      );
+      const available: Record<string, string[]> = {};
+      for (const constraint of constraints) {
+        available[constraint.name] = registry.listVersions(constraint.name);
+      }
+      const resolved = resolver.resolve(constraints, available);
+
+      // 4. Check for circular dependencies
+      if (deps.hasCircularDependency(manifest.name, registry)) {
+        throw new Error(`Circular dependency detected for "${manifest.name}"`);
+      }
+
+      // 5. Execute entry point in sandbox
+      const sandboxResult = await runner.execute(manifest.entryPoint);
+
+      // 6. Return resolved versions and sandbox result
+      return { resolved, sandboxResult };
+    },
+  };
+}
diff --git a/src/registry/index.ts b/src/registry/index.ts
new file mode 100644
index 0000000..a3b0375
--- /dev/null
+++ b/src/registry/index.ts
@@ -0,0 +1,123 @@
+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+  rowid: number;
+}
+
+function rowToManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entryPoint,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    );
+  `);
+
+  return {
+    register(manifest: PluginManifest): void {
+      db.prepare(
+        `INSERT OR REPLACE INTO plugins
+         (name, version, description, author, dependencies, entryPoint, permissions)
+         VALUES (?, ?, ?, ?, ?, ?, ?)`
+      ).run(
+        manifest.name,
+        manifest.version,
+        manifest.description,
+        manifest.author,
+        JSON.stringify(manifest.dependencies),
+        manifest.entryPoint,
+        JSON.stringify(manifest.permissions)
+      );
+    },
+
+    get(name: string): PluginManifest | null {
+      const row = db
+        .prepare('SELECT rowid, * FROM plugins WHERE name = ? ORDER BY rowid DESC LIMIT 1')
+        .get(name) as PluginRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = db
+        .prepare('SELECT rowid, * FROM plugins WHERE name = ? AND version = ?')
+        .get(name, version) as PluginRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    list(): PluginManifest[] {
+      const rows = db.prepare('SELECT rowid, * FROM plugins ORDER BY rowid ASC').all() as PluginRow[];
+      return rows.map(rowToManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const like = `%${query}%`;
+      const rows = db
+        .prepare(
+          'SELECT rowid, * FROM plugins WHERE name LIKE ? OR description LIKE ? ORDER BY rowid ASC'
+        )
+        .all(like, like) as PluginRow[];
+      return rows.map(rowToManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const info = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?').run(name, version);
+      return info.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = db
+        .prepare('SELECT version FROM plugins WHERE name = ? ORDER BY rowid ASC')
+        .all(name) as { version: string }[];
+      return rows.map((r) => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const existing = db
+        .prepare('SELECT rowid, * FROM plugins WHERE name = ? AND version = ?')
+        .get(name, version) as PluginRow | undefined;
+      if (!existing) {
+        return;
+      }
+      const merged: PluginManifest = { ...rowToManifest(existing), ...updates };
+      db.prepare(
+        `UPDATE plugins SET
+           description = ?, author = ?, dependencies = ?, entryPoint = ?, permissions = ?
+         WHERE name = ? AND version = ?`
+      ).run(
+        merged.description,
+        merged.author,
+        JSON.stringify(merged.dependencies),
+        merged.entryPoint,
+        JSON.stringify(merged.permissions),
+        name,
+        version
+      );
+    },
+  };
+}
diff --git a/src/resolver/index.ts b/src/resolver/index.ts
new file mode 100644
index 0000000..2866594
--- /dev/null
+++ b/src/resolver/index.ts
@@ -0,0 +1,38 @@
+import semver from 'semver';
+import type { ResolverService, VersionConstraint, ResolvedVersion } from '../types.js';
+
+export function createResolver(): ResolverService {
+  return {
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>
+    ): ResolvedVersion[] {
+      return constraints.map((constraint) => {
+        const versions = available[constraint.name] ?? [];
+        const best = semver.maxSatisfying(versions, constraint.range);
+        if (!best) {
+          throw new Error(
+            `Cannot resolve "${constraint.name}" with constraint "${constraint.range}"`
+          );
+        }
+        return {
+          name: constraint.name,
+          version: best,
+          satisfies: constraint.range,
+        };
+      });
+    },
+
+    satisfies(version: string, range: string): boolean {
+      return semver.satisfies(version, range);
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      return semver.maxSatisfying(versions, range);
+    },
+
+    validRange(range: string): boolean {
+      return semver.validRange(range) !== null;
+    },
+  };
+}
diff --git a/src/reviews/index.ts b/src/reviews/index.ts
new file mode 100644
index 0000000..80b88bf
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,118 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    );
+  `);
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      const info = db
+        .prepare(
+          `INSERT INTO reviews
+           (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+           VALUES (?, ?, ?, ?, ?, 0, ?)`
+        )
+        .run(
+          review.pluginName,
+          review.pluginVersion,
+          review.userId,
+          review.rating,
+          review.comment,
+          createdAt
+        );
+      return {
+        id: Number(info.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = db
+        .prepare('SELECT * FROM reviews WHERE pluginName = ? ORDER BY id ASC')
+        .all(pluginName) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = db
+        .prepare(
+          'SELECT AVG(rating) AS avg FROM reviews WHERE pluginName = ? AND flagged = 0'
+        )
+        .get(pluginName) as { avg: number | null };
+      return row.avg ?? 0;
+    },
+
+    flagReview(reviewId: number): void {
+      db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = db
+        .prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id ASC')
+        .all() as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const info = db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+      return info.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = db
+        .prepare('SELECT * FROM reviews WHERE userId = ? ORDER BY id ASC')
+        .all(userId) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = db
+        .prepare('SELECT COUNT(*) AS count FROM reviews WHERE pluginName = ?')
+        .get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
