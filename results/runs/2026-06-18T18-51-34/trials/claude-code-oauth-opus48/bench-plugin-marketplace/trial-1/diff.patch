@@ -0,0 +1,53 @@
+import vm from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+function run(
+  code: string,
+  timeoutMs: number,
+  context: Record<string, unknown>
+): SandboxResult {
+  const sandbox: Record<string, unknown> = { ...context };
+  const vmContext = vm.createContext(sandbox);
+  const wrapped = `(function () {\n${code}\n})();`;
+
+  const start = Date.now();
+  const memBefore = process.memoryUsage().heapUsed;
+  try {
+    const script = new vm.Script(wrapped);
+    const output = script.runInContext(vmContext, { timeout: timeoutMs });
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: true,
+      output,
+      duration: Date.now() - start,
+      memoryUsed: Math.max(0, memAfter - memBefore),
+    };
+  } catch (err) {
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: false,
+      output: undefined,
+      duration: Date.now() - start,
+      memoryUsed: Math.max(0, memAfter - memBefore),
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      return run(code, timeoutMs, context);
+    },
+  };
+}
