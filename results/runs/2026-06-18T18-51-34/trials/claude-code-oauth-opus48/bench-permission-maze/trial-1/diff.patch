@@ -0,0 +1,496 @@
+import express, { type Request, type Response, type NextFunction } from 'express';
+import { randomUUID } from 'node:crypto';
+
+// ---------------------------------------------------------------------------
+// Domain types
+// ---------------------------------------------------------------------------
+
+export type Role = 'viewer' | 'editor' | 'owner';
+export type ResourceType = 'folder' | 'document';
+
+const ROLE_RANK: Record<Role, number> = { viewer: 1, editor: 2, owner: 3 };
+
+interface User {
+  id: string;
+  username: string;
+  password: string;
+}
+
+interface Folder {
+  id: string;
+  name: string;
+  parentId: string | null;
+  ownerId: string;
+  createdAt: string;
+}
+
+interface Document {
+  id: string;
+  title: string;
+  content: string;
+  folderId: string;
+  ownerId: string;
+  createdAt: string;
+}
+
+// share key -> map of userId -> role
+interface Shares {
+  folder: Map<string, Map<string, Role>>;
+  document: Map<string, Map<string, Role>>;
+}
+
+interface ActivityEntry {
+  id: string;
+  action: string;
+  userId: string;
+  resourceType: ResourceType | null;
+  resourceId: string | null;
+  timestamp: string;
+}
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+function meets(role: Role | null, required: Role): boolean {
+  return role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+// Augment Express request with the authenticated user id.
+interface AuthRequest extends Request {
+  userId?: string;
+}
+
+export function createApp() {
+  const app = express();
+  app.use(express.json());
+
+  // -------------------------------------------------------------------------
+  // In-memory storage
+  // -------------------------------------------------------------------------
+  const users = new Map<string, User>();
+  const usersByName = new Map<string, User>();
+  const tokens = new Map<string, string>(); // token -> userId
+  const folders = new Map<string, Folder>();
+  const documents = new Map<string, Document>();
+  const shares: Shares = { folder: new Map(), document: new Map() };
+  const activity: ActivityEntry[] = [];
+
+  function log(
+    action: string,
+    userId: string,
+    resourceType: ResourceType | null,
+    resourceId: string | null,
+  ): void {
+    activity.push({
+      id: randomUUID(),
+      action,
+      userId,
+      resourceType,
+      resourceId,
+      timestamp: new Date().toISOString(),
+    });
+  }
+
+  // -------------------------------------------------------------------------
+  // Permission resolution
+  // -------------------------------------------------------------------------
+
+  // Effective role on a folder, walking up the ancestor chain and taking the
+  // most permissive role granted along the way (direct share or ownership).
+  function folderRole(userId: string, folderId: string | null): Role | null {
+    let role: Role | null = null;
+    const seen = new Set<string>();
+    let current = folderId;
+    while (current && !seen.has(current)) {
+      seen.add(current);
+      const folder = folders.get(current);
+      if (!folder) break;
+      if (folder.ownerId === userId) role = maxRole(role, 'owner');
+      const direct = shares.folder.get(current)?.get(userId) ?? null;
+      role = maxRole(role, direct);
+      current = folder.parentId;
+    }
+    return role;
+  }
+
+  // Effective role on a document: ownership + direct shares + inherited folder
+  // role (which itself includes the ancestor chain). Most permissive wins.
+  function documentRole(userId: string, docId: string): Role | null {
+    const doc = documents.get(docId);
+    if (!doc) return null;
+    let role: Role | null = null;
+    if (doc.ownerId === userId) role = maxRole(role, 'owner');
+    const direct = shares.document.get(docId)?.get(userId) ?? null;
+    role = maxRole(role, direct);
+    role = maxRole(role, folderRole(userId, doc.folderId));
+    return role;
+  }
+
+  function effectiveRole(
+    userId: string,
+    type: ResourceType,
+    id: string,
+  ): Role | null {
+    return type === 'folder' ? folderRole(userId, id) : documentRole(userId, id);
+  }
+
+  // -------------------------------------------------------------------------
+  // Auth middleware
+  // -------------------------------------------------------------------------
+  function authenticate(req: AuthRequest, res: Response, next: NextFunction): void {
+    const header = req.headers.authorization ?? '';
+    const match = header.match(/^Bearer\s+(.+)$/i);
+    if (!match) {
+      res.status(401).json({ error: 'Missing or malformed Authorization header' });
+      return;
+    }
+    const userId = tokens.get(match[1]);
+    if (!userId) {
+      res.status(401).json({ error: 'Invalid token' });
+      return;
+    }
+    req.userId = userId;
+    next();
+  }
+
+  // -------------------------------------------------------------------------
+  // Auth routes
+  // -------------------------------------------------------------------------
+  app.post('/auth/register', (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string' || !username || !password) {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    if (usersByName.has(username)) {
+      res.status(409).json({ error: 'username already taken' });
+      return;
+    }
+    const user: User = { id: randomUUID(), username, password };
+    users.set(user.id, user);
+    usersByName.set(username, user);
+    res.status(201).json({ id: user.id, username: user.username });
+  });
+
+  app.post('/auth/login', (req: Request, res: Response) => {
+    const { username, password } = req.body ?? {};
+    if (typeof username !== 'string' || typeof password !== 'string') {
+      res.status(400).json({ error: 'username and password are required' });
+      return;
+    }
+    const user = usersByName.get(username);
+    if (!user || user.password !== password) {
+      res.status(401).json({ error: 'Invalid credentials' });
+      return;
+    }
+    const token = randomUUID();
+    tokens.set(token, user.id);
+    res.status(200).json({ token, userId: user.id });
+  });
+
+  // All routes below require authentication.
+  app.use(authenticate);
+
+  // -------------------------------------------------------------------------
+  // Folder routes
+  // -------------------------------------------------------------------------
+  app.post('/folders', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const { name, parentId } = req.body ?? {};
+    if (typeof name !== 'string' || !name) {
+      res.status(400).json({ error: 'name is required' });
+      return;
+    }
+    if (parentId !== undefined && parentId !== null) {
+      if (typeof parentId !== 'string' || !folders.has(parentId)) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      if (!meets(folderRole(userId, parentId), 'editor')) {
+        res.status(403).json({ error: 'forbidden' });
+        return;
+      }
+    }
+    const folder: Folder = {
+      id: randomUUID(),
+      name,
+      parentId: parentId ?? null,
+      ownerId: userId,
+      createdAt: new Date().toISOString(),
+    };
+    folders.set(folder.id, folder);
+    log('folder.create', userId, 'folder', folder.id);
+    res.status(201).json(folder);
+  });
+
+  app.get('/folders/:id', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const folder = folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!meets(folderRole(userId, folder.id), 'viewer')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    res.status(200).json(folder);
+  });
+
+  app.put('/folders/:id', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const folder = folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!meets(folderRole(userId, folder.id), 'editor')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    const { name, parentId } = req.body ?? {};
+    if (name !== undefined) {
+      if (typeof name !== 'string' || !name) {
+        res.status(400).json({ error: 'name must be a non-empty string' });
+        return;
+      }
+      folder.name = name;
+    }
+    if (parentId !== undefined) {
+      if (parentId !== null && (typeof parentId !== 'string' || !folders.has(parentId))) {
+        res.status(404).json({ error: 'parent folder not found' });
+        return;
+      }
+      // Prevent cycles.
+      if (parentId !== null && wouldCycle(folder.id, parentId)) {
+        res.status(400).json({ error: 'cannot move folder into its own descendant' });
+        return;
+      }
+      folder.parentId = parentId;
+    }
+    log('folder.update', userId, 'folder', folder.id);
+    res.status(200).json(folder);
+  });
+
+  app.delete('/folders/:id', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const folder = folders.get(req.params.id);
+    if (!folder) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!meets(folderRole(userId, folder.id), 'owner')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    // Recursively delete descendant folders and their documents.
+    deleteFolderRecursive(folder.id);
+    log('folder.delete', userId, 'folder', folder.id);
+    res.status(204).end();
+  });
+
+  function wouldCycle(folderId: string, newParentId: string): boolean {
+    const seen = new Set<string>();
+    let current: string | null = newParentId;
+    while (current && !seen.has(current)) {
+      if (current === folderId) return true;
+      seen.add(current);
+      current = folders.get(current)?.parentId ?? null;
+    }
+    return false;
+  }
+
+  function deleteFolderRecursive(folderId: string): void {
+    for (const doc of [...documents.values()]) {
+      if (doc.folderId === folderId) {
+        documents.delete(doc.id);
+        shares.document.delete(doc.id);
+      }
+    }
+    for (const child of [...folders.values()]) {
+      if (child.parentId === folderId) deleteFolderRecursive(child.id);
+    }
+    folders.delete(folderId);
+    shares.folder.delete(folderId);
+  }
+
+  // -------------------------------------------------------------------------
+  // Document routes
+  // -------------------------------------------------------------------------
+  app.post('/documents', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const { title, content, folderId } = req.body ?? {};
+    if (typeof title !== 'string' || !title) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+    if (typeof folderId !== 'string' || !folders.has(folderId)) {
+      res.status(404).json({ error: 'folder not found' });
+      return;
+    }
+    if (!meets(folderRole(userId, folderId), 'editor')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    const doc: Document = {
+      id: randomUUID(),
+      title,
+      content: typeof content === 'string' ? content : '',
+      folderId,
+      ownerId: userId,
+      createdAt: new Date().toISOString(),
+    };
+    documents.set(doc.id, doc);
+    log('document.create', userId, 'document', doc.id);
+    res.status(201).json(doc);
+  });
+
+  app.get('/documents/:id', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const doc = documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!meets(documentRole(userId, doc.id), 'viewer')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    res.status(200).json(doc);
+  });
+
+  app.put('/documents/:id', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const doc = documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!meets(documentRole(userId, doc.id), 'editor')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    const { title, content } = req.body ?? {};
+    if (title !== undefined) {
+      if (typeof title !== 'string' || !title) {
+        res.status(400).json({ error: 'title must be a non-empty string' });
+        return;
+      }
+      doc.title = title;
+    }
+    if (content !== undefined) {
+      if (typeof content !== 'string') {
+        res.status(400).json({ error: 'content must be a string' });
+        return;
+      }
+      doc.content = content;
+    }
+    log('document.update', userId, 'document', doc.id);
+    res.status(200).json(doc);
+  });
+
+  app.delete('/documents/:id', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const doc = documents.get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'document not found' });
+      return;
+    }
+    if (!meets(documentRole(userId, doc.id), 'owner')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    documents.delete(doc.id);
+    shares.document.delete(doc.id);
+    log('document.delete', userId, 'document', doc.id);
+    res.status(204).end();
+  });
+
+  // -------------------------------------------------------------------------
+  // Sharing
+  // -------------------------------------------------------------------------
+  function normalizeType(raw: string): ResourceType | null {
+    if (raw === 'folders' || raw === 'folder') return 'folder';
+    if (raw === 'documents' || raw === 'document') return 'document';
+    return null;
+  }
+
+  function resourceExists(type: ResourceType, id: string): boolean {
+    return type === 'folder' ? folders.has(id) : documents.has(id);
+  }
+
+  app.post('/:resourceType/:id/share', (req: AuthRequest, res: Response) => {
+    const userId = req.userId!;
+    const type = normalizeType(req.params.resourceType);
+    if (!type) {
+      res.status(404).json({ error: 'unknown resource type' });
+      return;
+    }
+    const id = req.params.id;
+    if (!resourceExists(type, id)) {
+      res.status(404).json({ error: 'resource not found' });
+      return;
+    }
+    const { role } = req.body ?? {};
+    let targetUserId: string | undefined = req.body?.userId;
+    const targetUsername: string | undefined = req.body?.username;
+    if (!targetUserId && typeof targetUsername === 'string') {
+      targetUserId = usersByName.get(targetUsername)?.id;
+    }
+    if (!targetUserId || !users.has(targetUserId)) {
+      res.status(404).json({ error: 'target user not found' });
+      return;
+    }
+    if (role !== 'viewer' && role !== 'editor' && role !== 'owner') {
+      res.status(400).json({ error: 'role must be viewer, editor, or owner' });
+      return;
+    }
+    const actorRole = effectiveRole(userId, type, id);
+    // Editors may share, but assigning the owner role (role management) is
+    // reserved for owners.
+    if (role === 'owner') {
+      if (!meets(actorRole, 'owner')) {
+        res.status(403).json({ error: 'only an owner can grant the owner role' });
+        return;
+      }
+    } else if (!meets(actorRole, 'editor')) {
+      res.status(403).json({ error: 'forbidden' });
+      return;
+    }
+    const table = shares[type];
+    if (!table.has(id)) table.set(id, new Map());
+    table.get(id)!.set(targetUserId, role);
+    log('share', userId, type, id);
+    res.status(200).json({ resourceType: type, resourceId: id, userId: targetUserId, role });
+  });
+
+  // -------------------------------------------------------------------------
+  // Activity log
+  // -------------------------------------------------------------------------
+  app.get('/activity', (_req: AuthRequest, res: Response) => {
+    res.status(200).json(activity);
+  });
+
+  // -------------------------------------------------------------------------
+  // Fallbacks
+  // -------------------------------------------------------------------------
+  app.use((_req: Request, res: Response) => {
+    res.status(404).json({ error: 'not found' });
+  });
+
+  // Centralized error handler (e.g. malformed JSON bodies).
+  app.use((err: unknown, _req: Request, res: Response, _next: NextFunction) => {
+    res.status(400).json({ error: 'bad request', detail: String(err) });
+  });
+
+  return app;
+}
+
+export default createApp;
