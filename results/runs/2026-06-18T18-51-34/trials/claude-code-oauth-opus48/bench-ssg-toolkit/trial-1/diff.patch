+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,42 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+/**
+ * asset-pipeline: rewrites relative asset URLs (`./foo.png`) under `src`/`href`
+ * attributes to absolute `/assets/` paths and records each discovered asset in
+ * a manifest stored at `ctx.data['asset-manifest']`.
+ */
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext): ContentFile => {
+        const found: string[] = [];
+
+        const content = file.content.replace(
+          /(src|href)="\.\/([^"]+)"/g,
+          (_match, attr: string, path: string) => {
+            found.push(path);
+            return `${attr}="/assets/${path}"`;
+          },
+        );
+
+        if (found.length > 0) {
+          const manifest =
+            (ctx.data.get('asset-manifest') as AssetManifest | undefined) ?? {
+              assets: [],
+            };
+          manifest.assets.push(...found);
+          ctx.data.set('asset-manifest', manifest);
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
