+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,67 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface Footnote {
+  id: string;
+  text: string;
+}
+
+function renderMarkdown(src: string): string {
+  return marked.parse(src, { async: false }) as string;
+}
+
+/**
+ * markdown-ext: converts Markdown to HTML with two extensions:
+ *  - footnotes using `[^id]` references and `[^id]: text` definitions
+ *  - admonition containers using `:::type ... :::` fences
+ */
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        let content = file.content;
+
+        // Extract footnote definitions: `[^id]: text` (one per line).
+        const footnotes: Footnote[] = [];
+        content = content.replace(
+          /^\[\^([^\]]+)\]:[ \t]*(.+)$/gm,
+          (_match, id: string, text: string) => {
+            footnotes.push({ id, text: text.trim() });
+            return '';
+          },
+        );
+
+        // Replace footnote references `[^id]` with superscript anchors.
+        content = content.replace(
+          /\[\^([^\]]+)\]/g,
+          (_match, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`,
+        );
+
+        // Convert admonition containers `:::type ... :::` into divs.
+        content = content.replace(
+          /^:::(\w+)[ \t]*\n([\s\S]*?)\n:::[ \t]*$/gm,
+          (_match, type: string, inner: string) => {
+            const innerHtml = renderMarkdown(inner.trim());
+            return `<div class="admonition admonition-${type}">\n${innerHtml}</div>`;
+          },
+        );
+
+        // Render the remaining Markdown to HTML.
+        let html = renderMarkdown(content);
+
+        // Append the footnote section at the bottom of the content.
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('\n');
+          html += `<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..05d12f4
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,56 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function timestamp(date?: string): number {
+  return date ? new Date(date).getTime() : 0;
+}
+
+/**
+ * rss-feed: generates an RSS 2.0 feed at `feed.xml` from the build's content
+ * files. Items are sorted newest-first, carry their (already rendered) HTML
+ * content in a CDATA block, and expose their tags as `<category>` elements.
+ */
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const { config } = ctx;
+
+        const sorted = [...ctx.files].sort(
+          (a, b) => timestamp(b.date) - timestamp(a.date),
+        );
+
+        const items = sorted
+          .map((file: ContentFile) => {
+            const categories = (file.tags ?? [])
+              .map((tag) => `      <category>${tag}</category>`)
+              .join('\n');
+            const pubDate = file.date
+              ? `      <pubDate>${new Date(file.date).toUTCString()}</pubDate>\n`
+              : '';
+            const cats = categories ? `${categories}\n` : '';
+            return `    <item>
+      <title>${file.title}</title>
+      <link>${config.baseUrl}/${file.slug}.html</link>
+${pubDate}${cats}      <description><![CDATA[${file.content}]]></description>
+    </item>`;
+          })
+          .join('\n');
+
+        const feed = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${config.title}</title>
+    <link>${config.baseUrl}</link>
+    <description>${config.title}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', feed);
+      },
+    },
+  };
+}
