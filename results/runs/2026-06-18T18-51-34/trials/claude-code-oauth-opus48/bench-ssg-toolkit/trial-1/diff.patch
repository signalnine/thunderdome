g: ${tag}</h1>\n  <ul class=\"tag-list\">\n${items}\n  </ul>\n</body>\n</html>`;\n          ctx.output.set(`tags/${tag}.html`, html);\n        }\n      },\n    },\n  };\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
