@@ -0,0 +1,26 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+/**
+ * syntax-highlight: augments fenced code blocks that declare a language
+ * (`<pre><code class="language-x">`) by adding a `highlighted` class to the
+ * code element and a `data-language` attribute to the surrounding `pre`.
+ * Code blocks without a language and inline `<code>` are left untouched.
+ */
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const content = file.content.replace(
+          /<pre><code class="language-([^"]+)">([\s\S]*?)<\/code><\/pre>/g,
+          (_match, lang: string, code: string) =>
+            `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`,
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
