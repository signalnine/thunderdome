@@ -0,0 +1,46 @@
+import { randomUUID } from 'crypto';
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events, PaymentProcessedEvent } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const successfulTransactions = new Map<string, { orderId: string; amount: number }>();
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      let result: { status: PaymentStatus; transactionId?: string; error?: string };
+
+      if (options.simulateTimeout) {
+        result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      } else if (options.simulateFailure) {
+        result = { status: PaymentStatus.FAILED, error: 'Payment failed' };
+      } else {
+        const transactionId = randomUUID();
+        successfulTransactions.set(transactionId, { orderId, amount });
+        result = { status: PaymentStatus.SUCCESS, transactionId };
+      }
+
+      const payload: PaymentProcessedEvent = {
+        orderId,
+        status: result.status,
+        transactionId: result.transactionId,
+        error: result.error,
+      };
+      await bus.emit(Events.PAYMENT_PROCESSED, payload);
+
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      if (!successfulTransactions.has(transactionId)) {
+        return false;
+      }
+      successfulTransactions.delete(transactionId);
+      return true;
+    },
+  };
+}
