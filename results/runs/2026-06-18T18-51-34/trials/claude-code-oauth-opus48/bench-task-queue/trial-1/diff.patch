@@ -0,0 +1,558 @@
+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus =
+  | 'pending'
+  | 'processing'
+  | 'completed'
+  | 'failed'
+  | 'cancelled';
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface Task {
+  id: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  queueName: string;
+  lastError?: string;
+  failCount: number;
+  seq: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export type TaskHandler = (task: Task) => Promise<void>;
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+  intervalMs: number;
+  nextRun: number;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface QueueData {
+  pending: Task[];
+  processing: Set<string>;
+  maxConcurrency: number;
+  dlq: Task[];
+  middleware: Middleware[];
+}
+
+interface ShutdownState {
+  resolve: (summary: ShutdownSummary) => void;
+  completed: number;
+  inflight: Set<string>;
+  start: number;
+  timer: ReturnType<typeof setTimeout> | null;
+}
+
+const DEFAULT_QUEUE = 'default';
+
+export class TaskQueue {
+  private queues = new Map<string, QueueData>();
+  private tasks = new Map<string, Task>();
+  private progress = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, Set<ProgressCallback>>();
+  private schedules: Schedule[] = [];
+  private seqCounter = 0;
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownState: ShutdownState | null = null;
+  private shutdownCallbacks: Array<() => void> = [];
+
+  private getQueue(name: string): QueueData {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = {
+        pending: [],
+        processing: new Set(),
+        maxConcurrency: Infinity,
+        dlq: [],
+        middleware: [],
+      };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  // ---- Phase 1 / 2 / 3 / 4 / 5 / 7 ----
+  enqueue(queueName: string, payload?: unknown, options: EnqueueOptions = {}): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue: queue is shutting down');
+    }
+
+    // Backward compatibility: enqueue(payload) on the default queue.
+    if (arguments.length === 1) {
+      payload = queueName as unknown;
+      queueName = DEFAULT_QUEUE;
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const now = Date.now();
+    let availableAt = new Date(now);
+    if (options.delay !== undefined) {
+      availableAt = new Date(now + options.delay);
+    } else if (options.runAt !== undefined) {
+      availableAt = options.runAt;
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    const id = randomUUID();
+
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency on non-existent task: ${depId}`);
+      }
+    }
+    this.assertNoCycle(id, dependsOn);
+
+    const task: Task = {
+      id,
+      payload,
+      status: 'pending',
+      createdAt: new Date(now),
+      priority,
+      availableAt,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      dependsOn,
+      queueName,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasks.set(id, task);
+    this.getQueue(queueName).pending.push(task);
+    return task;
+  }
+
+  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+
+    if (q.processing.size >= q.maxConcurrency) return null;
+
+    const now = Date.now();
+    const eligible = q.pending.filter(
+      (t) =>
+        t.status === 'pending' &&
+        t.availableAt.getTime() <= now &&
+        this.dependenciesSatisfied(t),
+    );
+    if (eligible.length === 0) return null;
+
+    eligible.sort(
+      (a, b) =>
+        a.priority - b.priority ||
+        a.availableAt.getTime() - b.availableAt.getTime() ||
+        a.seq - b.seq,
+    );
+
+    const task = eligible[0];
+    const idx = q.pending.indexOf(task);
+    if (idx !== -1) q.pending.splice(idx, 1);
+
+    task.status = 'processing';
+    task.attempts += 1;
+    q.processing.add(task.id);
+    return task;
+  }
+
+  size(): number {
+    return this.queueSize(DEFAULT_QUEUE);
+  }
+
+  // ---- Phase 2 ----
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  queueSize(queueName: string): number {
+    const q = this.queues.get(queueName);
+    if (!q) return 0;
+    return q.pending.filter((t) => t.status === 'pending').length;
+  }
+
+  // ---- Phase 5 ----
+  fail(taskId: string, error?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.getQueue(task.queueName);
+    q.processing.delete(task.id);
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    if (task.attempts <= task.maxRetries) {
+      // Retry with exponential backoff.
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.availableAt = new Date(Date.now() + backoff);
+      task.status = 'pending';
+      q.pending.push(task);
+    } else {
+      // Exhausted retries -> dead letter queue (Phase 6).
+      task.status = 'failed';
+      q.dlq.push(task);
+    }
+
+    this.maybeResolveShutdown();
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.getQueue(task.queueName);
+    q.processing.delete(task.id);
+    task.status = 'completed';
+
+    this.handleShutdownCompletion(task.id);
+    this.maybeResolveShutdown();
+  }
+
+  // ---- Phase 6: Dead Letter Queue ----
+  getDLQ(queueName: string): Task[] {
+    const q = this.queues.get(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+
+    const q = this.getQueue(task.queueName);
+    const idx = q.dlq.indexOf(task);
+    if (idx === -1) return null;
+    q.dlq.splice(idx, 1);
+
+    // Fresh set of retries.
+    task.attempts = 0;
+    task.failCount = 0;
+    task.status = 'pending';
+    task.availableAt = new Date(Date.now());
+    q.pending.push(task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.queues.get(queueName);
+    if (q) q.dlq = [];
+  }
+
+  // ---- Phase 7: Dependencies ----
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasks.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasks.get(depId)?.status ?? 'pending',
+    }));
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependsOn.every(
+      (depId) => this.tasks.get(depId)?.status === 'completed',
+    );
+  }
+
+  private assertNoCycle(newId: string, dependsOn: string[]): void {
+    // Determine whether adding newId -> dep edges would create a cycle, i.e.
+    // whether any dependency can already reach newId through its own deps.
+    const reaches = (from: string, target: string, seen: Set<string>): boolean => {
+      if (from === target) return true;
+      if (seen.has(from)) return false;
+      seen.add(from);
+      const t = this.tasks.get(from);
+      if (!t) return false;
+      return t.dependsOn.some((d) => reaches(d, target, seen));
+    };
+
+    for (const depId of dependsOn) {
+      if (reaches(depId, newId, new Set())) {
+        throw new Error('Circular dependency detected');
+      }
+    }
+  }
+
+  // ---- Phase 8: Concurrency Control ----
+  setConcurrency(queueName: string, limit: number): void {
+    this.getQueue(queueName).maxConcurrency = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.queues.get(queueName);
+    if (!q) return { current: 0, max: Infinity };
+    return { current: q.processing.size, max: q.maxConcurrency };
+  }
+
+  // ---- Phase 9: Progress and Cancellation ----
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`progress percent must be between 0 and 100, got ${percent}`);
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) cb(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = new Set();
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.add(callback);
+    return () => {
+      callbacks!.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    const q = this.queues.get(task.queueName);
+    if (task.status === 'pending' && q) {
+      const idx = q.pending.indexOf(task);
+      if (idx !== -1) q.pending.splice(idx, 1);
+    } else if (task.status === 'processing' && q) {
+      q.processing.delete(task.id);
+    }
+    task.status = 'cancelled';
+    this.maybeResolveShutdown();
+  }
+
+  // ---- Phase 10: Recurring Tasks (Cron) ----
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const intervalMs = parseCron(cronExpression);
+    const now = Date.now();
+    const schedule: Schedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      intervalMs,
+      nextRun: nextBoundaryAfter(now, intervalMs),
+    };
+    this.schedules.push(schedule);
+    return schedule;
+  }
+
+  unschedule(scheduleId: string): void {
+    const schedule = this.schedules.find((s) => s.id === scheduleId);
+    if (schedule) schedule.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    return this.schedules.filter(
+      (s) => s.active && (queueName === undefined || s.queueName === queueName),
+    );
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const schedule of this.schedules) {
+      if (!schedule.active) continue;
+      if (now >= schedule.nextRun) {
+        this.enqueue(schedule.queueName, schedule.taskTemplate);
+        schedule.nextRun = nextBoundaryAfter(now, schedule.intervalMs);
+      }
+    }
+  }
+
+  // ---- Phase 11: Middleware Pipeline ----
+  use(queueName: string, middleware: Middleware): void {
+    this.getQueue(queueName).middleware.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const q = this.getQueue(queueName);
+    const middleware = q.middleware;
+    let handlerRan = false;
+
+    const dispatch = async (i: number): Promise<void> => {
+      if (i < middleware.length) {
+        await middleware[i](task, () => dispatch(i + 1));
+      } else {
+        handlerRan = true;
+        await handler(task);
+      }
+    };
+
+    try {
+      await dispatch(0);
+      if (handlerRan) this.complete(task.id);
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+    }
+  }
+
+  // ---- Phase 12: Graceful Shutdown ----
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+
+    this.shuttingDown = true;
+    const start = Date.now();
+
+    for (const cb of this.shutdownCallbacks) cb();
+
+    const inflight = new Set<string>();
+    for (const q of this.queues.values()) {
+      for (const id of q.processing) inflight.add(id);
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      if (inflight.size === 0) {
+        resolve({ completed: 0, cancelled: 0, elapsed: Date.now() - start });
+        return;
+      }
+
+      const state: ShutdownState = {
+        resolve,
+        completed: 0,
+        inflight,
+        start,
+        timer: null,
+      };
+      this.shutdownState = state;
+
+      state.timer = setTimeout(() => {
+        const cancelled = state.inflight.size;
+        for (const id of state.inflight) {
+          const task = this.tasks.get(id);
+          if (task) {
+            const q = this.queues.get(task.queueName);
+            if (q) q.processing.delete(id);
+            task.status = 'cancelled';
+          }
+        }
+        state.inflight.clear();
+        this.shutdownState = null;
+        resolve({
+          completed: state.completed,
+          cancelled,
+          elapsed: Date.now() - start,
+        });
+      }, timeout);
+    });
+
+    return this.shutdownPromise;
+  }
+
+  private handleShutdownCompletion(taskId: string): void {
+    const state = this.shutdownState;
+    if (state && state.inflight.has(taskId)) {
+      state.inflight.delete(taskId);
+      state.completed += 1;
+    }
+  }
+
+  private maybeResolveShutdown(): void {
+    const state = this.shutdownState;
+    if (!state) return;
+    if (state.inflight.size === 0) {
+      if (state.timer) clearTimeout(state.timer);
+      this.shutdownState = null;
+      state.resolve({
+        completed: state.completed,
+        cancelled: 0,
+        elapsed: Date.now() - state.start,
+      });
+    }
+  }
+}
+
+function parseCron(expression: string): number {
+  const parts = expression.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Invalid cron expression: ${expression}`);
+  }
+  const [minute, hour, , ,] = parts;
+
+  // */N * * * * -> every N minutes
+  const everyMin = /^\*\/(\d+)$/.exec(minute);
+  if (everyMin && hour === '*') {
+    const n = parseInt(everyMin[1], 10);
+    return n * 60 * 1000;
+  }
+
+  // 0 * * * * -> every hour
+  if (minute === '0' && hour === '*') {
+    return 60 * 60 * 1000;
+  }
+
+  // 0 0 * * * -> every day at midnight
+  if (minute === '0' && hour === '0') {
+    return 24 * 60 * 60 * 1000;
+  }
+
+  throw new Error(`Unsupported cron expression: ${expression}`);
+}
+
+function nextBoundaryAfter(time: number, intervalMs: number): number {
+  return (Math.floor(time / intervalMs) + 1) * intervalMs;
+}
