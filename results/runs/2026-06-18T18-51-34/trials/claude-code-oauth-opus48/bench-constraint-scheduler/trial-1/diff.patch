+{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_01PxxyX2uYxvhqHhEMGrwdFH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YDwdnSkQHnujdWrSFYNjzi","name":"Write","input":{"file_path":"/workspace/src/scheduler.ts","content":"/**\n * Constraint-based event scheduler.\n *\n * Assigns events to rooms within a time window while respecting capacity\n * limits, prerequisite ordering, room gaps, and (soft) room preferences.\n * The scheduler maximizes the number of events placed using a multi-restart\n * greedy strategy: several prerequisite-respecting orderings are tried and the\n * best (most events scheduled) result is kept.\n */\n\nexport interface Event {\n  id: string;\n  name: string;\n  duration: number; // in minutes\n  attendees?: number; // number of people attending (default: 1)\n  prerequisites?: string[]; // event IDs that must finish before this starts\n  preferredRoom?: string; // room ID preference (hint, not hard constraint)\n}\n\nexport interface Room {\n  id: string;\n  name: string;\n  capacity: number; // max attendees\n}\n\nexport interface ScheduleOptions {\n  startTime: number; // minutes from midnight (e.g., 540 = 9:00 AM)\n  endTime: number; // minutes from midnight (e.g., 1020 = 5:00 PM)\n  gap?: number; // minimum gap in minutes between events in same room (default: 15)\n}\n\nexport interface Assignment {\n  eventId: string;\n  roomId: string;\n  startTime: number; // minutes from midnight\n  endTime: number; // minutes from midnight\n}\n\nexport interface ScheduleResult {\n  assignments: Assignment[];\n  unscheduled: string[]; // event IDs that could not be scheduled\n}\n\nconst DEFAULT_GAP = 15;\nconst DEFAULT_ATTENDEES = 1;\n\ninterface Interval {\n  start: number;\n  end: number;\n}\n\n/** Per-room sorted list of occupied intervals. */\ntype RoomState = Map<string, Interval[]>;\n\nfunction attendeesOf(e: Event): number {\n  return e.attendees ?? DEFAULT_ATTENDEES;\n}\n\n/**\n * Detects a cycle (including self-references) in the prerequisite graph.\n * Edges point from a prerequisite to its dependent. Throws on any cycle.\n * Prerequisites referencing non-existent events are ignored here (they make\n * the dependent unschedulable, but are not cycles).\n */\nfunction assertNoCycles(events: Event[]): void {\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n\n  // 0 = unvisited, 1 = in progress (gray), 2 = done (black)\n  const color = new Map<string, number>();\n\n  const visit = (id: string): void => {\n    color.set(id, 1);\n    const event = byId.get(id);\n    if (event && event.prerequisites) {\n      for (const prereqId of event.prerequisites) {\n        if (!byId.has(prereqId)) continue; // missing prereq: not a cycle\n        const state = color.get(prereqId) ?? 0;\n        if (state === 1) {\n          throw new Error(\n            `Prerequisite cycle detected involving event \"${prereqId}\"`,\n          );\n        }\n        if (state === 0) visit(prereqId);\n      }\n    }\n    color.set(id, 2);\n  };\n\n  for (const e of events) {\n    if ((color.get(e.id) ?? 0) === 0) visit(e.id);\n  }\n}\n\n/**\n * Finds the earliest feasible start time for a duration within a room,\n * respecting the existing intervals, the required gap, the earliest allowed\n * start, and the closing time. Returns null if no slot fits.\n */\nfunction findEarliestStart(\n  intervals: Interval[],\n  duration: number,\n  earliest: number,\n  endTime: number,\n  gap: number,\n): number | null {\n  let cand = earliest;\n  for (const iv of intervals) {\n    // Does [cand, cand + duration] fit entirely before this interval?\n    if (cand + duration + gap <= iv.start) break;\n    // Otherwise it overlaps or sits too close; push past this interval.\n    if (cand < iv.end + gap) cand = iv.end + gap;\n  }\n  if (cand + duration <= endTime) return cand;\n  return null;\n}\n\nfunction insertInterval(intervals: Interval[], interval: Interval): void {\n  let i = 0;\n  while (i < intervals.length && intervals[i].start < interval.start) i++;\n  intervals.splice(i, 0, interval);\n}\n\ninterface Placement {\n  roomId: string;\n  start: number;\n}\n\n/**\n * Chooses a room and start time for an event. Honors the preferred room when\n * the event fits there; otherwise picks the room giving the earliest start,\n * breaking ties by smaller capacity (to conserve large rooms) then room order.\n */\nfunction placeEvent(\n  event: Event,\n  rooms: Room[],\n  roomState: RoomState,\n  earliest: number,\n  endTime: number,\n  gap: number,\n): Placement | null {\n  const attendees = attendeesOf(event);\n\n  if (event.preferredRoom !== undefined) {\n    const room = rooms.find((r) => r.id === event.preferredRoom);\n    if (room && room.capacity >= attendees) {\n      const start = findEarliestStart(\n        roomState.get(room.id)!,\n        event.duration,\n        earliest,\n        endTime,\n        gap,\n      );\n      if (start !== null) return { roomId: room.id, start };\n    }\n  }\n\n  let best: { roomId: string; start: number; capacity: number } | null = null;\n  for (const room of rooms) {\n    if (room.capacity < attendees) continue;\n    const start = findEarliestStart(\n      roomState.get(room.id)!,\n      event.duration,\n      earliest,\n      endTime,\n      gap,\n    );\n    if (start === null) continue;\n    if (\n      best === null ||\n      start < best.start ||\n      (start === best.start && room.capacity < best.capacity)\n    ) {\n      best = { roomId: room.id, start, capacity: room.capacity };\n    }\n  }\n  return best ? { roomId: best.roomId, start: best.start } : null;\n}\n\ntype Comparator = (a: Event, b: Event) => number;\n\n/**\n * Produces a prerequisite-respecting (topological) ordering using Kahn's\n * algorithm, selecting among ready events with the given comparator.\n * Only edges to existing prerequisites constrain the order.\n */\nfunction topoOrder(events: Event[], comparator: Comparator): Event[] {\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n\n  const indegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n  for (const e of events) {\n    indegree.set(e.id, 0);\n    dependents.set(e.id, []);\n  }\n  for (const e of events) {\n    for (const p of e.prerequisites ?? []) {\n      if (!byId.has(p)) continue;\n      indegree.set(e.id, (indegree.get(e.id) ?? 0) + 1);\n      dependents.get(p)!.push(e.id);\n    }\n  }\n\n  const ready: Event[] = [];\n  for (const e of events) if ((indegree.get(e.id) ?? 0) === 0) ready.push(e);\n\n  const order: Event[] = [];\n  while (ready.length > 0) {\n    // Select the best ready event per comparator (stable on ties).\n    let bestIdx = 0;\n    for (let i = 1; i < ready.length; i++) {\n      if (comparator(ready[i], ready[bestIdx]) < 0) bestIdx = i;\n    }\n    const next = ready.splice(bestIdx, 1)[0];\n    order.push(next);\n    for (const dep of dependents.get(next.id)!) {\n      const d = (indegree.get(dep) ?? 0) - 1;\n      indegree.set(dep, d);\n      if (d === 0) ready.push(byId.get(dep)!);\n    }\n  }\n  return order;\n}\n\n/** Counts, for each event, how many events (transitively) depend on it. */\nfunction countDependents(events: Event[]): Map<string, number> {\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n  const directDeps = new Map<string, string[]>();\n  for (const e of events) directDeps.set(e.id, []);\n  for (const e of events) {\n    for (const p of e.prerequisites ?? []) {\n      if (byId.has(p)) directDeps.get(p)!.push(e.id);\n    }\n  }\n  const memo = new Map<string, number>();\n  const count = (id: string, seen: Set<string>): number => {\n    if (memo.has(id)) return memo.get(id)!;\n    let total = 0;\n    for (const dep of directDeps.get(id) ?? []) {\n      if (seen.has(dep)) continue;\n      seen.add(dep);\n      total += 1 + count(dep, seen);\n    }\n    memo.set(id, total);\n    return total;\n  };\n  const result = new Map<string, number>();\n  for (const e of events) result.set(e.id, count(e.id, new Set([e.id])));\n  return result;\n}\n\ninterface Attempt {\n  scheduled: Map<string, Assignment>;\n  count: number;\n}\n\n/**\n * Runs a single greedy placement pass over the given ordering. Events whose\n * prerequisites are unscheduled or unsatisfiable are skipped.\n */\nfunction greedyPass(\n  order: Event[],\n  rooms: Room[],\n  byId: Map<string, Event>,\n  startTime: number,\n  endTime: number,\n  gap: number,\n): Attempt {\n  const roomState: RoomState = new Map();\n  for (const r of rooms) roomState.set(r.id, []);\n\n  const scheduled = new Map<string, Assignment>();\n\n  for (const event of order) {\n    // Earliest start is bounded by the window and all prerequisites finishing.\n    let earliest = startTime;\n    let blocked = false;\n    for (const p of event.prerequisites ?? []) {\n      const prereq = byId.get(p);\n      if (!prereq) {\n        blocked = true; // prerequisite does not exist -> unsatisfiable\n        break;\n      }\n      const assigned = scheduled.get(p);\n      if (!assigned) {\n        blocked = true; // prerequisite could not be scheduled\n        break;\n      }\n      earliest = Math.max(earliest, assigned.endTime + gap);\n    }\n    if (blocked) continue;\n\n    const placement = placeEvent(\n      event,\n      rooms,\n      roomState,\n      earliest,\n      endTime,\n      gap,\n    );\n    if (!placement) continue;\n\n    const assignment: Assignment = {\n      eventId: event.id,\n      roomId: placement.roomId,\n      startTime: placement.start,\n      endTime: placement.start + event.duration,\n    };\n    scheduled.set(event.id, assignment);\n    insertInterval(roomState.get(placement.roomId)!, {\n      start: assignment.startTime,\n      end: assignment.endTime,\n    });\n  }\n\n  return { scheduled, count: scheduled.size };\n}\n\n/**\n * Schedules events into rooms, maximizing the number placed.\n *\n * @throws if the prerequisite graph contains a cycle (including self-references).\n */\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n): ScheduleResult {\n  assertNoCycles(events);\n\n  const gap = options.gap ?? DEFAULT_GAP;\n  const { startTime, endTime } = options;\n\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n\n  const depCount = countDependents(events);\n\n  // A set of prerequisite-respecting orderings to try; the best result wins.\n  // Different heuristics expose different packings, so trying several and\n  // keeping the best lets placement of one event account for the others.\n  const comparators: Comparator[] = [\n    // Most downstream dependents first (unblock the critical path early).\n    (a, b) =>\n      (depCount.get(b.id) ?? 0) - (depCount.get(a.id) ?? 0) ||\n      b.duration - a.duration,\n    // Longest first (place the hardest-to-fit events while space is open).\n    (a, b) => b.duration - a.duration,\n    // Shortest first (pack many small events).\n    (a, b) => a.duration - b.duration,\n    // Most attendees first (claim scarce large rooms early).\n    (a, b) => attendeesOf(b) - attendeesOf(a),\n    // Fewest attendees first.\n    (a, b) => attendeesOf(a) - attendeesOf(b),\n    // Original input order (stable baseline).\n    () => 0,\n  ];\n\n  let best: Attempt | null = null;\n  for (const cmp of comparators) {\n    const order = topoOrder(events, cmp);\n    const attempt = greedyPass(order, rooms, byId, startTime, endTime, gap);\n    if (best === null || attempt.count > best.count) {\n      best = attempt;\n      if (best.count === events.length) break; // all placed; cannot do better\n    }\n  }\n\n  const scheduled = best ? best.scheduled : new Map<string, Assignment>();\n\n  // Emit assignments and unscheduled IDs in original input order for stability.\n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  for