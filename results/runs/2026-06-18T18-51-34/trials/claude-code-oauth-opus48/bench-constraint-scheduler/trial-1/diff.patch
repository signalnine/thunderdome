ing (topological) ordering using Kahn's\n * algorithm, selecting among ready events with the given comparator.\n * Only edges to existing prerequisites constrain the order.\n */\nfunction topoOrder(events: Event[], comparator: Comparator): Event[] {\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n\n  const indegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n  for (const e of events) {\n    indegree.set(e.id, 0);\n    dependents.set(e.id, []);\n  }\n  for (const e of events) {\n    for (const p of e.prerequisites ?? []) {\n      if (!byId.has(p)) continue;\n      indegree.set(e.id, (indegree.get(e.id) ?? 0) + 1);\n      dependents.get(p)!.push(e.id);\n    }\n  }\n\n  const ready: Event[] = [];\n  for (const e of events) if ((indegree.get(e.id) ?? 0) === 0) ready.push(e);\n\n  const order: Event[] = [];\n  while (ready.length > 0) {\n    // Select the best ready event per comparator (stable on ties).\n    let bestIdx = 0;\n    for (let i = 1; i < ready.length; i++) {\n      if (comparator(ready[i], ready[bestIdx]) < 0) bestIdx = i;\n    }\n    const next = ready.splice(bestIdx, 1)[0];\n    order.push(next);\n    for (const dep of dependents.get(next.id)!) {\n      const d = (indegree.get(dep) ?? 0) - 1;\n      indegree.set(dep, d);\n      if (d === 0) ready.push(byId.get(dep)!);\n    }\n  }\n  return order;\n}\n\n/** Counts, for each event, how many events (transitively) depend on it. */\nfunction countDependents(events: Event[]): Map<string, number> {\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n  const directDeps = new Map<string, string[]>();\n  for (const e of events) directDeps.set(e.id, []);\n  for (const e of events) {\n    for (const p of e.prerequisites ?? []) {\n      if (byId.has(p)) directDeps.get(p)!.push(e.id);\n    }\n  }\n  const memo = new Map<string, number>();\n  const count = (id: string, seen: Set<string>): number => {\n    if (memo.has(id)) return memo.get(id)!;\n    let total = 0;\n    for (const dep of directDeps.get(id) ?? []) {\n      if (seen.has(dep)) continue;\n      seen.add(dep);\n      total += 1 + count(dep, seen);\n    }\n    memo.set(id, total);\n    return total;\n  };\n  const result = new Map<string, number>();\n  for (const e of events) result.set(e.id, count(e.id, new Set([e.id])));\n  return result;\n}\n\ninterface Attempt {\n  scheduled: Map<string, Assignment>;\n  count: number;\n}\n\n/**\n * Runs a single greedy placement pass over the given ordering. Events whose\n * prerequisites are unscheduled or unsatisfiable are skipped.\n */\nfunction greedyPass(\n  order: Event[],\n  rooms: Room[],\n  byId: Map<string, Event>,\n  startTime: number,\n  endTime: number,\n  gap: number,\n): Attempt {\n  const roomState: RoomState = new Map();\n  for (const r of rooms) roomState.set(r.id, []);\n\n  const scheduled = new Map<string, Assignment>();\n\n  for (const event of order) {\n    // Earliest start is bounded by the window and all prerequisites finishing.\n    let earliest = startTime;\n    let blocked = false;\n    for (const p of event.prerequisites ?? []) {\n      const prereq = byId.get(p);\n      if (!prereq) {\n        blocked = true; // prerequisite does not exist -> unsatisfiable\n        break;\n      }\n      const assigned = scheduled.get(p);\n      if (!assigned) {\n        blocked = true; // prerequisite could not be scheduled\n        break;\n      }\n      earliest = Math.max(earliest, assigned.endTime + gap);\n    }\n    if (blocked) continue;\n\n    const placement = placeEvent(\n      event,\n      rooms,\n      roomState,\n      earliest,\n      endTime,\n      gap,\n    );\n    if (!placement) continue;\n\n    const assignment: Assignment = {\n      eventId: event.id,\n      roomId: placement.roomId,\n      startTime: placement.start,\n      endTime: placement.start + event.duration,\n    };\n    scheduled.set(event.id, assignment);\n    insertInterval(roomState.get(placement.roomId)!, {\n      start: assignment.startTime,\n      end: assignment.endTime,\n    });\n  }\n\n  return { scheduled, count: scheduled.size };\n}\n\n/**\n * Schedules events into rooms, maximizing the number placed.\n *\n * @throws if the prerequisite graph contains a cycle (including self-references).\n */\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n): ScheduleResult {\n  assertNoCycles(events);\n\n  const gap = options.gap ?? DEFAULT_GAP;\n  const { startTime, endTime } = options;\n\n  const byId = new Map<string, Event>();\n  for (const e of events) byId.set(e.id, e);\n\n  const depCount = countDependents(events);\n\n  // A set of prerequisite-respecting orderings to try; the best result wins.\n  // Different heuristics expose different packings, so trying several and\n  // keeping the best lets placement of one event account for the others.\n  const comparators: Comparator[] = [\n    // Most downstream dependents first (unblock the critical path early).\n    (a, b) =>\n      (depCount.get(b.id) ?? 0) - (depCount.get(a.id) ?? 0) ||\n      b.duration - a.duration,\n    // Longest first (place the hardest-to-fit events while space is open).\n    (a, b) => b.duration - a.duration,\n    // Shortest first (pack many small events).\n    (a, b) => a.duration - b.duration,\n    // Most attendees first (claim scarce large rooms early).\n    (a, b) => attendeesOf(b) - attendeesOf(a),\n    // Fewest attendees first.\n    (a, b) => attendeesOf(a) - attendeesOf(b),\n    // Original input order (stable baseline).\n    () => 0,\n  ];\n\n  let best: Attempt | null = null;\n  for (const cmp of comparators) {\n    const order = topoOrder(events, cmp);\n    const attempt = greedyPass(order, rooms, byId, startTime, endTime, gap);\n    if (best === null || attempt.count > best.count) {\n      best = attempt;\n      if (best.count === events.length) break; // all placed; cannot do better\n    }\n  }\n\n  const scheduled = best ? best.scheduled : new Map<string, Assignment>();\n\n  // Emit assignments and unscheduled IDs in original input order for stability.\n  const assignments: Assignment[] = [];\n  const unscheduled: string[] = [];\n  for (const e of events) {\n    const a = scheduled.get(e.id);\n    if (a) assignments.push(a);\n    else unscheduled.push(e.id);\n  }\n\n  return { assignments, unscheduled };\n}\n\nexport default schedule;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
