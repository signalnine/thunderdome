heet();\n    s.set('A1', 1);\n    s.set('B1', 2);\n    s.set('C1', 3);\n    s.set('A2', 4);\n    s.set('B2', 5);\n    s.set('C2', 6);\n    s.set('D1', '=SUM(A1:C1)'); // row range\n    s.set('D2', '=SUM(A1:C2)'); // block range\n    expect(s.get('D1')).toBe(6);\n    expect(s.get('D2')).toBe(21);\n  });\n\n  it('SUM with scalar arguments', () => {\n    const s = setup();\n    s.set('B1', '=SUM(A1, A2, 100)');\n    expect(s.get('B1')).toBe(130);\n  });\n\n  it('nested function calls', () => {\n    const s = setup();\n    s.set('B1', '=SUM(A1:A2) + MAX(A3:A5)');\n    expect(s.get('B1')).toBe(80);\n  });\n});\n\ndescribe('IF and comparisons', () => {\n  it('evaluates the documented IF example', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 10);\n    s.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(s.get('C1')).toBe('small');\n    s.set('A1', 50);\n    expect(s.get('C1')).toBe('big');\n  });\n\n  it('supports all comparison operators', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=IF(A1>=5, 1, 0)');\n    s.set('B2', '=IF(A1<=4, 1, 0)');\n    s.set('B3', '=IF(A1=5, 1, 0)');\n    s.set('B4', '=IF(A1<>5, 1, 0)');\n    s.set('B5', '=IF(A1<10, 1, 0)');\n    expect(s.get('B1')).toBe(1);\n    expect(s.get('B2')).toBe(0);\n    expect(s.get('B3')).toBe(1);\n    expect(s.get('B4')).toBe(0);\n    expect(s.get('B5')).toBe(1);\n  });\n\n  it('compares strings for equality', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'yes');\n    s.set('B1', '=IF(A1=\"yes\", \"ok\", \"no\")');\n    expect(s.get('B1')).toBe('ok');\n  });\n\n  it('nested IFs', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 75);\n    s.set('B1', '=IF(A1>=90, \"A\", IF(A1>=70, \"B\", \"C\"))');\n    expect(s.get('B1')).toBe('B');\n  });\n});\n\ndescribe('reactive updates', () => {\n  it('updates direct dependents', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 5);\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe(6);