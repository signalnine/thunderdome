+++ b/src/tokenizer.ts
@@ -0,0 +1,152 @@
+/** Tokenizer for spreadsheet formula expressions. */
+
+export type TokenType =
+  | 'number'
+  | 'string'
+  | 'identifier' // function names or cell references like A1
+  | 'operator'
+  | 'lparen'
+  | 'rparen'
+  | 'comma'
+  | 'colon'
+  | 'eof';
+
+export interface Token {
+  type: TokenType;
+  value: string;
+  pos: number;
+}
+
+const TWO_CHAR_OPS = new Set(['>=', '<=', '<>']);
+const ONE_CHAR_OPS = new Set(['+', '-', '*', '/', '>', '<', '=']);
+
+/**
+ * Convert a formula expression (without the leading "=") into a token stream.
+ * Throws on unrecognized characters or unterminated strings.
+ */
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+
+  while (i < input.length) {
+    const ch = input[i];
+
+    if (ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r') {
+      i++;
+      continue;
+    }
+
+    // String literals using double quotes.
+    if (ch === '"') {
+      let str = '';
+      let j = i + 1;
+      let closed = false;
+      while (j < input.length) {
+        if (input[j] === '"') {
+          // Support "" as an escaped quote inside a string.
+          if (input[j + 1] === '"') {
+            str += '"';
+            j += 2;
+            continue;
+          }
+          closed = true;
+          j++;
+          break;
+        }
+        str += input[j];
+        j++;
+      }
+      if (!closed) {
+        throw new Error(`Unterminated string literal at position ${i}`);
+      }
+      tokens.push({ type: 'string', value: str, pos: i });
+      i = j;
+      continue;
+    }
+
+    // Numbers (integer or decimal). A leading sign is handled as a unary op.
+    if (isDigit(ch) || (ch === '.' && isDigit(input[i + 1]))) {
+      let num = '';
+      let j = i;
+      while (j < input.length && (isDigit(input[j]) || input[j] === '.')) {
+        num += input[j];
+        j++;
+      }
+      // Scientific notation, e.g. 1e3 or 2.5E-4.
+      if (input[j] === 'e' || input[j] === 'E') {
+        num += input[j];
+        j++;
+        if (input[j] === '+' || input[j] === '-') {
+          num += input[j];
+          j++;
+        }
+        while (j < input.length && isDigit(input[j])) {
+          num += input[j];
+          j++;
+        }
+      }
+      tokens.push({ type: 'number', value: num, pos: i });
+      i = j;
+      continue;
+    }
+
+    // Identifiers: function names and cell references (letters then optional digits).
+    if (isLetter(ch)) {
+      let ident = '';
+      let j = i;
+      while (j < input.length && (isLetter(input[j]) || isDigit(input[j]))) {
+        ident += input[j];
+        j++;
+      }
+      tokens.push({ type: 'identifier', value: ident, pos: i });
+      i = j;
+      continue;
+    }
+
+    // Two-character operators.
+    const two = input.substr(i, 2);
+    if (TWO_CHAR_OPS.has(two)) {
+      tokens.push({ type: 'operator', value: two, pos: i });
+      i += 2;
+      continue;
+    }
+
+    if (ONE_CHAR_OPS.has(ch)) {
+      tokens.push({ type: 'operator', value: ch, pos: i });
+      i++;
+      continue;
+    }
+
+    switch (ch) {
+      case '(':
+        tokens.push({ type: 'lparen', value: ch, pos: i });
+        i++;
+        continue;
+      case ')':
+        tokens.push({ type: 'rparen', value: ch, pos: i });
+        i++;
+        continue;
+      case ',':
+        tokens.push({ type: 'comma', value: ch, pos: i });
+        i++;
+        continue;
+      case ':':
+        tokens.push({ type: 'colon', value: ch, pos: i });
+        i++;
+        continue;
+    }
+
+    throw new Error(`Unexpected character '${ch}' at position ${i}`);
+  }
+
+  tokens.push({ type: 'eof', value: '', pos: input.length });
+  return tokens;
+}
+
+function isDigit(ch: string | undefined): boolean {
+  return ch !== undefined && ch >= '0' && ch <= '9';
+}
+
+function isLetter(ch: string | undefined): boolean {
+  return ch !== undefined && ((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z'));
+}
