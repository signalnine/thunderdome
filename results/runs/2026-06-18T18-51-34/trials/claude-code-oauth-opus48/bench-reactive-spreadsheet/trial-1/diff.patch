@@ -0,0 +1,82 @@
+/**
+ * Utilities for parsing and manipulating cell references (e.g. "A1", "AA10")
+ * and ranges (e.g. "A1:B3").
+ */
+
+const CELL_RE = /^([A-Z]+)([1-9][0-9]*)$/;
+
+export interface CellCoord {
+  /** 0-based column index (A = 0, B = 1, ... Z = 25, AA = 26, ...). */
+  col: number;
+  /** 0-based row index (row "1" => 0). */
+  row: number;
+}
+
+/** Convert a column label like "A", "Z", "AA" to a 0-based index. */
+export function columnToIndex(label: string): number {
+  let index = 0;
+  for (let i = 0; i < label.length; i++) {
+    index = index * 26 + (label.charCodeAt(i) - 64); // 'A' is 65
+  }
+  return index - 1;
+}
+
+/** Convert a 0-based column index back to its label ("A", "Z", "AA", ...). */
+export function indexToColumn(index: number): string {
+  let label = '';
+  let n = index + 1;
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    label = String.fromCharCode(65 + rem) + label;
+    n = Math.floor((n - 1) / 26);
+  }
+  return label;
+}
+
+/**
+ * Parse a single cell reference into coordinates. Throws on malformed input.
+ * The reference is upper-cased first, so "a1" is accepted as "A1".
+ */
+export function parseCellRef(ref: string): CellCoord {
+  const m = CELL_RE.exec(ref.toUpperCase());
+  if (!m) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  return {
+    col: columnToIndex(m[1]),
+    row: parseInt(m[2], 10) - 1,
+  };
+}
+
+/** Produce the canonical reference string for a coordinate. */
+export function coordToRef(coord: CellCoord): string {
+  return indexToColumn(coord.col) + (coord.row + 1);
+}
+
+/** Return the canonical (upper-cased, validated) form of a cell reference. */
+export function normalizeRef(ref: string): string {
+  return coordToRef(parseCellRef(ref));
+}
+
+/**
+ * Expand a range "start:end" into the list of cell references it covers.
+ * Handles single cells, row ranges, column ranges and 2D blocks. The bounds
+ * are normalized so "B3:A1" expands the same as "A1:B3".
+ */
+export function expandRange(start: string, end: string): string[] {
+  const a = parseCellRef(start);
+  const b = parseCellRef(end);
+
+  const minCol = Math.min(a.col, b.col);
+  const maxCol = Math.max(a.col, b.col);
+  const minRow = Math.min(a.row, b.row);
+  const maxRow = Math.max(a.row, b.row);
+
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(coordToRef({ col, row }));
+    }
+  }
+  return cells;
+}
