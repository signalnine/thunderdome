+/** Abstract syntax tree node types for parsed formulas. */
+
+export type BinaryOp = '+' | '-' | '*' | '/' | '>' | '<' | '>=' | '<=' | '=' | '<>';
+
+export type Node =
+  | NumberLiteral
+  | StringLiteral
+  | BooleanLiteral
+  | CellRefNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | FunctionNode;
+
+export interface NumberLiteral {
+  type: 'number';
+  value: number;
+}
+
+export interface StringLiteral {
+  type: 'string';
+  value: string;
+}
+
+export interface BooleanLiteral {
+  type: 'boolean';
+  value: boolean;
+}
+
+export interface CellRefNode {
+  type: 'cell';
+  ref: string; // normalized reference, e.g. "A1"
+}
+
+export interface RangeNode {
+  type: 'range';
+  cells: string[]; // expanded, normalized cell references
+}
+
+export interface UnaryNode {
+  type: 'unary';
+  op: '-' | '+';
+  operand: Node;
+}
+
+export interface BinaryNode {
+  type: 'binary';
+  op: BinaryOp;
+  left: Node;
+  right: Node;
+}
+
+export interface FunctionNode {
+  type: 'function';
+  name: string; // upper-cased function name
+  args: Node[];
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..d7f7765
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,218 @@
+/** Dependency collection and evaluation of formula ASTs. */
+
+import { Node } from './ast.js';
+
+export type CellValue = string | number | boolean | null;
+
+/** A lookup function returning the current computed value of a cell. */
+export type CellLookup = (ref: string) => CellValue;
+
+/** Error raised during evaluation; carries a spreadsheet-style error code. */
+export class EvalError extends Error {
+  constructor(public code: string, message?: string) {
+    super(message ?? code);
+    this.name = 'EvalError';
+  }
+}
+
+/** Collect every cell reference an AST depends on (expanding ranges). */
+export function collectDeps(node: Node, into: Set<string> = new Set()): Set<string> {
+  switch (node.type) {
+    case 'cell':
+      into.add(node.ref);
+      break;
+    case 'range':
+      for (const c of node.cells) into.add(c);
+      break;
+    case 'unary':
+      collectDeps(node.operand, into);
+      break;
+    case 'binary':
+      collectDeps(node.left, into);
+      collectDeps(node.right, into);
+      break;
+    case 'function':
+      for (const arg of node.args) collectDeps(arg, into);
+      break;
+    // literals have no dependencies
+  }
+  return into;
+}
+
+/** Evaluate an AST to a scalar cell value. */
+export function evaluate(node: Node, lookup: CellLookup): CellValue {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'boolean':
+      return node.value;
+    case 'cell':
+      return lookup(node.ref);
+    case 'range':
+      // A range used in a scalar position is not meaningful.
+      throw new EvalError('#VALUE!', 'Range used where a single value was expected');
+    case 'unary': {
+      const v = toNumber(evaluate(node.operand, lookup));
+      return node.op === '-' ? -v : +v;
+    }
+    case 'binary':
+      return evaluateBinary(node.op, node.left, node.right, lookup);
+    case 'function':
+      return evaluateFunction(node.name, node.args, lookup);
+  }
+}
+
+function evaluateBinary(
+  op: string,
+  leftNode: Node,
+  rightNode: Node,
+  lookup: CellLookup,
+): CellValue {
+  const left = evaluate(leftNode, lookup);
+  const right = evaluate(rightNode, lookup);
+
+  switch (op) {
+    case '+':
+      return toNumber(left) + toNumber(right);
+    case '-':
+      return toNumber(left) - toNumber(right);
+    case '*':
+      return toNumber(left) * toNumber(right);
+    case '/': {
+      const divisor = toNumber(right);
+      if (divisor === 0) {
+        throw new EvalError('#DIV/0!', 'Division by zero');
+      }
+      return toNumber(left) / divisor;
+    }
+    case '=':
+      return looseEquals(left, right);
+    case '<>':
+      return !looseEquals(left, right);
+    case '>':
+    case '<':
+    case '>=':
+    case '<=':
+      return compare(op, left, right);
+    default:
+      throw new EvalError('#ERROR!', `Unknown operator ${op}`);
+  }
+}
+
+function evaluateFunction(name: string, args: Node[], lookup: CellLookup): CellValue {
+  switch (name) {
+    case 'SUM': {
+      const nums = gatherNumbers(args, lookup);
+      return nums.reduce((a, b) => a + b, 0);
+    }
+    case 'AVERAGE': {
+      const nums = gatherNumbers(args, lookup);
+      if (nums.length === 0) throw new EvalError('#DIV/0!', 'AVERAGE of no numeric values');
+      return nums.reduce((a, b) => a + b, 0) / nums.length;
+    }
+    case 'MIN': {
+      const nums = gatherNumbers(args, lookup);
+      return nums.length === 0 ? 0 : Math.min(...nums);
+    }
+    case 'MAX': {
+      const nums = gatherNumbers(args, lookup);
+      return nums.length === 0 ? 0 : Math.max(...nums);
+    }
+    case 'COUNT': {
+      return gatherNumbers(args, lookup).length;
+    }
+    case 'IF': {
+      if (args.length < 2 || args.length > 3) {
+        throw new EvalError('#ERROR!', 'IF expects 2 or 3 arguments');
+      }
+      const cond = toBoolean(evaluate(args[0], lookup));
+      if (cond) return evaluate(args[1], lookup);
+      return args.length === 3 ? evaluate(args[2], lookup) : false;
+    }
+    default:
+      throw new EvalError('#NAME?', `Unknown function ${name}`);
+  }
+}
+
+/**
+ * Flatten function arguments (ranges and scalars) into the numeric values
+ * they contain. Non-numeric cells in ranges are ignored, matching the
+ * behaviour of SUM/AVERAGE/etc.
+ */
+function gatherNumbers(args: Node[], lookup: CellLookup): number[] {
+  const nums: number[] = [];
+  for (const arg of args) {
+    if (arg.type === 'range') {
+      for (const ref of arg.cells) {
+        const v = lookup(ref);
+        if (typeof v === 'number' && !Number.isNaN(v)) nums.push(v);
+      }
+    } else {
+      const v = evaluate(arg, lookup);
+      if (typeof v === 'number' && !Number.isNaN(v)) {
+        nums.push(v);
+      } else if (typeof v === 'boolean') {
+        // Explicit scalar booleans count as 1/0 (Excel behaviour for arguments).
+        nums.push(v ? 1 : 0);
+      }
+    }
+  }
+  return nums;
+}
+
+/** Coerce a cell value to a number for arithmetic. */
+function toNumber(v: CellValue): number {
+  if (v === null) return 0;
+  if (typeof v === 'number') return v;
+  if (typeof v === 'boolean') return v ? 1 : 0;
+  // String: accept numeric strings, otherwise it's a value error.
+  const trimmed = v.trim();
+  if (trimmed === '') return 0;
+  const n = Number(trimmed);
+  if (Number.isNaN(n)) {
+    throw new EvalError('#VALUE!', `Cannot convert "${v}" to a number`);
+  }
+  return n;
+}
+
+/** Coerce a cell value to a boolean for IF conditions. */
+function toBoolean(v: CellValue): boolean {
+  if (v === null) return false;
+  if (typeof v === 'boolean') return v;
+  if (typeof v === 'number') return v !== 0;
+  return v.length > 0;
+}
+
+function looseEquals(a: CellValue, b: CellValue): boolean {
+  if (a === null) a = '';
+  if (b === null) b = '';
+  // Compare numbers numerically; otherwise compare by value/type directly.
+  if (typeof a === 'number' && typeof b === 'number') return a === b;
+  return a === b;
+}
+
+function compare(op: string, a: CellValue, b: CellValue): boolean {
+  let cmp: number;
+  if (typeof a === 'number' || typeof b === 'number' || a === null || b === null) {
+    cmp = toNumber(a) - toNumber(b);
+  } else if (typeof a === 'boolean' || typeof b === 'boolean') {
+    cmp = (a ? 1 : 0) - (b ? 1 : 0);
+  } else {
+    // Both strings: lexicographic comparison.
+    cmp = a < b ? -1 : a > b ? 1 : 0;
+  }
+  switch (op) {
+    case '>':
+      return cmp > 0;
+    case '<':
+      return cmp < 0;
+    case '>=':
+      return cmp >= 0;
+    case '<=':
+      return cmp <= 0;
+    default:
+      return false;
+  }
+}
