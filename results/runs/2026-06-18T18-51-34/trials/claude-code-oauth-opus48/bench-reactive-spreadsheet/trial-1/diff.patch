+++ b/src/parser.ts
@@ -0,0 +1,163 @@
+/** Recursive-descent parser turning a token stream into an AST. */
+
+import { Token, tokenize } from './tokenizer.js';
+import { Node, BinaryOp } from './ast.js';
+import { expandRange, normalizeRef } from './references.js';
+
+const CELL_RE = /^[A-Za-z]+[1-9][0-9]*$/;
+const COMPARISON_OPS = new Set(['>', '<', '>=', '<=', '=', '<>']);
+
+/** Parse a formula expression (without the leading "=") into an AST. */
+export function parse(input: string): Node {
+  const parser = new Parser(tokenize(input));
+  const node = parser.parseExpression();
+  parser.expect('eof');
+  return node;
+}
+
+class Parser {
+  private pos = 0;
+
+  constructor(private tokens: Token[]) {}
+
+  private peek(): Token {
+    return this.tokens[this.pos];
+  }
+
+  private next(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  expect(type: Token['type']): Token {
+    const tok = this.peek();
+    if (tok.type !== type) {
+      throw new Error(`Expected ${type} but found '${tok.value || tok.type}' at position ${tok.pos}`);
+    }
+    return this.next();
+  }
+
+  /** expression := comparison */
+  parseExpression(): Node {
+    return this.parseComparison();
+  }
+
+  /** comparison := additive ( compareOp additive )? */
+  private parseComparison(): Node {
+    let left = this.parseAdditive();
+    const tok = this.peek();
+    if (tok.type === 'operator' && COMPARISON_OPS.has(tok.value)) {
+      this.next();
+      const right = this.parseAdditive();
+      left = { type: 'binary', op: tok.value as BinaryOp, left, right };
+    }
+    return left;
+  }
+
+  /** additive := multiplicative ( ('+'|'-') multiplicative )* */
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    let tok = this.peek();
+    while (tok.type === 'operator' && (tok.value === '+' || tok.value === '-')) {
+      this.next();
+      const right = this.parseMultiplicative();
+      left = { type: 'binary', op: tok.value as BinaryOp, left, right };
+      tok = this.peek();
+    }
+    return left;
+  }
+
+  /** multiplicative := unary ( ('*'|'/') unary )* */
+  private parseMultiplicative(): Node {
+    let left = this.parseUnary();
+    let tok = this.peek();
+    while (tok.type === 'operator' && (tok.value === '*' || tok.value === '/')) {
+      this.next();
+      const right = this.parseUnary();
+      left = { type: 'binary', op: tok.value as BinaryOp, left, right };
+      tok = this.peek();
+    }
+    return left;
+  }
+
+  /** unary := ('+'|'-') unary | primary */
+  private parseUnary(): Node {
+    const tok = this.peek();
+    if (tok.type === 'operator' && (tok.value === '+' || tok.value === '-')) {
+      this.next();
+      return { type: 'unary', op: tok.value as '+' | '-', operand: this.parseUnary() };
+    }
+    return this.parsePrimary();
+  }
+
+  /** primary := number | string | boolean | function | cellOrRange | '(' expression ')' */
+  private parsePrimary(): Node {
+    const tok = this.peek();
+
+    if (tok.type === 'number') {
+      this.next();
+      const value = Number(tok.value);
+      if (Number.isNaN(value)) {
+        throw new Error(`Invalid number literal '${tok.value}' at position ${tok.pos}`);
+      }
+      return { type: 'number', value };
+    }
+
+    if (tok.type === 'string') {
+      this.next();
+      return { type: 'string', value: tok.value };
+    }
+
+    if (tok.type === 'lparen') {
+      this.next();
+      const expr = this.parseExpression();
+      this.expect('rparen');
+      return expr;
+    }
+
+    if (tok.type === 'identifier') {
+      this.next();
+
+      // Function call: identifier immediately followed by '('.
+      if (this.peek().type === 'lparen') {
+        return this.parseFunctionCall(tok.value);
+      }
+
+      const upper = tok.value.toUpperCase();
+      if (upper === 'TRUE') return { type: 'boolean', value: true };
+      if (upper === 'FALSE') return { type: 'boolean', value: false };
+
+      if (!CELL_RE.test(tok.value)) {
+        throw new Error(`Invalid reference or name '${tok.value}' at position ${tok.pos}`);
+      }
+
+      // Range: cell ':' cell.
+      if (this.peek().type === 'colon') {
+        this.next();
+        const endTok = this.peek();
+        if (endTok.type !== 'identifier' || !CELL_RE.test(endTok.value)) {
+          throw new Error(`Expected cell reference after ':' at position ${endTok.pos}`);
+        }
+        this.next();
+        return { type: 'range', cells: expandRange(tok.value, endTok.value) };
+      }
+
+      return { type: 'cell', ref: normalizeRef(tok.value) };
+    }
+
+    throw new Error(`Unexpected token '${tok.value || tok.type}' at position ${tok.pos}`);
+  }
+
+  private parseFunctionCall(name: string): Node {
+    this.expect('lparen');
+    const args: Node[] = [];
+    if (this.peek().type !== 'rparen') {
+      args.push(this.parseExpression());
+      while (this.peek().type === 'comma') {
+        this.next();
+        args.push(this.parseExpression());
+      }
+    }
+    this.expect('rparen');
+    return { type: 'function', name: name.toUpperCase(), args };
+  }
+}
