et();\n    expect(() => s.set('A1', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a two-cell cycle', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1');\n    expect(() => s.set('B1', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects an indirect cycle through many cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=A2');\n    s.set('A2', '=A3');\n    s.set('A3', '=A4');\n    expect(() => s.set('A4', '=A1')).toThrow(CircularReferenceError);\n  });\n\n  it('detects a cycle through a range', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('B1', '=SUM(A1:A3)');\n    expect(() => s.set('A3', '=B1')).toThrow(CircularReferenceError);\n  });\n\n  it('leaves the spreadsheet unchanged after a rejected set', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1');\n    s.set('B1', 5);\n    expect(s.get('A1')).toBe(5);\n    expect(() => s.set('B1', '=A1')).toThrow();\n    // B1 keeps its old value; A1 still resolves through it.\n    expect(s.get('B1')).toBe(5);\n    expect(s.get('A1')).toBe(5);\n  });\n});\n\ndescribe('error propagation', () => {\n  it('propagates errors to dependents', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=1/0');\n    s.set('B1', '=A1+1');\n    expect(s.get('A1')).toBe('#DIV/0!');\n    expect(s.get('B1')).toBe('#DIV/0!');\n  });\n\n  it('recovers when the error source is fixed', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=1/0');\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe('#DIV/0!');\n    s.set('A1', 9);\n    expect(s.get('B1')).toBe(10);\n  });\n\n  it('reports value errors for non-numeric arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 'abc');\n    s.set('B1', '=A1+1');\n    expect(s.get('B1')).toBe('#VALUE!');\n  });\n\n  it('marks unparseable formulas as errors', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=A1+');\n    expect(s.get('A1')).toBe('#ERROR!');\n  });\n});\n\ndescribe('display and snapshot', () => {\n  it('formats values for display', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 30);\n    s.set('A2', 'hi');\n    s.set('A3', true);\n    s.set('A4', '=1/4');\n    expect(s.getDisplay('A1')).toBe('30');\n    expect(s.getDisplay('A2')).toBe('hi');\n    expect(s.getDisplay('A3')).toBe('TRUE');\n    expect(s.getDisplay('A4')).toBe('0.25');\n    expect(s.getDisplay('Z9')).toBe('');\n  });\n\n  it('trims floating point noise in display', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=0.1+0.2');\n    expect(s.get('A1')).toBeCloseTo(0.3);\n    expect(s.getDisplay('A1')).toBe('0.3');\n  });\n\n  it('getCells returns all non-empty cells', () => {\n    const s = new Spreadsheet();\n    s.set('A1', 1);\n    s.set('A2', 2);\n    s.set('A3', '=A1+A2');\n    const cells = s.getCells();\n    expect(cells.size).toBe(3);\n    expect(cells.get('A1')).toBe(1);\n    expect(cells.get('A3')).toBe(3);\n  });\n});\n\ndescribe('empty cells in formulas', () => {\n  it('treats empty cells as zero in arithmetic', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+5');\n    expect(s.get('A1')).toBe(5);\n  });\n\n  it('becomes reactive once the empty cell is filled', () => {\n    const s = new Spreadsheet();\n    s.set('A1', '=B1+5');\n    expect(s.get('A1')).toBe(5);\n    s.set('B1', 10);\n    expect(s.get('A1')).toBe(15);\n  });\n});\n","structuredPatch":[{"oldStart":229,"oldLines":7,"newStart":229,"newLines":6,"lines":["     s.set('A1', 1);","     s.set('A2', 2);","     s.set('A3', 3);","-    s.set('T', '=SUM(A1:A3)'.replace('T', 'B1') ? '=SUM(A1:A3)' : '');","     s.set('B1', '=SUM(A1:A3)');","     expect(s.get('B1')).toBe(6);","     s.set('A2', 20);"]}],"userModified":false,"replaceAll":false}}
