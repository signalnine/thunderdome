+++ b/src/index.ts
@@ -0,0 +1,264 @@
+/**
+ * A reactive spreadsheet engine.
+ *
+ * Cells hold literal values (numbers, strings, booleans) or formulas (strings
+ * beginning with "="). When a cell changes, every cell that transitively
+ * depends on it is automatically recomputed. Attempts to create a circular
+ * dependency throw an error and leave the spreadsheet unchanged.
+ */
+
+import { Node } from './ast.js';
+import { parse } from './parser.js';
+import { collectDeps, evaluate, EvalError, CellValue } from './evaluator.js';
+import { normalizeRef } from './references.js';
+
+export { CellValue } from './evaluator.js';
+
+/** Raised when a `set` would introduce a circular dependency. */
+export class CircularReferenceError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'CircularReferenceError';
+  }
+}
+
+interface Cell {
+  /** The raw input the user supplied. */
+  raw: string | number | boolean;
+  /** Whether the raw input is a formula (starts with "="). */
+  isFormula: boolean;
+  /** Parsed formula AST, or undefined for literals / unparseable formulas. */
+  ast?: Node;
+  /** Set if the formula could not be parsed. */
+  parseError?: string;
+  /** Cells this cell directly depends on. */
+  deps: Set<string>;
+  /** Last computed value (an error code string if evaluation failed). */
+  value: CellValue;
+  /** Spreadsheet-style error code if the last evaluation failed. */
+  error?: string;
+}
+
+export class Spreadsheet {
+  private cells = new Map<string, Cell>();
+  /** Reverse dependency index: ref -> set of cells that reference it. */
+  private dependents = new Map<string, Set<string>>();
+
+  /** Set a cell's value, either a literal or a formula string starting with "=". */
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeRef(cell);
+
+    const isFormula = typeof value === 'string' && value.length > 1 && value.startsWith('=');
+    let ast: Node | undefined;
+    let parseError: string | undefined;
+    let newDeps: Set<string> = new Set();
+
+    if (isFormula) {
+      try {
+        ast = parse((value as string).slice(1));
+        newDeps = collectDeps(ast);
+      } catch {
+        // Unparseable formula: keep it as an error cell with no dependencies.
+        parseError = '#ERROR!';
+      }
+
+      if (ast && this.wouldCreateCycle(ref, newDeps)) {
+        throw new CircularReferenceError(
+          `Setting ${ref} to "${value}" would create a circular reference`,
+        );
+      }
+    }
+
+    this.commit(ref, value, isFormula, ast, parseError, newDeps);
+    this.recompute([ref]);
+  }
+
+  /** Get a cell's computed value. Returns null for empty cells. */
+  get(cell: string): CellValue {
+    const c = this.cells.get(normalizeRef(cell));
+    return c ? c.value : null;
+  }
+
+  /** Get the display string for a cell's computed value. */
+  getDisplay(cell: string): string {
+    return formatValue(this.get(cell));
+  }
+
+  /** Get all non-empty cells as a Map from cell reference to computed value. */
+  getCells(): Map<string, CellValue> {
+    const out = new Map<string, CellValue>();
+    for (const [ref, c] of this.cells) {
+      out.set(ref, c.value);
+    }
+    return out;
+  }
+
+  // --- internals -----------------------------------------------------------
+
+  /** Write a cell's new content and update the dependency indexes. */
+  private commit(
+    ref: string,
+    raw: string | number | boolean,
+    isFormula: boolean,
+    ast: Node | undefined,
+    parseError: string | undefined,
+    newDeps: Set<string>,
+  ): void {
+    const existing = this.cells.get(ref);
+
+    // Detach from old dependencies.
+    if (existing) {
+      for (const dep of existing.deps) {
+        this.dependents.get(dep)?.delete(ref);
+      }
+    }
+
+    const cell: Cell = existing ?? { raw, isFormula, deps: newDeps, value: null };
+    cell.raw = raw;
+    cell.isFormula = isFormula;
+    cell.ast = ast;
+    cell.parseError = parseError;
+    cell.deps = newDeps;
+    cell.error = undefined;
+    this.cells.set(ref, cell);
+
+    // Attach to new dependencies.
+    for (const dep of newDeps) {
+      let set = this.dependents.get(dep);
+      if (!set) {
+        set = new Set();
+        this.dependents.set(dep, set);
+      }
+      set.add(ref);
+    }
+  }
+
+  /**
+   * Determine whether giving `ref` the dependencies `newDeps` would form a
+   * cycle, by checking if `ref` is reachable from any of those dependencies
+   * through the existing dependency graph.
+   */
+  private wouldCreateCycle(ref: string, newDeps: Set<string>): boolean {
+    const visited = new Set<string>();
+    const stack = [...newDeps];
+    while (stack.length > 0) {
+      const node = stack.pop()!;
+      if (node === ref) return true;
+      if (visited.has(node)) continue;
+      visited.add(node);
+      const c = this.cells.get(node);
+      if (c) {
+        for (const dep of c.deps) stack.push(dep);
+      }
+    }
+    return false;
+  }
+
+  /**
+   * Recompute the given cells and everything that transitively depends on them,
+   * in dependency (topological) order.
+   */
+  private recompute(roots: string[]): void {
+    const affected = this.collectAffected(roots);
+    const order = this.topoOrder(affected);
+
+    const lookup = (r: string): CellValue => {
+      const c = this.cells.get(r);
+      if (!c) return null;
+      if (c.error) {
+        throw new EvalError(c.error, `Reference to errored cell ${r}`);
+      }
+      return c.value;
+    };
+
+    for (const ref of order) {
+      const cell = this.cells.get(ref);
+      if (!cell) continue;
+      if (cell.parseError) {
+        // Formula that failed to parse.
+        cell.error = cell.parseError;
+        cell.value = cell.parseError;
+        continue;
+      }
+      if (!cell.isFormula || !cell.ast) {
+        // Literal cell: its value is just the raw input.
+        cell.value = cell.raw as CellValue;
+        cell.error = undefined;
+        continue;
+      }
+      try {
+        cell.value = evaluate(cell.ast, lookup);
+        cell.error = undefined;
+      } catch (e) {
+        cell.error = e instanceof EvalError ? e.code : '#ERROR!';
+        cell.value = cell.error;
+      }
+    }
+  }
+
+  /** Gather the root cells plus all of their transitive dependents. */
+  private collectAffected(roots: string[]): Set<string> {
+    const affected = new Set<string>();
+    const stack = [...roots];
+    while (stack.length > 0) {
+      const node = stack.pop()!;
+      if (affected.has(node)) continue;
+      affected.add(node);
+      const deps = this.dependents.get(node);
+      if (deps) {
+        for (const d of deps) stack.push(d);
+      }
+    }
+    return affected;
+  }
+
+  /** Topologically order the affected set so dependencies compute first. */
+  private topoOrder(affected: Set<string>): string[] {
+    const indegree = new Map<string, number>();
+    for (const ref of affected) indegree.set(ref, 0);
+
+    // Count, for each affected cell, how many of its deps are also affected.
+    for (const ref of affected) {
+      const cell = this.cells.get(ref);
+      if (!cell) continue;
+      for (const dep of cell.deps) {
+        if (affected.has(dep)) {
+          indegree.set(ref, indegree.get(ref)! + 1);
+        }
+      }
+    }
+
+    const queue: string[] = [];
+    for (const [ref, deg] of indegree) {
+      if (deg === 0) queue.push(ref);
+    }
+
+    const order: string[] = [];
+    while (queue.length > 0) {
+      const ref = queue.shift()!;
+      order.push(ref);
+      const dependents = this.dependents.get(ref);
+      if (!dependents) continue;
+      for (const dep of dependents) {
+        if (!affected.has(dep)) continue;
+        const deg = indegree.get(dep)! - 1;
+        indegree.set(dep, deg);
+        if (deg === 0) queue.push(dep);
+      }
+    }
+
+    return order;
+  }
+}
+
+/** Format a computed value for display. */
+function formatValue(value: CellValue): string {
+  if (value === null) return '';
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) return String(value);
+    // Trim binary floating-point noise (e.g. 0.1 + 0.2) for display.
+    return String(parseFloat(value.toPrecision(12)));
+  }
+  return value;
+}
