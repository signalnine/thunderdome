 collectDeps, evaluate, EvalError, CellValue } from './evaluator.js';\nimport { normalizeRef } from './references.js';\n\nexport { CellValue } from './evaluator.js';\n\n/** Raised when a `set` would introduce a circular dependency. */\nexport class CircularReferenceError extends Error {\n  constructor(message: string) {\n    super(message);\n    this.name = 'CircularReferenceError';\n  }\n}\n\ninterface Cell {\n  /** The raw input the user supplied. */\n  raw: string | number | boolean;\n  /** Parsed formula AST, or undefined for literal cells. */\n  ast?: Node;\n  /** Cells this cell directly depends on. */\n  deps: Set<string>;\n  /** Last computed value (an error code string if evaluation failed). */\n  value: CellValue;\n  /** Spreadsheet-style error code if the last evaluation failed. */\n  error?: string;\n}\n\nexport class Spreadsheet {\n  private cells = new Map<string, Cell>();\n  /** Reverse dependency index: ref -> set of cells that reference it. */\n  private dependents = new Map<string, Set<string>>();\n\n  /** Set a cell's value, either a literal or a formula string starting with \"=\". */\n  set(cell: string, value: string | number | boolean): void {\n    const ref = normalizeRef(cell);\n\n    let ast: Node | undefined;\n    let newDeps: Set<string>;\n\n    if (typeof value === 'string' && value.length > 1 && value.startsWith('=')) {\n      try {\n        ast = parse(value.slice(1));\n        newDeps = collectDeps(ast);\n      } catch {\n        // Unparseable formula: store as an error cell with no dependencies.\n        ast = undefined;\n        newDeps = new Set();\n        this.commit(ref, value, undefined, newDeps);\n        const existing = this.cells.get(ref)!;\n        existing.error = '#ERROR!';\n        existing.value = '#ERROR!';\n        this.recompute([ref]);\n        return;\n      }\n\n      if (this.wouldCreateCycle(ref, newDeps)) {\n        throw new CircularReferenceError(\n          `Setting ${ref} to \"${value}\" would create a circular reference`,\n        );\n      }\n    } else {\n      newDeps = new Set();\n    }\n\n    this.commit(ref, value, ast, newDeps);\n    this.recompute([ref]);\n  }\n\n  /** Get a cell's computed value. Returns null for empty cells. */\n  get(cell: string): CellValue {\n    const c = this.cells.get(normalizeRef(cell));\n    return c ? c.value : null;\n  }\n\n  /** Get the display string for a cell's computed value. */\n  getDisplay(cell: string): string {\n    return formatValue(this.get(cell));\n  }\n\n  /** Get all non-empty cells as a Map from cell reference to computed value. */\n  getCells(): Map<string, CellValue> {\n    const out = new Map<string, CellValue>();\n    for (const [ref, c] of this.cells) {\n      out.set(ref, c.value);\n    }\n    return out;\n  }\n\n  // --- internals -----------------------------------------------------------\n\n  /** Write a cell's new content and update the dependency indexes. */\n  private commit(\n    ref: string,\n    raw: string | number | boolean,\n    ast: Node | undefined,\n    newDeps: Set<string>,\n  ): void {\n    const existing = this.cells.get(ref);\n\n    // Detach from old dependencies.\n    if (existing) {\n      for (const dep of existing.deps) {\n        this.dependents.get(dep)?.delete(ref);\n      }\n    }\n\n    const cell: Cell = existing ?? { raw, deps: newDeps, value: null };\n    cell.raw = raw;\n    cell.ast = ast;\n    cell.deps = newDeps;\n    cell.error = undefined;\n    this.cells.set(ref, cell);\n\n    // Attach to new dependencies.\n    for (const dep of newDeps) {\n      let set = this.dependents.get(dep);\n      if (!set) {\n        set = new Set();\n        this.dependents.set(dep, set);\n      }\n      set.add(ref);\n    }\n  }\n\n  /**\n   * Determine whether giving `ref` the dependencies `newDeps` would form a\n   * cycle, by checking if `ref` is reachable from any of those dependencies\n   * through the existing dependency graph.\n   */\n  private wouldCreateCycle(ref: string, newDeps: 