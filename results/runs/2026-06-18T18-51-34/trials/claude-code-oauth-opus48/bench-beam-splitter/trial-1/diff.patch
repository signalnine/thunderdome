+import { describe, it, expect } from 'vitest';
+import { countBeamCells, countBeamPaths } from './index.js';
+
+const g = (rows: string[]): string[][] => rows.map((r) => r.split(' '));
+
+describe('countBeamCells', () => {
+  it('single splitter example', () => {
+    const grid = g(['. S . . .', '. . . . .', '. ^ . . .', '. . . . .']);
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('two splitters example', () => {
+    const grid = g(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('no splitters: a straight column', () => {
+    const grid = g(['S', '.', '.', '.']);
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('counts a cell once when two beams overlap', () => {
+    // overlap at (3,1) already covered by two-splitter example
+    const grid = g(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    const cells = countBeamCells(grid);
+    expect(cells).toBe(6);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('single splitter -> 2 paths', () => {
+    const grid = g(['. S . . .', '. . . . .', '. ^ . . .', '. . . . .']);
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('two splitters -> 4 paths (absorbed still counts as exit)', () => {
+    const grid = g(['. S . . .', '. ^ . . .', '^ . ^ . .', '. . . . .']);
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('no splitters -> 1 path', () => {
+    const grid = g(['S', '.', '.', '.']);
+    expect(countBeamPaths(grid)).toBe(1n);
+  });
+
+  it('full splitter triangle below source -> 2^(R-1) paths', () => {
+    // A wide grid that is all splitters below the source. Every beam splits on
+    // every row and none reach the side walls, so paths double each row.
+    const R = 30; // rows below the source where splitting happens
+    const cols = 2 * R + 5;
+    const mid = R + 2;
+    const grid: string[][] = [];
+    const top = Array(cols).fill('.');
+    top[mid] = 'S';
+    grid.push(top);
+    for (let r = 1; r <= R; r++) {
+      grid.push(Array(cols).fill('^'));
+    }
+    expect(countBeamPaths(grid)).toBe(2n ** BigInt(R));
+  });
+});
+
+describe('performance', () => {
+  it('200x200 grid with 50 splitters under 5s', () => {
+    const N = 200;
+    const grid: string[][] = [];
+    const top = Array(N).fill('.');
+    top[100] = 'S';
+    grid.push(top);
+    // Scatter 50 splitters across the grid.
+    for (let r = 1; r < N; r++) {
+      grid.push(Array(N).fill('.'));
+    }
+    let placed = 0;
+    for (let r = 1; r < N && placed < 50; r += 4) {
+      for (let c = 0; c < N && placed < 50; c += 50) {
+        grid[r][c] = '^';
+        placed++;
+      }
+    }
+    const start = Date.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = Date.now() - start;
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBeGreaterThan(0n);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
