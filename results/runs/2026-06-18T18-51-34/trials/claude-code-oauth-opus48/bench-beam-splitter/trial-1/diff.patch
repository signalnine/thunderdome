+// Beam propagation simulator for a 2D grid laboratory.
+//
+// Beams always advance one row downward per step, so row strictly increases
+// and the propagation graph is acyclic. We model a beam as a state
+// (row, col, dir) where `dir` is the column delta in {-1, 0, +1}.
+//
+// At a valid cell:
+//   - a splitter '^' consumes the beam and emits two beams: down-left
+//     (col-1, dir -1) and down-right (col+1, dir +1), regardless of the
+//     incoming direction.
+//   - any other cell ('.', 'S') passes the beam through in its current dir.
+// A beam that steps outside the grid is absorbed (an "exit").
+
+type Grid = string[][];
+
+function dimensions(grid: Grid): { rows: number; cols: number } {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  return { rows, cols };
+}
+
+// Locate every source cell. The spec guarantees sources sit on the top row,
+// but we scan defensively in case of multiple sources.
+function findSources(grid: Grid): Array<{ row: number; col: number }> {
+  const sources: Array<{ row: number; col: number }> = [];
+  for (let row = 0; row < grid.length; row++) {
+    for (let col = 0; col < grid[row].length; col++) {
+      if (grid[row][col] === 'S') sources.push({ row, col });
+    }
+  }
+  return sources;
+}
+
+// Encode a beam state into a single integer key for set/map use.
+function stateKey(row: number, col: number, dir: number, cols: number): number {
+  return (row * cols + col) * 3 + (dir + 1);
+}
+
+/**
+ * Count the distinct grid cells visited by any beam. A cell is counted once
+ * regardless of how many beams (or directions) traverse it.
+ */
+export function countBeamCells(grid: Grid): number {
+  const { rows, cols } = dimensions(grid);
+  if (rows === 0 || cols === 0) return 0;
+
+  const visitedStates = new Set<number>();
+  const visitedCells = new Set<number>();
+
+  // Stack of beams currently occupying a valid cell (entering with `dir`).
+  const stack: Array<{ row: number; col: number; dir: number }> = [];
+
+  const push = (row: number, col: number, dir: number): void => {
+    if (row < 0 || row >= rows || col < 0 || col >= cols) return; // absorbed
+    const key = stateKey(row, col, dir, cols);
+    if (visitedStates.has(key)) return;
+    visitedStates.add(key);
+    stack.push({ row, col, dir });
+  };
+
+  for (const { row, col } of findSources(grid)) {
+    push(row, col, 0); // source emits a beam straight down (dir 0)
+  }
+
+  while (stack.length > 0) {
+    const { row, col, dir } = stack.pop()!;
+    visitedCells.add(row * cols + col);
+
+    if (grid[row][col] === '^') {
+      push(row + 1, col - 1, -1);
+      push(row + 1, col + 1, 1);
+    } else {
+      push(row + 1, col + dir, dir);
+    }
+  }
+
+  return visitedCells.size;
+}
+
+/**
+ * Count the total number of distinct source-to-exit paths. Every split at a
+ * '^' creates two independent paths; a path completes when its beam exits the
+ * grid. Results can be astronomically large, so we return a bigint and use
+ * memoized path counting (O(rows * cols * 3) states) rather than enumeration.
+ */
+export function countBeamPaths(grid: Grid): bigint {
+  const { rows, cols } = dimensions(grid);
+  if (rows === 0 || cols === 0) return 0n;
+
+  // memo[stateKey] = number of exit paths for a beam entering that valid cell.
+  const memo = new Map<number, bigint>();
+
+  // Paths for a beam stepping into (row, col) with direction dir. An
+  // out-of-bounds step is a completed exit path worth 1.
+  const step = (row: number, col: number, dir: number): bigint => {
+    if (row < 0 || row >= rows || col < 0 || col >= cols) return 1n;
+
+    const key = stateKey(row, col, dir, cols);
+    const cached = memo.get(key);
+    if (cached !== undefined) return cached;
+
+    // Guard against unexpected revisits (rows strictly increase, so true
+    // cycles are impossible, but this keeps the memo self-consistent).
+    memo.set(key, 0n);
+
+    let paths: bigint;
+    if (grid[row][col] === '^') {
+      paths = step(row + 1, col - 1, -1) + step(row + 1, col + 1, 1);
+    } else {
+      paths = step(row + 1, col + dir, dir);
+    }
+
+    memo.set(key, paths);
+    return paths;
+  };
+
+  let total = 0n;
+  for (const { row, col } of findSources(grid)) {
+    total += step(row, col, 0);
+  }
+  return total;
+}
