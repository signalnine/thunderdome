+++ b/src/index.ts
@@ -0,0 +1,96 @@
+import { mkdirSync, readFileSync, writeFileSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  private load(): Entry[] {
+    try {
+      const raw = readFileSync(this.filePath, 'utf8');
+      const parsed = JSON.parse(raw) as Entry[];
+      return Array.isArray(parsed) ? parsed : [];
+    } catch {
+      return [];
+    }
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf8');
+  }
+
+  start(taskName: string): Entry {
+    if (taskName === '') {
+      throw new Error('taskName must not be empty');
+    }
+
+    const active = this.entries.find((e) => e.endTime === null);
+    if (active) {
+      active.endTime = new Date().toISOString();
+    }
+
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const active = this.entries.find((e) => e.endTime === null);
+    if (!active) {
+      throw new Error('No task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return active;
+  }
+
+  getActiveTask(): Entry | null {
+    return this.entries.find((e) => e.endTime === null) ?? null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    const since = options?.since;
+    if (!since) {
+      return [...this.entries];
+    }
+    const sinceMs = since.getTime();
+    return this.entries.filter((e) => {
+      if (new Date(e.startTime).getTime() >= sinceMs) {
+        return true;
+      }
+      if (e.endTime === null) {
+        return true;
+      }
+      return new Date(e.endTime).getTime() >= sinceMs;
+    });
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+    for (const e of this.entries) {
+      const start = new Date(e.startTime).getTime();
+      const end = e.endTime === null ? now : new Date(e.endTime).getTime();
+      const duration = end - start;
+      summary[e.taskName] = (summary[e.taskName] ?? 0) + duration;
+    }
+    return summary;
+  }
+}
