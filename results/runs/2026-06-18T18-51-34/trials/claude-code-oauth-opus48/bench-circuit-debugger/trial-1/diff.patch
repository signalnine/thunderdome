 i);\n  }\n  return inp;\n}\n\ndescribe('simulate', () => {\n  it('applies AND/OR/XOR correctly', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },\n    ];\n    const v = simulate(gates, { a: 1, b: 0 });\n    expect(v.and).toBe(0);\n    expect(v.or).toBe(1);\n    expect(v.xor).toBe(1);\n  });\n\n  it('resolves chained dependencies regardless of gate order', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'm', in2: 'n', out: 'out' }, // depends on m, n\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'm' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'n' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1 });\n    expect(v.m).toBe(0);\n    expect(v.n).toBe(1);\n    expect(v.out).toBe(0);\n  });\n\n  it('correctly adds numbers via the generated adder', () => {\n    const bits = 8;\n    const gates = buildAdder(bits);\n    for (const [x, y] of [\n      [0, 0],\n      [1, 1],\n      [255, 1],\n      [123, 45],\n      [200, 199],\n    ]) {\n      const v = simulate(gates, setInputs(x, y, bits));\n      expect(readZ(v, bits)).toBe(x + y);\n    }\n  });\n});\n\nfunction swapOutputs(gates: Gate[], w1: string, w2: string): void {\n  const g1 = gates.find((g) => g.out === w1)!;\n  const g2 = gates.find((g) => g.out === w2)!;\n  g1.out = w2;\n  g2.out = w1;\n}\n\n// deterministic PRNG so tests are reproducible\nfunction makeRng(seed: number): () => number {\n  let s = seed >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 0x100000000;\n  };\n}\n\ndescribe('findSwappedWires', () => {\n  it('finds 4 swapped pairs in adders of various sizes', () => {\n    for (const bits of [6, 8, 12, 20, 45]) {\n      const rng = makeRng(bits * 7 + 1);\n      const base = buildAdder(bits);\n      const wires = base.map((g) => g.out);\n\n      // pick 4 disjoint pairs of output wires to swap\n      const pool = [...wires];\n      const chosen: string[] = [];\n      for (let i = 0; i < 8; i++) {\n        const idx = Math.floor(rng() * pool.length);\n        chosen.push(pool.splice(idx, 1)[0]);\n      }\n      const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n      for (let i = 0; i < 8; i += 2) {\n        swapOutputs(swapped, chosen[i], chosen[i + 1]);\n      }\n\n      const expected = [...chosen].sort();\n      const result = findSwappedWires(swapped);\n      expect(result, `bits=${bits}`).toEqual(expected);\n    }\n  });\n\n  it('runs a 45-bit circuit in well under 5 seconds', () => {\n    const bits = 45;\n    const base = buildAdder(bits);\n    const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n    const outs = base.map((g) => g.out);\n    swapOutputs(swapped, outs[3], outs[10]);\n    swapOutputs(swapped, outs[20], outs[40]);\n    swapOutputs(swapped, outs[55], outs[70]);\n    swapOutputs(swapped, outs[90], outs[100]);\n\n    const start = Date.now();\n    const result = findSwappedWires(swapped);\n    const elapsed = Date.now() - start;\n    expect(result).toHaveLength(8);\n    expect(elapsed).toBeLessThan(5000);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8238,"cache_read_input_tokens":32639,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8238},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"866ce1d6-666d-4788-bad6-317cd13eca1e","uuid":"3f913a11-501c-4f3f-baad-c8d3bd2c3630","request_id":"req_011CcBFGYMSiAs4znEkwMbE1"}
