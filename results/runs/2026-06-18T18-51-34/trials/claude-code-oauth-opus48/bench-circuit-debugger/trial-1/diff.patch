JSON.parse(JSON.stringify(base)) as Gate[];\n      const expected: string[] = [];\n      for (const b of uniqueBits.slice(0, 4)) {\n        const z = `z${pad(b)}`;\n        const a = `a${pad(b)}`;\n        swapOutputs(swapped, z, a);\n        expected.push(z, a);\n      }\n      expected.sort();\n\n      // sanity: the swap actually broke the adder\n      expect(isCorrectAdder(swapped, bits), `bits=${bits} should be broken`).toBe(false);\n\n      const result = findSwappedWires(swapped);\n      expect(result, `bits=${bits}`).toEqual(expected);\n    }\n  });\n\n  it('detects mixed swap types (z<->b and partial-sum-feeding faults)', () => {\n    const bits = 16;\n    const base = buildAdder(bits);\n    const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n\n    const expected: string[] = [];\n    // z <-> b (propagate AND) at two bits\n    for (const b of [3, 9]) {\n      swapOutputs(swapped, `z${pad(b)}`, `b${pad(b)}`);\n      expected.push(`z${pad(b)}`, `b${pad(b)}`);\n    }\n    // z <-> a (generate AND) at two more bits\n    for (const b of [6, 12]) {\n      swapOutputs(swapped, `z${pad(b)}`, `a${pad(b)}`);\n      expected.push(`z${pad(b)}`, `a${pad(b)}`);\n    }\n    expected.sort();\n\n    expect(isCorrectAdder(swapped, bits)).toBe(false);\n    expect(findSwappedWires(swapped)).toEqual(expected);\n  });\n\n  it('returns nothing for a correct, unswapped adder', () => {\n    expect(findSwappedWires(buildAdder(16))).toEqual([]);\n  });\n\n  it('runs a 45-bit circuit in well under 5 seconds', () => {\n    const bits = 45;\n    const base = buildAdder(bits);\n    const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n    for (const b of [5, 17, 28, 39]) {\n      swapOutputs(swapped, `z${pad(b)}`, `a${pad(b)}`);\n    }\n\n    const start = Date.now();\n    const result = findSwappedWires(swapped);\n    const elapsed = Date.now() - start;\n    expect(result).toHaveLength(8);\n    expect(elapsed).toBeLessThan(5000);\n  });\n});","originalFile":"import { describe, it, expect } from 'vitest';\nimport { simulate, findSwappedWires, Gate } from './index.js';\n\nconst b2 = (n: number, bit: number): number => (n >> bit) & 1;\nconst pad = (n: number): string => n.toString().padStart(2, '0');\n\n/** Build a correct ripple-carry adder for `bits` input bits using AoC-style names. */\nfunction buildAdder(bits: number): Gate[] {\n  const gates: Gate[] = [];\n  // bit 0 half adder\n  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });\n  let carry = 'c00';\n  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: carry });\n\n  for (let i = 1; i < bits; i++) {\n    const xi = `x${pad(i)}`;\n    const yi = `y${pad(i)}`;\n    const t = `t${pad(i)}`;\n    const a = `a${pad(i)}`;\n    const bb = `b${pad(i)}`;\n    const c = `c${pad(i)}`;\n    gates.push({ op: 'XOR', in1: xi, in2: yi, out: t });\n    gates.push({ op: 'XOR', in1: t, in2: carry, out: `z${pad(i)}` });\n    gates.push({ op: 'AND', in1: xi, in2: yi, out: a });\n    gates.push({ op: 'AND', in1: t, in2: carry, out: bb });\n    gates.push({ op: 'OR', in1: a, in2: bb, out: c });\n    carry = c;\n  }\n  // final carry becomes the MSB output\n  // rename the last carry output to z(bits)\n  const last = gates[gates.length - 1];\n  last.out = `z${pad(bits)}`;\n  return gates;\n}\n\nfunction readZ(values: Record<string, number>, bits: number): number {\n  let n = 0;\n  for (let i = bits; i >= 0; i--) {\n    n = n * 2 + (values[`z${pad(i)}`] ?? 0);\n  }\n  return n;\n}\n\nfunction setInputs(x: number, y: number, bits: number): Record<string, number> {\n  const inp: Record<string, number> = {};\n  for (let i = 0; i < bits; i++) {\n    inp[`x${pad(i)}`] = b2(x, i);\n    inp[`y${pad(i)}`] = b2(y, i);\n  }\n  return inp;\n}\n\ndescribe('simulate', () => {\n  it('applies AND/OR/XOR correctly', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },\n    ];\n    const v = simulate(gates, { a: 1, b: 0 });\n    expect(v.and).toBe(0);\n    expect(v.or).toBe(1);\n    expect(v.xor).toBe(1);\n  });\n\n  it('resolves chained dependencies regardless of gate order', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'm', in2: 'n', out: 'out' }, // depends on m, n\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'm' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'n' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1 });\n    expect(v.m).toBe(0);\n    expect(v.n).toBe(1);\n    expect(v.out).toBe(0);\n  });\n\n  it('correctly adds numbers via the generated adder', () => {\n    const bits = 8;\n    const gates = buildAdder(bits);\n    for (const [x, y] of [\n      [0, 0],\n      [1, 1],\n      [255, 1],\n      [123, 45],\n      [200, 199],\n    ]) {\n      const v = simulate(gates, setInputs(x, y, bits));\n      expect(readZ(v, bits)).toBe(x + y);\n    }\n  });\n});\n\nfunction swapOutputs(gates: Gate[], w1: string, w2: string): void {\n  const g1 = gates.find((g) => g.out === w1)!;\n  const g2 = gates.find((g) => g.out === w2)!;\n  g1.out = w2;\n  g2.out = w1;\n}\n\n// deterministic PRNG so tests are reproducible\nfunction makeRng(seed: number): () => number {\n  let s = seed >>> 0;\n  return () => {\n    s = (s * 1664525 + 1013904223) >>> 0;\n    return s / 0x100000000;\n  };\n}\n\ndescribe('findSwappedWires', () => {\n  it('finds 4 swapped pairs in adders of various sizes', () => {\n    for (const bits of [6, 8, 12, 20, 45]) {\n      const rng = makeRng(bits * 7 + 1);\n      const base = buildAdder(bits);\n      const wires = base.map((g) => g.out);\n\n      // pick 4 disjoint pairs of output wires to swap\n      const pool = [...wires];\n      const chosen: string[] = [];\n      for (let i = 0; i < 8; i++) {\n        const idx = Math.floor(rng() * pool.length);\n        chosen.push(pool.splice(idx, 1)[0]);\n      }\n      const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n      for (let i = 0