@@ -0,0 +1,132 @@
+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string; // input wire name
+  in2: string; // input wire name
+  out: string; // output wire name
+}
+
+function applyOp(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Simulate the circuit. Gates fire once both of their input wires have a value.
+ * Returns the final value of every wire (inputs and gate outputs).
+ */
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+
+  // Repeatedly fire any gate whose inputs are both known. The circuit is
+  // acyclic, so each pass either fires at least one gate or we are done.
+  const pending = gates.slice();
+  let progress = true;
+  while (pending.length > 0 && progress) {
+    progress = false;
+    for (let i = pending.length - 1; i >= 0; i--) {
+      const g = pending[i];
+      const a = values[g.in1];
+      const b = values[g.in2];
+      if (a !== undefined && b !== undefined) {
+        values[g.out] = applyOp(g.op, a, b);
+        pending.splice(i, 1);
+        progress = true;
+      }
+    }
+  }
+
+  return values;
+}
+
+const isInput = (w: string): boolean => /^[xy]\d\d$/.test(w);
+const isOutput = (w: string): boolean => /^z\d\d$/.test(w);
+const isBitZero = (g: Gate): boolean =>
+  (g.in1 === 'x00' && g.in2 === 'y00') || (g.in1 === 'y00' && g.in2 === 'x00');
+
+/**
+ * The gates form a ripple-carry adder computing X + Y = Z, but exactly 4 pairs
+ * of gate output wires have been swapped (8 wires total). Find them.
+ *
+ * Rather than brute-forcing swap combinations, we exploit the rigid structure
+ * of a ripple-carry adder built from full adders. Each bit i (>= 1) is:
+ *   t_i = x_i XOR y_i          (partial sum)
+ *   z_i = t_i XOR c_{i-1}      (final sum, an output wire)
+ *   a_i = x_i AND y_i          (generate carry)
+ *   b_i = t_i AND c_{i-1}      (propagate carry)
+ *   c_i = a_i OR  b_i          (carry out)
+ * Bit 0 is a half adder: z00 = x00 XOR y00, c00 = x00 AND y00.
+ *
+ * A wire is mislabeled if its gate violates one of these structural rules.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const wrong = new Set<string>();
+
+  // Highest z wire is the final carry-out (produced by an OR gate).
+  let lastZ = '';
+  for (const g of gates) {
+    if (isOutput(g.out) && g.out > lastZ) lastZ = g.out;
+  }
+
+  // Map each wire to the gates that consume it as an input.
+  const consumers = new Map<string, Gate[]>();
+  const addConsumer = (wire: string, g: Gate): void => {
+    const list = consumers.get(wire);
+    if (list) list.push(g);
+    else consumers.set(wire, [g]);
+  };
+  for (const g of gates) {
+    addConsumer(g.in1, g);
+    addConsumer(g.in2, g);
+  }
+  const consumersOf = (w: string): Gate[] => consumers.get(w) ?? [];
+
+  for (const g of gates) {
+    const out = g.out;
+
+    if (isOutput(out)) {
+      // Final carry bit must come from an OR gate; every other z from a XOR.
+      if (out === lastZ) {
+        if (g.op !== 'OR') wrong.add(out);
+      } else if (g.op !== 'XOR') {
+        wrong.add(out);
+      }
+    }
+
+    if (g.op === 'XOR') {
+      if (isInput(g.in1) && isInput(g.in2)) {
+        // Partial-sum XOR (x_i XOR y_i). For bit 0 it directly produces z00.
+        // For higher bits it must feed a downstream XOR (and an AND), never an OR.
+        if (!isBitZero(g)) {
+          const cons = consumersOf(out);
+          if (!cons.some((c) => c.op === 'XOR') || cons.some((c) => c.op === 'OR')) {
+            wrong.add(out);
+          }
+        }
+      } else if (!isOutput(out)) {
+        // A XOR that isn't fed by inputs must produce an output (z) wire.
+        wrong.add(out);
+      }
+    }
+
+    if (g.op === 'AND' && !isBitZero(g)) {
+      // Generate/propagate AND gates feed only the carry OR gate.
+      for (const c of consumersOf(out)) {
+        if (c.op !== 'OR') {
+          wrong.add(out);
+          break;
+        }
+      }
+    }
+  }
+
+  return Array.from(wrong).sort();
+}
