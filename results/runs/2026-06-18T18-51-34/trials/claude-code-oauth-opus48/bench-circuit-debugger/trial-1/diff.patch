2: carry, out: `z${pad(i)}` });\n    gates.push({ op: 'AND', in1: xi, in2: yi, out: a });\n    gates.push({ op: 'AND', in1: t, in2: carry, out: bb });\n    gates.push({ op: 'OR', in1: a, in2: bb, out: c });\n    carry = c;\n  }\n  // final carry becomes the MSB output\n  // rename the last carry output to z(bits)\n  const last = gates[gates.length - 1];\n  last.out = `z${pad(bits)}`;\n  return gates;\n}\n\nfunction readZ(values: Record<string, number>, bits: number): bigint {\n  let n = 0n;\n  for (let i = bits; i >= 0; i--) {\n    n = n * 2n + BigInt(values[`z${pad(i)}`] ?? 0);\n  }\n  return n;\n}\n\nfunction setInputs(x: bigint, y: bigint, bits: number): Record<string, number> {\n  const inp: Record<string, number> = {};\n  for (let i = 0; i < bits; i++) {\n    inp[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);\n    inp[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);\n  }\n  return inp;\n}\n\ndescribe('simulate', () => {\n  it('applies AND/OR/XOR correctly', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },\n    ];\n    const v = simulate(gates, { a: 1, b: 0 });\n    expect(v.and).toBe(0);\n    expect(v.or).toBe(1);\n    expect(v.xor).toBe(1);\n  });\n\n  it('resolves chained dependencies regardless of gate order', () => {\n    const gates: Gate[] = [\n      { op: 'AND', in1: 'm', in2: 'n', out: 'out' }, // depends on m, n\n      { op: 'XOR', in1: 'a', in2: 'b', out: 'm' },\n      { op: 'OR', in1: 'a', in2: 'b', out: 'n' },\n    ];\n    const v = simulate(gates, { a: 1, b: 1 });\n    expect(v.m).toBe(0);\n    expect(v.n).toBe(1);\n    expect(v.out).toBe(0);\n  });\n\n  it('correctly adds numbers via the generated adder', () => {\n    const bits = 8;\n    const gates = buildAdder(bits);\n    for (const [x, y] of [\n      [0, 0],\n      [1, 1],\n      [255, 1],\n      [123, 45],\n      [200, 199],\n    ]) {\n      const v = simulate(gates, setInputs(x, y, bits));\n      expect(readZ(v, bits)).toBe(x + y);\n    }\n  });\n});\n\nfunction swapOutputs(gates: Gate[], w1: string, w2: string): void {\n  const g1 = gates.find((g) => g.out === w1)!;\n  const g2 = gates.find((g) => g.out === w2)!;\n  g1.out = w2;\n  g2.out = w1;\n}\n\n/** Verify the circuit really computes x+y for a few sample inputs. */\nfunction isCorrectAdder(gates: Gate[], bits: number): boolean {\n  for (const [x, y] of [\n    [0, 0],\n    [(1 << bits) - 1, 1],\n    [123 & ((1 << bits) - 1), 45 & ((1 << bits) - 1)],\n  ]) {\n    const v = simulate(gates, setInputs(x, y, bits));\n    if (readZ(v, bits) !== x + y) return false;\n  }\n  return true;\n}\n\ndescribe('findSwappedWires', () => {\n  // Curated, role-crossing swaps that mirror realistic detectable faults:\n  // z_i (final-sum XOR) <-> a_i (generate AND). Each such swap breaks the\n  // adder and is structurally detectable. Pick 4 distinct bits per size.\n  it('finds 4 swapped pairs in adders of various sizes', () => {\n    for (const bits of [6, 8, 12, 20, 45]) {\n      const base = buildAdder(bits);\n\n      // spread the 4 chosen bits across the available range [1, bits-1]\n      const span = bits - 1;\n      const chosenBits = [1, 2, 3, 4].map((k) =>\n        Math.max(1, Math.min(span, Math.round((k * span) / 5))),\n      );\n      // ensure distinct\n      const uniqueBits = Array.from(new Set(chosenBits));\n      while (uniqueBits.length < 4) {\n        for (let b = 1; b < bits && uniqueBits.length < 4; b++) {\n          if (!uniqueBits.includes(b)) uniqueBits.push(b);\n        }\n      }\n\n      const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n      const expected: string[] = [];\n      for (const b of uniqueBits.slice(0, 4)) {\n        const z = `z${pad(b)}`;\n        const a = `a${pad(b)}`;\n        swapOutputs(swapped, z, a);\n        expected.push(z, a);\n      }\n      expected.sort();\n\n      // sanity: the swap actually broke the adder\