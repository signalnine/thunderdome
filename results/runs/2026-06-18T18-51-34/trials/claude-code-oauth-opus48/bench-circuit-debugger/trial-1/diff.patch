pOutputs(swapped, z, a);\n        expected.push(z, a);\n      }\n      expected.sort();\n\n      // sanity: the swap actually broke the adder\n      expect(isCorrectAdder(swapped, bits), `bits=${bits} should be broken`).toBe(false);\n\n      const result = findSwappedWires(swapped);\n      expect(result, `bits=${bits}`).toEqual(expected);\n    }\n  });\n\n  it('detects mixed swap types (z<->b and partial-sum-feeding faults)', () => {\n    const bits = 16;\n    const base = buildAdder(bits);\n    const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n\n    const expected: string[] = [];\n    // z <-> b (propagate AND) at two bits\n    for (const b of [3, 9]) {\n      swapOutputs(swapped, `z${pad(b)}`, `b${pad(b)}`);\n      expected.push(`z${pad(b)}`, `b${pad(b)}`);\n    }\n    // z <-> a (generate AND) at two more bits\n    for (const b of [6, 12]) {\n      swapOutputs(swapped, `z${pad(b)}`, `a${pad(b)}`);\n      expected.push(`z${pad(b)}`, `a${pad(b)}`);\n    }\n    expected.sort();\n\n    expect(isCorrectAdder(swapped, bits)).toBe(false);\n    expect(findSwappedWires(swapped)).toEqual(expected);\n  });\n\n  it('returns nothing for a correct, unswapped adder', () => {\n    expect(findSwappedWires(buildAdder(16))).toEqual([]);\n  });\n\n  it('runs a 45-bit circuit in well under 5 seconds', () => {\n    const bits = 45;\n    const base = buildAdder(bits);\n    const swapped = JSON.parse(JSON.stringify(base)) as Gate[];\n    for (const b of [5, 17, 28, 39]) {\n      swapOutputs(swapped, `z${pad(b)}`, `a${pad(b)}`);\n    }\n\n    const start = Date.now();\n    const result = findSwappedWires(swapped);\n    const elapsed = Date.now() - start;\n    expect(result).toHaveLength(8);\n    expect(elapsed).toBeLessThan(5000);\n  });\n});"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2607,"cache_read_input_tokens":40877,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephem