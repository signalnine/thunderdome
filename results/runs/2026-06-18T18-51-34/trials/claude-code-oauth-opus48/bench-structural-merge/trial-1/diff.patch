t(history.length).toBe(3);\n    expect(history.map((v) => (v.content as any).x)).toEqual([1, 2, 3]);\n    for (let i = 1; i < history.length; i++) {\n      expect(history[i].timestamp).toBeGreaterThan(history[i - 1].timestamp);\n    }\n    const ids = new Set(history.map((v) => v.id));\n    expect(ids.size).toBe(3);\n  });\n\n  it('getVersion returns content at a version', () => {\n    store.create('a', { x: 1 });\n    store.update('a', { x: 2 });\n    const [v1, v2] = store.getHistory('a');\n    expect(store.getVersion('a', v1.id)).toEqual({ x: 1 });\n    expect(store.getVersion('a', v2.id)).toEqual({ x: 2 });\n    expect(() => store.getVersion('a', 'bogus')).toThrow();\n  });\n\n  it('getHistory throws for unknown doc', () => {\n    expect(() => store.getHistory('nope')).toThrow();\n  });\n});\n\ndescribe('branching', () => {\n  let store: DocumentStore;\n  beforeEach(() => { store = new DocumentStore(); });\n\n  it('default branch is main', () => {\n    expect(store.getBranch()).toBe('main');\n    expect(store.listBranches()).toEqual(['main']);\n  });\n\n  it('isolates changes between branches', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    expect(store.get('a')).toEqual({ x: 2 });\n    store.switchBranch('main');\n    expect(store.get('a')).toEqual({ x: 1 });\n  });\n\n  it('branch from a specified branch', () => {\n    store.create('a', { x: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('a', { x: 2 });\n    store.switchBranch('main');\n    store.createBranch('fromFeature', 'feature');\n    store.switchBranch('fromFeature');\n    expect(store.get('a')).toEqual({ x: 2 });\n  });\n\n  it('createBranch throws on dup, switch throws on missing', () => {\n    store.createBranch('f');\n    expect(() => store.createBranch('f')).toThrow();\n    expect(() => store.switchBranch('nope')).toThrow();\n    expect(() => sto