@@ -0,0 +1,328 @@
+// In-memory versioned document store with Git-style branching and three-way
+// structural merge.
+//
+// Internally the store is a commit DAG. Each branch is a named pointer to a
+// commit; every CRUD mutation appends a new commit on the current branch.
+// A commit holds the full snapshot of all live documents plus a record of the
+// versions created in that commit (used to reconstruct per-document history).
+
+import {
+  Conflict,
+  deepClone,
+  deepEqual,
+  mergeDocumentSets,
+} from './merge.js';
+
+export { Conflict };
+
+export interface Version {
+  id: string;
+  timestamp: number;
+  content: object;
+}
+
+export interface MergeResult {
+  /** documentId -> merged content. */
+  merged: Record<string, object>;
+  conflicts: Conflict[];
+  /** true if the merge was auto-applied to the current branch (no conflicts). */
+  applied: boolean;
+}
+
+interface Commit {
+  id: string;
+  parents: string[];
+  /** distance from the root commit, used for picking the merge base. */
+  depth: number;
+  /** Full snapshot of live documents at this commit: documentId -> content. */
+  state: Map<string, object>;
+  /** Versions produced by this commit: documentId -> version. */
+  versions: Map<string, Version>;
+}
+
+const DEFAULT_BRANCH = 'main';
+
+export class DocumentStore {
+  private commits = new Map<string, Commit>();
+  private branches = new Map<string, string>();
+  private current = DEFAULT_BRANCH;
+
+  private commitSeq = 0;
+  private versionSeq = 0;
+  private clock = 0;
+
+  constructor() {
+    const root: Commit = {
+      id: this.nextCommitId(),
+      parents: [],
+      depth: 0,
+      state: new Map(),
+      versions: new Map(),
+    };
+    this.commits.set(root.id, root);
+    this.branches.set(DEFAULT_BRANCH, root.id);
+  }
+
+  // ----- Document CRUD -------------------------------------------------------
+
+  create(id: string, content: object): void {
+    const state = this.headState();
+    if (state.has(id)) {
+      throw new Error(`Document "${id}" already exists on branch "${this.current}"`);
+    }
+    this.commitChange(id, deepClone(content));
+  }
+
+  get(id: string): object {
+    const content = this.headState().get(id);
+    if (content === undefined) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    return deepClone(content);
+  }
+
+  update(id: string, content: object): void {
+    const state = this.headState();
+    if (!state.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    this.commitChange(id, deepClone(content));
+  }
+
+  delete(id: string): void {
+    const state = this.headState();
+    if (!state.has(id)) {
+      throw new Error(`Document "${id}" does not exist on branch "${this.current}"`);
+    }
+    const next = new Map(state);
+    next.delete(id);
+    this.appendCommit([this.headId()], next, new Map());
+  }
+
+  // ----- Version history -----------------------------------------------------
+
+  getHistory(id: string): Version[] {
+    const versions = new Map<string, Version>();
+    for (const commit of this.ancestry(this.headId())) {
+      const version = commit.versions.get(id);
+      if (version) versions.set(version.id, version);
+    }
+    if (versions.size === 0) {
+      throw new Error(`Document "${id}" has no history on branch "${this.current}"`);
+    }
+    return [...versions.values()]
+      .sort((a, b) => a.timestamp - b.timestamp)
+      .map((v) => ({ ...v, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    for (const commit of this.ancestry(this.headId())) {
+      const version = commit.versions.get(id);
+      if (version && version.id === versionId) {
+        return deepClone(version.content);
+      }
+    }
+    throw new Error(`Version "${versionId}" of document "${id}" not found on branch "${this.current}"`);
+  }
+
+  // ----- Branching -----------------------------------------------------------
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const source = fromBranch ?? this.current;
+    const sourceHead = this.branches.get(source);
+    if (sourceHead === undefined) {
+      throw new Error(`Branch "${source}" does not exist`);
+    }
+    this.branches.set(name, sourceHead);
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" does not exist`);
+    }
+    this.current = name;
+  }
+
+  getBranch(): string {
+    return this.current;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  // ----- Merging -------------------------------------------------------------
+
+  merge(sourceBranch: string): MergeResult {
+    const theirsId = this.branches.get(sourceBranch);
+    if (theirsId === undefined) {
+      throw new Error(`Branch "${sourceBranch}" does not exist`);
+    }
+    if (sourceBranch === this.current) {
+      throw new Error('Cannot merge a branch into itself');
+    }
+
+    const oursId = this.headId();
+
+    // Nothing to do if both branches point at the same commit.
+    if (oursId === theirsId) {
+      return this.noopMerge();
+    }
+
+    const baseId = this.mergeBase(oursId, theirsId);
+
+    // Source has no new commits relative to us: no-op.
+    if (baseId === theirsId) {
+      return this.noopMerge();
+    }
+
+    // We have no commits of our own since the divergence: fast-forward to theirs.
+    if (baseId === oursId) {
+      this.branches.set(this.current, theirsId);
+      return {
+        merged: this.toRecord(this.commit(theirsId).state),
+        conflicts: [],
+        applied: true,
+      };
+    }
+
+    const base = this.commit(baseId).state;
+    const ours = this.commit(oursId).state;
+    const theirs = this.commit(theirsId).state;
+    const { merged, conflicts } = mergeDocumentSets(base, ours, theirs);
+
+    if (conflicts.length === 0) {
+      this.applyMerge(merged, [oursId, theirsId]);
+      return { merged: this.toRecord(merged), conflicts, applied: true };
+    }
+
+    // Conflicts: leave the current branch untouched, but still show the
+    // ours-favoured merged view.
+    return { merged: this.toRecord(merged), conflicts, applied: false };
+  }
+
+  // ----- Internals -----------------------------------------------------------
+
+  private noopMerge(): MergeResult {
+    return { merged: this.toRecord(this.headState()), conflicts: [], applied: true };
+  }
+
+  private toRecord(state: Map<string, object>): Record<string, object> {
+    const out: Record<string, object> = {};
+    for (const [id, content] of state) out[id] = deepClone(content);
+    return out;
+  }
+
+  private headId(): string {
+    return this.branches.get(this.current)!;
+  }
+
+  private headState(): Map<string, object> {
+    return this.commit(this.headId()).state;
+  }
+
+  private commit(id: string): Commit {
+    const commit = this.commits.get(id);
+    if (!commit) throw new Error(`Internal error: unknown commit "${id}"`);
+    return commit;
+  }
+
+  /** Append a commit that creates/updates a single document. */
+  private commitChange(id: string, content: object): void {
+    const next = new Map(this.headState());
+    next.set(id, content);
+    const version: Version = {
+      id: this.nextVersionId(),
+      timestamp: this.nextTimestamp(),
+      content,
+    };
+    this.appendCommit([this.headId()], next, new Map([[id, version]]));
+  }
+
+  private appendCommit(
+    parents: string[],
+    state: Map<string, object>,
+    versions: Map<string, Version>,
+  ): void {
+    const depth = Math.max(...parents.map((p) => this.commit(p).depth)) + 1;
+    const commit: Commit = {
+      id: this.nextCommitId(),
+      parents,
+      depth,
+      state,
+      versions,
+    };
+    this.commits.set(commit.id, commit);
+    this.branches.set(this.current, commit.id);
+  }
+
+  private applyMerge(merged: Map<string, object>, parents: string[]): void {
+    const ours = this.headState();
+    const versions = new Map<string, Version>();
+    // Record a new version for each document whose content changed or appeared.
+    for (const [id, content] of merged) {
+      if (!deepEqual(ours.get(id), content)) {
+        versions.set(id, {
+          id: this.nextVersionId(),
+          timestamp: this.nextTimestamp(),
+          content: deepClone(content),
+        });
+      }
+    }
+    const state = new Map<string, object>();
+    for (const [id, content] of merged) state.set(id, deepClone(content));
+    this.appendCommit(parents, state, versions);
+  }
+
+  /** All ancestors of `id` (including `id` itself). */
+  private ancestry(id: string): Commit[] {
+    const seen = new Set<string>();
+    const out: Commit[] = [];
+    const stack = [id];
+    while (stack.length > 0) {
+      const cur = stack.pop()!;
+      if (seen.has(cur)) continue;
+      seen.add(cur);
+      const commit = this.commit(cur);
+      out.push(commit);
+      stack.push(...commit.parents);
+    }
+    return out;
+  }
+
+  /**
+   * Lowest common ancestor of two commits: the deepest commit reachable from
+   * both. Good enough for the linear/single-merge histories this store builds.
+   */
+  private mergeBase(a: string, b: string): string {
+    const ancestorsA = new Set(this.ancestry(a).map((c) => c.id));
+    let best: Commit | undefined;
+    for (const commit of this.ancestry(b)) {
+      if (ancestorsA.has(commit.id)) {
+        if (!best || commit.depth > best.depth) best = commit;
+      }
+    }
+    if (!best) throw new Error('Internal error: no common ancestor');
+    return best.id;
+  }
+
+  private nextCommitId(): string {
+    return `c${++this.commitSeq}`;
+  }
+
+  private nextVersionId(): string {
+    return `v${++this.versionSeq}`;
+  }
+
+  /** Strictly increasing timestamp, seeded from wall-clock time. */
+  private nextTimestamp(): number {
+    const now = Date.now();
+    this.clock = now > this.clock ? now : this.clock + 1;
+    return this.clock;
+  }
+}
+
+export default DocumentStore;
