ivate clock = 0;\n\n  constructor() {\n    const root: Commit = {\n      id: this.nextCommitId(),\n      parents: [],\n      depth: 0,\n      state: new Map(),\n      versions: new Map(),\n    };\n    this.commits.set(root.id, root);\n    this.branches.set(DEFAULT_BRANCH, root.id);\n  }\n\n  // ----- Document CRUD -------------------------------------------------------\n\n  create(id: string, content: object): void {\n    const state = this.headState();\n    if (state.has(id)) {\n      throw new Error(`Document \"${id}\" already exists on branch \"${this.current}\"`);\n    }\n    this.commitChange(id, deepClone(content));\n  }\n\n  get(id: string): object {\n    const content = this.headState().get(id);\n    if (content === undefined) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.current}\"`);\n    }\n    return deepClone(content);\n  }\n\n  update(id: string, content: object): void {\n    const state = this.headState();\n    if (!state.has(id)) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.current}\"`);\n    }\n    this.commitChange(id, deepClone(content));\n  }\n\n  delete(id: string): void {\n    const state = this.headState();\n    if (!state.has(id)) {\n      throw new Error(`Document \"${id}\" does not exist on branch \"${this.current}\"`);\n    }\n    const next = new Map(state);\n    next.delete(id);\n    this.appendCommit([this.headId()], next, new Map());\n  }\n\n  // ----- Version history -----------------------------------------------------\n\n  getHistory(id: string): Version[] {\n    const versions = new Map<string, Version>();\n    for (const commit of this.ancestry(this.headId())) {\n      const version = commit.versions.get(id);\n      if (version) versions.set(version.id, version);\n    }\n    if (versions.size === 0) {\n      throw new Error(`Document \"${id}\" has no history on branch \"${this.current}\"`);\n    }\n    return [...versions.values()]\n      .sort((a, b) => a.timestamp - b.timestamp)\n      .map((v) => ({ ...v, content: deepClone(v.content) }));\n  }\n\n  getVersion(id: string, versionId: string): object {\n    for (const commit of this.ancestry(this.headId())) {\n      const version = commit.versions.get(id);\n      if (version && version.id === versionId) {\n        return deepClone(version.content);\n      }\n    }\n    throw new Error(`Version \"${versionId}\" of document \"${id}\" not found on branch \"${this.current}\"`);\n  }\n\n  // ----- Branching -----------------------------------------------------------\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" already exists`);\n    }\n    const source = fromBranch ?? this.current;\n    const sourceHead = this.branches.get(source);\n    if (sourceHead === undefined) {\n      throw new Error(`Branch \"${source}\" does not exist`);\n    }\n    this.branches.set(name, sourceHead);\n  }\n\n  switchBranch(name: string): void {\n    if (!this.branches.has(name)) {\n      throw new Error(`Branch \"${name}\" does not exist`);\n    }\n    this.current = name;\n  }\n\n  getBranch(): string {\n    return this.current;\n  }\n\n  listBranches(): string[] {\n    return [...this.branches.keys()];\n  }\n\n  // ----- Merging -------------------------------------------------------------\n\n  merge(sourceBranch: string): MergeResult {\n    const theirsId = this.branches.get(sourceBranch);\n    if (theirsId === undefined) {\n      throw new Error(`Branch \"${sourceBranch}\" does not exist`);\n    }\n    if (sourceBranch === this.current) {\n      throw new Error('Cannot merge a branch into itself');\n    }\n\n    const oursId = this.headId();\n\n    // Nothing to do if both branches point at the same commit.\n    if (oursId === theirsId) {\n      return this.noopMerge();\n    }\n\n    const baseId = this.mergeBase(oursId, theirsId);\n\n    // Source has no new commits relative to us: no-op.\n    if (baseId