+import { describe, it, expect, beforeEach } from 'vitest';
+import { DocumentStore } from './index.js';
+
+describe('CRUD', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('creates and gets', () => {
+    store.create('a', { x: 1 });
+    expect(store.get('a')).toEqual({ x: 1 });
+  });
+
+  it('throws on duplicate create', () => {
+    store.create('a', { x: 1 });
+    expect(() => store.create('a', { x: 2 })).toThrow();
+  });
+
+  it('throws on get missing / deleted', () => {
+    expect(() => store.get('nope')).toThrow();
+    store.create('a', { x: 1 });
+    store.delete('a');
+    expect(() => store.get('a')).toThrow();
+  });
+
+  it('update replaces content; throws if missing', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2, y: 3 });
+    expect(store.get('a')).toEqual({ x: 2, y: 3 });
+    expect(() => store.update('nope', {})).toThrow();
+  });
+
+  it('delete throws if missing', () => {
+    expect(() => store.delete('nope')).toThrow();
+  });
+
+  it('deep clones on store and retrieval', () => {
+    const input = { nested: { v: 1 } };
+    store.create('a', input);
+    input.nested.v = 99;
+    expect(store.get('a')).toEqual({ nested: { v: 1 } });
+    const got = store.get('a') as { nested: { v: number } };
+    got.nested.v = 42;
+    expect(store.get('a')).toEqual({ nested: { v: 1 } });
+  });
+});
+
+describe('version history', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('records versions chronologically', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2 });
+    store.update('a', { x: 3 });
+    const history = store.getHistory('a');
+    expect(history.length).toBe(3);
+    expect(history.map((v) => (v.content as { x: number }).x)).toEqual([1, 2, 3]);
+    for (let i = 1; i < history.length; i++) {
+      expect(history[i].timestamp).toBeGreaterThan(history[i - 1].timestamp);
+    }
+    const ids = new Set(history.map((v) => v.id));
+    expect(ids.size).toBe(3);
+  });
+
+  it('getVersion returns content at a version', () => {
+    store.create('a', { x: 1 });
+    store.update('a', { x: 2 });
+    const [v1, v2] = store.getHistory('a');
+    expect(store.getVersion('a', v1.id)).toEqual({ x: 1 });
+    expect(store.getVersion('a', v2.id)).toEqual({ x: 2 });
+    expect(() => store.getVersion('a', 'bogus')).toThrow();
+  });
+
+  it('getHistory throws for unknown doc', () => {
+    expect(() => store.getHistory('nope')).toThrow();
+  });
+});
+
+describe('branching', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('default branch is main', () => {
+    expect(store.getBranch()).toBe('main');
+    expect(store.listBranches()).toEqual(['main']);
+  });
+
+  it('isolates changes between branches', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('a', { x: 2 });
+    expect(store.get('a')).toEqual({ x: 2 });
+    store.switchBranch('main');
+    expect(store.get('a')).toEqual({ x: 1 });
+  });
+
+  it('branch from a specified branch', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('a', { x: 2 });
+    store.switchBranch('main');
+    store.createBranch('fromFeature', 'feature');
+    store.switchBranch('fromFeature');
+    expect(store.get('a')).toEqual({ x: 2 });
+  });
+
+  it('createBranch throws on dup, switch throws on missing', () => {
+    store.createBranch('f');
+    expect(() => store.createBranch('f')).toThrow();
+    expect(() => store.switchBranch('nope')).toThrow();
+    expect(() => store.createBranch('g', 'nope')).toThrow();
+  });
+
+  it('new branch sees existing docs from creation point', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    expect(store.get('a')).toEqual({ x: 1 });
+    expect(store.getHistory('a').length).toBe(1);
+  });
+});
+
+describe('merging', () => {
+  let store: DocumentStore;
+  beforeEach(() => { store = new DocumentStore(); });
+
+  it('no-op merge when nothing changed', () => {
+    store.create('a', { x: 1 });
+    store.createBranch('f');
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.conflicts).toEqual([]);
+  });
+
+  it('takes one-sided field changes without conflict', () => {
+    store.create('doc', { a: 1, b: 2 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: 1, b: 99 }); // change b
+    store.switchBranch('main');
+    store.update('doc', { a: 50, b: 2 }); // change a
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.conflicts).toEqual([]);
+    expect(res.merged.doc).toEqual({ a: 50, b: 99 });
+    expect(store.get('doc')).toEqual({ a: 50, b: 99 });
+  });
+
+  it('same field changed to same value => no conflict', () => {
+    store.create('doc', { a: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: 7 });
+    store.switchBranch('main');
+    store.update('doc', { a: 7 });
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged.doc).toEqual({ a: 7 });
+  });
+
+  it('same field changed to different values => conflict, not applied', () => {
+    store.create('doc', { a: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: 2 });
+    store.switchBranch('main');
+    store.update('doc', { a: 3 });
+    const res = store.merge('f');
+    expect(res.applied).toBe(false);
+    expect(res.conflicts).toEqual([
+      { documentId: 'doc', path: 'a', base: 1, ours: 3, theirs: 2 },
+    ]);
+    // merged view favours ours
+    expect(res.merged.doc).toEqual({ a: 3 });
+    // current branch unchanged
+    expect(store.get('doc')).toEqual({ a: 3 });
+  });
+
+  it('nested conflict path is dot-separated', () => {
+    store.create('doc', { a: { b: { c: 1 } } });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: { b: { c: 2 } } });
+    store.switchBranch('main');
+    store.update('doc', { a: { b: { c: 3 } } });
+    const res = store.merge('f');
+    expect(res.applied).toBe(false);
+    expect(res.conflicts[0].path).toBe('a.b.c');
+    expect(res.conflicts[0]).toMatchObject({ base: 1, ours: 3, theirs: 2 });
+  });
+
+  it('nested non-conflicting fields merge cleanly', () => {
+    store.create('doc', { a: { x: 1, y: 1 } });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: { x: 1, y: 2 } });
+    store.switchBranch('main');
+    store.update('doc', { a: { x: 5, y: 1 } });
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged.doc).toEqual({ a: { x: 5, y: 2 } });
+  });
+
+  it('independent documents merge with no conflict', () => {
+    store.create('d1', { v: 1 });
+    store.create('d2', { v: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('d1', { v: 2 });
+    store.switchBranch('main');
+    store.update('d2', { v: 2 });
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged).toEqual({ d1: { v: 2 }, d2: { v: 2 } });
+  });
+
+  it('new document on source is added', () => {
+    store.create('d1', { v: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.create('d2', { v: 9 });
+    store.switchBranch('main');
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged).toEqual({ d1: { v: 1 }, d2: { v: 9 } });
+    expect(store.get('d2')).toEqual({ v: 9 });
+  });
+
+  it('fast-forward when current has no own changes', () => {
+    store.create('d1', { v: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('d1', { v: 2 });
+    store.create('d2', { v: 3 });
+    store.switchBranch('main');
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(store.get('d1')).toEqual({ v: 2 });
+    expect(store.get('d2')).toEqual({ v: 3 });
+  });
+
+  it('key added on one side only is kept', () => {
+    store.create('doc', { a: 1 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: 1, newKey: 'x' });
+    store.switchBranch('main');
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged.doc).toEqual({ a: 1, newKey: 'x' });
+  });
+
+  it('key deleted on one side, untouched on other => deleted', () => {
+    store.create('doc', { a: 1, b: 2 });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: 1 }); // delete b
+    store.switchBranch('main');
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged.doc).toEqual({ a: 1 });
+  });
+
+  it('arrays are treated atomically', () => {
+    store.create('doc', { list: [1, 2] });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { list: [1, 2, 3] });
+    store.switchBranch('main');
+    const res = store.merge('f');
+    expect(res.applied).toBe(true);
+    expect(res.merged.doc).toEqual({ list: [1, 2, 3] });
+  });
+
+  it('conflicting array values produce a conflict', () => {
+    store.create('doc', { list: [1] });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { list: [1, 2] });
+    store.switchBranch('main');
+    store.update('doc', { list: [1, 3] });
+    const res = store.merge('f');
+    expect(res.applied).toBe(false);
+    expect(res.conflicts[0].path).toBe('list');
+  });
+
+  it('merge result does not leak references', () => {
+    store.create('doc', { a: { n: 1 } });
+    store.createBranch('f');
+    store.switchBranch('f');
+    store.update('doc', { a: { n: 1 }, extra: 1 });
+    store.switchBranch('main');
+    const res = store.merge('f');
+    (res.merged.doc as { a: { n: number } }).a.n = 999;
+    expect(store.get('doc')).toEqual({ a: { n: 1 }, extra: 1 });
+  });
+
+  it('throws merging unknown branch or self', () => {
+    expect(() => store.merge('nope')).toThrow();
+    expect(() => store.merge('main')).toThrow();
+  });
+});
