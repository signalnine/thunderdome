Id(),\n      timestamp: this.nextTimestamp(),\n      content,\n    };\n    this.appendCommit([this.headId()], next, new Map([[id, version]]));\n  }\n\n  private appendCommit(\n    parents: string[],\n    state: Map<string, object>,\n    versions: Map<string, Version>,\n  ): void {\n    const depth = Math.max(...parents.map((p) => this.commit(p).depth)) + 1;\n    const commit: Commit = {\n      id: this.nextCommitId(),\n      parents,\n      depth,\n      state,\n      versions,\n    };\n    this.commits.set(commit.id, commit);\n    this.branches.set(this.current, commit.id);\n  }\n\n  private applyMerge(merged: Map<string, object>, parents: string[]): void {\n    const ours = this.headState();\n    const versions = new Map<string, Version>();\n    // Record a new version for each document whose content changed or appeared.\n    for (const [id, content] of merged) {\n      if (!deepEqual(ours.get(id), content)) {\n        versions.set(id, {\n          id: this.nextVersionId(),\n          timestamp: this.nextTimestamp(),\n          content: deepClone(content),\n        });\n      }\n    }\n    const state = new Map<string, object>();\n    for (const [id, content] of merged) state.set(id, deepClone(content));\n    this.appendCommit(parents, state, versions);\n  }\n\n  /** All ancestors of `id` (including `id` itself). */\n  private ancestry(id: string): Commit[] {\n    const seen = new Set<string>();\n    const out: Commit[] = [];\n    const stack = [id];\n    while (stack.length > 0) {\n      const cur = stack.pop()!;\n      if (seen.has(cur)) continue;\n      seen.add(cur);\n      const commit = this.commit(cur);\n      out.push(commit);\n      stack.push(...commit.parents);\n    }\n    return out;\n  }\n\n  /**\n   * Lowest common ancestor of two commits: the deepest commit reachable from\n   * both. Good enough for the linear/single-merge histories this store builds.\n   */\n  private mergeBase(a: string, b: string): string {\n    const ancestorsA = new Set(this.ancestry(a).map((c) => c.id));\n    let best: Commit | undefined;\n    for (const commit of this.ancestry(b)) {\n      if (ancestorsA.has(commit.id)) {\n        if (!best || commit.depth > best.depth) best = commit;\n      }\n    }\n    if (!best) throw new Error('Internal error: no common ancestor');\n    return best.id;\n  }\n\n  private nextCommitId(): string {\n    return `c${++this.commitSeq}`;\n  }\n\n  private nextVersionId(): string {\n    return `v${++this.versionSeq}`;\n  }\n\n  /** Strictly increasing timestamp, seeded from wall-clock time. */\n  private nextTimestamp(): number {\n    const now = Date.now();\n    this.clock = now > this.clock ? now : this.clock + 1;\n    return this.clock;\n  }\n}\n\nexport default DocumentStore;\n","structuredPatch":[],"originalFile":null,"userModified":false}}
