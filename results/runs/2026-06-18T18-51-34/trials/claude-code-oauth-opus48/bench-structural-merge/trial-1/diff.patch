+// Three-way structural merge of JSON values.
+//
+// The merge is field-aware for plain objects: it recurses into nested objects
+// and treats everything else (primitives, arrays, null) as an atomic leaf.
+// Arrays are intentionally compared as whole values rather than merged
+// element-by-element.
+
+export type Json = unknown;
+
+export interface Conflict {
+  documentId: string;
+  /** Dot-separated path within the document, e.g. "a.b.c". Empty for the document root. */
+  path: string;
+  base: Json;
+  ours: Json;
+  theirs: Json;
+}
+
+/** A conflict without the documentId, produced while merging a single document. */
+interface FieldConflict {
+  path: string;
+  base: Json;
+  ours: Json;
+  theirs: Json;
+}
+
+interface MergeOutcome {
+  /** The merged value, or `undefined` when the key/document is absent or deleted. */
+  value: Json | undefined;
+  conflicts: FieldConflict[];
+}
+
+export function isPlainObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+export function deepEqual(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (a === null || b === null || a === undefined || b === undefined) {
+    return a === b;
+  }
+  if (Array.isArray(a) || Array.isArray(b)) {
+    if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false;
+    return a.every((item, i) => deepEqual(item, b[i]));
+  }
+  if (isPlainObject(a) && isPlainObject(b)) {
+    const aKeys = Object.keys(a);
+    const bKeys = Object.keys(b);
+    if (aKeys.length !== bKeys.length) return false;
+    return aKeys.every((key) => key in b && deepEqual(a[key], b[key]));
+  }
+  return false;
+}
+
+export function deepClone<T>(value: T): T {
+  return structuredClone(value);
+}
+
+/**
+ * Three-way merge a single value. `base`/`ours`/`theirs` may be `undefined` to
+ * signal an absent key or a deleted document.
+ *
+ * Resolution order:
+ *  - ours == theirs                  -> that value (no conflict)
+ *  - ours == base (we didn't change) -> theirs
+ *  - theirs == base (they didn't)    -> ours
+ *  - both objects                    -> recurse per key
+ *  - otherwise                       -> conflict, resolved in favour of ours
+ */
+function mergeValue(base: Json, ours: Json, theirs: Json, path: string): MergeOutcome {
+  if (deepEqual(ours, theirs)) return { value: ours, conflicts: [] };
+  if (deepEqual(ours, base)) return { value: theirs, conflicts: [] };
+  if (deepEqual(theirs, base)) return { value: ours, conflicts: [] };
+
+  // Both sides changed differently. If both are objects we can still merge
+  // them field-by-field; conflicts only arise on the leaves that truly clash.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? base : {};
+    const result: Record<string, unknown> = {};
+    const conflicts: FieldConflict[] = [];
+    const keys = new Set([
+      ...Object.keys(baseObj),
+      ...Object.keys(ours),
+      ...Object.keys(theirs),
+    ]);
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const outcome = mergeValue(baseObj[key], ours[key], theirs[key], childPath);
+      conflicts.push(...outcome.conflicts);
+      if (outcome.value !== undefined) result[key] = outcome.value;
+    }
+    return { value: result, conflicts };
+  }
+
+  // Leaf conflict: keep "ours" in the merged view.
+  return { value: ours, conflicts: [{ path, base, ours, theirs }] };
+}
+
+export interface DocMergeResult {
+  /** documentId -> merged content (deleted documents are omitted). */
+  merged: Map<string, object>;
+  conflicts: Conflict[];
+}
+
+/**
+ * Merge whole document sets. Each map is documentId -> content for the live
+ * documents in that snapshot.
+ */
+export function mergeDocumentSets(
+  base: Map<string, object>,
+  ours: Map<string, object>,
+  theirs: Map<string, object>,
+): DocMergeResult {
+  const merged = new Map<string, object>();
+  const conflicts: Conflict[] = [];
+
+  const ids = new Set([...base.keys(), ...ours.keys(), ...theirs.keys()]);
+  for (const id of ids) {
+    const outcome = mergeValue(base.get(id), ours.get(id), theirs.get(id), '');
+    for (const c of outcome.conflicts) {
+      conflicts.push({ documentId: id, ...c });
+    }
+    if (outcome.value !== undefined) {
+      merged.set(id, deepClone(outcome.value) as object);
+    }
+  }
+
+  return { merged, conflicts };
+}
