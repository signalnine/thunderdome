+import { randomUUID } from 'node:crypto';
+import type { Server } from 'node:http';
+import { WebSocketServer, WebSocket } from 'ws';
+import type Database from 'better-sqlite3';
+import type { Document, Operation, Version } from './models.js';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+
+interface Room {
+  clients: Set<WebSocket>;
+  version: number;
+  content: string;
+}
+
+function send(ws: WebSocket, payload: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(payload));
+  }
+}
+
+function parseOperation(raw: unknown): Operation | null {
+  if (!raw || typeof raw !== 'object') return null;
+  const op = raw as Record<string, unknown>;
+  if (op.type === 'insert' && typeof op.position === 'number' && typeof op.text === 'string') {
+    return { type: 'insert', position: op.position, text: op.text };
+  }
+  if (op.type === 'delete' && typeof op.position === 'number' && typeof op.count === 'number') {
+    return { type: 'delete', position: op.position, count: op.count };
+  }
+  return null;
+}
+
+export function createWss(server: Server, db: Database.Database): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Room>();
+
+  function getRoom(docId: string): Room | null {
+    let room = rooms.get(docId);
+    if (room) return room;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as
+      | Document
+      | undefined;
+    if (!doc) return null;
+    const latest = db
+      .prepare(
+        'SELECT MAX(version) as version FROM versions WHERE document_id = ?'
+      )
+      .get(docId) as { version: number | null };
+    room = {
+      clients: new Set(),
+      version: latest.version ?? 0,
+      content: doc.content,
+    };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  wss.on('connection', (ws: WebSocket, req) => {
+    const docId = decodeURIComponent((req.url ?? '/').replace(/^\//, '').split('?')[0]);
+    const room = getRoom(docId);
+
+    if (!room) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+
+    const connId = randomUUID();
+    db.prepare(
+      'INSERT INTO active_connections (id, document_id) VALUES (?, ?)'
+    ).run(connId, docId);
+    room.clients.add(ws);
+
+    // Send the current document state.
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      let message: Record<string, unknown>;
+      try {
+        message = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+
+      if (message.type !== 'operation') {
+        send(ws, { type: 'error', message: 'Unknown message type' });
+        return;
+      }
+
+      const op = parseOperation(message.operation);
+      if (!op) {
+        send(ws, { type: 'error', message: 'Invalid operation' });
+        return;
+      }
+
+      // Transform the incoming op against every operation applied since its
+      // base version so concurrent edits converge.
+      const baseVersion =
+        typeof message.version === 'number' ? message.version : room.version;
+      let transformed: Operation = op;
+      const priorOps = db
+        .prepare(
+          'SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC'
+        )
+        .all(docId, baseVersion) as Pick<Version, 'operation'>[];
+      for (const row of priorOps) {
+        if (!row.operation) continue;
+        const prior = parseOperation(JSON.parse(row.operation));
+        if (prior) transformed = transformOperation(transformed, prior);
+      }
+
+      if (!validateOperation(transformed, room.content.length)) {
+        send(ws, { type: 'error', message: 'Invalid operation bounds' });
+        return;
+      }
+
+      // Apply, persist, and bump the version atomically (synchronous).
+      room.content = applyOperation(room.content, transformed);
+      room.version += 1;
+      const newVersion = room.version;
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+      ).run(docId, newVersion, room.content, JSON.stringify(transformed));
+      db.prepare(
+        "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?"
+      ).run(room.content, docId);
+
+      // Acknowledge the sender; broadcast the applied op to everyone else.
+      send(ws, { type: 'ack', version: newVersion });
+      for (const client of room.clients) {
+        if (client !== ws) {
+          send(client, { type: 'operation', operation: transformed, version: newVersion });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connId);
+    });
+
+    ws.on('error', () => {
+      room.clients.delete(ws);
+    });
+  });
+
+  return wss;
+}
