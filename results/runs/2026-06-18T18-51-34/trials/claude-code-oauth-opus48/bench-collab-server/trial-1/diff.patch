@@ -0,0 +1,53 @@
+import { createServer, type Server } from 'node:http';
+import express, { type Express } from 'express';
+import type { WebSocketServer } from 'ws';
+import type Database from 'better-sqlite3';
+import { createDb } from './db.js';
+import { createRouter } from './routes.js';
+import { createWss } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  db: Database.Database;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+/**
+ * Build the combined Express + WebSocket application. Pass a file path for
+ * persistence, or omit for an isolated in-memory database.
+ */
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDb(dbPath);
+  const app = express();
+  app.use(express.json());
+  app.use(createRouter(db));
+
+  const server = createServer(app);
+  const wss = createWss(server, db);
+
+  const start = (port = 0): Promise<number> =>
+    new Promise((resolve) => {
+      server.listen(port, () => {
+        const addr = server.address();
+        resolve(typeof addr === 'object' && addr !== null ? addr.port : port);
+      });
+    });
+
+  const stop = (): Promise<void> =>
+    new Promise((resolve) => {
+      for (const client of wss.clients) {
+        client.terminate();
+      }
+      wss.close(() => {
+        server.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    });
+
+  return { app, server, wss, db, start, stop };
+}
