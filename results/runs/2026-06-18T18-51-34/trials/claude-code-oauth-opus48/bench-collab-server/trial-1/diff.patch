@@ -0,0 +1,68 @@
+import type { Operation } from './models.js';
+
+/**
+ * Apply an operation to document content, returning the new content.
+ * Assumes the operation has already been validated.
+ */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/**
+ * Validate that an operation is well-formed and in bounds for the given
+ * content length. Returns true if the operation can be safely applied.
+ */
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (!op || (op.type !== 'insert' && op.type !== 'delete')) return false;
+  if (!Number.isInteger(op.position) || op.position < 0 || op.position > contentLength) {
+    return false;
+  }
+  if (op.type === 'insert') {
+    return typeof op.text === 'string';
+  }
+  return (
+    Number.isInteger(op.count) &&
+    op.count >= 0 &&
+    op.position + op.count <= contentLength
+  );
+}
+
+/**
+ * Transform op1 so that it can be applied after op2 (which is treated as
+ * having already been applied to the same base document). Positions are
+ * adjusted so that both operations' intents are preserved.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op2.type === 'insert') {
+    const shift = op2.text.length;
+    // Insertions strictly before op1 push op1 to the right. Ties resolve by
+    // shifting op1 after op2 so both insertions are preserved.
+    if (op1.position < op2.position) return op1;
+    return { ...op1, position: op1.position + shift };
+  }
+
+  // op2 is a delete removing [p2, p2 + c2)
+  const p2 = op2.position;
+  const c2 = op2.count;
+
+  if (op1.type === 'insert') {
+    if (op1.position <= p2) return op1;
+    if (op1.position >= p2 + c2) return { ...op1, position: op1.position - c2 };
+    // op1 falls inside the deleted range; collapse to the deletion start.
+    return { ...op1, position: p2 };
+  }
+
+  // delete vs delete
+  const p1 = op1.position;
+  const c1 = op1.count;
+  if (p1 >= p2 + c2) return { ...op1, position: p1 - c2 };
+  if (p1 + c1 <= p2) return op1;
+  // Overlapping deletes: remove the portion already deleted by op2.
+  const overlapStart = Math.max(p1, p2);
+  const overlapEnd = Math.min(p1 + c1, p2 + c2);
+  const overlap = Math.max(0, overlapEnd - overlapStart);
+  return { ...op1, position: Math.min(p1, p2), count: Math.max(0, c1 - overlap) };
+}
