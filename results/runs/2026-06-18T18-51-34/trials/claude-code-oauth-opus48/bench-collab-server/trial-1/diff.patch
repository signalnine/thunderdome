+import { randomUUID } from 'node:crypto';
+import { Router, type Request, type Response } from 'express';
+import type Database from 'better-sqlite3';
+import type { Document, Version } from './models.js';
+
+export function createRouter(db: Database.Database): Router {
+  const router = Router();
+
+  const getDoc = db.prepare('SELECT * FROM documents WHERE id = ?');
+
+  // POST /docs - create a document
+  router.post('/docs', (req: Request, res: Response) => {
+    const title = typeof req.body?.title === 'string' ? req.body.title : 'Untitled';
+    const content = typeof req.body?.content === 'string' ? req.body.content : '';
+    const id = randomUUID();
+
+    db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(
+      id,
+      title,
+      content
+    );
+    // Record the initial state as version 0.
+    db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'
+    ).run(id, content);
+
+    const doc = getDoc.get(id) as Document;
+    res.status(201).json(doc);
+  });
+
+  // GET /docs - list documents
+  router.get('/docs', (_req: Request, res: Response) => {
+    const docs = db
+      .prepare('SELECT * FROM documents ORDER BY created_at ASC')
+      .all() as Document[];
+    res.json(docs);
+  });
+
+  // GET /docs/:id - fetch a document
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDoc.get(req.params.id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  // PUT /docs/:id - update a document's title (and optionally content)
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDoc.get(req.params.id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const title = typeof req.body?.title === 'string' ? req.body.title : doc.title;
+    const content =
+      typeof req.body?.content === 'string' ? req.body.content : doc.content;
+    db.prepare(
+      "UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?"
+    ).run(title, content, req.params.id);
+    res.json(getDoc.get(req.params.id) as Document);
+  });
+
+  // DELETE /docs/:id - delete a document
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    const info = db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);
+    if (info.changes === 0) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.status(204).end();
+  });
+
+  // GET /docs/:id/versions - list version history
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    const doc = getDoc.get(req.params.id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versions = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')
+      .all(req.params.id) as Version[];
+    res.json(versions);
+  });
+
+  // GET /docs/:id/versions/:version - fetch a specific version
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    const version = Number(req.params.version);
+    const row = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')
+      .get(req.params.id, version) as Version | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.json(row);
+  });
+
+  return router;
+}
