+// ---------------------------------------------------------------------------
+// Rule 4: prerequisites
+// ---------------------------------------------------------------------------
+
+describe('prerequisites', () => {
+  it('orders a prerequisite before its dependent with a gap', () => {
+    const events: Event[] = [
