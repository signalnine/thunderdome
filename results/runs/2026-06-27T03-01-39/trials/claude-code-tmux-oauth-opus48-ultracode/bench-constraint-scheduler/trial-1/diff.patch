+// ---------------------------------------------------------------------------
+// Rule 7: batch optimization (maximize the number scheduled)
+// ---------------------------------------------------------------------------
+
+describe('maximization', () => {
+  it('prefers two short events over one long event in a tight window', () => {
+    // Greedy-by-input order would place A (50) first and fit nothing else (1).
+    // Optimal drops A and schedules B + C (2).
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 50 },
+      { id: 'b', name: 'B', duration: 5 },
+      { id: 'c', name: 'C', duration: 5 },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const opts = { startTime: 0, endTime: 60, gap: 15 };
+    const r = schedule(events, rooms, opts);
+    expect(r.assignments).toHaveLength(2);
+    expect(r.unscheduled).toEqual(['a']);
+    assertValid(events, rooms, opts, r);
+  });
+
+  it('reasons about scarce rooms to maximize placements', () => {
+    // X and Y (5 attendees) only fit the big room, which holds one 30m event in
+    // the window. Z (2 attendees) fits either room. Greedily putting Z in the
+    // big room would block both X and Y (count 1). Optimal: one of X/Y in big,
+    // Z in small -> count 2.
+    const events: Event[] = [
+      { id: 'z', name: 'Z', duration: 30, attendees: 2 },
+      { id: 'x', name: 'X', duration: 30, attendees: 5 },
+      { id: 'y', name: 'Y', duration: 30, attendees: 5 },
+    ];
+    const rooms: Room[] = [
+      { id: 'big', name: 'Big', capacity: 8 },
+      { id: 'small', name: 'Small', capacity: 4 },
+    ];
+    const opts = { startTime: 0, endTime: 60, gap: 15 };
+    const r = schedule(events, rooms, opts);
+    expect(r.assignments).toHaveLength(2);
+    assertValid(events, rooms, opts, r);
+    // Z must be scheduled (it is the flexible one).
+    expect(r.assignments.some((a) => a.eventId === 'z')).toBe(true);
+  });
+
+  it('schedules everything when the window is roomy', () => {
+    const events: Event[] = Array.from({ length: 6 }, (_, i) => ({
+      id: `e${i}`,
+      name: `E${i}`,
+      duration: 30,
+    }));
+    const rooms: Room[] = [
+      { id: 'r1', name: 'R1', capacity: 10 },
+      { id: 'r2', name: 'R2', capacity: 10 },
+    ];
+    const r = schedule(events, rooms, { startTime: 540, endTime: 1020 });
+    expect(r.assignments).toHaveLength(6);
+    expect(r.unscheduled).toHaveLength(0);
+  });
+});
