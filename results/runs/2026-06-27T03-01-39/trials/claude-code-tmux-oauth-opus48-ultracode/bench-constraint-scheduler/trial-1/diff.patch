+// ---------------------------------------------------------------------------
+// Rule 6: prerequisite cycles
+// ---------------------------------------------------------------------------
+
+describe('prerequisite cycles', () => {
+  it('throws on a direct two-node cycle', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, prerequisites: ['b'] },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    expect(() => schedule(events, rooms, OPTS)).toThrow();
+  });
+
+  it('throws on a self-reference', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, prerequisites: ['a'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    expect(() => schedule(events, rooms, OPTS)).toThrow();
+  });
+
+  it('throws on a longer cycle', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 10, prerequisites: ['c'] },
+      { id: 'b', name: 'B', duration: 10, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 10, prerequisites: ['b'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    expect(() => schedule(events, rooms, OPTS)).toThrow();
+  });
+
+  it('does not throw on a diamond (shared, acyclic) dependency', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 10 },
+      { id: 'b', name: 'B', duration: 10, prerequisites: ['a'] },
+      { id: 'c', name: 'C', duration: 10, prerequisites: ['a'] },
+      { id: 'd', name: 'D', duration: 10, prerequisites: ['b', 'c'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    expect(() => schedule(events, rooms, OPTS)).not.toThrow();
+    const r = schedule(events, rooms, OPTS);
+    assertValid(events, rooms, OPTS, r);
+  });
+});
