+// ---------------------------------------------------------------------------
+// Rule 5: preferred room
+// ---------------------------------------------------------------------------
+
+describe('preferred room', () => {
+  it('honors a preferred room when possible', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, preferredRoom: 'r2' },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'R1', capacity: 10 },
+      { id: 'r2', name: 'R2', capacity: 10 },
+    ];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments[0].roomId).toBe('r2');
+  });
+
+  it('falls back to another room when the preferred one will not fit', () => {
+    const events: Event[] = [
+      // Prefers the small room but needs 8 seats -> must use the big room.
+      { id: 'a', name: 'A', duration: 30, attendees: 8, preferredRoom: 'small' },
+    ];
+    const rooms: Room[] = [
+      { id: 'small', name: 'Small', capacity: 4 },
+      { id: 'big', name: 'Big', capacity: 20 },
+    ];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(1);
+    expect(r.assignments[0].roomId).toBe('big');
+  });
+
+  it('never sacrifices a scheduled event to honor a preference', () => {
+    // Two events both prefer r1, but r1 only fits one in the window.
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, preferredRoom: 'r1' },
+      { id: 'b', name: 'B', duration: 30, preferredRoom: 'r1' },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'R1', capacity: 10 },
+      { id: 'r2', name: 'R2', capacity: 10 },
+    ];
+    const opts = { startTime: 0, endTime: 30, gap: 15 };
+    const r = schedule(events, rooms, opts);
+    expect(r.assignments).toHaveLength(2); // count wins over preference
+    assertValid(events, rooms, opts, r);
+  });
+
+  it('ignores a preferred room that does not exist', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30, preferredRoom: 'nope' },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments[0].roomId).toBe('r1');
+  });
+});
