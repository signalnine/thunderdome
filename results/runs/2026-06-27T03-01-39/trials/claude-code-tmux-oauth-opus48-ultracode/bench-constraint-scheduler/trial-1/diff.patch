+// ---------------------------------------------------------------------------
+// Randomized property test: any returned schedule must be valid.
+// ---------------------------------------------------------------------------
+
+describe('randomized validity', () => {
+  // Small deterministic PRNG (mulberry32) for reproducibility.
+  function rng(seed: number): () => number {
+    let s = seed >>> 0;
+    return () => {
+      s |= 0;
+      s = (s + 0x6d2b79f5) | 0;
+      let t = Math.imul(s ^ (s >>> 15), 1 | s);
+      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+  }
+
+  it('produces valid schedules across many random instances', () => {
+    for (let seed = 1; seed <= 200; seed++) {
+      const rand = rng(seed);
+      const nEvents = 1 + Math.floor(rand() * 7);
+      const nRooms = 1 + Math.floor(rand() * 3);
+      const rooms: Room[] = Array.from({ length: nRooms }, (_, i) => ({
+        id: `r${i}`,
+        name: `R${i}`,
+        capacity: 1 + Math.floor(rand() * 10),
+      }));
+      const events: Event[] = [];
+      for (let i = 0; i < nEvents; i++) {
+        const ev: Event = {
+          id: `e${i}`,
+          name: `E${i}`,
+          duration: 10 + Math.floor(rand() * 60),
+          attendees: 1 + Math.floor(rand() * 8),
+        };
+        if (rand() < 0.5) ev.preferredRoom = `r${Math.floor(rand() * nRooms)}`;
+        // Only reference earlier events as prerequisites -> guaranteed acyclic.
+        if (i > 0 && rand() < 0.4) {
+          ev.prerequisites = [`e${Math.floor(rand() * i)}`];
+        }
+        events.push(ev);
+      }
+      const gap = Math.floor(rand() * 20);
+      const start = 540;
+      const end = start + 120 + Math.floor(rand() * 240);
+      const opts = { startTime: start, endTime: end, gap };
+      const r = schedule(events, rooms, opts);
+      assertValid(events, rooms, opts, r);
+    }
+  });
+});
