index 0000000..8ce5a93
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,464 @@
+import type {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+const DEFAULT_GAP = 15;
+const DEFAULT_ATTENDEES = 1;
+
+/** Safety limits so the branch-and-bound search never hangs on large inputs. */
+const MAX_NODES = 1_000_000;
+const MAX_MILLIS = 2_500;
+/** Cap on the precomputed candidate-start pool (protects against huge inputs). */
+const ANCHOR_CAP = 50_000;
+
+/** Internal, normalized view of an event with defaults applied. */
+interface NormEvent {
+  id: string;
+  duration: number;
+  attendees: number;
+  /** Prerequisite IDs that refer to real events in the input. */
+  prerequisites: string[];
+  /** True if any listed prerequisite refers to an unknown event id. */
+  hasMissingPrereq: boolean;
+  preferredRoom?: string;
+}
+
+/** A placement decided during the search. */
+interface Placement {
+  roomId: string;
+  start: number;
+  end: number;
+  /** True when placed into the event's preferred room. */
+  preferred: boolean;
+}
+
+/**
+ * Assign events to rooms within a time window, honoring capacity, the time
+ * window, inter-event room gaps, prerequisite ordering and (softly) room
+ * preferences. Maximizes the number of events scheduled.
+ *
+ * @throws if the prerequisite graph contains a cycle (including self-references).
+ */
+export function schedule(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const { startTime, endTime } = options;
+
+  // --- Normalize events and index them by id. -----------------------------
+  const byId = new Map<string, NormEvent>();
+  const order: NormEvent[] = [];
+  for (const e of events) {
+    if (byId.has(e.id)) {
+      throw new Error(`Duplicate event id: ${e.id}`);
+    }
+    const norm: NormEvent = {
+      id: e.id,
+      duration: e.duration,
+      attendees: e.attendees ?? DEFAULT_ATTENDEES,
+      prerequisites: [],
+      hasMissingPrereq: false,
+      preferredRoom: e.preferredRoom,
+    };
+    byId.set(e.id, norm);
+    order.push(norm);
+  }
+  // Resolve prerequisites against the known event set (dedupe, flag dangling).
+  for (let i = 0; i < events.length; i++) {
+    const raw = events[i].prerequisites ?? [];
+    const seen = new Set<string>();
+    for (const pid of raw) {
+      if (seen.has(pid)) continue;
+      seen.add(pid);
+      if (byId.has(pid)) {
+        order[i].prerequisites.push(pid);
+      } else {
+        order[i].hasMissingPrereq = true;
+      }
+    }
+  }
+
+  // --- Cycle detection + topological branching order. ----------------------
+  // Throws on any cycle, including self-references (A -> A).
+  const topo = topologicalOrder(order, byId);
+
+  // --- Feasible rooms per event (capacity only). ---------------------------
+  const feasibleRooms = new Map<string, Room[]>();
+  for (const ev of order) {
+    const fits = rooms.filter((r) => r.capacity >= ev.attendees);
+    // Preferred room (if it qualifies) is tried first.
+    fits.sort((a, b) => {
+      const ap = a.id === ev.preferredRoom ? 0 : 1;
+      const bp = b.id === ev.preferredRoom ? 0 : 1;
+      return ap - bp;
+    });
+    feasibleRooms.set(ev.id, fits);
+  }
+
+  // An event can NEVER be placed if it has no capacity-fitting room, if it can
+  // not physically fit the window even alone, or if it references a missing
+  // prerequisite. Such events are skipped up front (forced unscheduled).
+  const placeable = new Map<string, boolean>();
+  for (const ev of order) {
+    const rooms_ = feasibleRooms.get(ev.id)!;
+    const fitsWindow = startTime + ev.duration <= endTime;
+    placeable.set(
+      ev.id,
+      rooms_.length > 0 && fitsWindow && !ev.hasMissingPrereq && ev.duration >= 0,
+    );
+  }
+
+  // --- Candidate start-time pool. ------------------------------------------
+  // Every event in an optimal (left-shifted) schedule starts at the window
+  // start or at `someEvent.end + gap` chained from the window start — i.e. at
+  // `startTime + sum of (duration+gap) over a subset of events`. Precomputing
+  // this pool makes the fixed-order search complete: an event can be anchored
+  // to a slot "carved out" for another event even before that event is placed.
+  const anchors = computeAnchors(order, startTime, endTime, gap);
+
+  // --- Branch-and-bound search. --------------------------------------------
+  const search = new Search(
+    topo,
+    byId,
+    feasibleRooms,
+    placeable,
+    anchors,
+    startTime,
+    endTime,
+    gap,
+  );
+  const best = search.run();
+
+  // --- Materialize result in input order. ----------------------------------
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  for (const e of events) {
+    const p = best.get(e.id);
+    if (p) {
+      assignments.push({
+        eventId: e.id,
+        roomId: p.roomId,
+        startTime: p.start,
+        endTime: p.end,
+      });
+    } else {
+      unscheduled.push(e.id);
+    }
+  }
+  return { assignments, unscheduled };
+}
+
+/**
+ * Kahn's algorithm over real-event prerequisite edges. Produces an order in
+ * which every prerequisite precedes its dependents. Throws if a cycle prevents
+ * a complete ordering (this also covers self-references).
+ *
+ * Within the ready set, events are ordered by a heuristic so the first
+ * (greedy) dive of the search builds a strong incumbent: events with more
+ * dependents and shorter durations go first.
+ */
+function topologicalOrder(
+  events: NormEvent[],
+  byId: Map<string, NormEvent>,
+): NormEvent[] {
+  const indeg = new Map<string, number>();
+  const dependents = new Map<string, string[]>(); // prereq id -> dependent ids
+  for (const e of events) {
+    indeg.set(e.id, e.prerequisites.length);
+    for (const pid of e.prerequisites) {
+      const list = dependents.get(pid);
+      if (list) list.push(e.id);
+      else dependents.set(pid, [e.id]);
+    }
+  }
+
+  const depCount = (id: string): number => dependents.get(id)?.length ?? 0;
+  const cmp = (a: NormEvent, b: NormEvent): number => {
+    // More dependents first (avoid stranding downstream events)...
+    const d = depCount(b.id) - depCount(a.id);
+    if (d !== 0) return d;
+    // ...then shorter events first (pack small to fit more)...
+    if (a.duration !== b.duration) return a.duration - b.duration;
+    // ...then larger groups first; finally stable by id.
+    if (a.attendees !== b.attendees) return b.attendees - a.attendees;
+    return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
+  };
+
+  // Ready set maintained as a sorted array (inputs are small).
+  const ready: NormEvent[] = events.filter((e) => indeg.get(e.id) === 0);
+  ready.sort(cmp);
+
+  const result: NormEvent[] = [];
+  while (ready.length > 0) {
+    const next = ready.shift()!;
+    result.push(next);
+    for (const depId of dependents.get(next.id) ?? []) {
+      const d = (indeg.get(depId) ?? 0) - 1;
+      indeg.set(depId, d);
+      if (d === 0) {
+        const ev = byId.get(depId)!;
+        // Insert maintaining sort order.
+        let lo = 0;
+        let hi = ready.length;
+        while (lo < hi) {
+          const mid = (lo + hi) >> 1;
+          if (cmp(ready[mid], ev) <= 0) lo = mid + 1;
+          else hi = mid;
+        }
+        ready.splice(lo, 0, ev);
+      }
+    }
+  }
+
+  if (result.length !== events.length) {
+    throw new Error('Prerequisite cycle detected');
+  }
+  return result;
+}
+
+/**
+ * The pool of candidate start times: `startTime` plus every value reachable by
+ * adding a 0/1 subset of `(duration + gap)` step sizes (one per event), bounded
+ * by the window. This is the set of "left-shift anchors"; an optimal schedule
+ * exists in which every event starts at one of these times.
+ */
+function computeAnchors(
+  events: NormEvent[],
+  startTime: number,
+  endTime: number,
+  gap: number,
+): number[] {
+  const span = endTime - startTime;
+  if (span < 0) return [];
+  const reach = new Set<number>([0]);
+  for (const e of events) {
+    const step = e.duration + gap;
+    if (step <= 0) continue; // a zero step adds nothing new
+    const additions: number[] = [];
+    for (const r of reach) {
+      const v = r + step;
+      if (v <= span && !reach.has(v)) additions.push(v);
+    }
+    for (const v of additions) reach.add(v);
+    if (reach.size > ANCHOR_CAP) break;
+  }
+  const anchors: number[] = [];
+  for (const r of reach) anchors.push(startTime + r);
+  anchors.sort((a, b) => a - b);
+  return anchors;
+}
+
+/** Branch-and-bound solver maximizing (#scheduled, then #preferred-room hits). */
+class Search {
+  private readonly n: number;
+  private readonly status: Int8Array; // 0=undecided, 1=placed, 2=skipped
+  private readonly placement: (Placement | undefined)[];
+  private readonly roomIntervals: Map<string, { start: number; end: number }[]>;
+  private readonly indexOf: Map<string, number>;
+
+  private bestCount = -1;
+  private bestPref = -1;
+  private best: Map<string, Placement> = new Map();
+
+  private nodes = 0;
+  private readonly deadline: number;
+
+  constructor(
+    private readonly topo: NormEvent[],
+    private readonly byId: Map<string, NormEvent>,
+    private readonly feasibleRooms: Map<string, Room[]>,
+    private readonly placeable: Map<string, boolean>,
+    private readonly anchors: number[],
+    private readonly startTime: number,
+    private readonly endTime: number,
+    private readonly gap: number,
+  ) {
+    this.n = topo.length;
+    this.status = new Int8Array(this.n);
+    this.placement = new Array(this.n).fill(undefined);
+    this.roomIntervals = new Map();
+    this.indexOf = new Map();
+    topo.forEach((e, i) => this.indexOf.set(e.id, i));
+    this.deadline = Date.now() + MAX_MILLIS;
+  }
+
+  run(): Map<string, Placement> {
+    this.dfs(0, 0, 0);
+    return this.best;
+  }
+
+  /** True once a resource budget is exhausted; search then unwinds. */
+  private exhausted(): boolean {
+    if (this.nodes >= MAX_NODES) return true;
+    // Check the clock occasionally to keep it cheap.
+    if ((this.nodes & 0x3ff) === 0 && Date.now() > this.deadline) return true;
+    return false;
+  }
+
+  private dfs(i: number, count: number, pref: number): void {
+    this.nodes++;
+    if (this.exhausted()) return;
+
+    if (i === this.n) {
+      this.record(count, pref);
+      return;
+    }
+
+    // Upper bound: current placements + every still-placeable remaining event.
+    let bound = count;
+    for (let j = i; j < this.n; j++) {
+      if (this.canStillPlace(j)) bound++;
+    }
+    if (bound < this.bestCount) return; // cannot beat incumbent on count
+    // On a count tie, the only way to improve is the secondary (preferred-room)
+    // score; prune if even a perfect remaining run could not exceed it.
+    if (bound === this.bestCount && this.maxRemainingPref(i, pref) <= this.bestPref) {
+      return;
+    }
+
+    const ev = this.topo[i];
+
+    // --- Branch 1: try to PLACE the event (preferred room first, earliest
+    //     start first). Skipped entirely if it can't be placed here. ---------
+    if (this.placeable.get(ev.id) && this.prereqsPlaced(ev)) {
+      const earliest = this.earliestStart(ev);
+      for (const room of this.feasibleRooms.get(ev.id)!) {
+        for (const start of this.candidateStarts(ev, room.id, earliest)) {
+          this.place(i, ev, room.id, start);
+          const isPref = this.placement[i]!.preferred ? 1 : 0;
+          this.dfs(i + 1, count + 1, pref + isPref);
+          this.unplace(i, ev, room.id);
+          if (this.exhausted()) return;
+        }
+      }
+    }
+
+    // --- Branch 2: SKIP the event (leave it unscheduled). -------------------
+    this.status[i] = 2;
+    this.dfs(i + 1, count, pref);
+    this.status[i] = 0;
+  }
+
+  private record(count: number, pref: number): void {
+    if (count > this.bestCount || (count === this.bestCount && pref > this.bestPref)) {
+      this.bestCount = count;
+      this.bestPref = pref;
+      const snapshot = new Map<string, Placement>();
+      for (let k = 0; k < this.n; k++) {
+        const p = this.placement[k];
+        if (this.status[k] === 1 && p) snapshot.set(this.topo[k].id, p);
+      }
+      this.best = snapshot;
+    }
+  }
+
+  /** Could event index j still be placed given current skip decisions? */
+  private canStillPlace(j: number): boolean {
+    if (this.status[j] === 2) return false; // already skipped
+    const ev = this.topo[j];
+    if (!this.placeable.get(ev.id)) return false;
+    // If any prerequisite is already skipped, j is doomed.
+    for (const pid of ev.prerequisites) {
+      const k = this.indexOf.get(pid)!;
+      if (this.status[k] === 2) return false;
+    }
+    return true;
+  }
+
+  /** Optimistic secondary score if every remaining placeable event hit pref. */
+  private maxRemainingPref(i: number, pref: number): number {
+    let extra = 0;
+    for (let j = i; j < this.n; j++) {
+      const ev = this.topo[j];
+      if (this.canStillPlace(j) && ev.preferredRoom) extra++;
+    }
+    return pref + extra;
+  }
+
+  private prereqsPlaced(ev: NormEvent): boolean {
+    for (const pid of ev.prerequisites) {
+      const k = this.indexOf.get(pid)!;
+      if (this.status[k] !== 1) return false;
+    }
+    return true;
+  }
+
+  /** Earliest legal start given the window and prerequisite finish + gap. */
+  private earliestStart(ev: NormEvent): number {
+    let t = this.startTime;
+    for (const pid of ev.prerequisites) {
+      const k = this.indexOf.get(pid)!;
+      const p = this.placement[k];
+      if (p) t = Math.max(t, p.end + this.gap);
+    }
+    return t;
+  }
+
+  /**
+   * Candidate start times for `ev` in `roomId`, drawn from the global anchor
+   * pool (plus the exact earliest legal time as a safety net), in ascending
+   * order so the greedy first dive packs tightly. Filtered to anchors that fit
+   * the window and clear every interval already in the room by `gap`.
+   */
+  private candidateStarts(ev: NormEvent, roomId: string, earliest: number): number[] {
+    const intervals = this.roomIntervals.get(roomId) ?? [];
+    const maxStart = this.endTime - ev.duration;
+    const valid: number[] = [];
+    // `earliest` is itself an anchor in all normal cases, but include it
+    // explicitly so a tightened release time is never skipped.
+    if (earliest <= maxStart && this.fits(earliest, ev.duration, intervals)) {
+      valid.push(earliest);
+    }
+    for (const s of this.anchors) {
+      if (s <= earliest) continue; // already considered / out of range
+      if (s > maxStart) break; // anchors are sorted ascending
+      if (this.fits(s, ev.duration, intervals)) valid.push(s);
+    }
+    return valid;
+  }
+
+  /** Does [start, start+duration] clear every interval by at least `gap`? */
+  private fits(
+    start: number,
+    duration: number,
+    intervals: { start: number; end: number }[],
+  ): boolean {
+    const end = start + duration;
+    if (start < this.startTime || end > this.endTime) return false;
+    for (const iv of intervals) {
+      const separated = end + this.gap <= iv.start || iv.end + this.gap <= start;
+      if (!separated) return false;
+    }
+    return true;
+  }
+
+  private place(i: number, ev: NormEvent, roomId: string, start: number): void {
+    const end = start + ev.duration;
+    this.status[i] = 1;
+    this.placement[i] = {
+      roomId,
+      start,
+      end,
+      preferred: ev.preferredRoom === roomId,
+    };
+    let list = this.roomIntervals.get(roomId);
+    if (!list) {
+      list = [];
+      this.roomIntervals.set(roomId, list);
+    }
+    list.push({ start, end });
+  }
+
+  private unplace(i: number, _ev: NormEvent, roomId: string): void {
+    this.status[i] = 0;
+    this.placement[i] = undefined;
+    const list = this.roomIntervals.get(roomId)!;
+    list.pop();
+  }
+}
