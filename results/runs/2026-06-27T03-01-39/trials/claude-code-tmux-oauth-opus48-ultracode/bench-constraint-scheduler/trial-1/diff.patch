@@ -0,0 +1,36 @@
+import { schedule } from './scheduler.js';
+import type { Event, Room, ScheduleOptions, ScheduleResult } from './types.js';
+
+export type {
+  Assignment,
+  Event,
+  Room,
+  ScheduleOptions,
+  ScheduleResult,
+} from './types.js';
+
+export { schedule } from './scheduler.js';
+
+/**
+ * Class wrapper around {@link schedule}, for callers that prefer an OO entry
+ * point. The options passed to the constructor are reused for every call.
+ */
+export class Scheduler {
+  constructor(private readonly options: ScheduleOptions) {}
+
+  schedule(events: Event[], rooms: Room[]): ScheduleResult {
+    return schedule(events, rooms, this.options);
+  }
+}
+
+/** Factory variant mirroring {@link Scheduler}. */
+export function createScheduler(options: ScheduleOptions): {
+  schedule: (events: Event[], rooms: Room[]) => ScheduleResult;
+} {
+  return {
+    schedule: (events: Event[], rooms: Room[]) =>
+      schedule(events, rooms, options),
+  };
+}
+
+export default schedule;
diff --git a/src/scheduler.ts b/src/scheduler.ts
