+      { id: 'a', name: 'A', duration: 30 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'R1', capacity: 10 },
+      { id: 'r2', name: 'R2', capacity: 10 },
+    ];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(2);
+    assertValid(events, rooms, OPTS, r);
+    const a = r.assignments.find((x) => x.eventId === 'a')!;
+    const b = r.assignments.find((x) => x.eventId === 'b')!;
+    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);
+  });
+
+  it('honors a prerequisite gap across different rooms', () => {
+    const events: Event[] = [
+      { id: 'a', name: 'A', duration: 30 },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'R1', capacity: 10 },
+      { id: 'r2', name: 'R2', capacity: 10 },
+    ];
+    const r = schedule(events, rooms, OPTS);
+    const a = r.assignments.find((x) => x.eventId === 'a')!;
+    const b = r.assignments.find((x) => x.eventId === 'b')!;
+    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);
+  });
+
+  it('leaves a dependent unscheduled when its prerequisite cannot be placed', () => {
+    const events: Event[] = [
+      // A needs a 50-person room that does not exist -> unschedulable.
+      { id: 'a', name: 'A', duration: 30, attendees: 50 },
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['a'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(0);
+    expect(new Set(r.unscheduled)).toEqual(new Set(['a', 'b']));
+  });
+
+  it('treats a dangling prerequisite as unschedulable', () => {
+    const events: Event[] = [
+      { id: 'b', name: 'B', duration: 30, prerequisites: ['ghost'] },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.unscheduled).toEqual(['b']);
+  });
+
+  it('handles a chain of prerequisites', () => {
+    const events: Event[] = [
+      { id: 'c', name: 'C', duration: 20, prerequisites: ['b'] },
+      { id: 'b', name: 'B', duration: 20, prerequisites: ['a'] },
+      { id: 'a', name: 'A', duration: 20 },
+    ];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const r = schedule(events, rooms, OPTS);
