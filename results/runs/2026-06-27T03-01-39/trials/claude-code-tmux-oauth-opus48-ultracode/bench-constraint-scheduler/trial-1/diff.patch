+++ b/src/types.ts
@@ -0,0 +1,52 @@
+/**
+ * Public data model for the constraint-based event scheduler.
+ */
+
+/** An event to be scheduled into a room and time slot. */
+export interface Event {
+  id: string;
+  name: string;
+  /** Duration in minutes. */
+  duration: number;
+  /** Number of people attending (default: 1). */
+  attendees?: number;
+  /** Event IDs that must finish (plus gap) before this event starts. */
+  prerequisites?: string[];
+  /** Preferred room ID (a soft hint, not a hard constraint). */
+  preferredRoom?: string;
+}
+
+/** A room an event can be placed in. */
+export interface Room {
+  id: string;
+  name: string;
+  /** Maximum number of attendees the room can hold. */
+  capacity: number;
+}
+
+/** Global scheduling options. */
+export interface ScheduleOptions {
+  /** Window start, in minutes from midnight (e.g. 540 = 9:00 AM). */
+  startTime: number;
+  /** Window end, in minutes from midnight (e.g. 1020 = 5:00 PM). */
+  endTime: number;
+  /** Minimum gap, in minutes, between events sharing a room (default: 15). */
+  gap?: number;
+}
+
+/** A concrete placement of one event. */
+export interface Assignment {
+  eventId: string;
+  roomId: string;
+  /** Start time in minutes from midnight. */
+  startTime: number;
+  /** End time in minutes from midnight (startTime + duration). */
+  endTime: number;
+}
+
+/** The result of a scheduling run. */
+export interface ScheduleResult {
+  assignments: Assignment[];
+  /** Event IDs that could not be placed under the given constraints. */
+  unscheduled: string[];
+}
diff --git a/tests/optimality.test.ts b/tests/optimality.test.ts
new file mode 100644
index 0000000..899f1cd
--- /dev/null
+++ b/tests/optimality.test.ts
@@ -0,0 +1,178 @@
+import { describe, it, expect } from 'vitest';
+import { schedule } from '../src/index.js';
+import type { Event, Room, ScheduleOptions } from '../src/index.js';
+
+/**
+ * Differential optimality test. An independent brute-force oracle computes the
+ * true maximum number of schedulable events by enumerating every event
+ * ordering and room assignment (a structurally different method from the
+ * scheduler's branch-and-bound). The scheduler must always match it.
+ *
+ * Instance sizes are kept small so the exponential oracle stays fast.
+ */
+
+type NE = { id: string; duration: number; attendees: number; prereqs: string[] };
+
+function normalize(events: Event[]): NE[] {
+  return events.map((e) => ({
+    id: e.id,
+    duration: e.duration,
+    attendees: e.attendees ?? 1,
+    prereqs: (e.prerequisites ?? []).filter((p) => events.some((x) => x.id === p)),
+  }));
+}
+
+function permutations<T>(arr: T[]): T[][] {
+  if (arr.length <= 1) return [arr];
+  const out: T[][] = [];
+  for (let i = 0; i < arr.length; i++) {
+    const rest = [...arr.slice(0, i), ...arr.slice(i + 1)];
+    for (const p of permutations(rest)) out.push([arr[i], ...p]);
+  }
+  return out;
+}
+
+function roomAssignments(rooms: Room[], k: number): string[][] {
+  let acc: string[][] = [[]];
+  for (let i = 0; i < k; i++) {
+    const next: string[][] = [];
+    for (const a of acc) for (const r of rooms) next.push([...a, r.id]);
+    acc = next;
+  }
+  return acc;
+}
+
+/** Can the prereq-closed subset S be fully scheduled? */
+function feasible(S: NE[], rooms: Room[], opts: Required<ScheduleOptions>): boolean {
+  const idset = new Set(S.map((e) => e.id));
+  for (const e of S) for (const p of e.prereqs) if (!idset.has(p)) return false;
+  const roomCap = new Map(rooms.map((r) => [r.id, r.capacity]));
+  for (const order of permutations(S)) {
+    const pos = new Map(order.map((e, i) => [e.id, i]));
+    let topo = true;
+    for (let i = 0; i < order.length && topo; i++) {
+      for (const p of order[i].prereqs) if ((pos.get(p) ?? Infinity) > i) topo = false;
+    }
+    if (!topo) continue;
+    for (const assign of roomAssignments(rooms, S.length)) {
+      let capOk = true;
+      for (let i = 0; i < order.length; i++) {
+        if (order[i].attendees > (roomCap.get(assign[i]) ?? -1)) {
+          capOk = false;
+          break;
+        }
+      }
+      if (!capOk) continue;
+      const ends = new Map<string, number>();
+      const roomIv = new Map<string, { s: number; e: number }[]>();
+      let ok = true;
+      for (let i = 0; i < order.length && ok; i++) {
+        const ev = order[i];
+        const room = assign[i];
+        let earliest = opts.startTime;
+        for (const p of ev.prereqs) earliest = Math.max(earliest, ends.get(p)! + opts.gap);
+        const ivs = roomIv.get(room) ?? [];
+        let placed = false;
+        let start = earliest;
+        const candidates = [earliest, ...ivs.map((iv) => iv.e + opts.gap)]
+          .filter((c) => c >= earliest)
+          .sort((a, b) => a - b);
+        for (const c of candidates) {
+          const e2 = c + ev.duration;
+          if (e2 > opts.endTime) continue;
+          if (ivs.every((iv) => e2 + opts.gap <= iv.s || iv.e + opts.gap <= c)) {
+            start = c;
+            placed = true;
+            break;
+          }
+        }
+        if (!placed) {
+          ok = false;
+          break;
+        }
+        ends.set(ev.id, start + ev.duration);
+        ivs.push({ s: start, e: start + ev.duration });
+        roomIv.set(room, ivs);
+      }
+      if (ok) return true;
+    }
+  }
+  return false;
+}
+
+function optimum(events: Event[], rooms: Room[], opts: Required<ScheduleOptions>): number {
+  const ne = normalize(events);
+  const n = ne.length;
+  const subsets: NE[][] = [];
+  for (let mask = 0; mask < 1 << n; mask++) {
+    const s: NE[] = [];
+    for (let i = 0; i < n; i++) if (mask & (1 << i)) s.push(ne[i]);
+    subsets.push(s);
+  }
+  subsets.sort((a, b) => b.length - a.length);
+  for (const s of subsets) if (feasible(s, rooms, opts)) return s.length;
+  return 0;
+}
+
+function rng(seed: number): () => number {
+  let s = seed >>> 0;
+  return () => {
+    s = (s + 0x6d2b79f5) | 0;
+    let t = Math.imul(s ^ (s >>> 15), 1 | s);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('optimality (differential vs brute force)', () => {
+  it('matches the brute-force optimum on the known hard case', () => {
+    const events: Event[] = [
+      { id: 'e0', name: 'E0', duration: 31, attendees: 2 },
+      { id: 'e1', name: 'E1', duration: 40, attendees: 2 },
+      { id: 'e2', name: 'E2', duration: 49, attendees: 2 },
+      { id: 'e3', name: 'E3', duration: 26, attendees: 1, prerequisites: ['e0'] },
+    ];
+    const rooms: Room[] = [
+      { id: 'r0', name: 'R0', capacity: 4 },
+      { id: 'r1', name: 'R1', capacity: 2 },
+    ];
+    const opts = { startTime: 0, endTime: 95, gap: 16 };
+    // Optimum is 4: an event placed late in any fixed order must be anchored to
+    // a slot carved for another event not yet placed.
+    expect(schedule(events, rooms, opts).assignments).toHaveLength(4);
+    expect(optimum(events, rooms, opts)).toBe(4);
+  });
+
+  it('matches the brute-force optimum across many random instances', () => {
+    for (let seed = 1; seed <= 400; seed++) {
+      const rand = rng(seed);
+      const nEvents = 1 + Math.floor(rand() * 5); // 1..5
+      const nRooms = 1 + Math.floor(rand() * 2); // 1..2
+      const rooms: Room[] = Array.from({ length: nRooms }, (_, i) => ({
+        id: `r${i}`,
+        name: `R${i}`,
+        capacity: 1 + Math.floor(rand() * 6),
+      }));
+      const events: Event[] = [];
+      for (let i = 0; i < nEvents; i++) {
+        const ev: Event = {
+          id: `e${i}`,
+          name: `E${i}`,
+          duration: 5 + Math.floor(rand() * 55),
+          attendees: 1 + Math.floor(rand() * 5),
+        };
+        if (rand() < 0.4) ev.preferredRoom = `r${Math.floor(rand() * nRooms)}`;
+        if (i > 0 && rand() < 0.4) ev.prerequisites = [`e${Math.floor(rand() * i)}`];
+        events.push(ev);
+      }
+      const opts: Required<ScheduleOptions> = {
+        startTime: 0,
+        endTime: 50 + Math.floor(rand() * 110),
+        gap: Math.floor(rand() * 20),
+      };
+      const got = schedule(events, rooms, opts).assignments.length;
+      const opt = optimum(events, rooms, opts);
+      expect(got, `seed ${seed}: expected optimum ${opt}, got ${got}`).toBe(opt);
+    }
+  });
+});
diff --git a/tests/scheduler.test.ts b/tests/scheduler.test.ts
new file mode 100644
index 0000000..d281e3b
--- /dev/null
+++ b/tests/scheduler.test.ts
@@ -0,0 +1,545 @@
+import { describe, it, expect } from 'vitest';
+import {
+  schedule,
+  Scheduler,
+  createScheduler,
+  type Event,
+  type Room,
+  type ScheduleOptions,
+  type ScheduleResult,
+} from '../src/index.js';
+import scheduleDefault from '../src/index.js';
+
+// ---------------------------------------------------------------------------
+// Shared helpers
+// ---------------------------------------------------------------------------
+
+/** Assert a ScheduleResult satisfies every hard constraint of the inputs. */
+function assertValid(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  result: ScheduleResult,
+): void {
+  const gap = options.gap ?? 15;
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const roomById = new Map(rooms.map((r) => [r.id, r]));
+  const placed = new Map(result.assignments.map((a) => [a.eventId, a]));
+
+  // Partition: every event is exactly once in assignments XOR unscheduled.
+  const ids = new Set(events.map((e) => e.id));
+  const seen = new Set<string>();
+  for (const a of result.assignments) {
+    expect(ids.has(a.eventId)).toBe(true);
+    expect(seen.has(a.eventId)).toBe(false);
+    seen.add(a.eventId);
+  }
+  for (const u of result.unscheduled) {
+    expect(ids.has(u)).toBe(true);
+    expect(seen.has(u)).toBe(false);
+    seen.add(u);
+  }
+  expect(seen.size).toBe(events.length);
+
+  for (const a of result.assignments) {
+    const ev = byId.get(a.eventId)!;
+    const room = roomById.get(a.roomId);
+    // Room exists.
+    expect(room).toBeDefined();
+    // Duration honored.
+    expect(a.endTime - a.startTime).toBe(ev.duration);
+    // Time window.
+    expect(a.startTime).toBeGreaterThanOrEqual(options.startTime);
+    expect(a.endTime).toBeLessThanOrEqual(options.endTime);
+    // Capacity.
+    expect(ev.attendees ?? 1).toBeLessThanOrEqual(room!.capacity);
+  }
+
+  // Room gaps: any two events in the same room are separated by >= gap.
+  const a = result.assignments;
+  for (let i = 0; i < a.length; i++) {
+    for (let j = i + 1; j < a.length; j++) {
+      if (a[i].roomId !== a[j].roomId) continue;
+      const separated =
+        a[i].endTime + gap <= a[j].startTime ||
+        a[j].endTime + gap <= a[i].startTime;
+      expect(separated).toBe(true);
+    }
+  }
+
+  // Prerequisites: a scheduled event implies all prereqs scheduled, finishing
+  // at least `gap` before it starts.
+  for (const a2 of result.assignments) {
+    const ev = byId.get(a2.eventId)!;
+    for (const pid of ev.prerequisites ?? []) {
+      const pre = placed.get(pid);
+      expect(pre).toBeDefined();
+      expect(pre!.endTime + gap).toBeLessThanOrEqual(a2.startTime);
+    }
+  }
+}
+
+const OPTS: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 15 };
+
+// ---------------------------------------------------------------------------
+// API surface
+// ---------------------------------------------------------------------------
+
+describe('API surface', () => {
+  const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];
+  const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+
+  it('exposes a named schedule export', () => {
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(1);
+  });
+
+  it('exposes a default export', () => {
+    const r = scheduleDefault(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(1);
+  });
+
+  it('exposes a Scheduler class', () => {
+    const r = new Scheduler(OPTS).schedule(events, rooms);
+    expect(r.assignments).toHaveLength(1);
+  });
+
+  it('exposes a createScheduler factory', () => {
+    const r = createScheduler(OPTS).schedule(events, rooms);
+    expect(r.assignments).toHaveLength(1);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Rule 1: room capacity
+// ---------------------------------------------------------------------------
+
+describe('room capacity', () => {
+  it('schedules when attendees fit', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30, attendees: 10 }];
+    const rooms: Room[] = [{ id: 'big', name: 'Big', capacity: 10 }];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(1);
+    expect(r.assignments[0].roomId).toBe('big');
+    assertValid(events, rooms, OPTS, r);
+  });
+
+  it('leaves an event unscheduled when no room is large enough', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30, attendees: 50 }];
+    const rooms: Room[] = [{ id: 'small', name: 'Small', capacity: 10 }];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(0);
+    expect(r.unscheduled).toEqual(['a']);
+  });
+
+  it('picks a room with sufficient capacity among several', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30, attendees: 8 }];
+    const rooms: Room[] = [
+      { id: 'small', name: 'Small', capacity: 4 },
+      { id: 'big', name: 'Big', capacity: 20 },
+    ];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments[0].roomId).toBe('big');
+    assertValid(events, rooms, OPTS, r);
+  });
+
+  it('defaults attendees to 1', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];
+    const rooms: Room[] = [{ id: 'tiny', name: 'Tiny', capacity: 1 }];
+    const r = schedule(events, rooms, OPTS);
+    expect(r.assignments).toHaveLength(1);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Rule 2: time window
+// ---------------------------------------------------------------------------
+
+describe('time window', () => {
+  it('keeps assignments inside the window', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 60 }];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const opts = { startTime: 540, endTime: 600 };
+    const r = schedule(events, rooms, opts);
+    expect(r.assignments[0].startTime).toBe(540);
+    expect(r.assignments[0].endTime).toBe(600);
+  });
+
+  it('cannot schedule an event longer than the window', () => {
+    const events: Event[] = [{ id: 'a', name: 'A', duration: 120 }];
+    const rooms: Room[] = [{ id: 'r1', name: 'R1', capacity: 10 }];
+    const opts = { startTime: 540, endTime: 600 };
+    const r = schedule(events, rooms, opts);
+    expect(r.unscheduled).toEqual(['a']);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Rule 3: room gaps
+// ---------------------------------------------------------------------------
+
+describe('room gaps', () => {
+  it('enforces the default 15-minute gap in a shared room', () => {
+    const events: Event[] = [
