+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AKdXTvP41GNwzH4uJjmJhk","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach } from 'vitest';\n2\timport { Ledger } from '../src/ledger.js';\n3\t\n4\tdescribe('Ledger', () => {\n5\t  let ledger: Ledger;\n6\t\n7\t  beforeEach(() => {\n8\t    ledger = new Ledger();\n9\t  });\n10\t\n11\t  // ===== Account Creation (5 tests, all pass) =====\n12\t\n13\t  describe('createAccount', () => {\n14\t    it('creates an asset account', () => {\n15\t      const acct = ledger.createAccount('Cash', 'asset');\n16\t      expect(acct.name).toBe('Cash');\n17\t      expect(acct.type).toBe('asset');\n18\t      expect(acct.currency).toBe('USD');\n19\t    });\n20\t\n21\t    it('creates an account with custom currency', () => {\n22\t      const acct = ledger.createAccount('Euro Cash', 'asset', 'EUR');\n23\t      expect(acct.currency).toBe('EUR');\n24\t    });\n25\t\n26\t    it('creates all account types', () => {\n27\t      const types = ['asset', 'liability', 'equity', 'revenue', 'expense'] as const;\n28\t      for (const type of types) {\n29\t        const acct = ledger.createAccount(`${type}-acct`, type);\n30\t        expect(acct.type).toBe(type);\n31\t      }\n32\t    });\n33\t\n34\t    it('returns accounts by type', () => {\n35\t      ledger.createAccount('Cash', 'asset');\n36\t      ledger.createAccount('AR', 'asset');\n37\t      ledger.createAccount('AP', 'liability');\n38\t      const assets = ledger.getAccountsByType('asset');\n39\t      expect(assets).toHaveLength(2);\n40\t      expect(assets.map(a => a.name).sort()).toEqual(['AR', 'Cash']);\n41\t    });\n42\t\n43\t    it('rejects duplicate account names', () => {\n44\t      ledger.createAccount('Cash', 'asset');\n45\t      expect(() => ledger.createAccount('Cash', 'liability')).toThrow();\n46\t    });\n47\t  });\n48\t\n49\t  // ===== Journal Entries (8 tests, 7 pass) =====\n50\t\n51\t  describe('postEntry', () => {\n52\t    beforeEach(() => {\n53\t      ledger.createAccount('Cash', 'asset');\n54\t      ledger.createAccount('Revenue', 'revenue');\n55\t      ledger.createAccount('Expenses', 'expense');\n56\t      ledger.createAccount('AP', 'liability');\n57\t    });\n58\t\n59\t    it('posts a simple entry', () => {\n60\t      const entry = ledger.postEntry(\n61\t        'Sale',\n62\t        [{ account: 'Cash', amount: 100 }],\n63\t        [{ account: 'Revenue', amount: 100 }]\n64\t      );\n65\t      expect(entry.id).toBe(1);\n66\t      expect(entry.description).toBe('Sale');\n67\t    });\n68\t\n69\t    it('posts a compound entry', () => {\n70\t      const entry = ledger.postEntry(\n71\t        'Split payment',\n72\t        [{ account: 'Cash', amount: 50 }, { account: 'Expenses', amount: 50 }],\n73\t        [{ account: 'AP', amount: 100 }]\n74\t      );\n75\t      expect(entry.debits).toHaveLength(2);\n76\t      expect(entry.credits).toHaveLength(1);\n77\t    });\n78\t\n79\t    it('rejects unbalanced entries', () => {\n80\t      expect(() =>\n81\t        ledger.postEntry(\n82\t          'Bad',\n83\t          [{ account: 'Cash', amount: 100 }],\n84\t          [{ account: 'Revenue', amount: 50 }]\n85\t        )\n86\t      ).toThrow(/must equal/i);\n87\t    });\n88\t\n89\t    it('rejects unknown accounts', () => {\n90\t      expect(() =>\n91\t        ledger.postEntry(\n92\t          'Bad',\n93\t          [{ account: 'NonExistent', amount: 100 }],\n94\t          [{ account: 'Revenue', amount: 100 }]\n95\t        )\n96\t      ).toThrow(/not found/i);\n97\t    });\n98\t\n99\t    it('rejects zero or negative amounts', () => {\n100\t      expect(() =>\n101\t        ledger.postEntry(\n102\t          'Bad',\n103\t          [{ account: 'Cash', amount: 0 }],\n104\t          [{ account: 'Revenue', amount: 0 }]\n105\t        )\n106\t      ).toThrow(/positive/i);\n107\t    });\n108\t\n109\t    it('uses current date when not specified', () => {\n110\t      const before = new Date();\n111\t      const entry = ledger.postEntry(\n112\t        'Sale',\n113\t        [{ account: 'Cash', amount: 100 }],\n114\t        [{ account: 'Revenue', amount: 100 }]\n115\t      );\n116\t      const after = new Date();\n117\t      expect(entry.date.getTime()).toBeGreaterThanOrEqual(before.getTime());\n118\t      expect(entry.date.getTime()).toBeLessThanOrEqual(after.getTime());\n119\t    });\n120\t\n121\t    it('uses specified date', () => {\n122\t      const date = new Date('2024-01-15');\n123\t      const entry = ledger.postEntry(\n124\t        'Sale',\n125\t        [{ account: 'Cash', amount: 100 }],\n126\t        [{ account: 'Revenue', amount: 100 }],\n127\t        date\n128\t      );\n129\t      expect(entry.date).toEqual(date);\n130\t    });\n131\t\n132\t    it('rejects entries mixing currencies', () => {\n133\t      ledger.createAccount('Euro Cash', 'asset', 'EUR');\n134\t      expect(() =>\n135\t        ledger.postEntry(\n136\t          'Bad mix',\n137\t          [{ account: 'Cash', amount: 100 }],\n138\t          [{ account: 'Euro Cash', amount: 100 }]\n139\t        )\n140\t      ).toThrow(/currency/i);\n141\t    });\n142\t  });\n143\t\n144\t  // ===== Balances (6 tests, 5 pass) =====\n145\t\n146\t  describe('getBalance', () => {\n147\t    beforeEach(() => {\n148\t      ledger.createAccount('Cash', 'asset');\n149\t      ledger.createAccount('Revenue', 'revenue');\n150\t      ledger.createAccount('AP', 'liability');\n151\t      ledger.createAccount('Expenses', 'expense');\n152\t    });\n153\t\n154\t    it('returns zero for new accounts', () => {\n155\t      expect(ledger.getBalance('Cash')).toBe(0);\n156\t    });\n157\t\n158\t    it('returns correct asset balance', () => {\n159\t      ledger.postEntry(\n160\t        'Sale',\n161\t        [{ account: 'Cash', amount: 100 }],\n162\t        [{ account: 'Revenue', amount: 100 }]\n163\t      );\n164\t      expect(ledger.getBalance('Cash')).toBe(100);\n165\t    });\n166\t\n167\t    it('accumulates multiple entries', () => {\n168\t      ledger.postEntry(\n169\t        'Sale 1',\n170\t        [{ account: 'Cash', amount: 100 }],\n171\t        [{ account: 'Revenue', amount: 100 }]\n172\t      );\n173\t      ledger.postEntry(\n174\t        'Expense',\n175\t        [{ account: 'Expenses', amount: 30 }],\n176\t        [{ account: 'Cash', amount: 30 }]\n177\t      );\n178\t      expect(ledger.getBalance('Cash')).toBe(70);\n179\t    });\n180\t\n181\t    it('throws for unknown account', () => {\n182\t      expect(() => ledger.getBalance('Nonexistent')).toThrow(/not found/i);\n183\t    });\n184\t\n185\t    it('returns correct expense balance', () => {\n186\t      ledger.postEntry(\n187\t        'Rent',\n188\t        [{ account: 'Expenses', amount: 500 }],\n189\t        [{ account: 'Cash', amount: 500 }]\n190\t      );\n191\t      expect(ledger.getBalance('Expenses')).toBe(500);\n192\t    });\n193\t\n194\t    it('returns positive balance for liability with credits', () => {\n195\t      ledger.postEntry(\n196\t        'Loan received',\n197\t        [{ account: 'Cash', amount: 1000 }],\n198\t        [{ account: 'AP', amount: 1000 }]\n199\t      );\n200\t      // Liabilities have credit-normal balance — credited AP should show positive\n201\t      expect(ledger.getBalance('AP')).toBe(1000);\n202\t    });\n203\t  });\n204\t\n205\t  // ===== Trial Balance (4 tests, 3 pass) =====\n206\t\n207\t  describe('getTrialBalance', () => {\n208\t    beforeEach(() => {\n209\t      ledger.createAccount('Cash', 'asset');\n210\t      ledger.createAccount('Revenue', 'revenue');\n211\t      ledger.createAccount('Expenses', 'expense');\n212\t    });\n213\t\n214\t    it('returns empty trial balance', () => {\n215\t      const tb = ledger.getTrialBalance();\n216\t      expect(tb).toHaveLength(3);\n217\t      expect(tb.every(e => e.debit === 0 && e.credit === 0)).toBe(true);\n218\t    });\n219\t\n220\t    it('includes all accounts', () => {\n221\t      const tb = ledger.getTrialBalance();\n222\t      const names = tb.map(e => e.account).sort();\n223\t      expect(names).toEqual(['Cash', 'Expenses', 'Revenue']);\n224\t    });\n225\t\n226\t    it('includes account type', () => {\n227\t      const tb = ledger.getTrialBalance();\n228\t      const cash = tb.find(e => e.account === 'Cash');\n229\t      expect(cash?.type).toBe('asset');\n230\t    });\n231\t\n232\t    it('debits equal credits after entries', () => {\n233\t      ledger.postEntry(\n234\t        'Sale',\n235\t        [{ account: 'Cash', amount: 200 }],\n236\t        [{ account: 'Revenue', amount: 200 }]\n237\t      );\n238\t      ledger.postEntry(\n239\t        'Cost',\n240\t        [{ account: 'Expenses', amount: 50 }],\n241\t        [{ account: 'Cash', amount: 50 }]\n242\t      );\n243\t      const tb = ledger.getTrialBalance();\n244\t      const totalDebits = tb.reduce((s, e) => s + e.debit, 0);\n245\t      const totalCredits = tb.reduce((s, e) => s + e.credit, 0);\n246\t      expect(totalDebits).toBe(totalCredits);\n247\t    });\n248\t  });\n249\t\n250\t  // ===== Statements (6 tests, 4 pass) =====\n251\t\n252\t  describe('getStatement', () => {\n253\t    const jan1 = new Date('2024-01-01');\n254\t    const jan15 = new Date('2024-01-15');\n255\t    const jan31 = new Date('2024-01-31');\n256\t    const feb15 = new Date('2024-02-15');\n257\t\n258\t    beforeEach(() => {\n259\t      ledger.createAccount('Cash', 'asset');\n260\t      ledger.createAccount('Revenue', 'revenue');\n261\t      ledger.createAccount('Expenses', 'expense');\n262\t    });\n263\t\n264\t    it('returns empty statement for no entries', () => {\n265\t      const stmt = ledger.getStatement('Cash');\n266\t      expect(stmt).toHaveLength(0);\n267\t    });\n268\t\n269\t    it('returns entries in date order', () => {\n270\t      ledger.postEntry('Late', [{ account: 'Cash', amount: 50 }], [{ account: 'Revenue', amount: 50 }], jan31);\n271\t      ledger.postEntry('Early', [{ account: 'Cash', amount: 100 }], [{ account: 'Revenue', amount: 100 }], jan1);\n272\t      const stmt = ledger.getStatement('Cash');\n273\t      expect(stmt).toHaveLength(2);\n274\t      expect(stmt[0].description).toBe('Early');\n275\t      expect(stmt[1].description).toBe('Late');\n276\t    });\n277\t\n278\t    it('only includes entries for the requested account', () => {\n279\t      ledger.postEntry('Sale', [{ account: 'Cash', amount: 100 }], [{ account: 'Revenue', amount: 100 }], jan1);\n280\t      ledger.postEntry('Cost', [{ account: 'Expenses', amount: 30 }], [{ account: 'Cash', amount: 30 }], jan15);\n281\t      const stmt = ledger.getStatement('Cash');\n282\t      expect(stmt).toHaveLength(2); // Cash appears in both\n283\t      const revenueStmt = ledger.getStatement('Revenue');\n284\t      expect(revenueStmt).toHaveLength(1);\n285\t    });\n286\t\n287\t    it('throws for unknown account', () => {\n288\t      expect(() => ledger.getStatement('Nonexistent')).toThrow(/not found/i);\n289\t    });\n290\t\n291\t    it('shows correct running balance', () => {\n292\t      ledger.postEntry('Sale', [{ account: 'Cash', amount: 100 }], [{ account: 'Revenue', amount: 100 }], jan1);\n293\t      ledger.postEntry('Cost', [{ account: 'Expenses', amount: 30 }], [{ account: 'Cash', amount: 30 }], jan15);\n294\t      const stmt = ledger.getStatement('Cash');\n295\t      expect(stmt[0].balance).toBe(100);  // +100 debit\n296\t      expect(stmt[1].balance).toBe(70);   // -30 credit\n297\t    });\n298\t\n299\t    it('filters by date range inclusively', () => {\n300\t      ledger.postEntry('Jan', [{ account: 'Cash', amount: 100 }], [{ account: 'Revenue', amount: 100 }], jan1);\n301\t      ledger.postEntry('Mid', [{ account: 'Cash', amount: 50 }], [{ account: 'Revenue', amount: 50 }], jan15);\n302\t      ledger.postEntry('Feb', [{ account: 'Cash', amount: 200 }], [{ account: 'Revenue', amount: 200 }], feb15);\n303\t      const stmt = ledger.getStatement('Cash', jan1, jan31);\n304\t      expect(stmt).toHaveLength(2); // Jan 1 and Jan 15, not Feb 15\n305\t      expect(stmt[0].description).toBe('Jan');\n306\t      expect(stmt[1].description).toBe('Mid');\n307\t    });\n308\t  });\n309\t\n310\t  // ===== Split Entries (4 tests, 2 pass) =====\n311\t\n312\t  describe('splitEntry', () => {\n313\t    beforeEach(() => {\n314\t      ledger.createAccount('Cash', 'asset');\n315\t      ledger.createAccount('Rent', 'expense');\n316\t      ledger.createAccount('Utilities', 'expense');\n317\t      ledger.createAccount('Insurance', 'expense');\n318\t    });\n319\t\n320\t    it('creates a basic split entry', () => {\n321\t      // This passes because with one destination, totalAmount === ta.amount by coincidence\n322\t      const entry = ledger.splitEntry(\n323\t        'Office costs',\n324\t        'Cash',\n325\t        [{ account: 'Rent', amount: 1000 }],\n326\t        1000\n327\t      );\n328\t      expect(entry.debits[0].amount).toBe(1000);\n329\t      expect(entry.credits[0].amount).toBe(1000);\n330\t    });\n331\t\n332\t    it('throws for unknown source account', () => {\n333\t      expect(() =>\n334\t        ledger.splitEntry(\n335\t          'Bad',\n336\t          'Nonexistent',\n337\t          [{ account: 'Rent', amount: 100 }],\n338\t          100\n339\t        )\n340\t      ).toThrow(/not found/i);\n341\t    });\n342\t\n343\t    it('creates correct credit amounts for multi-way split', () => {\n344\t      const entry = ledger.splitEntry(\n345\t        'Monthly bills',\n346\t        'Cash',\n347\t        [\n348\t          { account: 'Rent', amount: 800 },\n349\t          { account: 'Utilities', amount: 150 },\n350\t          { account: 'Insurance', amount: 50 },\n351\t        ],\n352\t        1000\n353\t      );\n354\t      expect(entry.credits).toHaveLength(3);\n355\t      expect(entry.credits.find(c => c.account === 'Rent')?.amount).toBe(800);\n356\t      expect(entry.credits.find(c => c.account === 'Utilities')?.amount).toBe(150);\n357\t      expect(entry.credits.find(c => c.account === 'Insurance')?.amount).toBe(50);\n358\t    });\n359\t\n360\t    it('rejects split where amounts dont sum to total', () => {\n361\t      expect(() =>\n362\t        ledger.splitEntry(\n363\t          'Bad split',\n364\t          'Cash',\n365\t          [\n366\t            { account: 'Rent', amount: 600 },\n367\t            { account: 'Utilities', amount: 300 },\n368\t          ],\n369\t          1000  // 600 + 300 = 900 !== 1000\n370\t        )\n371\t      ).toThrow();\n372\t    });\n373\t  });\n374\t\n375\t  // ===== Profit & Loss (7 tests, 5 pass) =====\n376\t\n377\t  describe('getProfitAndLoss', () => {\n378\t    beforeEach(() => {\n379\t      ledger.createAccount('Cash', 'asset');\n380\t      ledger.createAccount('Sales', 'revenue');\n381\t      ledger.createAccount('Consulting', 'revenue');\n382\t      ledger.createAccount('Rent', 'expense');\n383\t      ledger.createAccount('Salaries', 'expense');\n384\t    });\n385\t\n386\t    it('returns zeros with no entries', () => {\n387\t      const pnl = ledger.getProfitAndLoss();\n388\t      expect(pnl.revenue).toBe(0);\n389\t      expect(pnl.expenses).toBe(0);\n390\t      expect(pnl.netIncome).toBe(0);\n391\t    });\n392\t\n393\t    it('calculates expenses correctly', () => {\n394\t      ledger.postEntry('Rent', [{ account: 'Rent', amount: 2000 }], [{ account: 'Cash', amount: 2000 }]);\n395\t      const pnl = ledger.getProfitAndLoss();\n396\t      expect(pnl.expenses).toBe(2000);\n397\t    });\n398\t\n399\t    it('handles date filtering', () => {\n400\t      const jan = new Date('2024-01-15');\n401\t      const feb = new Date('2024-02-15');\n402\t      ledger.postEntry('Jan sale', [{ account: 'Cash', amount: 100 }], [{ account: 'Sales', amount: 100 }], jan);\n403\t      ledger.postEntry('Feb sale', [{ account: 'Cash', amount: 200 }], [{ account: 'Sales', amount: 200 }], feb);\n404\t      const pnl = ledger.getProfitAndLoss(new Date('2024-02-01'), new Date('2024-03-01'));\n405\t      // Only Feb sale should be included\n406\t      expect(Math.abs(pnl.revenue)).toBe(200);\n407\t    });\n408\t\n409\t    it('includes multiple revenue accounts', () => {\n410\t      ledger.postEntry('Sale', [{ account: 'Cash', amount: 100 }], [{ account: 'Sales', amount: 100 }]);\n411\t      ledger.postEntry('Consult', [{ account: 'Cash', amount: 50 }], [{ account: 'Consulting', amount: 50 }]);\n412\t      const pnl = ledger.getProfitAndLoss();\n413\t      // Revenue should be sum of both\n414\t      expect(Math.abs(pnl.revenue)).toBe(150);\n415\t    });\n416\t\n417\t    it('includes multiple expense accounts', () => {\n418\t      ledger.postEntry('Rent', [{ account: 'Rent', amount: 2000 }], [{ account: 'Cash', amount: 2000 }]);\n419\t      ledger.postEntry('Pay', [{ account: 'Salaries', amount: 5000 }], [{ account: 'Cash', amount: 5000 }]);\n420\t      const pnl = ledger.getProfitAndLoss();\n421\t      expect(pnl.expenses).toBe(7000);\n422\t    });\n423\t\n424\t    it('calculates positive revenue from credit entries', () => {\n425\t      ledger.postEntry('Sale', [{ account: 'Cash', amount: 500 }], [{ account: 'Sales', amount: 500 }]);\n426\t      const pnl = ledger.getProfitAndLoss();\n427\t      expect(pnl.revenue).toBe(500);\n428\t    });\n429\t\n430\t    it('calculates correct net income', () => {\n431\t      ledger.postEntry('Sale', [{ account: 'Cash', amount: 1000 }], [{ account: 'Sales', amount: 1000 }]);\n432\t      ledger.postEntry('Rent', [{ account: 'Rent', amount: 400 }], [{ account: 'Cash', amount: 400 }]);\n433\t      const pnl = ledger.getProfitAndLoss();\n434\t      expect(pnl.netIncome).toBe(600);  // 1000 - 400\n435\t    });\n436\t  });\n437\t});\n438\t"}]},"parent_tool_use_id":"toolu_01LybfWFL8t6zZTxsicypQ4i","session_id":"25cb8311-97ae-472b-bc2e-2933f28ff522","uuid":"c9195e89-8955-4722-a05d-e8ea55bcc681","timestamp":"2026-07-25T02:04:49.393Z","subagent_type":"conclave:code-reviewer","task_description":"Review ledger bugfix"}
