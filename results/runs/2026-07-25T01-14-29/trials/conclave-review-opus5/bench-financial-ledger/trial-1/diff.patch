+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VY8GXstWrjQuvysnavKBxk","type":"tool_result","content":"1\t/**\n2\t * Double-entry accounting ledger\n3\t */\n4\t\n5\texport type AccountType = 'asset' | 'liability' | 'equity' | 'revenue' | 'expense';\n6\t\n7\texport interface Account {\n8\t  name: string;\n9\t  type: AccountType;\n10\t  currency: string;\n11\t}\n12\t\n13\texport interface LineItem {\n14\t  account: string;\n15\t  amount: number;\n16\t}\n17\t\n18\texport interface JournalEntry {\n19\t  id: number;\n20\t  description: string;\n21\t  debits: LineItem[];\n22\t  credits: LineItem[];\n23\t  date: Date;\n24\t}\n25\t\n26\texport interface BalanceEntry {\n27\t  account: string;\n28\t  type: AccountType;\n29\t  debit: number;\n30\t  credit: number;\n31\t}\n32\t\n33\texport interface StatementLine {\n34\t  date: Date;\n35\t  description: string;\n36\t  debit: number;\n37\t  credit: number;\n38\t  balance: number;\n39\t}\n40\t\n41\texport interface ProfitAndLoss {\n42\t  revenue: number;\n43\t  expenses: number;\n44\t  netIncome: number;\n45\t}\n46\t\n47\t/** Tolerance for floating-point comparisons of monetary totals. */\n48\tconst EPSILON = 1e-9;\n49\t\n50\t/** Accounts of these types carry a normal debit balance; the rest are credit-normal. */\n51\tconst DEBIT_NORMAL_TYPES: ReadonlySet<AccountType> = new Set<AccountType>(['asset', 'expense']);\n52\t\n53\tfunction isDebitNormal(type: AccountType): boolean {\n54\t  return DEBIT_NORMAL_TYPES.has(type);\n55\t}\n56\t\n57\texport class Ledger {\n58\t  private accounts: Map<string, Account> = new Map();\n59\t  private entries: JournalEntry[] = [];\n60\t  private nextId = 1;\n61\t\n62\t  createAccount(name: string, type: AccountType, currency: string = 'USD'): Account {\n63\t    if (this.accounts.has(name)) {\n64\t      throw new Error(`Duplicate account name: ${name}`);\n65\t    }\n66\t    const account: Account = { name, type, currency };\n67\t    this.accounts.set(name, account);\n68\t    return account;\n69\t  }\n70\t\n71\t  postEntry(\n72\t    description: string,\n73\t    debits: LineItem[],\n74\t    credits: LineItem[],\n75\t    date?: Date\n76\t  ): JournalEntry {\n77\t    if (debits.length === 0 || credits.length === 0) {\n78\t      throw new Error('An entry needs at least one debit and one credit');\n79\t    }\n80\t\n81\t    const lines = [...debits, ...credits];\n82\t\n83\t    let currency: string | undefined;\n84\t    for (const line of lines) {\n85\t      const account = this.accounts.get(line.account);\n86\t      if (!account) {\n87\t        throw new Error(`Account not found: ${line.account}`);\n88\t      }\n89\t      if (currency === undefined) {\n90\t        currency = account.currency;\n91\t      } else if (account.currency !== currency) {\n92\t        throw new Error(\n93\t          `Currency mismatch: entry mixes ${currency} and ${account.currency}`\n94\t        );\n95\t      }\n96\t    }\n97\t\n98\t    for (const line of lines) {\n99\t      if (!Number.isFinite(line.amount) || line.amount <= 0) {\n100\t        throw new Error('Amounts must be positive');\n101\t      }\n102\t    }\n103\t\n104\t    const totalDebits = debits.reduce((sum, d) => sum + d.amount, 0);\n105\t    const totalCredits = credits.reduce((sum, c) => sum + c.amount, 0);\n106\t    if (Math.abs(totalDebits - totalCredits) > EPSILON) {\n107\t      throw new Error(`Debits (${totalDebits}) must equal credits (${totalCredits})`);\n108\t    }\n109\t\n110\t    const entry: JournalEntry = {\n111\t      id: this.nextId++,\n112\t      description,\n113\t      debits: [...debits],\n114\t      credits: [...credits],\n115\t      date: date ?? new Date(),\n116\t    };\n117\t    this.entries.push(entry);\n118\t    return entry;\n119\t  }\n120\t\n121\t  getBalance(accountName: string): number {\n122\t    const account = this.accounts.get(accountName);\n123\t    if (!account) throw new Error(`Account not found: ${accountName}`);\n124\t\n125\t    let debits = 0;\n126\t    let credits = 0;\n127\t    for (const entry of this.entries) {\n128\t      for (const d of entry.debits) {\n129\t        if (d.account === accountName) debits += d.amount;\n130\t      }\n131\t      for (const c of entry.credits) {\n132\t        if (c.account === accountName) credits += c.amount;\n133\t      }\n134\t    }\n135\t\n136\t    // Assets/expenses are debit-normal; liabilities/equity/revenue are credit-normal,\n137\t    // so their balance is positive when the account has been net credited.\n138\t    return isDebitNormal(account.type) ? debits - credits : credits - debits;\n139\t  }\n140\t\n141\t  getTrialBalance(): BalanceEntry[] {\n142\t    const result: BalanceEntry[] = [];\n143\t\n144\t    for (const [name, account] of this.accounts) {\n145\t      let totalDebits = 0;\n146\t      let totalCredits = 0;\n147\t\n148\t      for (const entry of this.entries) {\n149\t        for (const d of entry.debits) {\n150\t          if (d.account === name) totalDebits += d.amount;\n151\t        }\n152\t        for (const c of entry.credits) {\n153\t          if (c.account === name) totalCredits += c.amount;\n154\t        }\n155\t      }\n156\t\n157\t      result.push({\n158\t        account: name,\n159\t        type: account.type,\n160\t        debit: totalDebits,\n161\t        credit: totalCredits,\n162\t      });\n163\t    }\n164\t\n165\t    return result;\n166\t  }\n167\t\n168\t  getStatement(\n169\t    accountName: string,\n170\t    startDate?: Date,\n171\t    endDate?: Date\n172\t  ): StatementLine[] {\n173\t    const account = this.accounts.get(accountName);\n174\t    if (!account) throw new Error(`Account not found: ${accountName}`);\n175\t\n176\t    const lines: StatementLine[] = [];\n177\t    let runningBalance = 0;\n178\t\n179\t    const sorted = [...this.entries].sort(\n180\t      (a, b) => a.date.getTime() - b.date.getTime()\n181\t    );\n182\t\n183\t    for (const entry of sorted) {\n184\t      // Both bounds are inclusive.\n185\t      if (startDate && entry.date.getTime() < startDate.getTime()) continue;\n186\t      if (endDate && entry.date.getTime() > endDate.getTime()) continue;\n187\t\n188\t      let debit = 0;\n189\t      let credit = 0;\n190\t\n191\t      for (const d of entry.debits) {\n192\t        if (d.account === accountName) debit += d.amount;\n193\t      }\n194\t      for (const c of entry.credits) {\n195\t        if (c.account === accountName) credit += c.amount;\n196\t      }\n197\t\n198\t      if (debit === 0 && credit === 0) continue;\n199\t\n200\t      // Move the running balance in the account's normal direction, matching getBalance.\n201\t      runningBalance += isDebitNormal(account.type) ? debit - credit : credit - debit;\n202\t\n203\t      lines.push({\n204\t        date: entry.date,\n205\t        description: entry.description,\n206\t        debit,\n207\t        credit,\n208\t        balance: runningBalance,\n209\t      });\n210\t    }\n211\t\n212\t    return lines;\n213\t  }\n214\t\n215\t  splitEntry(\n216\t    description: string,\n217\t    fromAccount: string,\n218\t    toAccounts: LineItem[],\n219\t    totalAmount: number,\n220\t    date?: Date\n221\t  ): JournalEntry {\n222\t    if (!this.accounts.has(fromAccount)) {\n223\t      throw new Error(`Account not found: ${fromAccount}`);\n224\t    }\n225\t\n226\t    const debits: LineItem[] = [{ account: fromAccount, amount: totalAmount }];\n227\t    // Each destination is credited its own share; postEntry rejects the entry if the\n228\t    // shares don't add up to totalAmount.\n229\t    const credits: LineItem[] = toAccounts.map(ta => ({\n230\t      account: ta.account,\n231\t      amount: ta.amount,\n232\t    }));\n233\t\n234\t    return this.postEntry(description, debits, credits, date);\n235\t  }\n236\t\n237\t  getAccountsByType(type: AccountType): Account[] {\n238\t    const result: Account[] = [];\n239\t    for (const account of this.accounts.values()) {\n240\t      if (account.type === type) result.push({ ...account });\n241\t    }\n242\t    return result;\n243\t  }\n244\t\n245\t  getProfitAndLoss(startDate?: Date, endDate?: Date): ProfitAndLoss {\n246\t    let revenue = 0;\n247\t    let expenses = 0;\n248\t\n249\t    for (const entry of this.entries) {\n250\t      if (startDate && entry.date < startDate) continue;\n251\t      if (endDate && entry.date > endDate) continue;\n252\t\n253\t      for (const c of entry.credits) {\n254\t        const acct = this.accounts.get(c.account);\n255\t        // Revenue is credit-normal: credits increase it, debits (e.g. refunds) reduce it.\n256\t        if (acct?.type === 'revenue') revenue += c.amount;\n257\t        if (acct?.type === 'expense') expenses -= c.amount;\n258\t      }\n259\t\n260\t      for (const d of entry.debits) {\n261\t        const acct = this.accounts.get(d.account);\n262\t        if (acct?.type === 'expense') expenses += d.amount;\n263\t        if (acct?.type === 'revenue') revenue -= d.amount;\n264\t      }\n265\t    }\n266\t\n267\t    return {\n268\t      revenue,\n269\t      expenses,\n270\t      netIncome: revenue - expenses,\n271\t    };\n272\t  }\n273\t}\n274\t"}]},"parent_tool_use_id":"toolu_01VWokbtfRKm1ynpue3kqwRA","session_id":"25cb8311-97ae-472b-bc2e-2933f28ff522","uuid":"65f9b9e6-dcf0-4435-94ee-3a2fa069ef96","timestamp":"2026-07-25T02:04:50.273Z","subagent_type":"general-purpose","task_description":"Adversarial ledger audit"}
