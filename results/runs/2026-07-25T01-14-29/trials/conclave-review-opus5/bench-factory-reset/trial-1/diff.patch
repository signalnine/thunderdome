+import { popcount32 } from './bits.js';
+
+/**
+ * Reduced row-echelon form of a linear system over GF(2).
+ *
+ * Rows are stored packed, `wordsPerRow` 32-bit words per row, one bit per
+ * unknown. The right-hand side is kept separately.
+ */
+export interface Gf2Rref {
+  /** Number of unknowns (columns). */
+  cols: number;
+  /** 32-bit words used to store one row. */
+  wordsPerRow: number;
+  /** Packed coefficient rows, only the first `rank` rows are meaningful. */
+  rows: Uint32Array;
+  /** Right-hand side bit of each row. */
+  rhs: Uint8Array;
+  rank: number;
+  /** Column of the leading 1 of row `t`, for `t < rank`. */
+  pivotCols: number[];
+  /** Columns without a pivot; these are the free unknowns. */
+  freeCols: number[];
+  /** False when the system has no solution at all. */
+  consistent: boolean;
+}
+
+/**
+ * Gauss-Jordan elimination over GF(2).
+ *
+ * `equations` holds `equationCount` packed rows of `wordsPerRow` words each;
+ * `rhsBits[i]` is the right-hand side of equation `i`. Both are consumed
+ * (mutated) by this function.
+ */
+export function rref(
+  equations: Uint32Array,
+  rhsBits: Uint8Array,
+  equationCount: number,
+  cols: number,
+  wordsPerRow: number,
+): Gf2Rref {
+  let rank = 0;
+  const pivotCols: number[] = [];
+  const isPivotCol = new Uint8Array(cols);
+
+  for (let col = 0; col < cols && rank < equationCount; col++) {
+    const word = col >>> 5;
+    const bit = 1 << (col & 31);
+
+    let pivot = -1;
+    for (let r = rank; r < equationCount; r++) {
+      if ((equations[r * wordsPerRow + word] & bit) !== 0) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot === -1) continue;
+
+    if (pivot !== rank) {
+      const a = pivot * wordsPerRow;
+      const b = rank * wordsPerRow;
+      for (let w = 0; w < wordsPerRow; w++) {
+        const tmp = equations[a + w];
+        equations[a + w] = equations[b + w];
+        equations[b + w] = tmp;
+      }
+      const tmpRhs = rhsBits[pivot];
+      rhsBits[pivot] = rhsBits[rank];
+      rhsBits[rank] = tmpRhs;
+    }
+
+    const base = rank * wordsPerRow;
+    for (let r = 0; r < equationCount; r++) {
+      if (r === rank) continue;
+      const off = r * wordsPerRow;
+      if ((equations[off + word] & bit) === 0) continue;
+      for (let w = 0; w < wordsPerRow; w++) equations[off + w] ^= equations[base + w];
+      rhsBits[r] ^= rhsBits[rank];
+    }
+
+    pivotCols.push(col);
+    isPivotCol[col] = 1;
+    rank++;
+  }
+
+  let consistent = true;
+  for (let r = rank; r < equationCount; r++) {
+    if (rhsBits[r] !== 0) {
+      consistent = false;
+      break;
+    }
+  }
+
+  const freeCols: number[] = [];
+  for (let col = 0; col < cols; col++) if (!isPivotCol[col]) freeCols.push(col);
+
+  return { cols, wordsPerRow, rows: equations, rhs: rhsBits, rank, pivotCols, freeCols, consistent };
+}
+
+/** Particular solution obtained by setting every free unknown to 0. */
+export function particularSolution(system: Gf2Rref): Uint32Array {
+  const out = new Uint32Array(system.wordsPerRow);
+  for (let t = 0; t < system.rank; t++) {
+    if (system.rhs[t] === 1) {
+      const col = system.pivotCols[t];
+      out[col >>> 5] |= 1 << (col & 31);
+    }
+  }
+  return out;
+}
+
+/**
+ * Basis of the solution space's null space, one packed vector per free unknown.
+ * Returned as a flat array of `freeCols.length * wordsPerRow` words.
+ */
+export function nullSpaceBasis(system: Gf2Rref): Uint32Array {
+  const { wordsPerRow, freeCols, rank, pivotCols, rows } = system;
+  const basis = new Uint32Array(freeCols.length * wordsPerRow);
+  for (let j = 0; j < freeCols.length; j++) {
+    const free = freeCols[j];
+    const off = j * wordsPerRow;
+    basis[off + (free >>> 5)] |= 1 << (free & 31);
+    const word = free >>> 5;
+    const bit = 1 << (free & 31);
+    for (let t = 0; t < rank; t++) {
+      if ((rows[t * wordsPerRow + word] & bit) !== 0) {
+        const p = pivotCols[t];
+        basis[off + (p >>> 5)] |= 1 << (p & 31);
+      }
+    }
+  }
+  return basis;
+}
+
+/** Hamming weight of a packed vector. */
+export function weight(vec: Uint32Array, off: number, wordsPerRow: number): number {
+  let total = 0;
+  for (let w = 0; w < wordsPerRow; w++) total += popcount32(vec[off + w]);
+  return total;
+}
