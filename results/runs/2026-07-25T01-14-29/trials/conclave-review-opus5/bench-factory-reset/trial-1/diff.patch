new file mode 100644
index 0000000..95d14a0
--- /dev/null
+++ b/src/toggle.ts
@@ -0,0 +1,415 @@
+import { ctz32, popcount32 } from './bits.js';
+import { nullSpaceBasis, particularSolution, rref, weight } from './gf2.js';
+
+export interface Machine {
+  /** Desired state of each light; every light starts off. */
+  target: boolean[];
+  /** `buttons[i]` lists the light indices toggled by button `i`. */
+  buttons: number[][];
+}
+
+/**
+ * Beyond this many free unknowns, walking the whole null space costs more than
+ * a meet-in-the-middle sweep over the buttons.
+ */
+const NULL_SPACE_ENUM_LIMIT = 22;
+
+/**
+ * Hard ceiling on the null-space walk. Past this the 2^k sweep would run for
+ * hours, and `ctz32` stops being meaningful once the counter passes 2^32.
+ */
+const NULL_SPACE_WALK_LIMIT = 30;
+
+/**
+ * Meet in the middle enumerates 2^ceil(m/2) subsets per half and packs each
+ * subset into a 32-bit word, so the button count has to stay modest.
+ */
+const MEET_IN_MIDDLE_BUTTON_LIMIT = 48;
+
+/**
+ * Compare two candidate button sets, both packed as bit vectors of the same
+ * width. Fewer presses wins; on a tie the set whose sorted index list is
+ * lexicographically smaller wins, which is the set containing the smallest
+ * index the two disagree on.
+ *
+ * Returns a negative number when `a` is the better candidate.
+ */
+function comparePacked(
+  a: Uint32Array,
+  aOff: number,
+  aWeight: number,
+  b: Uint32Array,
+  bOff: number,
+  bWeight: number,
+  wordsPerRow: number,
+): number {
+  if (aWeight !== bWeight) return aWeight - bWeight;
+  for (let w = 0; w < wordsPerRow; w++) {
+    const diff = (a[aOff + w] ^ b[bOff + w]) >>> 0;
+    if (diff !== 0) {
+      const bit = ctz32(diff);
+      return (a[aOff + w] >>> bit) & 1 ? -1 : 1;
+    }
+  }
+  return 0;
+}
+
+/** Same ordering as `comparePacked`, for candidates that fit in two words. */
+function compareSplit(
+  aLo: number,
+  aHi: number,
+  aWeight: number,
+  bLo: number,
+  bHi: number,
+  bWeight: number,
+): number {
+  if (aWeight !== bWeight) return aWeight - bWeight;
+  const diffLo = (aLo ^ bLo) >>> 0;
+  if (diffLo !== 0) {
+    const bit = ctz32(diffLo);
+    return (aLo >>> bit) & 1 ? -1 : 1;
+  }
+  const diffHi = (aHi ^ bHi) >>> 0;
+  if (diffHi !== 0) {
+    const bit = ctz32(diffHi);
+    return (aHi >>> bit) & 1 ? -1 : 1;
+  }
+  return 0;
+}
+
+function indicesFromPacked(vec: Uint32Array, cols: number): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < cols; i++) {
+    if ((vec[i >>> 5] >>> (i & 31)) & 1) out.push(i);
+  }
+  return out;
+}
+
+/**
+ * Walk every point of the affine solution space in Gray-code order, keeping the
+ * best one. Costs 2^k vector updates for `k` free unknowns.
+ */
+function searchNullSpace(
+  base: Uint32Array,
+  basis: Uint32Array,
+  freeCount: number,
+  wordsPerRow: number,
+): Uint32Array {
+  const current = base.slice();
+  const best = current.slice();
+  let bestWeight = weight(current, 0, wordsPerRow);
+
+  const total = 2 ** freeCount;
+  for (let g = 1; g < total; g++) {
+    const flipped = ctz32(g);
+    const off = flipped * wordsPerRow;
+    for (let w = 0; w < wordsPerRow; w++) current[w] ^= basis[off + w];
+
+    const currentWeight = weight(current, 0, wordsPerRow);
+    if (currentWeight > bestWeight) continue;
+    if (comparePacked(current, 0, currentWeight, best, 0, bestWeight, wordsPerRow) < 0) {
+      best.set(current);
+      bestWeight = currentWeight;
+    }
+  }
+  return best;
+}
+
+/**
+ * Open-addressed map from a 64-bit light mask to the best button subset of the
+ * first half that produces it. Typed arrays keep a million entries affordable.
+ */
+class MaskTable {
+  private readonly mask: number;
+  // Keys must be unsigned: callers pass masks through `>>> 0`, and an
+  // Int32Array would fold a set bit 31 to a negative value that never compares
+  // equal to the unsigned probe.
+  private readonly keyLo: Uint32Array;
+  private readonly keyHi: Uint32Array;
+  private readonly value: Int32Array;
+
+  constructor(capacityLog2: number) {
+    const capacity = 1 << capacityLog2;
+    this.mask = capacity - 1;
+    this.keyLo = new Uint32Array(capacity);
+    this.keyHi = new Uint32Array(capacity);
+    this.value = new Int32Array(capacity).fill(-1);
+  }
+
+  private slot(lo: number, hi: number): number {
+    let h = (lo ^ Math.imul(hi, 0x9e3779b1)) >>> 0;
+    h = Math.imul(h ^ (h >>> 15), 0x85ebca6b) >>> 0;
+    return ((h ^ (h >>> 13)) >>> 0) & this.mask;
+  }
+
+  /** Keep `subset` if it beats whatever is already stored for this mask. */
+  offer(lo: number, hi: number, subset: number, subsetWeight: number): void {
+    let i = this.slot(lo, hi);
+    for (;;) {
+      const existing = this.value[i];
+      if (existing === -1) {
+        this.keyLo[i] = lo;
+        this.keyHi[i] = hi;
+        this.value[i] = subset;
+        return;
+      }
+      if (this.keyLo[i] === lo && this.keyHi[i] === hi) {
+        const existingWeight = popcount32(existing);
+        if (compareSplit(subset, 0, subsetWeight, existing, 0, existingWeight) < 0) {
+          this.value[i] = subset;
+        }
+        return;
+      }
+      i = (i + 1) & this.mask;
+    }
+  }
+
+  /** Stored subset for this mask, or -1. */
+  get(lo: number, hi: number): number {
+    let i = this.slot(lo, hi);
+    for (;;) {
+      const existing = this.value[i];
+      if (existing === -1) return -1;
+      if (this.keyLo[i] === lo && this.keyHi[i] === hi) return existing;
+      i = (i + 1) & this.mask;
+    }
+  }
+}
+
+/**
+ * Meet in the middle: enumerate subsets of the low half of the buttons and
+ * index them by the lights they toggle, then sweep subsets of the high half
+ * looking for the complement of the target.
+ *
+ * Keeping only one low-half subset per light mask is sound, which is the
+ * load-bearing invariant here. For a fixed high-half subset H, the press count
+ * of the pair is |L| + |H|, so ranking candidate Ls by press count is
+ * independent of H; and because every low index is below every high index, the
+ * lexicographic comparison of the merged index lists is settled inside L before
+ * H is ever consulted. The best L for a mask is therefore the best L for that
+ * mask against every possible H at once.
+ */
+function searchMeetInMiddle(
+  buttonLo: Int32Array,
+  buttonHi: Int32Array,
+  buttonCount: number,
+  targetLo: number,
+  targetHi: number,
+  maskDimension: number,
+): number[] | null {
+  const splitAt = buttonCount >>> 1;
+  const highCount = buttonCount - splitAt;
+
+  // Occupancy is bounded both by the number of subsets of the low half and by
+  // the number of distinct light patterns they can reach; sizing above the
+  // smaller of the two keeps the load factor at most one half, which caps probe
+  // lengths and guarantees a free slot always exists.
+  const capacityLog2 = Math.max(4, Math.min(splitAt, maskDimension) + 1);
+  const table = new MaskTable(capacityLog2);
+
+  table.offer(0, 0, 0, 0);
+  let lo = 0;
+  let hi = 0;
+  let subset = 0;
+  const lowTotal = 2 ** splitAt;
+  for (let g = 1; g < lowTotal; g++) {
+    const flipped = ctz32(g);
+    subset ^= 1 << flipped;
+    lo = (lo ^ buttonLo[flipped]) >>> 0;
+    hi = (hi ^ buttonHi[flipped]) >>> 0;
+    table.offer(lo, hi, subset >>> 0, popcount32(subset));
+  }
+
+  let bestLo = 0;
+  let bestHi = 0;
+  let bestWeight = -1;
+
+  const consider = (lowSubset: number, highSubset: number): void => {
+    let comboLo: number;
+    let comboHi: number;
+    if (splitAt === 0) {
+      // Only reachable for a single button; shifting by 32 would be a no-op.
+      comboLo = highSubset >>> 0;
+      comboHi = 0;
+    } else {
+      comboLo = (lowSubset | (highSubset << splitAt)) >>> 0;
+      comboHi = highSubset >>> (32 - splitAt);
+    }
+    const total = popcount32(lowSubset) + popcount32(highSubset);
+    if (bestWeight === -1 || compareSplit(comboLo, comboHi, total, bestLo, bestHi, bestWeight) < 0) {
+      bestLo = comboLo;
+      bestHi = comboHi;
+      bestWeight = total;
+    }
+  };
+
+  const probe = (maskLo: number, maskHi: number, highSubset: number): void => {
+    const found = table.get((targetLo ^ maskLo) >>> 0, (targetHi ^ maskHi) >>> 0);
+    if (found !== -1) consider(found, highSubset);
+  };
+
+  probe(0, 0, 0);
+  lo = 0;
+  hi = 0;
+  subset = 0;
+  const highTotal = 2 ** highCount;
+  for (let g = 1; g < highTotal; g++) {
+    const flipped = ctz32(g);
+    subset ^= 1 << flipped;
+    lo = (lo ^ buttonLo[splitAt + flipped]) >>> 0;
+    hi = (hi ^ buttonHi[splitAt + flipped]) >>> 0;
+    probe(lo, hi, subset >>> 0);
+  }
+
+  if (bestWeight === -1) return null;
+  const out: number[] = [];
+  for (let i = 0; i < buttonCount; i++) {
+    const word = i < 32 ? bestLo : bestHi;
+    if ((word >>> (i & 31)) & 1) out.push(i);
+  }
+  return out;
+}
+
+/**
+ * Drop buttons that can never appear in an optimal answer.
+ *
+ * A button wired to no lights only inflates the press count. Two buttons wired
+ * to the same lights cancel each other, so an optimal answer uses at most one
+ * of them, and the lexicographic tie-break always prefers the lowest index of
+ * the group.
+ */
+function reduceButtons(
+  buttons: number[][],
+  lightCount: number,
+): { buttons: number[][]; originalIndex: number[] } {
+  const words = Math.max(1, Math.ceil(lightCount / 32));
+  const seen = new Map<string, number>();
+  const kept: number[][] = [];
+  const originalIndex: number[] = [];
+
+  for (let b = 0; b < buttons.length; b++) {
+    const mask = new Uint32Array(words);
+    for (const light of buttons[b]) mask[light >>> 5] ^= 1 << (light & 31);
+    let empty = true;
+    for (let w = 0; w < words; w++) {
+      if (mask[w] !== 0) {
+        empty = false;
+        break;
+      }
+    }
+    if (empty) continue;
+    const key = mask.join(',');
+    if (seen.has(key)) continue;
+    seen.set(key, kept.length);
+    kept.push(buttons[b]);
+    originalIndex.push(b);
+  }
+  return { buttons: kept, originalIndex };
+}
+
+/**
+ * Which exact search to run. `auto` picks whichever is cheaper; the explicit
+ * values let the tests exercise both paths on the same instance.
+ */
+export type ToggleStrategy = 'auto' | 'null-space' | 'meet-in-middle';
+
+/**
+ * Smallest set of buttons whose combined toggles turn the all-off machine into
+ * `machine.target`, or null when the target is unreachable.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  return solveToggleWith(machine, 'auto');
+}
+
+/** `solveToggle` with the search strategy pinned. Both strategies are exact. */
+export function solveToggleWith(machine: Machine, strategy: ToggleStrategy): number[] | null {
+  // Lights referenced by a button but missing from `target` still exist and
+  // must end up off.
+  let lightCount = machine.target.length;
+  for (const wired of machine.buttons) {
+    for (const light of wired) {
+      if (!Number.isInteger(light) || light < 0) {
+        throw new RangeError(`invalid light index: ${light}`);
+      }
+      if (light + 1 > lightCount) lightCount = light + 1;
+    }
+  }
+
+  const { buttons, originalIndex } = reduceButtons(machine.buttons, lightCount);
+  const buttonCount = buttons.length;
+
+  const wordsPerButton = Math.max(1, Math.ceil(buttonCount / 32));
+  const equations = new Uint32Array(lightCount * wordsPerButton);
+  const rhs = new Uint8Array(lightCount);
+  for (let i = 0; i < lightCount; i++) rhs[i] = machine.target[i] ? 1 : 0;
+  for (let b = 0; b < buttonCount; b++) {
+    const word = b >>> 5;
+    const bit = 1 << (b & 31);
+    // Repeated indices cancel, matching what pressing the button does.
+    for (const light of buttons[b]) equations[light * wordsPerButton + word] ^= bit;
+  }
+
+  const system = rref(equations, rhs, lightCount, buttonCount, wordsPerButton);
+  if (!system.consistent) return null;
+  if (buttonCount === 0) return [];
+
+  const restore = (reduced: number[] | null): number[] | null =>
+    reduced === null ? null : reduced.map((i) => originalIndex[i]);
+
+  const base = particularSolution(system);
+  const freeCount = system.freeCols.length;
+  if (freeCount === 0) return restore(indicesFromPacked(base, buttonCount));
+
+  const halfCost = 2 ** Math.ceil(buttonCount / 2);
+  // The mask index holds one entry per subset of the low half, so cap the
+  // button count to keep the table sized well above its occupancy.
+  const fitsMeetInMiddle = buttonCount <= MEET_IN_MIDDLE_BUTTON_LIMIT && lightCount <= 64;
+  const useMeetInMiddle =
+    strategy === 'meet-in-middle'
+      ? fitsMeetInMiddle
+      : strategy === 'auto' &&
+        fitsMeetInMiddle &&
+        freeCount > NULL_SPACE_ENUM_LIMIT &&
+        halfCost < 2 ** freeCount;
+
+  if (!useMeetInMiddle && freeCount > NULL_SPACE_WALK_LIMIT) {
+    // Both searches are exponential; refuse loudly rather than spinning for
+    // hours on an instance far outside the documented limits.
+    throw new RangeError(
+      `machine too large to solve exactly: ${buttonCount} buttons and ${lightCount} lights ` +
+        `leave ${freeCount} free unknowns`,
+    );
+  }
+
+  if (useMeetInMiddle) {
+    const buttonLo = new Int32Array(buttonCount);
+    const buttonHi = new Int32Array(buttonCount);
+    for (let b = 0; b < buttonCount; b++) {
+      for (const light of buttons[b]) {
+        if (light < 32) buttonLo[b] ^= 1 << light;
+        else buttonHi[b] ^= 1 << (light - 32);
+      }
+    }
+    let targetLo = 0;
+    let targetHi = 0;
+    for (let i = 0; i < lightCount; i++) {
+      if (!machine.target[i]) continue;
+      if (i < 32) targetLo ^= 1 << i;
+      else targetHi ^= 1 << (i - 32);
+    }
+    return restore(
+      searchMeetInMiddle(
+        buttonLo,
+        buttonHi,
+        buttonCount,
+        targetLo >>> 0,
+        targetHi >>> 0,
+        system.rank,
+      ),
+    );
+  }
+
+  const basis = nullSpaceBasis(system);
+  const best = searchNullSpace(base, basis, freeCount, wordsPerButton);
+  return restore(indicesFromPacked(best, buttonCount));
+}
