+      const buttons: number[][] = [];
+      for (let b = 0; b < buttonCount; b++) {
+        const wired: number[] = [];
+        for (let l = 0; l < lights; l++) if (rand() < 0.5) wired.push(l);
+        buttons.push(wired);
+      }
