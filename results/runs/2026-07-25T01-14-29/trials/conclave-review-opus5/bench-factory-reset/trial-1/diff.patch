+import { describe, expect, it } from 'vitest';
+import { solveToggle, type Machine } from '../src/index.js';
+import { solveToggleWith } from '../src/toggle.js';
+
+function applyToggle(machine: Machine, presses: number[]): boolean[] {
+  let lightCount = machine.target.length;
+  for (const wired of machine.buttons) {
+    for (const light of wired) lightCount = Math.max(lightCount, light + 1);
+  }
+  const state = new Array<boolean>(lightCount).fill(false);
+  for (const b of presses) {
+    for (const light of machine.buttons[b]) state[light] = !state[light];
+  }
+  return state;
+}
+
+/** Exhaustive reference solver; only usable for small button counts. */
+function bruteToggle(machine: Machine): number[] | null {
+  const m = machine.buttons.length;
+  let best: number[] | null = null;
+  for (let mask = 0; mask < 1 << m; mask++) {
+    const presses: number[] = [];
+    for (let b = 0; b < m; b++) if ((mask >>> b) & 1) presses.push(b);
+    const state = applyToggle(machine, presses);
+    let ok = true;
+    for (let i = 0; i < state.length; i++) {
+      if (state[i] !== (machine.target[i] ?? false)) {
+        ok = false;
+        break;
+      }
+    }
+    if (!ok) continue;
+    if (best === null || presses.length < best.length) {
+      best = presses;
+      continue;
+    }
+    if (presses.length === best.length) {
+      for (let i = 0; i < presses.length; i++) {
+        if (presses[i] !== best[i]) {
+          if (presses[i] < best[i]) best = presses;
+          break;
+        }
+      }
+    }
+  }
+  return best;
+}
+
+function mulberry(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('solveToggle', () => {
+  it('returns null for the unsolvable example from the brief', () => {
+    expect(
+      solveToggle({
+        target: [true, true, false, true],
+        buttons: [
+          [0, 1],
+          [1, 2, 3],
+          [0, 3],
+        ],
+      }),
+    ).toBeNull();
+  });
+
+  it('returns an empty press list when the target is already met', () => {
+    expect(solveToggle({ target: [false, false], buttons: [[0], [1]] })).toEqual([]);
+  });
+
+  it('solves a simple system', () => {
+    expect(
+      solveToggle({
+        target: [true, false, true],
+        buttons: [[0], [1], [2]],
+      }),
+    ).toEqual([0, 2]);
+  });
+
+  it('handles no buttons', () => {
