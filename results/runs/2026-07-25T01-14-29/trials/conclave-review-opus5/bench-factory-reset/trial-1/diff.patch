diff --git a/src/bits.ts b/src/bits.ts
new file mode 100644
index 0000000..03d76a1
--- /dev/null
+++ b/src/bits.ts
@@ -0,0 +1,17 @@
+/** Low-level bit helpers shared by the GF(2) solvers. */
+
+/** Number of set bits in the low 32 bits of `v`. */
+export function popcount32(v: number): number {
+  v = v - ((v >>> 1) & 0x55555555);
+  v = (v & 0x33333333) + ((v >>> 2) & 0x33333333);
+  v = (v + (v >>> 4)) & 0x0f0f0f0f;
+  return (v * 0x01010101) >>> 24;
+}
+
+/**
+ * Index of the lowest set bit of `v`, or -1 when `v` has no set bits in its low
+ * 32. Callers pass loop counters here, so they must keep them under 2^31.
+ */
+export function ctz32(v: number): number {
+  return 31 - Math.clz32(v & -v);
+}
diff --git a/src/counter.ts b/src/counter.ts
new file mode 100644
index 0000000..13be65c
--- /dev/null
+++ b/src/counter.ts
@@ -0,0 +1,570 @@
+/**
+ * Counter puzzle: buttons increment counters, everything wraps at a prime
+ * modulus, and a button may be pressed 0..modulus-1 times.
+ */
+
+/** Multiplicative inverse of `a` modulo the prime `p`. */
+function modInverse(a: number, p: number): number {
+  let old = ((a % p) + p) % p;
+  let cur = p;
+  let oldCoeff = 1;
+  let coeff = 0;
+  while (cur !== 0) {
+    const q = Math.floor(old / cur);
+    [old, cur] = [cur, old - q * cur];
+    [oldCoeff, coeff] = [coeff, oldCoeff - q * coeff];
+  }
+  return ((oldCoeff % p) + p) % p;
+}
+
+interface ModRref {
+  rows: Int32Array;
+  rhs: Int32Array;
+  cols: number;
+  rank: number;
+  pivotCols: number[];
+  freeCols: number[];
+  consistent: boolean;
+}
+
+/** Reduced row-echelon form of an augmented system over GF(p). */
+function rrefMod(
+  rows: Int32Array,
+  rhs: Int32Array,
+  rowCount: number,
+  cols: number,
+  p: number,
+): ModRref {
+  let rank = 0;
+  const pivotCols: number[] = [];
+  const isPivot = new Uint8Array(cols);
+
+  for (let col = 0; col < cols && rank < rowCount; col++) {
+    let pivot = -1;
+    for (let r = rank; r < rowCount; r++) {
+      if (rows[r * cols + col] !== 0) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot === -1) continue;
+
+    if (pivot !== rank) {
+      for (let c = 0; c < cols; c++) {
+        const tmp = rows[pivot * cols + c];
+        rows[pivot * cols + c] = rows[rank * cols + c];
+        rows[rank * cols + c] = tmp;
+      }
+      const tmp = rhs[pivot];
+      rhs[pivot] = rhs[rank];
+      rhs[rank] = tmp;
+    }
+
+    const inv = modInverse(rows[rank * cols + col], p);
+    if (inv !== 1) {
+      for (let c = col; c < cols; c++) {
+        rows[rank * cols + c] = (rows[rank * cols + c] * inv) % p;
+      }
+      rhs[rank] = (rhs[rank] * inv) % p;
+    }
+
+    for (let r = 0; r < rowCount; r++) {
+      if (r === rank) continue;
+      const factor = rows[r * cols + col];
+      if (factor === 0) continue;
+      for (let c = col; c < cols; c++) {
+        rows[r * cols + c] = (rows[r * cols + c] - factor * rows[rank * cols + c]) % p;
+        if (rows[r * cols + c] < 0) rows[r * cols + c] += p;
+      }
+      rhs[r] = (rhs[r] - factor * rhs[rank]) % p;
+      if (rhs[r] < 0) rhs[r] += p;
+    }
+
+    pivotCols.push(col);
+    isPivot[col] = 1;
+    rank++;
+  }
+
+  let consistent = true;
+  for (let r = rank; r < rowCount; r++) {
+    if (rhs[r] !== 0) {
+      consistent = false;
+      break;
+    }
+  }
+
+  const freeCols: number[] = [];
+  for (let col = 0; col < cols; col++) if (!isPivot[col]) freeCols.push(col);
+
+  return { rows, rhs, cols, rank, pivotCols, freeCols, consistent };
+}
+
+/** True when `a` is a better answer than `b`: fewer presses, then lexicographic. */
+function betterThan(aCost: number, a: Int32Array, bCost: number, b: Int32Array): boolean {
+  if (aCost !== bCost) return aCost < bCost;
+  for (let i = 0; i < a.length; i++) {
+    if (a[i] !== b[i]) return a[i] < b[i];
+  }
+  return false;
+}
+
+/**
+ * Wall-clock budget for the branch-and-bound sweep. Minimising a sum over a
+ * coset modulo a prime is NP-hard in general, so with enough free unknowns the
+ * exhaustive search cannot finish; when the budget runs out the best solution
+ * found so far is returned instead of spinning past the caller's deadline.
+ */
+const TIME_BUDGET_MS = 2500;
+
+/** Restarts for the local search that seeds the branch-and-bound bound. */
+const LOCAL_SEARCH_RESTARTS = 64;
+
+/**
+ * Largest button subset the sparse pre-pass will enumerate. Each extra level
+ * multiplies the work by roughly the button count.
+ */
+const SPARSE_SUPPORT_LIMIT = 8;
+
+/**
+ * When the whole solution space is this small the exact search sweeps it
+ * outright, so the heuristic pre-passes would only burn wall-clock.
+ */
+const EXHAUSTIVE_SEARCH_LIMIT = 1e7;
+
+/**
+ * Minimum-press solution to the counter puzzle, or null when the target is
+ * unreachable.
+ *
+ * `modulus` must be prime — the elimination inverts pivot entries, which only
+ * works in a field. Composite moduli are not rejected but give wrong answers.
+ *
+ * The result is always a genuine solution. It is also provably minimal whenever
+ * the exact sweep completes, which covers every system with a unique solution
+ * and every underdetermined one whose optimum the deepening reaches inside
+ * `TIME_BUDGET_MS`. Minimising a press total over a coset modulo a prime is
+ * NP-hard, so on instances where the budget runs out the best solution found by
+ * the heuristic passes is returned instead, and the return value alone does not
+ * distinguish the two cases.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const deadline = Date.now() + TIME_BUDGET_MS;
+  const p = modulus;
+  if (!Number.isInteger(p) || p < 2) {
+    throw new RangeError(`modulus must be an integer >= 2, got ${modulus}`);
+  }
+
+  let counterCount = lights.length;
+  for (const wired of buttons) {
+    for (const idx of wired) {
+      if (!Number.isInteger(idx) || idx < 0) {
+        throw new RangeError(`invalid counter index: ${idx}`);
+      }
+      if (idx + 1 > counterCount) counterCount = idx + 1;
+    }
+  }
+
+  const totalButtons = buttons.length;
+
+  // Repeated indices increment that counter once per occurrence, so a button's
+  // column is the multiplicity vector taken mod p. A button whose column is all
+  // zeros changes nothing and can only inflate the press count: it is always
+  // pressed zero times, so drop it from the search.
+  const column = new Int32Array(counterCount);
+  const active: number[] = [];
+  const columns: Int32Array[] = [];
+  for (let b = 0; b < totalButtons; b++) {
+    column.fill(0);
+    for (const idx of buttons[b]) column[idx] = (column[idx] + 1) % p;
+    if (column.some((v) => v !== 0)) {
+      active.push(b);
+      columns.push(Int32Array.from(column));
+    }
+  }
+
+  const cols = active.length;
+  const stride = Math.max(1, cols);
+  const rows = new Int32Array(counterCount * stride);
+  const rhs = new Int32Array(counterCount);
+  const target = new Int32Array(counterCount);
+  for (let i = 0; i < counterCount; i++) {
+    const value = i < lights.length ? lights[i] : 0;
+    target[i] = (((value % p) + p) % p) | 0;
+    rhs[i] = target[i];
+  }
+  for (let c = 0; c < cols; c++) {
+    const col = columns[c];
+    for (let i = 0; i < counterCount; i++) rows[i * stride + c] = col[i];
+  }
+
+  const system = rrefMod(rows, rhs, counterCount, stride, p);
+  if (!system.consistent) return null;
+
+  const answer = new Int32Array(totalButtons);
+  if (cols === 0) return Array.from(answer);
+
+  const { rank, pivotCols, freeCols } = system;
+  const k = freeCols.length;
+
+  // Coefficients of the free unknowns inside each pivot row.
+  const cf = new Int32Array(rank * Math.max(1, k));
+  const kStride = Math.max(1, k);
+  for (let t = 0; t < rank; t++) {
+    for (let j = 0; j < k; j++) cf[t * kStride + j] = system.rows[t * stride + freeCols[j]];
+  }
+
+  const reduced = new Int32Array(cols);
+  const expand = (free: Int32Array, residual: Int32Array): number => {
+    let cost = 0;
+    for (let j = 0; j < k; j++) {
+      reduced[freeCols[j]] = free[j];
+      cost += free[j];
+    }
+    for (let t = 0; t < rank; t++) {
+      reduced[pivotCols[t]] = residual[t];
+      cost += residual[t];
+    }
+    return cost;
+  };
+
+  const bestReduced = new Int32Array(cols);
+  const residual = new Int32Array(rank);
+
+  const residualFor = (free: Int32Array, out: Int32Array): void => {
+    for (let t = 0; t < rank; t++) {
+      let acc = system.rhs[t];
+      for (let j = 0; j < k; j++) {
+        acc -= cf[t * kStride + j] * free[j];
+      }
+      acc %= p;
+      out[t] = acc < 0 ? acc + p : acc;
+    }
+  };
+
+  const zeroFree = new Int32Array(k);
+  residualFor(zeroFree, residual);
+  let bestCost = expand(zeroFree, residual);
+  bestReduced.set(reduced);
+
+  if (k > 0) {
+    // Coordinate descent, restarted from several starting points, gives the
+    // branch-and-bound a bound tight enough to prune most of the tree.
+    const localDeadline = Date.now() + Math.floor(TIME_BUDGET_MS * 0.3);
+    const current = new Int32Array(k);
+    const currentRes = new Int32Array(rank);
+    const trialRes = new Int32Array(rank);
+    const moveRes = new Int32Array(rank);
+    let seed = 0x9e3779b9;
+    const nextSeed = (): number => {
+      seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+      return seed;
+    };
+
+    // Restarts come from basic solutions: eliminate with the buttons taken in
+    // a shuffled order and press only the resulting pivots. Every solution of
+    // minimal support is basic for some ordering, so these starting points sit
+    // in the cheap, sparse corners of the solution space that a uniformly
+    // random press vector never reaches.
+    const order = new Int32Array(cols);
+    for (let c = 0; c < cols; c++) order[c] = c;
+    const scratch = new Int32Array(counterCount * stride);
+    const scratchRhs = new Int32Array(counterCount);
+    const basic = new Int32Array(cols);
+
+    const drawBasicSolution = (): boolean => {
+      for (let c = cols - 1; c > 0; c--) {
+        const j = nextSeed() % (c + 1);
+        const tmp = order[c];
+        order[c] = order[j];
+        order[j] = tmp;
+      }
+      for (let i = 0; i < counterCount; i++) {
+        for (let c = 0; c < cols; c++) scratch[i * stride + c] = columns[order[c]][i];
+        scratchRhs[i] = target[i];
+      }
+      const shuffled = rrefMod(scratch, scratchRhs, counterCount, stride, p);
+      if (!shuffled.consistent) return false;
+      basic.fill(0);
+      for (let t = 0; t < shuffled.rank; t++) {
+        basic[order[shuffled.pivotCols[t]]] = shuffled.rhs[t];
+      }
+      return true;
+    };
+
+    for (let restart = 0; restart < LOCAL_SEARCH_RESTARTS; restart++) {
+      if (restart === 0) {
+        current.fill(0);
+      } else {
+        if (Date.now() > localDeadline) break;
+        if (!drawBasicSolution()) break;
+        for (let j = 0; j < k; j++) current[j] = basic[freeCols[j]];
+      }
+
+      residualFor(current, currentRes);
+      let currentSum = 0;
+      for (let j = 0; j < k; j++) currentSum += current[j];
+      let currentCost = currentSum;
+      for (let t = 0; t < rank; t++) currentCost += currentRes[t];
+
+      let improving = true;
+      while (improving) {
+        improving = false;
+        for (let j = 0; j < k; j++) {
+          let moveTo = current[j];
+          let moveCost = currentCost;
+          for (let v = 0; v < p; v++) {
+            if (v === current[j]) continue;
+            const shift = current[j] - v;
+            let cost = currentSum - current[j] + v;
+            for (let t = 0; t < rank; t++) {
+              let r = (currentRes[t] + cf[t * kStride + j] * shift) % p;
+              if (r < 0) r += p;
+              trialRes[t] = r;
+              cost += r;
+            }
+            if (cost < moveCost) {
+              moveCost = cost;
+              moveTo = v;
+              moveRes.set(trialRes);
+            }
+          }
+          if (moveTo !== current[j]) {
+            currentSum += moveTo - current[j];
+            current[j] = moveTo;
+            currentRes.set(moveRes);
+            currentCost = moveCost;
+            improving = true;
+          }
+        }
+      }
+
+      const cost = expand(current, currentRes);
+      if (betterThan(cost, reduced, bestCost, bestReduced)) {
+        bestCost = cost;
+        bestReduced.set(reduced);
+      }
+    }
+  }
+
+  // A solution that presses only a handful of buttons is invisible to
+  // coordinate descent, which walks one free unknown at a time through a dense
+  // parameterisation, yet it is exactly the shape a built puzzle tends to have.
+  // Enumerate button subsets in increasing size and read off the unique
+  // combination that hits the target, deepening while the budget allows.
+  if (k > 0 && Math.pow(p, k) > EXHAUSTIVE_SEARCH_LIMIT) {
+    const sparseDeadline = Date.now() + Math.floor(TIME_BUDGET_MS * 0.4);
+    const n = counterCount;
+
+    for (let maxDepth = 1; maxDepth <= SPARSE_SUPPORT_LIMIT; maxDepth++) {
+      if (Date.now() > sparseDeadline) break;
+
+      // Row echelon form of the chosen columns: `basis[d]` is the d-th column
+      // after reduction, normalised to 1 at row `pivotRow[d]` and zero at every
+      // earlier pivot row. `rep[d]` records which chosen columns produced it.
+      const basis = new Int32Array(maxDepth * n);
+      const rep = new Int32Array(maxDepth * maxDepth);
+      const pivotRow = new Int32Array(maxDepth);
+      const chosen = new Int32Array(maxDepth);
+      // Per-level so that recursion never has to undo anything.
+      const unreached = new Int32Array((maxDepth + 1) * n);
+      const presses = new Int32Array((maxDepth + 1) * maxDepth);
+      const work = new Int32Array(n);
+      const workRep = new Int32Array(maxDepth);
+      const candidate = new Int32Array(cols);
+      let visited = 0;
+      let ranOut = false;
+
+      for (let i = 0; i < n; i++) unreached[i] = target[i];
+
+      const record = (depth: number): void => {
+        candidate.fill(0);
+        let cost = 0;
+        for (let d = 0; d < depth; d++) {
+          const value = presses[depth * maxDepth + d];
+          candidate[chosen[d]] = value;
+          cost += value;
+        }
+        if (!betterThan(cost, candidate, bestCost, bestReduced)) return;
+        // The combination comes out of an incremental elimination; confirm it
+        // before letting it cap the exact search.
+        for (let i = 0; i < n; i++) {
+          let acc = 0;
+          for (let d = 0; d < depth; d++) acc += presses[depth * maxDepth + d] * columns[chosen[d]][i];
+          if (acc % p !== target[i]) return;
+        }
+        bestCost = cost;
+        bestReduced.set(candidate);
+      };
+
+      const visit = (depth: number, from: number): void => {
+        for (let c = from; c < cols; c++) {
+          if ((++visited & 0x3fff) === 0 && Date.now() > sparseDeadline) {
+            ranOut = true;
+            return;
+          }
+
+          const col = columns[c];
+          for (let i = 0; i < n; i++) work[i] = col[i];
+          workRep.fill(0);
+          workRep[depth] = 1;
+          for (let d = 0; d < depth; d++) {
+            const factor = work[pivotRow[d]];
+            if (factor === 0) continue;
+            const off = d * n;
+            for (let i = 0; i < n; i++) {
+              const v = (work[i] - factor * basis[off + i]) % p;
+              work[i] = v < 0 ? v + p : v;
+            }
+            const repOff = d * maxDepth;
+            for (let e = 0; e <= depth; e++) {
+              const v = (workRep[e] - factor * rep[repOff + e]) % p;
+              workRep[e] = v < 0 ? v + p : v;
+            }
+          }
+
+          let pivot = -1;
+          for (let i = 0; i < n; i++) {
+            if (work[i] !== 0) {
+              pivot = i;
+              break;
+            }
+          }
+          // A column already spanned by the others adds nothing new here.
+          if (pivot === -1) continue;
+
+          const inv = modInverse(work[pivot], p);
+          const off = depth * n;
+          for (let i = 0; i < n; i++) basis[off + i] = (work[i] * inv) % p;
+          const repOff = depth * maxDepth;
+          for (let e = 0; e <= depth; e++) rep[repOff + e] = (workRep[e] * inv) % p;
+          pivotRow[depth] = pivot;
+          chosen[depth] = c;
+
+          const here = depth * n;
+          const next = here + n;
+          const factor = unreached[here + pivot];
+          for (let i = 0; i < n; i++) {
+            const v = (unreached[here + i] - factor * basis[off + i]) % p;
+            unreached[next + i] = v < 0 ? v + p : v;
+          }
+          const pressHere = depth * maxDepth;
+          const pressNext = pressHere + maxDepth;
+          for (let e = 0; e < maxDepth; e++) {
+            presses[pressNext + e] = (presses[pressHere + e] + factor * rep[repOff + e]) % p;
+          }
+
+          let reached = true;
+          for (let i = 0; i < n; i++) {
+            if (unreached[next + i] !== 0) {
+              reached = false;
+              break;
+            }
+          }
+          if (reached) record(depth + 1);
+
+          if (depth + 1 < maxDepth) {
+            visit(depth + 1, c + 1);
+            if (ranOut) return;
+          }
+        }
+      };
+
+      visit(0, 0);
+    }
+  }
+
+  if (k > 0) {
+    // Equations whose last non-zero free coefficient sits at level j-1 have a
+    // known pivot value once level j is reached; folding them into the bound
+    // makes pruning far sharper than counting free presses alone.
+    const buckets: number[][] = Array.from({ length: k + 1 }, () => []);
+    for (let t = 0; t < rank; t++) {
+      let last = -1;
+      for (let j = k - 1; j >= 0; j--) {
+        if (cf[t * kStride + j] !== 0) {
+          last = j;
+          break;
+        }
+      }
+      buckets[last + 1].push(t);
+    }
+
+    const free = new Int32Array(k);
+    const stack = new Int32Array((k + 1) * Math.max(1, rank));
+    for (let t = 0; t < rank; t++) stack[t] = system.rhs[t];
+
+    let ticks = 0;
+    let outOfTime = false;
+    let threshold = 0;
+    let nextThreshold = Infinity;
+    let reachedLeaf = false;
+
+    const dfs = (level: number, pressed: number, fixedIn: number): void => {
+      if (outOfTime) return;
+      if ((++ticks & 0xffff) === 0 && Date.now() > deadline) {
+        outOfTime = true;
+        return;
+      }
+
+      const base = level * rank;
+      let fixed = fixedIn;
+      for (const t of buckets[level]) fixed += stack[base + t];
+      const bound = pressed + fixed;
+      if (bound > threshold) {
+        if (bound < nextThreshold) nextThreshold = bound;
+        return;
+      }
+
+      if (level === k) {
+        reachedLeaf = true;
+        for (let t = 0; t < rank; t++) residual[t] = stack[base + t];
+        const cost = expand(free, residual);
+        if (betterThan(cost, reduced, bestCost, bestReduced)) {
+          bestCost = cost;
+          bestReduced.set(reduced);
+        }
+        return;
+      }
+
+      const childBase = (level + 1) * rank;
+      for (let t = 0; t < rank; t++) stack[childBase + t] = stack[base + t];
+
+      for (let v = 0; v < p; v++) {
+        if (v > 0) {
+          for (let t = 0; t < rank; t++) {
+            let next = stack[childBase + t] - cf[t * kStride + level];
+            if (next < 0) next += p;
+            stack[childBase + t] = next;
+          }
+        }
+        // The bound only grows with v, so the first overshoot ends the loop.
+        const childBound = pressed + v + fixed;
+        if (childBound > threshold) {
+          if (childBound < nextThreshold) nextThreshold = childBound;
+          break;
+        }
+        free[level] = v;
+        dfs(level + 1, pressed + v, fixed);
+        if (outOfTime) return;
+      }
+      free[level] = 0;
+    };
+
+    // Iterative deepening on the press total. Each sweep is complete for every
+    // solution costing at most `threshold`, so the first sweep that reaches a
+    // leaf has already seen the cheapest solutions, and the local-search
+    // incumbent caps the deepening so the loop always terminates.
+    while (!outOfTime && !reachedLeaf) {
+      nextThreshold = Infinity;
+      dfs(0, 0, 0);
+      if (reachedLeaf || outOfTime || !Number.isFinite(nextThreshold)) break;
+      threshold = Math.min(nextThreshold, bestCost);
+    }
+  }
+
+  for (let c = 0; c < cols; c++) answer[active[c]] = bestReduced[c];
+  return Array.from(answer);
+}
