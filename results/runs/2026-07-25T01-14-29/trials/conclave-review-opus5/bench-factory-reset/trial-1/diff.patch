@@ -0,0 +1,209 @@
+import { describe, expect, it } from 'vitest';
+import { solveCounter } from '../src/index.js';
+
+function applyCounter(
+  buttons: number[][],
+  presses: number[],
+  modulus: number,
+  counterCount: number,
+): number[] {
+  const state = new Array<number>(counterCount).fill(0);
+  for (let b = 0; b < buttons.length; b++) {
+    for (const idx of buttons[b]) state[idx] = (state[idx] + presses[b]) % modulus;
+  }
+  return state;
+}
+
+/** Exhaustive reference solver over modulus^buttons assignments. */
+function bruteCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const m = buttons.length;
+  const press = new Array<number>(m).fill(0);
+  let best: number[] | null = null;
+  let bestCost = Infinity;
+
+  const better = (candidate: number[], cost: number): boolean => {
+    if (best === null) return true;
+    if (cost !== bestCost) return cost < bestCost;
+    for (let i = 0; i < m; i++) {
+      if (candidate[i] !== best[i]) return candidate[i] < best[i];
+    }
+    return false;
+  };
+
+  const recurse = (i: number): void => {
+    if (i === m) {
+      const state = applyCounter(buttons, press, modulus, lights.length);
+      for (let j = 0; j < lights.length; j++) if (state[j] !== lights[j]) return;
+      const cost = press.reduce((a, b) => a + b, 0);
+      if (better(press, cost)) {
+        best = press.slice();
+        bestCost = cost;
+      }
+      return;
+    }
+    for (let v = 0; v < modulus; v++) {
+      press[i] = v;
+      recurse(i + 1);
+    }
+    press[i] = 0;
+  };
+
+  recurse(0);
+  return best;
+}
+
+function mulberry(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+describe('solveCounter', () => {
+  it('solves a diagonal system', () => {
+    expect(solveCounter([1, 2, 3], [[0], [1], [2]], 5)).toEqual([1, 2, 3]);
+  });
+
+  it('returns all zeros for an all-zero target', () => {
+    expect(solveCounter([0, 0], [[0], [1]], 7)).toEqual([0, 0]);
+  });
+
+  it('wraps around the modulus', () => {
+    // Button 0 hits both counters; reaching [4,4] mod 5 costs 4 presses.
