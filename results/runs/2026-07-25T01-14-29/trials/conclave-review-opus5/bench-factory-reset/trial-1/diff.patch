+      expect(
+        solveToggleWith(machine, 'meet-in-middle'),
+        JSON.stringify(machine),
+      ).toEqual(solveToggleWith(machine, 'null-space'));
+    }
+  });
+
+  it('solves 40 buttons and 40 lights quickly', () => {
+    const rand = mulberry(777);
+    const lights = 40;
+    const buttons: number[][] = [];
+    for (let b = 0; b < 40; b++) {
