+  });
+
+  it('prefers the fewest presses over an easier-looking set', () => {
+    // Button 3 alone matches; pressing 0,1,2 also matches but costs more.
+    const machine: Machine = {
+      target: [true, true, true],
+      buttons: [[0], [1], [2], [0, 1, 2]],
