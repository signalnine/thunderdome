  const row: UserRow = {\n    id: uuidv4(),\n    email,\n    password_hash: hashPassword(input.password),\n    tenant_id: input.tenantId,\n    role: input.role ?? 'viewer',\n    created_at: new Date().toISOString(),\n  };\n\n  try {\n    getDb()\n      .prepare(\n        `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)\n         VALUES (?, ?, ?, ?, ?, ?)`\n      )\n      .run(row.id, row.email, row.password_hash, row.tenant_id, row.role, row.created_at);\n  } catch (err) {\n    // Guards against a race between the existence check and the insert.\n    if (err instanceof Error && err.message.includes('UNIQUE')) {\n      throw conflict('A user with this email already exists');\n    }\n    throw err;\n  }\n\n  return toPublicUser(row);\n}\n\n/** Return the user when the credentials match, otherwise `undefined`. */\nexport function authenticateCredentials(email: string, password: string): UserRow | undefined {\n  const row = findUserByEmail(email);\n  if (!row) {\n    return undefined;\n  }\n  return verifyPassword(password, row.password_hash) ? row : undefined;\n}\n\nexport function updateUserRole(id: string, tenantId: string, role: Role): PublicUser {\n  const existing = requireUserInTenant(id, tenantId);\n  getDb().prepare('UPDATE users SET role = ? WHERE id = ?').run(role, existing.id);\n  return toPublicUser({ ...existing, role });\n}\n","structuredPatch":[{"oldStart":39,"oldLines":7,"newStart":39,"newLines":16,"lines":["   return email.trim().toLowerCase();"," }"," ","-export function findUserByEmail(email: string): UserRow | undefined {","+/**","+ * Look up a user by email address, which is deliberately NOT tenant-scoped:","+ * `schema.sql` declares `users.email UNIQUE` globally and `POST /users/login`","+ * carries no tenant, so an address must identify exactly one user across the","+ * whole system. The consequence is that two tenants cannot share an email","+ * address — registering a duplicate returns 409 regardless of `tenant_id`.","