new file mode 100644
index 0000000..9ded186
--- /dev/null
+++ b/src/export/csv.ts
@@ -0,0 +1,47 @@
+/** Characters that make a spreadsheet treat a leading cell value as a formula. */
+const FORMULA_PREFIX = /^[=+@\t\r]/;
+
+/**
+ * Neutralize spreadsheet formula injection.
+ *
+ * Event names and property values are attacker-controlled via ingestion, and a
+ * cell starting with `=`, `+`, `@` or a control character is executed when the
+ * export is opened in Excel or Sheets. A leading apostrophe forces the cell to
+ * be read as text. A leading `-` is only treated as dangerous when the value is
+ * not a plain number, so negative numbers still export unchanged.
+ */
+function neutralizeFormula(text: string): string {
+  if (FORMULA_PREFIX.test(text)) {
+    return `'${text}`;
+  }
+  if (text.startsWith('-') && !Number.isFinite(Number(text))) {
+    return `'${text}`;
+  }
+  return text;
+}
+
+/** Escape a single CSV field per RFC 4180. */
+function escapeField(value: unknown): string {
+  if (value === null || value === undefined) {
+    return '';
+  }
+  const text = neutralizeFormula(typeof value === 'string' ? value : String(value));
+  if (/[",\r\n]/.test(text)) {
+    return `"${text.replace(/"/g, '""')}"`;
+  }
+  return text;
+}
+
+/**
+ * Render rows as CSV with a leading header line.
+ *
+ * The result has no trailing newline, so `split('\n').length` equals
+ * `rows.length + 1`.
+ */
+export function toCsv<T>(rows: readonly T[], columns: readonly (keyof T & string)[]): string {
+  const lines = [columns.map(escapeField).join(',')];
+  for (const row of rows) {
+    lines.push(columns.map((column) => escapeField(row[column])).join(','));
+  }
+  return lines.join('\n');
+}
