TimeseriesPoint {\n  bucket: string;\n  count: number;\n}\n\nexport function timeseries(filter: EventFilter, bucket: Bucket): TimeseriesPoint[] {\n  const where = buildWhere(filter);\n  const expr = BUCKET_EXPR[bucket];\n  return getDb()\n    .prepare(\n      `SELECT ${expr} AS bucket, COUNT(*) AS count\n       FROM events\n       WHERE ${where.sql}\n       GROUP BY bucket\n       ORDER BY bucket ASC`\n    )\n    .all(...where.params) as TimeseriesPoint[];\n}\n\nexport interface BreakdownEntry {\n  property_value: string | number | null;\n  count: number;\n}\n\nexport function breakdown(\n  filter: EventFilter,\n  propertyKey: string,\n  limit: number\n): BreakdownEntry[] {\n  const where = buildWhere(filter);\n  const path = propertyPath(propertyKey);\n  return getDb()\n    .prepare(\n      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count\n       FROM events\n       WHERE ${where.sql} AND json_extract(properties, ?) IS NOT NULL\n       GROUP BY property_value\n       ORDER BY count DESC, property_value ASC\n       LIMIT ?`\n    )\n    .all(path, ...where.params, path, limit) as BreakdownEntry[];\n}\n\nexport interface FunnelStep {\n  step: number;\n  name: string;\n  count: number;\n  conversion_rate: number;\n}\n\ninterface FunnelEventRow {\n  name: string;\n  session_id: string | null;\n  user_id: string | null;\n  rowid: number;\n}\n\n/**\n * Ordered funnel analysis.\n *\n * Events are grouped into \"actors\" (session first, falling back to user) and\n * each actor's timeline is walked once: a step only counts if it happens at or\n * after the event that satisfied the previous step. Ties on timestamp — common\n * when a batch is ingested in one call — fall back to insertion order, so an\n * actor is never credited with completing a step out of sequence.\n */\nexport function funnel(filter: EventFilter, steps: string[]): FunnelStep[] {\n  const where = buildWhere({ ...filter, eventNames: steps });\n  const rows = getDb()\n    .prepare(\n  