+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CbZiLVo72btYEmhr68e7nk","type":"tool_result","content":"1\timport type { NextFunction, Request, Response } from 'express';\n2\timport { forbidden, unauthorized } from '../errors';\n3\timport { verifyToken } from './jwt';\n4\timport type { AuthUser, Role } from './types';\n5\timport './types';\n6\t\n7\t/**\n8\t * Read the authenticated principal from a request.\n9\t *\n10\t * Routers depend on this rather than on the authentication middleware directly,\n11\t * so they can be mounted behind any auth implementation.\n12\t */\n13\texport function getAuthUser(req: Request): AuthUser {\n14\t  const user = req.user;\n15\t  if (!user || typeof user.id !== 'string' || typeof user.tenantId !== 'string') {\n16\t    throw unauthorized();\n17\t  }\n18\t  return user;\n19\t}\n20\t\n21\t/** Verify the `Authorization: Bearer <token>` header and attach `req.user`. */\n22\texport function authenticate(req: Request, _res: Response, next: NextFunction): void {\n23\t  const header = req.get('authorization');\n24\t  if (!header) {\n25\t    next(unauthorized('Missing Authorization header'));\n26\t    return;\n27\t  }\n28\t\n29\t  const [scheme, token] = header.split(' ');\n30\t  if (!token || scheme.toLowerCase() !== 'bearer') {\n31\t    next(unauthorized('Authorization header must use the Bearer scheme'));\n32\t    return;\n33\t  }\n34\t\n35\t  try {\n36\t    const claims = verifyToken(token.trim());\n37\t    req.user = { id: claims.sub, tenantId: claims.tid, role: claims.role };\n38\t    next();\n39\t  } catch (err) {\n40\t    next(err);\n41\t  }\n42\t}\n43\t\n44\t/** Assert that a resolved role is among the allowed set. */\n45\texport function assertRole(role: Role | undefined, allowed: readonly Role[]): void {\n46\t  if (!role || !allowed.includes(role)) {\n47\t    throw forbidden(`Requires one of the following roles: ${allowed.join(', ')}`);\n48\t  }\n49\t}\n50\t"}]},"parent_tool_use_id":"toolu_019864zbiEaR3r