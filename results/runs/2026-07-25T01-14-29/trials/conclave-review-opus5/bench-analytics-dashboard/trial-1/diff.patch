+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HfZ24yra8EKXiAAVT4uinJ","type":"tool_result","content":"1\timport { Router } from 'express';\n2\timport { getAuthUser } from '../auth/middleware';\n3\timport { asObject, optionalEnum, optionalNumericString, optionalString, optionalTimestamp } from '../validate';\n4\timport { toCsv } from './csv';\n5\timport {\n6\t  EVENT_COLUMNS,\n7\t  EXPORT_FORMATS,\n8\t  exportDashboard,\n9\t  selectEvents,\n10\t  toExportJson,\n11\t} from './service';\n12\t\n13\tconst DEFAULT_LIMIT = 10000;\n14\tconst MAX_LIMIT = 100000;\n15\t\n16\tconst router = Router();\n17\t\n18\t/** GET /export/events?format=csv|json — export the tenant's raw events. */\n19\trouter.get('/events', (req, res) => {\n20\t  const auth = getAuthUser(req);\n21\t  const query = asObject(req.query, 'query');\n22\t\n23\t  const format = optionalEnum(query, 'format', EXPORT_FORMATS) ?? 'json';\n24\t  const rows = selectEvents(\n25\t    {\n26\t      tenantId: auth.tenantId,\n27\t      eventName: optionalString(query, 'event_name'),\n28\t      start: optionalTimestamp(query, 'start'),\n29\t      end: optionalTimestamp(query, 'end'),\n30\t    },\n31\t    optionalNumericString(query, 'limit', DEFAULT_LIMIT, 1, MAX_LIMIT)\n32\t  );\n33\t\n34\t  if (format === 'csv') {\n35\t    res.status(200);\n36\t    res.type('text/csv');\n37\t    res.setHeader('Content-Disposition', 'attachment; filename=\"events.csv\"');\n38\t    res.send(toCsv(rows as unknown as Record<string, unknown>[], EVENT_COLUMNS));\n39\t    return;\n40\t  }\n41\t\n42\t  res.status(200).json(toExportJson(rows));\n43\t});\n44\t\n45\t/** GET /export/dashboard/:id — export a dashboard with its widgets. */\n46\trouter.get('/dashboard/:id', (req, res) => {\n47\t  const auth = getAuthUser(req);\n48\t  res.status(200).json(exportDashboard(req.params.id, auth.tenantId));\n49\t});\n50\t\n51\texport default router;\n52\t"}]},"parent_tool_use_id":"toolu_019864zbiEaR3ri7grkkNEMh","session_id":"cf228