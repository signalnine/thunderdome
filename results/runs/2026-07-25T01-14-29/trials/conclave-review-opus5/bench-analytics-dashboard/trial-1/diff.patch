+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WD4asVGKv3FmtoVocxJDiF","type":"tool_result","content":"1\timport { v4 as uuidv4 } from 'uuid';\n2\timport { getDb } from '../db';\n3\timport { badRequest } from '../errors';\n4\timport { asObject, optionalObject, optionalString, optionalTimestamp, requireString } from '../validate';\n5\t\n6\texport const MAX_BATCH_SIZE = 1000;\n7\t\n8\texport interface EventRow {\n9\t  id: string;\n10\t  tenant_id: string;\n11\t  name: string;\n12\t  properties: string;\n13\t  timestamp: string;\n14\t  user_id: string | null;\n15\t  session_id: string | null;\n16\t}\n17\t\n18\texport interface EventPayload {\n19\t  id: string;\n20\t  tenant_id: string;\n21\t  name: string;\n22\t  properties: Record<string, unknown>;\n23\t  timestamp: string;\n24\t  user_id: string | null;\n25\t  session_id: string | null;\n26\t}\n27\t\n28\texport interface IngestContext {\n29\t  tenantId: string;\n30\t  userId: string;\n31\t}\n32\t\n33\t/**\n34\t * Validate a single raw event and stamp it with tenant/identity/time defaults.\n35\t * Validation happens for the whole batch before anything is written.\n36\t */\n37\texport function buildEvent(raw: unknown, ctx: IngestContext, label = 'event'): EventRow {\n38\t  const body = asObject(raw, label);\n39\t  const properties = optionalObject(body, 'properties') ?? {};\n40\t\n41\t  return {\n42\t    id: uuidv4(),\n43\t    tenant_id: ctx.tenantId,\n44\t    name: requireString(body, 'name'),\n45\t    properties: JSON.stringify(properties),\n46\t    timestamp: optionalTimestamp(body, 'timestamp') ?? new Date().toISOString(),\n47\t    user_id: optionalString(body, 'user_id') ?? ctx.userId,\n48\t    session_id: optionalString(body, 'session_id') ?? null,\n49\t  };\n50\t}\n51\t\n52\texport function toEventPayload(row: EventRow): EventPayload {\n53\t  return {\n54\t    id: row.id,\n55\t    tenant_id: row.tenant_id,\n56\t    name: row.name,\n57\t    properties: JSON.parse(row.properties) as Record<string, unknown>,\n58\t    timestamp: row.timestamp,\n59\t    user_id: row.user_id,\n60\t    session_id: row.session_id,\n61\t  };\n62\t}\n63\t\n64\t/** Insert events atomically — either every event lands or none do. */\n65\texport function insertEvents(rows: EventRow[]): EventPayload[] {\n66\t  const db = getDb();\n67\t  const stmt = db.prepare(\n68\t    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)\n69\t     VALUES (?, ?, ?, ?, ?, ?, ?)`\n70\t  );\n71\t\n72\t  const insertAll = db.transaction((items: EventRow[]) => {\n73\t    for (const row of items) {\n74\t      stmt.run(\n75\t        row.id,\n76\t        row.tenant_id,\n77\t        row.name,\n78\t        row.properties,\n79\t        row.timestamp,\n80\t        row.user_id,\n81\t        row.session_id\n82\t      );\n83\t    }\n84\t  });\n85\t\n86\t  insertAll(rows);\n87\t  return rows.map(toEventPayload);\n88\t}\n89\t\n90\texport function parseBatch(raw: unknown, ctx: IngestContext): EventRow[] {\n91\t  const body = asObject(raw);\n92\t  const events = body.events;\n93\t  if (!Array.isArray(events)) {\n94\t    throw badRequest('events is required and must be an array');\n95\t  }\n96\t  if (events.length === 0) {\n97\t    throw badRequest('events must contain at least one event');\n98\t  }\n99\t  if (events.length > MAX_BATCH_SIZE) {\n100\t    throw badRequest(`events may contain at most ${MAX_BATCH_SIZE} events`);\n101\t  }\n102\t  return events.map((event, index) => buildEvent(event, ctx, `events[${index}]`));\n103\t}\n104\t"}]},"parent_tool_use_id":"toolu_019864zbiEaR3ri7grkkNEMh","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"9184abe6-dca3-4c11-91d3-03b9e422c466","timestamp":"2026-07-25T01:40:49.216Z","subagent_type":"conclave:code-reviewer","task_description":"Review correctness and edge cases"}
