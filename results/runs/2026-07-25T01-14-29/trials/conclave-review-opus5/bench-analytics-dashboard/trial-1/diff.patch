@@ -0,0 +1,51 @@
+import jwt from 'jsonwebtoken';
+import { unauthorized } from '../errors';
+import { ROLES, type Role } from './types';
+
+const DEFAULT_SECRET = 'dev-secret-change-me';
+const DEFAULT_EXPIRY = '24h';
+
+function secret(): string {
+  return process.env.JWT_SECRET ?? DEFAULT_SECRET;
+}
+
+export interface TokenClaims {
+  sub: string;
+  tid: string;
+  role: Role;
+}
+
+/** Issue a signed JWT of shape `{ sub, tid, role, iat, exp }`. */
+export function signToken(claims: TokenClaims): string {
+  return jwt.sign({ sub: claims.sub, tid: claims.tid, role: claims.role }, secret(), {
+    expiresIn: process.env.JWT_EXPIRES_IN ?? DEFAULT_EXPIRY,
+  } as jwt.SignOptions);
+}
+
+/** Verify a JWT, throwing a 401 ApiError when it is missing, invalid or expired. */
+export function verifyToken(token: string): TokenClaims {
+  let decoded: unknown;
+  try {
+    decoded = jwt.verify(token, secret());
+  } catch {
+    throw unauthorized('Invalid or expired token');
+  }
+
+  if (typeof decoded !== 'object' || decoded === null) {
+    throw unauthorized('Invalid token payload');
+  }
+
+  const payload = decoded as Record<string, unknown>;
+  const sub = payload.sub;
+  const tid = payload.tid;
+  if (typeof sub !== 'string' || typeof tid !== 'string') {
+    throw unauthorized('Invalid token payload');
+  }
+
+  const role =
+    typeof payload.role === 'string' && (ROLES as readonly string[]).includes(payload.role)
+      ? (payload.role as Role)
+      : 'viewer';
+
+  return { sub, tid, role };
+}
