+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012zy7zt4NwgDTAMAua68BEJ","type":"tool_result","content":"1\timport { Router } from 'express';\n2\timport { signToken } from '../auth/jwt';\n3\timport { assertRole, getAuthUser } from '../auth/middleware';\n4\timport { ROLES, type Role } from '../auth/types';\n5\timport { notFound, unauthorized } from '../errors';\n6\timport { asObject, requireEnum, requireString } from '../validate';\n7\timport {\n8\t  authenticateCredentials,\n9\t  createUser,\n10\t  findUserById,\n11\t  toPublicUser,\n12\t  updateUserRole,\n13\t} from './service';\n14\t\n15\tconst router = Router();\n16\t\n17\t/** POST /users — register a new user. */\n18\trouter.post('/', (req, res) => {\n19\t  const body = asObject(req.body);\n20\t  const user = createUser({\n21\t    email: requireString(body, 'email'),\n22\t    password: requireString(body, 'password'),\n23\t    tenantId: requireString(body, 'tenant_id'),\n24\t  });\n25\t  res.status(201).json(user);\n26\t});\n27\t\n28\t/** POST /users/login — exchange credentials for a JWT. */\n29\trouter.post('/login', (req, res) => {\n30\t  const body = asObject(req.body);\n31\t  const email = requireString(body, 'email');\n32\t  const password = requireString(body, 'password');\n33\t\n34\t  const user = authenticateCredentials(email, password);\n35\t  if (!user) {\n36\t    throw unauthorized('Invalid email or password');\n37\t  }\n38\t\n39\t  const token = signToken({ sub: user.id, tid: user.tenant_id, role: user.role });\n40\t  res.status(200).json({ token, user: toPublicUser(user) });\n41\t});\n42\t\n43\t/** GET /users/me — the authenticated user's profile. */\n44\trouter.get('/me', (req, res) => {\n45\t  const auth = getAuthUser(req);\n46\t  const user = findUserById(auth.id);\n47\t  if (!user || user.tenant_id !== auth.tenantId) {\n48\t    throw notFound('User not found');\n49\t  }\n50\t  res.status(200).json(toPublicUser(user));\n51\t});\n52\t\n53\t/** PATCH /users/:id/role — admin-only role change within the same tenant. */\n54\trouter.patch('/:id/role', (req, res) => {\n55\t  const auth = getAuthUser(req);\n56\t  const body = asObject(req.body);\n57\t  const role: Role = requireEnum(body, 'role', ROLES);\n58\t\n59\t  // Resolve the actor's role from storage rather than trusting the token, so a\n60\t  // revoked admin cannot keep escalating with a still-valid JWT.\n61\t  const actor = findUserById(auth.id);\n62\t  if (!actor || actor.tenant_id !== auth.tenantId) {\n63\t    throw unauthorized('Authenticated user no longer exists');\n64\t  }\n65\t  assertRole(actor.role, ['admin']);\n66\t\n67\t  res.status(200).json(updateUserRole(req.params.id, auth.tenantId, role));\n68\t});\n69\t\n70\texport default router;\n71\t"}]},"parent_tool_use_id":"toolu_019864zbiEaR3ri7grkkNEMh","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"23e91918-4917-464a-b2bb-afe9e6c5f14e","timestamp":"2026-07-25T01:40:45.389Z","subagent_type":"conclave:code-reviewer","task_description":"Review correctness and edge cases"}
