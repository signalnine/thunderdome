+++ b/src/export/router.ts
@@ -0,0 +1,51 @@
+import { Router } from 'express';
+import { getAuthUser } from '../auth/middleware';
+import { asObject, optionalEnum, optionalNumericString, optionalString, optionalTimestamp } from '../validate';
+import { toCsv } from './csv';
+import {
+  EVENT_COLUMNS,
+  EXPORT_FORMATS,
+  exportDashboard,
+  selectEvents,
+  toExportJson,
+} from './service';
+
+const DEFAULT_LIMIT = 10000;
+const MAX_LIMIT = 100000;
+
+const router = Router();
+
+/** GET /export/events?format=csv|json — export the tenant's raw events. */
+router.get('/events', (req, res) => {
+  const auth = getAuthUser(req);
+  const query = asObject(req.query, 'query');
+
+  const format = optionalEnum(query, 'format', EXPORT_FORMATS) ?? 'json';
+  const rows = selectEvents(
+    {
+      tenantId: auth.tenantId,
+      eventName: optionalString(query, 'event_name'),
+      start: optionalTimestamp(query, 'start'),
+      end: optionalTimestamp(query, 'end'),
+    },
+    optionalNumericString(query, 'limit', DEFAULT_LIMIT, 1, MAX_LIMIT)
+  );
+
+  if (format === 'csv') {
+    res.status(200);
+    res.type('text/csv');
+    res.setHeader('Content-Disposition', 'attachment; filename="events.csv"');
+    res.send(toCsv(rows, EVENT_COLUMNS));
+    return;
+  }
+
+  res.status(200).json(toExportJson(rows));
+});
+
+/** GET /export/dashboard/:id — export a dashboard with its widgets. */
+router.get('/dashboard/:id', (req, res) => {
+  const auth = getAuthUser(req);
+  res.status(200).json(exportDashboard(req.params.id, auth.tenantId));
+});
+
+export default router;
diff --git a/src/export/service.ts b/src/export/service.ts
new file mode 100644
index 0000000..de178b2
--- /dev/null
+++ b/src/export/service.ts
@@ -0,0 +1,62 @@
+import { getDb } from '../db';
+import {
+  listWidgets,
+  requireDashboard,
+  toDashboardPayload,
+  type DashboardPayload,
+  type WidgetPayload,
+} from '../dashboards/service';
+import type { EventRow } from '../ingest/service';
+import { buildWhere, type EventFilter } from '../query/engine';
+import { parseJsonObject } from '../validate';
+
+export const EXPORT_FORMATS = ['json', 'csv'] as const;
+
+export const EVENT_COLUMNS = [
+  'id',
+  'tenant_id',
+  'name',
+  'properties',
+  'timestamp',
+  'user_id',
+  'session_id',
+] as const;
+
+/** Fetch raw event rows for export, always scoped to a single tenant. */
+export function selectEvents(filter: EventFilter, limit: number): EventRow[] {
+  const where = buildWhere(filter);
+  return getDb()
+    .prepare(
+      `SELECT ${EVENT_COLUMNS.join(', ')} FROM events
+       WHERE ${where.sql}
+       ORDER BY strftime('%Y-%m-%dT%H:%M:%fZ', timestamp) ASC, rowid ASC
+       LIMIT ?`
+    )
+    .all(...where.params, limit) as EventRow[];
+}
+
+export interface ExportedEvent extends Omit<EventRow, 'properties'> {
+  properties: Record<string, unknown>;
+}
+
+/**
+ * JSON export expands `properties` back into an object. CSV deliberately keeps
+ * the raw JSON text in a single column instead, since a flat table has nowhere
+ * to put a nested structure.
+ */
+export function toExportJson(rows: EventRow[]): ExportedEvent[] {
+  return rows.map((row) => ({ ...row, properties: parseJsonObject(row.properties) }));
+}
+
+export interface DashboardExport {
+  dashboard: DashboardPayload;
+  widgets: WidgetPayload[];
+}
+
+export function exportDashboard(id: string, tenantId: string): DashboardExport {
+  const dashboard = requireDashboard(id, tenantId);
+  return {
+    dashboard: toDashboardPayload(dashboard),
+    widgets: listWidgets(dashboard.id),
+  };
+}
diff --git a/src/ingest/router.ts b/src/ingest/router.ts
new file mode 100644
