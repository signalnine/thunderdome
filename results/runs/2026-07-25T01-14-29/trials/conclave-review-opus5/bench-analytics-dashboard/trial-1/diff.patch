+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HxTdy3W26Ggr63Ysk8FgED","type":"tool_result","content":"1\timport { getDb } from '../db';\n2\timport { listWidgets, requireDashboard, toDashboardPayload } from '../dashboards/service';\n3\timport type { EventRow } from '../ingest/service';\n4\timport { buildWhere, type EventFilter } from '../query/engine';\n5\timport { parseJsonObject } from '../validate';\n6\t\n7\texport const EXPORT_FORMATS = ['json', 'csv'] as const;\n8\texport type ExportFormat = (typeof EXPORT_FORMATS)[number];\n9\t\n10\texport const EVENT_COLUMNS = [\n11\t  'id',\n12\t  'tenant_id',\n13\t  'name',\n14\t  'properties',\n15\t  'timestamp',\n16\t  'user_id',\n17\t  'session_id',\n18\t] as const;\n19\t\n20\t/** Fetch raw event rows for export, always scoped to a single tenant. */\n21\texport function selectEvents(filter: EventFilter, limit: number): EventRow[] {\n22\t  const where = buildWhere(filter);\n23\t  return getDb()\n24\t    .prepare(\n25\t      `SELECT ${EVENT_COLUMNS.join(', ')} FROM events\n26\t       WHERE ${where.sql}\n27\t       ORDER BY strftime('%Y-%m-%dT%H:%M:%fZ', timestamp) ASC, rowid ASC\n28\t       LIMIT ?`\n29\t    )\n30\t    .all(...where.params, limit) as EventRow[];\n31\t}\n32\t\n33\t/** JSON export expands `properties` back into an object. */\n34\texport function toExportJson(rows: EventRow[]): Record<string, unknown>[] {\n35\t  return rows.map((row) => ({ ...row, properties: parseJsonObject(row.properties) }));\n36\t}\n37\t\n38\texport interface DashboardExport {\n39\t  dashboard: Record<string, unknown>;\n40\t  widgets: Record<string, unknown>[];\n41\t}\n42\t\n43\texport function exportDashboard(id: string, tenantId: string): DashboardExport {\n44\t  const dashboard = requireDashboard(id, tenantId);\n45\t  return {\n46\t    dashboard: toDashboardPayload(dashboard) as unknown as Record<string, unknown>,\n47\t    widgets: listWidgets(dashboard.id) as unknown as Record<string, unknown>[],\n48\t  };\n49\t}\n50\t"}]},"parent_tool_use_id":"toolu_01FT7BNMgLQ2UYZCh4ntxmoa","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"2fc5107e-5f05-4279-8952-3e9f6df08001","timestamp":"2026-07-25T01:41:08.606Z","subagent_type":"general-purpose","task_description":"Review code quality and API design"}
