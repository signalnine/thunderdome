+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CtQBXmXuVCFzqMTqXJHK38","type":"tool_result","content":"1\timport jwt from 'jsonwebtoken';\n2\timport { unauthorized } from '../errors';\n3\timport { ROLES, type Role } from './types';\n4\t\n5\tconst DEFAULT_SECRET = 'dev-secret-change-me';\n6\tconst DEFAULT_EXPIRY = '24h';\n7\t\n8\tfunction secret(): string {\n9\t  return process.env.JWT_SECRET ?? DEFAULT_SECRET;\n10\t}\n11\t\n12\texport interface TokenClaims {\n13\t  sub: string;\n14\t  tid: string;\n15\t  role: Role;\n16\t}\n17\t\n18\t/** Issue a signed JWT of shape `{ sub, tid, role, iat, exp }`. */\n19\texport function signToken(claims: TokenClaims): string {\n20\t  return jwt.sign({ sub: claims.sub, tid: claims.tid, role: claims.role }, secret(), {\n21\t    expiresIn: process.env.JWT_EXPIRES_IN ?? DEFAULT_EXPIRY,\n22\t  } as jwt.SignOptions);\n23\t}\n24\t\n25\t/** Verify a JWT, throwing a 401 ApiError when it is missing, invalid or expired. */\n26\texport function verifyToken(token: string): TokenClaims {\n27\t  let decoded: unknown;\n28\t  try {\n29\t    decoded = jwt.verify(token, secret());\n30\t  } catch {\n31\t    throw unauthorized('Invalid or expired token');\n32\t  }\n33\t\n34\t  if (typeof decoded !== 'object' || decoded === null) {\n35\t    throw unauthorized('Invalid token payload');\n36\t  }\n37\t\n38\t  const payload = decoded as Record<string, unknown>;\n39\t  const sub = payload.sub;\n40\t  const tid = payload.tid;\n41\t  if (typeof sub !== 'string' || typeof tid !== 'string') {\n42\t    throw unauthorized('Invalid token payload');\n43\t  }\n44\t\n45\t  const role =\n46\t    typeof payload.role === 'string' && (ROLES as readonly string[]).includes(payload.role)\n47\t      ? (payload.role as Role)\n48\t      : 'viewer';\n49\t\n50\t  return { sub, tid, role };\n51\t}\n52\t"}]},"parent_tool_use_id":"toolu_019864zbiEaR3ri7grkkNEMh","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"c1497644-1e0e-4248-8b7d-19deb1a56f