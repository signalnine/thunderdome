@@ -0,0 +1,48 @@
+import type { NextFunction, Request, Response } from 'express';
+import { forbidden, unauthorized } from '../errors';
+import { verifyToken } from './jwt';
+import type { AuthUser, Role } from './types';
+
+/**
+ * Read the authenticated principal from a request.
+ *
+ * Routers depend on this rather than on the authentication middleware directly,
+ * so they can be mounted behind any auth implementation.
+ */
+export function getAuthUser(req: Request): AuthUser {
+  const user = req.user;
+  if (!user || typeof user.id !== 'string' || typeof user.tenantId !== 'string') {
+    throw unauthorized();
+  }
+  return user;
+}
+
+/** Verify the `Authorization: Bearer <token>` header and attach `req.user`. */
+export function authenticate(req: Request, _res: Response, next: NextFunction): void {
+  const header = req.get('authorization');
+  if (!header) {
+    next(unauthorized('Missing Authorization header'));
+    return;
+  }
+
+  const [scheme, token] = header.split(' ');
+  if (!token || scheme.toLowerCase() !== 'bearer') {
+    next(unauthorized('Authorization header must use the Bearer scheme'));
+    return;
+  }
+
+  try {
+    const claims = verifyToken(token.trim());
+    req.user = { id: claims.sub, tenantId: claims.tid, role: claims.role };
+    next();
+  } catch (err) {
+    next(err);
+  }
+}
+
+/** Assert that a resolved role is among the allowed set. */
+export function assertRole(role: Role | undefined, allowed: readonly Role[]): void {
+  if (!role || !allowed.includes(role)) {
+    throw forbidden(`Requires one of the following roles: ${allowed.join(', ')}`);
+  }
+}
