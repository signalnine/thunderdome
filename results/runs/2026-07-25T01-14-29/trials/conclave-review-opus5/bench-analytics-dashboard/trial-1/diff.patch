ord<string, unknown>;\n}\n\ninterface WhereClause {\n  sql: string;\n  params: unknown[];\n}\n\n/** Convert a JSON property key into a bound `json_extract` path. */\nexport function propertyPath(key: string): string {\n  if (!PROPERTY_KEY_PATTERN.test(key)) {\n    throw badRequest(\n      'property_key may only contain letters, digits, underscores, dots and hyphens'\n    );\n  }\n  return `$.\"${key}\"`;\n}\n\n/**\n * `json_extract` yields SQL-native types, so filter values must be coerced the\n * same way for equality to hold (JSON booleans compare as 1/0).\n */\nfunction bindableValue(value: unknown, key: string): string | number | null {\n  if (value === null) return null;\n  if (typeof value === 'string' || typeof value === 'number') return value;\n  if (typeof value === 'boolean') return value ? 1 : 0;\n  throw badRequest(`filters.${key} must be a string, number, boolean or null`);\n}\n\n/** Build the shared `WHERE` fragment used by every query endpoint. */\nexport function buildWhere(filter: EventFilter): WhereClause {\n  const clauses = ['tenant_id = ?'];\n  const params: unknown[] = [filter.tenantId];\n\n  if (filter.eventName !== undefined) {\n    clauses.push('name = ?');\n    params.push(filter.eventName);\n  }\n\n  if (filter.eventNames !== undefined) {\n    if (filter.eventNames.length === 0) {\n      // An empty name set matches nothing; avoid emitting `IN ()`.\n      clauses.push('1 = 0');\n    } else {\n      clauses.push(`name IN (${filter.eventNames.map(() => '?').join(', ')})`);\n      params.push(...filter.eventNames);\n    }\n  }\n\n  if (filter.start !== undefined) {\n    clauses.push(`${TS('timestamp')} >= ${TS('?')}`);\n    params.push(filter.start);\n  }\n\n  if (filter.end !== undefined) {\n    clauses.push(`${TS('timestamp')} <= ${TS('?')}`);\n    params.push(filter.end);\n  }\n\n  for (const [key, value] of Object.entries(filter.properties ?? {})) {\n    const path = propertyPath(key);\n    const bound = bindableValue(value, key);\n    if