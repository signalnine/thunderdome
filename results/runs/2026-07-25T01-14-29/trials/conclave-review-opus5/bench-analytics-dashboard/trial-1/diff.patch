+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tmfv3gd3hnyACZEvn3ceDC","type":"tool_result","content":"1\timport { v4 as uuidv4 } from 'uuid';\n2\timport { getDb } from '../db';\n3\timport { badRequest, conflict, notFound } from '../errors';\n4\timport { hashPassword, verifyPassword } from '../auth/password';\n5\timport type { Role } from '../auth/types';\n6\t\n7\texport interface UserRow {\n8\t  id: string;\n9\t  email: string;\n10\t  password_hash: string;\n11\t  tenant_id: string;\n12\t  role: Role;\n13\t  created_at: string;\n14\t}\n15\t\n16\texport interface PublicUser {\n17\t  id: string;\n18\t  email: string;\n19\t  tenant_id: string;\n20\t  role: Role;\n21\t  created_at: string;\n22\t}\n23\t\n24\tconst EMAIL_PATTERN = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n25\tconst MIN_PASSWORD_LENGTH = 4;\n26\t\n27\t/** Strip the password hash before a user record leaves the API. */\n28\texport function toPublicUser(row: UserRow): PublicUser {\n29\t  return {\n30\t    id: row.id,\n31\t    email: row.email,\n32\t    tenant_id: row.tenant_id,\n33\t    role: row.role,\n34\t    created_at: row.created_at,\n35\t  };\n36\t}\n37\t\n38\texport function normalizeEmail(email: string): string {\n39\t  return email.trim().toLowerCase();\n40\t}\n41\t\n42\texport function findUserByEmail(email: string): UserRow | undefined {\n43\t  return getDb()\n44\t    .prepare('SELECT * FROM users WHERE email = ?')\n45\t    .get(normalizeEmail(email)) as UserRow | undefined;\n46\t}\n47\t\n48\texport function findUserById(id: string): UserRow | undefined {\n49\t  return getDb().prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow | undefined;\n50\t}\n51\t\n52\t/** Load a user, scoped to a tenant. Throws 404 when absent or cross-tenant. */\n53\texport function requireUserInTenant(id: string, tenantId: string): UserRow {\n54\t  const row = getDb()\n55\t    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')\n56\t    .get(id, tenantId) as UserRow | undefined;\n57\t  if (!row) {\n58\t    throw notFound('User not found');\n59\t  }\n60\t  return row;\n61\t}\n62\t\n63\texport function createUser(input: {\n64\t  email: string;\n65\t  password: string;\n66\t  tenantId: string;\n67\t  role?: Role;\n68\t}): PublicUser {\n69\t  const email = normalizeEmail(input.email);\n70\t  if (!EMAIL_PATTERN.test(email)) {\n71\t    throw badRequest('email must be a valid email address');\n72\t  }\n73\t  if (input.password.length < MIN_PASSWORD_LENGTH) {\n74\t    throw badRequest(`password must be at least ${MIN_PASSWORD_LENGTH} characters`);\n75\t  }\n76\t\n77\t  if (findUserByEmail(email)) {\n78\t    throw conflict('A user with this email already exists');\n79\t  }\n80\t\n81\t  const row: UserRow = {\n82\t    id: uuidv4(),\n83\t    email,\n84\t    password_hash: hashPassword(input.password),\n85\t    tenant_id: input.tenantId,\n86\t    role: input.role ?? 'viewer',\n87\t    created_at: new Date().toISOString(),\n88\t  };\n89\t\n90\t  try {\n91\t    getDb()\n92\t      .prepare(\n93\t        `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)\n94\t         VALUES (?, ?, ?, ?, ?, ?)`\n95\t      )\n96\t      .run(row.id, row.email, row.password_hash, row.tenant_id, row.role, row.created_at);\n97\t  } catch (err) {\n98\t    // Guards against a race between the existence check and the insert.\n99\t    if (err instanceof Error && err.message.includes('UNIQUE')) {\n100\t      throw conflict('A user with this email already exists');\n101\t    }\n102\t    throw err;\n103\t  }\n104\t\n105\t  return toPublicUser(row);\n106\t}\n107\t\n108\t/** Return the user when the credentials match, otherwise `undefined`. */\n109\texport function authenticateCredentials(email: string, password: string): UserRow | undefined {\n110\t  const row = findUserByEmail(email);\n111\t  if (!row) {\n112\t    return undefined;\n113\t  }\n114\t  return verifyPassword(password, row.password_hash) ? row : undefined;\n115\t}\n116\t\n117\texport function updateUserRole(id: string, tenantId: string, role: Role): PublicUser {\n118\t  const existing = requireUserInTenant(id, tenantId);\n119\t  getDb().prepare('UPDATE users SET role = ? WHERE id = ?').run(role, existing.id);\n120\t  return toPublicUser({ ...existing, role });\n121\t}\n122\t"}]},"parent_tool_use_id":"toolu_019864zbiEaR3ri7grkkNEMh","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"8de6b3a4-907b-42a2-b679-00e26b1a7670","timestamp":"2026-07-25T01:40:44.863Z","subagent_type":"conclave:code-reviewer","task_description":"Review correctness and edge cases"}
