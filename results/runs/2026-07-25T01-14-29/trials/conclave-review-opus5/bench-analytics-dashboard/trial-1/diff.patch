+++ b/src/users/router.ts
@@ -0,0 +1,69 @@
+import { Router } from 'express';
+import { signToken } from '../auth/jwt';
+import { assertRole, getAuthUser } from '../auth/middleware';
+import { ROLES, type Role } from '../auth/types';
+import { notFound, unauthorized } from '../errors';
+import { asObject, requireEnum, requireString } from '../validate';
+import {
+  authenticateCredentials,
+  createUser,
+  findUserById,
+  requireCurrentUser,
+  toPublicUser,
+  updateUserRole,
+} from './service';
+
+const router = Router();
+
+/** POST /users — register a new user. */
+router.post('/', (req, res) => {
+  const body = asObject(req.body);
+  // `role` is intentionally not read from the request: self-registration always
+  // produces a viewer, and only an admin can promote via PATCH /users/:id/role.
+  const user = createUser({
+    email: requireString(body, 'email'),
+    password: requireString(body, 'password'),
+    tenantId: requireString(body, 'tenant_id'),
+  });
+  res.status(201).json(user);
+});
+
+/** POST /users/login — exchange credentials for a JWT. */
+router.post('/login', (req, res) => {
+  const body = asObject(req.body);
+  const email = requireString(body, 'email');
+  const password = requireString(body, 'password');
+
+  const user = authenticateCredentials(email, password);
+  if (!user) {
+    throw unauthorized('Invalid email or password');
+  }
+
+  const token = signToken({ sub: user.id, tid: user.tenant_id, role: user.role });
+  res.status(200).json({ token, user: toPublicUser(user) });
+});
+
+/** GET /users/me — the authenticated user's profile. */
+router.get('/me', (req, res) => {
+  const auth = getAuthUser(req);
+  const user = findUserById(auth.id);
+  if (!user || user.tenant_id !== auth.tenantId) {
+    throw notFound('User not found');
+  }
+  res.status(200).json(toPublicUser(user));
+});
+
+/** PATCH /users/:id/role — admin-only role change within the same tenant. */
+router.patch('/:id/role', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+  const role: Role = requireEnum(body, 'role', ROLES);
+
+  // Resolve the actor's role from storage rather than trusting the token, so a
+  // demoted admin cannot keep escalating with a still-valid JWT.
+  assertRole(requireCurrentUser(auth).role, ['admin']);
+
+  res.status(200).json(updateUserRole(req.params.id, auth.tenantId, role));
+});
+
+export default router;
diff --git a/src/users/service.ts b/src/users/service.ts
new file mode 100644
index 0000000..18bdf8c
--- /dev/null
+++ b/src/users/service.ts
@@ -0,0 +1,145 @@
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { badRequest, conflict, notFound, unauthorized } from '../errors';
+import { hashPassword, verifyPassword } from '../auth/password';
+import type { AuthUser, Role } from '../auth/types';
+
+export interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+export interface PublicUser {
+  id: string;
+  email: string;
+  tenant_id: string;
+  role: Role;
+  created_at: string;
+}
+
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const MIN_PASSWORD_LENGTH = 4;
+
+/** Strip the password hash before a user record leaves the API. */
+export function toPublicUser(row: UserRow): PublicUser {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+function normalizeEmail(email: string): string {
+  return email.trim().toLowerCase();
+}
+
+/**
+ * Look up a user by email address, which is deliberately NOT tenant-scoped:
+ * `schema.sql` declares `users.email UNIQUE` globally and `POST /users/login`
+ * carries no tenant, so an address must identify exactly one user across the
+ * whole system. The consequence is that two tenants cannot share an email
+ * address — registering a duplicate returns 409 regardless of `tenant_id`.
+ * Changing that would require a `UNIQUE(tenant_id, email)` constraint and a
+ * tenant discriminator on login.
+ */
+function findUserByEmail(email: string): UserRow | undefined {
+  return getDb()
+    .prepare('SELECT * FROM users WHERE email = ?')
+    .get(normalizeEmail(email)) as UserRow | undefined;
+}
+
+export function findUserById(id: string): UserRow | undefined {
+  return getDb().prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow | undefined;
+}
+
+/**
+ * Resolve the authenticated principal to a live user record.
+ *
+ * A token stays valid until it expires, so it can outlive the user it names.
+ * Callers that write rows referencing `users(id)` must go through this to avoid
+ * turning a stale token into a foreign-key violation.
+ */
+export function requireCurrentUser(auth: AuthUser): UserRow {
+  const row = findUserById(auth.id);
+  if (!row || row.tenant_id !== auth.tenantId) {
+    throw unauthorized('Authenticated user no longer exists');
+  }
+  return row;
+}
+
+/** Load a user, scoped to a tenant. Throws 404 when absent or cross-tenant. */
+function requireUserInTenant(id: string, tenantId: string): UserRow {
+  const row = getDb()
+    .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as UserRow | undefined;
+  if (!row) {
+    throw notFound('User not found');
+  }
+  return row;
+}
+
+export function createUser(input: {
+  email: string;
+  password: string;
+  tenantId: string;
+  role?: Role;
+}): PublicUser {
+  const email = normalizeEmail(input.email);
+  if (!EMAIL_PATTERN.test(email)) {
+    throw badRequest('email must be a valid email address');
+  }
+  if (input.password.length < MIN_PASSWORD_LENGTH) {
+    throw badRequest(`password must be at least ${MIN_PASSWORD_LENGTH} characters`);
+  }
+
+  if (findUserByEmail(email)) {
+    throw conflict('A user with this email already exists');
+  }
+
+  const row: UserRow = {
+    id: uuidv4(),
+    email,
+    password_hash: hashPassword(input.password),
+    tenant_id: input.tenantId,
+    role: input.role ?? 'viewer',
+    created_at: new Date().toISOString(),
+  };
+
+  try {
+    getDb()
+      .prepare(
+        `INSERT INTO users (id, email, password_hash, tenant_id, role, created_at)
+         VALUES (?, ?, ?, ?, ?, ?)`
+      )
+      .run(row.id, row.email, row.password_hash, row.tenant_id, row.role, row.created_at);
+  } catch (err) {
+    // Guards against a race between the existence check and the insert.
+    if (err instanceof Error && err.message.includes('UNIQUE')) {
+      throw conflict('A user with this email already exists');
+    }
+    throw err;
+  }
+
+  return toPublicUser(row);
+}
+
+/** Return the user when the credentials match, otherwise `undefined`. */
+export function authenticateCredentials(email: string, password: string): UserRow | undefined {
+  const row = findUserByEmail(email);
+  if (!row) {
+    return undefined;
+  }
+  return verifyPassword(password, row.password_hash) ? row : undefined;
+}
+
+export function updateUserRole(id: string, tenantId: string, role: Role): PublicUser {
+  const existing = requireUserInTenant(id, tenantId);
+  getDb().prepare('UPDATE users SET role = ? WHERE id = ?').run(role, existing.id);
+  return toPublicUser({ ...existing, role });
+}
