+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import { authenticate } from './auth/middleware';
+import dashboardsRouter from './dashboards/router';
+import { errorHandler, notFoundHandler } from './errors';
+import exportRouter from './export/router';
+import ingestRouter from './ingest/router';
+import queryRouter from './query/router';
+import usersRouter from './users/router';
+
+/** Routes reachable without a token: registration, login and the health probe. */
+const PUBLIC_ROUTES: ReadonlyArray<{ method: string; path: string }> = [
+  { method: 'POST', path: '/users' },
+  { method: 'POST', path: '/users/login' },
+  { method: 'GET', path: '/health' },
+];
+
+function isPublic(req: Request): boolean {
+  // Strip a trailing slash so '/users/' is treated the same as '/users'.
+  const path = req.path.length > 1 ? req.path.replace(/\/+$/, '') : req.path;
+  return PUBLIC_ROUTES.some((route) => route.method === req.method && route.path === path);
+}
+
+/** Build the full application: JSON parsing, auth, feature routers, errors. */
+export function createApp(): Express {
+  const app = express();
+
+  app.use(express.json({ limit: '5mb' }));
+
+  app.get('/health', (_req: Request, res: Response) => {
+    res.status(200).json({ status: 'ok' });
+  });
+
+  app.use((req: Request, res: Response, next: NextFunction) => {
+    if (isPublic(req)) {
+      next();
+      return;
+    }
+    authenticate(req, res, next);
+  });
+
+  app.use('/users', usersRouter);
+  app.use('/events', ingestRouter);
+  app.use('/query', queryRouter);
+  app.use('/dashboards', dashboardsRouter);
+  app.use('/export', exportRouter);
+
+  app.use(notFoundHandler);
+  app.use(errorHandler);
+
+  return app;
+}
