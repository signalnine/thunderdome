s DashboardRow | undefined;\n57\t}\n58\t\n59\t/**\n60\t * Load a dashboard within the caller's tenant. Cross-tenant access is reported\n61\t * as 404 rather than 403 so that IDs from other tenants stay unguessable.\n62\t */\n63\texport function requireDashboard(id: string, tenantId: string): DashboardRow {\n64\t  const row = findDashboard(id, tenantId);\n65\t  if (!row) {\n66\t    throw notFound('Dashboard not found');\n67\t  }\n68\t  return row;\n69\t}\n70\t\n71\texport function listWidgets(dashboardId: string): WidgetPayload[] {\n72\t  const rows = getDb()\n73\t    .prepare(\n74\t      `SELECT * FROM widgets WHERE dashboard_id = ?\n75\t       ORDER BY position_y ASC, position_x ASC, id ASC`\n76\t    )\n77\t    .all(dashboardId) as WidgetRow[];\n78\t  return rows.map(toWidgetPayload);\n79\t}\n80\t\n81\texport function createDashboard(input: {\n82\t  tenantId: string;\n83\t  ownerId: string;\n84\t  name: string;\n85\t  config: Record<string, unknown>;\n86\t}): DashboardPayload {\n87\t  const now = new Date().toISOString();\n88\t  const row: DashboardRow = {\n89\t    id: uuidv4(),\n90\t    tenant_id: input.tenantId,\n91\t    name: input.name,\n92\t    owner_id: input.ownerId,\n93\t    config: JSON.stringify(input.config),\n94\t    created_at: now,\n95\t    updated_at: now,\n96\t  };\n97\t\n98\t  getDb()\n99\t    .prepare(\n100\t      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)\n101\t       VALUES (?, ?, ?, ?, ?, ?, ?)`\n102\t    )\n103\t    .run(\n104\t      row.id,\n105\t      row.tenant_id,\n106\t      row.name,\n107\t      row.owner_id,\n108\t      row.config,\n109\t      row.created_at,\n110\t      row.updated_at\n111\t    );\n112\t\n113\t  return toDashboardPayload(row);\n114\t}\n115\t\n116\texport function updateDashboard(\n117\t  id: string,\n118\t  tenantId: string,\n119\t  patch: { name?: string; config?: Record<string, unknown> }\n120\t): DashboardPayload {\n121\t  const existing = requireDashboard(id, tenantId);\n122\t  const updated: DashboardRow = {\n123\t    ...existing,\n124\t    name: patch.name ?? existing.name,\n125\t    config: patch.config === undefined ? existing.config : JSON.stringify(patch.config),\n126\t    updated_at: new Date().toISOString(),\n127\t  };\n128\t\n129\t  getDb()\n130\t    .prepare('UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?')\n131\t    .run(updated.name, updated.config, updated.updated_at, updated.id);\n132\t\n133\t  return toDashboardPayload(updated);\n134\t}\n135\t\n136\texport function deleteDashboard(id: string, tenantId: string): void {\n137\t  const existing = requireDashboard(id, tenantId);\n138\t  const db = getDb();\n139\t  // Widgets cascade via the foreign key, but deleting them explicitly keeps the\n140\t  // behaviour correct even if `PRAGMA foreign_keys` is off on a connection.\n141\t  db.transaction(() => {\n142\t    db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(existing.id);\n143\t    db.prepare('DELETE FROM dashboards WHERE id = ?').run(existing.id);\n144\t  })();\n145\t}\n146\t\n147\texport function createWidget(\n148\t  dashboardId: string,\n149\t  input: {\n150\t    type: WidgetType;\n151\t    config: Record<string, unknown>;\n152\t    position_x: number;\n153\t    position_y: number;\n154\t    width: number;\n155\t    height: number;\n156\t  }\n157\t): WidgetPayload {\n158\t  const row: WidgetRow = {\n159\t    id: uuidv4(),\n160\t    dashboard_id: dashboardId,\n161\t    type: input.type,\n162\t    config: JSON.stringify(input.config),\n163\t    position_x: input.position_x,\n164\t    position_y: input.position_y,\n165\t    width: input.width,\n166\t    height: input.height,\n167\t  };\n168\t\n169\t  getDb()\n170\t    .prepare(\n171\t      `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)\n172\t       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`\n173\t    )\n174\t    .run(\n175\t      row.id,\n176\t      row.dashboard_id,\n177\t      row.type,\n178\t 