+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gx4f95njpDeKiLTbiLyXbD","type":"tool_result","content":"1\timport { v4 as uuidv4 } from 'uuid';\n2\timport { getDb } from '../db';\n3\timport { notFound } from '../errors';\n4\timport { parseJsonObject } from '../validate';\n5\t\n6\texport const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'] as const;\n7\texport type WidgetType = (typeof WIDGET_TYPES)[number];\n8\t\n9\texport interface DashboardRow {\n10\t  id: string;\n11\t  tenant_id: string;\n12\t  name: string;\n13\t  owner_id: string;\n14\t  config: string;\n15\t  created_at: string;\n16\t  updated_at: string;\n17\t}\n18\t\n19\texport interface WidgetRow {\n20\t  id: string;\n21\t  dashboard_id: string;\n22\t  type: WidgetType;\n23\t  config: string;\n24\t  position_x: number;\n25\t  position_y: number;\n26\t  width: number;\n27\t  height: number;\n28\t}\n29\t\n30\texport interface DashboardPayload extends Omit<DashboardRow, 'config'> {\n31\t  config: Record<string, unknown>;\n32\t}\n33\t\n34\texport interface WidgetPayload extends Omit<WidgetRow, 'config'> {\n35\t  config: Record<string, unknown>;\n36\t}\n37\t\n38\texport function toDashboardPayload(row: DashboardRow): DashboardPayload {\n39\t  return { ...row, config: parseJsonObject(row.config) };\n40\t}\n41\t\n42\texport function toWidgetPayload(row: WidgetRow): WidgetPayload {\n43\t  return { ...row, config: parseJsonObject(row.config) };\n44\t}\n45\t\n46\texport function listDashboards(tenantId: string): DashboardPayload[] {\n47\t  const rows = getDb()\n48\t    .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC, id ASC')\n49\t    .all(tenantId) as DashboardRow[];\n50\t  return rows.map(toDashboardPayload);\n51\t}\n52\t\n53\texport function findDashboard(id: string, tenantId: string): DashboardRow | undefined {\n54\t  return getDb()\n55\t    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')\n56\t    .get(id, tenantId) as DashboardRow | undefined;\n57\t}\n58\t\n59\t/**\n60\t * Load a dashboard within the caller's tenant. Cross-tenant access is reported\n61\t * as 404 rather than 403 so that IDs from other tenants stay unguessable.\n62\t */\n63\texport function requireDashboard(id: string, tenantId: string): DashboardRow {\n64\t  const row = findDashboard(id, tenantId);\n65\t  if (!row) {\n66\t    throw notFound('Dashboard not found');\n67\t  }\n68\t  return row;\n69\t}\n70\t\n71\texport function listWidgets(dashboardId: string): WidgetPayload[] {\n72\t  const rows = getDb()\n73\t    .prepare(\n74\t      `SELECT * FROM widgets WHERE dashboard_id = ?\n75\t       ORDER BY position_y ASC, position_x ASC, id ASC`\n76\t    )\n77\t    .all(dashboardId) as WidgetRow[];\n78\t  return rows.map(toWidgetPayload);\n79\t}\n80\t\n81\texport function createDashboard(input: {\n82\t  tenantId: string;\n83\t  ownerId: string;\n84\t  name: string;\n85\t  config: Record<string, unknown>;\n86\t}): DashboardPayload {\n87\t  const now = new Date().toISOString();\n88\t  const row: DashboardRow = {\n89\t    id: uuidv4(),\n90\t    tenant_id: input.tenantId,\n91\t    name: input.name,\n92\t    owner_id: input.ownerId,\n93\t    config: JSON.stringify(input.config),\n94\t    created_at: now,\n95\t    updated_at: now,\n96\t  };\n97\t\n98\t  getDb()\n99\t    .prepare(\n100\t      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)\n101\t       VALUES (?, ?, ?, ?, ?, ?, ?)`\n102\t    )\n103\t    .run(\n104\t      row.id,\n105\t      row.tenant_id,\n106\t      row.name,\n107\t      row.owner_id,\n108\t      row.config,\n109\t      row.created_at,\n110\t      row.updated_at\n111\t    );\n112\t\n113\t  return toDashboardPayload(row);\n114\t}\n115\t\n116\texport function updateDashboard(\n117\t  id: string,\n118\t  tenantId: string,\n119\t  patch: { name?: string; config?: Record<string, unknown> }\n120\t): DashboardPayload {\n121\t  const existing = requireDashboard(id, tenantId);\n122\t  const updated: DashboardRow = {\n123\t    ...existing,\n124\t    name: patch.name ?? existing.name,\n125\t    config: patch.config === undefined ? existing.config : JSON.stringify(patch.config),\n126\t    updated_at: new Date().toISOString(),\n127\t  };\n128\t\n129\t  getDb()\n130\t    .prepare('UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?')\n131\t    .run(updated.name, updated.config, updated.updated_at, updated.id);\n132\t\n133\t  return toDashboardPayload(updated);\n134\t}\n135\t\n136\texport function deleteDashboard(id: string, tenantId: string): void {\n137\t  const existing = requireDashboard(id, tenantId);\n138\t  const db = getDb();\n139\t  // Widgets cascade via the foreign key, but deleting them explicitly keeps the\n140\t  // behaviour correct even if `PRAGMA foreign_keys` is off on a connection.\n141\t  db.transaction(() => {\n142\t    db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(existing.id);\n143\t    db.prepare('DELETE FROM dashboards WHERE id = ?').run(existing.id);\n144\t  })();\n145\t}\n146\t\n147\texport function createWidget(\n148\t  dashboardId: string,\n149\t  input: {\n150\t    type: WidgetType;\n151\t    config: Record<string, unknown>;\n152\t    position_x: number;\n153\t    position_y: number;\n154\t    width: number;\n155\t    height: number;\n156\t  }\n157\t): WidgetPayload {\n158\t  const row: WidgetRow = {\n159\t    id: uuidv4(),\n160\t    dashboard_id: dashboardId,\n161\t    type: input.type,\n162\t    config: JSON.stringify(input.config),\n163\t    position_x: input.position_x,\n164\t    position_y: input.position_y,\n165\t    width: input.width,\n166\t    height: input.height,\n167\t  };\n168\t\n169\t  getDb()\n170\t    .prepare(\n171\t      `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)\n172\t       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`\n173\t    )\n174\t    .run(\n175\t      row.id,\n176\t      row.dashboard_id,\n177\t      row.type,\n178\t      row.config,\n179\t      row.position_x,\n180\t      row.position_y,\n181\t      row.width,\n182\t      row.height\n183\t    );\n184\t\n185\t  return toWidgetPayload(row);\n186\t}\n187\t\n188\texport function requireWidget(dashboardId: string, widgetId: string): WidgetRow {\n189\t  const row = getDb()\n190\t    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')\n191\t    .get(widgetId, dashboardId) as WidgetRow | undefined;\n192\t  if (!row) {\n193\t    throw notFound('Widget not found');\n194\t  }\n195\t  return row;\n196\t}\n197\t\n198\texport function updateWidget(\n199\t  dashboardId: string,\n200\t  widgetId: string,\n201\t  patch: {\n202\t    type?: WidgetType;\n203\t    config?: Record<string, unknown>;\n204\t    position_x?: number;\n205\t    position_y?: number;\n206\t    width?: number;\n207\t    height?: number;\n208\t  }\n209\t): WidgetPayload {\n210\t  const existing = requireWidget(dashboardId, widgetId);\n211\t  const updated: WidgetRow = {\n212\t    ...existing,\n213\t    type: patch.type ?? existing.type,\n214\t    config: patch.config === undefined ? existing.config : JSON.stringify(patch.config),\n215\t    position_x: patch.position_x ?? existing.position_x,\n216\t    position_y: patch.position_y ?? existing.position_y,\n217\t    width: patch.width ?? existing.width,\n218\t    height: patch.height ?? existing.height,\n219\t  };\n220\t\n221\t  getDb()\n222\t    .prepare(\n223\t      `UPDATE widgets\n224\t       SET type = ?, config = ?, position_x = ?, position_y = ?, width = ?, height = ?\n225\t       WHERE id = ?`\n226\t    )\n227\t    .run(\n228\t      updated.type,\n229\t      updated.config,\n230\t      updated.position_x,\n231\t      updated.position_y,\n232\t      updated.width,\n233\t      updated.height,\n234\t      updated.id\n235\t    );\n236\t\n237\t  return toWidgetPayload(updated);\n238\t}\n239\t\n240\texport function deleteWidget(dashboardId: string, widgetId: string): void {\n241\t  const existing = requireWidget(dashboardId, widgetId);\n242\t  getDb().prepare('DELETE FROM widgets WHERE id = ?').run(existing.id);\n243\t}\n244\t"}]},"parent_tool_use_id":"toolu_01FT7BNMgLQ2UYZCh4ntxmoa","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"a21feb3b-880a-40ac-925e-e5217dd86e52","timestamp":"2026-07-25T01:41:04.337Z","subagent_type":"general-purpose","task_description":"Review code quality and API design"}
