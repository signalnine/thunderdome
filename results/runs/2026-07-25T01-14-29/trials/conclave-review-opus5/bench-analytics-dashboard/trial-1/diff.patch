ice@test.com', password: 'secret123' });\n\n    expect(loginRes.status).toBe(200);\n    expect(loginRes.body).toHaveProperty('token');\n    expect(loginRes.body.user.email).toBe('alice@test.com');\n  });\n\n  it('should return JWT with correct shape {sub, tid, iat, exp}', async () => {\n    await request(app)\n      .post('/users')\n      .send({ email: 'jwt@test.com', password: 'secret123', tenant_id: TENANT_A });\n\n    const loginRes = await request(app)\n      .post('/users/login')\n      .send({ email: 'jwt@test.com', password: 'secret123' });\n\n    const token = loginRes.body.token;\n    const decoded = jwt.decode(token) as Record<string, unknown>;\n\n    expect(decoded).toHaveProperty('sub');\n    expect(decoded).toHaveProperty('tid');\n    expect(decoded).toHaveProperty('iat');\n    expect(decoded).toHaveProperty('exp');\n    expect(decoded.tid).toBe(TENANT_A);\n  });\n\n  // --- Auth Error Format Consistency (2 tests) ---\n\n  it('should return consistent error format for missing auth', async () => {\n    const endpoints = [\n      { method: 'get' as const, url: '/users/me' },\n      { method: 'post' as const, url: '/events' },\n      { method: 'post' as const, url: '/query/count' },\n      { method: 'get' as const, url: '/dashboards' },\n      { method: 'get' as const, url: '/export/events?format=json' },\n    ];\n\n    for (const ep of endpoints) {\n      const res = await request(app)[ep.method](ep.url);\n      expect(res.status).toBe(401);\n      expect(res.body).toHaveProperty('error');\n      expect(res.body).toHaveProperty('code');\n      expect(typeof res.body.error).toBe('string');\n      expect(typeof res.body.code).toBe('string');\n    }\n  });\n\n  it('should return consistent error format for invalid token', async () => {\n    const endpoints = [\n      { method: 'get' as const, url: '/users/me' },\n      { method: 'post' as const, url: '/events' },\n      { method: 'get' as const, url: '/dashboards' },\n    ];\n\n    for (const ep of endpoints) {\n      const res = await request(app)\n        [ep.method](ep.url)\n        .set('Authorization', 'Bearer invalid-token-here');\n\n      expect(res.status).toBe(401);\n      expect(res.body).toHaveProperty('error');\n      expect(res.body).toHaveProperty('code');\n      expect(res.body.code).toBe('AUTH_ERROR');\n    }\n  });\n\n  // --- Ingest with Real Auth (2 tests) ---\n\n  it('should ingest a single event with real JWT', async () => {\n    const token = await registerAndLogin(app, 'ingest@test.com', 'pass', TENANT_A);\n\n    const res = await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'page_view', properties: { page: '/home' } });\n\n    expect(res.status).toBe(201);\n    expect(res.body.name).toBe('page_view');\n    expect(res.body.tenant_id).toBe(TENANT_A);\n  });\n\n  it('should ingest batch events with real JWT', async () => {\n    const token = await registerAndLogin(app, 'batch@test.com', 'pass', TENANT_A);\n\n    const res = await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'view', properties: { p: '1' } },\n          { name: 'click', properties: { p: '2' } },\n        ],\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.inserted).toBe(2);\n  });\n\n  // --- Query with Real Auth + Tenant Isolation (3 tests) ---\n\n  it('should query event count with real JWT', async () => {\n    const token = await registerAndLogin(app, 'q@test.com', 'pass', TENANT_A);\n\n    // Ingest events\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'page_view' },\n          { name: 'page_view' },\n          { name: 'click' },\n        ],\n      });\n\n    const res = await request(app)\n      .post('/query/count')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'page_view' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.count).toBe(2);\n  });\n\n  it('should return timeseries data with real JWT', async () => {\n    const token = await registerAndLogin(app, 'ts@test.com', 'pass', TENANT_A);\n\n    await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'view', timestamp: '2024-01-15T10:00:00Z' });\n\n    const res = await request(app)\n      .post('/query/timeseries')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'view', bucket: 'day' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.data).toBeInstanceOf(Array);\n  });\n\n  it('should enforce tenant isolation in queries', async () => {\n    const tokenA = await registerAndLogin(app, 'a@test.com', 'pass', TENANT_A);\n    const tokenB = await registerAndLogin(app, 'b@test.com', 'pass', TENANT_B);\n\n    // Tenant A ingests events\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${tokenA}`)\n      .send({\n        events: [{ name: 'secret_event' }, { name: 'secret_event' }],\n      });\n\n    // Tenant B should not see Tenant A's events\n    const res = await request(app)\n      .post('/query/count')\n      .set('Authorization', `Bearer ${tokenB}`)\n      .send({ event_name: 'secret_event' });\n\n    expect(res.status).toBe(200);\n    expect(res.body.count).toBe(0);\n  });\n\n  // --- Dashboard CRUD with Real Auth (3 tests) ---\n\n  it('should create and list dashboards with real JWT', async () => {\n    const token = await registerAndLogin(app, 'dash@test.com', 'pass', TENANT_A);\n\n    const createRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'My Dashboard' });\n\n    expect(createRes.status).toBe(201);\n    expect(createRes.body.name).toBe('My Dashboard');\n\n    const listRes = await request(app)\n      .get('/dashboards')\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(listRes.status).toBe(200);\n    expect(listRes.body).toHaveLength(1);\n  });\n\n  it('should get and update dashboard with real JWT', async () => {\n    const token = await registerAndLogin(app, 'dashup@test.com', 'pass', TENANT_A);\n\n    const createRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Original' });\n\n    const dashId = createRes.body.id;\n\n    const updateRes = await request(app)\n      .patch(`/dashboards/${dashId}`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Updated' });\n\n    expect(updateRes.status).toBe(200);\n    expect(updateRes.body.name).toBe('Updated');\n\n    const getRes = await request(app)\n      .get(`/dashboards/${dashId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(getRes.status).toBe(200);\n    expect(getRes.body.name).toBe('Updated');\n  });\n\n  it('should delete dashboard with real JWT', async () => {\n    const token = await registerAndLogin(app, 'dashdel@test.com', 'pass', TENANT_A);\n\n    const createRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'To Delete' });\n\n    const dashId = createRes.body.id;\n\n    const delRes = await request(app)\n      .delete(`/dashboards/${dashId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(delRes.status).toBe(204);\n\n    const getRes = await request(app)\n      .get(`/dashboards/${dashId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(getRes.status).toBe(404);\n  });\n\n  // --- Widget Management (2 tests) ---\n\n  it('should add widget to dashboard with real JWT', async () => {\n    const token = await registerAndLogin(app, 'widget@test.com', 'pass', TENANT_A);\n\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Widget Dash' });\n\n    const dashId = dashRes.body.id;\n\n    const widgetRes = await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'counter', config: { event_name: 'page_view' } });\n\n    expect(widgetRes.status).toBe(201);\n    expect(widgetRes.body.type).toBe('counter');\n    expect(widgetRes.body.dashboard_id).toBe(dashId);\n  });\n\n  it('should delete widget from dashboard with real JWT', async () => {\n    const token = await registerAndLogin(app, 'wdel@test.com', 'pass', TENANT_A);\n\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Widget Dash' });\n\n    const dashId = dashRes.body.id;\n\n    const widgetRes = await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'timeseries', config: {} });\n\n    const widgetId = widgetRes.body.id;\n\n    const delRes = await request(app)\n      .delete(`/dashboards/${dashId}/widgets/${widgetId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(delRes.status).toBe(204);\n  });\n\n  // --- Export with Real Auth (2 tests) ---\n\n  it('should export events as JSON with real JWT', async () => {\n    const token = await registerAndLogin(app, 'exp@test.com', 'pass', TENANT_A);\n\n    await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'exported_event' });\n\n    const res = await request(app)\n      .get('/export/events?format=json')\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body).toBeInstanceOf(Array);\n    expect(res.body.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('should export dashboard data with real JWT', async () => {\n    const token = await registerAndLogin(app, 'expd@test.com', 'pass', TENANT_A);\n\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Export Dash' });\n\n    const dashId = dashRes.body.id;\n\n    await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'breakdown', config: { prop: 'page' } });\n\n    const res = await request(app)\n      .get(`/export/dashboard/${dashId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.dashboard.name).toBe('Export Dash');\n    expect(res.body.widgets).toHaveLength(1);\n  });\n\n  // --- Cross-feature: Full Workflow (2 tests) ---\n\n  it('should complete full workflow: register, ingest, query, dashboard, export', async () => {\n    // Register and login\n    const token = await registerAndLogin(app, 'full@test.com', 'pass', TENANT_A);\n\n    // Get profile\n    const meRes = await request(app)\n      .get('/users/me')\n      .set('Authorization', `Bearer ${token}`);\n    expect(meRes.status).toBe(200);\n\n    // Ingest events\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'page_view', properties: { page: '/home' }, timestamp: '2024-01-15T10:00:00Z' },\n          { name: 'page_view', properties: { page: '/about' }, timestamp: '2024-01-15T11:00:00Z' },\n          { name: 'click', properties: { button: 'buy' }, timestamp: '2024-01-15T10:30:00Z' },\n        ],\n      });\n\n    // Query count\n    const countRes = await request(app)\n      .post('/query/count')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'page_view' });\n    expect(countRes.body.count).toBe(2);\n\n    // Create dashboard\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Full Workflow Dash' });\n    const dashId = dashRes.body.id;\n\n    // Add widget\n    await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'counter', config: { event_name: 'page_view' } });\n\n    // Export events\n    const exportRes = await request(app)\n      .get('/export/events?format=json')\n      .set('Authorization', `Bearer ${token}`);\n    expect(exportRes.body).toHaveLength(3);\n\n    // Export dashboard\n    const dashExportRes = await request(app)\n      .get(`/export/dashboard/${dashId}`)\n      .set('Authorization', `Bearer ${token}`);\n    expect(dashExportRes.body.widgets).toHaveLength(1);\n  });\n\n  it('should handle breakdown and funnel queries in full workflow', async () => {\n    const token = await registerAndLogin(app, 'funnel@test.com', 'pass', TENANT_A);\n\n    // Ingest funnel events with session\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'page_view', properties: { page: '/landing' }, session_id: 'sess1' },\n          { name: 'signup_click', properties: {}, session_id: 'sess1' },\n          { name: 'signup_complete', properties: {}, session_id: 'sess1' },\n          { name: 'page_view', properties: { page: '/landing' }, session_id: 'sess2' },\n          { name: 'signup_click', properties: {}, session_id: 'sess2' },\n        ],\n      });\n\n    // Breakdown\n    const breakdownRes = await request(app)\n      .post('/query/breakdown')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'page_view', property_key: 'page' });\n\n    expect(breakdownRes.status).toBe(200);\n    expect(breakdownRes.body.data).toBeInstanceOf(Array);\n\n    // Funnel\n    const funnelRes = await request(app)\n      .post('/query/funnel')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ steps: ['page_view', 'signup_click', 'signup_complete'] });\n\n    expect(funnelRes.status).toBe(200);\n    expect(funnelRes.body.steps).toHaveLength(3);\n    // step 1 (page_view) >= step 2 (signup_click) >= step 3 (signup_complete)\n    expect(funnelRes.body.steps[0].count).toBeGreaterThanOrEqual(funnelRes.body.steps[1].count);\n    expect(funnelRes.body.steps[1].count).toBeGreaterThanOrEqual(funnelRes.body.steps[2].count);\n  });\n\n  // --- Tenant Isolation Across All Features (2 tests) ---\n\n  it('should isolate dashboards between tenants', async () => {\n    const tokenA = await registerAndLogin(app, 'isoA@test.com', 'pass', TENANT_A);\n    const tokenB = await registerAndLogin(app, 'isoB@test.com', 'pass', TENANT_B);\n\n    // Tenant A creates a dashboard\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${tokenA}`)\n      .send({ name: 'Secret Dashboard' });\n\n    const dashId = dashRes.body.id;\n\n    // Tenant B should not see Tenant A's dashboard\n    const listRes = await request(app)\n      .get('/dashboards')\n      .set('Authorization', `Bearer ${tokenB}`);\n\n    expect(listRes.body).toHaveLength(0);\n\n    // Tenant B should not access Tenant A's dashboard by ID\n    const getRes = await request(app)\n      .get(`/dashboards/${dashId}`)\n      .set('Authorization', `Bearer ${tokenB}`);\n\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should isolate exports between tenants', async () => {\n    const tokenA = await registerAndLogin(app, 'exA@test.com', 'pass', TENANT_A);\n    const tokenB = await registerAndLogin(app, 'exB@test.com', 'pass', TENANT_B);\n\n    // Tenant A ingests events\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${tokenA}`)\n      .send({\n        events: [\n          { name: 'private_event' },\n          { name: 'private_event' },\n        ],\n      });\n\n    // Tenant B should not see Tenant A's events in export\n    const exportRes = await request(app)\n      .get('/export/events?format=json')\n      .set('Authorization', `Bearer ${tokenB}`);\n\n    expect(exportRes.body).toHaveLength(0);\n\n    // Tenant A's dashboard should not be exportable by Tenant B\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${tokenA}`)\n      .send({ name: 'Private Dash' });\n\n    const dashExportRes = await request(app)\n      .get(`/export/dashboard/${dashRes.body.id}`)\n      .set('Authorization', `Bearer ${tokenB}`);\n\n    expect(dashExportRes.status).toBe(404);\n  });\n});\n\n// Helper function to register a user and return their JWT token\nasync function registerAndLogin(\n  app: ReturnType<typeof createApp>,\n  email: string,\n  password: string,\n  tenantId: string\n): Promise<string> {\n  await request(app)\n    .post('/users')\n    .send({ email, password, tenant_id: tenantId });\n\n  const loginRes = await request(app)\n    .post('/users/login')\n    .send({ email, password });\n\n  return loginRes.body.token;\n}\n","numLines":537,"startLine":1,"totalLines":537}}}
