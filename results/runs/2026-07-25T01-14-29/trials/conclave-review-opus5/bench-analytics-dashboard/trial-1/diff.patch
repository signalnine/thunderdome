+import { Router } from 'express';
+import { getAuthUser } from '../auth/middleware';
+import { requireCurrentUser } from '../users/service';
+import {
+  asObject,
+  optionalEnum,
+  optionalIntInRange,
+  optionalObject,
+  requireEnum,
+  requireString,
+} from '../validate';
+import {
+  WIDGET_TYPES,
+  createDashboard,
+  createWidget,
+  deleteDashboard,
+  deleteWidget,
+  listDashboards,
+  listWidgets,
+  requireDashboard,
+  requireWidget,
+  toDashboardPayload,
+  toWidgetPayload,
+  updateDashboard,
+  updateWidget,
+} from './service';
+
+const MAX_POSITION = 1000;
+const MAX_SPAN = 100;
+
+const router = Router();
+
+/** POST /dashboards — create a dashboard owned by the caller. */
+router.post('/', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+
+  // `dashboards.owner_id` is a foreign key into `users`, so a still-valid token
+  // for a deleted user must be rejected here rather than surfacing as a 500.
+  const owner = requireCurrentUser(auth);
+
+  const dashboard = createDashboard({
+    tenantId: auth.tenantId,
+    ownerId: owner.id,
+    name: requireString(body, 'name'),
+    config: optionalObject(body, 'config') ?? {},
+  });
+
+  res.status(201).json(dashboard);
+});
+
+/** GET /dashboards — every dashboard in the caller's tenant. */
+router.get('/', (req, res) => {
+  const auth = getAuthUser(req);
+  res.status(200).json(listDashboards(auth.tenantId));
+});
+
+/** GET /dashboards/:id — a dashboard together with its widgets. */
+router.get('/:id', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = requireDashboard(req.params.id, auth.tenantId);
+  res.status(200).json({
+    ...toDashboardPayload(dashboard),
+    widgets: listWidgets(dashboard.id),
+  });
+});
+
+/** PATCH /dashboards/:id — update the name and/or config. */
+router.patch('/:id', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+
+  const name = body.name === undefined ? undefined : requireString(body, 'name');
+
+  res.status(200).json(
+    updateDashboard(req.params.id, auth.tenantId, {
+      name,
+      config: optionalObject(body, 'config'),
+    })
+  );
+});
+
+/** DELETE /dashboards/:id — remove a dashboard and its widgets. */
+router.delete('/:id', (req, res) => {
+  const auth = getAuthUser(req);
+  deleteDashboard(req.params.id, auth.tenantId);
+  res.status(204).send();
+});
+
+/** GET /dashboards/:id/widgets — widgets belonging to a dashboard. */
+router.get('/:id/widgets', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = requireDashboard(req.params.id, auth.tenantId);
+  res.status(200).json(listWidgets(dashboard.id));
+});
+
+/** POST /dashboards/:id/widgets — add a widget to a dashboard. */
+router.post('/:id/widgets', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = requireDashboard(req.params.id, auth.tenantId);
+  const body = asObject(req.body);
+
+  const widget = createWidget(dashboard.id, {
+    type: requireEnum(body, 'type', WIDGET_TYPES),
+    config: optionalObject(body, 'config') ?? {},
+    position_x: optionalIntInRange(body, 'position_x', 0, 0, MAX_POSITION),
+    position_y: optionalIntInRange(body, 'position_y', 0, 0, MAX_POSITION),
+    width: optionalIntInRange(body, 'width', 1, 1, MAX_SPAN),
+    height: optionalIntInRange(body, 'height', 1, 1, MAX_SPAN),
+  });
+
+  res.status(201).json(widget);
+});
+
+/** GET /dashboards/:id/widgets/:widgetId — a single widget. */
+router.get('/:id/widgets/:widgetId', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = requireDashboard(req.params.id, auth.tenantId);
+  res.status(200).json(toWidgetPayload(requireWidget(dashboard.id, req.params.widgetId)));
+});
+
+/** PATCH /dashboards/:id/widgets/:widgetId — update a widget. */
+router.patch('/:id/widgets/:widgetId', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = requireDashboard(req.params.id, auth.tenantId);
+  const body = asObject(req.body);
+  const existing = requireWidget(dashboard.id, req.params.widgetId);
+
+  // Fall back to the widget's current value rather than the create-time default,
+  // so an omitted (or explicitly null) field preserves the existing layout.
+  const patchInt = (field: string, current: number, min: number, max: number): number =>
+    optionalIntInRange(body, field, current, min, max);
+
+  const widget = updateWidget(existing, {
+    type: optionalEnum(body, 'type', WIDGET_TYPES),
+    config: optionalObject(body, 'config'),
+    position_x: patchInt('position_x', existing.position_x, 0, MAX_POSITION),
+    position_y: patchInt('position_y', existing.position_y, 0, MAX_POSITION),
+    width: patchInt('width', existing.width, 1, MAX_SPAN),
+    height: patchInt('height', existing.height, 1, MAX_SPAN),
+  });
+
+  res.status(200).json(widget);
+});
+
+/** DELETE /dashboards/:id/widgets/:widgetId — remove a widget. */
+router.delete('/:id/widgets/:widgetId', (req, res) => {
+  const auth = getAuthUser(req);
+  const dashboard = requireDashboard(req.params.id, auth.tenantId);
+  deleteWidget(dashboard.id, req.params.widgetId);
+  res.status(204).send();
+});
+
+export default router;
diff --git a/src/dashboards/service.ts b/src/dashboards/service.ts
new file mode 100644
index 0000000..8aa8346
--- /dev/null
+++ b/src/dashboards/service.ts
@@ -0,0 +1,245 @@
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { notFound } from '../errors';
+import { parseJsonObject } from '../validate';
+
+export const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'] as const;
+export type WidgetType = (typeof WIDGET_TYPES)[number];
+
+export interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: WidgetType;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+export interface DashboardPayload extends Omit<DashboardRow, 'config'> {
+  config: Record<string, unknown>;
+}
+
+export interface WidgetPayload extends Omit<WidgetRow, 'config'> {
+  config: Record<string, unknown>;
+}
+
+export function toDashboardPayload(row: DashboardRow): DashboardPayload {
+  return { ...row, config: parseJsonObject(row.config) };
+}
+
+export function toWidgetPayload(row: WidgetRow): WidgetPayload {
+  return { ...row, config: parseJsonObject(row.config) };
+}
+
+export function listDashboards(tenantId: string): DashboardPayload[] {
+  const rows = getDb()
+    .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at ASC, id ASC')
+    .all(tenantId) as DashboardRow[];
+  return rows.map(toDashboardPayload);
+}
+
+function findDashboard(id: string, tenantId: string): DashboardRow | undefined {
+  return getDb()
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, tenantId) as DashboardRow | undefined;
+}
+
+/**
+ * Load a dashboard within the caller's tenant. Cross-tenant access is reported
+ * as 404 rather than 403 so that IDs from other tenants stay unguessable.
+ */
+export function requireDashboard(id: string, tenantId: string): DashboardRow {
+  const row = findDashboard(id, tenantId);
+  if (!row) {
+    throw notFound('Dashboard not found');
+  }
+  return row;
+}
+
+export function listWidgets(dashboardId: string): WidgetPayload[] {
+  const rows = getDb()
+    .prepare(
+      `SELECT * FROM widgets WHERE dashboard_id = ?
+       ORDER BY position_y ASC, position_x ASC, id ASC`
+    )
+    .all(dashboardId) as WidgetRow[];
+  return rows.map(toWidgetPayload);
+}
+
+export function createDashboard(input: {
+  tenantId: string;
+  ownerId: string;
+  name: string;
+  config: Record<string, unknown>;
+}): DashboardPayload {
+  const now = new Date().toISOString();
+  const row: DashboardRow = {
+    id: uuidv4(),
+    tenant_id: input.tenantId,
+    name: input.name,
+    owner_id: input.ownerId,
+    config: JSON.stringify(input.config),
+    created_at: now,
+    updated_at: now,
+  };
+
+  getDb()
+    .prepare(
+      `INSERT INTO dashboards (id, tenant_id, name, owner_id, config, created_at, updated_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(
+      row.id,
+      row.tenant_id,
+      row.name,
+      row.owner_id,
+      row.config,
+      row.created_at,
+      row.updated_at
+    );
+
+  return toDashboardPayload(row);
+}
+
+export function updateDashboard(
+  id: string,
+  tenantId: string,
+  patch: { name?: string; config?: Record<string, unknown> }
+): DashboardPayload {
+  const existing = requireDashboard(id, tenantId);
+  const updated: DashboardRow = {
+    ...existing,
+    name: patch.name ?? existing.name,
+    config: patch.config === undefined ? existing.config : JSON.stringify(patch.config),
+    updated_at: new Date().toISOString(),
+  };
+
+  getDb()
+    .prepare('UPDATE dashboards SET name = ?, config = ?, updated_at = ? WHERE id = ?')
+    .run(updated.name, updated.config, updated.updated_at, updated.id);
+
+  return toDashboardPayload(updated);
+}
+
+export function deleteDashboard(id: string, tenantId: string): void {
+  const existing = requireDashboard(id, tenantId);
+  const db = getDb();
+  // Widgets cascade via the foreign key, but deleting them explicitly keeps the
+  // behaviour correct even if `PRAGMA foreign_keys` is off on a connection.
+  db.transaction(() => {
+    db.prepare('DELETE FROM widgets WHERE dashboard_id = ?').run(existing.id);
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(existing.id);
+  })();
+}
+
+export function createWidget(
+  dashboardId: string,
+  input: {
+    type: WidgetType;
+    config: Record<string, unknown>;
+    position_x: number;
+    position_y: number;
+    width: number;
+    height: number;
+  }
+): WidgetPayload {
+  const row: WidgetRow = {
+    id: uuidv4(),
+    dashboard_id: dashboardId,
+    type: input.type,
+    config: JSON.stringify(input.config),
+    position_x: input.position_x,
+    position_y: input.position_y,
+    width: input.width,
+    height: input.height,
+  };
+
+  getDb()
+    .prepare(
+      `INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
+    )
+    .run(
+      row.id,
+      row.dashboard_id,
+      row.type,
+      row.config,
+      row.position_x,
+      row.position_y,
+      row.width,
+      row.height
+    );
+
+  return toWidgetPayload(row);
+}
+
+export function requireWidget(dashboardId: string, widgetId: string): WidgetRow {
+  const row = getDb()
+    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+    .get(widgetId, dashboardId) as WidgetRow | undefined;
+  if (!row) {
+    throw notFound('Widget not found');
+  }
+  return row;
+}
+
+/**
+ * Persist a patch onto an already-loaded widget. The caller supplies the row so
+ * that it can resolve "leave unchanged" defaults from the current values.
+ */
+export function updateWidget(
+  existing: WidgetRow,
+  patch: {
+    type?: WidgetType;
+    config?: Record<string, unknown>;
+    position_x?: number;
+    position_y?: number;
+    width?: number;
+    height?: number;
+  }
+): WidgetPayload {
+  const updated: WidgetRow = {
+    ...existing,
+    type: patch.type ?? existing.type,
+    config: patch.config === undefined ? existing.config : JSON.stringify(patch.config),
+    position_x: patch.position_x ?? existing.position_x,
+    position_y: patch.position_y ?? existing.position_y,
+    width: patch.width ?? existing.width,
+    height: patch.height ?? existing.height,
+  };
+
+  getDb()
+    .prepare(
+      `UPDATE widgets
+       SET type = ?, config = ?, position_x = ?, position_y = ?, width = ?, height = ?
+       WHERE id = ?`
+    )
+    .run(
+      updated.type,
+      updated.config,
+      updated.position_x,
+      updated.position_y,
+      updated.width,
+      updated.height,
+      updated.id
+    );
+
+  return toWidgetPayload(updated);
+}
+
+export function deleteWidget(dashboardId: string, widgetId: string): void {
+  const existing = requireWidget(dashboardId, widgetId);
+  getDb().prepare('DELETE FROM widgets WHERE id = ?').run(existing.id);
+}
diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..2b32d49
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,66 @@
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import Database from 'better-sqlite3';
+
+let currentDb: Database.Database | null = null;
+let schemaSql: string | null = null;
+
+/**
+ * Load `schema.sql` from the repository root.
+ *
+ * `__dirname` is `src/` when running from source (tests) and `dist/` after
+ * compilation, so the parent directory locates the file in both cases. Reading
+ * the single canonical file keeps the runtime schema from drifting away from
+ * the checked-in DDL.
+ */
+function loadSchema(): string {
+  if (schemaSql === null) {
+    const path = join(__dirname, '..', 'schema.sql');
+    try {
+      schemaSql = readFileSync(path, 'utf8');
+    } catch (err) {
+      const reason = err instanceof Error ? err.message : String(err);
+      throw new Error(`Unable to read database schema at ${path}: ${reason}`);
+    }
+  }
+  return schemaSql;
+}
+
+/**
+ * Create a database connection with the analytics schema applied.
+ * Defaults to an in-memory database.
+ */
+export function createDb(location = ':memory:'): Database.Database {
+  const db = new Database(location);
+  db.pragma('foreign_keys = ON');
+  db.exec(loadSchema());
+  return db;
+}
+
+/** Create a fresh in-memory database for tests. */
+export function createTestDb(): Database.Database {
+  return createDb(':memory:');
+}
+
+/** Install the database instance used by the application. */
+export function setDb(db: Database.Database): void {
+  currentDb = db;
+}
+
+/** Get the active database instance. */
+export function getDb(): Database.Database {
+  if (!currentDb) {
+    throw new Error('Database has not been initialized. Call setDb() first.');
+  }
+  return currentDb;
+}
+
+/** Close and clear the active database instance. */
+export function closeDb(): void {
+  if (currentDb) {
+    if (currentDb.open) {
+      currentDb.close();
+    }
+    currentDb = null;
+  }
+}
