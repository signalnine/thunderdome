+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MuFhVutuZ6qSwksFPpfd6z","type":"tool_result","content":"1\timport { Router } from 'express';\n2\timport { getAuthUser } from '../auth/middleware';\n3\timport {\n4\t  asObject,\n5\t  optionalEnum,\n6\t  optionalIntInRange,\n7\t  optionalObject,\n8\t  requireEnum,\n9\t  requireString,\n10\t} from '../validate';\n11\timport {\n12\t  WIDGET_TYPES,\n13\t  createDashboard,\n14\t  createWidget,\n15\t  deleteDashboard,\n16\t  deleteWidget,\n17\t  listDashboards,\n18\t  listWidgets,\n19\t  requireDashboard,\n20\t  requireWidget,\n21\t  toDashboardPayload,\n22\t  toWidgetPayload,\n23\t  updateDashboard,\n24\t  updateWidget,\n25\t} from './service';\n26\t\n27\tconst MAX_POSITION = 1000;\n28\tconst MAX_SPAN = 100;\n29\t\n30\tconst router = Router();\n31\t\n32\t/** POST /dashboards — create a dashboard owned by the caller. */\n33\trouter.post('/', (req, res) => {\n34\t  const auth = getAuthUser(req);\n35\t  const body = asObject(req.body);\n36\t\n37\t  const dashboard = createDashboard({\n38\t    tenantId: auth.tenantId,\n39\t    ownerId: auth.id,\n40\t    name: requireString(body, 'name'),\n41\t    config: optionalObject(body, 'config') ?? {},\n42\t  });\n43\t\n44\t  res.status(201).json(dashboard);\n45\t});\n46\t\n47\t/** GET /dashboards — every dashboard in the caller's tenant. */\n48\trouter.get('/', (req, res) => {\n49\t  const auth = getAuthUser(req);\n50\t  res.status(200).json(listDashboards(auth.tenantId));\n51\t});\n52\t\n53\t/** GET /dashboards/:id — a dashboard together with its widgets. */\n54\trouter.get('/:id', (req, res) => {\n55\t  const auth = getAuthUser(req);\n56\t  const dashboard = requireDashboard(req.params.id, auth.tenantId);\n57\t  res.status(200).json({\n58\t    ...toDashboardPayload(dashboard),\n59\t    widgets: listWidgets(dashboard.id),\n60\t  });\n61\t});\n62\t\n63\t/** PATCH /dashboards/:id — update the name and/or config. */\n64\trouter.patch('/:id', (req, res) => {\n65\t  const auth = getAuthUser(req);\n66\t  const body = asObject(req.body);\n67\t\n68\t  const name = body.name === undefined ? undefined : requireString(body, 'name');\n69\t\n70\t  res.status(200).json(\n71\t    updateDashboard(req.params.id, auth.tenantId, {\n72\t      name,\n73\t      config: optionalObject(body, 'config'),\n74\t    })\n75\t  );\n76\t});\n77\t\n78\t/** DELETE /dashboards/:id — remove a dashboard and its widgets. */\n79\trouter.delete('/:id', (req, res) => {\n80\t  const auth = getAuthUser(req);\n81\t  deleteDashboard(req.params.id, auth.tenantId);\n82\t  res.status(204).send();\n83\t});\n84\t\n85\t/** GET /dashboards/:id/widgets — widgets belonging to a dashboard. */\n86\trouter.get('/:id/widgets', (req, res) => {\n87\t  const auth = getAuthUser(req);\n88\t  const dashboard = requireDashboard(req.params.id, auth.tenantId);\n89\t  res.status(200).json(listWidgets(dashboard.id));\n90\t});\n91\t\n92\t/** POST /dashboards/:id/widgets — add a widget to a dashboard. */\n93\trouter.post('/:id/widgets', (req, res) => {\n94\t  const auth = getAuthUser(req);\n95\t  const dashboard = requireDashboard(req.params.id, auth.tenantId);\n96\t  const body = asObject(req.body);\n97\t\n98\t  const widget = createWidget(dashboard.id, {\n99\t    type: requireEnum(body, 'type', WIDGET_TYPES),\n100\t    config: optionalObject(body, 'config') ?? {},\n101\t    position_x: optionalIntInRange(body, 'position_x', 0, 0, MAX_POSITION),\n102\t    position_y: optionalIntInRange(body, 'position_y', 0, 0, MAX_POSITION),\n103\t    width: optionalIntInRange(body, 'width', 1, 1, MAX_SPAN),\n104\t    height: optionalIntInRange(body, 'height', 1, 1, MAX_SPAN),\n105\t  });\n106\t\n107\t  res.status(201).json(widget);\n108\t});\n109\t\n110\t/** GET /dashboards/:id/widgets/:widgetId — a single widget. */\n111\trouter.get('/:id/widgets/:widgetId', (req, res) => {\n112\t  const auth = getAuthUser(req);\n113\t  const dashboard = requireDashboard(req.params.id, auth.tenantId);\n114\t  res.status(200).json(toWidgetPayload(requireWidget(dashboard.id, req.params.widgetId)));\n115\t});\n116\t\n117\t/** PATCH /dashboards/:id/widgets/:widgetId — update a widget. */\n118\trouter.patch('/:id/widgets/:widgetId', (req, res) => {\n119\t  const auth = getAuthUser(req);\n120\t  const dashboard = requireDashboard(req.params.id, auth.tenantId);\n121\t  const body = asObject(req.body);\n122\t  const existing = requireWidget(dashboard.id, req.params.widgetId);\n123\t\n124\t  const widget = updateWidget(dashboard.id, existing.id, {\n125\t    type: optionalEnum(body, 'type', WIDGET_TYPES),\n126\t    config: optionalObject(body, 'config'),\n127\t    position_x:\n128\t      body.position_x === undefined\n129\t        ? undefined\n130\t        : optionalIntInRange(body, 'position_x', 0, 0, MAX_POSITION),\n131\t    position_y:\n132\t      body.position_y === undefined\n133\t        ? undefined\n134\t        : optionalIntInRange(body, 'position_y', 0, 0, MAX_POSITION),\n135\t    width:\n136\t      body.width === undefined ? undefined : optionalIntInRange(body, 'width', 1, 1, MAX_SPAN),\n137\t    height:\n138\t      body.height === undefined ? undefined : optionalIntInRange(body, 'height', 1, 1, MAX_SPAN),\n139\t  });\n140\t\n141\t  res.status(200).json(widget);\n142\t});\n143\t\n144\t/** DELETE /dashboards/:id/widgets/:widgetId — remove a widget. */\n145\trouter.delete('/:id/widgets/:widgetId', (req, res) => {\n146\t  const auth = getAuthUser(req);\n147\t  const dashboard = requireDashboard(req.params.id, auth.tenantId);\n148\t  deleteWidget(dashboard.id, req.params.widgetId);\n149\t  res.status(204).send();\n150\t});\n151\t\n152\texport default router;\n153\t"}]},"parent_tool_use_id":"toolu_01FT7BNMgLQ2UYZCh4ntxmoa","session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"87f51888-b1b8-45f2-b328-2c80e79157f4","timestamp":"2026-07-25T01:41:04.134Z","subagent_type":"general-purpose","task_description":"Review code quality and API design"}
