+++ b/src/ingest/router.ts
@@ -0,0 +1,23 @@
+import { Router } from 'express';
+import { getAuthUser } from '../auth/middleware';
+import { buildEvent, insertEvents, parseBatch } from './service';
+
+const router = Router();
+
+/** POST /events — ingest a single event. */
+router.post('/', (req, res) => {
+  const auth = getAuthUser(req);
+  const row = buildEvent(req.body, { tenantId: auth.tenantId, userId: auth.id });
+  const [event] = insertEvents([row]);
+  res.status(201).json(event);
+});
+
+/** POST /events/batch — ingest many events atomically. */
+router.post('/batch', (req, res) => {
+  const auth = getAuthUser(req);
+  const rows = parseBatch(req.body, { tenantId: auth.tenantId, userId: auth.id });
+  const events = insertEvents(rows);
+  res.status(201).json({ inserted: events.length, events });
+});
+
+export default router;
diff --git a/src/ingest/service.ts b/src/ingest/service.ts
new file mode 100644
index 0000000..633a467
--- /dev/null
+++ b/src/ingest/service.ts
@@ -0,0 +1,103 @@
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { badRequest } from '../errors';
+import { asObject, optionalObject, optionalString, optionalTimestamp, requireString } from '../validate';
+
+export const MAX_BATCH_SIZE = 1000;
+
+export interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export interface EventPayload {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+export interface IngestContext {
+  tenantId: string;
+  userId: string;
+}
+
+/**
+ * Validate a single raw event and stamp it with tenant/identity/time defaults.
+ * Validation happens for the whole batch before anything is written.
+ */
+export function buildEvent(raw: unknown, ctx: IngestContext, label = 'event'): EventRow {
+  const body = asObject(raw, label);
+  const properties = optionalObject(body, 'properties') ?? {};
+
+  return {
+    id: uuidv4(),
+    tenant_id: ctx.tenantId,
+    name: requireString(body, 'name'),
+    properties: JSON.stringify(properties),
+    timestamp: optionalTimestamp(body, 'timestamp') ?? new Date().toISOString(),
+    user_id: optionalString(body, 'user_id') ?? ctx.userId,
+    session_id: optionalString(body, 'session_id') ?? null,
+  };
+}
+
+function toEventPayload(row: EventRow): EventPayload {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties) as Record<string, unknown>,
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+/** Insert events atomically — either every event lands or none do. */
+export function insertEvents(rows: EventRow[]): EventPayload[] {
+  const db = getDb();
+  const stmt = db.prepare(
+    `INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id)
+     VALUES (?, ?, ?, ?, ?, ?, ?)`
+  );
+
+  const insertAll = db.transaction((items: EventRow[]) => {
+    for (const row of items) {
+      stmt.run(
+        row.id,
+        row.tenant_id,
+        row.name,
+        row.properties,
+        row.timestamp,
+        row.user_id,
+        row.session_id
+      );
+    }
+  });
+
+  insertAll(rows);
+  return rows.map(toEventPayload);
+}
+
+export function parseBatch(raw: unknown, ctx: IngestContext): EventRow[] {
+  const body = asObject(raw);
+  const events = body.events;
+  if (!Array.isArray(events)) {
+    throw badRequest('events is required and must be an array');
+  }
+  if (events.length === 0) {
+    throw badRequest('events must contain at least one event');
+  }
+  if (events.length > MAX_BATCH_SIZE) {
+    throw badRequest(`events may contain at most ${MAX_BATCH_SIZE} events`);
+  }
+  return events.map((event, index) => buildEvent(event, ctx, `events[${index}]`));
+}
diff --git a/src/query/engine.ts b/src/query/engine.ts
new file mode 100644
index 0000000..af59f68
--- /dev/null
+++ b/src/query/engine.ts
@@ -0,0 +1,235 @@
+import { getDb } from '../db';
+import { badRequest } from '../errors';
+
+/**
+ * Canonical, millisecond-precision UTC rendering of a timestamp column or bound
+ * parameter. Events may be stored with any ISO-8601 spelling (`...Z`,
+ * `...+02:00`, with or without milliseconds); normalizing both sides of every
+ * comparison makes range filters and ordering reliable.
+ */
+const TS = (expr: string): string => `strftime('%Y-%m-%dT%H:%M:%fZ', ${expr})`;
+
+export const BUCKETS = ['hour', 'day', 'week', 'month'] as const;
+export type Bucket = (typeof BUCKETS)[number];
+
+const BUCKET_EXPR: Record<Bucket, string> = {
+  hour: `strftime('%Y-%m-%dT%H:00:00Z', timestamp)`,
+  day: `strftime('%Y-%m-%dT00:00:00Z', timestamp)`,
+  // 'weekday 0' jumps forward to Sunday; stepping back 6 days lands on Monday.
+  week: `strftime('%Y-%m-%dT00:00:00Z', timestamp, 'weekday 0', '-6 days')`,
+  month: `strftime('%Y-%m-01T00:00:00Z', timestamp)`,
+};
+
+const PROPERTY_KEY_PATTERN = /^[A-Za-z0-9_.-]+$/;
+
+export interface EventFilter {
+  tenantId: string;
+  eventName?: string;
+  eventNames?: string[];
+  start?: string;
+  end?: string;
+  properties?: Record<string, unknown>;
+}
+
+interface WhereClause {
+  sql: string;
+  params: unknown[];
+}
+
+/** Convert a JSON property key into a bound `json_extract` path. */
+export function propertyPath(key: string, label = 'property_key'): string {
+  if (!PROPERTY_KEY_PATTERN.test(key)) {
+    throw badRequest(`${label} may only contain letters, digits, underscores, dots and hyphens`);
+  }
+  return `$."${key}"`;
+}
+
+/**
+ * `json_extract` yields SQL-native types, so filter values must be coerced the
+ * same way for equality to hold (JSON booleans compare as 1/0).
+ */
+function bindableValue(value: unknown, key: string): string | number | null {
+  if (value === null) return null;
+  if (typeof value === 'string' || typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  throw badRequest(`filters.${key} must be a string, number, boolean or null`);
+}
+
+/** Build the shared `WHERE` fragment used by every query endpoint. */
+export function buildWhere(filter: EventFilter): WhereClause {
+  const clauses = ['tenant_id = ?'];
+  const params: unknown[] = [filter.tenantId];
+
+  if (filter.eventName !== undefined) {
+    clauses.push('name = ?');
+    params.push(filter.eventName);
+  }
+
+  if (filter.eventNames !== undefined) {
+    if (filter.eventNames.length === 0) {
+      // An empty name set matches nothing; avoid emitting `IN ()`.
+      clauses.push('1 = 0');
+    } else {
+      clauses.push(`name IN (${filter.eventNames.map(() => '?').join(', ')})`);
+      params.push(...filter.eventNames);
+    }
+  }
+
+  if (filter.start !== undefined) {
+    clauses.push(`${TS('timestamp')} >= ${TS('?')}`);
+    params.push(filter.start);
+  }
+
+  if (filter.end !== undefined) {
+    clauses.push(`${TS('timestamp')} <= ${TS('?')}`);
+    params.push(filter.end);
+  }
+
+  for (const [key, value] of Object.entries(filter.properties ?? {})) {
+    const path = propertyPath(key, `filters.${key}`);
+    const bound = bindableValue(value, key);
+    if (bound === null) {
+      clauses.push('json_extract(properties, ?) IS NULL');
+      params.push(path);
+    } else {
+      clauses.push('json_extract(properties, ?) = ?');
+      params.push(path, bound);
+    }
+  }
+
+  return { sql: clauses.join(' AND '), params };
+}
+
+export function countEvents(filter: EventFilter): number {
+  const where = buildWhere(filter);
+  const row = getDb()
+    .prepare(`SELECT COUNT(*) AS count FROM events WHERE ${where.sql}`)
+    .get(...where.params) as { count: number };
+  return row.count;
+}
+
+export interface TimeseriesPoint {
+  bucket: string;
+  count: number;
+}
+
+export function timeseries(filter: EventFilter, bucket: Bucket): TimeseriesPoint[] {
+  const where = buildWhere(filter);
+  const expr = BUCKET_EXPR[bucket];
+  return getDb()
+    .prepare(
+      `SELECT ${expr} AS bucket, COUNT(*) AS count
+       FROM events
+       WHERE ${where.sql}
+       GROUP BY bucket
+       ORDER BY bucket ASC`
+    )
+    .all(...where.params) as TimeseriesPoint[];
+}
+
+export interface BreakdownEntry {
+  property_value: string | number | null;
+  count: number;
+}
+
+export function breakdown(
+  filter: EventFilter,
+  propertyKey: string,
+  limit: number
+): BreakdownEntry[] {
+  const where = buildWhere(filter);
+  const path = propertyPath(propertyKey);
+  return getDb()
+    .prepare(
+      `SELECT json_extract(properties, ?) AS property_value, COUNT(*) AS count
+       FROM events
+       WHERE ${where.sql} AND json_extract(properties, ?) IS NOT NULL
+       GROUP BY property_value
+       ORDER BY count DESC, property_value ASC
+       LIMIT ?`
+    )
+    .all(path, ...where.params, path, limit) as BreakdownEntry[];
+}
+
+export interface FunnelStep {
+  step: number;
+  name: string;
+  count: number;
+  conversion_rate: number;
+}
+
+export const FUNNEL_GROUPINGS = ['session', 'user'] as const;
+export type FunnelGrouping = (typeof FUNNEL_GROUPINGS)[number];
+
+interface FunnelEventRow {
+  name: string;
+  session_id: string | null;
+  user_id: string | null;
+  rowid: number;
+}
+
+/**
+ * Ordered funnel analysis.
+ *
+ * Events are grouped into "actors" along a single dimension chosen for the
+ * whole query — `session_id` or `user_id`. The dimension is deliberately not
+ * decided per event: mixing them would split one real actor into two whenever
+ * an event carries a session but no user (or vice versa), and that actor would
+ * then never appear to convert. Events with no value on the chosen dimension
+ * cannot be attributed to an actor and are skipped.
+ *
+ * Each actor's timeline is walked once, in order: a step counts only if it
+ * occurs at or after the event that satisfied the previous step. Ties on
+ * timestamp — common when a batch is ingested in a single call — fall back to
+ * insertion order, so an actor is never credited with an out-of-sequence step.
+ *
+ * An actor enters the funnel at most once: after reaching the final step,
+ * repeating step 1 does not start a second pass. Counts are therefore
+ * monotonically non-increasing across steps.
+ */
+export function funnel(
+  filter: EventFilter,
+  steps: string[],
+  groupBy: FunnelGrouping = 'session'
+): FunnelStep[] {
+  const where = buildWhere({ ...filter, eventName: undefined, eventNames: steps });
+  const rows = getDb()
+    .prepare(
+      `SELECT name, session_id, user_id, rowid AS rowid
+       FROM events
+       WHERE ${where.sql}
+       ORDER BY ${TS('timestamp')} ASC, rowid ASC`
+    )
+    .all(...where.params) as FunnelEventRow[];
+
+  const progress = new Map<string, number>();
+  for (const row of rows) {
+    const actor = groupBy === 'user' ? row.user_id : row.session_id;
+    if (actor === null) {
+      continue;
+    }
+    const reached = progress.get(actor) ?? 0;
+    if (reached < steps.length && steps[reached] === row.name) {
+      progress.set(actor, reached + 1);
+    } else if (!progress.has(actor)) {
+      // Record the actor so they are counted as "seen but not converted".
+      progress.set(actor, 0);
+    }
+  }
+
+  const counts = steps.map((_, index) => {
+    let total = 0;
+    for (const reached of progress.values()) {
+      if (reached >= index + 1) total += 1;
+    }
+    return total;
+  });
+
+  const entered = counts[0] ?? 0;
+  return steps.map((name, index) => ({
+    step: index + 1,
+    name,
+    count: counts[index],
+    conversion_rate: entered === 0 ? 0 : counts[index] / entered,
+  }));
+}
