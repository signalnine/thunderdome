+++ b/src/query/router.ts
@@ -0,0 +1,97 @@
+import { Router } from 'express';
+import { getAuthUser } from '../auth/middleware';
+import { badRequest } from '../errors';
+import {
+  asObject,
+  optionalEnum,
+  optionalObject,
+  optionalPositiveInt,
+  optionalTimestamp,
+  requireString,
+} from '../validate';
+import {
+  BUCKETS,
+  FUNNEL_GROUPINGS,
+  breakdown,
+  countEvents,
+  funnel,
+  timeseries,
+  type EventFilter,
+} from './engine';
+
+const MAX_FUNNEL_STEPS = 10;
+const MAX_BREAKDOWN_LIMIT = 1000;
+const DEFAULT_BREAKDOWN_LIMIT = 100;
+
+const router = Router();
+
+/** Shared time-range / property filtering pulled from the request body. */
+function baseFilter(body: Record<string, unknown>, tenantId: string): EventFilter {
+  return {
+    tenantId,
+    start: optionalTimestamp(body, 'start'),
+    end: optionalTimestamp(body, 'end'),
+    properties: optionalObject(body, 'filters'),
+  };
+}
+
+/** POST /query/count — number of events matching a filter. */
+router.post('/count', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+  const eventName = requireString(body, 'event_name');
+
+  const count = countEvents({ ...baseFilter(body, auth.tenantId), eventName });
+  res.status(200).json({ event_name: eventName, count });
+});
+
+/** POST /query/timeseries — event counts bucketed over time. */
+router.post('/timeseries', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+  const eventName = requireString(body, 'event_name');
+  const bucket = optionalEnum(body, 'bucket', BUCKETS) ?? 'day';
+
+  const data = timeseries({ ...baseFilter(body, auth.tenantId), eventName }, bucket);
+  res.status(200).json({ event_name: eventName, bucket, data });
+});
+
+/** POST /query/breakdown — event counts grouped by a property value. */
+router.post('/breakdown', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+  const eventName = requireString(body, 'event_name');
+  const propertyKey = requireString(body, 'property_key');
+  const limit = optionalPositiveInt(body, 'limit', DEFAULT_BREAKDOWN_LIMIT, MAX_BREAKDOWN_LIMIT);
+
+  const data = breakdown({ ...baseFilter(body, auth.tenantId), eventName }, propertyKey, limit);
+  res.status(200).json({ event_name: eventName, property_key: propertyKey, data });
+});
+
+/** POST /query/funnel — ordered multi-step conversion analysis. */
+router.post('/funnel', (req, res) => {
+  const auth = getAuthUser(req);
+  const body = asObject(req.body);
+
+  const rawSteps = body.steps;
+  if (!Array.isArray(rawSteps) || rawSteps.length < 2) {
+    throw badRequest('steps is required and must be an array of at least 2 event names');
+  }
+  if (rawSteps.length > MAX_FUNNEL_STEPS) {
+    throw badRequest(`steps may contain at most ${MAX_FUNNEL_STEPS} event names`);
+  }
+  const steps = rawSteps.map((step, index) => {
+    if (typeof step !== 'string' || step.trim() === '') {
+      throw badRequest(`steps[${index}] must be a non-empty string`);
+    }
+    return step.trim();
+  });
+
+  const groupBy = optionalEnum(body, 'group_by', FUNNEL_GROUPINGS) ?? 'session';
+  res.status(200).json({
+    group_by: groupBy,
+    steps: funnel(baseFilter(body, auth.tenantId), steps, groupBy),
+  });
+});
+
+export default router;
