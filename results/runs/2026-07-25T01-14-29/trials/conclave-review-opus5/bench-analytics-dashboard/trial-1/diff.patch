.body.id}/widgets/${w.body.id}`)).send({ width: 9 });\n    expect(p3.body.width).toBe(9);\n  });\n\n  it('stale token for a deleted user yields 401, not a 500 FK leak', async () => {\n    const { token, id } = await reg('gone@x.com', 'T');\n    db.prepare('DELETE FROM users WHERE id = ?').run(id);\n    const res = await request(app).post('/dashboards').set('Authorization', `Bearer ${token}`).send({ name: 'X' });\n    expect(res.status).toBe(401);\n    expect(res.body.code).toBe('AUTH_ERROR');\n    expect(JSON.stringify(res.body)).not.toContain('FOREIGN KEY');\n  });\n\n  it('internal errors do not leak raw messages', async () => {\n    const { token } = await reg('e@x.com', 'T');\n    db.exec('DROP TABLE events');\n    const res = await request(app).post('/query/count').set('Authorization', `Bearer ${token}`).send({ event_name: 'a' });\n    expect(res.status).toBe(500);\n    expect(res.body).toEqual({ error: 'Internal server error', code: 'INTERNAL_ERROR' });\n  });\n\n  it('rejects hex/exponent limits and labels filter-key errors correctly', async () => {\n    const { token } = await reg('v@x.com', 'T');\n    const A = (r: request.Test) => r.set('Authorization', `Bearer ${token}`);\n    expect((await A(request(app).get('/export/events?format=json&limit=0x10'))).status).toBe(400);\n    expect((await A(request(app).get('/export/events?format=json&limit=1e3'))).status).toBe(400);\n    expect((await A(request(app).get('/export/events?format=json&limit=50'))).status).toBe(200);\n\n    const bad = await A(request(app).post('/query/count')).send({ event_name: 'a', filters: { 'a\"b': 1 } });\n    expect(bad.status).toBe(400);\n    expect(bad.body.error).toContain('filters.a\"b');\n  });\n\n  it('funnel groups by a single consistent dimension', async () => {\n    const { token } = await reg('f@x.com', 'T');\n    const A = (r: request.Test) => r.set('Authorization', `Bearer ${token}`);\n    await A(request(app).post('/events/batch')).send({ events: [\n      { name: 'pv',    timestamp: '2024-01-15T10:00:00Z', session_id: 's1' },\n      { name: 'click', timestamp: '2024-01-15T11:00:00Z', session_id: 's1' },\n      { name: 'buy',   timestamp: '2024-01-15T12:00:00Z', session_id: 's1' },\n      { name: 'click', timestamp: '2024-01-16T09:00:00Z', session_id: 's2' },\n      { name: 'pv',    timestamp: '2024-01-16T10:00:00Z', session_id: 's2' },\n      { name: 'pv',    timestamp: '2024-01-17T10:00:00Z' },\n    ]});\n    const steps = ['pv', 'click', 'buy'];\n    const bySession = await A(request(app).post('/query/funnel')).send({ steps });\n    expect(bySession.body.group_by).toBe('session');\n    expect(bySession.body.steps.map((s: {count:number}) => s.count)).toEqual([2, 1, 1]);\n\n    const byUser = await A(request(app).post('/query/funnel')).send({ steps, group_by: 'user' });\n    expect(byUser.body.steps.map((s: {count:number}) => s.count)).toEqual([1, 1, 1]);\n\n    expect((await A(request(app).post('/query/funnel')).send({ steps, group_by: 'device' })).status).toBe(400);\n  });\n\n  it('neutralizes CSV formula injection but keeps negative numbers intact', async () => {\n    const { token } = await reg('c@x.com', 'T');\n    const A = (r: request.Test) => r.set('Authorization', `Bearer ${token}`);\n    await A(request(app).post('/events')).send({ name: '=cmd|calc', properties: { v: -5 } });\n    const csv = await A(request(app).get('/export/events?format=csv'));\n    expect(csv.text).toContain(\"'=cmd|calc\");\n    expect(csv.text).toContain('-5');\n    expect(csv.text.split('\\n')).toHaveLength(2);\n  });\n\n  it('reads the canonical schema.sql from disk', async () => {\n    const idx = db.prepare(\"SELECT name FROM sqlite_master WHERE type='index' AND name='idx_widgets_dashboard'\").get();\n    expect(idx).toBeDefined();\n  });\n});\nEOF\nnpx vitest run tests/__verify.test.ts 2>&1 | tail -30","description":"Verify each review fix"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_t