nts grouped by a property value. */\nrouter.post('/breakdown', (req, res) => {\n  const auth = getAuthUser(req);\n  const body = asObject(req.body);\n  const eventName = requireString(body, 'event_name');\n  const propertyKey = requireString(body, 'property_key');\n  const limit = optionalPositiveInt(body, 'limit', DEFAULT_BREAKDOWN_LIMIT, MAX_BREAKDOWN_LIMIT);\n\n  const data = breakdown({ ...baseFilter(body, auth.tenantId), eventName }, propertyKey, limit);\n  res.status(200).json({ event_name: eventName, property_key: propertyKey, data });\n});\n\n/** POST /query/funnel — ordered multi-step conversion analysis. */\nrouter.post('/funnel', (req, res) => {\n  const auth = getAuthUser(req);\n  const body = asObject(req.body);\n\n  const rawSteps = body.steps;\n  if (!Array.isArray(rawSteps) || rawSteps.length < 2) {\n    throw badRequest('steps is required and must be an array of at least 2 event names');\n  }\n  if (rawSteps.length > MAX_FUNNEL_STEPS) {\n    throw badRequest(`steps may contain at most ${MAX_FUNNEL_STEPS} event names`);\n  }\n  const steps = rawSteps.map((step, index) => {\n    if (typeof step !== 'string' || step.trim() === '') {\n      throw badRequest(`steps[${index}] must be a non-empty string`);\n    }\n    return step.trim();\n  });\n\n  res.status(200).json({ steps: funnel(baseFilter(body, auth.tenantId), steps) });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1291,"cache_read_input_tokens":68771,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1291},"output_tokens":68,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"cf228aa1-b873-4452-b0ca-5ef63d0c9890","uuid":"1f9b74bf-7102-44ed-9f43-abecd698f032","request_id":"req_011CdMvFvn6TzyXaXdT7d5pz"}
