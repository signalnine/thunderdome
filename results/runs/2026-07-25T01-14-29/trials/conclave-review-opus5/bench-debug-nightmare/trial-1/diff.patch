+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Si3bJ6iQc78LvtNbhFmfAn","type":"tool_result","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/events/bus.js';\nimport { OrderRepository } from '../src/orders/repository.js';\nimport { OrderService } from '../src/orders/service.js';\nimport { InventoryRepository } from '../src/inventory/repository.js';\nimport { InventoryService } from '../src/inventory/service.js';\nimport { NotificationService } from '../src/notifications/service.js';\nimport { BillingService } from '../src/billing/service.js';\nimport { calculateOrderTotal } from '../src/billing/calculator.js';\n\n// ============================================================\n// Hidden validation tests — catch naive fixes and verify\n// root-cause fixes across different scenarios.\n// ============================================================\n\ndescribe('Validation: EventBus isolation', () => {\n  // These tests MUST run in sequence to verify cross-test isolation.\n  // If handlers leak between EventBus instances, the second test fails.\n\n  it('first bus instance registers handlers independently', async () => {\n    const bus1 = new EventBus();\n    const received: string[] = [];\n    bus1.on('test', () => { received.push('bus1'); });\n    await bus1.emit('test', {});\n    expect(received).toEqual(['bus1']);\n  });\n\n  it('second bus instance has no handlers from first', async () => {\n    const bus2 = new EventBus();\n    const received: string[] = [];\n    bus2.on('test', () => { received.push('bus2'); });\n    await bus2.emit('test', {});\n    // If global handlers leak, this would be ['bus1', 'bus2']\n    expect(received).toEqual(['bus2']);\n  });\n\n  it('clearing one bus does not affect another', async () => {\n    const busA = new EventBus();\n    const busB = new EventBus();\n    busA.on('x', () => {});\n    busB.on('x', () => {});\n    busA.clear();\n    // busB should still have its handler\n    let called = false;\n    busB.on('y', () => { called = true; });\n    await busB.emit('y', {});\n    expect(called).toBe(true);\n  });\n});\n\ndescribe('Validation: Calculator rounding edge cases', () => {\n  it('handles $19.99 at 12% discount and 6% tax', () => {\n    const result = calculateOrderTotal(\n      [{ productId: 'A', quantity: 1, unitPrice: 19.99 }],\n      12,\n      0.06\n    );\n    // subtotal = 19.99\n    // discount = 19.99 * 0.12 = 2.3988\n    // after discount = 17.5912\n    // tax = 17.5912 * 0.06 = 1.055472\n    // total = 18.646672 -> 18.65\n    expect(result.total).toBe(18.65);\n  });\n\n  it('handles $7.77 at 33% discount and 9.5% tax', () => {\n    const result = calculateOrderTotal(\n      [{ productId: 'A', quantity: 3, unitPrice: 7.77 }],\n      33,\n      0.095\n    );\n    // subtotal = 23.31\n    // discount = 23.31 * 0.33 = 7.6923\n    // after discount = 15.6177\n    // tax = 15.6177 * 0.095 = 1.4836815\n    // total = 17.1013815 -> 17.10\n    expect(result.total).toBe(17.10);\n  });\n\n  it('handles exact penny amounts correctly', () => {\n    const result = calculateOrderTotal(\n      [{ productId: 'A', quantity: 1, unitPrice: 10.05 }],\n      50,\n      0.10\n    );\n    // subtotal = 10.05\n    // discount = 10.05 * 0.50 = 5.025\n    // after discount = 5.025\n    // tax = 5.025 * 0.10 = 0.5025\n    // total = 5.5275 -> 5.53\n    expect(result.total).toBe(5.53);\n  });\n});\n\ndescribe('Validation: Order cancellation and stock release', () => {\n  let bus: EventBus;\n  let orderRepo: OrderRepository;\n  let inventoryRepo: InventoryRepository;\n  let inventoryService: InventoryService;\n  let notifications: NotificationService;\n  let billing: BillingService;\n  let orderService: OrderService;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    orderRepo = new OrderRepository();\n    inventoryRepo = new InventoryRepository();\n    inventoryService = new InventoryService(inventoryRepo, bus);\n    notifications = new NotificationService();\n    billing = new BillingService(bus, notifications);\n    inventoryService.registerHandlers();\n    billing.registerHandlers();\n    orderService = new OrderService(orderRepo, bus, billing);\n  });\n\n  it('cancel releases all items for multi-item order', async () => {\n    inventoryService.setStock('A', 10);\n    inventoryService.setStock('B', 20);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'A', quantity: 3, unitPrice: 10 },\n      { productId: 'B', quantity: 5, unitPrice: 20 },\n    ]);\n    await orderService.cancelOrder('O1', 'not needed');\n    expect(inventoryService.getStock('A')?.available).toBe(10);\n    expect(inventoryService.getStock('A')?.reserved).toBe(0);\n    expect(inventoryService.getStock('B')?.available).toBe(20);\n    expect(inventoryService.getStock('B')?.reserved).toBe(0);\n  });\n\n  it('cancel then create reuses released stock', async () => {\n    inventoryService.setStock('A', 5);\n    await orderService.createOrder('O1', 'C1', [\n      { productId: 'A', quantity: 5, unitPrice: 10 },\n    ]);\n    await orderService.cancelOrder('O1', 'mistake');\n    // Should be able to create another order using the same stock\n    const order2 = await orderService.createOrder('O2', 'C1', [\n      { productId: 'A', quantity: 4, unitPrice: 10 },\n    ]);\n    expect(order2.status).toBe('confirmed');\n    expect(inventoryService.getStock('A')?.available).toBe(1);\n  });\n\n  it('preserves order data through status transitions', async () => {\n    inventoryService.setStock('A', 10);\n    const order = await orderService.createOrder('O1', 'C1', [\n      { productId: 'A', quantity: 2, unitPrice: 25 },\n    ]);\n    expect(order.customerId).toBe('C1');\n    expect(order.items).toHaveLength(1);\n    expect(order.items[0].unitPrice).toBe(25);\n\n    const cancelled = await orderService.cancelOrder('O1', 'reason');\n    expect(cancelled?.customerId).toBe('C1');\n    expect(cancelled?.items).toH