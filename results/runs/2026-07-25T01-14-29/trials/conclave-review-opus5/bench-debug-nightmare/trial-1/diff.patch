t    const event = data as OrderCreatedEvent;\n    18\t    const reservations: Array<{ productId: string; quantity: number }> = [];\n    19\t\n    20\t    for (const item of event.items) {\n    21\t      const success = this.repo.reserve(item.productId, item.quantity);\n    22\t      if (!success) {\n    23\t        // Rollback previous reservations\n    24\t        for (const res of reservations) {\n    25\t          this.repo.release(res.productId, res.quantity);\n    26\t        }\n    27\t        throw new Error(\n    28\t          `Insufficient stock for product ${item.productId}`\n    29\t        );\n    30\t      }\n    31\t      reservations.push({ productId: item.productId, quantity: item.quantity });\n    32\t    }\n    33\t\n    34\t    await this.eventBus.emit(ORDER_EVENTS.STOCK_RESERVED, {\n    35\t      orderId: event.orderId,\n    36\t      items: reservations,\n    37\t      timestamp: Date.now(),\n    38\t    });\n    39\t  }\n    40\t\n    41\t  private async handleOrderCancelled(data: unknown): Promise<void> {\n    42\t    const event = data as OrderCancelledEvent;\n    43\t    // Release reserved stock — look up original order items from the event\n    44\t    // The order service attaches items to the cancellation event\n    45\t    const eventWithItems = data as OrderCancelledEvent & {\n    46\t      items?: Array<{ productId: string; quantity: number }>;\n    47\t      status?: string;\n    48\t    };\n    49\t\n    50\t    if (eventWithItems.status !== 'cancelled') return;\n    51\t\n    52\t    if (eventWithItems.items) {\n    53\t      for (const item of eventWithItems.items) {\n    54\t        this.repo.release(item.productId, item.quantity);\n    55\t      }\n    56\t    }\n    57\t\n    58\t    await this.eventBus.emit(ORDER_EVENTS.STOCK_RELEASED, {\n    59\t      orderId: event.orderId,\n    60\t      timestamp: Date.now(),\n    61\t    });\n    62\t  }\n    63\t\n    64\t  setStock(productId: string, quantity: number): void {\n    65\t    this.repo.setStock(productId, quantity);\n    66\t  }\n    67\t\n    68\t  getStock(productId: string) {\n    69\t    return this.repo.getStock(productId);\n    70\t  }\n    71\t}\n=== src/inventory/repository.ts ===\n     1\texport interface StockRecord {\n     2\t  productId: string;\n     3\t  available: number;\n     4\t  reserved: number;\n     5\t}\n     6\t\n     7\texport class InventoryRepository {\n     8\t  private store: Map<string, StockRecord> = new Map();\n     9\t\n    10\t  setStock(productId: string, available: number): void {\n    11\t    const existing = this.store.get(productId);\n    12\t    this.store.set(productId, {\n    13\t      productId,\n    14\t      available,\n    15\t      reserved: existing?.reserved ?? 0,\n    16\t    });\n    17\t  }\n    18\t\n    19\t  getStock(productId: string): StockRecord | undefined {\n    20\t    const record = this.store.get(productId);\n    21\t    return record ? { ...record } : undefined;\n    22\t  }\n    23\t\n    24\t  reserve(productId: string, quantity: number): boolean {\n    25\t    const record = this.store.get(productId);\n    26\t    if (!record || record.available < quantity) return false;\n    27\t    record.available -= quantity;\n    28\t    record.reserved += quantity;\n    29\t    return true;\n    30\t  }\n    31\t\n    32\t  release(productId: string, quantity: number): boolean {\n    33\t    const record = this.store.get(productId);\n    34\t    if (!record || record.reserved < quantity) return false;\n    35\t    record.reserved -= quantity;\n    36\t    record.available += quantity;\n    37\t    return true;\n    38\t  }\n    39\t\n    40\t  clear(): void {\n    41\t    this.store.clear();\n    42\t  }\n    43\t}\n=== src/events/bus.ts ===\n     1\texport type EventHandler = (data: unknown) => void | Promise<void>;\n     2\t\n     3\t// Module-level handler registry — shared across all EventBus instances\n     4\tconst globalHandlers: Map<string, EventHandler[]> = new Map();\n     5\t\n     6\texport class EventBus {\n     7\t  on(event: string, handler: EventHandler): void {\n     8\t    const existing = globalHandlers.get(event) ?? [];\n     9\t    existing.push(handler);\n    10\t    globalHandlers.set(event, existing);\n    11\t  }\n    12\t\n    13\t  off(event: string, handler: EventHandler): void {\n    14\t    const existing = globalHandlers.get(event);\n    15\t    if (!existing) return;\n    16\t    globalHandlers.set(\n    17\t      event,\n    18\t      existing.filter((h) => h !== handler)\n    19\t    );\n    20\t  }\n    21\t\n    22\t  async emit(event: string, data: unknown): Promise<void> {\n    23\t    const handlers = globalHandlers.get(event) ?? [];\n    24\t    for (const handler of handlers) {\n    25\t      await handler(data);\n    26\t    }\n    27\t  }\n    28\t\n    29\t  clear(): void {\n    30\t    globalHandlers.clear();\n    31\t  }\n    32\t}\n=== src/events/types.ts ===\n     1\texport interface OrderEvent {\n     2\t  orderId: string;\n     3\t  timestamp: number;\n     4\t}\n     5\t\n     6\texport interface OrderCreatedEvent extends OrderEvent {\n     7\t  items: Array<{ productId: string; quantity: number; unitPrice: number }>;\n     8\t  customerId: string;\n     9\t}\n    10\t\n    11\texport interface OrderCancelledEvent extends OrderEvent {\n    12\t  reason: string;\n    13\t}\n    14\t\n    15\texport interface OrderRefundedEvent extends OrderEvent {\n    16\t  amount: number;\n    17\t}\n    18\t\n    19\texport interface PaymentChargedEvent extends OrderEvent {\n    20\t  amount: number;\n    21\t  paymentMethod: string;\n    22\t}\n    23\t\n    24\texport interface StockReservedEvent extends OrderEvent {\n    25\t  items: Array<{ productId: string; quantity: number }>;\n    26\t}\n    27\t\n    28\texport const ORDER_EVENTS = {\n    29\t  CREATED: 'order.created',\n    30\t  CONFIRMED: 'order.confirmed',\n    31\t  CANCELLED: 'order.cancelled',\n    32\t  REFUNDED: 'order.refunded',\n    33\t  PAYMENT_CHARGED: 'order.payment.charged',\n    34\t  STOCK_RESERVED: 'order.stock.reserved',\n    35\t  STOCK_RELEASED: 'order.stock.released',\n    36\t  NOTIFICATION_SENT: 'order.notification.sent',\n    37\t} as const;\n=== src/billing/service.ts ===\n     1\timport { EventBus } from '../events/bus.js';\n     2\timport { ORDER_EVENTS } from '../events/types.js';\n     3\timport { NotificationService } from '../notifications/service.js';\n     4\timport { calculateOrderTotal } from './calculator.js';\n     5\timport { OrderItem } from '../orders/repository.js';\n     6\t\n     7\texport interface PaymentRecord {\n     8\t  orderId: string;\n     9\t  amount: number;\n    10\t  method: string;\n    11\t  status: 'charged' | 'refunded';\n    12\t  processedAt: number;\n    13\t}\n    14\t\n    15\texport class BillingService {\n    16\t  private payments: Map<string, PaymentRecord> = new Map();\n    17\t\n    18\t  constructor(\n    19\t    private eventBus: EventBus,\n    20\t    private notificationService: NotificationService\n    21\t  ) {}\n    22\t\n    23\t  registerHandlers(): void {\n    24\t    this.eventBus.on(ORDER_EVENTS.STOCK_RESERVED, this.handleStockReserved.bind(this));\n    25\t    this.eventBus.on(ORDER_EVENTS.REFUNDED, this.handleRefund);\n    26\t  }\n    27\t\n    28\t  private async handleStockReserved(data: unknown): Promise<void> {\n    29\t    const event = data as { orderId: string; items: OrderItem[] };\n    30\t    // Payment would be charged here in a real system\n    31\t    await this.eventBus.emit(ORDER_EVENTS.PAYMENT_CHARGED, {\n    32\t      orderId: event.orderId,\n    33\t      amount: 0, // Actual amount set by order service\n    34\t      paymentMethod: 'card',\n    35\t      timestamp: Date.now(),\n    36\t    });\n    37\t  }\n    38\t\n    39\t  async chargePayment(\n    40\t    orderId: string,\n    41\t    items: OrderItem[],\n    42\t    discountPercent: number,\n    43\t    taxRate: number,\n    44\t    paymentMethod: string\n    45\t  ): Promise<PaymentRecord> {\n    46\t    const breakdown = calculateOrderTotal(items, discountPercent, taxRate);\n    47\t\n    48\t    const record: PaymentRecord = {\n    49\t      orderId,\n    50\t      amount: breakdown.total,\n    51\t      method: paymentMethod,\n    52\t      status: 'charged',\n    53\t      processedAt: Date.now(),\n    54\t    };\n    55\t\n    56\t    this.payments.set(orderId, record);\n    57\t    this.notificationService.sendConfirmation(orderId, breakdown.total);\n    58\t    return record;\n    59\t  }\n    60\t\n    61\t  private async handleRefund(data: unknown): Promise<void> {\n    62\t    const event = data as { orderId: string; amount: number };\n    63\t    const payment = this.payments.get(event.orderId);\n    64\t    if (payment) {\n    65\t      payment.status = 'refunded';\n    66\t      this.notificationService.sendRefundNotice(event.orderId, event.amount);\n    67\t    }\n    68\t  }\n    69\t\n    70\t  async issueRefund(orderId: string, amount: number): Promise<PaymentRecord | undefined> {\n    71\t    const payment = this.payments.get(orderId);\n    72\t    if (!payment) return undefined;\n    73\t\n    74\t    payment.status = 'refunded';\n    75\t\n    76\t    await this.eventBus.emit(ORDER_EVENTS.REFUNDED, {\n    77\t      orderId,\n    78\t      amount,\n    79\t      timestamp: Date.now(),\n    80\t    });\n    81\t\n    82\t    return { ...payment };\n    83\t  }\n    84\t\n    85\t  getPayment(orderId: string): PaymentRecord | undefined {\n    86\t    const p = this.payments.get(orderId);\n    87\t    return p ? { ...p } : undefined;\n    88\t  }\n    89\t\n    90\t  clear(): void {\n    91\t    this.payments.clear();\n    92\t  }\n    93\t}\n=== src/billing/calculator.ts ===\n     1\timport { OrderItem } from '../orders/repository.js';\n     2\t\n     3\texport interface PriceBreakdown {\n     4\t  subtotal: number;\n     5\t  discountAmount: number;\n     6\t  taxAmount: number;\n     7\t  total: number;\n     8\t}\n     9\t\n    10\texport function calculateOrderTotal(\n    11\t  items: OrderItem[],\n    12\t  discountPercent: number,\n    13\t  taxRate: number\n    14\t): PriceBreakdown {\n    15\t  const subtotal = items.reduce(\n    16\t    (sum, item) => sum + item.unitPrice * item.quantity,\n    17\t    0\n    18\t  );\n    19\t\n    20\t  const discountAmount = Math.round(subtotal * (discountPercent / 100) * 100) / 100;\n    21\t  const afterDiscount = Math.round((subtotal - discountAmount) * 100) / 100;\n    22\t  const taxAmount = Math.round(afterDiscount * taxRate * 100) / 100;\n    23\t  const total = afterDiscount + taxAmount;\n    24\t\n    25\t  return {\n    26\t    subtotal: Math.round(subtotal * 100) / 100,\n    27\t    discountAmount: Math.round(discountAmount * 100) / 100,\n    28\t    taxAmount: Math.round(taxAmount * 100) / 100,\n    29\t    total,\n    30\t  };\n    31\t}\n=== src/orders/service.ts ===\n     1\timport { EventBus } from '../events/bus.js';\n     2\timport { ORDER_EVENTS, OrderCreatedEvent } from '../events/types.js';\n     3\timport { OrderRepository, Order, OrderItem } from './repository.js';\n     4\timport { BillingService } from '../billing/service.js';\n     5\t\n     6\tconst REFUND_WINDOW_DAYS = 30;\n     7\t\n     8\texport class OrderService {\n     9\t  constructor(\n    10\t    private repo: OrderRepository,\n    11\t    private eventBus: EventBus,\n    12\t    private billingService: BillingService\n    13\t  ) {}\n    14\t\n    15\t  async createOrder(\n    16\t    id: string,\n    17\t    customerId: string,\n    18\t    items: OrderItem[],\n    19\t    discount: number = 0,\n    20\t    taxRate: number = 0.1\n    21\t  ): Promise<Order> {\n    22\t    this.repo.create({\n    23\t      id,\n    24\t      customerId,\n    25\t      items: [...items],\n    26\t      status: 'pending',\n    27\t      total: 0,\n    28\t      discount,\n    29\t      taxRate,\n    30\t      createdAt: Date.now(),\n    31\t      updatedAt: Date.now(),\n    32\t    });\n    33\t\n    34\t    const event: OrderCreatedEvent = {\n    35\t      orderId: id,\n    36\t      items: items.map((i) => ({\n    37\t        productId: i.productId,\n    38\t        quantity: i.quantity,\n    39\t        unitPrice: i.unitPrice,\n    40\t      })),\n    41\t      customerId,\n    42\t      timestamp: Date.now(),\n    43\t    };\n    44\t\n    45\t    await this.eventBus.emit(ORDER_EVENTS.CREATED, event);\n    46\t\n    47\t    // Charge payment and confirm\n    48\t    const payment = await this.billingService.chargePayment(\n    49\t      id,\n    50\t      items,\n    51\t      discount,\n    52\t      taxRate,\n    53\t      'card'\n    54\t    );\n    55\t\n    56\t    this.repo.update(id, {\n    57\t      status: 'confirmed',\n    58\t      total: payment.amount,\n    59\t    });\n    60\t\n    61\t    await this.eventBus.emit(ORDER_EVENTS.CONFIRMED, {\n    62\t      orderId: id,\n    63\t      timestamp: Date.now(),\n    64\t    });\n    65\t\n    66\t    return this.repo.findById(id)!;\n    67\t  }\n    68\t\n    69\t  async cancelOrder(id: string, reason: string): Promise<Order | undefined> {\n    70\t    const order = this.repo.findById(id);\n    71\t    if (!order) return undefined;\n    72\t    if (order.status !== 'confirmed') return undefined;\n    73\t\n    74\t    // Emit cancellation event, then update status\n    75\t    await this.eventBus.emit(ORDER_EVENTS.CANCELLED, {\n    76\t      orderId: id,\n    77\t      reason,\n    78\t      items: order.items.map((i) => ({\n    79\t        productId: i.productId,\n    80\t        quantity: i.quantity,\n    81\t      })),\n    82\t      timestamp: Date.now(),\n    83\t    });\n    84\t\n    85\t    this.repo.update(id, { status: 'cancelled' });\n    86\t\n    87\t    return this.repo.findById(id);\n    88\t  }\n    89\t\n    90\t  async refundOrder(id: string): Promise<Order | undefined> {\n    91\t    const order = this.repo.findById(id);\n    92\t    if (!order) return undefined;\n    93\t    if (order.status !== 'cancelled') return undefined;\n    94\t\n    95\t    const daysSinceCreation = Math.floor(\n    96\t      (Date.now() - order.createdAt) / (1000 * 60 * 60 * 24)\n    97\t    );\n    98\t\n    99\t    if (daysSinceCreation >= REFUND_WINDOW_DAYS) {\n   100\t      throw new Error(\n   101\t        `Refund window expired: ${daysSinceCreation} days since order (max ${REFUND_WINDOW_DAYS})`\n   102\t      );\n   103\t    }\n   104\t\n   105\t    await this.billingService.issueRefund(id, order.total);\n   106\t    this.repo.update(id, { status: 'refunded' });\n   107\t\n   108\t    return this.repo.findById(id);\n   109\t  }\n   110\t\n   111\t  getOrder(id: string): Order | undefined {\n   112\t    return this.repo.findById(id);\n   113\t  }\n   114\t\n   115\t  getOrdersByCustomer(customerId: string): Order[] {\n   116\t    return this.repo.findByCustomer(customerId);\n   117\t  }\n   118\t}\n=== src/orders/repository.ts ===\n     1\texport type OrderStatus = 'pending' | 'confirmed' | 'cancelled' | 'refunded';\n     2\t\n     3\texport interface OrderItem {\n     4\t  productId: string;\n     5\t  quantity: number;\n     6\t  unitPrice: number;\n     7\t}\n     8\t\n     9\texport interface Order {\n    10\t  id: string;\n    11\t  customerId: string;\n    12\t  items: OrderItem[];\n    13\t  status: OrderStatus;\n    14\t  total: number;\n    15\t  discount: number;\n    16\t  taxRate: number;\n    17\t  createdAt: number;\n    18\t  updatedAt: number;\n    19\t  notes?: string;\n    20\t}\n    21\t\n    22\texport class OrderRepository {\n    23\t  private store: Map<string, Order> = new Map();\n    24\t\n    25\t  create(order: Order): Order {\n    26\t    this.store.set(order.id, { ...order });\n    27\t    return { ...order };\n    28\t  }\n    29\t\n    30\t  findById(id: string): Order | undefined {\n    31\t    const order = this.store.get(id);\n    32\t    return order ? { ...order