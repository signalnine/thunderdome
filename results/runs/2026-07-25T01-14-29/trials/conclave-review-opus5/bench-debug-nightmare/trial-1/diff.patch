55\t  clear(): void {\n    56\t    this.store.clear();\n    57\t  }\n    58\t}\n=== src/orders/service.ts ===\n     1\timport { EventBus } from '../events/bus.js';\n     2\timport { ORDER_EVENTS, OrderCreatedEvent } from '../events/types.js';\n     3\timport { OrderRepository, Order, OrderItem } from './repository.js';\n     4\timport { BillingService } from '../billing/service.js';\n     5\t\n     6\tconst REFUND_WINDOW_DAYS = 30;\n     7\t\n     8\texport class OrderService {\n     9\t  constructor(\n    10\t    private repo: OrderRepository,\n    11\t    private eventBus: EventBus,\n    12\t    private billingService: BillingService\n    13\t  ) {}\n    14\t\n    15\t  async createOrder(\n    16\t    id: string,\n    17\t    customerId: string,\n    18\t    items: OrderItem[],\n    19\t    discount: number = 0,\n    20\t    taxRate: number = 0.1\n    21\t  ): Promise<Order> {\n    22\t    this.repo.create({\n    23\t      id,\n    24\t      customerId,\n    25\t      items: [...items],\n    26\t      status: 'pending',\n    27\t      total: 0,\n    28\t      discount,\n    29\t      taxRate,\n    30\t      createdAt: Date.now(),\n    31\t      updatedAt: Date.now(),\n    32\t    });\n    33\t\n    34\t    const event: OrderCreatedEvent = {\n    35\t      orderId: id,\n    36\t      items: items.map((i) => ({\n    37\t        productId: i.productId,\n    38\t        quantity: i.quantity,\n    39\t        unitPrice: i.unitPrice,\n    40\t      })),\n    41\t      customerId,\n    42\t      timestamp: Date.now(),\n    43\t    };\n    44\t\n    45\t    await this.eventBus.emit(ORDER_EVENTS.CREATED, event);\n    46\t\n    47\t    // Charge payment and confirm\n    48\t    const payment = await this.billingService.chargePayment(\n    49\t      id,\n    50\t      items,\n    51\t      discount,\n    52\t      taxRate,\n    53\t      'card'\n    54\t    );\n    55\t\n    56\t    this.repo.update(id, {\n    57\t      status: 'confirmed',\n    58\t      total: payment.amount,\n    59\t    });\n    60\t\n    61\t    await this.eventBus.emit(ORDER_EVENTS.CONFIRMED, {\n    62\t      orderId: id,\n    63\t      timestamp: Date.now(),\n    64\t    });\n    65\t\n    66\t    return this.repo.findById(id)!;\n    67\t  }\n    68\t\n    69\t  async cancelOrder(id: string, reason: string): Promise<Order | undefined> {\n    70\t    const order = this.repo.findById(id);\n    71\t    if (!order) return undefined;\n    72\t    if (order.status !== 'confirmed') return undefined;\n    73\t\n    74\t    // Update status BEFORE emitting event so handlers see correct state\n    75\t    this.repo.update(id, { status: 'cancelled' });\n    76\t\n    77\t    await this.eventBus.emit(ORDER_EVENTS.CANCELLED, {\n    78\t      orderId: id,\n    79\t      reason,\n    80\t      status: 'cancelled',\n    81\t      items: order.items.map((i) => ({\n    82\t        productId: i.productId,\n    83\t        quantity: i.quantity,\n    84\t      })),\n    85\t      timestamp: Date.now(),\n    86\t    });\n    87\t\n    88\t    return this.repo.findById(id);\n    89\t  }\n    90\t\n    91\t  async refundOrder(id: string): Promise<Order | undefined> {\n    92\t    const order = this.repo.findById(id);\n    93\t    if (!order) return undefined;\n    94\t    if (order.status !== 'cancelled') return undefined;\n    95\t\n    96\t    const daysSinceCreation = Math.floor(\n    97\t      (Date.now() - order.createdAt) / (1000 * 60 * 60 * 24)\n    98\t    );\n    99\t\n   100\t    if (daysSinceCreation > REFUND_WINDOW_DAYS) {\n   101\t      throw new Error(\n   102\t        `Refund window expired: ${daysSinceCreation} days since order (max ${REFUND_WINDOW_DAYS})`\n   103\t      );\n   104\t    }\n   105\t\n   106\t    await this.billingService.issueRefund(id, order.total);\n   107\t    this.repo.update(id, { status: 'refunded' });\n   108\t\n   109\t    return this.repo.findById(id);\n   110\t  }\n   111\t\n   112\t  getOrder(id: string): Order | undefined {\n   113\t    return this.repo.findById(id);\n   114\t  }\n   115\t\n   116\t  getOrdersByCustomer(customerId: string): Order[] {\n   117\t    return this.repo.findByCustomer(customerId);\n   118\t  }\n   119\t}","is_error":false}]},"parent_tool_use_id":"toolu_01EfyRKAQtPN35YdCvULC8vK","session_id":"9f40e8c6-f577-4e76-ac46-daeab6907e97","uuid":"250e8a20-bd8a-43fc-91a7-b6de66159841","timestamp":"2026-07-25T01:52:50.142Z","subagent_type":"general-purpose","task_description":"Adversarial hidden-test audit"}
