+{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CdMwXiPH5ofz6PUUBSFE3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XnMWy73jy3sFx8xr9Jv8kX","name":"Write","input":{"file_path":"/workspace/.audit-scratch/probe.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/events/bus.js';\nimport { OrderRepository } from '../src/orders/repository.js';\nimport { OrderService } from '../src/orders/service.js';\nimport { InventoryRepository } from '../src/inventory/repository.js';\nimport { InventoryService } from '../src/inventory/service.js';\nimport { NotificationService } from '../src/notifications/service.js';\nimport { BillingService } from '../src/billing/service.js';\nimport { calculateOrderTotal } from '../src/billing/calculator.js';\nimport { ORDER_EVENTS } from '../src/events/types.js';\n\nfunction wire() {\n  const bus = new EventBus();\n  const orderRepo = new OrderRepository();\n  const inventoryRepo = new InventoryRepository();\n  const inventoryService = new InventoryService(inventoryRepo, bus);\n  const notifications = new NotificationService();\n  const billing = new BillingService(bus, notifications);\n  inventoryService.registerHandlers();\n  billing.registerHandlers();\n  const orderService = new OrderService(orderRepo, bus, billing);\n  return { bus, orderRepo, inventoryRepo, inventoryService, notifications, billing, orderService };\n}\n\ndescribe('P1: createOrder failure atomicity', () => {\n  it('order NOT confirmed when stock insufficient', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 1);\n    let threw = false;\n    try {\n      await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 5, unitPrice: 10 }]);\n    } catch { threw = true; }\n    expect(threw).toBe(true);\n    const o = s.orderService.getOrder('O1');\n    expect(o?.status).not.toBe('confirmed');\n  });\n\n  it('no payment recorded when stock insufficient', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 1);\n    try {\n      await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 5, unitPrice: 10 }]);\n    } catch { /* ignore */ }\n    expect(s.billing.getPayment('O1')).toBeUndefined();\n  });\n\n  it('no confirmation notification when stock insufficient', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 1);\n    try {\n      await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 5, unitPrice: 10 }]);\n    } catch { /* ignore */ }\n    expect(s.notifications.getSentNotifications()).toHaveLength(0);\n  });\n\n  it('unknown product id fails order', async () => {\n    const s = wire();\n    let threw = false;\n    try {\n      await s.orderService.createOrder('O1', 'C1', [{ productId: 'NOPE', quantity: 1, unitPrice: 10 }]);\n    } catch { threw = true; }\n    expect(threw).toBe(true);\n  });\n});\n\ndescribe('P2: event emission / ordering', () => {\n  it('emits created, stock.reserved, payment.charged, confirmed in order', async () => {\n    const s = wire();\n    const seen: string[] = [];\n    for (const e of Object.values(ORDER_EVENTS)) {\n      s.bus.on(e, () => { seen.push(e); });\n    }\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    expect(seen).toEqual([\n      ORDER_EVENTS.CREATED,\n      ORDER_EVENTS.STOCK_RESERVED,\n      ORDER_EVENTS.PAYMENT_CHARGED,\n      ORDER_EVENTS.CONFIRMED,\n    ]);\n  });\n\n  it('payment.charged carries the real amount', async () => {\n    const s = wire();\n    let amt: unknown;\n    s.bus.on(ORDER_EVENTS.PAYMENT_CHARGED, (d) => { amt = (d as { amount: number }).amount; });\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 2, unitPrice: 25 }]);\n    expect(amt).toBe(55);\n  });\n\n  it('emits order.cancelled on cancel', async () => {\n    const s = wire();\n    let fired = false;\n    s.bus.on(ORDER_EVENTS.CANCELLED, () => { fired = true; });\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    expect(fired).toBe(true);\n  });\n\n  it('emits order.refunded on refund', async () => {\n    const s = wire();\n    let fired = false;\n    s.bus.on(ORDER_EVENTS.REFUNDED, () => { fired = true; });\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.refundOrder('O1');\n    expect(fired).toBe(true);\n  });\n\n  it('emits stock.released on cancel', async () => {\n    const s = wire();\n    let fired = false;\n    s.bus.on(ORDER_EVENTS.STOCK_RELEASED, () => { fired = true; });\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    expect(fired).toBe(true);\n  });\n\n  it('handler sees cancelled status in repo when cancelled event fires', async () => {\n    const s = wire();\n    let statusAtEvent: string | undefined;\n    s.bus.on(ORDER_EVENTS.CANCELLED, () => {\n      statusAtEvent = s.orderService.getOrder('O1')?.status;\n    });\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    expect(statusAtEvent).toBe('cancelled');\n  });\n\n  it('handler sees confirmed status when confirmed event fires', async () => {\n    const s = wire();\n    let statusAtEvent: string | undefined;\n    s.bus.on(ORDER_EVENTS.CONFIRMED, () => {\n      statusAtEvent = s.orderService.getOrder('O1')?.status;\n    });\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    expect(statusAtEvent).toBe('confirmed');\n  });\n});\n\ndescribe('P3: cancellation notification', () => {\n  it('sends a cancellation notification when order is cancelled', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'changed mind');\n    const c = s.notifications.getSentNotifications().find((n) => n.type === 'cancellation');\n    expect(c).toBeDefined();\n  });\n});\n\ndescribe('P4: refund semantics', () => {\n  it('refund amount equals order total', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 2, unitPrice: 25 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.refundOrder('O1');\n    const n = s.notifications.getSentNotifications().find((x) => x.type === 'refund');\n    expect(n!.message).toContain('55.00');\n  });\n\n  it('payment status becomes refunded', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.refundOrder('O1');\n    expect(s.billing.getPayment('O1')?.status).toBe('refunded');\n  });\n\n  it('cannot refund a pending/confirmed order', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    expect(await s.orderService.refundOrder('O1')).toBeUndefined();\n  });\n\n  it('cannot refund twice', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.refundOrder('O1');\n    expect(await s.orderService.refundOrder('O1')).toBeUndefined();\n  });\n\n  it('double refund sends only one notification', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.refundOrder('O1');\n    await s.orderService.refundOrder('O1');\n    const refunds = s.notifications.getSentNotifications().filter((n) => n.type === 'refund');\n    expect(refunds).toHaveLength(1);\n  });\n\n  it('refunding unknown order returns undefined', async () => {\n    const s = wire();\n    expect(await s.orderService.refundOrder('NOPE')).toBeUndefined();\n  });\n\n  it('issueRefund on unknown order returns undefined and sends nothing', async () => {\n    const s = wire();\n    expect(await s.billing.issueRefund('NOPE', 10)).toBeUndefined();\n    expect(s.notifications.getSentNotifications()).toHaveLength(0);\n  });\n\n  it('issueRefund sends exactly one refund notification (not duplicated)', async () => {\n    const s = wire();\n    await s.billing.chargePayment('O1', [{ productId: 'A', quantity: 1, unitPrice: 50 }], 0, 0, 'card');\n    await s.billing.issueRefund('O1', 50);\n    const refunds = s.notifications.getSentNotifications().filter((n) => n.type === 'refund');\n    expect(refunds).toHaveLength(1);\n  });\n});\n\ndescribe('P5: cancellation guards', () => {\n  it('cancelling unknown order returns undefined', async () => {\n    const s = wire();\n    expect(await s.orderService.cancelOrder('NOPE', 'r')).toBeUndefined();\n  });\n\n  it('cancelling refunded order returns undefined', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.refundOrder('O1');\n    expect(await s.orderService.cancelOrder('O1', 'again')).toBeUndefined();\n  });\n\n  it('double cancel does not double-release stock', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 3, unitPrice: 10 }]);\n    await s.orderService.cancelOrder('O1', 'r');\n    await s.orderService.cancelOrder('O1', 'r2');\n    expect(s.inventoryService.getStock('A')?.available).toBe(10);\n  });\n});\n\ndescribe('P6: calculator edge cases', () => {\n  it('empty items => zeros', () => {\n    const r = calculateOrderTotal([], 10, 0.1);\n    expect(r.subtotal).toBe(0);\n    expect(r.total).toBe(0);\n  });\n\n  it('100% discount => total 0', () => {\n    const r = calculateOrderTotal([{ productId: 'A', quantity: 1, unitPrice: 100 }], 100, 0.1);\n    expect(r.total).toBe(0);\n  });\n\n  it('breakdown parts sum to total (0.1+0.2 style float)', () => {\n    const r = calculateOrderTotal([{ productId: 'A', quantity: 3, unitPrice: 0.1 }], 0, 0);\n    expect(r.subtotal).toBe(0.3);\n    expect(r.total).toBe(0.3);\n  });\n\n  it('subtotal - discount + tax == total', () => {\n    const r = calculateOrderTotal([{ productId: 'A', quantity: 3, unitPrice: 29.99 }], 15, 0.1);\n    expect(Math.round((r.subtotal - r.discountAmount + r.taxAmount) * 100) / 100).toBe(r.total);\n  });\n\n  it('large quantity precision', () => {\n    const r = calculateOrderTotal([{ productId: 'A', quantity: 1000, unitPrice: 19.99 }], 7.5, 0.0825);\n    // 19990 * 0.925 = 18490.75 ; tax = 1525.48... total = 20016.23...\n    expect(r.total).toBeCloseTo(20016.23, 2);\n  });\n\n  it('negative discount treated somehow (no crash)', () => {\n    const r = calculateOrderTotal([{ productId: 'A', quantity: 1, unitPrice: 100 }], -10, 0);\n    expect(typeof r.total).toBe('number');\n  });\n});\n\ndescribe('P7: inventory repo semantics', () => {\n  it('reserve fails for unknown product', () => {\n    const repo = new InventoryRepository();\n    expect(repo.reserve('X', 1)).toBe(false);\n  });\n\n  it('release fails when releasing more than reserved', () => {\n    const repo = new InventoryRepository();\n    repo.setStock('A', 10);\n    repo.reserve('A', 2);\n    expect(repo.release('A', 5)).toBe(false);\n    expect(repo.getStock('A')?.available).toBe(8);\n  });\n\n  it('getStock returns a copy (mutation does not leak)', () => {\n    const repo = new InventoryRepository();\n    repo.setStock('A', 10);\n    const s = repo.getStock('A')!;\n    s.available = 999;\n    expect(repo.getStock('A')?.available).toBe(10);\n  });\n\n  it('setStock preserves reserved count', () => {\n    const repo = new InventoryRepository();\n    repo.setStock('A', 10);\n    repo.reserve('A', 3);\n    repo.setStock('A', 20);\n    expect(repo.getStock('A')?.reserved).toBe(3);\n    expect(repo.getStock('A')?.available).toBe(20);\n  });\n\n  it('reserve exact available amount succeeds', () => {\n    const repo = new InventoryRepository();\n    repo.setStock('A', 5);\n    expect(repo.reserve('A', 5)).toBe(true);\n    expect(repo.getStock('A')?.available).toBe(0);\n  });\n\n  it('clear empties store', () => {\n    const repo = new InventoryRepository();\n    repo.setStock('A', 5);\n    repo.clear();\n    expect(repo.getStock('A')).toBeUndefined();\n  });\n});\n\ndescribe('P8: inventory rollback details', () => {\n  it('rollback restores second product too when third fails', async () => {\n    const bus = new EventBus();\n    const repo = new InventoryRepository();\n    const svc = new InventoryService(repo, bus);\n    svc.registerHandlers();\n    svc.setStock('A', 10);\n    svc.setStock('B', 10);\n    svc.setStock('C', 1);\n    try {\n      await bus.emit(ORDER_EVENTS.CREATED, {\n        orderId: 'O1',\n        items: [\n          { productId: 'A', quantity: 2, unitPrice: 1 },\n          { productId: 'B', quantity: 3, unitPrice: 1 },\n          { productId: 'C', quantity: 9, unitPrice: 1 },\n        ],\n        customerId: 'C1',\n        timestamp: Date.now(),\n      });\n    } catch { /* expected */ }\n    expect(repo.getStock('A')).toMatchObject({ available: 10, reserved: 0 });\n    expect(repo.getStock('B')).toMatchObject({ available: 10, reserved: 0 });\n    expect(repo.getStock('C')).toMatchObject({ available: 1, reserved: 0 });\n  });\n\n  it('no stock.reserved event emitted on failure', async () => {\n    const bus = new EventBus();\n    const repo = new InventoryRepository();\n    const svc = new InventoryService(repo, bus);\n    svc.registerHandlers();\n    let fired = false;\n    bus.on(ORDER_EVENTS.STOCK_RESERVED, () => { fired = true; });\n    svc.setStock('A', 1);\n    try {\n      await bus.emit(ORDER_EVENTS.CREATED, {\n        orderId: 'O1', items: [{ productId: 'A', quantity: 5, unitPrice: 1 }],\n        customerId: 'C1', timestamp: Date.now(),\n      });\n    } catch { /* expected */ }\n    expect(fired).toBe(false);\n  });\n\n  it('duplicate productId in same order aggregates correctly', async () => {\n    const bus = new EventBus();\n    const repo = new InventoryRepository();\n    const svc = new InventoryService(repo, bus);\n    svc.registerHandlers();\n    svc.setStock('A', 5);\n    await bus.emit(ORDER_EVENTS.CREATED, {\n      orderId: 'O1',\n      items: [\n        { productId: 'A', quantity: 3, unitPrice: 1 },\n        { productId: 'A', quantity: 2, unitPrice: 1 },\n      ],\n      customerId: 'C1', timestamp: Date.now(),\n    });\n    expect(repo.getStock('A')).toMatchObject({ available: 0, reserved: 5 });\n  });\n\n  it('cancelled event without status guard does not release', async () => {\n    const bus = new EventBus();\n    const repo = new InventoryRepository();\n    const svc = new InventoryService(repo, bus);\n    svc.registerHandlers();\n    svc.setStock('A', 10);\n    repo.reserve('A', 3);\n    // A plain OrderCancelledEvent (per types.ts) has NO status field\n    await bus.emit(ORDER_EVENTS.CANCELLED, {\n      orderId: 'O1',\n      reason: 'x',\n      items: [{ productId: 'A', quantity: 3 }],\n      timestamp: Date.now(),\n    });\n    expect(repo.getStock('A')?.available).toBe(10);\n  });\n});\n\ndescribe('P9: order repo semantics', () => {\n  it('findByStatus works', () => {\n    const repo = new OrderRepository();\n    repo.create({ id: 'O1', customerId: 'C1', items: [], status: 'pending', total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0 });\n    repo.create({ id: 'O2', customerId: 'C1', items: [], status: 'confirmed', total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0 });\n    expect(repo.findByStatus('confirmed')).toHaveLength(1);\n  });\n\n  it('update on missing order returns undefined', () => {\n    const repo = new OrderRepository();\n    expect(repo.update('NOPE', { status: 'confirmed' })).toBeUndefined();\n  });\n\n  it('create returns a copy; mutating result does not affect store', () => {\n    const repo = new OrderRepository();\n    const o = repo.create({ id: 'O1', customerId: 'C1', items: [], status: 'pending', total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0 });\n    o.status = 'cancelled';\n    expect(repo.findById('O1')?.status).toBe('pending');\n  });\n\n  it('items array is deep-isolated from caller', () => {\n    const repo = new OrderRepository();\n    const items = [{ productId: 'A', quantity: 1, unitPrice: 10 }];\n    repo.create({ id: 'O1', customerId: 'C1', items, status: 'pending', total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0 });\n    items[0].quantity = 999;\n    expect(repo.findById('O1')?.items[0].quantity).toBe(1);\n  });\n\n  it('update bumps updatedAt', async () => {\n    const repo = new OrderRepository();\n    repo.create({ id: 'O1', customerId: 'C1', items: [], status: 'pending', total: 0, discount: 0, taxRate: 0, createdAt: 1, updatedAt: 1 });\n    const u = repo.update('O1', { status: 'confirmed' });\n    expect(u!.updatedAt).toBeGreaterThan(1);\n  });\n\n  it('clear empties store', () => {\n    const repo = new OrderRepository();\n    repo.create({ id: 'O1', customerId: 'C1', items: [], status: 'pending', total: 0, discount: 0, taxRate: 0, createdAt: 0, updatedAt: 0 });\n    repo.clear();\n    expect(repo.findById('O1')).toBeUndefined();\n  });\n});\n\ndescribe('P10: order service misc', () => {\n  it('order persists discount and taxRate', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    const o = await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 100 }], 10, 0.08);\n    expect(o.discount).toBe(10);\n    expect(o.taxRate).toBe(0.08);\n    expect(o.total).toBe(97.2);\n  });\n\n  it('default taxRate is 0.1 and discount 0', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    const o = await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 100 }]);\n    expect(o.total).toBe(110);\n  });\n\n  it('getOrdersByCustomer returns all their orders', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 100);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.createOrder('O2', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.createOrder('O3', 'C2', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    expect(s.orderService.getOrdersByCustomer('C1')).toHaveLength(2);\n  });\n\n  it('duplicate order id does not silently corrupt', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 100);\n    await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    await s.orderService.createOrder('O1', 'C2', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    // ideally rejected; at minimum stock shouldn't be double-consumed silently\n    expect(s.orderService.getOrder('O1')?.customerId).toBe('C1');\n  });\n\n  it('empty items order', async () => {\n    const s = wire();\n    const o = await s.orderService.createOrder('O1', 'C1', []);\n    expect(o.total).toBe(0);\n  });\n\n  it('order.createdAt <= updatedAt', async () => {\n    const s = wire();\n    s.inventoryService.setStock('A', 10);\n    const o = await s.orderService.createOrder('O1', 'C1', [{ productId: 'A', quantity: 1, unitPrice: 10 }]);\n    expect(o.updatedAt).toBeGreaterThanOrEqual(o.createdAt);\n  });\n});\n\ndescribe('P11: event bus semantics', () => {\n  it('off with unregistered handler is a no-op', async () => {\n    const bus = new EventBus();\n    let n = 0;\n    const h = () => { n++; };\n    bus.on('t', h);\n    bus.off('t', () => {});\n    await bus.emit('t', {});\n    expect(n).toBe(1);\n  });\n\n  it('off on unknown event does not throw', () => {\n    const bus = new EventBus();\n    expect(() => bus.off('nope', () => {})).not.toThrow();\n  });\n\n  it('emit with no handlers resolves', async () => {\n    const bus = new EventBus();\n    await expect(bus.emit('none', {})).resolves.toBeUndefined();\n  });\n\n  it('same handler registered twice fires twice', async () => {\n    const bus = new EventBus();\n    let n = 0;\n    const h = () => { n++; };\n    bus.on('t', h); bus.on('t', h);\n    await bus.emit('t', {});\n    expect(n).toBe(2);\n  });\n\n  it('off removes all copies of duplicate handler', async () => {\n    const bus = new EventBus();\n    let n = 0;\n    const h = () => { n++; };\n    bus.on('t', h); bus.on('t', h);\n    bus.off('t', h);\n    await bus.emit('t', {});\n    expect(n).toBe(0);\n  });\n\n  it('handlers run sequentially awaiting async', async () => {\n    const bus = new EventBus();\n    const order: string[] = [];\n    bus.on('t', async () => { await new Promise((r) => setTimeout(r, 20)); order.push('slow'); });\n    bus.on('t', () => { order.push('fast'); });\n    await bus.emit('t', {});\n    expect(order).toEqual(['slow', 'fast']);\n  });\n\n  it('throwing handler prevents later handlers (documented behavior)', async () => {\n    const bus = new EventBus();\n    let second = false;\n    bus.on('t', () => { throw new Error('boom'); });\n    bus.on('t', () => { second = true; });\n    await expect(bus.emit('t', {})).rejects.toThrow('boom');\n    expect(second).toBe(false);\n  });\n\n  it('off during emit does not skip handlers (snapshot semantics)', async () => {\n    const bus = new EventBus();\n    const called: string[] = [];\n    const h2 = () => { called.push('h2'); };\n    bus.on('t', () => { called.push('h1'); bus.off('t', h2); });\n    bus.on('t', h2);\n    await bus.emit('t', {});\n    expect(called).toEqual(['h1', 'h2']);\n  });\n\n  it('on during emit does not affect current emit', async () => {\n    const bus = new EventBus();\n    const called: string[] = [];\n    bus.on('t', () => { called.push('h1'); bus.on('t', () => { called.push('added'); }); });\n    await bus.emit('t', {});\n    expect(called).toEqual(['h1']);\n  });\n\n  it('data passed by reference identity', async () => {\n    const bus = new EventBus();\n    const payload = { a: 1 };\n    let got: unknown;\n    bus.on('t', (d) => { got = d; });\n    await bus.emit('t', payload);\n    expect(got).toBe(payload);\n  });\n\n  it('clear then on works again', async () => {\n    const bus = new EventBus();\n    bus.on('t', () => {});\n    bus.clear();\n    let n = 0;\n    bus.on('t', () => { n++; });\n    await bus.emit('t', {});\n    expect(n).toBe(1);\n  });\n});\n\ndescribe('P12: notifications', () => {\n  it('confirmation with 0 total formats 0.00', () => {\n    const n = new NotificationService();\n    expect(n.sendConfirmation('O1', 0).message).toContain('0.00');\n  });\n\n  it('getSentNotifications returns copy of array', () => {\n    const n = new NotificationService();\n    n.sendConfirmation('O1', 1);\n    const arr = n.getSentNotifications();\n    arr.push({ type: 'x', orderId: 'y', message: 'z', sentAt: 0 });\n    expect(n.getSentNotifications()).toHaveLength(1);\n  });\n\n  it('clear resets', () => {\n    const n = new NotificationService();\n    n.sendConfirmation('O1', 1);\n    n.clear();\n    expect(n.getSentNotifications()).toHaveLength(0);\n  });\n\n  it('orderId appearing in reason is not mangled (single replace)', () => {\n    const n = new NotificationService();\n    const m = n.sendCancellation('O1', 'dup of {orderId}');\n    expect(m.message).toContain('dup of {orderId}');\n  });\n\n  it('template placeholder replaced everywhere it appears', () => {\n    const n = new NotificationService();\n    const m = n.sendRefundNotice('ORD-7', 12.5);\n    expect(m.message).toContain('ORD-7');\n    expect(m.message).toContain('12.50');\n    expect(m.message).not.toContain('{');\n  });\n\n  it('records sentAt timestamp', () => {\n    const n = new NotificationService();\n    expect(n.sendConfirmation('O1', 1).sentAt).toBeGreaterThan(0);\n  });\n});\n\ndescribe('P13: billing service', () => {\n  it('chargePayment overwrites/keeps a single record per order', async () => {\n    const bus = new EventBus();\n    const n = new NotificationService();\n    const b = new BillingService(bus, n);\n    b.registerHandlers();\n    await b.chargePayment('O1', [{ productId: 'A', quantity: 1, unitPrice: 10 }], 0, 0, 'card');\n    await b.chargePayment('O1', [{ productId: 'A', quantity: 1, unitPrice: 20 }], 0, 0, 'card');\n    expect(b.getPayment('O1')?.amount).toBe(20);\n  });\n\n  it('getPayment returns copy', async () => {\n    const bus = new EventBus();\n    const b = new BillingService(bus, new NotificationService());\n    await b.chargePayment('O1', [{ productId: 'A', quantity: 1, unitPrice: 10 }], 0, 0, 'card');\n    const p = b.getPayment('O1')!;\n    p.status = 'refunded';\n    expect(b.getPayment('O1')?.status).toBe('charged');\n  });\n\n  it('clear removes payments', async () => {\n    