+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HmN3ABA6FEo2AeWZZzpJx3","type":"tool_result","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport request from 'supertest';\nimport { createApp } from '../src/index.js';\nimport { resetDefaultConnection } from '@monorepo/core';\n\ndescribe('User Routes', () => {\n  let app: ReturnType<typeof createApp>;\n\n  beforeEach(() => {\n    resetDefaultConnection();\n    app = createApp();\n  });\n\n  it('registers user with valid data', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Test', email: 'test@test.com', role: 'user' });\n    expect(res.status).toBe(201);\n    expect(res.body.user.name).toBe('Test');\n  });\n\n  it('rejects user creation without admin role', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'viewer')\n      .send({ name: 'Test', email: 'test@test.com', role: 'user' });\n    expect(res.status).toBe(403);\n  });\n\n  it('returns 400 for invalid user data', async () => {\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: '', email: 'not-email', role: 'user' });\n    expect(res.status).toBe(400);\n  });\n\n  it('lists all users', async () => {\n    // Create a user first\n    await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Alice', email: 'alice@test.com', role: 'user' });\n\n    const res = await request(app)\n      .get('/users')\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(200);\n    expect(res.body.users).toHaveLength(1);\n  });\n\n  it('gets user by id', async () => {\n    const createRes = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Bob', email: 'bob@test.com', role: 'user' });\n\n    const res = await request(app)\n      .get(`/users/${createRes.body.user.id}`)\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(200);\n    expect(res.body.user.name).toBe('Bob');\n  });\n\n  it('returns 404 for nonexistent user', async () => {\n    const res = await request(app)\n      .get('/users/999')\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(404);\n  });\n\n  it('returns 400 for invalid user id', async () => {\n    const res = await request(app)\n      .get('/users/abc')\n      .set('x-user-role', 'admin');\n    expect(res.status).toBe(400);\n  });\n\n  it('returns 409 for duplicate email', async () => {\n    await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'First', email: 'dup@test.com', role: 'user' });\n\n    const res = await request(app)\n      .post('/users')\n      .set('x-user-role', 'admin')\n      .send({ name: 'Second', email: 'dup@test.com', role: 'user' });\n    expect(res.status).toBe(409);\n  });\n});\n=== routes/users.ts ===\n/**\n * User CRUD routes.\n */\n\nimport { Router, type Request, type Response } from 'express';\nimport {\n  registerUser,\n  getUserById,\n  getAllUsers,\n  validateCreateUser,\n  validateUserId,\n  canManageUsers,\n  type Role,\n} from '@monorepo/core';\n\nexport const usersRouter = Router();\n\n// List all users\nusersRouter.get('/', (_req: Request, res: Response) => {\n  try {\n    const users = getAllUsers();\n    res.json({ users });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to fetch users' });\n  }\n});\n\n// Get user by ID\nusersRouter.get('/:id', (req: Request, res: Response) => {\n  try {\n    const validation = validateUserId(req.params['id']!);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = getUserById(validation.data!);\n    if (!user) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n    res.json({ user });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to fetch user' });\n  }\n});\n\n// Create a new user\nusersRouter.post('/', (req: Request, res: Response) => {\n  try {\n    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!canManageUsers(callerRole)) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const validation = validateCreateUser(req.body);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = registerUser(req.body);\n    res.status(201).json({ user });\n  } catch (err) {\n    if (err instanceof Error && err.message.includes('UNIQUE')) {\n      res.status(409).json({ error: 'Email already exists' });\n      return;\n    }\n    res.status(500).json({ error: 'Failed to create user' });\n  }\n});\n\n// Delete user by ID\nusersRouter.delete('/:id', (req: Request, res: Response) => {\n  try {\n    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!canManageUsers(callerRole)) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const validation = validateUserId(req.params['id']!);\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n\n    const user = getUserById(validation.data!);\n    if (!user) {\n      res.status(404).json({ error: 'User not found' });\n      return;\n    }\n\n    // In a real app, we'd delete here\n    res.status(200).json({ message: 'User deleted', user });\n  } catch (err) {\n    res.status(500).json({ error: 'Failed to delete user' });\n  }\n});","is_error":false}]},"parent_tool_use_id":"toolu_01MVFuppnGGQpeGtXgkQ7kTT","session_id":"0f520463-21e5-43b6-b67a-d84a690444e9","uuid":"b49f3184-d594-45cb-a7ed-3b5478f2f761","timestamp":"2026-07-25T01:27:16.189Z","subagent_type":"conclave:code-reviewer","task_description":"Review monorepo recovery diff"}
