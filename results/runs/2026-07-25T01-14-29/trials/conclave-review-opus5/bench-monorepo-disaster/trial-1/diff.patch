CreateUser,\n    11\t  validateUserId,\n    12\t  canManageUsers,\n    13\t  type Role,\n    14\t} from '@monorepo/core';\n    15\t\n    16\texport const usersRouter = Router();\n    17\t\n    18\t// List all users\n    19\tusersRouter.get('/', (_req: Request, res: Response) => {\n    20\t  try {\n    21\t    const users = getAllUsers();\n    22\t    res.json({ users });\n    23\t  } catch (err) {\n    24\t    res.status(500).json({ error: 'Failed to fetch users' });\n    25\t  }\n    26\t});\n    27\t\n    28\t// Get user by ID\n    29\tusersRouter.get('/:id', (req: Request, res: Response) => {\n    30\t  try {\n    31\t    const validation = validateUserId(req.params['id']!);\n    32\t    if (!validation.success) {\n    33\t      res.status(400).json({ errors: validation.errors });\n    34\t      return;\n    35\t    }\n    36\t\n    37\t    const user = getUserById(validation.data!);\n    38\t    if (!user) {\n    39\t      res.status(404).json({ error: 'User not found' });\n    40\t      return;\n    41\t    }\n    42\t    res.json({ user });\n    43\t  } catch (err) {\n    44\t    res.status(500).json({ error: 'Failed to fetch user' });\n    45\t  }\n    46\t});\n    47\t\n    48\t// Create a new user\n    49\tusersRouter.post('/', (req: Request, res: Response) => {\n    50\t  try {\n    51\t    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    52\t    if (!canManageUsers(callerRole)) {\n    53\t      res.status(403).json({ error: 'Insufficient permissions' });\n    54\t      return;\n    55\t    }\n    56\t\n    57\t    const validation = validateCreateUser(req.body);\n    58\t    if (!validation.success) {\n    59\t      res.status(400).json({ errors: validation.errors });\n    60\t      return;\n    61\t    }\n    62\t\n    63\t    const user = createUser(req.body);\n    64\t    res.status(201).json({ user });\n    65\t  } catch (err) {\n    66\t    if (err instanceof Error && err.message.includes('UNIQUE')) {\n    67\t      res.status(409).json({ error: 'Email already exists' });\n    68\t      return;\n    69\t    }\n    70\t    res.status(500).json({ error: 'Failed to create user' });\n    71\t  }\n    72\t});\n    73\t\n    74\t// Delete user by ID\n    75\tusersRouter.delete('/:id', (req: Request, res: Response) => {\n    76\t  try {\n    77\t    const callerRole = (req.headers['x-user-role'] as Role) || 'viewer';\n    78\t    if (!canManageUsers(callerRole)) {\n    79\t      res.status(403).json({ error: 'Insufficient permissions' });\n    80\t      return;\n    81\t    }\n    82\t\n    83\t    const validation = validateUserId(req.params['id']!);\n    84\t    if (!validation.success) {\n    85\t      res.status(400).json({ errors: validation.errors });\n    86\t      return;\n    87\t    }\n    88\t\n    89\t    const user = getUserById(validation.data!);\n    90\t    if (!user) {\n    91\t      res.status(404).json({ error: 'User not found' });\n    92\t      return;\n    93\t    }\n    94\t\n    95\t    // In a real app, we'd delete here\n    96\t    res.status(200).json({ message: 'User deleted', user });\n    97\t  } catch (err) {\n    98\t    res.status(500).json({ error: 'Failed to delete user' });\n    99\t  }\n   100\t});\n=== packages/api/src/routes/auth.ts ===\n     1\t/**\n     2\t * Authentication routes.\n     3\t */\n     4\t\n     5\timport { Router, type Request, type Response } from 'express';\n     6\timport { validateCreateUser, registerUser, type Role } from '@monorepo/core';\n     7\t\n     8\texport const authRouter = Router();\n     9\t\n    10\t// Simple registration (public)\n    11\tauthRouter.post('/register', (req: Request, res: Response) => {\n    12\t  try {\n    13\t    const validation = validateCreateUser({\n    14\t      ...req.body,\n    15\t      role: 'user', // Force 'user' role for self-registration\n    16\t    });\n    17\t\n    18\t    if (!validation.success) {\n    19\t      res.status(400).json({ errors: validation.errors });\n    20\t      return;\n    21\t    }\n    22\t\n    23\t    const user = registerUser({\n    24\t      name: req.body.name,\n    25\t      email: req.body.email,\n    26\t      role: 'user' as Role,\n    27\t    });\n    28\t\n    29\t    res.status(201).json({\n    30\t      user,\n    31\t      token: `mock-token-${user.id}`, // Simplified for benchmark\n    32\t    });\n    33\t  } catch (err) {\n    34\t    if (err instanceof Error && err.message.includes('UNIQUE')) {\n    35\t      res.status(409).json({ error: 'Email already registered' });\n    36\t      return;\n    37\t    }\n    38\t    res.status(500).json({ error: 'Registration failed' });\n    39\t  }\n    40\t});\n    41\t\n    42\t// Simple login (mock)\n    43\tauthRouter.post('/login', (req: Request, res: Response) => {\n    44\t  try {\n    45\t    const { email } = req.body as { email?: string };\n    46\t    if (!email) {\n    47\t      res.status(400).json({ error: 'Email is required' });\n    48\t      return;\n    49\t    }\n    50\t\n    51\t    // In a real app, we'd verify credentials\n    52\t    res.json({\n    53\t      token: `mock-token-for-${email}`,\n    54\t      message: 'Login successful',\n    55\t    });\n    56\t  } catch (err) {\n    57\t    res.status(500).json({ error: 'Login failed' });\n    58\t  }\n    59\t});\n    60\t\n    61\t// Token validation (mock)\n    62\tauthRouter.get('/verify', (req: Request, res: Response) => {\n    63\t  const token = req.headers['authorization']?.replace('Bearer ', '');\n    64\t  if (!token) {\n    65\t    res.status(401).json({ error: 'No token provided' });\n    66\t    return;\n    67\t  }\n    68\t\n    69\t  // Simplified: any token with correct format is valid\n    70\t  if (token.startsWith('mock-token-')) {\n    71\t    res.json({ valid: true, token });\n    72\t  } else {\n    73\t    res.status(401).json({ valid: false, error: 'Invalid token' });\n    74\t  }\n    75\t});\n=== packages/api/src/middleware/auth.ts ===\n     1\t/**\n     2\t * Authentication middleware using core permissions.\n     3\t */\n     4\t\n     5\timport type { Request, Response, NextFunction } from 'express';\n     6\timport { hasPermission, type Role, type Permission } from '@monorepo/core';\n     7\t\n     8\t/**\n     9\t * Basic auth middleware that checks for a token header.\n    10\t * In this benchmark, we use a simplified mock auth system.\n    11\t */\n    12\texport function authMiddleware(\n    13\t  req: Request,\n    14\t  res: Response,\n    15\t  next: NextFunction\n    16\t): void {\n    17\t  const token = req.headers['authorization']?.replace('Bearer ', '');\n    18\t\n    19\t  // Allow requests with valid mock tokens or role headers\n    20\t  if (token?.startsWith('mock-token-') || req.headers['x-user-role']) {\n    21\t    next();\n    22\t    return;\n    23\t  }\n    24\t\n    25\t  res.status(401).json({ error: 'Authentication required' });\n    26\t}\n    27\t\n    28\t/**\n    29\t * Middleware factory to require a specific permission.\n    30\t */\n    31\texport function requirePermissionMiddleware(permission: Permission) {\n    32\t  return (req: Request, res: Response, next: NextFunction): void => {\n    33\t    const role = (req.headers['x-user-role'] as Role) || 'viewer';\n    34\t\n    35\t    if (!hasPermission(role, permission)) {\n    36\t      res.status(403).json({\n    37\t        error: `Permission '${permission}' required`,\n    38\t      });\n    39\t      return;\n    40\t    }\n    41\t\n    42\t    next();\n    43\t  };\n    44\t}\n=== packages/worker/src/index.ts ===\n     1\t/**\n     2\t * Worker entry point.\n     3\t * Runs background jobs on a schedule.\n     4\t */\n     5\t\n     6\timport { Scheduler } from './scheduler.js';\n     7\timport { syncJob } from './jobs/sync.js';\n     8\timport { cleanupJob } from './jobs/cleanup.js';\n     9\t\n    10\texport function createWorker(): Scheduler {\n    11\t  const scheduler = new Scheduler();\n    12\t\n    13\t  // Register jobs\n    14\t  scheduler.register('sync', syncJob, 60_000); // Every 60 seconds\n    15\t  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000); // Every 5 minutes\n    16\t\n    17\t  return scheduler;\n    18\t}\n    19\t\n    20\t// Start worker if run directly\n    21\tconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\n    22\tif (isMainModule) {\n    23\t  console.log('Starting worker...');\n    24\t  const worker = createWorker();\n    25\t  worker.start();\n    26\t\n    27\t  process.on('SIGINT', () => {\n    28\t    console.log('Shutting down worker...');\n    29\t    worker.stop();\n    30\t    process.exit(0);\n    31\t  });\n    32\t}\n=== packages/worker/src/scheduler.ts ===\n     1\t/**\n     2\t * Simple job scheduler for background tasks.\n     3\t */\n     4\t\n     5\texport interface JobDefinition {\n     6\t  name: string;\n     7\t  handler: () => Promise<void> | void;\n     8\t  intervalMs: number;\n     9\t  timer?: ReturnType<typeof setInterval>;\n    10\t  lastRun?: Date;\n    11\t  runCount: number;\n    12\t  errors: string[];\n    13\t}\n    14\t\n    15\texport class Scheduler {\n    16\t  private jobs: Map<string, JobDefinition> = new Map();\n    17\t  private running = false;\n    18\t\n    19\t  register(\n    20\t    name: string,\n    21\t    handler: () => Promise<void> | void,\n    22\t    intervalMs: number\n    23\t  ): void {\n    24\t    this.jobs.set(name, {\n    25\t      name,\n    26\t      handler,\n    27\t      intervalMs,\n    28\t      runCount: 0,\n    29\t      errors: [],\n    30\t    });\n    31\t  }\n    32\t\n    33\t  start(): void {\n    34\t    if (this.running) return;\n    35\t    this.running = true;\n    36\t\n    37\t    for (const [, job] of this.jobs) {\n    38\t      job.timer = setInterval(async () => {\n    39\t        try {\n    40\t          await job.handler();\n    41\t          job.lastRun = new Date();\n    42\t          job.runCount++;\n    43\t        } catch (err) {\n    44\t          job.errors.push(\n    45\t            err instanceof Error ? err.message : String(err)\n    46\t          );\n    47\t        }\n    48\t      }, job.intervalMs);\n    49\t    }\n    50\t  }\n    51\t\n    52\t  stop(): void {\n    53\t    if (!this.running) return;\n    54\t    this.running = false;\n    55\t\n    56\t    for (const [, job] of this.jobs) {\n    57\t      if (job.timer) {\n    58\t        clearInterval(job.timer);\n    59\t        job.timer = undefined;\n    60\t      }\n    61\t    }\n    62\t  }\n    63\t\n    64\t  async runOnce(name: string): Promise<void> {\n    65\t    const job = this.jobs.get(name);\n    66\t    if (!job) {\n    67\t      throw new Error(`Job '${name}' not found`);\n    68\t    }\n    69\t\n    70\t    await job.handler();\n    71\t    job.lastRun = new Date();\n    72\t    job.runCount++;\n    73\t  }\n    74\t\n    75\t  getStatus(): Array<{\n    76\t    name: string;\n    77\t    lastRun: Date | undefined;\n    78\t    runCount: number;\n    79\t    errorCount: number;\n    80\t  }> {\n    81\t    return Array.from(this.jobs.values()).map((job) => ({\n    82\t      name: job.name,\n    83\t      lastRun: job.lastRun,\n    84\t      runCount: job.runCount,\n    85\t      errorCount: job.errors.length,\n    86\t    }));\n    87\t  }\n    88\t\n    89\t  isRunning(): boolean {\n    90\t    return this.running;\n    91\t  }\n    92\t}\n=== packages/worker/src/jobs/cleanup.ts ===\n     1\t/**\n     2\t * Cleanup job.\n     3\t * Removes stale data and performs maintenance tasks.\n     4\t */\n     5\t\n     6\timport { getAllUsers } from '@monorepo/core';\n     7\t\n     8\texport interface CleanupResult {\n     9\t  staleRecords: number;\n    10\t  cleanedUp: number;\n    11\t  duration: number;\n    12\t}\n    13\t\n    14\texport async function cleanupJob(): Promise<CleanupResult> {\n    15\t  const startTime = Date.now();\n    16\t\n    17\t  // Get all users to check for stale records\n    18\t  const users = getAllUsers();\n    19\t\n    20\t  let staleRecords = 0;\n    21\t  let cleanedUp = 0;\n    22\t\n    23\t  for (const user of users) {\n    24\t    const createdDate = new Date(user.createdAt);\n    25\t    const now = new Date();\n    26\t    const daysSinceCreation =\n    27\t      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n    28\t\n    29\t    // Mark records older than 365 days as stale (simulation)\n    30\t    if (daysSinceCreation > 365) {\n    31\t      staleRecords++;\n    32\t      // In a real app, we'd archive or delete\n    33\t      cleanedUp++;\n    34\t    }\n    35\t  }\n    36\t\n    37\t  const duration = Date.now() - startTime;\n    38\t\n    39\t  console.log(\n    40\t    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n    41\t  );\n    42\t\n    43\t  return { staleRecords, cleanedUp, duration };\n    44\t}\n    45\t\n    46\texport function getCleanupThresholdDays(): number {\n    47\t  return 365;\n    48\t}\n=== packages/worker/src/jobs/sync.ts ===\n     1\t/**\n     2\t * Data sync job.\n     3\t * Syncs external user data into the local database.\n     4\t */\n     5\t\n     6\timport {\n     7\t  createUser,\n     8\t  getUserById,\n     9\t  getAllUsers,\n    10\t  type CreateUserInput,\n    11\t} from '@monorepo/core';\n    12\t\n    13\tinterface ExternalUser {\n    14\t  name: string;\n    15\t  email: string;\n    16\t  role: 'admin' | 'user' | 'viewer';\n    17\t}\n    18\t\n    19\t// Simulated external data source\n    20\tfunction fetchExternalUsers(): ExternalUser[] {\n    21\t  return [\n    22\t    { name: 'External User 1', email: 'ext1@example.com', role: 'user' },\n    23\t    { name: 'External User 2', email: 'ext2@example.com', role: 'viewer' },\n    24\t  ];\n    25\t}\n    26\t\n    27\texport async function syncJob(): Promise<void> {\n    28\t  const externalUsers = fetchExternalUsers();\n    29\t  const existingUsers = getAllUsers();\n  