diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..df793f5
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,156 @@
+import { forbidden, notFound } from './errors.js';
+import { getShares, type Store } from './store.js';
+import type { Document, Folder, ResourceType, Role } from './types.js';
+
+export const ROLE_RANK: Record<Role, number> = {
+  viewer: 1,
+  editor: 2,
+  owner: 3,
+};
+
+export const ROLES: Role[] = ['viewer', 'editor', 'owner'];
+
+export function isRole(value: unknown): value is Role {
+  return typeof value === 'string' && (ROLES as string[]).includes(value);
+}
+
+/** Returns the more permissive of two (possibly absent) roles. */
+export function maxRole(a: Role | null, b: Role | null): Role | null {
+  if (!a) return b;
+  if (!b) return a;
+  return ROLE_RANK[a] >= ROLE_RANK[b] ? a : b;
+}
+
+export function atLeast(role: Role | null, required: Role): boolean {
+  return role !== null && ROLE_RANK[role] >= ROLE_RANK[required];
+}
+
+/** Walks the parent chain of a folder, innermost first. Cycle-safe. */
+export function folderChain(store: Store, folderId: string | null): Folder[] {
+  const chain: Folder[] = [];
+  const seen = new Set<string>();
+  let current = folderId;
+  while (current && !seen.has(current)) {
+    seen.add(current);
+    const folder = store.folders.get(current);
+    if (!folder) break;
+    chain.push(folder);
+    current = folder.parentId;
+  }
+  return chain;
+}
+
+/** Role granted directly on a resource (creator ownership + explicit shares). */
+function directRole(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+  ownerId: string | null,
+): Role | null {
+  const shared = getShares(store, resourceType, resourceId).get(userId) ?? null;
+  const owned: Role | null = ownerId === userId ? 'owner' : null;
+  return maxRole(owned, shared);
+}
+
+/**
+ * Effective role of a user on a folder: the most permissive role granted
+ * directly on it or inherited from any ancestor folder.
+ */
+export function effectiveFolderRole(store: Store, userId: string, folderId: string): Role | null {
+  let role: Role | null = null;
+  for (const folder of folderChain(store, folderId)) {
+    role = maxRole(role, directRole(store, userId, 'folder', folder.id, folder.ownerId));
+    if (role === 'owner') break;
+  }
+  return role;
+}
+
+/**
+ * Effective role of a user on a document: the most permissive role granted
+ * directly on the document or inherited from its folder ancestry.
+ */
+export function effectiveDocumentRole(store: Store, userId: string, documentId: string): Role | null {
+  const doc = store.documents.get(documentId);
+  if (!doc) return null;
+  const direct = directRole(store, userId, 'document', doc.id, doc.ownerId);
+  if (direct === 'owner') return direct;
+  return maxRole(direct, effectiveFolderRole(store, userId, doc.folderId));
+}
+
+export function effectiveRole(
+  store: Store,
+  userId: string,
+  resourceType: ResourceType,
+  resourceId: string,
+): Role | null {
+  return resourceType === 'folder'
+    ? effectiveFolderRole(store, userId, resourceId)
+    : effectiveDocumentRole(store, userId, resourceId);
+}
+
+/** Loads a folder, enforcing that the user holds at least `required` on it. */
+export function requireFolderAccess(
+  store: Store,
+  userId: string,
+  folderId: string,
+  required: Role,
+): { folder: Folder; role: Role } {
+  const folder = store.folders.get(folderId);
+  if (!folder) throw notFound(`Folder ${folderId} not found`);
+  const role = effectiveFolderRole(store, userId, folderId);
+  if (!atLeast(role, required)) {
+    throw forbidden(`You need ${required} access to this folder`);
+  }
+  return { folder, role: role as Role };
+}
+
+/** Loads a document, enforcing that the user holds at least `required` on it. */
+export function requireDocumentAccess(
+  store: Store,
+  userId: string,
+  documentId: string,
+  required: Role,
+): { document: Document; role: Role } {
+  const document = store.documents.get(documentId);
+  if (!document) throw notFound(`Document ${documentId} not found`);
+  const role = effectiveDocumentRole(store, userId, documentId);
+  if (!atLeast(role, required)) {
+    throw forbidden(`You need ${required} access to this document`);
+  }
+  return { document, role: role as Role };
+}
+
+export function canRead(store: Store, userId: string, resourceType: ResourceType, resourceId: string): boolean {
+  return atLeast(effectiveRole(store, userId, resourceType, resourceId), 'viewer');
+}
+
+/**
+ * Every user who can currently read a resource. Captured alongside activity
+ * entries so the audit trail outlives the resource it describes.
+ */
+export function audienceFor(store: Store, resourceType: ResourceType, resourceId: string): string[] {
+  const audience: string[] = [];
+  for (const userId of store.users.keys()) {
+    if (canRead(store, userId, resourceType, resourceId)) audience.push(userId);
+  }
+  return audience;
+}
+
+/** Every descendant folder of `folderId`, excluding the folder itself. */
+export function descendantFolders(store: Store, folderId: string): Folder[] {
+  const result: Folder[] = [];
+  const queue = [folderId];
+  const seen = new Set<string>([folderId]);
+  while (queue.length > 0) {
+    const current = queue.shift() as string;
+    for (const folder of store.folders.values()) {
+      if (folder.parentId === current && !seen.has(folder.id)) {
+        seen.add(folder.id);
+        result.push(folder);
+        queue.push(folder.id);
+      }
+    }
+  }
+  return result;
+}
