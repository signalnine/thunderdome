@@ -0,0 +1,63 @@
+import { badRequest } from './errors.js';
+
+/** Body parsers may leave `req.body` undefined; normalise to an object. */
+export function body(value: unknown): Record<string, unknown> {
+  if (value && typeof value === 'object' && !Array.isArray(value)) {
+    return value as Record<string, unknown>;
+  }
+  return {};
+}
+
+export function requiredString(source: Record<string, unknown>, field: string, label = field): string {
+  const value = source[field];
+  if (typeof value !== 'string' || value.trim().length === 0) {
+    throw badRequest(`"${label}" is required and must be a non-empty string`);
+  }
+  return value.trim();
+}
+
+export function optionalString(
+  source: Record<string, unknown>,
+  field: string,
+  label = field,
+): string | undefined {
+  if (!(field in source) || source[field] === undefined) return undefined;
+  const value = source[field];
+  if (typeof value !== 'string') {
+    throw badRequest(`"${label}" must be a string`);
+  }
+  return value;
+}
+
+/** Reads a nullable id field, accepting any of the supplied aliases. */
+export function optionalId(source: Record<string, unknown>, fields: string[]): string | null | undefined {
+  for (const field of fields) {
+    if (!(field in source)) continue;
+    const value = source[field];
+    if (value === null || value === '') return null;
+    if (value === undefined) continue;
+    if (typeof value !== 'string') {
+      throw badRequest(`"${field}" must be a string id or null`);
+    }
+    return value;
+  }
+  return undefined;
+}
+
+export function firstString(source: Record<string, unknown>, fields: string[]): string | undefined {
+  for (const field of fields) {
+    const value = source[field];
+    if (typeof value === 'string' && value.trim().length > 0) return value.trim();
+  }
+  return undefined;
+}
+
+export function parsePositiveInt(value: unknown, label: string): number | undefined {
+  if (value === undefined || value === '') return undefined;
+  const raw = Array.isArray(value) ? value[0] : value;
+  const num = Number(raw);
+  if (!Number.isInteger(num) || num < 0) {
+    throw badRequest(`"${label}" must be a non-negative integer`);
+  }
+  return num;
+}
