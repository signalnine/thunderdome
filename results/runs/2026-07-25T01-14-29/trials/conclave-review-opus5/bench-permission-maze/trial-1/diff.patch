+describe('activity log', () => {
+  it('records document lifecycle and sharing events', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const folder = await makeFolder(alice.token, 'Root');
+    const doc = await makeDoc(alice.token, folder.id, 'Doc');
+
+    await request(app)
+      .put(`/documents/${doc.id}`)
+      .set(bearer(alice.token))
+      .send({ content: 'v2' })
+      .expect(200);
+    await request(app)
+      .post(`/documents/${doc.id}/share`)
+      .set(bearer(alice.token))
+      .send({ userId: bob.id, role: 'viewer' })
+      .expect(201);
+
+    const log = await request(app).get('/activity').set(bearer(alice.token));
+    expect(log.status).toBe(200);
+    expect(Array.isArray(log.body)).toBe(true);
+
+    const actions = log.body.map((e: { action: string }) => e.action);
+    expect(actions).toEqual(['document.create', 'document.update', 'share.grant']);
+
+    const first = log.body[0];
+    expect(first.userId).toBe(alice.id);
+    expect(first.resourceType).toBe('document');
+    expect(first.resourceId).toBe(doc.id);
+    expect(typeof first.timestamp).toBe('string');
+    expect(Number.isNaN(Date.parse(first.timestamp))).toBe(false);
+
+    const del = await request(app).delete(`/documents/${doc.id}`).set(bearer(alice.token));
+    expect(del.status).toBe(204);
+    const after = await request(app).get('/activity').set(bearer(alice.token));
+    expect(after.body.map((e: { action: string }) => e.action)).toContain('document.delete');
+
+    // Deleting the document must not erase its history for the people it affected.
+    const bobLog = await request(app).get('/activity').set(bearer(bob.token));
+    expect(bobLog.body.map((e: { action: string }) => e.action)).toContain('document.delete');
+  });
+
