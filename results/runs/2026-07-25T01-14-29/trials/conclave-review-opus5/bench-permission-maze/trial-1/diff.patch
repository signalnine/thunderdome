+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import { HttpError } from './errors.js';
+import { activityRoutes } from './routes/activity.js';
+import { authRoutes } from './routes/auth.js';
+import { documentRoutes } from './routes/documents.js';
+import { folderRoutes } from './routes/folders.js';
+import { shareRoutes } from './routes/shares.js';
+import { createStore, type Store } from './store.js';
+
+export interface AppOptions {
+  /** Supply an existing store to share state across app instances (mostly for tests). */
+  store?: Store;
+}
+
+/**
+ * Builds the document management API. Each call creates an isolated,
+ * in-memory data store unless one is provided.
+ */
+export function createApp(options: AppOptions = {}): Express {
+  const store = options.store ?? createStore();
+  const app = express();
+
+  app.use(express.json({ limit: '5mb' }));
+  app.use(express.urlencoded({ extended: false }));
+
+  app.get('/health', (_req: Request, res: Response) => {
+    res.status(200).json({ status: 'ok' });
+  });
+
+  app.use(authRoutes(store));
+  app.use(folderRoutes(store));
+  app.use(documentRoutes(store));
+  app.use(shareRoutes(store));
+  app.use(activityRoutes(store));
+
+  app.use((req: Request, res: Response) => {
+    res.status(404).json({
+      error: 'not_found',
+      message: `Cannot ${req.method} ${req.path}`,
+    });
+  });
+
+  app.use((err: unknown, _req: Request, res: Response, _next: NextFunction) => {
+    if (err instanceof HttpError) {
+      res.status(err.status).json({ error: err.code, message: err.message });
+      return;
+    }
+    // Body parser failures surface as SyntaxError with a `status` property.
+    const status = typeof (err as { status?: unknown })?.status === 'number'
+      ? (err as { status: number }).status
+      : 500;
+    const message = err instanceof Error ? err.message : 'Internal server error';
+    if (status >= 500) {
+      // eslint-disable-next-line no-console
+      console.error('Unhandled error:', err);
+    }
+    res.status(status >= 400 && status < 600 ? status : 500).json({
+      error: status === 400 ? 'bad_request' : 'internal_error',
+      message,
+    });
+  });
+
+  return app;
+}
+
+export default createApp;
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..bd1f923
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,74 @@
+import { pbkdf2Sync, randomBytes, timingSafeEqual } from 'node:crypto';
+import type { NextFunction, Request, RequestHandler, Response } from 'express';
+import { unauthorized } from './errors.js';
+import type { Store } from './store.js';
+import type { User } from './types.js';
+
+// Deliberately modest for an in-memory demo API: high enough to avoid storing
+// anything reversible, low enough that a test suite registering many users
+// stays fast. A production deployment should use a far higher work factor.
+const ITERATIONS = 10_000;
+const KEY_LENGTH = 32;
+const DIGEST = 'sha256';
+
+export function hashPassword(password: string, salt = randomBytes(16).toString('hex')): {
+  salt: string;
+  hash: string;
+} {
+  const hash = pbkdf2Sync(password, salt, ITERATIONS, KEY_LENGTH, DIGEST).toString('hex');
+  return { salt, hash };
+}
+
+export function verifyPassword(password: string, salt: string, expectedHash: string): boolean {
+  const { hash } = hashPassword(password, salt);
+  const a = Buffer.from(hash, 'hex');
+  const b = Buffer.from(expectedHash, 'hex');
+  if (a.length !== b.length) return false;
+  return timingSafeEqual(a, b);
+}
+
+export function issueToken(store: Store, userId: string): string {
+  const token = randomBytes(24).toString('hex');
+  store.tokens.set(token, userId);
+  return token;
+}
+
+/**
+ * Extracts the token from `Authorization: Bearer <token>`. A bare value in the
+ * header (or `X-Access-Token`) is also accepted; query-string tokens are not,
+ * since they leak into logs and referrers.
+ */
+export function extractToken(req: Request): string | null {
+  const header = req.get('authorization') ?? req.get('x-access-token');
+  if (!header) return null;
+  const match = /^Bearer\s+(.+)$/i.exec(header.trim());
+  if (match) return match[1].trim();
+  if (!header.includes(' ')) return header.trim() || null;
+  return null;
+}
+
+/** Rejects the request with 401 unless a valid bearer token is present. */
+export function requireAuth(store: Store): RequestHandler {
+  return (req: Request, _res: Response, next: NextFunction) => {
+    const token = extractToken(req);
+    if (!token) {
+      next(unauthorized('Missing authentication token'));
+      return;
+    }
+    const userId = store.tokens.get(token);
+    const user = userId ? store.users.get(userId) : undefined;
+    if (!user) {
+      next(unauthorized('Invalid or expired authentication token'));
+      return;
+    }
+    req.user = user;
+    next();
+  };
+}
+
+/** Narrowing helper: routes behind `requireAuth` always have a user. */
+export function currentUser(req: Request): User {
+  const user = req.user;
+  if (!user) throw unauthorized();
+  return user;
+}
diff --git a/src/errors.ts b/src/errors.ts
new file mode 100644
index 0000000..9bcd39b
--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,37 @@
+/** Error carrying an HTTP status code, translated to a JSON body by the error middleware. */
+export class HttpError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, message: string, code?: string) {
+    super(message);
+    this.name = 'HttpError';
+    this.status = status;
+    this.code = code ?? defaultCode(status);
+  }
+}
+
+function defaultCode(status: number): string {
+  switch (status) {
+    case 400:
+      return 'bad_request';
+    case 401:
+      return 'unauthorized';
+    case 403:
+      return 'forbidden';
+    case 404:
+      return 'not_found';
+    case 409:
+      return 'conflict';
+    default:
+      return 'error';
+  }
+}
+
+export const badRequest = (message: string): HttpError => new HttpError(400, message);
+export const unauthorized = (message = 'Authentication required'): HttpError =>
+  new HttpError(401, message);
+export const forbidden = (message = 'You do not have permission to perform this action'): HttpError =>
+  new HttpError(403, message);
+export const notFound = (message = 'Resource not found'): HttpError => new HttpError(404, message);
+export const conflict = (message: string): HttpError => new HttpError(409, message);
