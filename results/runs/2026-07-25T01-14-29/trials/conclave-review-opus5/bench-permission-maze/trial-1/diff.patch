@@ -0,0 +1,19 @@
+import { createApp } from './app.js';
+
+export { createApp };
+
+const port = Number(process.env.PORT ?? 3000);
+
+/** Starts an HTTP listener. Only invoked when this file is the entrypoint. */
+export function startServer(listenPort = port) {
+  const app = createApp();
+  return app.listen(listenPort, () => {
+    // eslint-disable-next-line no-console
+    console.log(`Document management API listening on port ${listenPort}`);
+  });
+}
+
+const entrypoint = process.argv[1] ?? '';
+if (entrypoint.endsWith('server.ts') || entrypoint.endsWith('server.js')) {
+  startServer();
+}
diff --git a/src/sharing.ts b/src/sharing.ts
new file mode 100644
index 0000000..eab63fb
--- /dev/null
+++ b/src/sharing.ts
@@ -0,0 +1,193 @@
+import { badRequest, conflict, forbidden, notFound } from './errors.js';
+import {
+  atLeast,
+  audienceFor,
+  effectiveRole,
+  folderChain,
+  isRole,
+  ROLE_RANK,
+  ROLES,
+} from './permissions.js';
+import { getShares, recordActivity, removeShare, setShare, type Store } from './store.js';
+import type { ResourceType, Role, Share, User } from './types.js';
+
+/** Returns the creator/owner id of a resource, or throws 404 if it is gone. */
+function ownerOf(store: Store, resourceType: ResourceType, resourceId: string): string {
+  const resource =
+    resourceType === 'folder' ? store.folders.get(resourceId) : store.documents.get(resourceId);
+  if (!resource) {
+    throw notFound(`${resourceType === 'folder' ? 'Folder' : 'Document'} ${resourceId} not found`);
+  }
+  return resource.ownerId;
+}
+
+export function resolveTargetUser(store: Store, ref: { userId?: string; username?: string }): User {
+  if (ref.userId) {
+    const user = store.users.get(ref.userId);
+    if (!user) throw notFound(`User ${ref.userId} not found`);
+    return user;
+  }
+  if (ref.username) {
+    const id = store.usernameIndex.get(ref.username.toLowerCase());
+    const user = id ? store.users.get(id) : undefined;
+    if (!user) throw notFound(`User "${ref.username}" not found`);
+    return user;
+  }
+  throw badRequest('A target "userId" or "username" is required');
+}
+
+export function parseRole(value: unknown): Role {
+  if (!isRole(value)) {
+    throw badRequest(`"role" must be one of: ${ROLES.join(', ')}`);
+  }
+  return value;
+}
+
+export interface GrantResult {
+  created: boolean;
+  share: Share;
+}
+
+/**
+ * Grants (or updates) a role for `target` on a resource.
+ *
+ * Editors may share, but never above their own level — only an owner can mint
+ * another owner. The creator's ownership can never be downgraded.
+ */
+export function grantShare(
+  store: Store,
+  actor: User,
+  resourceType: ResourceType,
+  resourceId: string,
+  target: User,
+  role: Role,
+): GrantResult {
+  const creatorId = ownerOf(store, resourceType, resourceId);
+  const actorRole = effectiveRole(store, actor.id, resourceType, resourceId);
+  if (!atLeast(actorRole, 'editor')) {
+    throw forbidden('You need editor access to share this resource');
+  }
+  if (ROLE_RANK[role] > ROLE_RANK[actorRole as Role]) {
+    throw forbidden(`You cannot grant a role higher than your own ("${actorRole}")`);
+  }
+  if (target.id === actor.id) {
+    throw badRequest('You cannot share a resource with yourself');
+  }
+  if (target.id === creatorId) {
+    throw badRequest("The creator's ownership cannot be changed");
+  }
+
+  const existing = getShares(store, resourceType, resourceId).get(target.id) ?? null;
+  setShare(store, resourceType, resourceId, target.id, role);
+
+  recordActivity(store, {
+    action: existing ? 'share.update' : 'share.grant',
+    userId: actor.id,
+    resourceType,
+    resourceId,
+    audience: audienceFor(store, resourceType, resourceId),
+    details: {
+      targetUserId: target.id,
+      targetUsername: target.username,
+      role,
+      previousRole: existing,
+    },
+  });
+
+  return { created: existing === null, share: { resourceType, resourceId, userId: target.id, role } };
+}
+
+export function revokeShare(
+  store: Store,
+  actor: User,
+  resourceType: ResourceType,
+  resourceId: string,
+  target: User,
+): void {
+  const creatorId = ownerOf(store, resourceType, resourceId);
+  const actorRole = effectiveRole(store, actor.id, resourceType, resourceId);
+  // Revocation mirrors granting: you may withdraw any role you could have given.
+  if (!atLeast(actorRole, 'editor')) {
+    throw forbidden('You need editor access to manage sharing on this resource');
+  }
+  if (target.id === creatorId) {
+    throw badRequest("The creator's ownership cannot be revoked");
+  }
+
+  const existing = getShares(store, resourceType, resourceId).get(target.id) ?? null;
+  if (existing === null) {
+    const inherited = effectiveRole(store, target.id, resourceType, resourceId);
+    if (inherited) {
+      throw conflict(
+        `"${target.username}" has ${inherited} access inherited from a parent folder; revoke it there`,
+      );
+    }
+    throw notFound('That user does not have a direct share on this resource');
+  }
+  if (ROLE_RANK[existing] > ROLE_RANK[actorRole as Role]) {
+    throw forbidden(`You cannot revoke a role higher than your own ("${actorRole}")`);
+  }
+
+  // Capture the audience before the share disappears.
+  const audience = audienceFor(store, resourceType, resourceId);
+  removeShare(store, resourceType, resourceId, target.id);
+  recordActivity(store, {
+    action: 'share.revoke',
+    userId: actor.id,
+    resourceType,
+    resourceId,
+    audience,
+    details: { targetUserId: target.id, targetUsername: target.username, previousRole: existing },
+  });
+}
+
+export interface ShareView extends Share {
+  username: string;
+  inherited: boolean;
+  /** Id of the ancestor folder the role came from, or null when granted directly. */
+  via: string | null;
+}
+
+/**
+ * Everyone with access to a resource: direct grants plus roles inherited from
+ * ancestor folders. Where a user holds several roles, the most permissive wins,
+ * which matches what the permission checks actually enforce.
+ */
+export function listShares(store: Store, resourceType: ResourceType, resourceId: string): ShareView[] {
+  const views = new Map<string, ShareView>();
+
+  const add = (userId: string, role: Role, via: string | null): void => {
+    const user = store.users.get(userId);
+    if (!user) return;
+    const existing = views.get(userId);
+    // Direct grants are registered first, so they win ties against inherited ones.
+    if (existing && ROLE_RANK[role] <= ROLE_RANK[existing.role]) return;
+    views.set(userId, {
+      resourceType,
+      resourceId,
+      userId,
+      username: user.username,
+      role,
+      inherited: via !== null,
+      via,
+    });
+  };
+
+  add(ownerOf(store, resourceType, resourceId), 'owner', null);
+  for (const [userId, role] of getShares(store, resourceType, resourceId)) {
+    add(userId, role, null);
+  }
+
+  const startFolderId =
+    resourceType === 'document'
+      ? (store.documents.get(resourceId)?.folderId ?? null)
+      : (store.folders.get(resourceId)?.parentId ?? null);
+  for (const ancestor of folderChain(store, startFolderId)) {
+    add(ancestor.ownerId, 'owner', ancestor.id);
+    for (const [userId, role] of getShares(store, 'folder', ancestor.id)) {
+      add(userId, role, ancestor.id);
+    }
+  }
+
+  return [...views.values()];
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..26db52e
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,119 @@
+import { randomUUID } from 'node:crypto';
+import type {
+  ActivityAction,
+  ActivityEntry,
+  Document,
+  Folder,
+  ResourceType,
+  Role,
+  User,
+} from './types.js';
+
+/**
+ * All application state lives here. A fresh store is created per `createApp()`
+ * call so that tests (and restarts) start from a clean slate.
+ */
+export interface Store {
+  users: Map<string, User>;
+  /** Lower-cased username -> user id. */
+  usernameIndex: Map<string, string>;
+  /** Bearer token -> user id. */
+  tokens: Map<string, string>;
+  folders: Map<string, Folder>;
+  documents: Map<string, Document>;
+  /** `${resourceType}:${resourceId}` -> (userId -> role). */
+  shares: Map<string, Map<string, Role>>;
+  activity: ActivityEntry[];
+  nextSeq: number;
+}
+
+export function createStore(): Store {
+  return {
+    users: new Map(),
+    usernameIndex: new Map(),
+    tokens: new Map(),
+    folders: new Map(),
+    documents: new Map(),
+    shares: new Map(),
+    activity: [],
+    nextSeq: 1,
+  };
+}
+
+export function shareKey(resourceType: ResourceType, resourceId: string): string {
+  return `${resourceType}:${resourceId}`;
+}
+
+export function getShares(store: Store, resourceType: ResourceType, resourceId: string): Map<string, Role> {
+  return store.shares.get(shareKey(resourceType, resourceId)) ?? new Map();
+}
+
+export function setShare(
+  store: Store,
+  resourceType: ResourceType,
+  resourceId: string,
+  userId: string,
+  role: Role,
+): void {
+  const key = shareKey(resourceType, resourceId);
+  let entry = store.shares.get(key);
+  if (!entry) {
+    entry = new Map();
+    store.shares.set(key, entry);
+  }
+  entry.set(userId, role);
+}
+
+export function removeShare(
+  store: Store,
+  resourceType: ResourceType,
+  resourceId: string,
+  userId: string,
+): boolean {
+  const entry = store.shares.get(shareKey(resourceType, resourceId));
+  if (!entry) return false;
+  const removed = entry.delete(userId);
+  if (entry.size === 0) store.shares.delete(shareKey(resourceType, resourceId));
+  return removed;
+}
+
+export function dropAllShares(store: Store, resourceType: ResourceType, resourceId: string): void {
+  store.shares.delete(shareKey(resourceType, resourceId));
+}
+
+export function newId(): string {
+  return randomUUID();
+}
+
+export function now(): string {
+  return new Date().toISOString();
+}
+
+export function recordActivity(
+  store: Store,
+  entry: {
+    action: ActivityAction;
+    userId: string;
+    resourceType: ResourceType;
+    resourceId: string;
+    /** Users who could read the resource at the time of the action. */
+    audience?: string[];
+    details?: Record<string, unknown>;
+  },
+): ActivityEntry {
+  const audience = new Set(entry.audience ?? []);
+  audience.add(entry.userId);
+  const logged: ActivityEntry = {
+    id: newId(),
+    seq: store.nextSeq++,
+    action: entry.action,
+    userId: entry.userId,
+    resourceType: entry.resourceType,
+    resourceId: entry.resourceId,
+    timestamp: now(),
+    audience: [...audience],
+    details: entry.details ?? {},
+  };
+  store.activity.push(logged);
+  return logged;
+}
