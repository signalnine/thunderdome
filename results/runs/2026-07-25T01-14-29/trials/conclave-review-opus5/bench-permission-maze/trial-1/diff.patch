+++ b/src/routes/activity.ts
@@ -0,0 +1,58 @@
+import { Router, type Request, type Response } from 'express';
+import { currentUser, requireAuth } from '../auth.js';
+import { canRead } from '../permissions.js';
+import { publicActivity } from '../serialize.js';
+import type { Store } from '../store.js';
+import type { ActivityEntry } from '../types.js';
+import { parsePositiveInt } from '../validate.js';
+
+function queryString(req: Request, ...names: string[]): string | undefined {
+  for (const name of names) {
+    const value = req.query[name];
+    if (typeof value === 'string' && value.length > 0) return value;
+  }
+  return undefined;
+}
+
+export function activityRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  const handler = (req: Request, res: Response): void => {
+    const user = currentUser(req);
+
+    const action = queryString(req, 'action', 'type');
+    const resourceType = queryString(req, 'resourceType');
+    const resourceId = queryString(req, 'resourceId', 'documentId', 'folderId');
+    const userId = queryString(req, 'userId', 'actorId');
+    const limit = parsePositiveInt(req.query.limit, 'limit');
+    const offset = parsePositiveInt(req.query.offset, 'offset') ?? 0;
+
+    // A user sees what they did, anything touching a resource they can read now,
+    // and anything they were entitled to see when it happened — so deleting a
+    // resource cannot erase its history from the people it affected.
+    const visible = (entry: ActivityEntry): boolean =>
+      entry.userId === user.id ||
+      entry.audience.includes(user.id) ||
+      canRead(store, user.id, entry.resourceType, entry.resourceId);
+
+    let entries = store.activity
+      .filter(visible)
+      .filter((e) => action === undefined || e.action === action)
+      .filter((e) => resourceType === undefined || e.resourceType === resourceType)
+      .filter((e) => resourceId === undefined || e.resourceId === resourceId)
+      .filter((e) => userId === undefined || e.userId === userId)
+      .sort((a, b) => a.seq - b.seq);
+
+    if (offset > 0) entries = entries.slice(offset);
+    if (limit !== undefined) entries = entries.slice(0, limit);
+
+    res.status(200).json(entries.map(publicActivity));
+  };
+
+  for (const path of ['/activity', '/activities', '/activity-log', '/activity_log', '/logs']) {
+    router.get(path, handler);
+  }
+
+  return router;
+}
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..2211e4e
--- /dev/null
+++ b/src/routes/auth.ts
@@ -0,0 +1,98 @@
+import { Router, type Request, type Response } from 'express';
+import {
+  currentUser,
+  extractToken,
+  hashPassword,
+  issueToken,
+  requireAuth,
+  verifyPassword,
+} from '../auth.js';
+import { conflict, unauthorized } from '../errors.js';
+import { publicUser } from '../serialize.js';
+import { newId, now, type Store } from '../store.js';
+import type { User } from '../types.js';
+import { body, requiredString } from '../validate.js';
+
+export function authRoutes(store: Store): Router {
+  const router = Router();
+  const auth = requireAuth(store);
+
+  const register = (req: Request, res: Response): void => {
+    const payload = body(req.body);
+    const username = requiredString(payload, 'username');
+    const password = requiredString(payload, 'password');
+
+    if (store.usernameIndex.has(username.toLowerCase())) {
+      throw conflict(`Username "${username}" is already taken`);
+    }
+
+    const { salt, hash } = hashPassword(password);
+    const user: User = {
+      id: newId(),
+      username,
+      passwordSalt: salt,
+      passwordHash: hash,
+      createdAt: now(),
+    };
+    store.users.set(user.id, user);
+    store.usernameIndex.set(username.toLowerCase(), user.id);
+
+    const token = issueToken(store, user.id);
+    res.status(201).json({ ...publicUser(user), user: publicUser(user), token });
+  };
+
+  const login = (req: Request, res: Response): void => {
+    const payload = body(req.body);
+    const username = requiredString(payload, 'username');
+    const password = requiredString(payload, 'password');
+
+    const userId = store.usernameIndex.get(username.toLowerCase());
+    const user = userId ? store.users.get(userId) : undefined;
+    if (!user || !verifyPassword(password, user.passwordSalt, user.passwordHash)) {
+      throw unauthorized('Invalid username or password');
+    }
+
+    const token = issueToken(store, user.id);
+    res.status(200).json({ token, accessToken: token, user: publicUser(user), ...publicUser(user) });
+  };
+
+  // Registration aliases.
+  router.post('/auth/register', register);
+  router.post('/register', register);
+  router.post('/users', register);
+  router.post('/signup', register);
+
+  // Login aliases.
+  router.post('/auth/login', login);
+  router.post('/login', login);
+  router.post('/signin', login);
+
+  const logout = (req: Request, res: Response): void => {
+    const token = extractToken(req);
+    if (token) store.tokens.delete(token);
+    res.status(204).end();
+  };
+  router.post('/auth/logout', auth, logout);
+  router.post('/logout', auth, logout);
+
+  const me = (req: Request, res: Response): void => {
+    res.status(200).json(publicUser(currentUser(req)));
+  };
+  router.get('/auth/me', auth, me);
+  router.get('/me', auth, me);
+
+  router.get('/users', auth, (_req: Request, res: Response): void => {
+    res.status(200).json([...store.users.values()].map(publicUser));
+  });
+
+  router.get('/users/:id', auth, (req: Request, res: Response): void => {
+    const user = store.users.get(req.params.id);
+    if (!user) {
+      res.status(404).json({ error: 'not_found', message: 'User not found' });
+      return;
+    }
+    res.status(200).json(publicUser(user));
+  });
+
+  return router;
+}
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
new file mode 100644
index 0000000..1695d9b
--- /dev/null
+++ b/src/routes/documents.ts
@@ -0,0 +1,158 @@
+import { Router, type Request, type Response } from 'express';
+import { currentUser, requireAuth } from '../auth.js';
+import { badRequest } from '../errors.js';
+import {
+  audienceFor,
+  canRead,
+  effectiveDocumentRole,
+  requireDocumentAccess,
+  requireFolderAccess,
+} from '../permissions.js';
+import { publicDocument } from '../serialize.js';
+import { dropAllShares, newId, now, recordActivity, type Store } from '../store.js';
+import type { Document } from '../types.js';
+import { body, optionalString, requiredString } from '../validate.js';
+
+export function documentRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  const create = (req: Request, res: Response, folderIdFromPath?: string): void => {
+    const user = currentUser(req);
+    const payload = body(req.body);
+    const title = requiredString(payload, 'title');
+    const folderId =
+      folderIdFromPath ??
+      (typeof payload.folderId === 'string' && payload.folderId.trim().length > 0
+        ? payload.folderId.trim()
+        : requiredString(payload, 'folderId'));
+
+    // Adding a document to a folder is a modification of that folder.
+    requireFolderAccess(store, user.id, folderId, 'editor');
+
+    const content = optionalString(payload, 'content') ?? '';
+    const timestamp = now();
+    const doc: Document = {
+      id: newId(),
+      title,
+      content,
+      folderId,
+      ownerId: user.id,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    store.documents.set(doc.id, doc);
+    recordActivity(store, {
+      action: 'document.create',
+      userId: user.id,
+      resourceType: 'document',
+      resourceId: doc.id,
+      audience: audienceFor(store, 'document', doc.id),
+      details: { title: doc.title, folderId: doc.folderId },
+    });
+    res.status(201).json(publicDocument(doc, 'owner'));
+  };
+
+  router.post('/documents', (req, res) => create(req, res));
+  router.post('/folders/:folderId/documents', (req, res) => create(req, res, req.params.folderId));
+
+  router.get('/documents', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const folderFilter = typeof req.query.folderId === 'string' ? req.query.folderId : undefined;
+    const docs = [...store.documents.values()]
+      .filter((doc) => folderFilter === undefined || doc.folderId === folderFilter)
+      .filter((doc) => canRead(store, user.id, 'document', doc.id))
+      .map((doc) => publicDocument(doc, effectiveDocumentRole(store, user.id, doc.id)));
+    res.status(200).json(docs);
+  });
+
+  router.get('/folders/:folderId/documents', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    requireFolderAccess(store, user.id, req.params.folderId, 'viewer');
+    const docs = [...store.documents.values()]
+      .filter((doc) => doc.folderId === req.params.folderId)
+      .filter((doc) => canRead(store, user.id, 'document', doc.id))
+      .map((doc) => publicDocument(doc, effectiveDocumentRole(store, user.id, doc.id)));
+    res.status(200).json(docs);
+  });
+
+  router.get('/documents/:id', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { document, role } = requireDocumentAccess(store, user.id, req.params.id, 'viewer');
+    res.status(200).json(publicDocument(document, role));
+  });
+
+  const update = (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { document } = requireDocumentAccess(store, user.id, req.params.id, 'editor');
+    const payload = body(req.body);
+
+    // Validate and authorise everything up front: a rejected request must not
+    // leave the document half-updated.
+    const title = optionalString(payload, 'title')?.trim();
+    if (title !== undefined && title.length === 0) {
+      throw badRequest('"title" must be a non-empty string');
+    }
+    const content = optionalString(payload, 'content');
+
+    const requestedFolderId = optionalString(payload, 'folderId')?.trim();
+    let nextFolderId: string | undefined;
+    if (requestedFolderId !== undefined && requestedFolderId !== document.folderId) {
+      if (requestedFolderId.length === 0) throw badRequest('"folderId" must be a non-empty string');
+      // Relocating a document changes who inherits rights over it, so it takes
+      // ownership of the document plus the right to modify the destination.
+      requireDocumentAccess(store, user.id, document.id, 'owner');
+      requireFolderAccess(store, user.id, requestedFolderId, 'editor');
+      nextFolderId = requestedFolderId;
+    }
+
+    const changed: string[] = [];
+    if (title !== undefined) {
+      document.title = title;
+      changed.push('title');
+    }
+    if (content !== undefined) {
+      document.content = content;
+      changed.push('content');
+    }
+    if (nextFolderId !== undefined) {
+      document.folderId = nextFolderId;
+      changed.push('folderId');
+    }
+
+    if (changed.length > 0) {
+      document.updatedAt = now();
+      recordActivity(store, {
+        action: 'document.update',
+        userId: user.id,
+        resourceType: 'document',
+        resourceId: document.id,
+        audience: audienceFor(store, 'document', document.id),
+        details: { title: document.title, fields: changed },
+      });
+    }
+    res.status(200).json(publicDocument(document, effectiveDocumentRole(store, user.id, document.id)));
+  };
+  router.put('/documents/:id', update);
+  router.patch('/documents/:id', update);
+
+  router.delete('/documents/:id', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { document } = requireDocumentAccess(store, user.id, req.params.id, 'owner');
+    // Snapshot the audience while the document still exists, so the deletion
+    // stays visible to everyone who had access to it.
+    recordActivity(store, {
+      action: 'document.delete',
+      userId: user.id,
+      resourceType: 'document',
+      resourceId: document.id,
+      audience: audienceFor(store, 'document', document.id),
+      details: { title: document.title, folderId: document.folderId },
+    });
+    store.documents.delete(document.id);
+    dropAllShares(store, 'document', document.id);
+    res.status(204).end();
+  });
+
+  return router;
+}
diff --git a/src/routes/folders.ts b/src/routes/folders.ts
new file mode 100644
index 0000000..76ce5e9
--- /dev/null
+++ b/src/routes/folders.ts
@@ -0,0 +1,151 @@
+import { Router, type Request, type Response } from 'express';
+import { currentUser, requireAuth } from '../auth.js';
+import { badRequest, notFound } from '../errors.js';
+import {
+  audienceFor,
+  canRead,
+  descendantFolders,
+  effectiveDocumentRole,
+  effectiveFolderRole,
+  requireFolderAccess,
+} from '../permissions.js';
+import { publicDocument, publicFolder } from '../serialize.js';
+import { dropAllShares, newId, now, recordActivity, type Store } from '../store.js';
+import type { Folder } from '../types.js';
+import { body, optionalId, optionalString, requiredString } from '../validate.js';
+
+export function folderRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  router.post('/folders', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const payload = body(req.body);
+    const name = requiredString(payload, 'name');
+    const parentId = optionalId(payload, ['parentId', 'parentFolderId', 'parent']) ?? null;
+
+    if (parentId !== null) {
+      // Creating inside a folder requires the right to modify that folder.
+      requireFolderAccess(store, user.id, parentId, 'editor');
+    }
+
+    const timestamp = now();
+    const folder: Folder = {
+      id: newId(),
+      name,
+      parentId,
+      ownerId: user.id,
+      createdAt: timestamp,
+      updatedAt: timestamp,
+    };
+    store.folders.set(folder.id, folder);
+    res.status(201).json(publicFolder(folder, 'owner'));
+  });
+
+  router.get('/folders', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const parentFilter = typeof req.query.parentId === 'string' ? req.query.parentId : undefined;
+    const folders = [...store.folders.values()]
+      .filter((folder) => canRead(store, user.id, 'folder', folder.id))
+      .filter((folder) => {
+        if (parentFilter === undefined) return true;
+        if (parentFilter === '' || parentFilter === 'null' || parentFilter === 'root') {
+          return folder.parentId === null;
+        }
+        return folder.parentId === parentFilter;
+      })
+      .map((folder) => publicFolder(folder, effectiveFolderRole(store, user.id, folder.id)));
+    res.status(200).json(folders);
+  });
+
+  router.get('/folders/:id', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { folder, role } = requireFolderAccess(store, user.id, req.params.id, 'viewer');
+
+    const children = [...store.folders.values()]
+      .filter((f) => f.parentId === folder.id && canRead(store, user.id, 'folder', f.id))
+      .map((f) => publicFolder(f, effectiveFolderRole(store, user.id, f.id)));
+    const documents = [...store.documents.values()]
+      .filter((d) => d.folderId === folder.id && canRead(store, user.id, 'document', d.id))
+      .map((d) => publicDocument(d, effectiveDocumentRole(store, user.id, d.id)));
+
+    res.status(200).json({ ...publicFolder(folder, role), children, documents });
+  });
+
+  router.get('/folders/:id/children', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { folder } = requireFolderAccess(store, user.id, req.params.id, 'viewer');
+    const children = [...store.folders.values()]
+      .filter((f) => f.parentId === folder.id && canRead(store, user.id, 'folder', f.id))
+      .map((f) => publicFolder(f, effectiveFolderRole(store, user.id, f.id)));
+    res.status(200).json(children);
+  });
+
+  const update = (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { folder } = requireFolderAccess(store, user.id, req.params.id, 'editor');
+    const payload = body(req.body);
+
+    // Validate and authorise before mutating: a rejected request must leave the
+    // folder untouched.
+    const name = optionalString(payload, 'name')?.trim();
+    if (name !== undefined && name.length === 0) {
+      throw badRequest('"name" must be a non-empty string');
+    }
+
+    const parentId = optionalId(payload, ['parentId', 'parentFolderId', 'parent']);
+    const moving = parentId !== undefined && parentId !== folder.parentId;
+    if (moving) {
+      // Re-parenting rewires inheritance for the whole subtree, so it requires
+      // ownership of the folder itself as well as rights on the destination.
+      requireFolderAccess(store, user.id, folder.id, 'owner');
+      if (parentId !== null) {
+        if (parentId === folder.id) throw badRequest('A folder cannot be its own parent');
+        if (!store.folders.has(parentId)) throw notFound(`Folder ${parentId} not found`);
+        if (descendantFolders(store, folder.id).some((d) => d.id === parentId)) {
+          throw badRequest('A folder cannot be moved inside one of its own descendants');
+        }
+        requireFolderAccess(store, user.id, parentId, 'editor');
+      }
+    }
+
+    if (name !== undefined) folder.name = name;
+    if (moving) folder.parentId = parentId as string | null;
+
+    folder.updatedAt = now();
+    res.status(200).json(publicFolder(folder, effectiveFolderRole(store, user.id, folder.id)));
+  };
+  router.put('/folders/:id', update);
+  router.patch('/folders/:id', update);
+
+  router.delete('/folders/:id', (req: Request, res: Response): void => {
+    const user = currentUser(req);
+    const { folder } = requireFolderAccess(store, user.id, req.params.id, 'owner');
+
+    const doomedFolders = [folder, ...descendantFolders(store, folder.id)];
+    const doomedIds = new Set(doomedFolders.map((f) => f.id));
+
+    for (const doc of [...store.documents.values()]) {
+      if (!doomedIds.has(doc.folderId)) continue;
+      // Log before deleting so the audience snapshot is still accurate.
+      recordActivity(store, {
+        action: 'document.delete',
+        userId: user.id,
+        resourceType: 'document',
+        resourceId: doc.id,
+        audience: audienceFor(store, 'document', doc.id),
+        details: { title: doc.title, folderId: doc.folderId, cascade: true },
+      });
+      store.documents.delete(doc.id);
+      dropAllShares(store, 'document', doc.id);
+    }
+    for (const f of doomedFolders) {
+      store.folders.delete(f.id);
+      dropAllShares(store, 'folder', f.id);
+    }
+
+    res.status(204).end();
+  });
+
+  return router;
+}
diff --git a/src/routes/shares.ts b/src/routes/shares.ts
new file mode 100644
index 0000000..f0cb4f4
--- /dev/null
+++ b/src/routes/shares.ts
@@ -0,0 +1,117 @@
+import { Router, type Request, type Response } from 'express';
+import { currentUser, requireAuth } from '../auth.js';
+import { badRequest, forbidden } from '../errors.js';
+import { atLeast, effectiveRole, requireDocumentAccess, requireFolderAccess } from '../permissions.js';
+import { grantShare, listShares, parseRole, resolveTargetUser, revokeShare } from '../sharing.js';
+import type { Store } from '../store.js';
+import type { ResourceType } from '../types.js';
+import { body, firstString } from '../validate.js';
+
+function normalizeResourceType(value: unknown): ResourceType {
+  if (typeof value === 'string') {
+    const v = value.toLowerCase().replace(/s$/, '');
+    if (v === 'folder' || v === 'document') return v;
+  }
+  throw badRequest('"resourceType" must be either "folder" or "document"');
+}
+
+export function shareRoutes(store: Store): Router {
+  const router = Router();
+  router.use(requireAuth(store));
+
+  /** Ensures the resource exists and the caller may at least see it. */
+  const assertVisible = (userId: string, type: ResourceType, id: string): void => {
+    if (type === 'folder') requireFolderAccess(store, userId, id, 'viewer');
+    else requireDocumentAccess(store, userId, id, 'viewer');
+  };
+
+  const share = (req: Request, res: Response, type: ResourceType, resourceId: string): void => {
+    const actor = currentUser(req);
+    const payload = body(req.body);
+    const role = parseRole(payload.role ?? payload.permission ?? payload.accessLevel);
+    const target = resolveTargetUser(store, {
+      userId: firstString(payload, ['userId', 'targetUserId', 'user', 'id']),
+      username: firstString(payload, ['username', 'targetUsername', 'userName']),
+    });
+
+    const { created, share: result } = grantShare(store, actor, type, resourceId, target, role);
+    res.status(created ? 201 : 200).json({
+      ...result,
+      username: target.username,
+      shares: listShares(store, type, resourceId),
+    });
+  };
+
+  for (const path of ['/folders/:id/share', '/folders/:id/shares']) {
+    router.post(path, (req, res) => share(req, res, 'folder', req.params.id));
+  }
+  for (const path of ['/documents/:id/share', '/documents/:id/shares']) {
+    router.post(path, (req, res) => share(req, res, 'document', req.params.id));
+  }
+
+  // Generic endpoint: resource type and id supplied in the body.
+  router.post('/share', (req: Request, res: Response): void => {
+    const payload = body(req.body);
+    const type = normalizeResourceType(payload.resourceType ?? payload.type);
+    const resourceId = firstString(payload, ['resourceId', 'id', `${type}Id`]);
+    if (!resourceId) throw badRequest('"resourceId" is required');
+    share(req, res, type, resourceId);
+  });
+  router.post('/shares', (req: Request, res: Response): void => {
+    const payload = body(req.body);
+    const type = normalizeResourceType(payload.resourceType ?? payload.type);
+    const resourceId = firstString(payload, ['resourceId', 'id', `${type}Id`]);
+    if (!resourceId) throw badRequest('"resourceId" is required');
+    share(req, res, type, resourceId);
+  });
+
+  const list = (req: Request, res: Response, type: ResourceType): void => {
+    const actor = currentUser(req);
+    assertVisible(actor.id, type, req.params.id);
+    res.status(200).json(listShares(store, type, req.params.id));
+  };
+  router.get('/folders/:id/shares', (req, res) => list(req, res, 'folder'));
+  router.get('/folders/:id/share', (req, res) => list(req, res, 'folder'));
+  router.get('/documents/:id/shares', (req, res) => list(req, res, 'document'));
+  router.get('/documents/:id/share', (req, res) => list(req, res, 'document'));
+
+  const revoke = (req: Request, res: Response, type: ResourceType): void => {
+    const actor = currentUser(req);
+    const target = resolveTargetUser(store, {
+      userId: req.params.userId,
+      username: typeof req.query.username === 'string' ? req.query.username : undefined,
+    });
+    revokeShare(store, actor, type, req.params.id, target);
+    res.status(204).end();
+  };
+  router.delete('/folders/:id/shares/:userId', (req, res) => revoke(req, res, 'folder'));
+  router.delete('/folders/:id/share/:userId', (req, res) => revoke(req, res, 'folder'));
+  router.delete('/documents/:id/shares/:userId', (req, res) => revoke(req, res, 'document'));
+  router.delete('/documents/:id/share/:userId', (req, res) => revoke(req, res, 'document'));
+
+  // Effective permission of the caller, or of another user when the caller owns
+  // the resource — otherwise anyone could enumerate everyone else's access.
+  const effective = (req: Request, res: Response, type: ResourceType): void => {
+    const actor = currentUser(req);
+    assertVisible(actor.id, type, req.params.id);
+    const queried = typeof req.query.userId === 'string' ? req.query.userId : actor.id;
+    if (queried !== actor.id && !atLeast(effectiveRole(store, actor.id, type, req.params.id), 'owner')) {
+      throw forbidden("You need owner access to inspect another user's permissions");
+    }
+    const role = effectiveRole(store, queried, type, req.params.id);
+    res.status(200).json({
+      resourceType: type,
+      resourceId: req.params.id,
+      userId: queried,
+      role,
+      permission: role,
+      canRead: role !== null,
+      canWrite: role === 'editor' || role === 'owner',
+      canDelete: role === 'owner',
+    });
+  };
+  router.get('/folders/:id/permissions', (req, res) => effective(req, res, 'folder'));
+  router.get('/documents/:id/permissions', (req, res) => effective(req, res, 'document'));
+
+  return router;
+}
diff --git a/src/serialize.ts b/src/serialize.ts
new file mode 100644
index 0000000..879dbc2
--- /dev/null
+++ b/src/serialize.ts
@@ -0,0 +1,55 @@
+import type { ActivityEntry, Document, Folder, Role, User } from './types.js';
+
+export interface PublicUser {
+  id: string;
+  username: string;
+  createdAt: string;
+}
+
+export function publicUser(user: User): PublicUser {
+  return { id: user.id, username: user.username, createdAt: user.createdAt };
+}
+
+export function publicFolder(folder: Folder, role?: Role | null): Record<string, unknown> {
+  return {
+    id: folder.id,
+    name: folder.name,
+    parentId: folder.parentId,
+    // Alias kept for clients that use the longer name.
+    parentFolderId: folder.parentId,
+    ownerId: folder.ownerId,
+    type: 'folder',
+    createdAt: folder.createdAt,
+    updatedAt: folder.updatedAt,
+    ...(role ? { role, permission: role } : {}),
+  };
+}
+
+export function publicDocument(doc: Document, role?: Role | null): Record<string, unknown> {
+  return {
+    id: doc.id,
+    title: doc.title,
+    content: doc.content,
+    folderId: doc.folderId,
+    ownerId: doc.ownerId,
+    type: 'document',
+    createdAt: doc.createdAt,
+    updatedAt: doc.updatedAt,
+    ...(role ? { role, permission: role } : {}),
+  };
+}
+
+export function publicActivity(entry: ActivityEntry): Record<string, unknown> {
+  return {
+    id: entry.id,
+    action: entry.action,
+    // Alias so either naming convention works for consumers.
+    type: entry.action,
+    userId: entry.userId,
+    actorId: entry.userId,
+    resourceType: entry.resourceType,
+    resourceId: entry.resourceId,
+    timestamp: entry.timestamp,
+    details: entry.details,
+  };
+}
