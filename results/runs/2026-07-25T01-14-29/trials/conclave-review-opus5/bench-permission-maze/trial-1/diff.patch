+import { describe, expect, it, beforeEach } from 'vitest';
+import request from 'supertest';
+import type { Express } from 'express';
+import { createApp } from '../src/app.js';
+
+let app: Express;
+
+beforeEach(() => {
+  app = createApp();
+});
+
+async function register(username: string, password = 'secret123') {
+  const res = await request(app).post('/auth/register').send({ username, password });
+  expect(res.status).toBe(201);
+  return { id: res.body.id as string, token: res.body.token as string, username };
+}
+
+const bearer = (token: string) => ({ Authorization: `Bearer ${token}` });
+
+async function makeFolder(token: string, name: string, parentId?: string | null) {
+  const res = await request(app)
+    .post('/folders')
+    .set(bearer(token))
+    .send({ name, ...(parentId ? { parentId } : {}) });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+async function makeDoc(token: string, folderId: string, title: string, content = 'hello') {
+  const res = await request(app)
+    .post('/documents')
+    .set(bearer(token))
+    .send({ title, content, folderId });
+  expect(res.status).toBe(201);
+  return res.body;
+}
+
+describe('auth', () => {
+  it('registers a user and returns a token', async () => {
+    const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'pw' });
+    expect(res.status).toBe(201);
+    expect(res.body.username).toBe('alice');
+    expect(res.body.id).toBeTruthy();
+    expect(res.body.token).toBeTruthy();
+    expect(res.body.password).toBeUndefined();
+    expect(res.body.passwordHash).toBeUndefined();
+  });
+
+  it('rejects registration without credentials', async () => {
+    expect((await request(app).post('/auth/register').send({ username: 'a' })).status).toBe(400);
+    expect((await request(app).post('/auth/register').send({})).status).toBe(400);
+  });
+
+  it('rejects duplicate usernames', async () => {
+    await register('alice');
+    const res = await request(app).post('/auth/register').send({ username: 'alice', password: 'x' });
+    expect(res.status).toBe(409);
+  });
+
+  it('logs in with valid credentials and rejects bad ones', async () => {
+    await register('alice', 'hunter2');
+    const ok = await request(app).post('/auth/login').send({ username: 'alice', password: 'hunter2' });
+    expect(ok.status).toBe(200);
+    expect(ok.body.token).toBeTruthy();
+
+    const bad = await request(app).post('/auth/login').send({ username: 'alice', password: 'nope' });
+    expect(bad.status).toBe(401);
+
+    const missing = await request(app).post('/auth/login').send({ username: 'ghost', password: 'x' });
+    expect(missing.status).toBe(401);
+  });
+
+  it('supports the /login and /users aliases', async () => {
+    const reg = await request(app).post('/users').send({ username: 'bob', password: 'pw' });
+    expect(reg.status).toBe(201);
+    const login = await request(app).post('/login').send({ username: 'bob', password: 'pw' });
+    expect(login.status).toBe(200);
+  });
+
+  it('requires a valid token on protected routes', async () => {
+    expect((await request(app).get('/folders')).status).toBe(401);
+    expect((await request(app).get('/folders').set(bearer('garbage'))).status).toBe(401);
+  });
+});
+
+describe('folders', () => {
+  it('creates, reads, updates and deletes folders', async () => {
+    const alice = await register('alice');
+    const folder = await makeFolder(alice.token, 'Root');
+    expect(folder.name).toBe('Root');
+    expect(folder.parentId).toBeNull();
+    expect(folder.ownerId).toBe(alice.id);
+
+    const read = await request(app).get(`/folders/${folder.id}`).set(bearer(alice.token));
+    expect(read.status).toBe(200);
+    expect(read.body.name).toBe('Root');
+    expect(read.body.role).toBe('owner');
+
+    const updated = await request(app)
+      .patch(`/folders/${folder.id}`)
+      .set(bearer(alice.token))
+      .send({ name: 'Renamed' });
+    expect(updated.status).toBe(200);
+    expect(updated.body.name).toBe('Renamed');
+
+    const del = await request(app).delete(`/folders/${folder.id}`).set(bearer(alice.token));
+    expect(del.status).toBe(204);
+    expect((await request(app).get(`/folders/${folder.id}`).set(bearer(alice.token))).status).toBe(404);
+  });
+
+  it('nests folders and lists children', async () => {
+    const alice = await register('alice');
+    const root = await makeFolder(alice.token, 'Root');
+    const child = await makeFolder(alice.token, 'Child', root.id);
+    expect(child.parentId).toBe(root.id);
+
+    const res = await request(app).get(`/folders/${root.id}/children`).set(bearer(alice.token));
+    expect(res.status).toBe(200);
+    expect(res.body.map((f: { id: string }) => f.id)).toEqual([child.id]);
+  });
+
+  it('404s for unknown folders and 400s for invalid input', async () => {
+    const alice = await register('alice');
+    expect((await request(app).get('/folders/nope').set(bearer(alice.token))).status).toBe(404);
+    const bad = await request(app).post('/folders').set(bearer(alice.token)).send({ name: '  ' });
+    expect(bad.status).toBe(400);
+  });
+
+  it('hides folders from unrelated users', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const folder = await makeFolder(alice.token, 'Private');
+
+    expect((await request(app).get(`/folders/${folder.id}`).set(bearer(bob.token))).status).toBe(403);
+    const list = await request(app).get('/folders').set(bearer(bob.token));
+    expect(list.body).toEqual([]);
+  });
+
+  it('prevents cycles when re-parenting', async () => {
+    const alice = await register('alice');
+    const root = await makeFolder(alice.token, 'Root');
+    const child = await makeFolder(alice.token, 'Child', root.id);
+
+    const selfParent = await request(app)
+      .patch(`/folders/${root.id}`)
+      .set(bearer(alice.token))
+      .send({ parentId: root.id });
+    expect(selfParent.status).toBe(400);
+
+    const cycle = await request(app)
+      .patch(`/folders/${root.id}`)
+      .set(bearer(alice.token))
+      .send({ parentId: child.id });
+    expect(cycle.status).toBe(400);
+  });
+
+  it('cascades deletion to descendants', async () => {
+    const alice = await register('alice');
+    const root = await makeFolder(alice.token, 'Root');
+    const child = await makeFolder(alice.token, 'Child', root.id);
+    const doc = await makeDoc(alice.token, child.id, 'Nested');
+
+    expect((await request(app).delete(`/folders/${root.id}`).set(bearer(alice.token))).status).toBe(204);
+    expect((await request(app).get(`/folders/${child.id}`).set(bearer(alice.token))).status).toBe(404);
+    expect((await request(app).get(`/documents/${doc.id}`).set(bearer(alice.token))).status).toBe(404);
+  });
+});
+
+describe('documents', () => {
+  it('creates documents in a folder via both route shapes', async () => {
+    const alice = await register('alice');
+    const folder = await makeFolder(alice.token, 'Root');
+
+    const a = await makeDoc(alice.token, folder.id, 'Doc A');
+    expect(a.title).toBe('Doc A');
+    expect(a.folderId).toBe(folder.id);
+    expect(a.ownerId).toBe(alice.id);
+
+    const b = await request(app)
+      .post(`/folders/${folder.id}/documents`)
+      .set(bearer(alice.token))
+      .send({ title: 'Doc B', content: 'text' });
+    expect(b.status).toBe(201);
+    expect(b.body.folderId).toBe(folder.id);
+  });
+
+  it('validates document creation', async () => {
+    const alice = await register('alice');
+    const folder = await makeFolder(alice.token, 'Root');
+
+    expect(
+      (await request(app).post('/documents').set(bearer(alice.token)).send({ folderId: folder.id }))
+        .status,
+    ).toBe(400);
+    expect(
+      (await request(app).post('/documents').set(bearer(alice.token)).send({ title: 'x' })).status,
+    ).toBe(400);
+    expect(
+      (
+        await request(app)
+          .post('/documents')
+          .set(bearer(alice.token))
+          .send({ title: 'x', folderId: 'missing' })
+      ).status,
+    ).toBe(404);
+  });
+
+  it('updates and deletes documents', async () => {
+    const alice = await register('alice');
+    const folder = await makeFolder(alice.token, 'Root');
+    const doc = await makeDoc(alice.token, folder.id, 'Doc');
+
+    const updated = await request(app)
+      .put(`/documents/${doc.id}`)
+      .set(bearer(alice.token))
+      .send({ content: 'updated body' });
+    expect(updated.status).toBe(200);
+    expect(updated.body.content).toBe('updated body');
+    expect(updated.body.title).toBe('Doc');
+
+    expect((await request(app).delete(`/documents/${doc.id}`).set(bearer(alice.token))).status).toBe(204);
+    expect((await request(app).get(`/documents/${doc.id}`).set(bearer(alice.token))).status).toBe(404);
+  });
+
+  it('denies access to users without a share', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const folder = await makeFolder(alice.token, 'Root');
+    const doc = await makeDoc(alice.token, folder.id, 'Doc');
+
+    expect((await request(app).get(`/documents/${doc.id}`).set(bearer(bob.token))).status).toBe(403);
+    expect(
+      (await request(app).put(`/documents/${doc.id}`).set(bearer(bob.token)).send({ content: 'x' }))
+        .status,
+    ).toBe(403);
+    expect((await request(app).delete(`/documents/${doc.id}`).set(bearer(bob.token))).status).toBe(403);
+  });
+});
+
+describe('sharing and permissions', () => {
+  it('grants a viewer read-only access', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const folder = await makeFolder(alice.token, 'Root');
+    const doc = await makeDoc(alice.token, folder.id, 'Doc');
+
+    const shared = await request(app)
+      .post(`/documents/${doc.id}/share`)
+      .set(bearer(alice.token))
+      .send({ userId: bob.id, role: 'viewer' });
+    expect(shared.status).toBe(201);
+
+    const read = await request(app).get(`/documents/${doc.id}`).set(bearer(bob.token));
+    expect(read.status).toBe(200);
+    expect(read.body.role).toBe('viewer');
+
+    const write = await request(app)
+      .put(`/documents/${doc.id}`)
+      .set(bearer(bob.token))
+      .send({ content: 'nope' });
+    expect(write.status).toBe(403);
+    expect((await request(app).delete(`/documents/${doc.id}`).set(bearer(bob.token))).status).toBe(403);
+  });
+
+  it('lets editors modify and re-share but not delete', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const carol = await register('carol');
+    const folder = await makeFolder(alice.token, 'Root');
+    const doc = await makeDoc(alice.token, folder.id, 'Doc');
+
+    await request(app)
+      .post(`/documents/${doc.id}/share`)
+      .set(bearer(alice.token))
+      .send({ username: 'bob', role: 'editor' })
+      .expect(201);
+
+    expect(
+      (await request(app).put(`/documents/${doc.id}`).set(bearer(bob.token)).send({ content: 'ok' }))
+        .status,
+    ).toBe(200);
+    expect((await request(app).delete(`/documents/${doc.id}`).set(bearer(bob.token))).status).toBe(403);
+
+    // An editor may share, but not hand out ownership.
+    const reshare = await request(app)
+      .post(`/documents/${doc.id}/share`)
+      .set(bearer(bob.token))
+      .send({ userId: carol.id, role: 'viewer' });
+    expect(reshare.status).toBe(201);
+
+    const escalate = await request(app)
+      .post(`/documents/${doc.id}/share`)
+      .set(bearer(bob.token))
+      .send({ userId: carol.id, role: 'owner' });
+    expect(escalate.status).toBe(403);
+  });
+
+  it('inherits permissions from ancestor folders', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const root = await makeFolder(alice.token, 'Root');
+    const child = await makeFolder(alice.token, 'Child', root.id);
+    const grandchild = await makeFolder(alice.token, 'Grandchild', child.id);
+    const doc = await makeDoc(alice.token, grandchild.id, 'Deep');
+
+    expect((await request(app).get(`/documents/${doc.id}`).set(bearer(bob.token))).status).toBe(403);
+
+    await request(app)
+      .post(`/folders/${root.id}/share`)
+      .set(bearer(alice.token))
+      .send({ userId: bob.id, role: 'viewer' })
+      .expect(201);
+
+    const read = await request(app).get(`/documents/${doc.id}`).set(bearer(bob.token));
+    expect(read.status).toBe(200);
+    expect(read.body.role).toBe('viewer');
+    expect((await request(app).get(`/folders/${grandchild.id}`).set(bearer(bob.token))).status).toBe(200);
+  });
+
+  it('uses the most permissive role across multiple paths', async () => {
+    const alice = await register('alice');
+    const bob = await register('bob');
+    const root = await makeFolder(alice.token, 'Root');
+    const doc = await makeDoc(alice.token, root.id, 'Doc');
+
+    await request(app)
+      .post(`/folders/${root.id}/share`)
+      .set(bearer(alice.token))
+      .send({ userId: bob.id, role: 'viewer' })
+      .expect(201);
+    await request(app)
+      .post(`/documents/${doc.id}/share`)
+      .set(bearer(alice.token))
+      .send({ userId: bob.id, role: 'editor' })
+      .expect(201);
+
+    const perms = await request(app).get(`/documents/${doc.id}/permissions`).set(bearer(bob.token));
+    expect(perms.body.role).toBe('editor');
+    expect(
+      (await request(app).put(`/documents/${doc.id}`).set(bearer(bob.token)).send({ content: 'y' }))
+        .status,
+    ).toBe(200);
+  });
+
+  it('does not downgrade when a less permissive share is added elsewhere', async () => {
