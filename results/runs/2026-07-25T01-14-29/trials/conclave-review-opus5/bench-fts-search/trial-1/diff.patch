st insert = db.prepare(`\n     INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\ndiff --git a/src/routes.ts b/src/routes.ts\nindex 013b2dc..0f977aa 100644\n--- a/src/routes.ts\n+++ b/src/routes.ts\n@@ -2,10 +2,15 @@ import { Router, Request, Response, NextFunction } from 'express';\n import Database from 'better-sqlite3';\n import { Note, NoteInput } from './models.js';\n import { NotFoundError, ValidationError } from './errors.js';\n+import { createSearchRoutes } from './search.js';\n \n export function createRoutes(db: Database.Database): Router {\n   const router = Router();\n \n+  // Search routes must be registered before /notes/:id so that \"search\" is not\n+  // swallowed by the :id parameter.\n+  router.use(createSearchRoutes(db));\n+\n   // GET /notes - List all notes (with optional tag filter)\n   router.get('/notes', (req: Request, res: Response, next: NextFunction) => {\n     try {\ndiff --git a/src/search.ts b/src/search.ts\nnew file mode 100644\nindex 0000000..1dba820\n--- /dev/null\n+++ b/src/search.ts\n@@ -0,0 +1,143 @@\n+import { Router, Request, Response, NextFunction } from 'express';\n+import Database from 'better-sqlite3';\n+import { SearchResult, SuggestResult } from './models.js';\n+import { ValidationError } from './errors.js';\n+\n+export const PER_PAGE = 20;\n+export const SUGGEST_LIMIT = 5;\n+\n+// Title matches count for more than body matches when ranking.\n+const TITLE_WEIGHT = 10.0;\n+const BODY_WEIGHT = 1.0;\n+\n+/**\n+ * Splits arbitrary user text into the same kind of tokens the unicode61\n+ * tokenizer produces. Everything that is not a letter, digit or underscore is a\n+ * separator, so no FTS5 operator or quote character can survive into the query.\n+ */\n+function tokenize(text: string): string[] {\n+  return text.toLowerCase().match(/[\\p{L}\\p{N}_]+/gu) ?? [];\n+}\n+\n+/**\n+ * Translates a user query into a safe FTS5 MATCH expression.\n+ *\n+ * Double-quoted runs become phrase queries; everything else becomes individual\n+ * terms that must all be present. Returns null when the query contains nothing\n+ * searchable (e.g. `?q=***`), in which case the caller should report no matches\n+ * rather than running a query.\n+ */\n+export function buildMatchQuery(raw: string, prefixLastTerm = false): string | null {\n+  const terms: string[] = [];\n+\n+  // Pull out quoted phrases first so their internal spaces are preserved.\n+  const unquoted = raw.replace(/\"([^\"]*)\"/g, (_match, phrase: string) => {\n+    const words = tokenize(phrase);\n+    if (words.length > 0) {\n+      terms.push(`\"${words.join(' ')}\"`);\n+    }\n+    return ' ';\n+  });\n+\n+  for (const word of tokenize(unquoted)) {\n+    terms.push(`\"${word}\"`);\n+  }\n+\n+  if (terms.length === 0) {\n+    return null;\n+  }\n+\n+  if (prefixLastTerm) {\n+    terms[terms.length - 1] += '*';\n+  }\n+\n+  return terms.join(' AND ');\n+}\n+\n+function requireQuery(req: Request): string {\n+  // Express yields an array when the parameter is repeated (?q=a&q=b).\n+  const raw = Array.isArray(req.query.q) ? req.query.q[0] : req.query.q;\n+  const q = typeof raw === 'string' ? raw.trim() : '';\n+\n+  if (q === '') {\n+    throw new ValidationError('Query parameter \"q\" is required');\n+  }\n+\n+  return q;\n+}\n+\n+function parsePage(raw: unknown): number {\n+  const page = parseInt(String(raw ?? ''), 10);\n+  return Number.isFinite(page) && page > 0 ? page : 1;\n+}\n+\n+export function createSearchRoutes(db: Database.Database): Router {\n+  const router = Router();\n+\n+  const countStmt = db.prepare(`\n+    SELECT COUNT(*) AS total FROM notes_fts WHERE notes_fts MATCH ?\n+  `);\n+\n+  const searchStmt = db.prepare(`\n+    SELECT\n+      notes.id AS id,\n+      notes.title AS title,\n+      snippet(notes_fts, -1, '<mark>', '</mark>', '…', 32) AS snippet,\n+      bm25(notes_fts, ${TITLE_WEIGHT}, ${BODY_WEIGHT}) AS rank\n+    FROM notes_fts\n+    JOIN notes ON notes.id = notes_fts.rowid\n+    WHERE notes_fts MATCH ?\n+    ORDER BY bm25(notes_fts, ${TITLE_WEIGHT}, ${BODY_WEIGHT}), notes.id\n+    LIMIT ? OFFSET ?\n+  `);\n+\n+  const suggestStmt = db.prepare(`\n+    SELECT notes.id AS id, notes.title AS title\n+    FROM notes_fts\n+    JOIN notes ON notes.id = notes_fts.rowid\n+    WHERE notes_fts MATCH ?\n+    ORDER BY bm25(notes_fts, ${TITLE_WEIGHT}, ${BODY_WEIGHT}), notes.id\n+    LIMIT ?\n+  `);\n+\n+  // GET /notes/search?q=<query>&page=<n> - full-text search\n+  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n+    try {\n+      const q = requireQuery(req);\n+      const page = parsePage(req.query.page);\n+      const match = buildMatchQuery(q);\n+\n+      if (match === null) {\n+        res.json({ results: [], total: 0, page, perPage: PER_PAGE });\n+        return;\n+      }\n+\n+      const { total } = countStmt.get(match) as { total: number };\n+      const results = searchStmt.all(match, PER_PAGE, (page - 1) * PER_PAGE) as SearchResult[];\n+\n+      res.json({ results, total, page, perPage: PER_PAGE });\n+    } catch (err) {\n+      next(err);\n+    }\n+  });\n+\n+  // GET /notes/search/suggest?q=<prefix> - autocomplete over note content\n+  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n+    try {\n+      const q = requireQuery(req);\n+      const match = buildMatchQuery(q, true);\n+\n+      if (match === null) {\n+        res.json({ results: [] });\n+        return;\n+      }\n+\n+      const results = suggestStmt.all(match, SUGGEST_LIMIT) as SuggestResult[];\n+      res.json({ results });\n+    } catch (err) {\n+      next(err);\n+    }\n+  });\n+\n+  return router;\n+}","is_error":false}]},"parent_tool_use_id":"toolu_01Mc2ZxQ1q3mW5bdKqsQ3WTR","session_id":"43d1e346-7b84-459f-9add-449e61bb9053","uuid":"1ef9424a-ded3-48bc-b69e-f2357e002cb7","timestamp":"2026-07-25T01:17:29.324Z","subagent_type":"conclave:code-reviewer","task_description":"Review FTS search implementation"}
