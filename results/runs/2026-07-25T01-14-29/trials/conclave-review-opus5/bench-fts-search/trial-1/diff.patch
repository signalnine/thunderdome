+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CFxeMNyJk7YwQczJnje1eq","type":"tool_result","content":"The file /workspace/src/db.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"43d1e346-7b84-459f-9add-449e61bb9053","uuid":"47170a81-1264-4c61-9147-9600a3a89005","timestamp":"2026-07-25T01:22:22.232Z","tool_use_result":{"filePath":"/workspace/src/db.ts","oldString":"  // A pre-existing database may already hold notes that were never indexed.\n  if (!alreadyIndexed) {\n    db.exec(\"INSERT INTO notes_fts (notes_fts) VALUES ('rebuild')\");\n  }\n}","newString":"  // A freshly created index holds nothing, and an index carried over from an\n  // earlier run may have drifted from `notes` (e.g. writes made while the\n  // triggers were missing). Either way, rebuilding restores a correct index.\n  if (!alreadyIndexed || !ftsIndexMatchesNotes(db)) {\n    db.exec(\"INSERT INTO notes_fts (notes_fts) VALUES ('rebuild')\");\n  }\n}\n\n/**\n * Verifies the FTS index against the contents of `notes`. The `rank = 1`\n * argument is what makes integrity-check compare the index to the external\n * content table rather than only checking the index's internal consistency.\n * Any failure - including SQLite builds too old to accept the argument - is\n * reported as a mismatch so the caller rebuilds.\n */\nfunction ftsIndexMatchesNotes(db: Database.Database): boolean {\n  try {\n    db.prepare(\"INSERT INTO notes_fts (notes_fts, rank) VALUES ('integrity-check', 1)\").run();\n    return true;\n  } catch {\n    return false;\n  }\n}","originalFile":"import Database from 'better-sqlite3';\n\nexport function createDatabase(path?: string): Database.Database {\n  const db = path ? new Database(path) : new Database(':memory:');\n\n  db.pragma('journal_mode = WAL');\n  db.pragma('foreign_keys = ON');\n\n  // Create notes table\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS notes (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      title TEXT NOT NULL,\n      body TEXT NOT NULL,\n      tags TEXT DEFAULT '[]',\n      created_at TEXT DEFAULT (datetime('now')),\n      updated_at TEXT DEFAULT (datetime('now'))\n    )\n  `);\n\n  createFtsIndex(db);\n\n  return db;\n}\n\n/**\n * Creates the FTS5 index over notes(title, body) plus the triggers that keep it\n * in sync with the base table. The index is an external-content table, so it\n * stores only the inverted index and reads document text back from `notes`.\n */\nfunction createFtsIndex(db: Database.Database): void {\n  const alreadyIndexed = db\n    .prepare(\"SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'notes_fts'\")\n    .get();\n\n  db.exec(`\n    CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts USING fts5(\n      title,\n      body,\n      content = 'notes',\n      content_rowid = 'id',\n      tokenize = 'unicode61'\n    );\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_ai AFTER INSERT ON notes BEGIN\n      INSERT INTO notes_fts (rowid, title, body) VALUES (new.id, new.title, new.body);\n    END;\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_ad AFTER DELETE ON notes BEGIN\n      INSERT INTO notes_fts (notes_fts, rowid, title, body)\n        VALUES ('delete', old.id, old.title, old.body);\n    END;\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_au AFTER UPDATE ON notes BEGIN\n      INSERT INTO notes_fts (notes_fts, rowid, title, body)\n        VALUES ('delete', old.id, old.title, old.body);\n      INSERT INTO notes_fts (rowid, title, body) VALUES (new.id, new.title, new.body);\n    END;\n  `);\n\n  // A pre-existing database may already hold notes that were never indexed.\n  if (!alreadyIndexed) {\n    db.exec(\"INSERT INTO notes_fts (notes_fts) VALUES ('rebuild')\");\n  }\n}\n\nexport function seedDatabase(db: Database.Database): void {\n  const insert = db.prepare(`\n    INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n  `);\n\n  const notes = getSeedNotes();\n\n  const insertMany = db.transaction((items: { title: string; body: string; tags: string }[]) => {\n    for (const item of items) {\n      insert.run(item.title, item.body, item.tags);\n    }\n  });\n\n  insertMany(notes);\n}\n\nfunction getSeedNotes(): { title: string; body: string; tags: string }[] {\n  return [\n    {\n      title: 'Getting Started with TypeScript',\n      body: 'TypeScript is a typed superset of JavaScript that compiles to plain JavaScript. It adds optional static typing and class-based object-oriented programming to the language. TypeScript is designed for development of large applications and transcompiles to JavaScript.',\n      tags: JSON.stringify(['programming', 'typescript', 'javascript']),\n    },\n    {\n      title: 'Introduction to Python Programming',\n      body: 'Python is a high-level, interpreted programming language known for its simplicity and readability. It supports multiple programming paradigms including procedural, object-oriented, and functional programming. Python is widely used in web development, data science, and automation.',\n      tags: JSON.stringify(['programming', 'python']),\n    },\n    {\n      title: 'Understanding Database Indexing',\n      body: 'Database indexing is a data structure technique used to quickly locate and access data in a database. Indexes are created using columns that are frequently searched against. Without an index, the database must scan every row to find relevant data, which becomes slow for large tables.',\n      tags: JSON.stringify(['database', 'performance']),\n    },\n    {\n      title: 'Homemade Pasta Recipe',\n      body: 'Making fresh pasta at home is surprisingly simple. You need flour, eggs, salt, and olive oil. Mix the ingredients to form a dough, knead for 10 minutes until smooth, rest for 30 minutes, then roll out and cut into your desired shape. Cook in boiling salted water for 2-3 minutes.',\n      tags: JSON.stringify(['cooking', 'recipes', 'italian']),\n    },\n    {\n      title: 'Classic Chocolate Chip Cookies',\n      body: 'The perfect chocolate chip cookie requires butter, sugar, brown sugar, eggs, vanilla extract, flour, baking soda, salt, and chocolate chips. Cream the butter and sugars, add eggs and vanilla, mix in dry ingredients, fold in chocolate chips, and bake at 375°F for 9-11 minutes.',\n      tags: JSON.stringify(['cooking', 'recipes', 'baking']),\n    },\n    {\n      title: 'Travel Guide: Tokyo Japan',\n      body: 'Tokyo is a fascinating blend of ultramodern and traditional. Visit the ancient Senso-ji temple, explore the bustling streets of Shibuya, enjoy fresh sushi at Tsukiji fish market, and experience the tranquility of Meiji Shrine. The best time to visit is during cherry blossom season in spring.',\n      tags: JSON.stringify(['travel', 'japan', 'asia']),\n    },\n    {\n      title: 'Exploring Paris France',\n      body: 'Paris, the City of Light, offers world-class museums like the Louvre, iconic landmarks like the Eiffel Tower, charming neighborhoods like Montmartre, and exquisite cuisine. Stroll along the Seine, visit Notre-Dame Cathedral, and enjoy croissants at a sidewalk cafe.',\n      tags: JSON.stringify(['travel', 'france', 'europe']),\n    },\n    {\n      title: 'Quantum Computing Basics',\n      body: 'Quantum computing leverages quantum mechanical phenomena like superposition and entanglement to process information. Unlike classical bits that are either 0 or 1, quantum bits (qubits) can exist in multiple states simultaneously. This enables quantum computers to solve certain problems exponentially faster.',\n      tags: JSON.stringify(['science', 'computing', 'physics']),\n    },\n    {\n      title: 'The Solar System Overview',\n      body: 'Our solar system consists of the Sun and everything that orbits it, including eight planets, dwarf planets, moons, asteroids, and comets. The inner planets (Mercury, Venus, Earth, Mars) are rocky, while the outer planets (Jupiter, Saturn, Uranus, Neptune) are gas or ice giants.',\n      tags: JSON.stringify(['science', 'astronomy', 'space']),\n    },\n    {\n      title: 'Learning Guitar for Beginners',\n      body: 'Starting guitar requires patience and practice. Begin with basic open chords like G, C, D, E minor, and A minor. Practice transitioning between chords smoothly. Learn simple strumming patterns and work on finger strength. Playing just 15 minutes daily will show remarkable progress within weeks.',\n      tags: JSON.stringify(['music', 'guitar', 'learning']),\n    },\n    {\n      title: 'History of Jazz Music',\n      body: 'Jazz originated in the African-American communities of New Orleans in the late 19th and early 20th centuries. It blends elements of blues, ragtime, and European harmony. Key figures include Louis Armstrong, Duke Ellington, Charlie Parker, and Miles Davis. Jazz has evolved through many styles including swing, bebop, and fusion.',\n      tags: JSON.stringify(['music', 'history', 'jazz']),\n    },\n    {\n      title: 'React Hooks Deep Dive',\n      body: 'React Hooks allow you to use state and other React features without writing class components. useState manages local state, useEffect handles side effects, useContext accesses context, and useMemo optimizes performance. Custom hooks let you extract reusable stateful logic.',\n      tags: JSON.stringify(['programming', 'react', 'javascript']),\n    },\n    {\n      title: 'Docker Container Essentials',\n      body: 'Docker containers package applications with their dependencies into standardized units for development, shipment, and deployment. Containers are lightweight, portable, and consistent across environments. Key concepts include images, containers, volumes, networks, and docker-compose for multi-container applications.',\n      tags: JSON.stringify(['programming', 'devops', 'docker']),\n    },\n    {\n      title: 'Mediterranean Diet Benefits',\n      body: 'The Mediterranean diet emphasizes fruits, vegetables, whole grains, legumes, nuts, and olive oil. It includes moderate amounts of fish, poultry, and dairy, with limited red meat. Studies show it reduces risk of heart disease, stroke, type 2 diabetes, and cognitive decline.',\n      tags: JSON.stringify(['health', 'nutrition', 'diet']),\n    },\n    {\n      title: 'Yoga for Stress Relief',\n      body: 'Yoga combines physical postures, breathing exercises, and meditation to promote relaxation and reduce stress. Regular practice improves flexibility, strength, and mental clarity. Beginner-friendly poses include child pose, downward dog, warrior I and II, and tree pose.',\n      tags: JSON.stringify(['health', 'fitness', 'yoga']),\n    },\n    {\n      title: 'Machine Learning Fundamentals',\n      body: 'Machine learning is a subset of artificial intelligence where algorithms learn patterns from data without being explicitly programmed. Key types include supervised learning (classification, regression), unsupervised learning (clustering), and reinforcement learning. Popular frameworks include TensorFlow, PyTorch, and scikit-learn.',\n      tags: JSON.stringify(['programming', 'ai', 'machine-learning']),\n    },\n    {\n      title: 'Backpacking Through Southeast Asia',\n      body: 'Southeast Asia offers incredible backpacking experiences on a budget. Visit ancient temples in Cambodia, pristine beaches in Thailand, rice terraces in Vietnam, and vibrant cities in Malaysia. Budget around $30-50 per day for accommodation, food, and transport.',\n      tags: JSON.stringify(['travel', 'asia', 'backpacking']),\n    },\n    {\n      title: 'Sourdough Bread Baking Guide',\n      body: 'Sourdough bread requires a mature starter, flour, water, and salt. The process involves mixing, autolyse, bulk fermentation with stretch and folds, shaping, cold retard overnight, and baking in a Dutch oven. The natural fermentation creates complex flavors and better digestibility.',\n      tags: JSON.stringify(['cooking', 'baking', 'bread']),\n    },\n    {\n      title: 'Introduction to Rust Programming',\n      body: 'Rust is a systems programming language focused on safety, speed, and concurrency. Its ownership system prevents null pointer dereferences, dangling pointers, and data races at compile time. Rust is ideal for performance-critical applications, web assembly, and embedded systems.',\n      tags: JSON.stringify(['programming', 'rust', 'systems']),\n    },\n    {\n      title: 'Climate Change and Renewable Energy',\n      body: 'Renewable energy sources like solar, wind, hydroelectric, and geothermal are essential for combating climate change. Solar panel costs have dropped 89% since 2010. Wind energy is the fastest-growing power source globally. Transitioning to renewables can significantly reduce greenhouse gas emissions.',\n      tags: JSON.stringify(['science', 'environment', 'energy']),\n    },\n    {\n      title: 'Photography Composition Techniques',\n      body: 'Great photography relies on strong composition. The rule of thirds places subjects at grid intersections. Leading lines guide the viewer eye. Framing uses natural elements to surround the subject. Symmetry creates balance. Negative space emphasizes the main subject by leaving empty areas.',\n      tags: JSON.stringify(['photography', 'art', 'techniques']),\n    },\n    {\n      title: 'GraphQL vs REST API Design',\n      body: 'GraphQL lets clients request exactly the data they need in a single query, reducing over-fetching and under-fetching common with REST. REST uses multiple endpoints with fixed data structures. GraphQL has a single endpoint with a flexible query language. Both have tradeoffs in caching, complexity, and tooling.',\n      tags: JSON.stringify(['programming', 'api', 'web']),\n    },\n    {\n      title: 'The Art of French Cooking',\n      body: 'French cuisine is built on foundational techniques: the five mother sauces (bechamel, veloute, espagnole, hollandaise, tomato), proper knife skills, stock making, and mastering heat control. Classic dishes include coq au vin, beef bourguignon, ratatouille, and creme brulee.',\n      tags: JSON.stringify(['cooking', 'french', 'techniques']),\n    },\n    {\n      title: 'Hiking the Appalachian Trail',\n      body: 'The Appalachian Trail stretches 2,190 miles from Georgia to Maine through 14 states. Thru-hiking takes 5-7 months. Section hiking is popular for those with less time. Essential gear includes a quality backpack, lightweight tent, sleeping bag, water filter, and proper hiking boots.',\n      tags: JSON.stringify(['travel', 'hiking', 'outdoors']),\n    },\n    {\n      title: 'Kubernetes Orchestration Guide',\n      body: 'Kubernetes automates deployment, scaling, and management of containerized applications. Key concepts include pods, services, deployments, namespaces, and ingress controllers. Kubernetes provides self-healing, horizontal scaling, rolling updates, and service discovery out of the box.',\n      tags: JSON.stringify(['programming', 'devops', 'kubernetes']),\n    },\n    {\n      title: 'Classical Music Appreciation',\n      body: 'Classical music spans centuries from Bach and Handel through Mozart and Beethoven to modern composers. The orchestra typically includes strings, woodwinds, brass, and percussion sections. Major forms include symphonies, concertos, sonatas, and operas. Listening actively to different sections enhances appreciation.',\n      tags: JSON.stringify(['music', 'classical', 'culture']),\n    },\n    {\n      title: 'Effective Public Speaking',\n      body: 'Great public speakers master preparation, delivery, and audience engagement. Structure talks with a hook, three main points, and a memorable closing. Use pauses for emphasis, vary your tone, maintain eye contact, and use gestures naturally. Practice extensively and seek feedback.',\n      tags: JSON.stringify(['communication', 'skills', 'career']),\n    },\n    {\n      title: 'Indoor Plant Care Essentials',\n      body: 'Successful indoor gardening requires understanding light, water, and soil needs. Low-light plants like pothos and snake plants are great for beginners. Water when the top inch of soil is dry. Use well-draining potting mix. Fertilize monthly during growing season. Monitor for pests regularly.',\n      tags: JSON.stringify(['gardening', 'plants', 'home']),\n    },\n    {\n      title: 'SQLite Full-Text Search Tutorial',\n      body: 'SQLite FTS5 provides powerful full-text search capabilities. Create a virtual table using FTS5, insert content, and query using the MATCH operator. FTS5 supports phrase queries, prefix queries, boolean operators, and ranking with BM25. Snippet extraction highlights matching terms in results.',\n      tags: JSON.stringify(['programming', 'database', 'sqlite']),\n    },\n    {\n      title: 'Mindfulness Meditation Practice',\n      body: 'Mindfulness meditation involves focusing attention on the present moment without judgment. Start with 5-minute sessions, focusing on breath. When thoughts arise, acknowledge them and return to breathing. Regular practice reduces anxiety, improves focus, and promotes emotional resilience.',\n      tags: JSON.stringify(['health', 'meditation', 'wellness']),\n    },\n    {\n      title: 'Web Accessibility Standards',\n      body: 'Web accessibility ensures websites are usable by people with disabilities. Follow WCAG guidelines: provide alt text for images, ensure keyboard navigation, use semantic HTML, maintain sufficient color contrast, add ARIA labels, and test with screen readers. Accessibility benefits all users.',\n      tags: JSON.stringify(['programming', 'web', 'accessibility']),\n    },\n    {\n      title: 'Italian Risotto Masterclass',\n      body: 'Perfect risotto requires Arborio or Carnaroli rice, warm stock, patience, and constant stirring. Toast the rice in butter, add wine, then ladle warm stock gradually while stirring. The starch releases slowly, creating a creamy texture. Finish with butter and Parmigiano-Reggiano.',\n      tags: JSON.stringify(['cooking', 'italian', 'recipes']),\n    },\n    {\n      title: 'Artificial Neural Networks Explained',\n      body: 'Neural networks are computing systems inspired by biological neural networks. They consist of layers of interconnected nodes (neurons) that process information. Deep learning uses many hidden layers to learn hierarchical representations. Applications include image recognition, natural language processing, and autonomous vehicles.',\n      tags: JSON.stringify(['programming', 'ai', 'deep-learning']),\n    },\n    {\n      title: 'Sustainable Living Tips',\n      body: 'Reduce your environmental footprint by minimizing single-use plastics, composting food waste, choosing renewable energy, buying local produce, reducing water usage, and using public transport or cycling. Small daily choices collectively make a significant environmental impact.',\n      tags: JSON.stringify(['environment', 'lifestyle', 'sustainability']),\n    },\n    {\n      title: 'Chess Strategy for Intermediates',\n      body: 'Improve your chess by studying openings, understanding pawn structure, controlling the center, developing pieces early, and thinking several moves ahead. Learn tactical patterns like pins, forks, skewers, and discovered attacks. Analyze your games to identify mistakes and patterns.',\n      tags: JSON.stringify(['games', 'chess', 'strategy']),\n    },\n    {\n      title: 'RESTful API Best Practices',\n      body: 'Design RESTful APIs with consistent naming conventions, proper HTTP methods (GET, POST, PUT, DELETE), meaningful status codes, pagination for collections, versioning, authentication, and comprehensive error responses. Use JSON for request and response bodies. Document with OpenAPI specification.',\n      tags: JSON.stringify(['programming', 'api', 'rest']),\n    },\n    {\n      title: 'Nordic Hiking Adventures',\n      body: 'Scandinavia offers breathtaking hiking through fjords, mountains, and arctic landscapes. Norway Trolltunga and Preikestolen are iconic. Sweden Kungsleden trail spans 270 miles. Finland offers midnight sun hiking in summer. Pack layers, waterproof gear, and be prepared for rapidly changing weather.',\n      tags: JSON.stringify(['travel', 'hiking', 'europe']),\n    },\n    {\n      title: 'Espresso Brewing Techniques',\n      body: 'Perfect espresso requires freshly roasted beans, proper grind size, correct dose (18-20g), consistent tamping pressure, water temperature around 200°F, and 25-30 second extraction time. The result should be a balanced shot with a rich crema layer. Adjust grind size to control flow rate.',\n      tags: JSON.stringify(['cooking', 'coffee', 'techniques']),\n    },\n    {\n      title: 'Version Control with Git',\n      body: 'Git is the most widely used version control system. Key commands include init, clone, add, commit, push, pull, branch, merge, and rebase. Use feature branches for development, pull requests for code review, and tags for releases. Write meaningful commit messages that explain why changes were made.',\n      tags: JSON.stringify(['programming', 'git', 'tools']),\n    },\n    {\n      title: 'The Science of Sleep',\n      body: 'Quality sleep is essential for health. Adults need 7-9 hours nightly. Sleep cycles through stages including light sleep, deep sleep, and REM. Improve sleep hygiene by maintaining consistent schedules, limiting screen time before bed, keeping rooms cool and dark, and avoiding caffeine after noon.',\n      tags: JSON.stringify(['health', 'science', 'sleep']),\n    },\n    {\n      title: 'Watercolor Painting Basics',\n      body: 'Watercolor painting uses water-soluble pigments on paper. Start with basic techniques: wet-on-wet for soft blends, wet-on-dry for sharp edges, and dry brush for texture. Use quality paper (140lb cold press), a limited palette of primary colors, and practice controlling water ratios.',\n      tags: JSON.stringify(['art', 'painting', 'watercolor']),\n    },\n    {\n      title: 'Blockchain Technology Overview',\n      body: 'Blockchain is a distributed ledger technology where data is stored in linked blocks secured by cryptography. Each block contains a hash of the previous block, creating an immutable chain. Applications extend beyond cryptocurrency to supply chain, healthcare records, and voting systems.',\n      tags: JSON.stringify(['technology', 'blockchain', 'crypto']),\n    },\n    {\n      title: 'Thai Cooking Fundamentals',\n      body: 'Thai cuisine balances sweet, sour, salty, spicy, and bitter flavors. Essential ingredients include fish sauce, lime, lemongrass, galangal, Thai basil, and coconut milk. Master dishes like pad thai, green curry, tom yum soup, and mango sticky rice. Fresh herbs and aromatics are key.',\n      tags: JSON.stringify(['cooking', 'thai', 'asian']),\n    },\n    {\n      title: 'Astrophotography Guide',\n      body: 'Capturing the night sky requires a DSLR or mirrorless camera, wide-angle lens, sturdy tripod, and remote shutter release. Use manual mode with wide aperture (f/2.8 or lower), high ISO (1600-6400), and long exposure (15-30 seconds). The 500 rule helps avoid star trails.',\n      tags: JSON.stringify(['photography', 'astronomy', 'techniques']),\n    },\n    {\n      title: 'Functional Programming Concepts',\n      body: 'Functional programming treats computation as evaluation of mathematical functions. Core concepts include pure functions, immutability, higher-order functions, function composition, and avoiding side effects. Languages like Haskell, Elixir, and Clojure embrace FP, while JavaScript and Python support FP patterns.',\n      tags: JSON.stringify(['programming', 'functional', 'concepts']),\n    },\n    {\n      title: 'Home Coffee Roasting',\n      body: 'Roasting coffee at home gives you control over flavor profiles. Green beans progress through drying, first crack, development, and optionally second crack. Light roasts preserve origin flavors, medium roasts balance sweetness and body, dark roasts emphasize roast character. Cool beans quickly after roasting.',\n      tags: JSON.stringify(['cooking', 'coffee', 'hobby']),\n    },\n    {\n      title: 'Climbing Mount Kilimanjaro',\n      body: 'Kilimanjaro is the highest peak in Africa at 19,341 feet. The Machame route is the most scenic, taking 6-7 days. Acclimatization is crucial to prevent altitude sickness. No technical climbing skills needed, but physical fitness is essential. The summit offers breathtaking views of the African plains.',\n      tags: JSON.stringify(['travel', 'hiking', 'africa']),\n    },\n    {\n      title: 'CSS Grid Layout Mastery',\n      body: 'CSS Grid provides a two-dimensional layout system for the web. Define rows and columns with grid-template, place items with grid-column and grid-row, and use gap for spacing. Grid areas name regions for intuitive placement. Combine with Flexbox for complete layout control.',\n      tags: JSON.stringify(['programming', 'css', 'web']),\n    },\n    {\n      title: 'Fermentation and Pickling',\n      body: 'Fermentation preserves food using beneficial bacteria. Sauerkraut, kimchi, kombucha, and yogurt are popular fermented foods. Basic lacto-fermentation needs only vegetables, salt, and water. Maintain proper salt ratios (2-3%), keep vegetables submerged, and ferment at room temperature for optimal results.',\n      tags: JSON.stringify(['cooking', 'fermentation', 'preservation']),\n    },\n  ];\n}\n","structuredPatch":[{"oldStart":58,"oldLines":12,"newStart":58,"newLines":30,"lines":["     END;","   `);"," ","-  // A pre-existing database may already hold notes that were never indexed.","-  if (!alreadyIndexed) {","+  // A freshly created index holds nothing, and an index carried over from an","+  // earlier run may have drifted from `notes` (e.g. writes made while the","+  // triggers were missing). Either way, rebuilding restores a correct index.","+  if (!alreadyIndexed || !ftsIndexMatchesNotes(db)) {","     db.exec(\"INSE