le, old.body);\n    END;\n\n    CREATE TRIGGER IF NOT EXISTS notes_fts_au AFTER UPDATE ON notes BEGIN\n      INSERT INTO notes_fts (notes_fts, rowid, title, body)\n        VALUES ('delete', old.id, old.title, old.body);\n      INSERT INTO notes_fts (rowid, title, body) VALUES (new.id, new.title, new.body);\n    END;\n  `);\n\n  // A pre-existing database may already hold notes that were never indexed.\n  if (!alreadyIndexed) {\n    db.exec(\"INSERT INTO notes_fts (notes_fts) VALUES ('rebuild')\");\n  }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":223,"cache_creation_input_tokens":8541,"cache_read_input_tokens":30736,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8541},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"43d1e346-7b84-459f-9add-449e61bb9053","uuid":"b678465c-86d0-4f29-9c5b-233871f1feac","request_id":"req_011CdMta4yyhT7TVRkG7bw99"}
