+<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/**
+ * Beam propagation simulator for a 2D grid laboratory.
+ *
+ * Every beam advances exactly one row per step, so the state space
+ * `(row, col, direction)` forms a layered DAG with no cycles. Both queries are
+ * therefore solved with a single sweep over the grid rather than by
+ * enumerating beams or paths individually.
+ */
+&nbsp;
+export type Grid = string[][];
+&nbsp;
+const SOURCE = 'S';
+const SPLITTER = '^';
+&nbsp;
+/** Beam directions. The index is also the offset into {@link COL_DELTA}. */
+const DOWN_LEFT = 0;
+const DOWN = 1;
+const DOWN_RIGHT = 2;
+const DIRECTIONS = 3;
+&nbsp;
+/** Column change applied when a beam of each direction advances one row. */
+const COL_DELTA = [-1, 0, 1];
+&nbsp;
+/** Widest row in the grid; used to size the per-row state buffers. */
+function maxWidth(grid: Grid): number {
+  let width = 0;
+  for (const row of grid) {
+    if (row.length &gt; width) width = row.length;
+  }
+  return width;
+}
+&nbsp;
+/** A cell is in bounds when its row exists and the column fits that row. */
+function inBounds(grid: Grid, row: number, col: number): boolean {
+  return row &gt;= 0 &amp;&amp; row &lt; grid.length &amp;&amp; col &gt;= 0 &amp;&amp; col &lt; grid[row].length;
+}
+&nbsp;
+/**
+ * Count the distinct cells visited by any beam.
+ *
+ * Beams are propagated row by row as a set of `(col, direction)` states, so
+ * beams that overlap collapse into a single state instead of multiplying.
+ */
+export function countBeamCells(grid: Grid): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const width = maxWidth(grid);
+  if (width === 0) return 0;
+&nbsp;
+  let current = new Uint8Array(width * DIRECTIONS);
+  let next = new Uint8Array(width * DIRECTIONS);
+  const visitedInRow = new Uint8Array(width);
+&nbsp;
+  let hasCurrent = false;
+  const topRow = grid[0];
+  for (let col = 0; col &lt; topRow.length; col++) {
+    if (topRow[col] === SOURCE) {
+      current[col * DIRECTIONS + DOWN] = 1;
+      hasCurrent = true;
+    }
+  }
+&nbsp;
+  let visited = 0;
+  for (let row = 0; row &lt; rows &amp;&amp; hasCurrent; row++) {
+    next.fill(0);
+    visitedInRow.fill(0);
+    let hasNext = false;
+&nbsp;
+    const cells = grid[row];
+    for (let col = 0; col &lt; cells.length; col++) {
+      const base = col * DIRECTIONS;
+      if (!current[base + DOWN_LEFT] &amp;&amp; !current[base + DOWN] &amp;&amp; !current[base + DOWN_RIGHT]) {
+        continue;
+      }
+&nbsp;
+      if (!visitedInRow[col]) {
+        visitedInRow[col] = 1;
+        visited++;
+      }
+&nbsp;
+      if (cells[col] === SPLITTER) {
+        // The incoming beam is consumed; a splitter always emits the same
+        // pair of diagonals no matter how many beams arrived or from where.
+        if (inBounds(grid, row + 1, col - 1)) {
+          next[(col - 1) * DIRECTIONS + DOWN_LEFT] = 1;
+          hasNext = true;
+        }
+        if (inBounds(grid, row + 1, col + 1)) {
+          next[(col + 1) * DIRECTIONS + DOWN_RIGHT] = 1;
+          hasNext = true;
+        }
+      } else {
+        for (let dir = 0; dir &lt; DIRECTIONS; dir++) {
+          if (!current[base + dir]) continue;
+          const nextCol = col + COL_DELTA[dir];
+          if (inBounds(grid, row + 1, nextCol)) {
+            next[nextCol * DIRECTIONS + dir] = 1;
+            hasNext = true;
+          }
+        }
+      }
+    }
+&nbsp;
+    const swap = current;
+    current = next;
+    next = swap;
+    hasCurrent = hasNext;
+  }
+&nbsp;
+  return visited;
+}
+&nbsp;
+/**
+ * Count the total number of distinct source-to-exit paths.
+ *
+ * `paths(row, col, dir)` is the number of ways a beam in that state can leave
+ * the grid. Successors always live on the next row, so the values are filled in
+ * bottom-up and each state is evaluated exactly once. A successor outside the
+ * grid contributes a single completed path.
+ */
+export function countBeamPaths(grid: Grid): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const width = maxWidth(grid);
+  if (width === 0) return 0n;
+&nbsp;
+  const size = width * DIRECTIONS;
+  let below: bigint[] = new Array&lt;bigint&gt;(size).fill(0n);
+  let current: bigint[] = new Array&lt;bigint&gt;(size).fill(0n);
+&nbsp;
+  for (let row = rows - 1; row &gt;= 0; row--) {
+    current.fill(0n);
+    const lastRow = row === rows - 1;
+    const nextWidth = lastRow ? 0 : grid[row + 1].length;
+&nbsp;
+    /** Paths remaining once a beam steps onto (row + 1, col) heading `dir`. */
+    const step = (col: number, dir: number): bigint =&gt;
+      !lastRow &amp;&amp; col &gt;= 0 &amp;&amp; col &lt; nextWidth ? below[col * DIRECTIONS + dir] : 1n;
+&nbsp;
+    const cells = grid[row];
+    for (let col = 0; col &lt; cells.length; col++) {
+      const base = col * DIRECTIONS;
+      if (cells[col] === SPLITTER) {
+        // Incoming direction is irrelevant at a splitter.
+        const total = step(col - 1, DOWN_LEFT) + step(col + 1, DOWN_RIGHT);
+        current[base + DOWN_LEFT] = total;
+        current[base + DOWN] = total;
+        current[base + DOWN_RIGHT] = total;
+      } else {
+        for (let dir = 0; dir &lt; DIRECTIONS; dir++) {
+          current[base + dir] = step(col + COL_DELTA[dir], dir);
+        }
+      }
+    }
+&nbsp;
+    const swap = below;
+    below = current;
+    current = swap;
+  }
+&nbsp;
+  // `below` now holds row 0. Each source emits one beam travelling down.
+  let total = 0n;
+  const topRow = grid[0];
+  for (let col = 0; col &lt; topRow.length; col++) {
+    if (topRow[col] === SOURCE) {
+      total += below[col * DIRECTIONS + DOWN];
+    }
+  }
+  return total;
+}
