+import { describe, expect, it } from 'vitest';
+import { countBeamCells, countBeamPaths } from '../src/index.js';
+
+/** Build a grid from strings where each character is one cell. */
+function parse(...rows: string[]): string[][] {
+  return rows.map((row) => row.split(''));
+}
+
+describe('countBeamCells', () => {
+  it('counts a straight beam with a single splitter (spec example)', () => {
+    const grid = parse('.S...', '.....', '.^...', '.....');
+    expect(countBeamCells(grid)).toBe(5);
+  });
+
+  it('counts overlapping beams once (spec example)', () => {
+    const grid = parse('.S...', '.^...', '^.^..', '.....');
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('counts only the source when the grid is one row tall', () => {
+    expect(countBeamCells(parse('.S.'))).toBe(1);
+  });
+
+  it('counts a full straight column when there are no splitters', () => {
+    const grid = parse('.S.', '...', '...', '...');
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('returns 0 when there is no source', () => {
+    expect(countBeamCells(parse('...', '.^.', '...'))).toBe(0);
+  });
+
+  it('returns 0 for an empty grid', () => {
+    expect(countBeamCells([])).toBe(0);
+  });
+
+  it('returns 0 for a grid of empty rows', () => {
+    expect(countBeamCells([[], [], []])).toBe(0);
+  });
+
+  it('counts the splitter cell itself as visited', () => {
+    // Source directly above a splitter on the last row: both branches leave.
+    const grid = parse('S', '^');
+    expect(countBeamCells(grid)).toBe(2);
+  });
+
+  it('absorbs beams that walk off the left and right edges', () => {
+    // Splitter in a 1-wide grid: both diagonals leave immediately.
+    const grid = parse('S', '^', '.');
+    expect(countBeamCells(grid)).toBe(2);
+  });
+
+  it('splits regardless of the incoming diagonal direction', () => {
+    //  . S . . .
+    //  . ^ . . .   -> (2,0) DL and (2,2) DR
+    //  ^ . ^ . .   -> both split again
+    //  . . . . .
+    const grid = parse('.S...', '.^...', '^.^..', '.....');
+    // Row 3 receives (3,1) from both splitters and (3,3) from the right one.
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('lets a diagonal beam keep its direction through empty cells', () => {
+    //  S....
+    //  ^....   split: down-left exits, down-right goes to (2,1)
+    //  .....
+    //  .....   down-right continues to (3,2)
+    const grid = parse('S....', '^....', '.....', '.....');
+    // (0,0), (1,0), (2,1), (3,2)
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('supports multiple sources on the top row', () => {
+    const grid = parse('S.S', '...', '...');
+    expect(countBeamCells(grid)).toBe(6);
+  });
+
+  it('merges overlapping beams from multiple sources', () => {
+    //  S.S
+    //  .^.   both beams pass down columns 0 and 2, missing the splitter
+    const grid = parse('S.S', '.^.');
+    expect(countBeamCells(grid)).toBe(4);
+  });
+
+  it('ignores an S that is not on the top row', () => {
+    const grid = parse('...', '.S.', '...');
+    expect(countBeamCells(grid)).toBe(0);
+  });
+
+  it('treats a non-top-row S as an ordinary pass-through cell', () => {
+    const grid = parse('.S.', '.S.', '.S.');
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('treats unknown characters as empty cells', () => {
+    const grid = parse('.S.', '.#.', '.?.');
+    expect(countBeamCells(grid)).toBe(3);
+  });
+
+  it('handles a beam that re-enters a splitter chain diagonally', () => {
+    //  ..S..
+    //  ..^..   -> (2,1) DL, (2,3) DR
+    //  .^.^.   -> both split
+    //  ^.^.^   -> (3,0),(3,2) from left; (3,2),(3,4) from right
+    const grid = parse('..S..', '..^..', '.^.^.', '^.^.^');
+    // visited: (0,2),(1,2),(2,1),(2,3),(3,0),(3,2),(3,4)
+    expect(countBeamCells(grid)).toBe(7);
+  });
+});
+
+describe('countBeamPaths', () => {
+  it('counts two paths for a single splitter (spec example)', () => {
+    const grid = parse('.S...', '.....', '.^...', '.....');
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts absorbed branches as completed paths (spec example)', () => {
+    const grid = parse('.S...', '.^...', '^.^..', '.....');
+    expect(countBeamPaths(grid)).toBe(4n);
+  });
+
+  it('counts one path when there are no splitters', () => {
+    expect(countBeamPaths(parse('.S.', '...', '...'))).toBe(1n);
+  });
+
+  it('counts one path for a single-row grid', () => {
+    expect(countBeamPaths(parse('.S.'))).toBe(1n);
+  });
+
+  it('returns 0n when there is no source', () => {
+    expect(countBeamPaths(parse('...', '.^.'))).toBe(0n);
+  });
+
+  it('returns 0n for an empty grid', () => {
+    expect(countBeamPaths([])).toBe(0n);
+  });
+
+  it('returns 0n for a grid of empty rows', () => {
+    expect(countBeamPaths([[], []])).toBe(0n);
+  });
+
+  it('sums paths across multiple sources', () => {
+    //  S.S
+    //  .^.  neither beam reaches the splitter
+    const grid = parse('S.S', '.^.', '...');
+    expect(countBeamPaths(grid)).toBe(2n);
+  });
+
+  it('counts both branches even when they immediately leave the grid', () => {
+    expect(countBeamPaths(parse('S', '^'))).toBe(2n);
+  });
+
+  it('never reaches splitters stacked below one in a 1-wide grid', () => {
+    // The down beam hits the first splitter and both diagonals walk off the
+    // 1-wide grid, so the lower splitters are unreachable: still just 2 paths.
+    expect(countBeamPaths(parse('S', '^', '^', '^'))).toBe(2n);
+  });
+
+  it('doubles per splitter when branches stay in bounds', () => {
+    //  Wide grid, splitters stacked so every branch meets another splitter.
+    //  ....S....
+    //  ....^....
+    //  ...^.^...
+    //  ..^.^.^..
+    //  .........
+    const grid = parse('....S....', '....^....', '...^.^...', '..^.^.^..', '.........');
+    expect(countBeamPaths(grid)).toBe(8n);
+  });
+
+  it('counts paths independently even when they share cells', () => {
+    //  ..S..
+    //  ..^..
+    //  .^.^.
+    //  .....
+    // 4 paths; the middle two land on the same cell (3,2) but stay distinct.
+    const grid = parse('..S..', '..^..', '.^.^.', '.....');
+    expect(countBeamPaths(grid)).toBe(4n);
+    expect(countBeamCells(grid)).toBe(7);
+  });
+
+  it('returns a bigint beyond Number.MAX_SAFE_INTEGER', () => {
+    // Build a wide triangle of splitters so no branch is ever absorbed.
+    const depth = 70;
+    const width = 2 * depth + 3;
+    const centre = depth + 1;
+    const rows: string[][] = [];
+    const top = new Array<string>(width).fill('.');
+    top[centre] = 'S';
+    rows.push(top);
+    for (let r = 1; r <= depth; r++) {
+      const row = new Array<string>(width).fill('.');
+      // Splitters sit where a beam from the apex can actually land.
+      for (let c = centre - (r - 1); c <= centre + (r - 1); c += 2) {
+        row[c] = '^';
+      }
+      rows.push(row);
+    }
+    const paths = countBeamPaths(rows);
+    expect(typeof paths).toBe('bigint');
+    expect(paths).toBe(2n ** BigInt(depth));
+    expect(paths > BigInt(Number.MAX_SAFE_INTEGER)).toBe(true);
+  });
+
+  it('agrees with brute-force enumeration on random grids', () => {
+    let seed = 0x2f6e2b1;
+    const rand = () => {
+      seed = (seed * 1664525 + 1013904223) >>> 0;
+      return seed / 0x100000000;
+    };
+
+    for (let trial = 0; trial < 400; trial++) {
+      // Every third trial uses ragged rows, so row widths shrink and grow
+      // between layers and beams can leave through a short row's edge.
+      const ragged = trial % 3 === 0;
+      const rows = 2 + Math.floor(rand() * 6);
+      const cols = 2 + Math.floor(rand() * 6);
+      const grid: string[][] = [];
+      for (let r = 0; r < rows; r++) {
+        const rowCols = ragged ? Math.floor(rand() * (cols + 1)) : cols;
+        const row: string[] = [];
+        for (let c = 0; c < rowCols; c++) {
+          row.push(rand() < 0.25 ? '^' : '.');
+        }
+        grid.push(row);
+      }
+
+      // 0..3 sources on the top row, so the no-source case is exercised too.
+      const sources = Math.floor(rand() * 4);
+      grid[0] = new Array<string>(grid[0].length).fill('.');
+      for (let s = 0; s < sources && grid[0].length > 0; s++) {
+        grid[0][Math.floor(rand() * grid[0].length)] = 'S';
+      }
+
+      const brute = bruteForce(grid);
+      expect(countBeamCells(grid)).toBe(brute.cells);
+      expect(countBeamPaths(grid)).toBe(brute.paths);
+    }
+  });
+});
+
+describe('performance', () => {
+  it('handles a 200x200 grid with 50 splitters quickly', () => {
+    const size = 200;
+    const grid: string[][] = [];
+    for (let r = 0; r < size; r++) {
+      grid.push(new Array<string>(size).fill('.'));
+    }
+    grid[0][100] = 'S';
+
+    // 50 splitters arranged so branches keep colliding with new ones.
+    let placed = 0;
+    for (let r = 1; r < size && placed < 50; r += 2) {
+      for (let c = 100 - (r - 1); c <= 100 + (r - 1) && placed < 50; c += 2) {
+        grid[r][c] = '^';
+        placed++;
+      }
+    }
+    expect(placed).toBe(50);
+
+    const start = performance.now();
+    const cells = countBeamCells(grid);
+    const paths = countBeamPaths(grid);
+    const elapsed = performance.now() - start;
+
+    expect(cells).toBeGreaterThan(0);
+    expect(paths).toBeGreaterThan(0n);
+    expect(elapsed).toBeLessThan(5000);
+  });
+});
+
+/**
+ * Reference implementation: walks every beam one at a time, with no memoisation
+ * or state merging. Only usable on tiny grids.
+ */
+function bruteForce(grid: string[][]): { cells: number; paths: bigint } {
+  const rows = grid.length;
+  const visited = new Set<string>();
+  let paths = 0n;
+
+  const walk = (row: number, col: number, colDelta: number): void => {
+    if (row < 0 || row >= rows || col < 0 || col >= grid[row].length) {
+      paths += 1n;
+      return;
+    }
+    visited.add(`${row},${col}`);
+    if (grid[row][col] === '^') {
+      walk(row + 1, col - 1, -1);
+      walk(row + 1, col + 1, 1);
+    } else {
+      walk(row + 1, col + colDelta, colDelta);
+    }
+  };
+
+  if (rows > 0) {
+    for (let col = 0; col < grid[0].length; col++) {
+      if (grid[0][col] === 'S') walk(0, col, 0);
+    }
+  }
+  return { cells: visited.size, paths };
+}
