+import { describe, it, expect } from 'vitest';
+import { BuildEngine, createDefaultTemplate } from '../../src/core/index.js';
+import { BuildContext, ContentFile, SiteConfig } from '../../src/core/types.js';
+import {
+  createMarkdownExtPlugin, createAssetPipelinePlugin, createSyntaxHighlightPlugin,
+  createTaxonomyPlugin, createRssFeedPlugin, createSearchIndexPlugin,
+  createSitemapPlugin, createDevServerPlugin,
+} from '../../src/plugins/index.js';
+
+const config: SiteConfig = {
+  title: 'T', baseUrl: 'https://example.com',
+  outputDir: './dist', contentDir: './c', templateDir: './t',
+};
+const ctx = (files: ContentFile[] = [], data = new Map<string, unknown>()): BuildContext =>
+  ({ config, files, output: new Map(), assets: new Map(), data });
+const f = (o: Partial<ContentFile> = {}): ContentFile =>
+  ({ slug: 's', title: 'T', content: '', metadata: {}, ...o });
+
+const md = createMarkdownExtPlugin();
+const ap = createAssetPipelinePlugin();
+const sh = createSyntaxHighlightPlugin();
+const tax = createTaxonomyPlugin();
+
+describe('plugin regression coverage', () => {
+  it('R1: forged placeholder token is not replaced', async () => {
+    const r = await md.hooks.transformContent!(
+      f({ content: 'Token xxadmonitionx0xx literal.\n\n:::note\nReal body\n:::' }), ctx());
+    expect(r.content).toContain('xxadmonitionx0xx literal');
+    expect((r.content.match(/admonition-note/g) || []).length).toBe(1);
+  });
+
+  it('R2: footnote defs inside code fences are preserved', async () => {
+    const r = await md.hooks.transformContent!(
+      f({ content: 'Ex:\n\n```\n[^1]: sample text\n```' }), ctx());
+    expect(r.content).toContain('[^1]: sample text');
+    expect(r.content).not.toContain('<section class="footnotes">');
+  });
+
+  it('R2b: admonition syntax inside code fences is not rendered', async () => {
+    const r = await md.hooks.transformContent!(
+      f({ content: 'Doc:\n\n```md\n:::note\nexample\n:::\n```' }), ctx());
+    expect(r.content).not.toContain('<div class="admonition');
+    expect(r.content).toContain(':::note');
+  });
+
+  it('R2c: footnote refs inside code fences are not linked', async () => {
+    const r = await md.hooks.transformContent!(
+      f({ content: 'A[^1]\n\n```\ncode[^1] here\n```\n\n[^1]: note' }), ctx());
+    expect(r.content).toContain('code[^1] here');
+  });
+
+  it('R3: colliding footnote labels get distinct ids', async () => {
+    const r = await md.hooks.transformContent!(
+      f({ content: 'A[^a.b] B[^a-b]\n\n[^a.b]: First\n[^a-b]: Second' }), ctx());
+    const ids = [...r.content.matchAll(/<li id="([^"]+)"/g)].map(m => m[1]);
+    expect(new Set(ids).size).toBe(ids.length);
+    expect(ids.length).toBe(2);
+    for (const id of ids) expect(r.content).toContain(`href="#${id}"`);
+  });
+
+  it('R4: taxonomy slug collisions produce distinct pages', async () => {
+    const c = ctx([f({ slug: 'p1', title: 'P1', tags: ['c++'] }), f({ slug: 'p2', title: 'P2', tags: ['c--'] })]);
+    await tax.hooks.beforeBuild!(c); await tax.hooks.afterBuild!(c);
+    const pages = [...c.output.keys()].filter(k => k.startsWith('tags/') && k !== 'tags/index.html');
+    expect(pages.length).toBe(2);
+    expect(c.output.get(pages[0])).not.toBe(c.output.get(pages[1]));
+    // index page links must point at the real pages
+    for (const p of pages) expect(c.output.get('tags/index.html')).toContain(`/${p}`);
+  });
+
+  it('R4b: a tag named "index" does not clobber the index page', async () => {
+    const c = ctx([f({ slug: 'p1', title: 'P1', tags: ['index'] })]);
+    await tax.hooks.beforeBuild!(c); await tax.hooks.afterBuild!(c);
+    expect(c.output.get('tags/index.html')).toContain('class="tags-index"');
+    const term = [...c.output.keys()].find(k => k.startsWith('tags/') && k !== 'tags/index.html');
+    expect(c.output.get(term!)).toContain('Tag: index');
+  });
+
+  it('R5: duplicate slugs do not cross-contaminate RSS categories', async () => {
+    const files = [f({ slug: 'dup', title: 'A', tags: ['alpha'] }), f({ slug: 'dup', title: 'B', tags: ['beta'] })];
+    const c = ctx(files);
+    await tax.hooks.beforeBuild!(c);
+    await tax.hooks.afterBuild!(c);
+    await createRssFeedPlugin().hooks.afterBuild!(c);
+    const items = c.output.get('feed.xml')!.split('<item>').slice(1);
+    expect(items).toHaveLength(2);
+    expect(items[0]).toContain('<category>alpha</category>');
+    expect(items[0]).not.toContain('<category>beta</category>');
+    expect(items[1]).toContain('<category>beta</category>');
+    expect(items[1]).not.toContain('<category>alpha</category>');
+  });
+
+  it('R6: query strings and fragments survive asset rewriting', async () => {
+    const c = ctx();
+    const r = await ap.hooks.transformContent!(f({ content: '<img src="img/a.png?v=2#fr">' }), c);
+    expect(r.content).toBe('<img src="/assets/img/a.png?v=2#fr">');
+    expect((c.data.get('asset-manifest') as { assets: string[] }).assets).toEqual(['img/a.png']);
+  });
+
+  it('R7: asset rewriting skips code fences and prose', async () => {
+    const c = ctx();
+    const r = await ap.hooks.transformContent!(
+      f({ content: 'Docs:\n\n```md\n![a](./img/x.png)\n```\n\n<p>Set src="config/app.yaml" here.</p>' }), c);
+    expect(r.content).toContain('![a](./img/x.png)');
+    expect(r.content).toContain('src="config/app.yaml"');
+    expect((c.data.get('asset-manifest') as { assets: string[] }).assets).toEqual([]);
+  });
+
+  it('R8: relative assetPrefix is idempotent', async () => {
+    const p = createAssetPipelinePlugin({ assetPrefix: 'assets' });
+    const c = ctx();
+    let file = f({ content: '<img src="img/a.png">' });
+    for (let i = 0; i < 3; i++) file = await p.hooks.transformContent!(file, c) as ContentFile;
+    expect(file.content).toBe('<img src="/assets/img/a.png">');
+    expect((c.data.get('asset-manifest') as { assets: string[] }).assets).toEqual(['img/a.png']);
+  });
+
+  it('R9: syntax-highlight rejects attribute injection', async () => {
+    const r = await sh.hooks.transformContent!(
+      f({ content: `<pre><code class='language-js" onload="alert(1)'>x</code></pre>` }), ctx());
+    expect(r.content).not.toContain('onload="alert(1)"');
+    expect(r.content).toBe(`<pre><code class='language-js" onload="alert(1)'>x</code></pre>`);
+  });
+
+  it('R10: syntax-highlight ignores class= nested in another attribute value', async () => {
+    const src = `<pre><code data-x="class='language-js'">x</code></pre>`;
+    const r = await sh.hooks.transformContent!(f({ content: src }), ctx());
+    expect(r.content).toBe(src);
+  });
+
+  it('R11: stripHtml keeps prose around bare angle brackets', async () => {
+    const c = ctx([f({ slug: 'p', title: 'P', content: '<p>if a < b and c > d then</p>' })]);
+    await createSearchIndexPlugin().hooks.afterBuild!(c);
+    const idx = JSON.parse(c.output.get('search-index.json')!);
+    expect(idx[0].content).toContain('a < b and c > d');
+  });
+
+  it('R12: entities are decoded exactly once', async () => {
+    const c = ctx([f({ slug: 'p', title: 'P', content: '<p>&amp;lt;script&amp;gt;</p>' })]);
+    await createSearchIndexPlugin().hooks.afterBuild!(c);
+    expect(JSON.parse(c.output.get('search-index.json')!)[0].content).toBe('&lt;script&gt;');
+  });
+
+  it('R13: XML-illegal control chars are stripped from the feed', async () => {
+    const NUL = String.fromCharCode(0);
+    const BS = String.fromCharCode(8);
+    const c = ctx([f({ slug: 'p', title: `Bad${NUL}Title${BS}`, content: `<p>a${NUL}b</p>`, date: '2024-01-01' })]);
+    await createRssFeedPlugin().hooks.afterBuild!(c);
+    const feed = c.output.get('feed.xml')!;
+    expect(feed.includes(NUL) || feed.includes(BS)).toBe(false);
+    expect(feed).toContain('BadTitle');
+  });
+
+  it('R14: sitemap percent-encodes unsafe path chars and is idempotent', async () => {
+    const out = new Map([['sp ace.html', 'x'], ['pre%20enc.html', 'x']]);
+    const c = ctx(); out.forEach((v, k) => c.output.set(k, v));
+    await createSitemapPlugin().hooks.afterBuild!(c);
+    const sm = c.output.get('sitemap.xml')!;
+    expect(sm).toContain('https://example.com/sp%20ace.html');
+    expect(sm).toContain('https://example.com/pre%20enc.html');
+    expect(sm).not.toContain('%2520');
+  });
+
+  it('R15: sitemap never lists itself', async () => {
+    const c = ctx();
+    c.output.set('sitemap.xml', '<stale/>');
+    c.output.set('a.html', 'x');
+    await createSitemapPlugin({ outputPath: 'sitemap2.xml' }).hooks.afterBuild!(c);
+    expect(c.output.get('sitemap2.xml')).not.toContain('sitemap.xml');
+  });
+
+  it('R16: dev-server honours custom upstream paths', async () => {
+    const c = ctx([f({ slug: 'p', title: 'P', content: '<p>x</p>' })]);
+    await createAssetPipelinePlugin({ assetPrefix: '/static' })
+      .hooks.transformContent!(f({ content: '<img src="a.png">' }), c);
+    await createSearchIndexPlugin({ outputPath: 'custom-search.json' }).hooks.afterBuild!(c);
+    await createDevServerPlugin().hooks.afterBuild!(c);
+    const cfg = c.data.get('dev-server-config') as { routes: { path: string; handler: string }[]; searchIndexPath: string };
+    expect(cfg.searchIndexPath).toBe('/custom-search.json');
+    expect(cfg.routes.find(r => r.path === '/custom-search.json')!.handler).toBe('search');
+    expect(cfg.routes.find(r => r.handler === 'asset')!.path).toBe('/static/a.png');
+  });
+
+  it('R17: markdown-ext transform is stable and does not mutate input', async () => {
+    const original = f({ content: '# H[^1]\n\n:::note\nBody\n:::\n\n[^1]: N' });
+    const snapshot = original.content;
+    const once = await md.hooks.transformContent!(original, ctx()) as ContentFile;
+    expect(original.content).toBe(snapshot);
+    const twiceSh = await sh.hooks.transformContent!(
+      await sh.hooks.transformContent!(f({ content: '<pre><code class="language-js">x</code></pre>' }), ctx()) as ContentFile,
+      ctx()) as ContentFile;
+    expect(twiceSh.content).toBe('<pre data-language="js"><code class="language-js highlighted">x</code></pre>');
+    expect(once.content).toContain('admonition-note');
+  });
+
+  it('E2E: full pipeline still produces a coherent site', async () => {
+    const engine = new BuildEngine(config);
+    engine.registerTemplate(createDefaultTemplate());
+    [md, ap, sh, tax, createRssFeedPlugin(), createSearchIndexPlugin(),
+     createSitemapPlugin(), createDevServerPlugin()].forEach(p => engine.registerPlugin(p));
+    const built = await engine.build([
+      f({ slug: 'post-1', title: 'Hello', date: '2024-03-01', tags: ['JS'],
+          content: '# Hi[^1]\n\n![p](./img/a.png)\n\n:::warning\nCare\n:::\n\n```js\nconst x = 1;\n```\n\n[^1]: A note.' }),
+    ]);
+    expect(built.output.get('post-1.html')).toContain('src="/assets/img/a.png"');
+    expect(built.output.get('post-1.html')).toContain('data-language="js"');
+    expect(built.output.get('feed.xml')).toContain('<category>js</category>');
+    expect(built.output.get('sitemap.xml')).toContain('/tags/js.html');
+    expect(JSON.parse(built.output.get('search-index.json')!)[0].content).toContain('const x = 1;');
+    const dev = built.data.get('dev-server-config') as { assetPaths: string[] };
+    expect(dev.assetPaths).toEqual(['img/a.png']);
+  });
+});
