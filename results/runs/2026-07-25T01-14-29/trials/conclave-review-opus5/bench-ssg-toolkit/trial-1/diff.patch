diff --git a/src/plugins/markdown-ext.ts b/src/plugins/markdown-ext.ts
new file mode 100644
index 0000000..b837535
--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,264 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+import { annotateFences } from './utils.js';
+
+/**
+ * Markdown renderer with two extensions on top of CommonMark/GFM:
+ *
+ *  - footnotes: `text[^1]` references paired with `[^1]: definition` blocks
+ *  - admonitions: `:::note ... :::` fenced containers
+ *
+ * Both extensions deliberately skip fenced code blocks, so a document that
+ * documents this syntax still renders its own examples verbatim.
+ */
+
+const FOOTNOTE_REF_RE = /\[\^([^\]\s]+)\]/g;
+const FOOTNOTE_DEF_RE = /^\[\^([^\]\s]+)\]:[ \t]*(.*)$/;
+const ADMONITION_OPEN_RE = /^:::([a-zA-Z][\w-]*)[ \t]*(.*)$/;
+const ADMONITION_CLOSE_RE = /^:::[ \t]*$/;
+
+function renderBlock(markdown: string): string {
+  return marked.parse(markdown) as string;
+}
+
+function renderInline(markdown: string): string {
+  return marked.parseInline(markdown) as string;
+}
+
+/**
+ * Build a placeholder generator whose token is guaranteed absent from the
+ * source. A fixed token would let author content forge a placeholder and have
+ * an admonition spliced in over it.
+ */
+function makePlaceholder(source: string): (index: number) => string {
+  let base = 'xxadmonitionx';
+  while (source.includes(base)) base += 'x';
+  return (index: number) => `${base}${index}xx`;
+}
+
+/**
+ * Map each footnote label to a unique DOM id. Sanitising alone is not enough:
+ * `a.b` and `a-b` both reduce to `fn-a-b`, which would emit duplicate ids.
+ */
+function assignFootnoteIds(labels: string[]): Map<string, string> {
+  const ids = new Map<string, string>();
+  const used = new Set<string>();
+
+  for (const label of labels) {
+    const base = `fn-${label.replace(/[^A-Za-z0-9_-]/g, '-')}`;
+    let id = base;
+    let suffix = 2;
+    while (used.has(id)) {
+      id = `${base}-${suffix}`;
+      suffix += 1;
+    }
+    used.add(id);
+    ids.set(label, id);
+  }
+
+  return ids;
+}
+
+/** Strip the smallest common indentation from a block of lines. */
+function dedent(block: string): string {
+  const lines = block.split('\n');
+  let indent = Infinity;
+  for (const line of lines) {
+    if (line.trim() === '') continue;
+    const match = /^[ \t]*/.exec(line);
+    indent = Math.min(indent, match ? match[0].length : 0);
+  }
+  if (!Number.isFinite(indent) || indent === 0) return block;
+  return lines.map(line => line.slice(indent)).join('\n');
+}
+
+interface FootnoteExtraction {
+  text: string;
+  definitions: Map<string, string>;
+}
+
+/**
+ * Pull `[^label]: text` definitions (plus their indented continuation lines)
+ * out of the source, returning the remaining markdown.
+ */
+function extractFootnoteDefinitions(source: string): FootnoteExtraction {
+  const definitions = new Map<string, string>();
+  const lines = source.split('\n');
+  const inside = annotateFences(lines);
+  const kept: string[] = [];
+  let current: { label: string; parts: string[] } | null = null;
+
+  const flush = (): void => {
+    if (!current) return;
+    definitions.set(current.label, current.parts.join('\n').trim());
+    current = null;
+  };
+
+  lines.forEach((line, index) => {
+    if (inside[index]) {
+      flush();
+      kept.push(line);
+      return;
+    }
+
+    const definition = FOOTNOTE_DEF_RE.exec(line);
+    if (definition) {
+      flush();
+      current = { label: definition[1], parts: [definition[2]] };
+      return;
+    }
+    if (current) {
+      // Indented, non-empty lines continue the previous definition.
+      if (/^[ \t]+\S/.test(line)) {
+        current.parts.push(line.trim());
+        return;
+      }
+      flush();
+      // Drop the blank line that terminated the definition block.
+      if (line.trim() === '') return;
+    }
+    kept.push(line);
+  });
+  flush();
+
+  return { text: kept.join('\n'), definitions };
+}
+
+/**
+ * Replace `[^label]` references that have a matching definition with a
+ * numbered superscript link. Returns the labels in order of first reference.
+ */
+function linkFootnoteReferences(
+  source: string,
+  definitions: Map<string, string>,
+  ids: Map<string, string>
+): { text: string; order: string[] } {
+  const order: string[] = [];
+  const lines = source.split('\n');
+  const inside = annotateFences(lines);
+
+  const text = lines
+    .map((line, index) => {
+      if (inside[index]) return line;
+      return line.replace(FOOTNOTE_REF_RE, (match, label: string) => {
+        if (!definitions.has(label)) return match;
+        let position = order.indexOf(label);
+        if (position === -1) {
+          position = order.length;
+          order.push(label);
+        }
+        return `<sup><a href="#${ids.get(label)}">${position + 1}</a></sup>`;
+      });
+    })
+    .join('\n');
+
+  return { text, order };
+}
+
+function renderFootnoteSection(
+  order: string[],
+  definitions: Map<string, string>,
+  ids: Map<string, string>
+): string {
+  const labels = [...order];
+  // Defined but never referenced notes still belong in the section.
+  for (const label of definitions.keys()) {
+    if (!labels.includes(label)) labels.push(label);
+  }
+  if (labels.length === 0) return '';
+
+  const items = labels
+    .map(label => `<li id="${ids.get(label)}">${renderInline(definitions.get(label) ?? '')}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>\n`;
+}
+
+function renderAdmonition(kind: string, title: string, body: string): string {
+  const variant = kind.toLowerCase();
+  const heading = title ? `<p class="admonition-title">${renderInline(title)}</p>` : '';
+  const content = renderBlock(dedent(body)).trim();
+  return `<div class="admonition admonition-${variant}">${heading}${content}</div>`;
+}
+
+/**
+ * Swap admonition blocks for placeholders so the surrounding markdown can be
+ * rendered without the container fences confusing the parser. An unterminated
+ * container is left untouched.
+ */
+function extractAdmonitions(
+  source: string,
+  placeholder: (index: number) => string
+): { text: string; blocks: string[] } {
+  const lines = source.split('\n');
+  const inside = annotateFences(lines);
+  const blocks: string[] = [];
+  const out: string[] = [];
+  let index = 0;
+
+  while (index < lines.length) {
+    const open = inside[index] ? null : ADMONITION_OPEN_RE.exec(lines[index]);
+    if (!open) {
+      out.push(lines[index]);
+      index += 1;
+      continue;
+    }
+
+    let cursor = index + 1;
+    while (cursor < lines.length && !(!inside[cursor] && ADMONITION_CLOSE_RE.test(lines[cursor]))) {
+      cursor += 1;
+    }
+    if (cursor >= lines.length) {
+      out.push(lines[index]);
+      index += 1;
+      continue;
+    }
+
+    blocks.push(renderAdmonition(open[1], open[2].trim(), lines.slice(index + 1, cursor).join('\n')));
+    out.push('', placeholder(blocks.length - 1), '');
+    index = cursor + 1;
+  }
+
+  return { text: out.join('\n'), blocks };
+}
+
+function restoreAdmonitions(
+  html: string,
+  blocks: string[],
+  placeholder: (index: number) => string
+): string {
+  let result = html;
+  blocks.forEach((_block, index) => {
+    const token = placeholder(index);
+    // Markdown wraps the lone placeholder line in a paragraph; unwrap it.
+    result = result.replace(new RegExp(`<p>\\s*${token}\\s*</p>`, 'g'), () => blocks[index]);
+    result = result.split(token).join(blocks[index]);
+  });
+  return result;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        const source = file.content ?? '';
+        if (source.trim() === '') {
+          return { ...file, content: '' };
+        }
+
+        const placeholder = makePlaceholder(source);
+        const { text: withoutDefs, definitions } = extractFootnoteDefinitions(source);
+        const ids = assignFootnoteIds([...definitions.keys()]);
+        const { text: withRefs, order } = linkFootnoteReferences(withoutDefs, definitions, ids);
+        const { text: withPlaceholders, blocks } = extractAdmonitions(withRefs, placeholder);
+
+        const html = restoreAdmonitions(renderBlock(withPlaceholders), blocks, placeholder);
+        const footnotes = renderFootnoteSection(order, definitions, ids);
+
+        return { ...file, content: `${html}${footnotes}` };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
