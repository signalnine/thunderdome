--- /dev/null
+++ b/src/plugins/search-index.ts
@@ -0,0 +1,66 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { joinUrl, stripHtml } from './utils.js';
+
+/**
+ * Emits a client-consumable JSON index of every page. Runs after markdown-ext
+ * and syntax-highlight so the indexed text reflects the final HTML — including
+ * the contents of code blocks.
+ */
+
+export interface SearchIndexEntry {
+  slug: string;
+  title: string;
+  url: string;
+  content: string;
+  date?: string;
+  tags?: string[];
+}
+
+export interface SearchIndexOptions {
+  /** Output path for the index. Default `search-index.json`. */
+  outputPath?: string;
+  /** Truncate indexed text to this many characters. Default: no limit. */
+  maxContentLength?: number;
+  /** Pretty-print the JSON. Default false. */
+  pretty?: boolean;
+}
+
+export const SEARCH_INDEX_PATH = 'search-index.json';
+
+/** Publishes the effective output path so dev-server need not assume it. */
+export const SEARCH_INDEX_PATH_KEY = 'search-index-path';
+
+export function createSearchIndexPlugin(options: SearchIndexOptions = {}): Plugin {
+  const outputPath = options.outputPath ?? SEARCH_INDEX_PATH;
+  const { maxContentLength, pretty } = options;
+
+  const toEntry = (file: ContentFile, ctx: BuildContext): SearchIndexEntry => {
+    let content = stripHtml(file.content ?? '');
+    if (maxContentLength !== undefined && content.length > maxContentLength) {
+      content = content.slice(0, maxContentLength).trimEnd();
+    }
+
+    const entry: SearchIndexEntry = {
+      slug: file.slug,
+      title: file.title,
+      url: joinUrl(ctx.config.baseUrl, `${file.slug}.html`),
+      content,
+    };
+    if (file.date) entry.date = file.date;
+    if (file.tags && file.tags.length > 0) entry.tags = [...file.tags];
+    return entry;
+  };
+
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const entries = ctx.files.map(file => toEntry(file, ctx));
+        ctx.output.set(outputPath, JSON.stringify(entries, null, pretty ? 2 : undefined));
+        ctx.data.set(SEARCH_INDEX_PATH_KEY, outputPath);
+      },
+    },
+  };
+}
