index 0000000..9e980dc
--- /dev/null
+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,156 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { mapUnfencedLines } from './utils.js';
+
+/**
+ * Rewrites relative asset references to a canonical `/assets/` prefix and
+ * records every asset it discovers in a build-wide manifest.
+ */
+
+export interface AssetManifest {
+  assets: string[];
+  /** URL prefix the rewritten assets are served from, for downstream plugins. */
+  prefix: string;
+}
+
+export interface AssetPipelineOptions {
+  /**
+   * URL prefix that rewritten assets are served from. Normalised to be
+   * root-relative so that rewriting is idempotent. Default `/assets`.
+   */
+  assetPrefix?: string;
+}
+
+export const ASSET_MANIFEST_KEY = 'asset-manifest';
+
+// Attribute rewriting is scoped to real tags so that prose or escaped example
+// markup (`&lt;img src="a.png"&gt;`) is never touched.
+const TAG_RE = /<[a-zA-Z][^>]*>/g;
+const URL_ATTR_RE = /\b(src|href)\s*=\s*("([^"]*)"|'([^']*)')/gi;
+
+// Inline markdown links and images: `[text](url)` / `![alt](url "title")`.
+// This plugin declares no dependencies, so it may run either side of
+// markdown-ext; handling both forms keeps it order-independent.
+const MARKDOWN_LINK_RE = /(!?\[[^\]]*\])\(\s*([^)\s]+)((?:\s+(?:"[^"]*"|'[^']*'))?\s*)\)/g;
+
+/** Documents are pages, not assets — they keep their original URLs. */
+const DOCUMENT_EXTENSIONS = new Set(['html', 'htm', 'xhtml', 'xml', 'md', 'markdown']);
+
+interface AssetReference {
+  /** Manifest key: a clean, root-relative path with no query or fragment. */
+  path: string;
+  /** The original `?query#fragment`, preserved when rewriting. */
+  suffix: string;
+}
+
+function isExternal(url: string): boolean {
+  // Scheme-qualified (`https:`, `mailto:`, `data:`), protocol-relative, or
+  // rooted/fragment/query-only URLs are all left untouched. Leaving rooted
+  // URLs alone is also what makes a second pass a no-op.
+  return (
+    url === '' ||
+    /^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(url) ||
+    url.startsWith('//') ||
+    url.startsWith('/') ||
+    url.startsWith('#') ||
+    url.startsWith('?')
+  );
+}
+
+/**
+ * Resolve a relative reference, e.g. `./img/a.png?v=2` -> path `img/a.png`
+ * with suffix `?v=2`. Returns null when the URL is not a rewritable asset.
+ */
+function toAssetReference(url: string): AssetReference | null {
+  if (isExternal(url)) return null;
+
+  const separator = url.search(/[?#]/);
+  const pathPart = separator === -1 ? url : url.slice(0, separator);
+  const suffix = separator === -1 ? '' : url.slice(separator);
+
+  const segments: string[] = [];
+  for (const segment of pathPart.split('/')) {
+    if (segment === '' || segment === '.') continue;
+    if (segment === '..') {
+      // Assets live in a flat namespace rooted at the content directory, so a
+      // `..` that would climb above the root is clamped rather than honoured.
+      segments.pop();
+      continue;
+    }
+    segments.push(segment);
+  }
+  if (segments.length === 0) return null;
+
+  const name = segments[segments.length - 1];
+  const dot = name.lastIndexOf('.');
+  if (dot <= 0 || dot === name.length - 1) return null;
+  const extension = name.slice(dot + 1).toLowerCase();
+  if (DOCUMENT_EXTENSIONS.has(extension)) return null;
+
+  return { path: segments.join('/'), suffix };
+}
+
+/** Normalise to a root-relative prefix; `/` collapses to the bare root. */
+function normalizePrefix(raw: string): string {
+  const trimmed = raw.replace(/\/+$/, '').replace(/^\/*/, '/');
+  return trimmed === '/' ? '' : trimmed;
+}
+
+function getManifest(ctx: BuildContext, prefix: string): AssetManifest {
+  const existing = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  if (existing) return existing;
+  const manifest: AssetManifest = { assets: [], prefix };
+  ctx.data.set(ASSET_MANIFEST_KEY, manifest);
+  return manifest;
+}
+
+export function createAssetPipelinePlugin(options: AssetPipelineOptions = {}): Plugin {
+  const prefix = normalizePrefix(options.assetPrefix ?? '/assets');
+
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild(ctx: BuildContext): void {
+        getManifest(ctx, prefix);
+      },
+
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        const manifest = getManifest(ctx, prefix);
+        const source = file.content ?? '';
+
+        /** Record the asset and hand back its public URL. */
+        const record = (reference: AssetReference): string => {
+          if (!manifest.assets.includes(reference.path)) {
+            manifest.assets.push(reference.path);
+          }
+          return `${prefix}/${reference.path}${reference.suffix}`;
+        };
+
+        const withRewrittenAttrs = source.replace(TAG_RE, tag =>
+          tag.replace(
+            URL_ATTR_RE,
+            (match, attr: string, _quoted: string, doubleQuoted?: string, singleQuoted?: string) => {
+              const quote = doubleQuoted !== undefined ? '"' : "'";
+              const url = doubleQuoted !== undefined ? doubleQuoted : (singleQuoted ?? '');
+              const reference = toAssetReference(url);
+              if (reference === null) return match;
+              return `${attr}=${quote}${record(reference)}${quote}`;
+            }
+          )
+        );
+
+        // Markdown links are only meaningful outside fenced code blocks.
+        const content = mapUnfencedLines(withRewrittenAttrs, line =>
+          line.replace(MARKDOWN_LINK_RE, (match, label: string, url: string, title: string) => {
+            const reference = toAssetReference(url);
+            if (reference === null) return match;
+            return `${label}(${record(reference)}${title})`;
+          })
+        );
+
+        return content === source ? file : { ...file, content };
+      },
+    },
+  };
+}
