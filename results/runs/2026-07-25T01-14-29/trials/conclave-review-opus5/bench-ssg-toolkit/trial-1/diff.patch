--- /dev/null
+++ b/src/plugins/sitemap.ts
@@ -0,0 +1,66 @@
+import { BuildContext, Plugin } from '../core/types.js';
+import { encodeUrlPath, escapeXml, joinUrl } from './utils.js';
+
+/**
+ * Emits a sitemap covering every rendered page, the taxonomy listings and the
+ * RSS feed. It depends on taxonomy and rss-feed precisely so that their
+ * outputs are already present in `ctx.output` by the time this hook runs —
+ * enumerating `ctx.output` therefore needs no plugin-specific knowledge.
+ */
+
+export interface SitemapOptions {
+  /** Output path for the sitemap. Default `sitemap.xml`. */
+  outputPath?: string;
+  /** Extra output paths to include beyond the auto-detected ones. */
+  extraPaths?: string[];
+}
+
+export const SITEMAP_PATH = 'sitemap.xml';
+
+const INDEXABLE_EXTENSIONS = new Set(['html', 'htm', 'xml']);
+
+function isIndexable(path: string): boolean {
+  const dot = path.lastIndexOf('.');
+  if (dot === -1) return false;
+  return INDEXABLE_EXTENSIONS.has(path.slice(dot + 1).toLowerCase());
+}
+
+export function createSitemapPlugin(options: SitemapOptions = {}): Plugin {
+  const outputPath = options.outputPath ?? SITEMAP_PATH;
+
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const paths = new Set<string>();
+
+        for (const path of ctx.output.keys()) {
+          // A sitemap never lists itself, under either the configured name or
+          // the default (which may linger from an earlier run).
+          if (path === outputPath || path === SITEMAP_PATH) continue;
+          if (isIndexable(path)) paths.add(path);
+        }
+        for (const extra of options.extraPaths ?? []) {
+          paths.add(extra.replace(/^\/+/, ''));
+        }
+
+        const urls = [...paths]
+          .map(path => {
+            const loc = escapeXml(joinUrl(ctx.config.baseUrl, encodeUrlPath(path)));
+            return `  <url>\n    <loc>${loc}</loc>\n  </url>`;
+          })
+          .join('\n');
+
+        ctx.output.set(
+          outputPath,
+          `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+${urls}
+</urlset>`
+        );
+      },
+    },
+  };
+}
diff --git a/src/plugins/syntax-highlight.ts b/src/plugins/syntax-highlight.ts
new file mode 100644
index 0000000..246afab
--- /dev/null
+++ b/src/plugins/syntax-highlight.ts
@@ -0,0 +1,72 @@
+import { ContentFile, Plugin } from '../core/types.js';
+import { parseAttributes } from './utils.js';
+
+/**
+ * Annotates fenced code blocks with a `data-language` attribute on the `<pre>`
+ * and a `highlighted` marker class on the `<code>`, so a client-side
+ * highlighter can pick them up. Blocks without a declared language and inline
+ * `<code>` spans are left exactly as they were.
+ */
+
+export interface SyntaxHighlightOptions {
+  /** Class added to `<code>` elements that were annotated. Default `highlighted`. */
+  highlightClass?: string;
+}
+
+// A `<pre>` immediately followed by its `<code>` child.
+const PRE_CODE_RE = /<pre\b([^>]*)>(\s*)<code\b([^>]*)>/gi;
+const LANGUAGE_CLASS_RE = /(?:^|\s)(?:language|lang)-(\S+)/i;
+
+// Language names are echoed into an attribute value, so anything outside this
+// conservative set is ignored rather than escaped — a crafted class such as
+// `language-js" onload="alert(1)` must not become a live handler.
+const SAFE_LANGUAGE_RE = /^[A-Za-z0-9_+#.-]+$/;
+
+export function createSyntaxHighlightPlugin(options: SyntaxHighlightOptions = {}): Plugin {
+  const highlightClass = options.highlightClass ?? 'highlighted';
+
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        const source = file.content ?? '';
+
+        const content = source.replace(
+          PRE_CODE_RE,
+          (match, preAttrs: string, gap: string, codeAttrs: string) => {
+            const classAttr = parseAttributes(codeAttrs).find(
+              attr => attr.name.toLowerCase() === 'class'
+            );
+            if (!classAttr) return match;
+
+            const language = LANGUAGE_CLASS_RE.exec(classAttr.value);
+            if (!language || !SAFE_LANGUAGE_RE.test(language[1])) return match;
+
+            const classes = classAttr.value.split(/\s+/).filter(Boolean);
+            if (!classes.includes(highlightClass)) {
+              classes.push(highlightClass);
+            }
+
+            // Reusing the original quote character is safe: the value was read
+            // from between those quotes, so it cannot contain one.
+            const quote = classAttr.quote || '"';
+            const nextCodeAttrs =
+              codeAttrs.slice(0, classAttr.start) +
+              `class=${quote}${classes.join(' ')}${quote}` +
+              codeAttrs.slice(classAttr.end);
+
+            const nextPreAttrs = /\bdata-language\s*=/i.test(preAttrs)
+              ? preAttrs
+              : `${preAttrs} data-language="${language[1]}"`;
+
+            return `<pre${nextPreAttrs}>${gap}<code${nextCodeAttrs}>`;
+          }
+        );
+
+        return content === source ? file : { ...file, content };
+      },
+    },
+  };
+}
diff --git a/src/plugins/taxonomy.ts b/src/plugins/taxonomy.ts
new file mode 100644
index 0000000..b35bbc0
--- /dev/null
+++ b/src/plugins/taxonomy.ts
@@ -0,0 +1,168 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { escapeHtml, uniqueSlug } from './utils.js';
+
+/**
+ * Groups content by tag and by category, exposes the indices on `ctx.data`,
+ * and emits a listing page for every term.
+ */
+
+export const TAXONOMY_TAGS_KEY = 'taxonomy-tags';
+export const TAXONOMY_CATEGORIES_KEY = 'taxonomy-categories';
+
+export type TaxonomyIndex = Map<string, ContentFile[]>;
+
+export interface TaxonomyOptions {
+  /** Emit `tags/index.html` and `categories/index.html`. Default true. */
+  generateIndexPages?: boolean;
+}
+
+type TaxonomyKind = 'tags' | 'categories';
+
+/** Terms are compared case-insensitively so `JS` and `js` are one bucket. */
+function normalizeTerm(term: unknown): string | null {
+  if (typeof term !== 'string') return null;
+  const normalized = term.trim().toLowerCase();
+  return normalized === '' ? null : normalized;
+}
+
+function categoriesOf(file: ContentFile): unknown[] {
+  const { category, categories } = file.metadata ?? {};
+  if (Array.isArray(categories)) return categories;
+  if (categories !== undefined) return [categories];
+  if (category !== undefined) return [category];
+  return [];
+}
+
+function buildIndex(files: ContentFile[], termsOf: (file: ContentFile) => unknown[]): TaxonomyIndex {
+  const index: TaxonomyIndex = new Map();
+  for (const file of files) {
+    const seen = new Set<string>();
+    for (const raw of termsOf(file)) {
+      const term = normalizeTerm(raw);
+      // A file listing the same term twice is still only one entry.
+      if (term === null || seen.has(term)) continue;
+      seen.add(term);
+      const bucket = index.get(term);
+      if (bucket) {
+        bucket.push(file);
+      } else {
+        index.set(term, [file]);
+      }
+    }
+  }
+  return index;
+}
+
+function buildIndices(files: ContentFile[]): Record<TaxonomyKind, TaxonomyIndex> {
+  return {
+    tags: buildIndex(files, file => file.tags ?? []),
+    categories: buildIndex(files, categoriesOf),
+  };
+}
+
+/**
+ * Assign every term a distinct page slug. Terms that differ only in
+ * punctuation (`C++` / `C#`) share a base slug, and without disambiguation the
+ * later page would silently overwrite the earlier one.
+ */
+function assignSlugs(index: TaxonomyIndex, reserved: string[]): Map<string, string> {
+  const used = new Set(reserved);
+  const slugs = new Map<string, string>();
+  for (const term of index.keys()) {
+    slugs.set(term, uniqueSlug(term, used));
+  }
+  return slugs;
+}
+
+function renderPage(title: string, body: string, siteTitle: string): string {
+  return `<!DOCTYPE html>
+<html>
+<head>
+  <meta charset="utf-8">
+  <title>${escapeHtml(title)} | ${escapeHtml(siteTitle)}</title>
+</head>
+<body>
+  <h1>${escapeHtml(title)}</h1>
+${body}
+</body>
+</html>`;
+}
+
+function renderTermPage(
+  kind: TaxonomyKind,
+  term: string,
+  files: ContentFile[],
+  siteTitle: string
+): string {
+  const items = files
+    .map(
+      file =>
+        `    <li><a href="/${escapeHtml(file.slug)}.html">${escapeHtml(file.title)}</a></li>`
+    )
+    .join('\n');
+  const body = `  <ul class="${kind}-list">\n${items}\n  </ul>`;
+  return renderPage(`${kind === 'tags' ? 'Tag' : 'Category'}: ${term}`, body, siteTitle);
+}
+
+function renderIndexPage(
+  kind: TaxonomyKind,
+  index: TaxonomyIndex,
+  slugs: Map<string, string>,
+  siteTitle: string
+): string {
+  const items = [...index.entries()]
+    .map(
+      ([term, files]) =>
+        `    <li><a href="/${kind}/${escapeHtml(slugs.get(term) ?? '')}.html">${escapeHtml(term)}</a> (${files.length})</li>`
+    )
+    .join('\n');
+  const body = `  <ul class="${kind}-index">\n${items}\n  </ul>`;
+  return renderPage(kind === 'tags' ? 'Tags' : 'Categories', body, siteTitle);
+}
+
+export function createTaxonomyPlugin(options: TaxonomyOptions = {}): Plugin {
+  const generateIndexPages = options.generateIndexPages ?? true;
+
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild(ctx: BuildContext): void {
+        const indices = buildIndices(ctx.files);
+        ctx.data.set(TAXONOMY_TAGS_KEY, indices.tags);
+        ctx.data.set(TAXONOMY_CATEGORIES_KEY, indices.categories);
+      },
+
+      afterBuild(ctx: BuildContext): void {
+        // Re-index against the transformed files: `beforeBuild` captured the
+        // pre-transform objects, and the engine replaces rather than mutates
+        // them, so the early index is stale by the time pages are rendered.
+        const indices = buildIndices(ctx.files);
+        ctx.data.set(TAXONOMY_TAGS_KEY, indices.tags);
+        ctx.data.set(TAXONOMY_CATEGORIES_KEY, indices.categories);
+
+        const siteTitle = ctx.config.title;
+
+        for (const kind of ['tags', 'categories'] as const) {
+          const index = indices[kind];
+          if (index.size === 0) continue;
+
+          // `index` is reserved so a term literally named "index" cannot
+          // collide with the listing page.
+          const slugs = assignSlugs(index, generateIndexPages ? ['index'] : []);
+
+          for (const [term, files] of index) {
+            ctx.output.set(
+              `${kind}/${slugs.get(term)}.html`,
+              renderTermPage(kind, term, files, siteTitle)
+            );
+          }
+          if (generateIndexPages) {
+            ctx.output.set(`${kind}/index.html`, renderIndexPage(kind, index, slugs, siteTitle));
+          }
+        }
+      },
+    },
+  };
+}
diff --git a/src/plugins/utils.ts b/src/plugins/utils.ts
new file mode 100644
index 0000000..427098a
--- /dev/null
+++ b/src/plugins/utils.ts
@@ -0,0 +1,206 @@
+/**
+ * Small helpers shared by the bundled plugins.
+ */
+
+// Code points that XML 1.0 cannot represent at all, even escaped. Matching
+// control characters is the entire point here, hence the rule suppression.
+// eslint-disable-next-line no-control-regex
+const XML_INVALID_RE = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\uFFFE\uFFFF]/g;
+
+/** Drop characters that would make the surrounding XML document unparseable. */
+export function stripXmlInvalid(value: string): string {
+  return value.replace(XML_INVALID_RE, '');
+}
+
+/** Escape a string for safe interpolation into XML text or attribute values. */
+export function escapeXml(value: string): string {
+  return stripXmlInvalid(value)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+/** Escape a string for safe interpolation into HTML text or attribute values. */
+export function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+/** Turn an arbitrary label into a URL/file-name safe slug. */
+export function slugify(value: string): string {
+  const slug = value
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  return slug || 'untitled';
+}
+
+/**
+ * Pick a slug for `value` that is not already in `used`, registering the
+ * result. Distinct terms often share a base slug (`C++` and `C#` both reduce
+ * to `c`), so callers need the disambiguated form to avoid clobbering pages.
+ */
+export function uniqueSlug(value: string, used: Set<string>): string {
+  const base = slugify(value);
+  let slug = base;
+  let suffix = 2;
+  while (used.has(slug)) {
+    slug = `${base}-${suffix}`;
+    suffix += 1;
+  }
+  used.add(slug);
+  return slug;
+}
+
+/**
+ * Percent-encode the characters that are not legal in a URL path. `%` is
+ * deliberately left alone so that re-encoding an already-encoded path is a
+ * no-op (unlike `encodeURI`, which would turn `%20` into `%2520`).
+ */
+export function encodeUrlPath(path: string): string {
+  return path.replace(/[^A-Za-z0-9\-._~!$&'()*+,;=:@/%#?]/g, char => encodeURIComponent(char));
+}
+
+/** Join a site base URL with an output path, avoiding duplicate slashes. */
+export function joinUrl(baseUrl: string, path: string): string {
+  const base = baseUrl.replace(/\/+$/, '');
+  const rel = path.replace(/^\/+/, '');
+  return rel ? `${base}/${rel}` : base;
+}
+
+const NAMED_ENTITIES: Record<string, string> = {
+  amp: '&',
+  lt: '<',
+  gt: '>',
+  quot: '"',
+  apos: "'",
+  nbsp: ' ',
+};
+
+/**
+ * Decode the entities the HTML renderers here can emit. This is a single pass,
+ * so `&amp;lt;` correctly yields the literal text `&lt;` rather than `<`.
+ */
+export function decodeEntities(value: string): string {
+  return value.replace(
+    /&(?:([a-zA-Z][a-zA-Z0-9]*)|#(\d+)|#[xX]([0-9a-fA-F]+));/g,
+    (match, name: string | undefined, decimal: string | undefined, hex: string | undefined) => {
+      if (name !== undefined) {
+        return NAMED_ENTITIES[name.toLowerCase()] ?? match;
+      }
+      const code = decimal !== undefined ? parseInt(decimal, 10) : parseInt(hex ?? '', 16);
+      // Reject nulls, lone surrogates and out-of-range code points.
+      if (!Number.isFinite(code) || code <= 0 || code > 0x10ffff) return match;
+      if (code >= 0xd800 && code <= 0xdfff) return match;
+      return String.fromCodePoint(code);
+    }
+  );
+}
+
+// Only sequences that plausibly open a tag, so prose like `a < b and c > d`
+// survives intact.
+const HTML_TAG_RE = /<\/?[a-zA-Z][^>]*>|<![^>]*>/g;
+
+/**
+ * Reduce an HTML fragment to plain, searchable text. Tags become spaces so
+ * that adjacent blocks do not run their words together.
+ */
+export function stripHtml(html: string): string {
+  const withoutBlocks = html
+    .replace(/<script\b[^>]*>[\s\S]*?<\/script\s*>/gi, ' ')
+    .replace(/<style\b[^>]*>[\s\S]*?<\/style\s*>/gi, ' ')
+    .replace(/<!--[\s\S]*?-->/g, ' ');
+  return decodeEntities(withoutBlocks.replace(HTML_TAG_RE, ' '))
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+const FENCE_RE = /^ {0,3}(`{3,}|~{3,})(.*)$/;
+
+/**
+ * Mark which lines sit inside a fenced code block (delimiters included).
+ *
+ * Markdown-aware rewrites must skip these lines: a document that *documents*
+ * footnote or admonition syntax should render its examples verbatim rather
+ * than having them interpreted.
+ */
+export function annotateFences(lines: string[]): boolean[] {
+  const inside: boolean[] = [];
+  let fence: { char: string; length: number } | null = null;
+
+  for (const line of lines) {
+    const match = FENCE_RE.exec(line);
+    if (fence) {
+      inside.push(true);
+      const closes =
+        match !== null &&
+        match[1][0] === fence.char &&
+        match[1].length >= fence.length &&
+        match[2].trim() === '';
+      if (closes) fence = null;
+      continue;
+    }
+    // An info string on a backtick fence may not itself contain a backtick.
+    if (match && !(match[1][0] === '`' && match[2].includes('`'))) {
+      fence = { char: match[1][0], length: match[1].length };
+      inside.push(true);
+      continue;
+    }
+    inside.push(false);
+  }
+
+  return inside;
+}
+
+/** Apply `transform` to every line that is not inside a fenced code block. */
+export function mapUnfencedLines(source: string, transform: (line: string) => string): string {
+  const lines = source.split('\n');
+  const inside = annotateFences(lines);
+  return lines.map((line, index) => (inside[index] ? line : transform(line))).join('\n');
+}
+
+export interface HtmlAttribute {
+  name: string;
+  value: string;
+  /** The quote character used, or `''` when the value was unquoted. */
+  quote: string;
+  start: number;
+  end: number;
+}
+
+// name, optionally followed by ="value" / ='value' / bare-value.
+const ATTRIBUTE_RE = /([^\s=/>]+)(?:\s*=\s*("([^"]*)"|'([^']*)'|([^\s"'=<>`]+)))?/g;
+
+/**
+ * Parse a tag's attribute string into ordered name/value pairs.
+ *
+ * Walking real attribute boundaries matters: a naive `class="..."` search
+ * would happily match the `class=` sitting *inside* another attribute's value
+ * (e.g. `data-x="class='language-js'"`) and splice markup into the middle of it.
+ */
+export function parseAttributes(attrs: string): HtmlAttribute[] {
+  const parsed: HtmlAttribute[] = [];
+  ATTRIBUTE_RE.lastIndex = 0;
+  let match: RegExpExecArray | null;
+
+  while ((match = ATTRIBUTE_RE.exec(attrs)) !== null) {
+    const [raw, name, , doubleQuoted, singleQuoted, bare] = match;
+    const quote = doubleQuoted !== undefined ? '"' : singleQuoted !== undefined ? "'" : '';
+    parsed.push({
+      name,
+      value: doubleQuoted ?? singleQuoted ?? bare ?? '',
+      quote,
+      start: match.index,
+      end: match.index + raw.length,
+    });
+  }
+
+  return parsed;
+}
