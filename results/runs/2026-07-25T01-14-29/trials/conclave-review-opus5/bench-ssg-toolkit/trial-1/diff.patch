@@ -0,0 +1,93 @@
+import { BuildContext, Plugin } from '../core/types.js';
+import { ASSET_MANIFEST_KEY, AssetManifest } from './asset-pipeline.js';
+import { SEARCH_INDEX_PATH, SEARCH_INDEX_PATH_KEY } from './search-index.js';
+
+/**
+ * Derives a serve-time configuration from the finished build: one route per
+ * rendered output, one per discovered asset, and a pointer to the search index.
+ */
+
+export type DevServerHandler = 'static' | 'asset' | 'search' | 'file';
+
+export interface DevServerRoute {
+  path: string;
+  handler: DevServerHandler;
+}
+
+export interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export interface DevServerOptions {
+  /** Port the dev server should listen on. Default 3000. */
+  port?: number;
+  /**
+   * Fallback URL prefix for assets, used only when asset-pipeline did not
+   * publish its own. Default `/assets`.
+   */
+  assetPrefix?: string;
+}
+
+export const DEV_SERVER_CONFIG_KEY = 'dev-server-config';
+export const DEFAULT_DEV_SERVER_PORT = 3000;
+
+function handlerFor(path: string, searchIndexPath: string): DevServerHandler {
+  if (path === searchIndexPath) return 'search';
+  return /\.html?$/i.test(path) ? 'static' : 'file';
+}
+
+function readManifest(ctx: BuildContext): AssetManifest | undefined {
+  const manifest = ctx.data.get(ASSET_MANIFEST_KEY) as AssetManifest | undefined;
+  return manifest && Array.isArray(manifest.assets) ? manifest : undefined;
+}
+
+export function createDevServerPlugin(options: DevServerOptions = {}): Plugin {
+  const port = options.port ?? DEFAULT_DEV_SERVER_PORT;
+  const fallbackPrefix = (options.assetPrefix ?? '/assets').replace(/\/+$/, '');
+
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        // Read the effective paths the upstream plugins actually used rather
+        // than assuming their defaults, so custom options stay consistent.
+        const manifest = readManifest(ctx);
+        const assetPrefix = manifest?.prefix ?? fallbackPrefix;
+        const indexPath =
+          (ctx.data.get(SEARCH_INDEX_PATH_KEY) as string | undefined) ?? SEARCH_INDEX_PATH;
+
+        const routes: DevServerRoute[] = [];
+        const seen = new Set<string>();
+
+        const addRoute = (path: string, handler: DevServerHandler): void => {
+          const normalized = `/${path.replace(/^\/+/, '')}`;
+          if (seen.has(normalized)) return;
+          seen.add(normalized);
+          routes.push({ path: normalized, handler });
+        };
+
+        for (const path of ctx.output.keys()) {
+          addRoute(path, handlerFor(path, indexPath));
+        }
+
+        const assetPaths = manifest ? [...manifest.assets] : [];
+        for (const asset of assetPaths) {
+          addRoute(`${assetPrefix}/${asset}`, 'asset');
+        }
+
+        const config: DevServerConfig = {
+          port,
+          routes,
+          assetPaths,
+          searchIndexPath: ctx.output.has(indexPath) ? `/${indexPath}` : '',
+        };
+        ctx.data.set(DEV_SERVER_CONFIG_KEY, config);
+      },
+    },
+  };
+}
