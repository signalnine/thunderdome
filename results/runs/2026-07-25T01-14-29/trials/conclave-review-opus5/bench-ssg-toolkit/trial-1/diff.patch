index 0000000..58f287f
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,121 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+import { escapeXml, joinUrl, stripXmlInvalid } from './utils.js';
+import { TAXONOMY_TAGS_KEY, TaxonomyIndex } from './taxonomy.js';
+
+/**
+ * Emits an RSS 2.0 feed from the rendered content. Runs after markdown-ext so
+ * item descriptions carry HTML, and after taxonomy so items can be categorised.
+ */
+
+export interface RssFeedOptions {
+  /** Output path for the feed. Default `feed.xml`. */
+  outputPath?: string;
+  /** Cap on the number of items. Default: unlimited. */
+  limit?: number;
+  /** Channel description. Defaults to the site title. */
+  description?: string;
+}
+
+export const RSS_FEED_PATH = 'feed.xml';
+
+function parseDate(value: string | undefined): Date | null {
+  if (!value) return null;
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? null : date;
+}
+
+/** Newest first; undated entries sink to the bottom in their original order. */
+function byDateDescending(files: ContentFile[]): ContentFile[] {
+  return files
+    .map((file, index) => ({ file, index, time: parseDate(file.date)?.getTime() ?? null }))
+    .sort((a, b) => {
+      if (a.time === b.time) return a.index - b.index;
+      if (a.time === null) return 1;
+      if (b.time === null) return -1;
+      return b.time - a.time;
+    })
+    .map(entry => entry.file);
+}
+
+/**
+ * Prefer the taxonomy index (which is normalised and deduplicated) and fall
+ * back to the file's own tags when taxonomy has not run.
+ *
+ * Membership is tested by object identity, not by slug: slugs are not
+ * guaranteed unique, and matching on them would give two files that share a
+ * slug the union of both their tag sets. Taxonomy re-indexes the transformed
+ * files in its own `afterBuild`, which runs first, so the identities line up.
+ */
+function categoriesFor(file: ContentFile, ctx: BuildContext): string[] {
+  const index = ctx.data.get(TAXONOMY_TAGS_KEY) as TaxonomyIndex | undefined;
+  if (index instanceof Map) {
+    const terms: string[] = [];
+    for (const [term, files] of index) {
+      if (files.includes(file)) terms.push(term);
+    }
+    if (terms.length > 0) return terms;
+  }
+  return [...new Set(file.tags ?? [])];
+}
+
+/** CDATA cannot contain `]]>`; split the sequence across two sections. */
+function cdata(value: string): string {
+  return `<![CDATA[${stripXmlInvalid(value).split(']]>').join(']]]]><![CDATA[>')}]]>`;
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext): string {
+  const link = joinUrl(ctx.config.baseUrl, `${file.slug}.html`);
+  const date = parseDate(file.date);
+  const parts = [
+    `      <title>${escapeXml(file.title)}</title>`,
+    `      <link>${escapeXml(link)}</link>`,
+    `      <guid isPermaLink="true">${escapeXml(link)}</guid>`,
+  ];
+  if (date) {
+    parts.push(`      <pubDate>${date.toUTCString()}</pubDate>`);
+  }
+  for (const category of categoriesFor(file, ctx)) {
+    parts.push(`      <category>${escapeXml(category)}</category>`);
+  }
+  parts.push(`      <description>${cdata(file.content ?? '')}</description>`);
+  return `    <item>\n${parts.join('\n')}\n    </item>`;
+}
+
+export function createRssFeedPlugin(options: RssFeedOptions = {}): Plugin {
+  const outputPath = options.outputPath ?? RSS_FEED_PATH;
+
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const ordered = byDateDescending(ctx.files);
+        const selected =
+          options.limit !== undefined && options.limit >= 0
+            ? ordered.slice(0, options.limit)
+            : ordered;
+
+        const description = options.description ?? ctx.config.title;
+        const siteLink = joinUrl(ctx.config.baseUrl, '');
+
+        const channel = [
+          `    <title>${escapeXml(ctx.config.title)}</title>`,
+          `    <link>${escapeXml(siteLink)}</link>`,
+          `    <description>${escapeXml(description)}</description>`,
+          ...selected.map(file => renderItem(file, ctx)),
+        ].join('\n');
+
+        ctx.output.set(
+          outputPath,
+          `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+${channel}
+  </channel>
+</rss>`
+        );
+      },
+    },
+  };
+}
