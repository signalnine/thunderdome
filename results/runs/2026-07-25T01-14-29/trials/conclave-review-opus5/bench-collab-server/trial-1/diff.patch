nt[] = [];\n640\t    for (let i = 0; i < 10; i++) {\n641\t      const c = await createWsClient(port, docId);\n642\t      await waitForMsg(c, 0); // sync\n643\t      clients.push(c);\n644\t    }\n645\t\n646\t    expect(clients.length).toBe(10);\n647\t    for (const c of clients) {\n648\t      expect(c.ws.readyState).toBe(WebSocket.OPEN);\n649\t    }\n650\t\n651\t    for (const c of clients) await closeClient(c);\n652\t  });\n653\t\n654\t  it('10 clients each send an edit, all edits present in final document', async () => {\n655\t    const res = await request(app.app).post('/docs').send({ title: 'StressEdit', content: '' });\n656\t    const docId = res.body.id;\n657\t\n658\t    const clients: WsClient[] = [];\n659\t    for (let i = 0; i < 10; i++) {\n660\t      const c = await createWsClient(port, docId);\n661\t      await waitForMsg(c, 0); // sync\n662\t      clients.push(c);\n663\t    }\n664\t\n665\t    // Each client sends a unique character sequentially\n666\t    for (let i = 0; i < 10; i++) {\n667\t      sendOp(clients[i], { type: 'insert', position: 0, text: String(i) });\n668\t      await delay(30);\n669\t    }\n670\t\n671\t    await delay(1000);\n672\t    const doc = await request(app.app).get(`/docs/${docId}`);\n673\t\n674\t    for (let i = 0; i < 10; i++) {\n675\t      expect(doc.body.content).toContain(String(i));\n676\t    }\n677\t\n678\t    for (const c of clients) await closeClient(c);\n679\t  });\n680\t\n681\t  it('Document content identical across all 10 clients after sync', async () => {\n682\t    const res = await request(app.app).post('/docs').send({ title: 'Sync10', content: '' });\n683\t    const docId = res.body.id;\n684\t\n685\t    const clients: WsClient[] = [];\n686\t    for (let i = 0; i < 10; i++) {\n687\t      const c = await createWsClient(port, docId);\n688\t      await waitForMsg(c, 0); // sync\n689\t      clients.push(c);\n690\t    }\n691\t\n692\t    // One client makes an edit\n693\t    sendOp(clients[0], { type: 'insert', position: 0,