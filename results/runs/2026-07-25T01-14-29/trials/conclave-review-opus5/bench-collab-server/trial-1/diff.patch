+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R9hxi8aEXqLjoFpT8YigZa","type":"tool_result","content":"1\timport Database from 'better-sqlite3';\n2\timport { existsSync, readFileSync } from 'node:fs';\n3\timport { dirname, resolve } from 'node:path';\n4\timport { fileURLToPath } from 'node:url';\n5\t\n6\timport type { Document, Operation, Version } from './models.js';\n7\t\n8\texport type DatabaseHandle = Database.Database;\n9\t\n10\tconst moduleDir = dirname(fileURLToPath(import.meta.url));\n11\t\n12\t/** Locate schema.sql whether running from `src/` (vitest) or `dist/` (compiled). */\n13\tfunction schemaPath(): string {\n14\t  const candidates = [\n15\t    resolve(moduleDir, '..', 'schema.sql'),\n16\t    resolve(moduleDir, '..', '..', 'schema.sql'),\n17\t    resolve(process.cwd(), 'schema.sql'),\n18\t  ];\n19\t  const found = candidates.find((candidate) => existsSync(candidate));\n20\t  if (!found) {\n21\t    throw new Error(`Could not locate schema.sql (looked in: ${candidates.join(', ')})`);\n22\t  }\n23\t  return found;\n24\t}\n25\t\n26\t/**\n27\t * Open (or create) a database and apply the schema.\n28\t *\n29\t * Defaults to an in-memory database so each `createApp()` in tests is isolated.\n30\t * Connection bookkeeping is process-scoped, so stale `active_connections` rows\n31\t * from a previous run are cleared on startup.\n32\t */\n33\texport function createDatabase(dbPath = ':memory:'): DatabaseHandle {\n34\t  const db = new Database(dbPath);\n35\t  db.pragma('foreign_keys = ON');\n36\t  db.exec(readFileSync(schemaPath(), 'utf8'));\n37\t  db.exec('DELETE FROM active_connections');\n38\t  return db;\n39\t}\n40\t\n41\t// ------------------------------------------------------------------\n42\t// Document queries\n43\t// ------------------------------------------------------------------\n44\t\n45\texport function getDocument(db: DatabaseHandle, id: string): Document | undefined {\n46\t  return db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;\n47\t}\n48\t\n49\texport function listDocuments(db: DatabaseHandle): Document[] {\n50\t  return db.prepare('SELECT * FROM documents ORDER BY created_at ASC, id ASC').all() as Document[];\n51\t}\n52\t\n53\t/** Insert a document together with its initial (version 0) history entry. */\n54\texport function insertDocument(db: DatabaseHandle, id: string, title: string, content: string): Document {\n55\t  const create = db.transaction(() => {\n56\t    db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);\n57\t    db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)').run(\n58\t      id,\n59\t      content\n60\t    );\n61\t  });\n62\t  create();\n63\t  return getDocument(db, id) as Document;\n64\t}\n65\t\n66\texport function deleteDocument(db: DatabaseHandle, id: string): boolean {\n67\t  return db.prepare('DELETE FROM documents WHERE id = ?').run(id).changes > 0;\n68\t}\n69\t\n70\t// ------------------------------------------------------------------\n71\t// Version queries\n72\t// ------------------------------------------------------------------\n73\t\n74\texport function listVersions(db: DatabaseHandle, documentId: string): Version[] {\n75\t  return db\n76\t    .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC')\n77\t    .all(documentId) as Version[];\n78\t}\n79\t\n80\texport function getVersion(db: DatabaseHandle, documentId: string, version: number): Version | undefined {\n81\t  return db.prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?').get(documentId, version) as\n82\t    | Version\n83\t    | undefined;\n84\t}\n85\t\n86\texport function getLatestVersion(db: DatabaseHandle, documentId: string): number {\n87\t  const row = db\n88\t    .prepare('SELECT MAX(version) AS version FROM versions WHERE document_id = ?')\n89\t    .get(documentId) as { version: number | null } | undefined;\n90\t  return row?.version ?? 0;\n91\t}\n92\t\n93\t/**\n94\t * Atomically record a new document state: bump the document row and append the\n95\t * version that produced it. Returns the newly committed version number.\n96\t */\n97\texport function commitVersion(\n98\t  db: DatabaseHandle,\n99\t  documentId: string,\n100\t  version: number,\n101\t  content: string,\n102\t  operation: Operation | null\n103\t): number {\n104\t  const commit = db.transaction(() => {\n105\t    db.prepare(\"UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?\").run(\n106\t      content,\n107\t      documentId\n108\t    );\n109\t    db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(\n110\t      documentId,\n111\t      version,\n112\t      content,\n113\t      operation === null ? null : JSON.stringify(operation)\n114\t    );\n115\t  });\n116\t  commit();\n117\t  return version;\n118\t}\n119\t\n120\t// ------------------------------------------------------------------\n121\t// Connection bookkeeping\n122\t// ------------------------------------------------------------------\n123\t\n124\texport function registerConnection(db: DatabaseHandle, id: string, documentId: string): void {\n125\t  db.prepare('INSERT OR REPLACE INTO active_connections (id, document_id) VALUES (?, ?)').run(id, documentId);\n126\t}\n127\t\n128\texport function unregisterConnection(db: DatabaseHandle, id: string): void {\n129\t  db.prepare('DELETE FROM active_connections WHERE id = ?').run(id);\n130\t}\n131\t"}]},"parent_tool_use_id":"toolu_01DdQvo1fuuMamNQQrEXD2gX","session_id":"e246dbcb-e9b4-4717-8ce2-8446dd5eb5a5","uuid":"331091be-2a61-4a23-89a4-2102e252f788","timestamp":"2026-07-25T01:19:24.029Z","subagent_type":"conclave:code-reviewer","task_description":"Review OT and WS correctness"}
