+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UzJuZc2nQdHYpCMVyiqceG","type":"tool_result","content":"1\timport { randomUUID } from 'node:crypto';\n2\timport { Router, type Request, type Response } from 'express';\n3\t\n4\timport {\n5\t  commitVersion,\n6\t  deleteDocument,\n7\t  getDocument,\n8\t  getLatestVersion,\n9\t  getVersion,\n10\t  insertDocument,\n11\t  listDocuments,\n12\t  listVersions,\n13\t  type DatabaseHandle,\n14\t} from './db.js';\n15\timport type { RoomSync } from './models.js';\n16\t\n17\tfunction notFound(res: Response, what = 'Document'): void {\n18\t  res.status(404).json({ error: `${what} not found` });\n19\t}\n20\t\n21\t/**\n22\t * REST API for document CRUD and version history.\n23\t *\n24\t * `rooms` is optional so the routes can be mounted (and tested) without a live\n25\t * WebSocket layer; when present it is notified of out-of-band mutations.\n26\t */\n27\texport function createRoutes(db: DatabaseHandle, rooms?: RoomSync): Router {\n28\t  const router = Router();\n29\t\n30\t  router.post('/docs', (req: Request, res: Response) => {\n31\t    const body = (req.body ?? {}) as { title?: unknown; content?: unknown; id?: unknown };\n32\t    const title = typeof body.title === 'string' ? body.title.trim() : '';\n33\t    if (!title) {\n34\t      res.status(400).json({ error: 'title is required and must be a non-empty string' });\n35\t      return;\n36\t    }\n37\t    if (body.content !== undefined && typeof body.content !== 'string') {\n38\t      res.status(400).json({ error: 'content must be a string' });\n39\t      return;\n40\t    }\n41\t\n42\t    const id = typeof body.id === 'string' && body.id.trim() ? body.id.trim() : randomUUID();\n43\t    if (getDocument(db, id)) {\n44\t      res.status(409).json({ error: 'Document already exists' });\n45\t      return;\n46\t    }\n47\t\n48\t    res.status(201).json(insertDocument(db, id, title, (body.content as string | undefined) ?? ''));\n49\t  });\n50\t\n51\t  router.get('/docs', (_req: Request, res: Response) => {\n52\t    res.json(listDocuments(db));\n53\t  });\n54\t\n55\t  router.get('/docs/:id', (req: Request, res: Response) => {\n56\t    const doc = getDocument(db, req.params.id);\n57\t    if (!doc) {\n58\t      notFound(res);\n59\t      return;\n60\t    }\n61\t    res.json(doc);\n62\t  });\n63\t\n64\t  router.put('/docs/:id', (req: Request, res: Response) => {\n65\t    const doc = getDocument(db, req.params.id);\n66\t    if (!doc) {\n67\t      notFound(res);\n68\t      return;\n69\t    }\n70\t\n71\t    const body = (req.body ?? {}) as { title?: unknown; content?: unknown };\n72\t    if (body.title !== undefined && (typeof body.title !== 'string' || !body.title.trim())) {\n73\t      res.status(400).json({ error: 'title must be a non-empty string' });\n74\t      return;\n75\t    }\n76\t    if (body.content !== undefined && typeof body.content !== 'string') {\n77\t      res.status(400).json({ error: 'content must be a string' });\n78\t      return;\n79\t    }\n80\t\n81\t    if (typeof body.title === 'string') {\n82\t      db.prepare(\"UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?\").run(\n83\t        body.title.trim(),\n84\t        doc.id\n85\t      );\n86\t    }\n87\t\n88\t    // A content rewrite is a real edit, so it earns its own history entry.\n89\t    if (typeof body.content === 'string' && body.content !== doc.content) {\n90\t      commitVersion(db, doc.id, getLatestVersion(db, doc.id) + 1, body.content, null);\n91\t      rooms?.refresh(doc.id);\n92\t    }\n93\t\n94\t    res.json(getDocument(db, doc.id));\n95\t  });\n96\t\n97\t  router.delete('/docs/:id', (req: Request, res: Response) => {\n98\t    if (!deleteDocument(db, req.params.id)) {\n99\t      notFound(res);\n100\t      return;\n101\t    }\n102\t    rooms?.closeRoom(req.params.id, 'Document was deleted');\n103\t    res.status(204).end();\n104\t  });\n105\t\n106\t  router.get('/docs/:id/versions', (req: Request, res: Response) => {\n107\t    if (!getDocument(db, req.params.id)) {\n108\t      notFound(res);\n109\t      return;\n110\t    }\n111\t    res.json(listVersions(db, req.params.id));\n112\t  });\n113\t\n114\t  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {\n115\t    if (!getDocument(db, req.params.id)) {\n116\t      notFound(res);\n117\t      return;\n118\t    }\n119\t    const version = Number(req.params.version);\n120\t    if (!Number.isInteger(version) || version < 0) {\n121\t      res.status(400).json({ error: 'version must be a non-negative integer' });\n122\t      return;\n123\t    }\n124\t    const row = getVersion(db, req.params.id, version);\n125\t    if (!row) {\n126\t      notFound(res, 'Version');\n127\t      return;\n128\t    }\n129\t    res.json(row);\n130\t  });\n131\t\n132\t  return router;\n133\t}\n134\t"}]},"parent_tool_use_id":"toolu_013f2YxM2yzDfkqNF47QhiKo","session_id":"e246dbcb-e9b4-4717-8ce2-8446dd5eb5a5","uuid":"a05d84bd-71c3-47af-a5cd-304ebad7933e","timestamp":"2026-07-25T01:19:28.941Z","subagent_type":"conclave:code-reviewer","task_description":"Review REST persistence and shutdown"}
