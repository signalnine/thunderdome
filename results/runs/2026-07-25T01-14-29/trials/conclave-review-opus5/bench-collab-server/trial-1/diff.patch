+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018sXAahpGcUzMcMrHXoLHbz","type":"tool_result","content":"1\timport type { Operation } from './models.js';\n2\t\n3\t/**\n4\t * Operational Transform primitives.\n5\t *\n6\t * The server keeps a single linear history of operations. A client may submit an\n7\t * operation composed against an older version; the server transforms it against\n8\t * every operation committed since, so that concurrent edits converge.\n9\t */\n10\t\n11\tfunction isFiniteIndex(value: unknown): value is number {\n12\t  return typeof value === 'number' && Number.isInteger(value) && value >= 0;\n13\t}\n14\t\n15\t/** Structural check: does `value` look like an {@link Operation}? */\n16\texport function isOperation(value: unknown): value is Operation {\n17\t  if (typeof value !== 'object' || value === null) return false;\n18\t  const op = value as { type?: unknown; position?: unknown; text?: unknown; count?: unknown };\n19\t  if (!isFiniteIndex(op.position)) return false;\n20\t  if (op.type === 'insert') return typeof op.text === 'string';\n21\t  if (op.type === 'delete') return isFiniteIndex(op.count);\n22\t  return false;\n23\t}\n24\t\n25\t/**\n26\t * Validate an operation's shape and bounds against a document of `contentLength`\n27\t * characters. Returns false rather than throwing so callers can turn it into a\n28\t * protocol error message.\n29\t */\n30\texport function validateOperation(op: unknown, contentLength: number): op is Operation {\n31\t  if (!isOperation(op)) return false;\n32\t  if (!Number.isInteger(contentLength) || contentLength < 0) return false;\n33\t  if (op.position > contentLength) return false;\n34\t  if (op.type === 'delete' && op.position + op.count > contentLength) return false;\n35\t  return true;\n36\t}\n37\t\n38\t/** Apply `op` to `content`, returning the resulting document text. */\n39\texport function applyOperation(content: string, op: Operation): string {\n40\t  if (op.type === 'insert') {\n41\t    const at = clamp(op.position, 0, content.length);\n42\t    return content.slice(0, at) + op.text + content.slice(at);\n43\t  }\n44\t  const start = clamp(op.position, 0, content.length);\n45\t  const end = clamp(start + op.count, start, content.length);\n46\t  return content.slice(0, start) + content.slice(end);\n47\t}\n48\t\n49\t/**\n50\t * Transform `op1` so it can be applied after `op2`, where both were composed\n51\t * against the same document state. `op2` is treated as having happened first,\n52\t * which also breaks ties for insertions at identical positions.\n53\t */\n54\texport function transformOperation(op1: Operation, op2: Operation): Operation {\n55\t  if (op1.type === 'insert') {\n56\t    if (op2.type === 'insert') {\n57\t      // Ties resolve in favour of op2: op1 lands after the text already inserted.\n58\t      if (op1.position < op2.position) return { ...op1 };\n59\t      return { ...op1, position: op1.position + op2.text.length };\n60\t    }\n61\t    const deleteEnd = op2.position + op2.count;\n62\t    if (op1.position <= op2.position) return { ...op1 };\n63\t    if (op1.position >= deleteEnd) return { ...op1, position: op1.position - op2.count };\n64\t    // The insertion point was inside the removed range; collapse it to the seam.\n65\t    return { ...op1, position: op2.position };\n66\t  }\n67\t\n68\t  if (op2.type === 'insert') {\n69\t    const deleteEnd = op1.position + op1.count;\n70\t    if (deleteEnd <= op2.position) return { ...op1 };\n71\t    if (op1.position >= op2.position) return { ...op1, position: op1.position + op2.text.length };\n72\t    // The insertion landed inside the range being removed; remove it too.\n73\t    return { ...op1, count: op1.count + op2.text.length };\n74\t  }\n75\t\n76\t  // delete vs delete: drop the characters op2 already removed.\n77\t  const start1 = op1.position;\n78\t  const end1 = start1 + op1.count;\n79\t  const start2 = op2.position;\n80\t  const end2 = start2 + op2.count;\n81\t  const overlap = Math.max(0, Math.min(end1, end2) - Math.max(start1, start2));\n82\t  const removedBefore = clamp(start1 - start2, 0, op2.count);\n83\t  return { type: 'delete', position: start1 - removedBefore, count: op1.count - overlap };\n84\t}\n85\t\n86\t/** Transform `op` against an ordered list of operations that were committed first. */\n87\texport function transformAgainst(op: Operation, priorOps: readonly Operation[]): Operation {\n88\t  let result = op;\n89\t  for (const prior of priorOps) {\n90\t    result = transformOperation(result, prior);\n91\t  }\n92\t  return result;\n93\t}\n94\t\n95\tfunction clamp(value: number, min: number, max: number): number {\n96\t  return Math.min(Math.max(value, min), max);\n97\t}\n98\t"}]},"parent_tool_use_id":"toolu_01DdQvo1fuuMamNQQrEXD2gX","session_id":"e246dbcb-e9b4-4717-8ce2-8446dd5eb5a5","uuid":"f20bb1fa-6e46-4194-b017-ce1d3f420892","timestamp":"2026-07-25T01:19:22.155Z","subagent_type":"conclave:code-reviewer","task_description":"Review OT and WS correctness"}
