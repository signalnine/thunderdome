index 0000000..1679fae
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,136 @@
+import type { Operation } from './models.js';
+
+/**
+ * Operational Transform primitives.
+ *
+ * The server keeps a single linear history of operations. A client may submit an
+ * operation composed against an older version; the server transforms it against
+ * every operation committed since, so that concurrent edits converge.
+ *
+ * Transform convention: `transformOperation(a, b)` always treats `b` as having
+ * happened first. Because the server is authoritative and only ever rebases
+ * incoming operations onto committed ones, this single direction is all that is
+ * needed for the stored document to converge. Clients that apply operations
+ * optimistically must use the same function, in the same direction, to rebase
+ * their own pending operations onto what the server broadcasts.
+ */
+
+/** Positions and counts must be safe integers: `2**53` breaks position arithmetic. */
+function isIndex(value: unknown): value is number {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0;
+}
+
+/** Structural check: does `value` look like an {@link Operation}? */
+export function isOperation(value: unknown): value is Operation {
+  if (typeof value !== 'object' || value === null) return false;
+  const op = value as { type?: unknown; position?: unknown; text?: unknown; count?: unknown };
+  if (!isIndex(op.position)) return false;
+  if (op.type === 'insert') return typeof op.text === 'string';
+  if (op.type === 'delete') return isIndex(op.count);
+  return false;
+}
+
+/** True when `index` falls between the halves of a surrogate pair. */
+function splitsSurrogatePair(content: string, index: number): boolean {
+  if (index <= 0 || index >= content.length) return false;
+  const before = content.charCodeAt(index - 1);
+  const after = content.charCodeAt(index);
+  return before >= 0xd800 && before <= 0xdbff && after >= 0xdc00 && after <= 0xdfff;
+}
+
+/**
+ * Validate an operation's shape and bounds against the target document, given
+ * either its text or just its length. Passing the text additionally rejects
+ * positions that would bisect a surrogate pair (which would produce invalid
+ * UTF-16). Returns false rather than throwing so callers can turn it into a
+ * protocol error message.
+ */
+export function validateOperation(op: unknown, content: string | number): op is Operation {
+  const contentLength = typeof content === 'string' ? content.length : content;
+  if (!isOperation(op)) return false;
+  if (!Number.isSafeInteger(contentLength) || contentLength < 0) return false;
+  if (op.position > contentLength) return false;
+  if (op.type === 'delete' && op.position + op.count > contentLength) return false;
+
+  if (typeof content === 'string') {
+    const end = op.type === 'delete' ? op.position + op.count : op.position;
+    if (splitsSurrogatePair(content, op.position) || splitsSurrogatePair(content, end)) return false;
+  }
+  return true;
+}
+
+/** True for operations that leave the document unchanged. */
+export function isNoop(op: Operation): boolean {
+  return op.type === 'insert' ? op.text.length === 0 : op.count === 0;
+}
+
+/** Apply `op` to `content`, returning the resulting document text. */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    const at = clamp(op.position, 0, content.length);
+    return content.slice(0, at) + op.text + content.slice(at);
+  }
+  const start = clamp(op.position, 0, content.length);
+  const end = clamp(start + op.count, start, content.length);
+  return content.slice(0, start) + content.slice(end);
+}
+
+/**
+ * Transform `op1` so it can be applied after `op2`, where both were composed
+ * against the same document state. `op2` is treated as having happened first,
+ * which also breaks ties for insertions at identical positions.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert') {
+    if (op2.type === 'insert') {
+      // Ties resolve in favour of op2: op1 lands after the text already inserted.
+      if (op1.position < op2.position) return { ...op1 };
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    const deleteEnd = op2.position + op2.count;
+    if (op1.position <= op2.position) return { ...op1 };
+    if (op1.position >= deleteEnd) return { ...op1, position: op1.position - op2.count };
+    // The insertion point was inside the removed range; collapse it to the seam.
+    return { ...op1, position: op2.position };
+  }
+
+  if (op2.type === 'insert') {
+    const deleteEnd = op1.position + op1.count;
+    if (deleteEnd <= op2.position) return { ...op1 };
+    if (op1.position >= op2.position) return { ...op1, position: op1.position + op2.text.length };
+    // The insertion landed strictly inside the range being removed. A single
+    // {position, count} delete cannot skip over it, so the delete claims the
+    // whole span it targeted, new text included. The alternative — splitting
+    // into two deletes — needs an operation list, which this protocol does not
+    // carry.
+    return { ...op1, count: op1.count + op2.text.length };
+  }
+
+  // delete vs delete: drop the characters op2 already removed.
+  const start1 = op1.position;
+  const end1 = start1 + op1.count;
+  const start2 = op2.position;
+  const end2 = start2 + op2.count;
+  const overlap = Math.max(0, Math.min(end1, end2) - Math.max(start1, start2));
+  const removedBefore = clamp(start1 - start2, 0, op2.count);
+  return { type: 'delete', position: start1 - removedBefore, count: op1.count - overlap };
+}
+
+/**
+ * Transform `op` against an ordered list of operations that were committed first.
+ *
+ * This fold is only sound because each entry of `priorOps` is itself already
+ * rebased onto its predecessors (the server stores the *transformed* form in its
+ * history), so `result` and `prior` always share a context.
+ */
+export function transformAgainst(op: Operation, priorOps: readonly Operation[]): Operation {
+  let result = op;
+  for (const prior of priorOps) {
+    result = transformOperation(result, prior);
+  }
+  return result;
+}
+
+function clamp(value: number, min: number, max: number): number {
+  return Math.min(Math.max(value, min), max);
+}
diff --git a/src/routes.ts b/src/routes.ts
new file mode 100644
index 0000000..b5bafb1
--- /dev/null
+++ b/src/routes.ts
@@ -0,0 +1,139 @@
+import { randomUUID } from 'node:crypto';
+import { Router, type Request, type Response } from 'express';
+
+import {
+  commitVersion,
+  deleteDocument,
+  getDocument,
+  getLatestVersion,
+  getVersion,
+  insertDocument,
+  listDocuments,
+  listVersions,
+  updateDocumentTitle,
+  type DatabaseHandle,
+} from './db.js';
+import type { RoomSync } from './models.js';
+
+/** Ids must survive being embedded in a URL path segment unencoded. */
+const ID_PATTERN = /^[A-Za-z0-9._~-]{1,128}$/;
+
+function notFound(res: Response, what = 'Document'): void {
+  res.status(404).json({ error: `${what} not found` });
+}
+
+/**
+ * REST API for document CRUD and version history.
+ *
+ * `rooms` is optional so the routes can be mounted (and tested) without a live
+ * WebSocket layer; when present it is notified of out-of-band mutations.
+ */
+export function createRoutes(db: DatabaseHandle, rooms?: RoomSync): Router {
+  const router = Router();
+
+  router.post('/docs', (req: Request, res: Response) => {
+    const body = (req.body ?? {}) as { title?: unknown; content?: unknown; id?: unknown };
+    const title = typeof body.title === 'string' ? body.title.trim() : '';
+    if (!title) {
+      res.status(400).json({ error: 'title is required and must be a non-empty string' });
+      return;
+    }
+    if (body.content !== undefined && typeof body.content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+
+    const id = typeof body.id === 'string' && body.id.trim() ? body.id.trim() : randomUUID();
+    if (!ID_PATTERN.test(id)) {
+      res.status(400).json({ error: 'id must be 1-128 characters of [A-Za-z0-9._~-]' });
+      return;
+    }
+    if (getDocument(db, id)) {
+      res.status(409).json({ error: 'Document already exists' });
+      return;
+    }
+
+    res.status(201).json(insertDocument(db, id, title, (body.content as string | undefined) ?? ''));
+  });
+
+  router.get('/docs', (_req: Request, res: Response) => {
+    res.json(listDocuments(db));
+  });
+
+  router.get('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDocument(db, req.params.id);
+    if (!doc) {
+      notFound(res);
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/docs/:id', (req: Request, res: Response) => {
+    const doc = getDocument(db, req.params.id);
+    if (!doc) {
+      notFound(res);
+      return;
+    }
+
+    const body = (req.body ?? {}) as { title?: unknown; content?: unknown };
+    if (body.title !== undefined && (typeof body.title !== 'string' || !body.title.trim())) {
+      res.status(400).json({ error: 'title must be a non-empty string' });
+      return;
+    }
+    if (body.content !== undefined && typeof body.content !== 'string') {
+      res.status(400).json({ error: 'content must be a string' });
+      return;
+    }
+
+    if (typeof body.title === 'string') {
+      updateDocumentTitle(db, doc.id, body.title.trim());
+    }
+
+    // A content rewrite is a real edit, so it earns its own history entry.
+    if (typeof body.content === 'string' && body.content !== doc.content) {
+      commitVersion(db, doc.id, getLatestVersion(db, doc.id) + 1, body.content, null);
+      rooms?.refresh(doc.id);
+    }
+
+    res.json(getDocument(db, doc.id));
+  });
+
+  router.delete('/docs/:id', (req: Request, res: Response) => {
+    if (!deleteDocument(db, req.params.id)) {
+      notFound(res);
+      return;
+    }
+    rooms?.closeRoom(req.params.id, 'Document was deleted');
+    res.status(204).end();
+  });
+
+  router.get('/docs/:id/versions', (req: Request, res: Response) => {
+    if (!getDocument(db, req.params.id)) {
+      notFound(res);
+      return;
+    }
+    res.json(listVersions(db, req.params.id));
+  });
+
+  router.get('/docs/:id/versions/:version', (req: Request, res: Response) => {
+    if (!getDocument(db, req.params.id)) {
+      notFound(res);
+      return;
+    }
+    // Number() would happily accept '0x0', ' ' and '1e2'.
+    if (!/^\d{1,15}$/.test(req.params.version)) {
+      res.status(400).json({ error: 'version must be a non-negative integer' });
+      return;
+    }
+    const version = Number(req.params.version);
+    const row = getVersion(db, req.params.id, version);
+    if (!row) {
+      notFound(res, 'Version');
+      return;
+    }
+    res.json(row);
+  });
+
+  return router;
+}
