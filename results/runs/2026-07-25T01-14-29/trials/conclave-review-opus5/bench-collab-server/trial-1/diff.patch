+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DTGX8xFyB17sM4ExkngaD5","type":"tool_result","content":"1\timport { describe, it, expect, beforeAll, afterAll } from 'vitest';\n2\timport request from 'supertest';\n3\timport WebSocket from 'ws';\n4\timport { createApp, type AppInstance } from '../src/server.js';\n5\t\n6\t// ============================================================\n7\t// Test Helpers\n8\t// ============================================================\n9\t\n10\tinterface WsClient {\n11\t  ws: WebSocket;\n12\t  messages: Record<string, unknown>[];\n13\t}\n14\t\n15\tfunction createWsClient(port: number, docId: string): Promise<WsClient> {\n16\t  return new Promise((resolve, reject) => {\n17\t    const ws = new WebSocket(`ws://localhost:${port}/${docId}`);\n18\t    const messages: Record<string, unknown>[] = [];\n19\t    ws.on('message', (data) => {\n20\t      messages.push(JSON.parse(data.toString()));\n21\t    });\n22\t    ws.on('open', () => resolve({ ws, messages }));\n23\t    ws.on('error', reject);\n24\t  });\n25\t}\n26\t\n27\t/** Wait for the messages array to have at least `idx + 1` entries, then return messages[idx]. */\n28\tfunction waitForMsg(client: WsClient, idx: number, timeout = 3000): Promise<Record<string, unknown>> {\n29\t  return new Promise((resolve, reject) => {\n30\t    if (client.messages.length > idx) {\n31\t      resolve(client.messages[idx]);\n32\t      return;\n33\t    }\n34\t    const timer = setTimeout(\n35\t      () => reject(new Error(`Timed out waiting for message at index ${idx} (have ${client.messages.length})`)),\n36\t      timeout\n37\t    );\n38\t    const interval = setInterval(() => {\n39\t      if (client.messages.length > idx) {\n40\t        clearTimeout(timer);\n41\t        clearInterval(interval);\n42\t        resolve(client.messages[idx]);\n43\t      }\n44\t    }, 5);\n45\t  });\n46\t}\n47\t\n48\t\n49\tfunction delay(ms: number): Promise<void> {\n50\t  return new Promise((resolve) => setTimeout(resolve, ms));\n51\t}\n52\t\n53\tfunction sendOp(client: WsClient, operation: Record<string, unknown>, version?: number) {\n54\t  const msg: Record<string, unknown> = { type: 'operation', operation };\n55\t  if (version !== undefined) msg.version = version;\n56\t  client.ws.send(JSON.stringify(msg));\n57\t}\n58\t\n59\tfunction closeClient(client: WsClient): Promise<void> {\n60\t  return new Promise((resolve) => {\n61\t    if (client.ws.readyState === WebSocket.CLOSED || client.ws.readyState === WebSocket.CLOSING) {\n62\t      resolve();\n63\t      return;\n64\t    }\n65\t    client.ws.on('close', () => resolve());\n66\t    client.ws.close();\n67\t  });\n68\t}\n69\t\n70\t// ============================================================\n71\t// REST CRUD Tests\n72\t// ============================================================\n73\t\n74\tdescribe('REST CRUD', () => {\n75\t  let app: AppInstance;\n76\t\n77\t  beforeAll(async () => {\n78\t    app = createApp();\n79\t    await app.start(0);\n80\t  });\n81\t\n82\t  afterAll(async () => {\n83\t    await app.stop();\n84\t  });\n85\t\n86\t  it('POST /docs creates document with title', async () => {\n87\t    const res = await request(app.app).post('/docs').send({ title: 'Test Doc' });\n88\t    expect(res.status).toBe(201);\n89\t    expect(res.body.title).toBe('Test Doc');\n90\t  });\n91\t\n92\t  it('POST /docs returns id, title, content, timestamps', async () => {\n93\t    const res = await request(app.app).post('/docs').send({ title: 'Full Doc' });\n94\t    expect(res.body).toHaveProperty('id');\n95\t    expect(res.body).toHaveProperty('title');\n96\t    expect(res.body).toHaveProperty('content');\n97\t    expect(res.body).toHaveProperty('created_at');\n98\t    expect(res.body).toHaveProperty('updated_at');\n99\t  });\n100\t\n101\t  it('GET /docs lists all documents', async () => {\n102\t    const res = await request(app.app).get('/docs');\n103\t    expect(res.status).toBe(200);\n104\t    expect(Array.isArray(res.body)).toBe(true);\n105\t    expect(res.body.length).toBeGreaterThanOrEqual(2);\n106\t  });\n107\t\n108\t  it('GET /docs/:id returns specific document', async () => {\n109\t    const created = await request(app.app).post('/docs').send({ title: 'Specific' });\n110\t    const res = await request(app.app).get(`/docs/${created.body.id}`);\n111\t    expect(res.status).toBe(200);\n112\t    expect(res.body.title).toBe('Specific');\n113\t  });\n114\t\n115\t  it('GET /docs/:id returns 404 for non-existent', async () => {\n116\t    const res = await request(app.app).get('/docs/nonexistent-id');\n117\t    expect(res.status).toBe(404);\n118\t  });\n119\t\n120\t  it('PUT /docs/:id updates title', async () => {\n121\t    const created = await request(app.app).post('/docs').send({ title: 'Old Title' });\n122\t    const res = await request(app.app).put(`/docs/${created.body.id}`).send({ title: 'New Title' });\n123\t    expect(res.status).toBe(200);\n124\t    expect(res.body.title).toBe('New Title');\n125\t  });\n126\t\n127\t  it('DELETE /docs/:id removes document', async () => {\n128\t    const created = await request(app.app).post('/docs').send({ title: 'To Delete' });\n129\t    const res = await request(app.app).delete(`/docs/${created.body.id}`);\n130\t    expect(res.status).toBe(204);\n131\t    const check = await request(app.app).get(`/docs/${created.body.id}`);\n132\t    expect(check.status).toBe(404);\n133\t  });\n134\t\n135\t  it('DELETE /docs/:id returns 404 for non-existent', async () => {\n136\t    const res = await request(app.app).delete('/docs/nonexistent-id');\n137\t    expect(res.status).toBe(404);\n138\t  });\n139\t\n140\t  it('GET /docs/:id/versions lists version history', async () => {\n141\t    const created = await request(app.app).post('/docs').send({ title: 'Versioned' });\n142\t    const res = await request(app.app).get(`/docs/${created.body.id}/versions`);\n143\t    expect(res.status).toBe(200);\n144\t    expect(Array.isArray(res.body)).toBe(true);\n145\t    expect(res.body.length).toBeGreaterThanOrEqual(1);\n146\t    expect(res.body[0].version).toBe(0);\n147\t  });\n148\t\n149\t  it('GET /docs/:id/versions/:version returns specific version content', async () => {\n150\t    const created = await request(app.app).post('/docs').send({ title: 'Versioned2' });\n151\t    const res = await request(app.app).get(`/docs/${created.body.id}/versions/0`);\n152\t    expect(res.status).toBe(200);\n153\t    expect(res.body).toHaveProperty('content');\n154\t    expect(res.body.version).toBe(0);\n155\t  });\n156\t});\n157\t\n158\t// ============================================================\n159\t// WebSocket Lifecycle Tests\n160\t// ============================================================\n161\t\n162\tdescribe('WebSocket Lifecycle', () => {\n163\t  let app: AppInstance;\n164\t  let port: number;\n165\t  let docId: string;\n166\t\n167\t  beforeAll(async () => {\n168\t    app = createApp();\n169\t    port = await app.start(0);\n170\t    const res = await request(app.app).post('/docs').send({ title: 'WS Doc' });\n171\t    docId = res.body.id;\n172\t  });\n173\t\n174\t  afterAll(async () => {\n175\t    await app.stop();\n176\t  });\n177\t\n178\t  it('Client connects to ws://.../:docId', async () => {\n179\t    const client = await createWsClient(port, docId);\n180\t    expect(client.ws.readyState).toBe(WebSocket.OPEN);\n181\t    await waitForMsg(client, 0);\n182\t    await closeClient(client);\n183\t  });\n184\t\n185\t  it('Client receives current document content on connect', async () => {\n186\t    const client = await createWsClient(port, docId);\n187\t    const msg = await waitForMsg(client, 0);\n188\t    expect(msg.type).toBe('sync');\n189\t    expect(msg).toHaveProperty('content');\n190\t    expect(msg).toHaveProperty('version');\n191\t    await closeClient(client);\n192\t  });\n193\t\n194\t  it('Client sends edit operation and receives acknowledgment', async () => {\n195\t    const client = await createWsClient(port, docId);\n196\t    await waitForMsg(client, 0); // sync\n197\t    sendOp(client, { type: 'insert', position: 0, text: 'Hello' });\n198\t    const ack = await waitForMsg(client, 1);\n199\t    expect(ack.type).toBe('ack');\n200\t    expect(ack).toHaveProperty('version');\n201\t    await closeClient(client);\n202\t  });\n203\t\n204\t  it('Server broadcasts operation to other clients in same document', async () => {\n205\t    const c1 = await createWsClient(port, docId);\n206\t    await waitForMsg(c1, 0); // sync\n207\t    const c2 = await createWsClient(port, docId);\n208\t    await waitForMsg(c2, 0); // sync\n209\t\n210\t    sendOp(c1, { type: 'insert', position: 0, text: 'Broadcast' });\n211\t    await waitForMsg(c1, 1); // ack for c1\n212\t\n213\t    const broadcast = await waitForMsg(c2, 1); // broadcast for c2\n214\t    expect(broadcast.type).toBe('operation');\n215\t    expect(broadcast).toHaveProperty('operation');\n216\t\n217\t    await closeClient(c1);\n218\t    await closeClient(c2);\n219\t  });\n220\t\n221\t  it('Client does not receive own operations back as broadcast', async () => {\n222\t    const client = await createWsClient(port, docId);\n223\t    await waitForMsg(client, 0); // sync\n224\t\n225\t    sendOp(client, { type: 'insert', position: 0, text: 'Self' });\n226\t    const msg = await waitForMsg(client, 1);\n227\t    // Should get ack, not operation broadcast\n228\t    expect(msg.type).toBe('ack');\n229\t\n230\t    await closeClient(client);\n231\t  });\n232\t\n233\t  it('Client disconnects cleanly', async () => {\n234\t    const client = await createWsClient(port, docId);\n235\t    await waitForMsg(client, 0); // sync\n236\t    await closeClient(client);\n237\t    expect(client.ws.readyState).toBe(WebSocket.CLOSED);\n238\t  });\n239\t\n240\t  it('Multiple clients can join same document', async () => {\n241\t    const clients: WsClient[] = [];\n242\t    for (let i = 0; i < 3; i++) {\n243\t      const c = await createWsClient(port, docId);\n244\t      await waitForMsg(c, 0); // sync\n245\t      clients.push(c);\n246\t    }\n247\t    expect(clients.length).toBe(3);\n248\t    for (const c of clients) {\n249\t      expect(c.ws.readyState).toBe(WebSocket.OPEN);\n250\t      await closeClient(c);\n251\t    }\n252\t  });\n253\t\n254\t  it('Client joining different document does not receive other doc edits', async () => {\n255\t    const res2 = await request(app.app).post('/docs').send({ title: 'Other Doc' });\n256\t    const otherDocId = res2.body.id;\n257\t\n258\t    const c1 = await createWsClient(port, docId);\n259\t    await waitForMsg(c1, 0); // sync\n260\t    const c2 = await createWsClient(port, otherDocId);\n261\t    await waitForMsg(c2, 0); // sync\n262\t\n263\t    sendOp(c1, { type: 'insert', position: 0, text: 'Private' });\n264\t    await waitForMsg(c1, 1); // ack\n265\t\n266\t    // Give time for potential unwanted messages\n267\t    await delay(200);\n268\t\n269\t    // c2 should only have the sync message (index 0), nothing else\n270\t    expect(c2.messages.length).toBe(1);\n271\t\n272\t    await closeClient(c1);\n273\t    await closeClient(c2);\n274\t  });\n275\t});\n276\t\n277\t// ============================================================\n278\t// Single Client Editing Tests\n279\t// ============================================================\n280\t\n281\tdescribe('Single Client Editing', () => {\n282\t  let app: AppInstance;\n283\t  let port: number;\n284\t\n285\t  beforeAll(async () => {\n286\t    app = createApp();\n287\t    port = await app.start(0);\n288\t  });\n289\t\n290\t  afterAll(async () => {\n291\t    await app.stop();\n292\t  });\n293\t\n294\t  it('Insert at beginning of document', async () => {\n295\t    const res = await request(app.app).post('/docs').send({ title: 'Begin', content: 'World' });\n296\t    const docId = res.body.id;\n297\t    const client = await createWsClient(port, docId);\n298\t    await waitForMsg(client, 0); // sync\n299\t\n300\t    sendOp(client, { type: 'insert', position: 0, text: 'Hello ' });\n301\t    await waitForMsg(client, 1); // ack\n302\t\n303\t    const doc = await request(app.app).get(`/docs/${docId}`);\n304\t    expect(doc.body.content).toBe('Hello World');\n305\t\n306\t    await closeClient(client);\n307\t  });\n308\t\n309\t  it('Insert at end of document', async () => {\n310\t    const res = await request(app.app).post('/docs').send({ title: 'End', content: 'Hello' });\n311\t    const docId = res.body.id;\n312\t    const client = await createWsClient(port, docId);\n313\t    await waitForMsg(client, 0); // sync\n314\t\n315\t    sendOp(client, { type: 'insert', position: 5, text: ' World' });\n316\t    await waitForMsg(client, 1); // ack\n317\t\n318\t    const doc = await request(app.app).get(`/docs/${docId}`);\n319\t    expect(doc.body.content).toBe('Hello World');\n320\t\n321\t    await closeClient(client);\n322\t  });\n323\t\n324\t  it('Insert in middle of document', async () => {\n325\t    const res = await request(app.app).post('/docs').send({ title: 'Mid', content: 'Helo World' });\n326\t    const docId = res.body.id;\n327\t    const client = await createWsClient(port, docId);\n328\t    await waitForMsg(client, 0); // sync\n329\t\n330\t    sendOp(client, { type: 'insert', position: 3, text: 'l' });\n331\t    await waitForMsg(client, 1); // ack\n332\t\n333\t    const doc = await request(app.app).get(`/docs/${docId}`);\n334\t    expect(doc.body.content).toBe('Hello World');\n335\t\n336\t    await closeClient(client);\n337\t  });\n338\t\n339\t  it('Delete range from document', async () => {\n340\t    const res = await request(app.app).post('/docs').send({ title: 'Del', content: 'Hello Cruel World' });\n341\t    const docId = res.body.id;\n342\t    const client = await createWsClient(port, docId);\n343\t    await waitForMsg(client, 0); // sync\n344\t\n345\t    sendOp(client, { type: 'delete', position: 5, count: 6 });\n346\t    await waitForMsg(client, 1); // ack\n347\t\n348\t    const doc = await request(app.app).get(`/docs/${docId}`);\n349\t    expect(doc.body.content).toBe('Hello World');\n350\t\n351\t    await closeClient(client);\n352\t  });\n353\t\n354\t  it('Multiple sequential edits build up content correctly', async () => {\n355\t    const res = await request(app.app).post('/docs').send({ title: 'Sequential' });\n356\t    const docId = res.body.id;\n357\t    const client = await createWsClient(port, docId);\n358\t    await waitForMsg(client, 0); // sync (msg 0)\n359\t\n360\t    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n361\t    await waitForMsg(client, 1); // ack (msg 1)\n362\t    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n363\t    await waitForMsg(client, 2); // ack (msg 2)\n364\t    sendOp(client, { type: 'insert', position: 2, text: 'C' });\n365\t    await waitForMsg(client, 3); // ack (msg 3)\n366\t\n367\t    const doc = await request(app.app).get(`/docs/${docId}`);\n368\t    expect(doc.body.content).toBe('ABC');\n369\t\n370\t    await closeClient(client);\n371\t  });\n372\t\n373\t  it('Version is incremented after each edit', async () => {\n374\t    const res = await request(app.app).post('/docs').send({ title: 'Version' });\n375\t    const docId = res.body.id;\n376\t    const client = await createWsClient(port, docId);\n377\t    await waitForMsg(client, 0); // sync\n378\t\n379\t    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n380\t    const ack1 = await waitForMsg(client, 1);\n381\t    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n382\t    const ack2 = await waitForMsg(client, 2);\n383\t\n384\t    expect((ack2 as { version: number }).version).toBeGreaterThan(\n385\t      (ack1 as { version: number }).version\n386\t    );\n387\t\n388\t    await closeClient(client);\n389\t  });\n390\t});\n391\t\n392\t// ============================================================\n393\t// Two-Client Convergence Tests\n394\t// ============================================================\n395\t\n396\tdescribe('Two-Client Convergence', () => {\n397\t  let app: AppInstance;\n398\t  let port: number;\n399\t\n400\t  beforeAll(async () => {\n401\t    app = createApp();\n402\t    port = await app.start(0);\n403\t  });\n404\t\n405\t  afterAll(async () => {\n406\t    await app.stop();\n407\t  });\n408\t\n409\t  it('Two clients editing different positions converge to same content', async () => {\n410\t    const res = await request(app.app).post('/docs').send({ title: 'Converge', content: 'ABCDEF' });\n411\t    const docId = res.body.id;\n412\t\n413\t    const c1 = await createWsClient(port, docId);\n414\t    const sync1 = await waitForMsg(c1, 0);\n415\t    const c2 = await createWsClient(port, docId);\n416\t    await waitForMsg(c2, 0);\n417\t\n418\t    const version = (sync1 as { version: number }).version;\n419\t\n420\t    // Client 1 inserts at position 0\n421\t    sendOp(c1, { type: 'insert', position: 0, text: 'X' }, version);\n422\t    await waitForMsg(c1, 1); // ack\n423\t    await waitForMsg(c2, 1); // broadcast\n424\t\n425\t    // Client 2 inserts at position 7 (after \"X\" was added, \"XABCDEF\" is 7 chars, insert at end)\n426\t    sendOp(c2, { type: 'insert', position: 7, text: 'Y' }, version + 1);\n427\t    await waitForMsg(c2, 2); // ack\n428\t\n429\t    await delay(100);\n430\t    const doc = await request(app.app).get(`/docs/${docId}`);\n431\t    expect(doc.body.content).toBe('XABCDEFY');\n432\t\n433\t    await closeClient(c1);\n434\t    await closeClient(c2);\n435\t  });\n436\t\n437\t  it('Two clients inserting at same position both insertions preserved', async () => {\n438\t    const res = await request(app.app).post('/docs').send({ title: 'SamePos', content: '' });\n439\t    const docId = res.body.id;\n440\t\n441\t    const c1 = await createWsClient(port, docId);\n442\t    const sync1 = await waitForMsg(c1, 0);\n443\t    const c2 = await createWsClient(port, docId);\n444\t    await waitForMsg(c2, 0);\n445\t    const version = (sync1 as { version: number }).version;\n446\t\n447\t    // Both insert at position 0\n448\t    sendOp(c1, { type: 'insert', position: 0, text: 'A' }, version);\n449\t    await waitForMsg(c1, 1); // ack\n450\t    await waitForMsg(c2, 1); // broadcast\n451\t\n452\t    sendOp(c2, { type: 'insert', position: 0, text: 'B' }, version);\n453\t    await waitForMsg(c2, 2); // ack\n454\t\n455\t    await delay(100);\n456\t    const doc = await request(app.app).get(`/docs/${docId}`);\n457\t    expect(doc.body.content).toContain('A');\n458\t    expect(doc.body.content).toContain('B');\n459\t    expect(doc.body.content.length).toBe(2);\n460\t\n461\t    await closeClient(c1);\n462\t    await closeClient(c2);\n463\t  });\n464\t\n465\t  it('Client A inserts, Client B deletes: both changes applied', async () => {\n466\t    const res = await request(app.app).post('/docs').send({ title: 'InsertDelete', content: 'Hello World' });\n467\t    const docId = res.body.id;\n468\t\n469\t    const c1 = await createWsClient(port, docId);\n470\t    const sync1 = await waitForMsg(c1, 0);\n471\t    const c2 = await createWsClient(port, docId);\n472\t    await waitForMsg(c2, 0);\n473\t    const version = (sync1 as { version: number }).version;\n474\t\n475\t    // Client 1 inserts at beginning\n476\t    sendOp(c1, { type: 'insert', position: 0, text: 'Hey ' }, version);\n477\t    await waitForMsg(c1, 1); // ack\n478\t    await waitForMsg(c2, 1); // broadcast\n479\t\n480\t    // Client 2 deletes \"World\" (now at position 10 because \"Hey \" shifted it; \"Hey Hello World\")\n481\t    // After transform: \"Hey Hello World\" - delete at pos 10 count 5 = \"Hey Hello \"\n482\t    sendOp(c2, { type: 'delete', position: 10, count: 5 }, version + 1);\n483\t    await waitForMsg(c2, 2); // ack\n484\t\n485\t    await delay(100);\n486\t    const doc = await request(app.app).get(`/docs/${docId}`);\n487\t    expect(doc.body.content).toContain('Hey');\n488\t    expect(doc.body.content).not.toContain('World');\n489\t\n490\t    await closeClient(c1);\n491\t    await closeClient(c2);\n492\t  });\n493\t\n494\t  it('Rapid alternating edits from two clients converge', async () => {\n495\t    const res = await request(app.app).post('/docs').send({ title: 'Rapid', content: '' });\n496\t    const docId = res.body.id;\n497\t\n498\t    const c1 = await createWsClient(port, docId);\n499\t    await waitForMsg(c1, 0); // sync\n500\t    const c2 = await createWsClient(port, docId);\n501\t    await waitForMsg(c2, 0); // sync\n502\t\n503\t    // Alternating edits - each appends a char\n504\t    for (let i = 0; i < 5; i++) {\n505\t      sendOp(c1, { type: 'insert', position: i * 2, text: 'A' });\n506\t      await delay(50);\n507\t      sendOp(c2, { type: 'insert', position: i * 2 + 1, text: 'B' });\n508\t      await delay(50);\n509\t    }\n510\t\n511\t    await delay(500);\n512\t    const doc = await request(app.app).get(`/docs/${docId}`);\n513\t    // All 10 characters should be present\n514\t    expect(doc.body.content.length).toBe(10);\n515\t\n516\t    await closeClient(c1);\n517\t    await closeClient(c2);\n518\t  });\n519\t\n520\t  it('Both clients can fetch document and see identical content after sync', async () => {\n521\t    const res = await request(app.app).post('/docs').send({ title: 'Identical', content: 'Start' });\n522\t    const docId = res.body.id;\n523\t\n524\t    const c1 = await createWsClient(port, docId);\n525\t    await waitForMsg(c1, 0);\n526\t    const c2 = await createWsClient(port, docId);\n527\t    await waitForMsg(c2, 0);\n528\t\n529\t    sendOp(c1, { type: 'insert', position: 5, text: ' End' });\n530\t    await waitForMsg(c1, 1); // ack\n531\t    await waitForMsg(c2, 1); // broadcast\n532\t\n533\t    await delay(100);\n534\t    const doc1 = await request(app.app).get(`/docs/${docId}`);\n535\t    const doc2 = await request(app.app).get(`/docs/${docId}`);\n536\t    expect(doc1.body.content).toBe(doc2.body.content);\n537\t    expect(doc1.body.content).toBe('Start End');\n538\t\n539\t    await closeClient(c1);\n540\t    await closeClient(c2);\n541\t  });\n542\t\n543\t  it('Version history contains all operations in order', async () => {\n544\t    const res = await request(app.app).post('/docs').send({ title: 'History', content: '' });\n545\t    const docId = res.body.id;\n546\t\n547\t    const client = await createWsClient(port, docId);\n548\t    await waitForMsg(client, 0); // sync\n549\t\n550\t    sendOp(client, { type: 'insert', position: 0, text: 'A' });\n551\t    await waitForMsg(client, 1);\n552\t    sendOp(client, { type: 'insert', position: 1, text: 'B' });\n553\t    await waitForMsg(client, 2);\n554\t    sendOp(client, { type: 'insert', position: 2, text: 'C' });\n555\t    await waitForMsg(client, 3);\n556\t\n557\t    const versions = await request(app.app).get(`/docs/${docId}/versions`);\n558\t    expect(versions.body.length).toBeGreaterThanOrEqual(4); // version 0 + 3 edits\n559\t    for (let i = 1; i < versions.body.length; i++) {\n560\t      expect(versions.body[i].version).toBeGreaterThan(versions.body[i - 1].version);\n561\t    }\n562\t\n563\t    await closeClient(client);\n564\t  });\n565\t\n566\t  it('Concurrent edits do not lose data', async () => {\n567\t    const res = await request(app.app).post('/docs').send({ title: 'NoLoss', content: '' });\n568\t    const docId = res.body.id;\n569\t\n570\t    const c1 = await createWsClient(port, docId);\n571\t    const sync1 = await waitForMsg(c1, 0);\n572\t    const c2 = await createWsClient(port, docId);\n573\t    await waitForMsg(c2, 0);\n574\t    const version = (sync1 as { version: number }).version;\n575\t\n576\t    // Both send edits based on same initial version\n577\t    sendOp(c1, { type: 'insert', position: 0, text: 'FIRST' }, version);\n578\t    sendOp(c2, { type: 'insert', position: 0, text: 'SECOND' }, version);\n579\t\n580\t    // Wait for messages to settle\n581\t    await delay(500);\n582\t\n583\t    const doc = await request(app.app).get(`/docs/${docId}`);\n584\t    expect(doc.body.content).t