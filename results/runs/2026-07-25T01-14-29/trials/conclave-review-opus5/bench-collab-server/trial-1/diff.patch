new file mode 100644
index 0000000..d0a60f1
--- /dev/null
+++ b/src/models.ts
@@ -0,0 +1,78 @@
+/**
+ * Shared domain types for the collaborative Markdown editing server.
+ */
+
+/** A stored Markdown document. */
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+/** A single point in a document's history. */
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  /** JSON encoded {@link Operation} that produced this version, null for the initial version. */
+  operation: string | null;
+  created_at: string;
+}
+
+/** A row of the `active_connections` table. */
+export interface ActiveConnection {
+  id: string;
+  document_id: string;
+  connected_at: string;
+}
+
+/** Insert `text` at `position`. */
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+/** Remove `count` characters starting at `position`. */
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
+
+/** Message sent by a client over the WebSocket. */
+export interface ClientOperationMessage {
+  type: 'operation';
+  operation: Operation;
+  /** Document version the operation was composed against. Defaults to the server's current version. */
+  version?: number;
+}
+
+export type ServerMessage =
+  | { type: 'sync'; documentId: string; content: string; version: number }
+  | { type: 'ack'; documentId: string; version: number; operation: Operation }
+  | {
+      type: 'operation';
+      documentId: string;
+      version: number;
+      /** Document version the broadcast operation applies to (`version - 1`). */
+      baseVersion: number;
+      operation: Operation;
+    }
+  | { type: 'error'; message: string };
+
+/**
+ * Hook the REST layer uses to keep live WebSocket rooms in step with out-of-band
+ * changes (a PUT that rewrites content, or a DELETE that removes the document).
+ */
+export interface RoomSync {
+  /** Reload a room's cached state from the database. */
+  refresh(documentId: string): void;
+  /** Tear down a room, disconnecting anyone still attached. */
+  closeRoom(documentId: string, reason: string): void;
+}
