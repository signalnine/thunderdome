+{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CdMuJDTdmawxP5mSuuutR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013q8bpJqct7Kk8BvpQ9wgAD","name":"Write","input":{"file_path":"/workspace/src/db.ts","content":"import Database from 'better-sqlite3';\nimport { existsSync, readFileSync } from 'node:fs';\nimport { dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport type { Document, Operation, Version } from './models.js';\n\nexport type DatabaseHandle = Database.Database;\n\nconst moduleDir = dirname(fileURLToPath(import.meta.url));\n\n/** Locate schema.sql whether running from `src/` (vitest) or `dist/` (compiled). */\nfunction schemaPath(): string {\n  const candidates = [\n    resolve(moduleDir, '..', 'schema.sql'),\n    resolve(moduleDir, '..', '..', 'schema.sql'),\n    resolve(process.cwd(), 'schema.sql'),\n  ];\n  const found = candidates.find((candidate) => existsSync(candidate));\n  if (!found) {\n    throw new Error(`Could not locate schema.sql (looked in: ${candidates.join(', ')})`);\n  }\n  return found;\n}\n\n/**\n * better-sqlite3 does not cache prepared statements, and re-preparing on every\n * call is ~8x slower on the edit hot path. Cache per handle so a closed database\n * can never hand a stale statement to a freshly opened one.\n */\nconst statementCache = new WeakMap<DatabaseHandle, Map<string, Database.Statement>>();\n\nfunction stmt(db: DatabaseHandle, sql: string): Database.Statement {\n  let perDb = statementCache.get(db);\n  if (!perDb) {\n    perDb = new Map();\n    statementCache.set(db, perDb);\n  }\n  let prepared = perDb.get(sql);\n  if (!prepared) {\n    prepared = db.prepare(sql);\n    perDb.set(sql, prepared);\n  }\n  return prepared;\n}\n\n/**\n * Open (or create) a database and apply the schema.\n *\n * Defaults to an in-memory database so each `createApp()` in tests is isolated.\n *\n * Connection bookkeeping is process-scoped: `active_connections` is truncated on\n * startup so rows orphaned by a crash do not linger. That assumes a single\n * process owns the file — two servers sharing one database file would clear each\n * other's live connections.\n */\nexport function createDatabase(dbPath = ':memory:'): DatabaseHandle {\n  const db = new Database(dbPath);\n  db.pragma('foreign_keys = ON');\n  db.exec(readFileSync(schemaPath(), 'utf8'));\n  db.exec('DELETE FROM active_connections');\n  return db;\n}\n\n// ------------------------------------------------------------------\n// Document queries\n// ------------------------------------------------------------------\n\nexport function getDocument(db: DatabaseHandle, id: string): Document | undefined {\n  return stmt(db, 'SELECT * FROM documents WHERE id = ?').get(id) as Document | undefined;\n}\n\nexport function listDocuments(db: DatabaseHandle): Document[] {\n  return stmt(db, 'SELECT * FROM documents ORDER BY created_at ASC, id ASC').all() as Document[];\n}\n\n/** Insert a document together with its initial (version 0) history entry. */\nexport function insertDocument(db: DatabaseHandle, id: string, title: string, content: string): Document {\n  const create = db.transaction(() => {\n    stmt(db, 'INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);\n    stmt(db, 'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)').run(\n      id,\n      content\n    );\n  });\n  create();\n  return getDocument(db, id) as Document;\n}\n\nexport function updateDocumentTitle(db: DatabaseHandle, id: string, title: string): void {\n  stmt(db, \"UPDATE documents SET title = ?, updated_at = datetime('now') WHERE id = ?\").run(title, id);\n}\n\nexport function deleteDocument(db: DatabaseHandle, id: string): boolean {\n  return stmt(db, 'DELETE FROM documents WHERE id = ?').run(id).changes > 0;\n}\n\n// ------------------------------------------------------------------\n// Version queries\n// ------------------------------------------------------------------\n\nexport function listVersions(db: DatabaseHandle, documentId: string): Version[] {\n  return stmt(db, 'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC').all(\n    documentId\n  ) as Version[];\n}\n\n/** Just the history needed to rebuild a room's OT state — avoids loading every content blob. */\nexport function listVersionOperations(\n  db: DatabaseHandle,\n  documentId: string\n): { version: number; operation: string | null }[] {\n  return stmt(db, 'SELECT version, operation FROM versions WHERE document_id = ? ORDER BY version ASC').all(\n    documentId\n  ) as { version: number; operation: string | null }[];\n}\n\nexport function getVersion(db: DatabaseHandle, documentId: string, version: number): Version | undefined {\n  return stmt(db, 'SELECT * FROM versions WHERE document_id = ? AND version = ?').get(documentId, version) as\n    | Version\n    | undefined;\n}\n\nexport function getLatestVersion(db: DatabaseHandle, documentId: string): number {\n  const row = stmt(db, 'SELECT MAX(version) AS version FROM versions WHERE document_id = ?').get(\n    documentId\n  ) as { version: number | null } | undefined;\n  return row?.version ?? 0;\n}\n\n/**\n * Atomically record a new document state: bump the document row and append the\n * version that produced it. Returns the newly committed version number.\n */\nexport function commitVersion(\n  db: DatabaseHandle,\n  documentId: string,\n  version: number,\n  content: string,\n  operation: Operation | null\n): number {\n  const commit = db.transaction(() => {\n    stmt(db, \"UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?\").run(\n      content,\n      documentId\n    );\n    stmt(db, 'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(\n      documentId,\n      version,\n      content,\n      operation === null ? null : JSON.stringify(operation)\n    );\n  });\n  commit();\n  return