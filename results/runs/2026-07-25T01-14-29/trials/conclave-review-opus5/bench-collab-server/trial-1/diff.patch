new file mode 100644
index 0000000..924ad97
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,118 @@
+import { createServer, type Server } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import type { Socket } from 'node:net';
+import express, { type Express, type NextFunction, type Request, type Response } from 'express';
+import type { WebSocketServer } from 'ws';
+
+import { createDatabase, type DatabaseHandle } from './db.js';
+import { createRoutes } from './routes.js';
+import { CollabServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: Server;
+  wss: WebSocketServer;
+  db: DatabaseHandle;
+  /** Start listening; resolves with the actual bound port (pass 0 for a random one). */
+  start(port?: number): Promise<number>;
+  /** Close every connection, the HTTP server and the database. */
+  stop(): Promise<void>;
+}
+
+/**
+ * Build a collaboration server: Express REST API and the WebSocket collaboration
+ * hub sharing a single HTTP listener.
+ */
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDatabase(dbPath);
+  const app = express();
+  const server = createServer(app);
+  const collab = new CollabServer(db, server);
+
+  app.use(express.json({ limit: '10mb' }));
+  app.use(createRoutes(db, collab));
+
+  app.use((_req: Request, res: Response) => {
+    res.status(404).json({ error: 'Not found' });
+  });
+  app.use((err: Error, _req: Request, res: Response, next: NextFunction) => {
+    if (res.headersSent) {
+      next(err);
+      return;
+    }
+    res.status(400).json({ error: err.message || 'Bad request' });
+  });
+
+  // Track raw sockets so shutdown cannot hang on keep-alive connections.
+  const sockets = new Set<Socket>();
+  server.on('connection', (socket: Socket) => {
+    sockets.add(socket);
+    socket.on('close', () => sockets.delete(socket));
+  });
+
+  let listening = false;
+  let closed = false;
+
+  return {
+    app,
+    server,
+    wss: collab.wss,
+    db,
+
+    start(port = 0): Promise<number> {
+      return new Promise((resolve, reject) => {
+        if (closed) {
+          reject(new Error('Server has been stopped and cannot be restarted'));
+          return;
+        }
+        if (listening) {
+          resolve((server.address() as AddressInfo).port);
+          return;
+        }
+        // Both listeners are removed on either outcome; `server.listen(port, cb)`
+        // would leak a 'listening' listener on every failed attempt.
+        const onError = (err: Error) => {
+          server.removeListener('listening', onListening);
+          reject(err);
+        };
+        const onListening = () => {
+          server.removeListener('error', onError);
+          listening = true;
+          resolve((server.address() as AddressInfo).port);
+        };
+        server.once('error', onError);
+        server.once('listening', onListening);
+        server.listen(port);
+      });
+    },
+
+    stop(): Promise<void> {
+      return new Promise((resolve) => {
+        if (closed) {
+          resolve();
+          return;
+        }
+        closed = true;
+
+        collab.closeAll();
+        collab.wss.close(() => undefined);
+
+        const finish = () => {
+          for (const socket of sockets) socket.destroy();
+          sockets.clear();
+          if (db.open) db.close();
+          resolve();
+        };
+
+        if (!server.listening) {
+          finish();
+          return;
+        }
+        server.close(() => finish());
+        // Keep-alive sockets would otherwise delay `close`; drop them now.
+        for (const socket of sockets) socket.destroy();
+        sockets.clear();
+      });
+    },
+  };
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..7e13cbc
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,323 @@
+import { randomUUID } from 'node:crypto';
+import type { Server as HttpServer } from 'node:http';
+import { WebSocket, WebSocketServer } from 'ws';
+
+import {
+  commitVersion,
+  getDocument,
+  getLatestVersion,
+  listVersionOperations,
+  registerConnection,
+  unregisterConnection,
+  type DatabaseHandle,
+} from './db.js';
+import type { Operation, RoomSync, ServerMessage } from './models.js';
+import { applyOperation, isNoop, isOperation, transformAgainst, validateOperation } from './ot.js';
+
+/** Refuse frames larger than this; `ws` otherwise allows 100MB per message. */
+const MAX_PAYLOAD_BYTES = 1024 * 1024;
+
+/**
+ * In-memory state for one document's collaboration session.
+ *
+ * `history[v]` is the operation that advanced the document from version `v` to
+ * `v + 1`; a `null` entry marks a change that did not come from an operation
+ * (e.g. a REST content overwrite), which cannot be transformed through.
+ */
+interface Room {
+  documentId: string;
+  content: string;
+  version: number;
+  history: (Operation | null)[];
+  clients: Set<WebSocket>;
+}
+
+function send(ws: WebSocket, message: ServerMessage): void {
+  if (ws.readyState !== WebSocket.OPEN) return;
+  ws.send(JSON.stringify(message));
+}
+
+/** Extract the document id from a WebSocket upgrade URL such as `/abc-123?x=1`. */
+function documentIdFromUrl(url: string | undefined): string {
+  const path = (url ?? '/').split('?')[0];
+  const raw = path.replace(/^\/+/, '').replace(/\/+$/, '');
+  try {
+    return decodeURIComponent(raw);
+  } catch {
+    return raw;
+  }
+}
+
+/**
+ * WebSocket collaboration hub: one room per document, operational transform on
+ * every inbound edit, broadcast to everyone but the author.
+ *
+ * Broadcasts carry the operation in the context of `baseVersion` (the document
+ * version it was applied to). A client with unacknowledged local edits must
+ * rebase the incoming operation onto them before applying it.
+ */
+export class CollabServer implements RoomSync {
+  readonly wss: WebSocketServer;
+
+  private readonly db: DatabaseHandle;
+  private readonly rooms = new Map<string, Room>();
+  private closing = false;
+
+  constructor(db: DatabaseHandle, server: HttpServer) {
+    this.db = db;
+    this.wss = new WebSocketServer({ server, maxPayload: MAX_PAYLOAD_BYTES });
+    this.wss.on('connection', (ws, req) => {
+      try {
+        this.handleConnection(ws, documentIdFromUrl(req.url));
+      } catch {
+        send(ws, { type: 'error', message: 'Internal error establishing session' });
+        ws.close();
+      }
+    });
+    // A failing server socket must never take the process down.
+    this.wss.on('error', () => undefined);
+  }
+
+  // ----------------------------------------------------------------
+  // Connection lifecycle
+  // ----------------------------------------------------------------
+
+  private handleConnection(ws: WebSocket, documentId: string): void {
+    ws.on('error', () => undefined);
+
+    const room = this.loadRoom(documentId);
+    if (!room) {
+      send(ws, { type: 'error', message: `Document not found: ${documentId}` });
+      ws.close();
+      return;
+    }
+
+    const connectionId = randomUUID();
+    room.clients.add(ws);
+    registerConnection(this.db, connectionId, documentId);
+
+    ws.on('message', (data) => {
+      try {
+        this.handleMessage(ws, room, data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Internal error processing message' });
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      // Drop idle rooms so history does not accumulate for every document ever
+      // opened; the next join rehydrates from the database.
+      if (room.clients.size === 0 && this.rooms.get(documentId) === room) {
+        this.rooms.delete(documentId);
+      }
+      // During shutdown the database is already closed; skip the bookkeeping
+      // rather than throwing from an event handler.
+      if (this.closing) return;
+      try {
+        unregisterConnection(this.db, connectionId);
+      } catch {
+        /* the document (and its connections) may already be gone */
+      }
+    });
+
+    send(ws, { type: 'sync', documentId, content: room.content, version: room.version });
+  }
+
+  /** Fetch a room, hydrating it from the database on first use. */
+  private loadRoom(documentId: string): Room | undefined {
+    const existing = this.rooms.get(documentId);
+    if (existing) return existing;
+
+    const doc = getDocument(this.db, documentId);
+    if (!doc) return undefined;
+
+    const history: (Operation | null)[] = [];
+    let version = 0;
+    for (const row of listVersionOperations(this.db, documentId)) {
+      version = Math.max(version, row.version);
+      if (row.version === 0) continue;
+      history[row.version - 1] = parseOperation(row.operation);
+    }
+
+    const room: Room = { documentId, content: doc.content, version, history, clients: new Set() };
+    this.rooms.set(documentId, room);
+    return room;
+  }
+
+  // ----------------------------------------------------------------
+  // Message handling
+  // ----------------------------------------------------------------
+
+  private handleMessage(ws: WebSocket, room: Room, raw: string): void {
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      send(ws, { type: 'error', message: 'Invalid JSON message' });
+      return;
+    }
+
+    if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) {
+      send(ws, { type: 'error', message: 'Message must be a JSON object' });
+      return;
+    }
+
+    // The room was captured when this socket connected; it goes stale if the
+    // document was deleted underneath us.
+    if (this.rooms.get(room.documentId) !== room || !this.db.open) {
+      send(ws, { type: 'error', message: 'Document is no longer available' });
+      return;
+    }
+
+    const message = parsed as Record<string, unknown>;
+    if (message.type === 'sync') {
+      this.sendSync(ws, room);
+      return;
+    }
+    if (message.type !== 'operation') {
+      send(ws, { type: 'error', message: `Unsupported message type: ${String(message.type)}` });
+      return;
+    }
+
+    if (!isOperation(message.operation)) {
+      send(ws, { type: 'error', message: 'Invalid operation: expected insert or delete with a position' });
+      return;
+    }
+
+    const baseVersion = message.version;
+    if (baseVersion !== undefined && baseVersion !== null) {
+      if (typeof baseVersion !== 'number' || !Number.isSafeInteger(baseVersion) || baseVersion < 0) {
+        send(ws, { type: 'error', message: `Invalid version: ${String(baseVersion)}` });
+        return;
+      }
+      if (baseVersion > room.version) {
+        // The client claims a version the server has never produced; applying
+        // its operation untransformed would corrupt the document.
+        send(ws, { type: 'error', message: `Unknown version ${baseVersion} (server is at ${room.version})` });
+        return;
+      }
+    }
+    const from = typeof baseVersion === 'number' ? baseVersion : room.version;
+
+    // Rebase the client's operation onto everything committed since its base
+    // version. A null entry marks a change (a REST content overwrite) that
+    // cannot be transformed through, so the client must resynchronise instead.
+    const concurrent = room.history.slice(from, room.version);
+    if (concurrent.some((op) => op === null)) {
+      this.sendSync(ws, room);
+      return;
+    }
+    const transformed = transformAgainst(message.operation, concurrent as Operation[]);
+
+    if (!validateOperation(transformed, room.content)) {
+      send(ws, {
+        type: 'error',
+        message: `Operation out of bounds for document of length ${room.content.length}`,
+      });
+      return;
+    }
+
+    // An operation that transformed away to nothing still gets an ack so the
+    // client can retire it, but it earns no version and no broadcast.
+    if (!isNoop(transformed)) {
+      this.commit(room, transformed);
+      this.broadcast(room, transformed, ws);
+    }
+    send(ws, { type: 'ack', documentId: room.documentId, version: room.version, operation: transformed });
+  }
+
+  private sendSync(ws: WebSocket, room: Room): void {
+    send(ws, { type: 'sync', documentId: room.documentId, content: room.content, version: room.version });
+  }
+
+  private commit(room: Room, op: Operation): void {
+    const content = applyOperation(room.content, op);
+    // Persist first: if the write fails, in-memory state must not drift ahead
+    // of the database.
+    commitVersion(this.db, room.documentId, room.version + 1, content, op);
+    room.history[room.version] = op;
+    room.content = content;
+    room.version += 1;
+  }
+
+  private broadcast(room: Room, operation: Operation, exclude: WebSocket): void {
+    for (const client of room.clients) {
+      if (client === exclude) continue;
+      send(client, {
+        type: 'operation',
+        documentId: room.documentId,
+        version: room.version,
+        baseVersion: room.version - 1,
+        operation,
+      });
+    }
+  }
+
+  // ----------------------------------------------------------------
+  // RoomSync — keeps live rooms in step with REST mutations
+  // ----------------------------------------------------------------
+
+  refresh(documentId: string): void {
+    const room = this.rooms.get(documentId);
+    if (!room) return;
+
+    const doc = getDocument(this.db, documentId);
+    if (!doc) {
+      this.closeRoom(documentId, 'Document was deleted');
+      return;
+    }
+
+    const version = Math.max(room.version, getLatestVersion(this.db, documentId));
+    if (doc.content === room.content && version === room.version) return;
+
+    // Content changed out of band: pad history with an untransformable gap and
+    // push the authoritative state to every connected client.
+    for (let v = room.version; v < version; v += 1) {
+      room.history[v] = null;
+    }
+    room.content = doc.content;
+    room.version = version;
+    for (const client of room.clients) this.sendSync(client, room);
+  }
+
+  closeRoom(documentId: string, reason: string): void {
+    const room = this.rooms.get(documentId);
+    this.rooms.delete(documentId);
+    if (!room) return;
+    for (const client of room.clients) {
+      send(client, { type: 'error', message: reason });
+      client.close();
+    }
+    room.clients.clear();
+  }
+
+  /**
+   * Force every socket closed; used during shutdown. `ws` emits 'close'
+   * asynchronously, so the `closing` flag must be set first — otherwise those
+   * handlers would touch the database after it has been closed.
+   */
+  closeAll(): void {
+    this.closing = true;
+    for (const room of this.rooms.values()) {
+      for (const client of room.clients) client.terminate();
+      room.clients.clear();
+    }
+    this.rooms.clear();
+    for (const client of this.wss.clients) client.terminate();
+  }
+}
+
+function parseOperation(serialized: string | null): Operation | null {
+  if (!serialized) return null;
+  try {
+    const parsed: unknown = JSON.parse(serialized);
+    return isOperation(parsed) ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+export function createWsServer(db: DatabaseHandle, server: HttpServer): CollabServer {
+  return new CollabServer(db, server);
+}
