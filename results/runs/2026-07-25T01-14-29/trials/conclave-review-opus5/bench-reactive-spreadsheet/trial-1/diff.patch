index 0000000..2df464e
--- /dev/null
+++ b/src/ast.ts
@@ -0,0 +1,122 @@
+/** Formula syntax tree and dependency extraction. */
+
+import type { CellRef, Rect } from './reference.js';
+
+export type BinaryOperator =
+  | '+'
+  | '-'
+  | '*'
+  | '/'
+  | '^'
+  | '&'
+  | '='
+  | '<>'
+  | '<'
+  | '<='
+  | '>'
+  | '>=';
+
+export type UnaryOperator = '+' | '-';
+
+export interface NumberNode {
+  readonly type: 'number';
+  readonly value: number;
+}
+export interface StringNode {
+  readonly type: 'string';
+  readonly value: string;
+}
+export interface BooleanNode {
+  readonly type: 'boolean';
+  readonly value: boolean;
+}
+export interface ReferenceNode {
+  readonly type: 'reference';
+  readonly ref: CellRef;
+}
+export interface RangeNode {
+  readonly type: 'range';
+  readonly rect: Rect;
+}
+export interface UnaryNode {
+  readonly type: 'unary';
+  readonly operator: UnaryOperator;
+  readonly operand: Node;
+}
+export interface BinaryNode {
+  readonly type: 'binary';
+  readonly operator: BinaryOperator;
+  readonly left: Node;
+  readonly right: Node;
+}
+export interface CallNode {
+  readonly type: 'call';
+  /** Uppercased function name. */
+  readonly name: string;
+  readonly args: readonly Node[];
+}
+
+export type Node =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | ReferenceNode
+  | RangeNode
+  | UnaryNode
+  | BinaryNode
+  | CallNode;
+
+/** Everything a formula reads from the grid. */
+export interface Dependencies {
+  /** Canonical keys of individually referenced cells. */
+  readonly cells: Set<string>;
+  /** Rectangles referenced as ranges; these also cover cells not yet created. */
+  readonly rects: Rect[];
+}
+
+/** The sub-expressions of a node, if any. */
+export function childrenOf(node: Node): readonly Node[] {
+  switch (node.type) {
+    case 'unary':
+      return [node.operand];
+    case 'binary':
+      return [node.left, node.right];
+    case 'call':
+      return node.args;
+    default:
+      return [];
+  }
+}
+
+/**
+ * Collects the cell and range dependencies of a parsed formula.
+ * Iterative, so that a deep tree cannot overflow the stack.
+ */
+export function collectDependencies(node: Node): Dependencies {
+  const cells = new Set<string>();
+  const rects: Rect[] = [];
+  const stack: Node[] = [node];
+
+  while (stack.length > 0) {
+    const current = stack.pop() as Node;
+    if (current.type === 'reference') cells.add(current.ref.key);
+    else if (current.type === 'range') rects.push(current.rect);
+    else for (const child of childrenOf(current)) stack.push(child);
+  }
+
+  return { cells, rects };
+}
+
+/** Height of the tree; a leaf has depth 1. Iterative for the same reason. */
+export function measureDepth(node: Node): number {
+  let deepest = 0;
+  const stack: Array<{ node: Node; depth: number }> = [{ node, depth: 1 }];
+
+  while (stack.length > 0) {
+    const { node: current, depth } = stack.pop() as { node: Node; depth: number };
+    if (depth > deepest) deepest = depth;
+    for (const child of childrenOf(current)) stack.push({ node: child, depth: depth + 1 });
+  }
+
+  return deepest;
+}
