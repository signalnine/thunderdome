+import { beforeEach, describe, expect, it } from 'vitest';
+
+import {
+  CircularReferenceError,
+  FormulaSyntaxError,
+  InvalidReferenceError,
+  SpreadsheetError,
+} from './errors.js';
+import { Spreadsheet } from './index.js';
+
+let sheet: Spreadsheet;
+
+beforeEach(() => {
+  sheet = new Spreadsheet();
+});
+
+describe('literal values', () => {
+  it('stores numbers, strings and booleans', () => {
+    sheet.set('A1', 42);
+    sheet.set('A2', 3.14);
+    sheet.set('A3', 'hello');
+    sheet.set('A4', true);
+    sheet.set('A5', false);
+
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.get('A2')).toBe(3.14);
+    expect(sheet.get('A3')).toBe('hello');
+    expect(sheet.get('A4')).toBe(true);
+    expect(sheet.get('A5')).toBe(false);
+  });
+
+  it('returns null for empty cells', () => {
+    expect(sheet.get('A1')).toBeNull();
+    expect(sheet.get('ZZ999')).toBeNull();
+    expect(sheet.has('A1')).toBe(false);
+  });
+
+  it('overwrites previous content', () => {
+    sheet.set('A1', 1);
+    sheet.set('A1', 'text');
+    expect(sheet.get('A1')).toBe('text');
+    expect(sheet.size).toBe(1);
+  });
+
+  it('accepts references in any case and with absolute markers', () => {
+    sheet.set('a1', 5);
+    expect(sheet.get('A1')).toBe(5);
+    expect(sheet.get('$A$1')).toBe(5);
+  });
+
+  it('rejects invalid references', () => {
+    expect(() => sheet.set('A0', 1)).toThrow(InvalidReferenceError);
+    expect(() => sheet.get('nope')).toThrow(InvalidReferenceError);
+  });
+
+  it('rejects unsupported value types', () => {
+    expect(() => sheet.set('A1', {} as never)).toThrow(SpreadsheetError);
+  });
+
+  it('rejects non-finite numbers', () => {
+    for (const value of [NaN, Infinity, -Infinity]) {
+      expect(() => sheet.set('A1', value), String(value)).toThrow(SpreadsheetError);
+    }
+    expect(sheet.has('A1')).toBe(false);
+  });
+
+  it('reports unknown references as absent rather than throwing from has()', () => {
+    expect(sheet.has('not a ref')).toBe(false);
+  });
+
+  it('only coerces decimal numeric text', () => {
+    sheet.set('A1', '12.5e1');
+    expect(sheet.evaluateFormula('=A1+0')).toBe(125);
+
+    for (const text of ['0x10', '0b101', 'Infinity', '1,000']) {
+      sheet.set('A1', text);
+      expect(sheet.evaluateFormula('=A1+0'), text).toBe('#VALUE!');
+    }
+  });
+
+  it('does not coerce numeric strings', () => {
+    sheet.set('A1', '42');
+    expect(sheet.get('A1')).toBe('42');
+  });
+});
+
+describe('display strings', () => {
+  it('renders each value type', () => {
+    sheet.set('A1', 30);
+    sheet.set('A2', 'hi');
+    sheet.set('A3', true);
+    sheet.set('A4', '=1/0');
+
+    expect(sheet.getDisplay('A1')).toBe('30');
+    expect(sheet.getDisplay('A2')).toBe('hi');
+    expect(sheet.getDisplay('A3')).toBe('TRUE');
+    expect(sheet.getDisplay('A4')).toBe('#DIV/0!');
+    expect(sheet.getDisplay('B9')).toBe('');
+  });
+
+  it('hides binary floating point noise', () => {
+    sheet.set('A1', '=0.1+0.2');
+    expect(sheet.get('A1')).toBeCloseTo(0.3);
+    expect(sheet.getDisplay('A1')).toBe('0.3');
+  });
+});
+
+describe('arithmetic formulas', () => {
+  it('evaluates the four operators', () => {
+    sheet.set('A1', 10);
+    sheet.set('A2', 4);
+    sheet.set('B1', '=A1+A2');
+    sheet.set('B2', '=A1-A2');
+    sheet.set('B3', '=A1*A2');
+    sheet.set('B4', '=A1/A2');
+
+    expect(sheet.get('B1')).toBe(14);
+    expect(sheet.get('B2')).toBe(6);
+    expect(sheet.get('B3')).toBe(40);
+    expect(sheet.get('B4')).toBe(2.5);
+  });
+
+  it('respects precedence and parentheses', () => {
+    sheet.set('A1', 2);
+    sheet.set('B1', 3);
+    sheet.set('C1', '=A1+B1*2');
+    sheet.set('C2', '=(A1+B1)*2');
+    expect(sheet.get('C1')).toBe(8);
+    expect(sheet.get('C2')).toBe(10);
+  });
+
+  it('handles unary minus and chained references', () => {
+    sheet.set('A1', 5);
+    sheet.set('B1', '=-A1');
+    sheet.set('C1', '=-B1+1');
+    expect(sheet.get('B1')).toBe(-5);
+    expect(sheet.get('C1')).toBe(6);
+  });
+
+  it('treats empty cells as zero inside arithmetic', () => {
+    sheet.set('A1', 7);
+    sheet.set('B1', '=A1+Z9');
+    expect(sheet.get('B1')).toBe(7);
+  });
+
+  it('coerces booleans to 1 and 0', () => {
+    sheet.set('A1', true);
+    sheet.set('A2', false);
+    sheet.set('B1', '=A1+A2+1');
+    expect(sheet.get('B1')).toBe(2);
+  });
+
+  it('concatenates text with &', () => {
+    sheet.set('A1', 'foo');
+    sheet.set('A2', 2);
+    sheet.set('B1', '=A1&A2');
+    expect(sheet.get('B1')).toBe('foo2');
+  });
+});
+
+describe('comparisons', () => {
+  const cases: Array<[string, boolean]> = [
+    ['=1>2', false],
+    ['=2>1', true],
+    ['=1<2', true],
+    ['=2<=2', true],
+    ['=3>=4', false],
+    ['=2=2', true],
+    ['=2<>2', false],
+    ['="a"="a"', true],
+    ['="a"="b"', false],
+    ['="a"<"b"', true],
+    ['=TRUE=TRUE', true],
+  ];
+
+  it.each(cases)('evaluates %s', (formula, expected) => {
+    sheet.set('A1', formula);
+    expect(sheet.get('A1')).toBe(expected);
+  });
+
+  it('compares cell values', () => {
+    sheet.set('A1', 10);
+    sheet.set('A2', 20);
+    sheet.set('B1', '=A1<A2');
+    expect(sheet.get('B1')).toBe(true);
+    sheet.set('A1', 30);
+    expect(sheet.get('B1')).toBe(false);
+  });
+});
+
+describe('reactive updates', () => {
+  it('updates direct dependents', () => {
+    sheet.set('A1', 5);
+    sheet.set('B1', '=A1+1');
+    expect(sheet.get('B1')).toBe(6);
+
+    sheet.set('A1', 10);
+    expect(sheet.get('B1')).toBe(11);
+  });
+
