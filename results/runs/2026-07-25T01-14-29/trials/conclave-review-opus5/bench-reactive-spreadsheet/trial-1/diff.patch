@@ -0,0 +1,104 @@
+import { describe, expect, it } from 'vitest';
+
+import { FormulaSyntaxError } from './errors.js';
+import { isFormula, parseFormula } from './parser.js';
+import { tokenize } from './tokenizer.js';
+import { collectDependencies } from './ast.js';
+
+describe('isFormula', () => {
+  it('detects formula strings', () => {
+    expect(isFormula('=A1')).toBe(true);
+    expect(isFormula('  =A1')).toBe(true);
+    expect(isFormula('A1')).toBe(false);
+    expect(isFormula(42)).toBe(false);
+    expect(isFormula(true)).toBe(false);
+  });
+});
+
+describe('tokenize', () => {
+  it('separates references, numbers and operators', () => {
+    expect(tokenize('A1+2.5').map((t) => [t.type, t.value])).toEqual([
+      ['ref', 'A1'],
+      ['operator', '+'],
+      ['number', '2.5'],
+      ['eof', ''],
+    ]);
+  });
+
+  it('treats a name followed by "(" as an identifier, not a reference', () => {
+    expect(tokenize('LOG10(2)')[0]).toMatchObject({ type: 'identifier', value: 'LOG10' });
+  });
+
+  it('reads quoted strings with doubled-quote escapes', () => {
+    expect(tokenize('"a""b"')[0]).toMatchObject({ type: 'string', value: 'a"b' });
+    expect(tokenize("'hi'")[0]).toMatchObject({ type: 'string', value: 'hi' });
+  });
+
+  it('rejects unterminated strings and stray characters', () => {
+    expect(() => tokenize('"abc')).toThrow(FormulaSyntaxError);
+    expect(() => tokenize('1 # 2')).toThrow(FormulaSyntaxError);
+  });
+});
+
+describe('parseFormula', () => {
+  it('honours operator precedence', () => {
+    expect(parseFormula('=1+2*3')).toEqual({
+      type: 'binary',
+      operator: '+',
+      left: { type: 'number', value: 1 },
+      right: {
+        type: 'binary',
+        operator: '*',
+        left: { type: 'number', value: 2 },
+        right: { type: 'number', value: 3 },
+      },
+    });
+  });
+
+  it('parses ranges and calls', () => {
+    const node = parseFormula('=SUM(A1:B2, 3)');
+    expect(node).toMatchObject({ type: 'call', name: 'SUM' });
+    expect(collectDependencies(node).rects).toEqual([{ left: 1, top: 1, right: 2, bottom: 2 }]);
+  });
+
+  it('parses booleans case-insensitively', () => {
+    expect(parseFormula('=true')).toEqual({ type: 'boolean', value: true });
+    expect(parseFormula('=FALSE')).toEqual({ type: 'boolean', value: false });
+  });
+
+  it('collects cell and range dependencies', () => {
+    const deps = collectDependencies(parseFormula('=IF(a1>0, SUM(B1:B3), -C7)'));
+    expect([...deps.cells].sort()).toEqual(['A1', 'C7']);
+    expect(deps.rects).toHaveLength(1);
+  });
+
+  it('binds unary minus tighter than exponentiation, as a spreadsheet does', () => {
+    expect(parseFormula('=-2^2')).toMatchObject({
+      type: 'binary',
+      operator: '^',
+      left: { type: 'unary', operator: '-' },
+    });
+  });
+
+  it('rejects formulas nested beyond the parser limit', () => {
+    const deep = `=${'('.repeat(20_000)}1${')'.repeat(20_000)}`;
+    expect(() => parseFormula(deep)).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula(`=${'-'.repeat(500)}1`)).toThrow(FormulaSyntaxError);
+  });
+
+  it('rejects operator chains that would build an unwalkably deep tree', () => {
+    expect(() => parseFormula(`=${Array(6000).fill('1').join('+')}`)).toThrow(FormulaSyntaxError);
+    expect(() => parseFormula(`=${Array(900).fill('1').join('+')}`)).not.toThrow();
+  });
+
+  it('rejects malformed formulas', () => {
+    for (const bad of ['=', '=1+', '=(1', '=1)', '=A1:', '=,', '=1 2', '=SUM(1,)']) {
+      expect(() => parseFormula(bad), bad).toThrow(FormulaSyntaxError);
+    }
+  });
+
+  it('reports the position of the offending token', () => {
+    // Positions are relative to the formula body, i.e. after the leading "=".
+    expect(() => parseFormula('=1+*2')).toThrow(/position 2/);
+  });
+});
