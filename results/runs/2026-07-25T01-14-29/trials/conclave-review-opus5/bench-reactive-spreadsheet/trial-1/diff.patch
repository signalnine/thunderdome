new file mode 100644
index 0000000..382b06e
--- /dev/null
+++ b/src/functions.ts
@@ -0,0 +1,168 @@
+/**
+ * Built-in worksheet functions.
+ *
+ * Every function here receives already-evaluated arguments. `IF` is the one
+ * exception: it needs lazy branches, so the evaluator handles it directly.
+ */
+
+import { CellError, ErrorCode, isCellError } from './errors.js';
+import { isNumericValue, toBoolean, toNumber, type InternalValue } from './values.js';
+import { isRange, type Evaluated } from './range.js';
+
+export interface FunctionDefinition {
+  readonly name: string;
+  readonly minArgs: number;
+  /** `Infinity` for variadic functions. */
+  readonly maxArgs: number;
+  readonly evaluate: (args: readonly Evaluated[]) => InternalValue;
+}
+
+const ARG_ERROR = new CellError(ErrorCode.ARGS, 'wrong number of arguments');
+
+/**
+ * Flattens arguments into the numbers an aggregate should operate on.
+ *
+ * Inside a range, non-numeric cells are ignored (as in Excel). A scalar
+ * argument is coerced, so `SUM(A1, "2", TRUE)` contributes `2` and `1`, while
+ * `SUM("abc")` is an error.
+ */
+function collectNumbers(args: readonly Evaluated[]): number[] | CellError {
+  const numbers: number[] = [];
+
+  for (const arg of args) {
+    if (isRange(arg)) {
+      for (const value of arg.values()) {
+        if (isCellError(value)) return value;
+        if (isNumericValue(value)) numbers.push(value);
+      }
+      continue;
+    }
+    if (isCellError(arg)) return arg;
+    if (arg === null) continue;
+    const asNumber = toNumber(arg);
+    if (isCellError(asNumber)) return asNumber;
+    numbers.push(asNumber);
+  }
+
+  return numbers;
+}
+
+/**
+ * Flattens arguments into scalar values, expanding ranges in place.
+ * Values are appended one at a time: spreading a large range would exceed the
+ * engine's argument-count limit.
+ */
+function collectValues(args: readonly Evaluated[]): InternalValue[] {
+  const values: InternalValue[] = [];
+  for (const arg of args) {
+    if (!isRange(arg)) {
+      values.push(arg);
+      continue;
+    }
+    for (const value of arg.values()) values.push(value);
+  }
+  return values;
+}
+
+/** `Math.min`/`Math.max` cannot be spread over a large range, so reduce. */
+function extreme(numbers: number[], keepLeft: (a: number, b: number) => boolean): number {
+  let best = numbers[0];
+  for (let i = 1; i < numbers.length; i++) {
+    if (!keepLeft(best, numbers[i])) best = numbers[i];
+  }
+  return best;
+}
+
+function aggregate(
+  name: string,
+  reduce: (numbers: number[]) => InternalValue,
+): FunctionDefinition {
+  return {
+    name,
+    minArgs: 1,
+    maxArgs: Infinity,
+    evaluate: (args) => {
+      const numbers = collectNumbers(args);
+      return isCellError(numbers) ? numbers : reduce(numbers);
+    },
+  };
+}
+
+function logical(
+  name: string,
+  reduce: (flags: boolean[]) => boolean,
+): FunctionDefinition {
+  return {
+    name,
+    minArgs: 1,
+    maxArgs: Infinity,
+    evaluate: (args) => {
+      const flags: boolean[] = [];
+      for (const value of collectValues(args)) {
+        // Empty cells inside a range are ignored rather than treated as FALSE.
+        if (value === null) continue;
+        const flag = toBoolean(value);
+        if (isCellError(flag)) return flag;
+        flags.push(flag);
+      }
+      return reduce(flags);
+    },
+  };
+}
+
+const DEFINITIONS: FunctionDefinition[] = [
+  aggregate('SUM', (numbers) => numbers.reduce((total, n) => total + n, 0)),
+  aggregate('AVERAGE', (numbers) =>
+    numbers.length === 0
+      ? new CellError(ErrorCode.DIV0, 'AVERAGE of no numeric values')
+      : numbers.reduce((total, n) => total + n, 0) / numbers.length,
+  ),
+  aggregate('MIN', (numbers) =>
+    numbers.length === 0 ? 0 : extreme(numbers, (a, b) => a <= b),
+  ),
+  aggregate('MAX', (numbers) =>
+    numbers.length === 0 ? 0 : extreme(numbers, (a, b) => a >= b),
+  ),
+  {
+    name: 'COUNT',
+    minArgs: 1,
+    maxArgs: Infinity,
+    evaluate: (args) => {
+      const numbers = collectNumbers(args);
+      return isCellError(numbers) ? numbers : numbers.length;
+    },
+  },
+  logical('AND', (flags) => flags.length > 0 && flags.every(Boolean)),
+  logical('OR', (flags) => flags.some(Boolean)),
+  {
+    name: 'NOT',
+    minArgs: 1,
+    maxArgs: 1,
+    evaluate: (args) => {
+      const flag = toBoolean(isRange(args[0]) ? args[0].single() : args[0]);
+      return isCellError(flag) ? flag : !flag;
+    },
+  },
+];
+
+const REGISTRY = new Map<string, FunctionDefinition>(
+  DEFINITIONS.map((definition) => [definition.name, definition]),
+);
+
+/** Names of every built-in function, including the lazily evaluated `IF`. */
+export const FUNCTION_NAMES: readonly string[] = [...REGISTRY.keys(), 'IF'].sort();
+
+export function lookupFunction(name: string): FunctionDefinition | undefined {
+  return REGISTRY.get(name);
+}
+
+/** Applies a function, validating arity first. */
+export function callFunction(
+  definition: FunctionDefinition,
+  args: readonly Evaluated[],
+): InternalValue {
+  if (args.length < definition.minArgs || args.length > definition.maxArgs) {
+    return ARG_ERROR;
+  }
+  return definition.evaluate(args);
+}
