@@ -0,0 +1,42 @@
+/** The intermediate value produced by a range expression such as `A1:B3`. */
+
+import { RANGE_IN_SCALAR_CONTEXT } from './errors.js';
+import { rectArea, type Rect } from './reference.js';
+import type { InternalValue } from './values.js';
+
+/**
+ * A range is only meaningful as a function argument, so it is kept distinct
+ * from ordinary cell values. Values are read lazily: `MIN(A1:A5)` needs them,
+ * `IF(TRUE, 1, SUM(A1:A5))` never does.
+ */
+export class RangeValue {
+  constructor(
+    readonly rect: Rect,
+    private readonly read: (rect: Rect) => InternalValue[],
+  ) {}
+
+  /**
+   * The populated values in the rectangle, in row-major order. Empty cells are
+   * omitted; no built-in distinguishes an empty cell from an absent one.
+   */
+  values(): InternalValue[] {
+    return this.read(this.rect);
+  }
+
+  /**
+   * The value of a single-cell range, or `#VALUE!` when the range covers more
+   * than one cell and therefore cannot stand in for one value.
+   */
+  single(): InternalValue {
+    if (rectArea(this.rect) !== 1) return RANGE_IN_SCALAR_CONTEXT;
+    const values = this.values();
+    return values.length === 1 ? values[0] : null;
+  }
+}
+
+/** A value flowing through the evaluator: a cell value or a range. */
+export type Evaluated = InternalValue | RangeValue;
+
+export function isRange(value: Evaluated): value is RangeValue {
+  return value instanceof RangeValue;
+}
