--- /dev/null
+++ b/src/values.ts
@@ -0,0 +1,115 @@
+/** Cell value types plus the coercion, comparison and formatting rules. */
+
+import { CellError, ErrorCode, isCellError, NUM, VALUE } from './errors.js';
+
+/** A value observable through the public API. `null` means "empty cell". */
+export type CellValue = number | string | boolean | null;
+
+/** A value as stored internally; adds error values to {@link CellValue}. */
+export type InternalValue = CellValue | CellError;
+
+/** Raw input accepted by `Spreadsheet.set`. */
+export type CellInput = string | number | boolean;
+
+/**
+ * Number of significant digits kept when rendering a number. Trimming the last
+ * couple of digits hides binary floating point noise, so `=0.1+0.2` displays as
+ * `0.3` rather than `0.30000000000000004`.
+ */
+const DISPLAY_PRECISION = 15;
+
+/**
+ * Decimal literals only. `Number()` alone would also accept `0x10`, `0b1`,
+ * `Infinity` and the empty string, none of which are numbers to a spreadsheet.
+ */
+const NUMERIC_TEXT = /^[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?$/;
+
+/** Coerces a value to a number, or returns an error value. */
+export function toNumber(value: InternalValue): number | CellError {
+  if (isCellError(value)) return value;
+  if (value === null) return 0;
+  if (typeof value === 'number') return Number.isNaN(value) ? NUM : value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+
+  const trimmed = value.trim();
+  if (!NUMERIC_TEXT.test(trimmed)) return VALUE;
+  const parsed = Number(trimmed);
+  return Number.isFinite(parsed) ? parsed : NUM;
+}
+
+/** Coerces a value to a boolean condition, or returns an error value. */
+export function toBoolean(value: InternalValue): boolean | CellError {
+  if (isCellError(value)) return value;
+  if (value === null) return false;
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+
+  const upper = value.trim().toUpperCase();
+  if (upper === 'TRUE') return true;
+  if (upper === 'FALSE') return false;
+  return VALUE;
+}
+
+/** Renders a value as text, following spreadsheet display conventions. */
+export function toText(value: InternalValue): string {
+  if (isCellError(value)) return value.code;
+  if (value === null) return '';
+  if (typeof value === 'string') return value;
+  if (typeof value === 'boolean') return value ? 'TRUE' : 'FALSE';
+  return formatNumber(value);
+}
+
+/** Formats a number for display, trimming floating point representation noise. */
+export function formatNumber(value: number): string {
+  // `Spreadsheet.set` rejects non-finite literals and arithmetic folds them
+  // into #NUM!, so this is only a safety net.
+  if (!Number.isFinite(value)) return ErrorCode.NUM;
+  if (Number.isInteger(value)) return String(value);
+  return String(Number(value.toPrecision(DISPLAY_PRECISION)));
+}
+
+/** True when the value participates in numeric aggregation over a range. */
+export function isNumericValue(value: InternalValue): value is number {
+  return typeof value === 'number' && !Number.isNaN(value);
+}
+
+/**
+ * Sort rank for cross-type comparison, matching spreadsheet ordering where
+ * numbers sort before text, which sorts before booleans.
+ */
+function typeRank(value: Exclude<CellValue, null>): number {
+  if (typeof value === 'number') return 0;
+  if (typeof value === 'string') return 1;
+  return 2;
+}
+
+/**
+ * Three-way comparison used by `<`, `>`, `=`, ... An empty cell adopts the type
+ * of the other operand (`0` against a number, `""` against text).
+ */
+export function compareValues(a: InternalValue, b: InternalValue): number | CellError {
+  if (isCellError(a)) return a;
+  if (isCellError(b)) return b;
+
+  const left = coalesceEmpty(a, b);
+  const right = coalesceEmpty(b, a);
+
+  const rankDelta = typeRank(left) - typeRank(right);
+  if (rankDelta !== 0) return rankDelta < 0 ? -1 : 1;
+
+  if (typeof left === 'string' && typeof right === 'string') {
+    return left < right ? -1 : left > right ? 1 : 0;
+  }
+
+  const leftNumber = typeof left === 'boolean' ? Number(left) : (left as number);
+  const rightNumber = typeof right === 'boolean' ? Number(right) : (right as number);
+  return leftNumber < rightNumber ? -1 : leftNumber > rightNumber ? 1 : 0;
+}
+
+/** Replaces an empty value with the zero-value of the other operand's type. */
+function coalesceEmpty(value: InternalValue, other: InternalValue): Exclude<CellValue, null> {
+  if (value !== null) return value as Exclude<CellValue, null>;
+  if (typeof other === 'string') return '';
+  if (typeof other === 'boolean') return false;
+  return 0;
+}
