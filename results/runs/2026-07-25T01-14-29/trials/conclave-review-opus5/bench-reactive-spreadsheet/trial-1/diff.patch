+import { describe, expect, it } from 'vitest';
+
+import { InvalidReferenceError } from './errors.js';
+import {
+  columnToIndex,
+  indexToColumn,
+  normalizeRef,
+  parseRef,
+  rectArea,
+  rectContains,
+  rectFrom,
+  tryParseRef,
+} from './reference.js';
+
+describe('column conversion', () => {
+  it('maps single letters', () => {
+    expect(columnToIndex('A')).toBe(1);
+    expect(columnToIndex('B')).toBe(2);
+    expect(columnToIndex('Z')).toBe(26);
+  });
+
+  it('maps multi-letter columns', () => {
+    expect(columnToIndex('AA')).toBe(27);
+    expect(columnToIndex('AZ')).toBe(52);
+    expect(columnToIndex('BA')).toBe(53);
+    expect(columnToIndex('ZZ')).toBe(702);
+    expect(columnToIndex('AAA')).toBe(703);
+  });
+
+  it('round-trips through indexToColumn', () => {
+    for (const index of [1, 26, 27, 52, 53, 702, 703, 16384]) {
+      expect(columnToIndex(indexToColumn(index))).toBe(index);
+    }
+  });
+
+  it('rejects invalid column indices', () => {
+    expect(() => indexToColumn(0)).toThrow(RangeError);
+    expect(() => indexToColumn(-3)).toThrow(RangeError);
+  });
+});
+
+describe('parseRef', () => {
+  it('parses simple references', () => {
+    expect(parseRef('A1')).toMatchObject({ col: 1, row: 1, key: 'A1' });
+    expect(parseRef('B2')).toMatchObject({ col: 2, row: 2, key: 'B2' });
+    expect(parseRef('Z100')).toMatchObject({ col: 26, row: 100, key: 'Z100' });
+    expect(parseRef('AA1')).toMatchObject({ col: 27, row: 1, key: 'AA1' });
+  });
+
+  it('normalizes case, whitespace and absolute markers', () => {
+    expect(normalizeRef('a1')).toBe('A1');
+    expect(normalizeRef(' aa12 ')).toBe('AA12');
+    expect(normalizeRef('$B$7')).toBe('B7');
+  });
+
+  it('rejects malformed references', () => {
+    for (const bad of ['', 'A', '1', 'A0', '1A', 'A1B', 'hello', 'A-1', 'A1.5']) {
+      expect(tryParseRef(bad), bad).toBeNull();
+      expect(() => parseRef(bad), bad).toThrow(InvalidReferenceError);
+    }
+  });
+
+  it('rejects references beyond the grid bounds', () => {
+    expect(tryParseRef('XFD1048576')).not.toBeNull();
+    expect(tryParseRef('XFE1')).toBeNull();
+    expect(tryParseRef('A1048577')).toBeNull();
+  });
+});
+
+describe('rectangles', () => {
+  it('normalizes corner order', () => {
+    const forwards = rectFrom(parseRef('A1'), parseRef('C3'));
+    const backwards = rectFrom(parseRef('C3'), parseRef('A1'));
+    expect(forwards).toEqual(backwards);
+    expect(forwards).toEqual({ left: 1, top: 1, right: 3, bottom: 3 });
+  });
+
+  it('computes area and containment', () => {
+    const rect = rectFrom(parseRef('B2'), parseRef('D4'));
+    expect(rectArea(rect)).toBe(9);
+    expect(rectContains(rect, 3, 3)).toBe(true);
+    expect(rectContains(rect, 1, 3)).toBe(false);
+    expect(rectContains(rect, 3, 5)).toBe(false);
+  });
+});
