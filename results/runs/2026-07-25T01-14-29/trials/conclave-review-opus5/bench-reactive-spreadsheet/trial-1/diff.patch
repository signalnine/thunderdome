index 0000000..60c9a6a
--- /dev/null
+++ b/src/parser.ts
@@ -0,0 +1,271 @@
+/**
+ * Recursive-descent parser for formulas.
+ *
+ * Precedence, loosest to tightest:
+ *   comparison (`=` `<>` `<` `<=` `>` `>=`)
+ *   concatenation (`&`)
+ *   additive (`+` `-`)
+ *   multiplicative (`*` `/`)
+ *   exponentiation (`^`, right associative)
+ *   unary (`-` `+`)
+ *   primary (literals, references, ranges, function calls, parentheses)
+ *
+ * Unary minus binds tighter than `^`, as in a spreadsheet: `=-2^2` is `4`.
+ */
+
+import { measureDepth, type BinaryOperator, type Node, type UnaryOperator } from './ast.js';
+import { FormulaSyntaxError } from './errors.js';
+import { rectFrom, tryParseRef, type CellRef } from './reference.js';
+import { tokenize, type Token } from './tokenizer.js';
+
+const COMPARISON_OPERATORS = new Set<string>(['=', '<>', '<', '<=', '>', '>=']);
+const ADDITIVE_OPERATORS = new Set<string>(['+', '-']);
+const MULTIPLICATIVE_OPERATORS = new Set<string>(['*', '/']);
+
+/**
+ * Nesting allowed inside a formula (parentheses, arguments, unary chains).
+ * Bounded so that a hostile formula cannot overflow the parser's own stack.
+ */
+const MAX_NESTING = 200;
+
+/**
+ * Maximum depth of the resulting tree. Operator chains such as `=1+1+1+...`
+ * nest to the left without recursing in the parser, so they are checked
+ * separately; the evaluator walks the tree recursively and must not overflow.
+ */
+const MAX_TREE_DEPTH = 1000;
+
+/** Returns true when a raw cell input should be treated as a formula. */
+export function isFormula(value: unknown): value is string {
+  return typeof value === 'string' && value.trimStart().startsWith('=');
+}
+
+/** Strips the leading `=` (and surrounding whitespace) from a formula string. */
+export function formulaBody(formula: string): string {
+  const trimmed = formula.trim();
+  return trimmed.startsWith('=') ? trimmed.slice(1) : trimmed;
+}
+
+/**
+ * Parses a formula. `source` may include the leading `=`.
+ * @throws {FormulaSyntaxError} when the formula is malformed.
+ */
+export function parseFormula(source: string): Node {
+  const body = formulaBody(source);
+  return new Parser(body).parse();
+}
+
+class Parser {
+  private readonly tokens: Token[];
+  private index = 0;
+  private nesting = 0;
+
+  constructor(private readonly source: string) {
+    this.tokens = tokenize(source);
+  }
+
+  parse(): Node {
+    if (this.peek().type === 'eof') {
+      throw this.error('Formula is empty', this.peek());
+    }
+    const node = this.parseExpression();
+    const token = this.peek();
+    if (token.type !== 'eof') {
+      throw this.error(`Unexpected token ${JSON.stringify(token.value)}`, token);
+    }
+    if (measureDepth(node) > MAX_TREE_DEPTH) {
+      throw this.error(`Formula is too deeply nested (limit ${MAX_TREE_DEPTH})`, this.peek());
+    }
+    return node;
+  }
+
+  private parseExpression(): Node {
+    if (++this.nesting > MAX_NESTING) {
+      throw this.error(`Formula is nested more than ${MAX_NESTING} levels deep`, this.peek());
+    }
+    const node = this.parseComparison();
+    this.nesting--;
+    return node;
+  }
+
+  private parseComparison(): Node {
+    let left = this.parseConcatenation();
+    while (this.matchOperator(COMPARISON_OPERATORS)) {
+      const operator = this.next().value as BinaryOperator;
+      const right = this.parseConcatenation();
+      left = { type: 'binary', operator, left, right };
+    }
+    return left;
+  }
+
+  private parseConcatenation(): Node {
+    let left = this.parseAdditive();
+    while (this.peekIsOperator('&')) {
+      this.next();
+      const right = this.parseAdditive();
+      left = { type: 'binary', operator: '&', left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): Node {
+    let left = this.parseMultiplicative();
+    while (this.matchOperator(ADDITIVE_OPERATORS)) {
+      const operator = this.next().value as BinaryOperator;
+      const right = this.parseMultiplicative();
+      left = { type: 'binary', operator, left, right };
+    }
+    return left;
+  }
+
+  private parseMultiplicative(): Node {
+    let left = this.parsePower();
+    while (this.matchOperator(MULTIPLICATIVE_OPERATORS)) {
+      const operator = this.next().value as BinaryOperator;
+      const right = this.parsePower();
+      left = { type: 'binary', operator, left, right };
+    }
+    return left;
+  }
+
+  private parsePower(): Node {
+    const base = this.parseUnary();
+    if (this.peekIsOperator('^')) {
+      this.next();
+      // Right associative: `2^3^2` is `2^(3^2)`.
+      const exponent = this.parsePower();
+      return { type: 'binary', operator: '^', left: base, right: exponent };
+    }
+    return base;
+  }
+
+  private parseUnary(): Node {
+    if (this.matchOperator(ADDITIVE_OPERATORS)) {
+      if (++this.nesting > MAX_NESTING) {
+        throw this.error(`Formula is nested more than ${MAX_NESTING} levels deep`, this.peek());
+      }
+      const operator = this.next().value as UnaryOperator;
+      const operand = this.parseUnary();
+      this.nesting--;
+      return { type: 'unary', operator, operand };
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): Node {
+    const token = this.next();
+
+    switch (token.type) {
+      case 'number': {
+        const value = Number(token.value);
+        if (!Number.isFinite(value)) {
+          throw this.error(`Invalid number ${JSON.stringify(token.value)}`, token);
+        }
+        return { type: 'number', value };
+      }
+
+      case 'string':
+        return { type: 'string', value: token.value };
+
+      case 'ref':
+        return this.parseReferenceOrRange(token);
+
+      case 'identifier': {
+        const upper = token.value.toUpperCase();
+        if (upper === 'TRUE') return { type: 'boolean', value: true };
+        if (upper === 'FALSE') return { type: 'boolean', value: false };
+        if (this.peekIsPunct('(')) return this.parseCall(upper);
+        throw this.error(`Unknown identifier ${JSON.stringify(token.value)}`, token);
+      }
+
+      case 'punct':
+        if (token.value === '(') {
+          const inner = this.parseExpression();
+          this.expectPunct(')');
+          return inner;
+        }
+        throw this.error(`Unexpected token ${JSON.stringify(token.value)}`, token);
+
+      default:
+        throw this.error(
+          token.type === 'eof'
+            ? 'Unexpected end of formula'
+            : `Unexpected token ${JSON.stringify(token.value)}`,
+          token,
+        );
+    }
+  }
+
+  private parseReferenceOrRange(token: Token): Node {
+    const start = this.toRef(token);
+    if (!this.peekIsPunct(':')) {
+      return { type: 'reference', ref: start };
+    }
+    this.next(); // ':'
+    const endToken = this.next();
+    if (endToken.type !== 'ref') {
+      throw this.error('Expected a cell reference after ":"', endToken);
+    }
+    const end = this.toRef(endToken);
+    return { type: 'range', rect: rectFrom(start, end) };
+  }
+
+  private parseCall(name: string): Node {
+    this.expectPunct('(');
+    const args: Node[] = [];
+    if (!this.peekIsPunct(')')) {
+      args.push(this.parseExpression());
+      while (this.peekIsPunct(',')) {
+        this.next();
+        args.push(this.parseExpression());
+      }
+    }
+    this.expectPunct(')');
+    return { type: 'call', name, args };
+  }
+
+  private toRef(token: Token): CellRef {
+    const ref = tryParseRef(token.value);
+    if (!ref) {
+      throw this.error(`Cell reference out of range: ${token.value}`, token);
+    }
+    return ref;
+  }
+
+  private peek(): Token {
+    return this.tokens[this.index];
+  }
+
+  private next(): Token {
+    const token = this.tokens[this.index];
+    if (token.type !== 'eof') this.index++;
+    return token;
+  }
+
+  private peekIsOperator(value: string): boolean {
+    const token = this.peek();
+    return token.type === 'operator' && token.value === value;
+  }
+
+  private matchOperator(values: Set<string>): boolean {
+    const token = this.peek();
+    return token.type === 'operator' && values.has(token.value);
+  }
+
+  private peekIsPunct(value: string): boolean {
+    const token = this.peek();
+    return token.type === 'punct' && token.value === value;
+  }
+
+  private expectPunct(value: string): void {
+    const token = this.peek();
+    if (token.type !== 'punct' || token.value !== value) {
+      throw this.error(`Expected ${JSON.stringify(value)}`, token);
+    }
+    this.next();
+  }
+
+  private error(message: string, token: Token): FormulaSyntaxError {
+    return new FormulaSyntaxError(message, this.source, token.start);
+  }
+}
