+/**
+ * A reactive spreadsheet engine.
+ *
+ * ```ts
+ * import { Spreadsheet } from './index.js';
+ *
+ * const sheet = new Spreadsheet();
+ * sheet.set('A1', 10);
+ * sheet.set('A2', 20);
+ * sheet.set('A3', '=A1+A2');
+ * sheet.get('A3');        // 30
+ * sheet.set('A1', 50);
+ * sheet.get('A3');        // 70 — recomputed automatically
+ * ```
+ */
+
+export { Spreadsheet } from './spreadsheet.js';
+export { Spreadsheet as default } from './spreadsheet.js';
+
+export {
+  CellError,
+  CircularReferenceError,
+  ErrorCode,
+  FormulaSyntaxError,
+  InvalidReferenceError,
+  SpreadsheetError,
+  isCellError,
+  type ErrorCodeValue,
+} from './errors.js';
+
+export {
+  columnToIndex,
+  indexToColumn,
+  normalizeRef,
+  tryParseRef,
+  type CellRef,
+  type Rect,
+} from './reference.js';
+
+export { FUNCTION_NAMES } from './functions.js';
+export { isFormula, parseFormula } from './parser.js';
+export type { Node as FormulaNode } from './ast.js';
+export type { CellInput, CellValue } from './values.js';
