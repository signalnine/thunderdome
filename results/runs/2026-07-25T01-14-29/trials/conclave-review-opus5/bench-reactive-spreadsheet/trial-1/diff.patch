+import { describe, expect, it } from 'vitest';
+
+import { RangeIndex } from './range-index.js';
+import { parseRef, rectFrom } from './reference.js';
+
+const rect = (from: string, to: string) => rectFrom(parseRef(from), parseRef(to));
+const watchers = (index: RangeIndex, ref: string) => {
+  const { col, row } = parseRef(ref);
+  return [...index.watchersOf(col, row)].sort();
+};
+
+describe('RangeIndex', () => {
+  it('finds the formulas covering an address', () => {
+    const index = new RangeIndex();
+    index.add('D1', [rect('A1', 'B2')]);
+    index.add('D2', [rect('B2', 'C3')]);
+
+    expect(watchers(index, 'A1')).toEqual(['D1']);
+    expect(watchers(index, 'B2')).toEqual(['D1', 'D2']);
+    expect(watchers(index, 'C3')).toEqual(['D2']);
+    expect(watchers(index, 'Z9')).toEqual([]);
+  });
+
+  it('reports each formula once even with overlapping rectangles', () => {
+    const index = new RangeIndex();
+    index.add('D1', [rect('A1', 'A3'), rect('A2', 'A5')]);
+    expect(watchers(index, 'A2')).toEqual(['D1']);
+  });
+
+  it('handles rectangles spanning many row bands', () => {
+    const index = new RangeIndex();
+    index.add('D1', [rect('A1', 'A900000')]);
+
+    expect(index.size).toBe(1);
+    expect(watchers(index, 'A1')).toEqual(['D1']);
+    expect(watchers(index, 'A500000')).toEqual(['D1']);
+    expect(watchers(index, 'B500000')).toEqual([]);
+  });
+
+  it('mixes tall and short rectangles for the same formula', () => {
+    const index = new RangeIndex();
+    index.add('D1', [rect('A1', 'A900000'), rect('C5', 'C6')]);
+    expect(watchers(index, 'C5')).toEqual(['D1']);
+    expect(watchers(index, 'A7')).toEqual(['D1']);
+  });
+
+  it('forgets removed formulas', () => {
+    const index = new RangeIndex();
+    index.add('D1', [rect('A1', 'B2')]);
+    index.add('D2', [rect('A1', 'A900000')]);
+
+    index.remove('D1');
+    index.remove('D2');
+    index.remove('missing');
+
+    expect(index.size).toBe(0);
+    expect(watchers(index, 'A1')).toEqual([]);
+  });
+
+  it('replaces the rectangles of a re-registered formula', () => {
+    const index = new RangeIndex();
+    index.add('D1', [rect('A1', 'A5')]);
+    index.add('D1', [rect('B1', 'B5')]);
+
+    expect(index.size).toBe(1);
+    expect(watchers(index, 'A1')).toEqual([]);
+    expect(watchers(index, 'B1')).toEqual(['D1']);
+  });
+
+  it('ignores formulas without ranges and clears completely', () => {
+    const index = new RangeIndex();
+    index.add('D1', []);
+    expect(index.size).toBe(0);
+
+    index.add('D2', [rect('A1', 'A2')]);
+    index.clear();
+    expect(index.size).toBe(0);
+    expect(watchers(index, 'A1')).toEqual([]);
+  });
+});
