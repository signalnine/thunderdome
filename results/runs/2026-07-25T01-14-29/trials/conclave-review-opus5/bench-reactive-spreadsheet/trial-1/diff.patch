+  }
+
+  // --- cell construction -------------------------------------------------
+
+  private createCell(ref: CellRef, input: CellInput): Cell {
+    if (!isFormula(input)) {
+      return { ref, input, formula: null, deps: NO_DEPS, rects: NO_RECTS, value: input };
+    }
