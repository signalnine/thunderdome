+++ b/src/functions.test.ts
@@ -0,0 +1,189 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+
+import { Spreadsheet } from './index.js';
+
+let sheet: Spreadsheet;
+
+beforeEach(() => {
+  sheet = new Spreadsheet();
+  // A1:C3 block:
+  //   1  2  3
+  //   4  5  6
+  //   7  8  "x"
+  const values = [
+    [1, 2, 3],
+    [4, 5, 6],
+    [7, 8, 'x'],
+  ];
+  const columns = ['A', 'B', 'C'];
+  values.forEach((row, rowIndex) => {
+    row.forEach((value, columnIndex) => {
+      sheet.set(`${columns[columnIndex]}${rowIndex + 1}`, value);
+    });
+  });
+});
+
+describe('ranges', () => {
+  it('sums a column range', () => {
+    expect(sheet.evaluateFormula('=SUM(A1:A3)')).toBe(12);
+  });
+
+  it('sums a row range', () => {
+    expect(sheet.evaluateFormula('=SUM(A1:C1)')).toBe(6);
+  });
+
+  it('sums a block range and skips non-numeric cells', () => {
+    expect(sheet.evaluateFormula('=SUM(A1:C3)')).toBe(36);
+  });
+
+  it('accepts ranges written in either corner order', () => {
+    expect(sheet.evaluateFormula('=SUM(C3:A1)')).toBe(36);
+  });
+
+  it('includes cells that are still empty as nothing', () => {
+    expect(sheet.evaluateFormula('=SUM(A1:A100)')).toBe(12);
+  });
+
+  it('rejects a range used as a single value', () => {
+    expect(sheet.evaluateFormula('=A1:A3+1')).toBe('#VALUE!');
+    expect(sheet.evaluateFormula('=IF(A1:A3, 1, 2)')).toBe('#VALUE!');
+    expect(sheet.evaluateFormula('=NOT(A1:A3)')).toBe('#VALUE!');
+  });
+
+  it('accepts a single-cell range where one value is expected', () => {
+    sheet.set('E1', true);
+    expect(sheet.evaluateFormula('=NOT(E1:E1)')).toBe(false);
+  });
+});
+
+describe('aggregate functions', () => {
+  it('computes AVERAGE over numeric cells only', () => {
+    expect(sheet.evaluateFormula('=AVERAGE(A1:A3)')).toBe(4);
+    expect(sheet.evaluateFormula('=AVERAGE(A1:C3)')).toBe(4.5);
+  });
+
+  it('returns #DIV/0! for AVERAGE with no numbers', () => {
+    expect(sheet.evaluateFormula('=AVERAGE(E1:E5)')).toBe('#DIV/0!');
+  });
+
+  it('computes MIN and MAX', () => {
+    expect(sheet.evaluateFormula('=MIN(A1:C3)')).toBe(1);
+    expect(sheet.evaluateFormula('=MAX(A1:C3)')).toBe(8);
+    expect(sheet.evaluateFormula('=MIN(E1:E5)')).toBe(0);
+    expect(sheet.evaluateFormula('=MAX(E1:E5)')).toBe(0);
+  });
+
+  it('counts numeric values only', () => {
+    expect(sheet.evaluateFormula('=COUNT(A1:C3)')).toBe(8);
+    expect(sheet.evaluateFormula('=COUNT(C3:C3)')).toBe(0);
+  });
+
+  it('accepts several arguments, mixing ranges and scalars', () => {
+    expect(sheet.evaluateFormula('=SUM(A1:A3, B1, 100)')).toBe(114);
+    expect(sheet.evaluateFormula('=MAX(A1:A3, 99)')).toBe(99);
+  });
+
+  it('propagates errors found inside a range', () => {
+    sheet.set('A4', '=1/0');
+    expect(sheet.evaluateFormula('=SUM(A1:A4)')).toBe('#DIV/0!');
+  });
+
+  it('reports wrong argument counts', () => {
+    expect(sheet.evaluateFormula('=SUM()')).toBe('#N/A');
+    expect(sheet.evaluateFormula('=NOT(1, 2)')).toBe('#N/A');
+  });
+
+  it('nests function calls', () => {
+    expect(sheet.evaluateFormula('=SUM(A1:A3) + MAX(B1:B3)')).toBe(20);
+    expect(sheet.evaluateFormula('=MAX(MIN(A1:A3), 3)')).toBe(3);
+  });
+});
+
+describe('IF', () => {
+  it('selects a branch based on a comparison', () => {
+    sheet.set('E1', '=IF(A1>0, "yes", "no")');
+    expect(sheet.get('E1')).toBe('yes');
+
+    sheet.set('A1', -5);
+    expect(sheet.get('E1')).toBe('no');
+  });
+
+  it('works with numeric and formula branches', () => {
+    expect(sheet.evaluateFormula('=IF(A1=1, SUM(A1:A3), 0)')).toBe(12);
+    expect(sheet.evaluateFormula('=IF(A1<>1, 1, 2)')).toBe(2);
+  });
+
+  it('defaults the false branch to FALSE', () => {
+    expect(sheet.evaluateFormula('=IF(A1>100, "big")')).toBe(false);
+  });
+
+  it('does not evaluate the branch it did not take', () => {
+    sheet.set('A1', 0);
+    expect(sheet.evaluateFormula('=IF(A1=0, "safe", 1/A1)')).toBe('safe');
+  });
+
+  it('propagates an error in the condition', () => {
+    expect(sheet.evaluateFormula('=IF(1/0>1, "a", "b")')).toBe('#DIV/0!');
+  });
+
+  it('rejects a non-boolean condition', () => {
+    expect(sheet.evaluateFormula('=IF("abc", 1, 2)')).toBe('#VALUE!');
+  });
+
+  it('nests', () => {
+    sheet.set('E1', '=IF(A1>5, "high", IF(A1>2, "mid", "low"))');
+    expect(sheet.get('E1')).toBe('low');
+    sheet.set('A1', 4);
+    expect(sheet.get('E1')).toBe('mid');
+    sheet.set('A1', 9);
+    expect(sheet.get('E1')).toBe('high');
+  });
+});
+
+describe('logical helpers', () => {
+  it('combines conditions', () => {
+    expect(sheet.evaluateFormula('=AND(A1=1, B1=2)')).toBe(true);
+    expect(sheet.evaluateFormula('=AND(A1=1, B1=9)')).toBe(false);
+    expect(sheet.evaluateFormula('=OR(A1=9, B1=2)')).toBe(true);
+    expect(sheet.evaluateFormula('=NOT(A1=1)')).toBe(false);
+    expect(sheet.evaluateFormula('=IF(AND(A1>0, B1>0), "both", "not")')).toBe('both');
+  });
+});
+
+describe('large ranges', () => {
+  it('aggregates a range with more values than a call can take arguments', () => {
+    // Guards against implementations that spread the values into Math.min/max.
+    const wide = new Spreadsheet();
+    const count = 150_000;
+    for (let row = 1; row <= count; row++) wide.set(`A${row}`, row);
+
+    expect(wide.evaluateFormula(`=MIN(A1:A${count})`)).toBe(1);
+    expect(wide.evaluateFormula(`=MAX(A1:A${count})`)).toBe(count);
+    expect(wide.evaluateFormula(`=COUNT(A1:A${count})`)).toBe(count);
+    expect(wide.evaluateFormula(`=AND(A1:A${count})`)).toBe(true);
+  });
+
+  it('tracks a range that spans a huge number of rows', () => {
+    const tall = new Spreadsheet();
+    tall.set('A1', '=SUM(B1:B900000)');
+    tall.set('B500000', 7);
+    expect(tall.get('A1')).toBe(7);
+
+    tall.set('B2', 3);
+    expect(tall.get('A1')).toBe(10);
+
+    tall.clear('B500000');
+    expect(tall.get('A1')).toBe(3);
+  });
+
+  it('aggregates a sparse range far larger than the populated area', () => {
+    const large = new Spreadsheet();
+    large.set('A1', 1);
+    large.set('A5000', 2);
+    large.set('B1', '=SUM(A1:A100000)');
+    expect(large.get('B1')).toBe(3);
+
+    large.set('A5000', 40);
+    expect(large.get('B1')).toBe(41);
+  });
+});
