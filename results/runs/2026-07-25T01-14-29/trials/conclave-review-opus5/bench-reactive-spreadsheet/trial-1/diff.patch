index 0000000..1848e2f
--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,94 @@
+/**
+ * Error types and in-cell error values used across the engine.
+ *
+ * There are two distinct notions of "error" here:
+ *
+ * 1. Thrown errors (`SpreadsheetError` subclasses) — the caller did something
+ *    invalid: a malformed cell reference, an unparseable formula, or a change
+ *    that would introduce a circular dependency.
+ * 2. Error *values* (`CellError`) — the formula is well formed but cannot
+ *    produce a result, e.g. `=1/0`. These behave like Excel error values: they
+ *    live in the cell and propagate through anything that references it.
+ */
+
+/** Base class for every error thrown by the engine. */
+export class SpreadsheetError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = new.target.name;
+  }
+}
+
+/** Thrown when a cell reference such as `A0` or `hello` cannot be parsed. */
+export class InvalidReferenceError extends SpreadsheetError {
+  constructor(public readonly reference: string) {
+    super(`Invalid cell reference: ${JSON.stringify(reference)}`);
+  }
+}
+
+/** Thrown when a formula cannot be tokenized or parsed. */
+export class FormulaSyntaxError extends SpreadsheetError {
+  constructor(
+    message: string,
+    public readonly formula: string,
+    public readonly position: number,
+  ) {
+    super(`${message} in formula "${formula}" at position ${position}`);
+  }
+}
+
+/** Thrown when a `set()` would create a direct or indirect dependency cycle. */
+export class CircularReferenceError extends SpreadsheetError {
+  constructor(public readonly path: readonly string[]) {
+    super(`Circular reference detected: ${path.join(' -> ')}`);
+  }
+}
+
+/** The set of error codes a cell value can hold. */
+export const ErrorCode = {
+  /** Division by zero. */
+  DIV0: '#DIV/0!',
+  /** A value has the wrong type for the operation. */
+  VALUE: '#VALUE!',
+  /** Unknown function or unresolvable name. */
+  NAME: '#NAME?',
+  /** Reference is not usable in this position. */
+  REF: '#REF!',
+  /** Numeric overflow or an otherwise impossible number. */
+  NUM: '#NUM!',
+  /** Wrong number of arguments passed to a function. */
+  ARGS: '#N/A',
+  /** Evaluation failed unexpectedly, e.g. the engine ran out of stack. */
+  EVAL: '#ERROR!',
+} as const;
+
+export type ErrorCodeValue = (typeof ErrorCode)[keyof typeof ErrorCode];
+
+/**
+ * An error stored as a cell's computed value. Instances are compared by code,
+ * and are surfaced through the public API as their code string (`"#DIV/0!"`).
+ */
+export class CellError {
+  constructor(
+    public readonly code: ErrorCodeValue,
+    public readonly detail?: string,
+  ) {}
+
+  toString(): string {
+    return this.code;
+  }
+}
+
+export function isCellError(value: unknown): value is CellError {
+  return value instanceof CellError;
+}
+
+export const DIV0 = new CellError(ErrorCode.DIV0);
+export const VALUE = new CellError(ErrorCode.VALUE);
+export const NUM = new CellError(ErrorCode.NUM);
+
+/** A range used where exactly one value is required, e.g. `=A1:B2 + 1`. */
+export const RANGE_IN_SCALAR_CONTEXT = new CellError(
+  ErrorCode.VALUE,
+  'a range cannot be used as a single value',
+);
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..8c59446
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,154 @@
+/** Evaluates a parsed formula against a grid snapshot. */
+
+import type { BinaryNode, CallNode, Node, UnaryNode } from './ast.js';
+import {
+  CellError,
+  DIV0,
+  ErrorCode,
+  isCellError,
+  NUM,
+  RANGE_IN_SCALAR_CONTEXT,
+} from './errors.js';
+import { callFunction, lookupFunction } from './functions.js';
+import { isRange, RangeValue, type Evaluated } from './range.js';
+import type { Rect } from './reference.js';
+import { compareValues, toBoolean, toNumber, toText, type InternalValue } from './values.js';
+
+/** How the evaluator reads the grid. */
+export interface EvalContext {
+  /** Current value of a cell; `null` when the cell is empty. */
+  readCell(key: string): InternalValue;
+  /** Values inside a rectangle, row-major, with `null` for empty cells. */
+  readRect(rect: Rect): InternalValue[];
+}
+
+/** Evaluates a formula, returning a cell value (possibly an error value). */
+export function evaluate(node: Node, context: EvalContext): InternalValue {
+  return toScalar(evaluateNode(node, context));
+}
+
+function evaluateNode(node: Node, context: EvalContext): Evaluated {
+  switch (node.type) {
+    case 'number':
+    case 'string':
+    case 'boolean':
+      return node.value;
+    case 'reference':
+      return context.readCell(node.ref.key);
+    case 'range':
+      return new RangeValue(node.rect, (rect) => context.readRect(rect));
+    case 'unary':
+      return evaluateUnary(node, context);
+    case 'binary':
+      return evaluateBinary(node, context);
+    case 'call':
+      return evaluateCall(node, context);
+  }
+}
+
+/** Collapses a range to an error, since ranges are not scalar values. */
+function toScalar(value: Evaluated): InternalValue {
+  return isRange(value) ? RANGE_IN_SCALAR_CONTEXT : value;
+}
+
+function evaluateUnary(node: UnaryNode, context: EvalContext): InternalValue {
+  const operand = toNumber(toScalar(evaluateNode(node.operand, context)));
+  if (isCellError(operand)) return operand;
+  return node.operator === '-' ? -operand : operand;
+}
+
+function evaluateBinary(node: BinaryNode, context: EvalContext): InternalValue {
+  const left = toScalar(evaluateNode(node.left, context));
+  const right = toScalar(evaluateNode(node.right, context));
+
+  switch (node.operator) {
+    case '+':
+    case '-':
+    case '*':
+    case '/':
+    case '^':
+      return arithmetic(node.operator, left, right);
+
+    case '&': {
+      if (isCellError(left)) return left;
+      if (isCellError(right)) return right;
+      return toText(left) + toText(right);
+    }
+
+    default: {
+      const order = compareValues(left, right);
+      if (isCellError(order)) return order;
+      switch (node.operator) {
+        case '=':
+          return order === 0;
+        case '<>':
+          return order !== 0;
+        case '<':
+          return order < 0;
+        case '<=':
+          return order <= 0;
+        case '>':
+          return order > 0;
+        case '>=':
+          return order >= 0;
+      }
+    }
+  }
+}
+
+function arithmetic(
+  operator: '+' | '-' | '*' | '/' | '^',
+  leftValue: InternalValue,
+  rightValue: InternalValue,
+): InternalValue {
+  const left = toNumber(leftValue);
+  if (isCellError(left)) return left;
+  const right = toNumber(rightValue);
+  if (isCellError(right)) return right;
+
+  switch (operator) {
+    case '+':
+      return finite(left + right);
+    case '-':
+      return finite(left - right);
+    case '*':
+      return finite(left * right);
+    case '/':
+      return right === 0 ? DIV0 : finite(left / right);
+    case '^':
+      return finite(Math.pow(left, right));
+  }
+}
+
+/** Guards against overflow (`1e308*10`) and undefined results (`(-8)^0.5`). */
+function finite(value: number): number | CellError {
+  return Number.isFinite(value) ? value : NUM;
+}
+
+function evaluateCall(node: CallNode, context: EvalContext): Evaluated {
+  // IF is lazy: only the selected branch is evaluated, so
+  // `=IF(A1=0, 0, 1/A1)` never divides by zero.
+  if (node.name === 'IF') return evaluateIf(node, context);
+
+  const definition = lookupFunction(node.name);
+  if (!definition) {
+    return new CellError(ErrorCode.NAME, `unknown function ${node.name}`);
+  }
+
+  const args = node.args.map((arg) => evaluateNode(arg, context));
+  return callFunction(definition, args);
+}
+
+function evaluateIf(node: CallNode, context: EvalContext): Evaluated {
+  if (node.args.length < 2 || node.args.length > 3) {
+    return new CellError(ErrorCode.ARGS, 'IF expects 2 or 3 arguments');
+  }
+
+  const conditionValue = toScalar(evaluateNode(node.args[0], context));
+  const condition = toBoolean(conditionValue);
+  if (isCellError(condition)) return condition;
+
+  if (condition) return evaluateNode(node.args[1], context);
+  if (node.args.length === 3) return evaluateNode(node.args[2], context);
+  return false;
+}
