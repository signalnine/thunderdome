new file mode 100644
index 0000000..d2b59fd
--- /dev/null
+++ b/src/range-index.ts
@@ -0,0 +1,104 @@
+/**
+ * Index from a cell address to the formulas whose range references cover it.
+ *
+ * A formula such as `=SUM(A1:A5)` depends on cells that may not exist yet, so
+ * range dependencies cannot be expanded into the ordinary dependency map. The
+ * naive alternative — testing every range formula on every change — makes each
+ * update cost the number of range formulas in the sheet.
+ *
+ * Rectangles are therefore bucketed by bands of rows. A lookup only tests the
+ * rectangles registered in the band containing the row. Rectangles spanning
+ * more bands than {@link MAX_BANDS_PER_RECT} would pollute too many buckets and
+ * are kept in a small always-scanned set instead.
+ */
+
+import { rectContains, type Rect } from './reference.js';
+
+const ROWS_PER_BAND = 256;
+const MAX_BANDS_PER_RECT = 32;
+
+function bandOf(row: number): number {
+  return Math.floor((row - 1) / ROWS_PER_BAND);
+}
+
+export class RangeIndex {
+  private readonly rectsByKey = new Map<string, readonly Rect[]>();
+  private readonly bands = new Map<number, Set<string>>();
+  private readonly tall = new Set<string>();
+
+  /** Number of indexed formulas. */
+  get size(): number {
+    return this.rectsByKey.size;
+  }
+
+  /** Registers the rectangles a formula reads. Replaces any earlier entry. */
+  add(key: string, rects: readonly Rect[]): void {
+    if (rects.length === 0) return;
+    this.remove(key);
+    this.rectsByKey.set(key, rects);
+
+    for (const rect of rects) {
+      const first = bandOf(rect.top);
+      const last = bandOf(rect.bottom);
+      if (last - first + 1 > MAX_BANDS_PER_RECT) {
+        this.tall.add(key);
+        continue;
+      }
+      for (let band = first; band <= last; band++) {
+        let members = this.bands.get(band);
+        if (!members) {
+          members = new Set<string>();
+          this.bands.set(band, members);
+        }
+        members.add(key);
+      }
+    }
+  }
+
+  /** Removes a formula from the index. */
+  remove(key: string): void {
+    const rects = this.rectsByKey.get(key);
+    if (!rects) return;
+
+    for (const rect of rects) {
+      const first = bandOf(rect.top);
+      const last = bandOf(rect.bottom);
+      if (last - first + 1 > MAX_BANDS_PER_RECT) continue;
+      for (let band = first; band <= last; band++) {
+        const members = this.bands.get(band);
+        if (!members) continue;
+        members.delete(key);
+        if (members.size === 0) this.bands.delete(band);
+      }
+    }
+
+    this.tall.delete(key);
+    this.rectsByKey.delete(key);
+  }
+
+  clear(): void {
+    this.rectsByKey.clear();
+    this.bands.clear();
+    this.tall.clear();
+  }
+
+  /** Formulas with a range covering the given address. Never yields a key twice. */
+  *watchersOf(col: number, row: number): Generator<string> {
+    for (const key of this.tall) {
+      if (this.covers(key, col, row)) yield key;
+    }
+
+    const members = this.bands.get(bandOf(row));
+    if (!members) return;
+    for (const key of members) {
+      // Already considered above; a formula can hold both tall and short rects.
+      if (this.tall.has(key)) continue;
+      if (this.covers(key, col, row)) yield key;
+    }
+  }
+
+  private covers(key: string, col: number, row: number): boolean {
+    const rects = this.rectsByKey.get(key);
+    return rects !== undefined && rects.some((rect) => rectContains(rect, col, row));
+  }
+}
