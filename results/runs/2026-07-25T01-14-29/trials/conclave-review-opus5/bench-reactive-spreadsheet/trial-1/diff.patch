+      cell.value = cell.input;
+      return;
+    }
+    try {
+      cell.value = evaluate(cell.formula, this.context);
+    } catch (error) {
+      // Evaluation is not expected to throw. If it somehow does, the failure
+      // belongs in the cell rather than half-way through an update, so the
+      // rest of the sheet stays consistent.
+      cell.value = new CellError(ErrorCode.EVAL, String(error));
+    }
+  }
+
+  // --- range access -------------------------------------------------------
+
+  /**
+   * Populated cells inside a rectangle, in row-major order. Empty cells are
+   * omitted: no built-in distinguishes an empty cell from an absent one.
+   */
+  private cellsIn(rect: Rect): Cell[] {
+    const area = rectArea(rect);
+    const found: Cell[] = [];
+
+    if (area <= RECT_SCAN_THRESHOLD || area <= this.cells.size) {
+      forEachInRect(rect, (col, row) => {
+        const cell = this.cells.get(makeKey(col, row));
+        if (cell) found.push(cell);
+      });
+      return found;
+    }
+
+    for (const cell of this.cells.values()) {
+      if (rectContains(rect, cell.ref.col, cell.ref.row)) found.push(cell);
+    }
+    return sortRowMajor(found);
+  }
+
+  private sortedCells(): Cell[] {
+    return sortRowMajor([...this.cells.values()]);
+  }
+}
+
+/** Converts the internal representation to the public one (errors as text). */
+function toPublic(value: InternalValue): CellValue {
+  return isCellError(value) ? value.code : value;
+}
+
+function sortRowMajor(cells: Cell[]): Cell[] {
+  return cells.sort((a, b) => a.ref.row - b.ref.row || a.ref.col - b.ref.col);
+}
+
+/** Rebuilds `start -> ... -> node -> start` from the DFS parent links. */
+function buildCyclePath(parents: Map<string, string>, start: string, node: string): string[] {
+  const path = [node];
+  let current = node;
+  while (current !== start) {
+    current = parents.get(current) as string;
+    path.push(current);
+  }
+  path.reverse();
+  path.push(start);
+  return path;
+}
