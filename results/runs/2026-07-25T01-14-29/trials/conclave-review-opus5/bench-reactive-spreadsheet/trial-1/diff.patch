index 0000000..48a1481
--- /dev/null
+++ b/src/tokenizer.ts
@@ -0,0 +1,120 @@
+/** Lexer for formula expressions (the text after the leading `=`). */
+
+import { FormulaSyntaxError } from './errors.js';
+
+export type TokenType =
+  | 'number'
+  | 'string'
+  | 'ref'
+  | 'identifier'
+  | 'operator'
+  | 'punct'
+  | 'eof';
+
+export interface Token {
+  readonly type: TokenType;
+  /** Raw source text for the token; for strings, the decoded contents. */
+  readonly value: string;
+  readonly start: number;
+}
+
+/**
+ * A cell reference. The negative lookahead keeps `LOG10(` and `A1B` from being
+ * mistaken for references — those fall through to the identifier rule.
+ */
+const REF_RE = /\$?[A-Za-z]{1,3}\$?[0-9]+(?![A-Za-z0-9_.$(])/y;
+const NUMBER_RE = /[0-9]+(?:\.[0-9]*)?(?:[eE][+-]?[0-9]+)?|\.[0-9]+(?:[eE][+-]?[0-9]+)?/y;
+const IDENT_RE = /[A-Za-z_][A-Za-z0-9_.]*/y;
+
+/** Multi-character operators must be tried before their single-char prefixes. */
+const OPERATORS = ['<>', '<=', '>=', '+', '-', '*', '/', '^', '&', '=', '<', '>'];
+const PUNCTUATION = ['(', ')', ',', ':'];
+
+const QUOTES = new Set(['"', "'"]);
+
+/** Splits a formula body into tokens. Throws on characters it cannot classify. */
+export function tokenize(source: string): Token[] {
+  const tokens: Token[] = [];
+  let pos = 0;
+
+  while (pos < source.length) {
+    const char = source[pos];
+
+    if (char === ' ' || char === '\t' || char === '\n' || char === '\r') {
+      pos++;
+      continue;
+    }
+
+    if (QUOTES.has(char)) {
+      const { value, end } = readString(source, pos);
+      tokens.push({ type: 'string', value, start: pos });
+      pos = end;
+      continue;
+    }
+
+    REF_RE.lastIndex = pos;
+    const refMatch = REF_RE.exec(source);
+    if (refMatch) {
+      tokens.push({ type: 'ref', value: refMatch[0], start: pos });
+      pos = REF_RE.lastIndex;
+      continue;
+    }
+
+    NUMBER_RE.lastIndex = pos;
+    const numberMatch = NUMBER_RE.exec(source);
+    if (numberMatch) {
+      tokens.push({ type: 'number', value: numberMatch[0], start: pos });
+      pos = NUMBER_RE.lastIndex;
+      continue;
+    }
+
+    IDENT_RE.lastIndex = pos;
+    const identMatch = IDENT_RE.exec(source);
+    if (identMatch) {
+      tokens.push({ type: 'identifier', value: identMatch[0], start: pos });
+      pos = IDENT_RE.lastIndex;
+      continue;
+    }
+
+    const operator = OPERATORS.find((op) => source.startsWith(op, pos));
+    if (operator) {
+      tokens.push({ type: 'operator', value: operator, start: pos });
+      pos += operator.length;
+      continue;
+    }
+
+    if (PUNCTUATION.includes(char)) {
+      tokens.push({ type: 'punct', value: char, start: pos });
+      pos++;
+      continue;
+    }
+
+    throw new FormulaSyntaxError(`Unexpected character ${JSON.stringify(char)}`, source, pos);
+  }
+
+  tokens.push({ type: 'eof', value: '', start: source.length });
+  return tokens;
+}
+
+/** Reads a quoted string; a doubled quote character is an escaped quote. */
+function readString(source: string, start: number): { value: string; end: number } {
+  const quote = source[start];
+  let pos = start + 1;
+  let value = '';
+
+  while (pos < source.length) {
+    const char = source[pos];
+    if (char === quote) {
+      if (source[pos + 1] === quote) {
+        value += quote;
+        pos += 2;
+        continue;
+      }
+      return { value, end: pos + 1 };
+    }
+    value += char;
+    pos++;
+  }
+
+  throw new FormulaSyntaxError('Unterminated string literal', source, start);
+}
