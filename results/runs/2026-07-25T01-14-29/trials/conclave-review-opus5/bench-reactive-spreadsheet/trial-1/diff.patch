--- /dev/null
+++ b/src/reference.ts
@@ -0,0 +1,130 @@
+/** Parsing and formatting of A1-style cell references and rectangular ranges. */
+
+import { InvalidReferenceError } from './errors.js';
+
+/** A single cell address. `col` and `row` are both 1-based. */
+export interface CellRef {
+  readonly col: number;
+  readonly row: number;
+  /** Canonical uppercase form, e.g. `"AA12"`. */
+  readonly key: string;
+}
+
+/** An inclusive rectangle of cells, in 1-based coordinates. */
+export interface Rect {
+  readonly left: number;
+  readonly top: number;
+  readonly right: number;
+  readonly bottom: number;
+}
+
+/** Upper bounds, matching the limits of a modern spreadsheet grid. */
+export const MAX_COLUMN = 16384; // XFD
+export const MAX_ROW = 1048576;
+
+const CELL_PATTERN = /^\$?([A-Za-z]{1,3})\$?([0-9]{1,7})$/;
+
+/** Converts column letters to a 1-based index: `A` -> 1, `Z` -> 26, `AA` -> 27. */
+export function columnToIndex(letters: string): number {
+  let index = 0;
+  for (let i = 0; i < letters.length; i++) {
+    const code = letters.charCodeAt(i);
+    const digit =
+      code >= 65 && code <= 90
+        ? code - 64 // A-Z
+        : code >= 97 && code <= 122
+          ? code - 96 // a-z
+          : 0;
+    if (digit === 0) return 0;
+    index = index * 26 + digit;
+  }
+  return index;
+}
+
+/** Converts a 1-based column index back to letters: `1` -> `A`, `27` -> `AA`. */
+export function indexToColumn(index: number): string {
+  if (!Number.isInteger(index) || index < 1) {
+    throw new RangeError(`Column index out of range: ${index}`);
+  }
+  let letters = '';
+  let remaining = index;
+  while (remaining > 0) {
+    const rest = (remaining - 1) % 26;
+    letters = String.fromCharCode(65 + rest) + letters;
+    remaining = Math.floor((remaining - 1) / 26);
+  }
+  return letters;
+}
+
+/** Builds the canonical reference string for a coordinate pair. */
+export function makeKey(col: number, row: number): string {
+  return `${indexToColumn(col)}${row}`;
+}
+
+/** Builds a {@link CellRef} from coordinates without re-parsing text. */
+export function cellRef(col: number, row: number): CellRef {
+  return { col, row, key: makeKey(col, row) };
+}
+
+/**
+ * Parses an A1-style reference. Case-insensitive; leading `$` markers are
+ * accepted and ignored. Returns `null` when the text is not a valid reference.
+ */
+export function tryParseRef(text: string): CellRef | null {
+  const match = CELL_PATTERN.exec(text.trim());
+  if (!match) return null;
+  const col = columnToIndex(match[1]);
+  const row = Number(match[2]);
+  if (col < 1 || col > MAX_COLUMN) return null;
+  if (row < 1 || row > MAX_ROW) return null;
+  return cellRef(col, row);
+}
+
+/** Like {@link tryParseRef} but throws {@link InvalidReferenceError} on failure. */
+export function parseRef(text: string): CellRef {
+  const ref = typeof text === 'string' ? tryParseRef(text) : null;
+  if (!ref) throw new InvalidReferenceError(String(text));
+  return ref;
+}
+
+/** Normalizes user input such as `"$b2"` to the canonical `"B2"`. */
+export function normalizeRef(text: string): string {
+  return parseRef(text).key;
+}
+
+/** Builds the smallest rectangle covering both corners, in any order. */
+export function rectFrom(a: CellRef, b: CellRef): Rect {
+  return {
+    left: Math.min(a.col, b.col),
+    right: Math.max(a.col, b.col),
+    top: Math.min(a.row, b.row),
+    bottom: Math.max(a.row, b.row),
+  };
+}
+
+export function rectContains(rect: Rect, col: number, row: number): boolean {
+  return col >= rect.left && col <= rect.right && row >= rect.top && row <= rect.bottom;
+}
+
+/** Number of cells covered by the rectangle. */
+export function rectArea(rect: Rect): number {
+  return (rect.right - rect.left + 1) * (rect.bottom - rect.top + 1);
+}
+
+/** Canonical `A1:B2` text for a rectangle, used in error messages. */
+export function rectToString(rect: Rect): string {
+  return `${makeKey(rect.left, rect.top)}:${makeKey(rect.right, rect.bottom)}`;
+}
+
+/**
+ * Visits every address in the rectangle in row-major order.
+ * Callers that only care about populated cells should prefer scanning their own
+ * cell map when the rectangle is large — see `Spreadsheet.cellsIn`.
+ */
+export function forEachInRect(rect: Rect, visit: (col: number, row: number) => void): void {
+  for (let row = rect.top; row <= rect.bottom; row++) {
+    for (let col = rect.left; col <= rect.right; col++) {
+      visit(col, row);
+    }
+  }
+}
