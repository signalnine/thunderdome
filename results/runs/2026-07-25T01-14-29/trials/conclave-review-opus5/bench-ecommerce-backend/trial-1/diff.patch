diff --git a/src/orders/index.ts b/src/orders/index.ts
new file mode 100644
index 0000000..d8f9bd7
--- /dev/null
+++ b/src/orders/index.ts
@@ -0,0 +1,92 @@
+import { EventBus } from '../bus.js';
+import { emitEvent } from '../common/emit.js';
+import { generateId } from '../common/id.js';
+import {
+  Events,
+  OrderCreatedEvent,
+  OrderService,
+  OrderStatus,
+  OrderStatusChangedEvent,
+} from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  status: OrderStatus;
+  total: number;
+}
+
+/**
+ * Legal status transitions. An order moves forward one step at a time and can
+ * be cancelled from any state that has not reached a terminal one.
+ */
+const ALLOWED_TRANSITIONS: Record<OrderStatus, readonly OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED, OrderStatus.CANCELLED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+/**
+ * Order lifecycle. Orders start PENDING and only move through transitions the
+ * state machine allows; every accepted move is broadcast so notifications and
+ * analytics stay in sync.
+ */
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      if (!Number.isFinite(total) || total < 0) {
+        throw new Error(`Invalid order total: ${total}`);
+      }
+
+      const id = generateId('order');
+      orders.set(id, { id, userId, cartId, status: OrderStatus.PENDING, total });
+
+      const event: OrderCreatedEvent = { orderId: id, userId, cartId, total };
+      emitEvent(bus, Events.ORDER_CREATED, event);
+
+      return id;
+    },
+
+    getOrder(orderId: string): { id: string; userId: string; status: OrderStatus; total: number } | null {
+      const order = orders.get(orderId);
+      if (!order) return null;
+
+      return {
+        id: order.id,
+        userId: order.userId,
+        status: order.status,
+        total: order.total,
+      };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) {
+        throw new Error(`Unknown order: ${orderId}`);
+      }
+
+      const previousStatus = order.status;
+      if (!ALLOWED_TRANSITIONS[previousStatus].includes(status)) {
+        throw new Error(
+          `Illegal order transition for ${orderId}: ${previousStatus} -> ${status}`,
+        );
+      }
+
+      order.status = status;
+
+      const event: OrderStatusChangedEvent = { orderId, status, previousStatus };
+      emitEvent(bus, Events.ORDER_STATUS_CHANGED, event);
+    },
+
+    listOrders(userId: string): Array<{ id: string; status: OrderStatus; total: number }> {
+      return [...orders.values()]
+        .filter(order => order.userId === userId)
+        .map(order => ({ id: order.id, status: order.status, total: order.total }));
+    },
+  };
+}
