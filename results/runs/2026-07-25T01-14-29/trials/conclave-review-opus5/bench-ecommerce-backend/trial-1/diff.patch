  catalog.updateProduct(id, { price: 14.99 });\n193\t    expect(catalog.getProduct(id)!.price).toBe(14.99);\n194\t\n195\t    const removed = catalog.removeProduct(id);\n196\t    expect(removed).toBe(true);\n197\t    expect(catalog.getProduct(id)).toBeNull();\n198\t\n199\t    const removedAgain = catalog.removeProduct(id);\n200\t    expect(removedAgain).toBe(false);\n201\t  });\n202\t});\n203\t===== tests/integration.test.ts =====\n204\timport { describe, it, expect, beforeEach } from 'vitest';\n205\timport { createHash } from 'crypto';\n206\timport { readFileSync, readdirSync } from 'fs';\n207\timport { resolve, dirname } from 'path';\n208\timport { fileURLToPath } from 'url';\n209\timport { EventBus } from '../src/bus.js';\n210\timport { Events, OrderStatus, PaymentStatus } from '../src/types.js';\n211\timport { createCatalogService } from '../src/catalog/index.js';\n212\timport { createInventoryService } from '../src/inventory/index.js';\n213\timport { createCartService } from '../src/cart/index.js';\n214\timport { createPricingService } from '../src/pricing/index.js';\n215\timport { createOrderService } from '../src/orders/index.js';\n216\timport { createPaymentService } from '../src/payment/index.js';\n217\timport { createNotificationService } from '../src/notifications/index.js';\n218\timport { createAnalyticsService } from '../src/analytics/index.js';\n219\t\n220\tconst __filename = fileURLToPath(import.meta.url);\n221\tconst __dirname = dirname(__filename);\n222\tconst srcDir = resolve(__dirname, '..', 'src');\n223\t\n224\tfunction sha256(filePath: string): string {\n225\t  const content = readFileSync(filePath, 'utf-8');\n226\t  return createHash('sha256').update(content).digest('hex');\n227\t}\n228\t\n229\tdescribe('Integration Tests', () => {\n230\t  let bus: EventBus;\n231\t  let catalog: ReturnType<typeof createCatalogService>;\n232\t  let inventory: ReturnType<typeof createInventoryService>;\n233\t  let cart: ReturnType<typeof createCartService>;\n234\t