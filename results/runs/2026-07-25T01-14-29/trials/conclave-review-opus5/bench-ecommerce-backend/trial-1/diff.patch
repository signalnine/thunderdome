 productId, quantity });\n      }\n\n      publishUpdate(cart);\n    },\n\n    removeItem(cartId: string, productId: string): void {\n      const cart = requireCart(cartId);\n      const index = cart.items.findIndex(item => item.productId === productId);\n      if (index === -1) return;\n\n      cart.items.splice(index, 1);\n      publishUpdate(cart);\n    },\n\n    getCart(cartId: string): Cart | null {\n      const cart = carts.get(cartId);\n      if (!cart) return null;\n      return { ...cart, items: cart.items.map(item => ({ ...item })) };\n    },\n\n    clearCart(cartId: string): void {\n      const cart = requireCart(cartId);\n      if (cart.items.length === 0) return;\n\n      cart.items = [];\n      publishUpdate(cart);\n    },\n\n    updateQuantity(cartId: string, productId: string, quantity: number): void {\n      if (!Number.isFinite(quantity) || quantity < 0) {\n        throw new Error(`Invalid quantity: ${quantity}`);\n      }\n\n      const cart = requireCart(cartId);\n      const index = cart.items.findIndex(item => item.productId === productId);\n      if (index === -1) {\n        throw new Error(`Product ${productId} is not in cart ${cartId}`);\n      }\n\n      // A quantity of zero is the conventional way to drop a line item.\n      if (quantity === 0) {\n        cart.items.splice(index, 1);\n      } else {\n        cart.items[index].quantity = quantity;\n      }\n\n      publishUpdate(cart);\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1035,"cache_read_input_tokens":55226,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1035},"output_tokens":61,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9acea484-8931-43f9-b4f9-99a255b023a5","uuid":"a5a4c64e-a280-4bf7-990f-5f684009c7ff","request_id":"req_011CdMvws2jeT