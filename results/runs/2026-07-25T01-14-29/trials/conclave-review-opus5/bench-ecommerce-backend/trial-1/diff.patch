oBe(true);\n275\t    expect(catalog.getProduct(id)).toBeNull();\n276\t    expect(catalog.listProducts()).toHaveLength(0);\n277\t  });\n278\t\n279\t  // 4-5: Inventory management with stock events\n280\t  it('4. should set stock and emit inventory:updated event', () => {\n281\t    inventory.setStock('p1', 100);\n282\t    const log = bus.getLog();\n283\t    const invEvents = log.filter(e => e.event === Events.INVENTORY_UPDATED);\n284\t    expect(invEvents.length).toBeGreaterThanOrEqual(1);\n285\t    const payload = invEvents[0].payload as { productId: string; quantity: number };\n286\t    expect(payload.productId).toBe('p1');\n287\t    expect(payload.quantity).toBe(100);\n288\t  });\n289\t\n290\t  it('5. should reserve stock and reflect updated quantity', () => {\n291\t    inventory.setStock('p1', 10);\n292\t    const reserved = inventory.reserve('p1', 3);\n293\t    expect(reserved).toBe(true);\n294\t    expect(inventory.getStock('p1')).toBe(7);\n295\t\n296\t    const failedReserve = inventory.reserve('p1', 100);\n297\t    expect(failedReserve).toBe(false);\n298\t    expect(inventory.getStock('p1')).toBe(7);\n299\t  });\n300\t\n301\t  // 6-7: Cart operations emitting cart events\n302\t  it('6. should add items to cart and emit cart:updated event', () => {\n303\t    const cartId = cart.createCart('user1');\n304\t    cart.addItem(cartId, 'p1', 2);\n305\t    const log = bus.getLog();\n306\t    const cartEvents = log.filter(e => e.event === Events.CART_UPDATED);\n307\t    expect(cartEvents).toHaveLength(1);\n308\t    const payload = cartEvents[0].payload as { cartId: string; items: Array<{ productId: string; quantity: number }> };\n309\t    expect(payload.cartId).toBe(cartId);\n310\t    expect(payload.items).toHaveLength(1);\n311\t  });\n312\t\n313\t  it('7. should update cart quantity and reflect in cart data', () => {\n314\t    const cartId = cart.createCart('user1');\n315\t    cart.addItem(cartId, 'p1', 2);\n316\t    cart.updateQuantity(cartId, 'p1', 5);\n317\t    const c = cart.getCart(cartId);\n318\t    expect(c!.items[0].quantity).toBe(5);\n319\t  });\n320\t\n321\t  // 8-9: Pricing calculation with discount codes\n322\t  it('8. should calculate price with tax (10%)', () => {\n323\t    const result = pricing.calculateTotal([\n324\t      { productId: 'p1', quantity: 2, price: 50 },\n325\t    ]);\n326\t    expect(result.subtotal).toBe(100);\n327\t    expect(result.tax).toBe(10);\n328\t    expect(result.total).toBe(110);\n329\t  });\n330\t\n331\t  it('9. should apply discount code and compute correct total', () => {\n332\t    pricing.addDiscountCode('SAVE20', 20);\n333\t    const result = pricing.calculateTotal(\n334\t      [{ productId: 'p1', quantity: 1, price: 200 }],\n335\t      'SAVE20',\n336\t    );\n337\t    expect(result.subtotal).toBe(200);\n338\t    expect(result.discount).toBe(40);\n339\t    // After discount: 160, tax: 16, total: 176\n340\t    expect(result.tax).toBe(16);\n341\t    expect(result.total).toBe(176);\n342\t  });\n343\t\n344\t  // 10-12: Order creation and status transitions\n345\t  it('10. should create an order with PENDING status', () => {\n346\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n347\t    const order = orders.getOrder(orderId);\n348\t    expect(order!.status).toBe(OrderStatus.PENDING);\n349\t    expect(order!.total).toBe(150);\n350\t  });\n351\t\n352\t  it('11. should transition order through status states', () => {\n353\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n354\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n355\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n356\t\n357\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n358\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.SHIPPED);\n359\t\n360\t    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n361\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.DELIVERED);\n362\t  });\n363\t\n364\t  it('12. should emit order:status_changed events with correct previous status', () => {\n365\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n366\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n367\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n368\t\n369\t    const log = bus.getLog();\n370\t    const statusEvents = log.filter(e => e.event === Events.ORDER_STATUS_CHANGED);\n371\t    expect(statusEvents).toHaveLength(2);\n372\t\n373\t    const first = statusEvents[0].payload as { previousStatus: string; status: string };\n374\t    expect(first.previousStatus).toBe(OrderStatus.PENDING);\n375\t    expect(first.status).toBe(OrderStatus.CONFIRMED);\n376\t\n377\t    const second = statusEvents[1].payload as { previousStatus: string; status: string };\n378\t    expect(second.previousStatus).toBe(OrderStatus.CONFIRMED);\n379\t    expect(second.status).toBe(OrderStatus.SHIPPED);\n380\t  });\n381\t\n382\t  // 13-14: Payment processing (success and failure)\n383\t  it('13. should process payment successfully and emit event', async () => {\n384\t    const result = await payment.processPayment('order1', 99.99);\n385\t    expect(result.status).toBe(PaymentStatus.SUCCESS);\n386\t    expect(result.transactionId).toBeDefined();\n387\t\n388\t    const log = bus.getLog();\n389\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n390\t    expect(payEvents).toHaveLength(1);\n391\t  });\n392\t\n393\t  it('14. should handle payment failure and emit failure event', async () => {\n394\t    const failPayment = createPaymentService(bus, { simulateFailure: true });\n395\t    const result = await failPayment.processPayment('order1', 99.99);\n396\t    expect(result.status).toBe(PaymentStatus.FAILED);\n397\t\n398\t    const log = bus.getLog();\n399\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n400\t    const failEvent = payEvents.find(e => (e.payload as { status: string }).status === PaymentStatus.FAILED);\n401\t    expect(failEvent).toBeDefined();\n402\t  });\n403\t\n404\t  // 15-16: Notifications generated for order events\n405\t  it('15. should send notification on order status change', async () => {\n406\t    notifications.subscribe('user1');\n407\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n408\t\n409\t    // Wait for event propagation\n410\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n411\t\n412\t    // Give async handlers a tick to resolve\n413\t    await new Promise(resolve => setTimeout(resolve, 10));\n414\t\n415\t    const notifs = notifications.getNotifications('user1');\n416\t    expect(notifs.length).toBeGreaterThanOrEqual(1);\n417\t    expect(notifs.some(n => n.type === 'order_status')).toBe(true);\n418\t  });\n419\t\n420\t  it('16. should send notification on payment processed', async () => {\n421\t    notifications.subscribe('user1');\n422\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n423\t\n424\t    await payment.processPayment(orderId, 100);\n425\t\n426\t    await new Promise(resolve => setTimeout(resolve, 10));\n427\t\n428\t    const notifs = notifications.getNotifications('user1');\n429\t    expect(notifs.some(n => n.type === 'payment')).toBe(true);\n430\t  });\n431\t\n432\t  // 17-18: Analytics tracking events and computing metrics\n433\t  it('17. should track event counts through the bus', async () => {\n434\t    catalog.createProduct('Widget', 10, 'gadgets');\n435\t    catalog.createProduct('Gizmo', 20, 'gadgets');\n436\t\n437\t    // Wait for async propagation\n438\t    await new Promise(resolve => setTimeout(resolve, 10));\n439\t\n440\t    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n441\t  });\n442\t\n443\t  it('18. should track revenue from successful payments', async () => {\n444\t    const orderId = orders.createOrder('user1', 'cart1', 250);\n445\t    await payment.processPayment(orderId, 250);\n446\t\n447\t    expect(analytics.getRevenue()).toBe(250);\n448\t  });\n449\t\n450\t  // 19: Full checkout flow\n451\t  it('19. should complete full checkout flow end-to-end', async () => {\n452\t    // Subscribe for notifications\n453\t    notifications.subscribe('user1');\n454\t\n455\t    // Create product\n456\t    const productId = catalog.createProduct('Premium Widget', 49.99, 'gadgets');\n457\t    expect(catalog.getProduct(productId)).not.toBeNull();\n458\t\n459\t    // Set stock\n460\t    inventory.setStock(productId, 100);\n461\t    expect(inventory.getStock(productId)).toBe(100);\n462\t\n463\t    // Add to cart\n464\t    const cartId = cart.createCart('user1');\n465\t    cart.addItem(cartId, productId, 2);\n466\t    const cartData = cart.getCart(cartId);\n467\t    expect(cartData!.items).toHaveLength(1);\n468\t\n469\t    // Calculate price\n470\t    const priceResult = pricing.calculateTotal([\n471\t      { productId, quantity: 2, price: 49.99 },\n472\t    ]);\n473\t    expect(priceResult.subtotal).toBe(99.98);\n474\t    expect(priceResult.total).toBeGreaterThan(0);\n475\t\n476\t    // Reserve inventory\n477\t    const reserved = inventory.reserve(productId, 2);\n478\t    expect(reserved).toBe(true);\n479\t    expect(inventory.getStock(productId)).toBe(98);\n480\t\n481\t    // Create order\n482\t    const orderId = orders.createOrder('user1', cartId, priceResult.total);\n483\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.PENDING);\n484\t\n485\t    // Process payment\n486\t    const payResult = await payment.processPayment(orderId, priceResult.total);\n487\t    expect(payResult.status).toBe(PaymentStatus.SUCCESS);\n488\t\n489\t    // Update order status\n490\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n491\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n492\t\n493\t    // Wait for async event propagation\n494\t    await new Promise(resolve => setTimeout(resolve, 50));\n495\t\n496\t    // Verify notifications were sent\n497\t    const notifs = notifications.getNotifications('user1');\n498\t    expect(notifs.length).toBeGreaterThanOrEqual(1);\n499\t\n500\t    // Verify analytics tracked the events\n501\t    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBeGreaterThanOrEqual(1);\n502\t    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBeGreaterThanOrEqual(1);\n503\t    expect(analytics.getRevenue()).toBe(priceResult.total);\n504\t\n505\t    // Verify bus log has all expected events\n506\t    const log = bus.getLog();\n507\t    const eventTypes = new Set(log.map(e => e.event));\n508\t    expect(eventTypes.has(Events.PRODUCT_CREATED)).toBe(true);\n509\t    expect(eventTypes.has(Events.INVENTORY_UPDATED)).toBe(true);\n510\t    expect(eventTypes.has(Events.CART_UPDATED)).toBe(true);\n511\t    expect(eventTypes.has(Events.ORDER_CREATED)).toBe(true);\n512\t    expect(eventTypes.has(Events.PAYMENT_PROCESSED)).toBe(true);\n513\t    expect(eventTypes.has(Events.ORDER_STATUS_CHANGED)).toBe(true);\n514\t  });\n515\t\n516\t  // 20: Low stock alert\n517\t  it('20. should trigger low stock alert when stock drops below threshold', () => {\n518\t    inventory.setStock('p1', 20);\n519\t    inventory.setLowStockThreshold('p1', 5);\n520\t\n521\t    // Reserve stock to trigger low stock\n522\t    inventory.reserve('p1', 16); // stock drops to 4, below threshold of 5\n523\t\n524\t    const log = bus.getLog();\n525\t    const alerts = log.filter(e => e.event === Events.LOW_STOCK_ALERT);\n526\t    expect(alerts.length).toBeGreaterThanOrEqual(1);\n527\t    const payload = alerts[alerts.length - 1].payload as { productId: string; currentQuantity: number; threshold: number };\n528\t    expect(payload.productId).toBe('p1');\n529\t    expect(payload.currentQuantity).toBe(4);\n530\t    expect(payload.threshold).toBe(5);\n531\t  });\n532\t\n533\t  // 21: Import graph validation\n534\t  it('21. should not have cross-service imports', () => {\n535\t    const serviceNames = ['catalog', 'inventory', 'cart', 'pricing', 'orders', 'payment', 'notifications', 'analytics'];\n536\t    const violations: string[] = [];\n537\t\n538\t    for (const service of serviceNames) {\n539\t      const serviceDir = resolve(srcDir, service);\n540\t      let files: string[];\n541\t      try {\n542\t        files = readdirSync(serviceDir).filter(f => f.endsWith('.ts'));\n543\t      } catch {\n544\t        continue;\n545\t      }\n546\t\n547\t      for (const file of files) {\n548\t        const content = readFileSync(resolve(serviceDir, file), 'utf-8');\n549\t        for (const otherService of serviceNames) {\n550\t          if (otherService === service) continue;\n551\t          // Check for imports from other service directories\n552\t          const importPattern = new RegExp(`from\\\\s+['\"].*/${otherService}/`, 'g');\n553\t          if (importPattern.test(content)) {\n554\t            violations.push(`${service}/${file} imports from ${otherService}`);\n555\t          }\n556\t        }\n557\t      }\n558\t    }\n559\t\n560\t    expect(violations).toHaveLength(0);\n561\t  });\n562\t\n563\t  // 22: Checksum validation\n564\t  it('22. should have unmodified bus.ts and types.ts', () => {\n565\t    const busHash = sha256(resolve(srcDir, 'bus.ts'));\n566\t    const typesHash = sha256(resolve(srcDir, 'types.ts'));\n567\t\n568\t    expect(busHash).toBe('53821a7f0a41a0bbb4a0fbbf7707b11c566abbf92f525e9b64a70b28efe6a866');\n569\t    expect(typesHash).toBe('778497bd1e702d81a70c7a8ed1c5ee18d83a8bff3da14ac70bd690977abb403f');\n570\t  });\n571\t});\n572\t===== tests/inventory.test.ts =====\n573\timport { describe, it, expect, beforeEach } from 'vitest';\n574\timport { EventBus } from '../src/bus.js';\n575\timport { createInventoryService } from '../src/inventory/index.js';\n576\t\n577\tdescribe('InventoryService (unit)', () => {\n578\t  let bus: EventBus;\n579\t  let inventory: ReturnType<typeof createInventoryService>;\n580\t\n581\t  beforeEach(() => {\n582\t    bus = new EventBus();\n583\t    inventory = createInventoryService(bus);\n584\t  });\n585\t\n586\t  it('should set and get stock for a product', () => {\n587\t    inventory.setStock('p1', 100);\n588\t    expect(inventory.getStock('p1')).toBe(100);\n589\t  });\n590\t\n591\t  it('should return 0 for unknown product stock', () => {\n592\t    expect(inventory.getStock('unknown')).toBe(0);\n593\t  });\n594\t\n595\t  it('should reserve stock when sufficient', () => {\n596\t    inventory.setStock('p1', 10);\n597\t    const result = inventory.reserve('p1', 3);\n598\t    expect(result).toBe(true);\n599\t    expect(inventory.getStock('p1')).toBe(7);\n600\t  });\n601\t\n602\t  it('should fail to reserve when insufficient stock', () => {\n603\t    inventory.setStock('p1', 2);\n604\t    const result = inventory.reserve('p1', 5);\n605\t    expect(result).toBe(false);\n606\t    expect(inventory.getStock('p1')).toBe(2);\n607\t  });\n608\t\n609\t  it('should release reserved stock', () => {\n610\t    inventory.setStock('p1', 10);\n611\t    inventory.reserve('p1', 3);\n612\t    inventory.release('p1', 3);\n613\t    expect(inventory.getStock('p1')).toBe(10);\n614\t  });\n615\t\n616\t  it('should emit inventory updated events', () => {\n617\t    inventory.setStock('p1', 50);\n618\t    const log = bus.getLog();\n619\t    expect(log.length).toBeGreaterThan(0);\n620\t    expect(log[0].event).toBe('inventory:updated');\n621\t  });\n622\t});\n623\t===== tests/notifications.test.ts =====\n624\timport { describe, it, expect, beforeEach } from 'vitest';\n625\timport { EventBus } from '../src/bus.js';\n626\timport { createNotificationService } from '../src/notifications/index.js';\n627\timport { OrderStatus, PaymentStatus } from '../src/types.js';\n628\t\n629\tdescribe('NotificationService (unit)', () => {\n630\t  let bus: EventBus;\n631\t  let notifications: ReturnType<typeof createNotificationService>;\n632\t\n633\t  beforeEach(() => {\n634\t    bus = new EventBus();\n635\t    notifications = createNotificationService(bus);\n636\t  });\n637\t\n638\t  it('should subscribe a user', () => {\n639\t    notifications.subscribe('user1');\n640\t    // No error thrown\n641\t    expect(notifications.getNotifications('user1')).toHaveLength(0);\n642\t  });\n643\t\n644\t  it('should return empty array for unsubscribed user', () => {\n645\t    expect(notifications.getNotifications('user1')).toHaveLength(0);\n646\t  });\n647\t\n648\t  it('should collect notification on order status change for subscribed user', async () => {\n649\t    notifications.subscribe('user1');\n650\t    // Simulate order created event to set up userId mapping\n651\t    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n652\t    // Simulate order status change\n653\t    await bus.emit('order:status_changed', {\n654\t      orderId: 'o1',\n655\t      status: OrderStatus.CONFIRMED,\n656\t      previousStatus: OrderStatus.PENDING,\n657\t    });\n658\t\n659\t    const notifs = notifications.getNotifications('user1');\n660\t    expect(notifs).toHaveLength(1);\n661\t    expect(notifs[0].type).toBe('order_status');\n662\t  });\n663\t\n664\t  it('should not notify unsubscribed users', async () => {\n665\t    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n666\t    await bus.emit('order:status_changed', {\n667\t      orderId: 'o1',\n668\t      status: OrderStatus.CONFIRMED,\n669\t      previousStatus: OrderStatus.PENDING,\n670\t    });\n671\t\n672\t    const notifs = notifications.getNotifications('user1');\n673\t    expect(notifs).toHaveLength(0);\n674\t  });\n675\t\n676\t  it('should collect notification on payment processed', async () => {\n677\t    notifications.subscribe('user1');\n678\t    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n679\t    await bus.emit('payment:processed', {\n680\t      orderId: 'o1',\n681\t      status: PaymentStatus.SUCCESS,\n682\t      transactionId: 'tx1',\n683\t    });\n684\t\n685\t    const notifs = notifications.getNotifications('user1');\n686\t    expect(notifs).toHaveLength(1);\n687\t    expect(notifs[0].type).toBe('payment');\n688\t  });\n689\t\n690\t  it('should accumulate multiple notifications', async () => {\n691\t    notifications.subscribe('user1');\n692\t    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n693\t    await bus.emit('order:status_changed', {\n694\t      orderId: 'o1',\n695\t      status: OrderStatus.CONFIRMED,\n696\t      previousStatus: OrderStatus.PENDING,\n697\t    });\n698\t    await bus.emit('payment:processed', {\n699\t      orderId: 'o1',\n700\t      status: PaymentStatus.SUCCESS,\n701\t      transactionId: 'tx1',\n702\t    });\n703\t\n704\t    const notifs = notifications.getNotifications('user1');\n705\t    expect(notifs).toHaveLength(2);\n706\t  });\n707\t});\n708\t===== tests/orders.test.ts =====\n709\timport { describe, it, expect, beforeEach } from 'vitest';\n710\timport { EventBus } from '../src/bus.js';\n711\timport { createOrderService } from '../src/orders/index.js';\n712\timport { OrderStatus } from '../src/types.js';\n713\t\n714\tdescribe('OrderService (unit)', () => {\n715\t  let bus: EventBus;\n716\t  let orders: ReturnType<typeof createOrderService>;\n717\t\n718\t  beforeEach(() => {\n719\t    bus = new EventBus();\n720\t    orders = createOrderService(bus);\n721\t  });\n722\t\n723\t  it('should create an order with PENDING status', () => {\n724\t    const id = orders.createOrder('user1', 'cart1', 99.99);\n725\t    expect(id).toBeDefined();\n726\t    const order = orders.getOrder(id);\n727\t    expect(order).not.toBeNull();\n728\t    expect(order!.status).toBe(OrderStatus.PENDING);\n729\t    expect(order!.total).toBe(99.99);\n730\t  });\n731\t\n732\t  it('should return null for non-existent order', () => {\n733\t    expect(orders.getOrder('non-existent')).toBeNull();\n734\t  });\n735\t\n736\t  it('should update order status', () => {\n737\t    const id = orders.createOrder('user1', 'cart1', 50);\n738\t    orders.updateStatus(id, OrderStatus.CONFIRMED);\n739\t    expect(orders.getOrder(id)!.status).toBe(OrderStatus.CONFIRMED);\n740\t  });\n741\t\n742\t  it('should track status transitions via events', () => {\n743\t    const id = orders.createOrder('user1', 'cart1', 50);\n744\t    orders.updateStatus(id, OrderStatus.CONFIRMED);\n745\t\n746\t    const log = bus.getLog();\n747\t    const statusEvents = log.filter(e => e.event === 'order:status_changed');\n748\t    expect(statusEvents).toHaveLength(1);\n749\t    const payload = statusEvents[0].payload as { previousStatus: string; status: string };\n750\t    expect(payload.previousStatus).toBe(OrderStatus.PENDING);\n751\t    expect(payload.status).toBe(OrderStatus.CONFIRMED);\n752\t  });\n753\t\n754\t  it('should list orders by user', () => {\n755\t    orders.createOrder('user1', 'cart1', 50);\n756\t    orders.createOrder('user1', 'cart2', 75);\n757\t    orders.createOrder('user2', 'cart3', 100);\n758\t\n759\t    const user1Orders = orders.listOrders('user1');\n760\t    expect(user1Orders).toHaveLength(2);\n761\t\n762\t    const user2Orders = orders.listOrders('user2');\n763\t    expect(user2Orders).toHaveLength(1);\n764\t  });\n765\t\n766\t  it('should emit order created event', () => {\n767\t    orders.createOrder('user1', 'cart1', 99.99);\n768\t    const log = bus.getLog();\n769\t    const createEvents = log.filter(e => e.event === 'order:created');\n770\t    expect(createEvents).toHaveLength(1);\n771\t  });\n772\t});\n773\t===== tests/payment.test.ts =====\n774\timport { describe, it, expect, beforeEach } from 'vitest';\n775\timport { EventBus } from '../src/bus.js';\n776\timport { createPaymentService } from '../src/payment/index.js';\n777\timport { PaymentStatus } from '../src/types.js';\n778\t\n779\tdescribe('PaymentService (unit)', () => {\n780\t  let bus: EventBus;\n781\t\n782\t  beforeEach(() => {\n783\t    bus = new EventBus();\n784\t  });\n785\t\n786\t  it('should process payment successfully', async () => {\n787\t    const payment = createPaymentService(bus);\n788\t    const result = await payment.processPayment('order1', 99.99);\n789\t    expect(result.status).toBe(PaymentStatus.SUCCESS);\n790\t    expect(result.transactionId).toBeDefined();\n791\t  });\n792\t\n793\t  it('should simulate payment failure', async () => {\n794\t    const payment = createPaymentService(bus, { simulateFailure: true });\n795\t    const result = await payment.processPayment('order1', 99.99);\n796\t    expect(result.status).toBe(PaymentStatus.FAILED);\n797\t    expect(result.error).toBeDefined();\n798\t  });\n799\t\n800\t  it('should simulate payment timeout', async () => {\n801\t    const payment = createPaymentService(bus, { simulateTimeout: true });\n802\t    const result = await payment.processPayment('order1', 99.99);\n803\t    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n804\t    expect(result.error).toBeDefined();\n805\t  });\n806\t\n807\t  it('should refund a successful transaction', async () => {\n808\t    const payment = createPaymentService(bus);\n809\t    const result = await payment.processPayment('order1', 99.99);\n810\t    const refunded = await payment.refund(result.transactionId!);\n811\t    expect(refunded).toBe(true);\n812\t  });\n813\t\n814\t  it('should fail to refund non-existent transaction', async () => {\n815\t    const payment = createPaymentService(bus);\n816\t    const refunded = await payment.refund('non-existent');\n817\t    expect(refunded).toBe(false);\n818\t  });\n819\t\n820\t  it('should emit payment processed event', async () => {\n821\t    const payment = createPaymentService(bus);\n822\t    await payment.processPayment('order1', 50);\n823\t    const log = bus.getLog();\n824\t    const paymentEvents = log.filter(e => e.event === 'payment:processed');\n825\t    expect(paymentEvents).toHaveLength(1);\n826\t  });\n827\t});\n828\t===== tests/pricing.test.ts =====\n829\timport { describe, it, expect, beforeEach } from 'vitest';\n830\timport { EventBus } from '../src/bus.js';\n831\timport { createPricingService } from '../src/pricing/index.js';\n832\t\n833\tdescribe('PricingService (unit)', () => {\n834\t  let bus: EventBus;\n835\t  let pricing: ReturnType<typeof createPricingService>;\n836\t\n837\t  beforeEach(() => {\n838\t    bus = new EventBus();\n839\t    pricing = createPricingService(bus);\n840\t  });\n841\t\n842\t  it('should calculate subtotal correctly', () => {\n843\t    const result = pricing.calculateTotal([\n844\t      { productId: 'p1', quantity: 2, price: 10 },\n845\t      { productId: 'p2', quantity: 1, price: 20 },\n846\t    ]);\n847\t    expect(result.subtotal).toBe(40);\n848\t  });\n849\t\n850\t  it('should apply 10% tax', () => {\n851\t    const result = pricing.calculateTotal([\n852\t      { productId: 'p1', quantity: 1, price: 100 },\n853\t    ]);\n854\t    expect(result.tax).toBe(10);\n855\t    expect(result.total).toBe(110);\n856\t  });\n857\t\n858\t  it('should apply discount codes', () => {\n859\t    pricing.addDiscountCode('SAVE10', 10);\n860\t    const result = pricing.calculateTotal(\n861\t      [{ productId: 'p1', quantity: 1, price: 100 }],\n862\t      'SAVE10'\n863\t    );\n864\t    expect(result.discount).toBe(10);\n865\t    expect(result.subtotal).toBe(100);\n866\t    // After discount: 90, tax: 9, total: 99\n867\t    expect(result.tax).toBe(9);\n868\t    expect(result.total).toBe(99);\n869\t  });\n870\t\n871\t  it('should ignore invalid discount codes', () => {\n872\t    const result = pricing.calculateTotal(\n873\t      [{ productId: 'p1', quantity: 1, price: 100 }],\n874\t      'INVALID'\n875\t    );\n876\t    expect(result.discount).toBe(0);\n877\t    expect(result.total).toBe(110);\n878\t  });\n879\t\n880\t  it('should handle empty items list', () => {\n881\t    const result = pricing.calculateTotal([]);\n882\t    expect(result.subtotal).toBe(0);\n883\t    expect(result.discount).toBe(0);\n884\t    expect(result.tax).toBe(0);\n885\t    expect(result.total).toBe(0);\n886\t  });\n887\t\n888\t  it('should track prices from product created events', async () => {\n889\t    await bus.emit('product:created', { productId: 'p1', name: 'Widget', price: 25.99, category: 'gadgets' });\n890\t    expect(pricing.getPrice('p1')).toBe(25.99);\n891\t    expect(pricing.getPrice('unknown')).toBe(0);\n892\t  });\n893\t});\n894\t"}]},"parent_tool_use_id":null,"session_id":"9acea484-8931-43f9-b4f9-99a255b023a5","uuid":"123c230f-09aa-4a81-908d-fad91d950daf","timestamp":"2026-07-25T01:42:53.390Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/.claude/projects/-workspace/9acea484-8931-43f9-b4f9-99a255b023a5/tool-results/b9y4xpb59.txt","content":"===== tests/analytics.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createAnalyticsService } from '../src/analytics/index.js';\nimport { Events, PaymentStatus } from '../src/types.js';\n\ndescribe('AnalyticsService (unit)', () => {\n  let bus: EventBus;\n  let analytics: ReturnType<typeof createAnalyticsService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    analytics = createAnalyticsService(bus);\n  });\n\n  it('should count events by type', async () => {\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p1', name: 'Widget', price: 10, category: 'gadgets' });\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p2', name: 'Gizmo', price: 20, category: 'gadgets' });\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n  });\n\n  it('should return 0 for unknown event type', () => {\n    expect(analytics.getEventCount('unknown:event')).toBe(0);\n  });\n\n  it('should track revenue from successful payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 'tx1' });\n    expect(analytics.getRevenue()).toBe(100);\n  });\n\n  it('should not track revenue from failed payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.FAILED, error: 'declined' });\n    expect(analytics.getRevenue()).toBe(0);\n  });\n\n  it('should compute conversion rate', async () => {\n    // Create 2 carts (via cart updated events with unique cart IDs)\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [{ productId: 'p1', quantity: 1 }] });\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c2', userId: 'u2', items: [{ productId: 'p2', quantity: 1 }] });\n    // Create 1 order\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 50 });\n\n    expect(analytics.getConversionRate()).toBe(0.5);\n  });\n\n  it('should return top products by order quantity', async () => {\n    await bus.emit(Events.CART_UPDATED, {\n      cartId: 'c1', userId: 'u1',\n      items: [{ productId: 'p1', quantity: 5 }, { productId: 'p2', quantity: 2 }],\n    });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n\n    const top = analytics.getTopProducts(2);\n    expect(top).toHaveLength(2);\n    expect(top[0].productId).toBe('p1');\n    expect(top[0].count).toBe(5);\n    expect(top[1].productId).toBe('p2');\n    expect(top[1].count).toBe(2);\n  });\n});\n===== tests/cart.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createCartService } from '../src/cart/index.js';\n\ndescribe('CartService (unit)', () => {\n  let bus: EventBus;\n  let cart: ReturnType<typeof createCartService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    cart = createCartService(bus);\n  });\n\n  it('should create a cart and return its id', () => {\n    const id = cart.createCart('user1');\n    expect(id).toBeDefined();\n    expect(typeof id).toBe('string');\n  });\n\n  it('should add items to a cart', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    const c = cart.getCart(id);\n    expect(c).not.toBeNull();\n    expect(c!.items).toHaveLength(1);\n    expect(c!.items[0].productId).toBe('p1');\n    expect(c!.items[0].quantity).toBe(2);\n  });\n\n  it('should merge quantities when adding same product', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p1', 3);\n    const c = cart.getCart(id);\n    expect(c!.items).toHaveLength(1);\n    expect(c!.items[0].quantity).toBe(5);\n  });\n\n  it('should remove items from a cart', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p2', 1);\n    cart.removeItem(id, 'p1');\n    const c = cart.getCart(id);\n    expect(c!.items).toHaveLength(1);\n    expect(c!.items[0].productId).toBe('p2');\n  });\n\n  it('should clear all items from a cart', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p2', 1);\n    cart.clearCart(id);\n    const c = cart.getCart(id);\n    expect(c!.items).toHaveLength(0);\n  });\n\n  it('should update item quantity', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.updateQuantity(id, 'p1', 10);\n    const c = cart.getCart(id);\n    expect(c!.items[0].quantity).toBe(10);\n  });\n});\n===== tests/catalog.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createCatalogService } from '../src/catalog/index.js';\n\ndescribe('CatalogService (unit)', () => {\n  let bus: EventBus;\n  let catalog: ReturnType<typeof createCatalogService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    catalog = createCatalogService(bus);\n  });\n\n  it('should create a product and return its id', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    expect(id).toBeDefined();\n    expect(typeof id).toBe('string');\n  });\n\n  it('should retrieve a product by id', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    const product = catalog.getProduct(id);\n    expect(product).not.toBeNull();\n    expect(product!.name).toBe('Widget');\n    expect(product!.price).toBe(9.99);\n    expect(product!.category).toBe('gadgets');\n  });\n\n  it('should return null for non-existent product', () => {\n    const product = catalog.getProduct('non-existent');\n    expect(product).toBeNull();\n  });\n\n  it('should list products filtered by category', () => {\n    catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.createProduct('Gizmo', 19.99, 'gadgets');\n    catalog.createProduct('Book', 12.99, 'books');\n\n    const gadgets = catalog.listProducts('gadgets');\n    expect(gadgets).toHaveLength(2);\n\n    const books = catalog.listProducts('books');\n    expect(books).toHaveLength(1);\n\n    const all = catalog.listProducts();\n    expect(all).toHaveLength(3);\n  });\n\n  it('should search products by name or category', () => {\n    catalog.createProduct('Blue Widget', 9.99, 'gadgets');\n    catalog.createProduct('Red Gizmo', 19.99, 'electronics');\n\n    const results = catalog.searchProducts('widget');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('Blue Widget');\n\n    const catResults = catalog.searchProducts('electronics');\n    expect(catResults).toHaveLength(1);\n  });\n\n  it('should update and remove products', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    catalog.updateProduct(id, { price: 14.99 });\n    expect(catalog.getProduct(id)!.price).toBe(14.99);\n\n    const removed = catalog.removeProduct(id);\n    expect(removed).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n\n    const removedAgain = catalog.removeProduct(id);\n    expect(removedAgain).toBe(false);\n  });\n});\n===== tests/integration.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { createHash } from 'crypto';\nimport { readFileSync, readdirSync } from 'fs';\nimport { resolve, dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport { EventBus } from '../src/bus.js';\nimport { Events, OrderStatus, PaymentStatus } from '../src/types.js';\nimport { createCatalogService } from '../src/catalog/index.js';\nimport { createInventoryService } from '../src/inventory/index.js';\nimport { createCartService } from '../src/cart/index.js';\nimport { createPricingService } from '../src/pricing/index.js';\nimport { createOrderService } from '../src/orders/index.js';\nimport { createPaymentService } from '../src/payment/index.js';\nimport { createNotificationService } from '../src/notifications/index.js';\nimport { createAnalyticsService } from '../src/analytics/index.js';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = dirname(__filename);\nconst srcDir = resolve(__dirname, '..', 'src');\n\nfunction sha256(filePath: string): string {\n  const content = readFileSync(filePath, 'utf-8');\n  return createHash('sha256').update(content).digest('hex');\n}\n\ndescribe('Integration Tests', () => {\n  let bus: EventBus;\n  let catalog: ReturnType<typeof createCatalogService>;\n  let inventory: ReturnType<typeof createInventoryService>;\n  let cart: ReturnType<typeof createCartService>;\n  let pricing: ReturnType<typeof createPricingService>;\n  let orders: ReturnType<typeof createOrderService>;\n  let payment: ReturnType<typeof createPaymentService>;\n  let notifications: ReturnType<typeof createNotificationService>;\n  let analytics: ReturnType<typeof createAnalyticsService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    catalog = createCatalogService(bus);\n    inventory = createInventoryService(bus);\n    cart = createCartService(bus);\n    pricing = createPricingService(bus);\n    orders = createOrderService(bus);\n    payment = createPaymentService(bus);\n    notifications = createNotificationService(bus);\n    analytics = createAnalyticsService(bus);\n  });\n\n  // 1-3: Product catalog CRUD through bus events\n  it('1. should create a product and emit product:created event', () => {\n    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    expect(id).toBeDefined();\n    const log = bus.getLog();\n    const createEvents = log.filter(e => e.event === Events.PRODUCT_CREATED);\n    expect(createEvents).toHaveLength(1);\n    const payload = createEvents[0].payload as { productId: string; name: string };\n    expect(payload.productId).toBe(id);\n    expect(payload.name).toBe('Laptop');\n  });\n\n  it('2. should update a product and retrieve updated data', () => {\n    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    catalog.updateProduct(id, { price: 899.99, name: 'Gaming Laptop' });\n    const product = catalog.getProduct(id);\n    expect(product!.price).toBe(899.99);\n    expect(product!.name).toBe('Gaming Laptop');\n  });\n\n  it('3. should remove a product and confirm deletion', () => {\n    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    expect(catalog.removeProduct(id)).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n    expect(catalog.listProducts()).toHaveLength(0);\n  });\n\n  // 4-5: Inventory management with stock events\n  it('4. should set stock and emit inventory:updated event', () => {\n    inventory.setStock('p1', 100);\n    const log = bus.getLog();\n    const invEvents = log.filter(e => e.event === Events.INVENTORY_UPDATED);\n    expect(invEvents.length).toBeGreaterThanOrEqual(1);\n    const payload = invEvents[0].payload as { productId: string; quantity: number };\n    expect(payload.productId).toBe('p1');\n    expect(payload.quantity).toBe(100);\n  });\n\n  it('5. should reserve stock and reflect updated quantity', () => {\n    inventory.setStock('p1', 10);\n    const reserved = inventory.reserve('p1', 3);\n    expect(reserved).toBe(true);\n    expect(inventory.getStock('p1')).toBe(7);\n\n    const failedReserve = inventory.reserve('p1', 100);\n    expect(failedReserve).toBe(false);\n    expect(inventory.getStock('p1')).toBe(7);\n  });\n\n  // 6-7: Cart operations emitting cart events\n  it('6. should add items to cart and emit cart:updated event', () => {\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, 'p1', 2);\n    const log = bus.getLog();\n    const cartEvents = log.filter(e => e.event === Events.CART_UPDATED);\n    expect(cartEvents).toHaveLength(1);\n    const payload = cartEvents[0].payload as { cartId: string; items: Array<{ productId: string; quantity: number }> };\n    expect(payload.cartId).toBe(cartId);\n    expect(payload.items).toHaveLength(1);\n  });\n\n  it('7. should update cart quantity and reflect in cart data', () => {\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, 'p1', 2);\n    cart.updateQuantity(cartId, 'p1', 5);\n    const c = cart.getCart(cartId);\n    expect(c!.items[0].quantity).toBe(5);\n  });\n\n  // 8-9: Pricing calculation with discount codes\n  it('8. should calculate price with tax (10%)', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 2, price: 50 },\n    ]);\n    expect(result.subtotal).toBe(100);\n    expect(result.tax).toBe(10);\n    expect(result.total).toBe(110);\n  });\n\n  it('9. should apply discount code and compute correct total', () => {\n    pricing.addDiscountCode('SAVE20', 20);\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 200 }],\n      'SAVE20',\n    );\n    expect(result.subtotal).toBe(200);\n    expect(result.discount).toBe(40);\n    // After discount: 160, tax: 16, total: 176\n    expect(result.tax).toBe(16);\n    expect(result.total).toBe(176);\n  });\n\n  // 10-12: Order creation and status transitions\n  it('10. should create an order with PENDING status', () => {\n    const orderId = orders.createOrder('user1', 'cart1', 150);\n    const order = orders.getOrder(orderId);\n    expect(order!.status).toBe(OrderStatus.PENDING);\n    expect(order!.total).toBe(150);\n  });\n\n  it('11. should transition order through status states', () => {\n    const orderId = orders.createOrder('user1', 'cart1', 150);\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.SHIPPED);\n\n    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.DELIVERED);\n  });\n\n  it('12. should emit order:status_changed events with correct previous status', () => {\n    const orderId = orders.createOrder('user1', 'cart1', 150);\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n\n    const log = bus.getLog();\n    const statusEvents = log.filter(e => e.event === Events.ORDER_STATUS_CHANGED);\n    expect(statusEvents).toHaveLength(2);\n\n    const first = statusEvents[0].payload as { previousStatus: string; status: string };\n    expect(first.previousStatus).toBe(OrderStatus.PENDING);\n    expect(first.status).toBe(OrderStatus.CONFIRMED);\n\n    const second = statusEvents[1].payload as { previousStatus: string; status: string };\n    expect(second.previousStatus).toBe(OrderStatus.CONFIRMED);\n    expect(second.status).toBe(OrderStatus.SHIPPED);\n  });\n\n  // 13-14: Payment processing (success and failure)\n  it('13. should process payment successfully and emit event', async () => {\n    const result = await payment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeDefined();\n\n    const log = bus.getLog();\n    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n    expect(payEvents).toHaveLength(1);\n  });\n\n  it('14. should handle payment failure and emit failure event', async () => {\n    const failPayment = createPaymentService(bus, { simulateFailure: true });\n    const result = await failPayment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n\n    const log = bus.getLog();\n    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n    const failEvent = payEvents.find(e => (e.payload as { status: string }).status === PaymentStatus.FAILED);\n    expect(failEvent).toBeDefined();\n  });\n\n  // 15-16: Notifications generated for order events\n  it('15. should send notification on order status change', async () => {\n    notifications.subscribe('user1');\n    const orderId = orders.createOrder('user1', 'cart1', 100);\n\n    // Wait for event propagation\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n\n    // Give async handlers a tick to resolve\n    await new Promise(resolve => setTimeout(resolve, 10));\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs.length).toBeGreaterThanOrEqual(1);\n    expect(notifs.some(n => n.type === 'order_status')).toBe(true);\n  });\n\n  it('16. should send notification on payment processed', async () => {\n    notifications.subscribe('user1');\n    const orderId = orders.createOrder('user1', 'cart1', 100);\n\n    await payment.processPayment(orderId, 100);\n\n    await new Promise(resolve => setTimeout(resolve, 10));\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs.some(n => n.type === 'payment')).toBe(true);\n  });\n\n  // 17-18: Analytics tracking events and computing metrics\n  it('17. should track event counts through the bus', async () => {\n    catalog.createProduct('Widget', 10, 'gadgets');\n    catalog.createProduct('Gizmo', 20, 'gadgets');\n\n    // Wait for async propagation\n    await new Promise(resolve => setTimeout(resolve, 10));\n\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n  });\n\n  it('18. should track revenue from successful payments', async () => {\n    const orderId = orders.createOrder('user1', 'cart1', 250);\n    await payment.processPayment(orderId, 250);\n\n    expect(analytics.getRevenue()).toBe(250);\n  });\n\n  // 19: Full checkout flow\n  it('19. should complete full checkout flow end-to-end', async () => {\n    // Subscribe for notifications\n    notifications.subscribe('user1');\n\n    // Create product\n    const productId = catalog.createProduct('Premium Widget', 49.99, 'gadgets');\n    expect(catalog.getProduct(productId)).not.toBeNull();\n\n    // Set stock\n    inventory.setStock(productId, 100);\n    expect(inventory.getStock(productId)).toBe(100);\n\n    // Add to cart\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, productId, 2);\n    const cartData = cart.getCart(cartId);\n    expect(cartData!.items).toHaveLength(1);\n\n    // Calculate price\n    const priceResult = pricing.calculateTotal([\n      { productId, quantity: 2, price: 49.99 },\n    ]);\n    expect(priceResult.subtotal).toBe(99.98);\n    expect(priceResult.total).toBeGreaterThan(0);\n\n    // Reserve inventory\n    const reserved = inventory.reserve(productId, 2);\n    expect(reserved).toBe(true);\n    expect(inventory.getStock(productId)).toBe(98);\n\n    // Create order\n    const orderId = orders.createOrder('user1', cartId, priceResult.total);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.PENDING);\n\n    // Process payment\n    const payResult = await payment.processPayment(orderId, priceResult.total);\n    expect(payResult.status).toBe(PaymentStatus.SUCCESS);\n\n    // Update order status\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n\n    // Wait for async event propagation\n    await new Promise(resolve => setTimeout(resolve, 50));\n\n    // Verify notifications were sent\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs.length).toBeGreaterThanOrEqual(1);\n\n    // Verify analytics tracked the events\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBeGreaterThanOrEqual(1);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBeGreaterThanOrEqual(1);\n    expect(analytics.getRevenue()).toBe(priceResult.total);\n\n    // Verify bus log has all expected events\n    const log = bus.getLog();\n    const eventTypes = new Set(log.map(e => e.event));\n    expect(eventTypes.has(Events.PRODUCT_CREATED)).toBe(true);\n    expect(eventTypes.has(Events.INVENTORY_UPDATED)).toBe(true);\n    expect(eventTypes.has(Events.CART_UPDATED)).toBe(true);\n    expect(eventTypes.has(Events.ORDER_CREATED)).toBe(true);\n    expect(eventTypes.has(Events.PAYMENT_PROCESSED)).toBe(true);\n    expect(eventTypes.has(Events.ORDER_STATUS_CHANGED)).toBe(true);\n  });\n\n  // 20: Low stock alert\n  it('20. should trigger low stock alert when stock drops below threshold', () => {\n    inventory.setStock('p1', 20);\n    inventory.setLowStockThreshold('p1', 5);\n\n    // Reserve stock to trigger low stock\n    inventory.reserve('p1', 16); // stock drops to 4, below threshold of 5\n\n    const log = bus.getLog();\n    const alerts = log.filter(e => e.event === Events.LOW_STOCK_ALERT);\n    expect(alerts.length).toBeGreaterThanOrEqual(1);\n    const payload = alerts[alerts.length - 1].payload as { productId: string; currentQuantity: number; threshold: number };\n    expect(payload.productId).toBe('p1');\n    expect(payload.currentQuantity).toBe(4);\n    expect(payload.threshold).toBe(5);\n  });\n\n  // 21: Import graph validation\n  it('21. should not have cross-service imports', () => {\n    const serviceNames = ['catalog', 'inventory', 'cart', 'pricing', 'orders', 'payment', 'notifications', 'analytics'];\n    const violations: string[] = [];\n\n    for (const service of serviceNames) {\n      const serviceDir = resolve(srcDir, service);\n      let files: string[];\n      try {\n        files = readdirSync(serviceDir).filter(f => f.endsWith('.ts'));\n      } catch {\n        continue;\n      }\n\n      for (const file of files) {\n        const content = readFileSync(resolve(serviceDir, file), 'utf-8');\n        for (const otherService of serviceNames) {\n          if (otherService === service) continue;\n          // Check for imports from other service directories\n          const importPattern = new RegExp(`from\\\\s+['\"].*/${otherService}/`, 'g');\n          if (importPattern.test(content)) {\n            violations.push(`${service}/${file} imports from ${otherService}`);\n          }\n        }\n      }\n    }\n\n    expect(violations).toHaveLength(0);\n  });\n\n  // 22: Checksum validation\n  it('22. should have unmodified bus.ts and types.ts', () => {\n    const busHash = sha256(resolve(srcDir, 'bus.ts'));\n    const typesHash = sha256(resolve(srcDir, 'types.ts'));\n\n    expect(busHash).toBe('53821a7f0a41a0bbb4a0fbbf7707b11c566abbf92f525e9b64a70b28efe6a866');\n    expect(typesHash).toBe('778497bd1e702d81a70c7a8ed1c5ee18d83a8bff3da14ac70bd690977abb403f');\n  });\n});\n===== tests/inventory.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createInventoryService } from '../src/inventory/index.js';\n\ndescribe('InventoryService (unit)', () => {\n  let bus: EventBus;\n  let inventory: ReturnType<typeof createInventoryService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    inventory = createInventoryService(bus);\n  });\n\n  it('should set and get stock for a product', () => {\n    inventory.setStock('p1', 100);\n    expect(inventory.getStock('p1')).toBe(100);\n  });\n\n  it('should return 0 for unknown product stock', () => {\n    expect(inventory.getStock('unknown')).toBe(0);\n  });\n\n  it('should reserve stock when sufficient', () => {\n    inventory.setStock('p1', 10);\n    const result = inventory.reserve('p1', 3);\n    expect(result).toBe(true);\n    expect(inventory.getStock('p1')).toBe(7);\n  });\n\n  it('should fail to reserve when insufficient stock', () => {\n    inventory.setStock('p1', 2);\n    const result = inventory.reserve('p1', 5);\n    expect(result).toBe(false);\n    expect(inventory.getStock('p1')).toBe(2);\n  });\n\n  it('should release reserved stock', () => {\n    inventory.setStock('p1', 10);\n    inventory.reserve('p1', 3);\n    inventory.release('p1', 3);\n    expect(inventory.getStock('p1')).toBe(10);\n  });\n\n  it('should emit inventory updated events', () => {\n    inventory.setStock('p1', 50);\n    const log = bus.getLog();\n    expect(log.length).toBeGreaterThan(0);\n    expect(log[0].event).toBe('inventory:updated');\n  });\n});\n===== tests/notifications.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createNotificationService } from '../src/notifications/index.js';\nimport { OrderStatus, PaymentStatus } from '../src/types.js';\n\ndescribe('NotificationService (unit)', () => {\n  let bus: EventBus;\n  let notifications: ReturnType<typeof createNotificationService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    notifications = createNotificationService(bus);\n  });\n\n  it('should subscribe a user', () => {\n    notifications.subscribe('user1');\n    // No error thrown\n    expect(notifications.getNotifications('user1')).toHaveLength(0);\n  });\n\n  it('should return empty array for unsubscribed user', () => {\n    expect(notifications.getNotifications('user1')).toHaveLength(0);\n  });\n\n  it('should collect notification on order status change for subscribed user', async () => {\n    notifications.subscribe('user1');\n    // Simulate order created event to set up userId mapping\n    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    // Simulate order status change\n    await bus.emit('order:status_changed', {\n      orderId: 'o1',\n      status: OrderStatus.CONFIRMED,\n      previousStatus: OrderStatus.PENDING,\n    });\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs).toHaveLength(1);\n    expect(notifs[0].type).toBe('order_status');\n  });\n\n  it('should not notify unsubscribed users', async () => {\n    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit('order:status_changed', {\n      orderId: 'o1',\n      status: OrderStatus.CONFIRMED,\n      previousStatus: OrderStatus.PENDING,\n    });\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs).toHaveLength(0);\n  });\n\n  it('should collect notification on payment processed', async () => {\n    notifications.subscribe('user1');\n    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit('payment:processed', {\n      orderId: 'o1',\n      status: PaymentStatus.SUCCESS,\n      transactionId: 'tx1',\n    });\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs).toHaveLength(1);\n    expect(notifs[0].type).toBe('payment');\n  });\n\n  it('should accumulate multiple notifications', async () => {\n    notifications.subscribe('user1');\n    await bus.emit('order:created', { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit('order:status_changed', {\n      orderId: 'o1',\n      status: OrderStatus.CONFIRMED,\n      previousStatus: OrderStatus.PENDING,\n    });\n    await bus.emit('payment:processed', {\n      orderId: 'o1',\n      status: PaymentStatus.SUCCESS,\n      transactionId: 'tx1',\n    });\n\n    const notifs = notifications.getNotifications('user1');\n    expect(notifs).toHaveLength(2);\n  });\n});\n===== tests/orders.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createOrderService } from '../src/orders/index.js';\nimport { OrderStatus } from '../src/types.js';\n\ndescribe('OrderService (unit)', () => {\n  let bus: EventBus;\n  let orders: ReturnType<typeof createOrderService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    orders = createOrderService(bus);\n  });\n\n  it('should create an order with PENDING status', () => {\n    const id = orders.createOrder('user1', 'cart1', 99.99);\n    expect(id).toBeDefined();\n    const order = orders.getOrder(id);\n    expect(order).not.toBeNull();\n    expect(order!.status).toBe(OrderStatus.PENDING);\n    expect(order!.total).toBe(99.99);\n  });\n\n  it('should return null for non-existent order', () => {\n    expect(orders.getOrder('non-existent')).toBeNull();\n  });\n\n  it('should update order status', () => {\n    const id = orders.createOrder('user1', 'cart1', 50);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(id)!.status).toBe(OrderStatus.CONFIRMED);\n  });\n\n  it('should track status transitions via events', () => {\n    const id = orders.createOrder('user1', 'cart1', 50);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n\n    const log = bus.getLog();\n    const statusEvents = log.filter(e => e.event === 'order:status_changed');\n    expect(statusEvents).toHaveLength(1);\n    const payload = statusEvents[0].payload as { previousStatus: string; status: string };\n    expect(payload.previousStatus).toBe(OrderStatus.PENDING);\n    expect(payload.status).toBe(OrderStatus.CONFIRMED);\n  });\n\n  it('should list orders by user', () => {\n    orders.createOrder('user1', 'cart1', 50);\n    orders.createOrder('user1', 'cart2', 75);\n    orders.createOrder('user2', 'cart3', 100);\n\n    const user1Orders = orders.listOrders('user1');\n    expect(user1Orders).toHaveLength(2);\n\n    const user2Orders = orders.listOrders('user2');\n    expect(user2Orders).toHaveLength(1);\n  });\n\n  it('should emit order created event', () => {\n    orders.createOrder('user1', 'cart1', 99.99);\n    const log = bus.getLog();\n    const createEvents = log.filter(e => e.event === 'order:created');\n    expect(createEvents).toHaveLength(1);\n  });\n});\n===== tests/payment.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createPaymentService } from '../src/payment/index.js';\nimport { PaymentStatus } from '../src/types.js';\n\ndescribe('PaymentService (unit)', () => {\n  let bus: EventBus;\n\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('should process payment successfully', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeDefined();\n  });\n\n  it('should simulate payment failure', async () => {\n    const payment = createPaymentService(bus, { simulateFailure: true });\n    const result = await payment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n    expect(result.error).toBeDefined();\n  });\n\n  it('should simulate payment timeout', async () => {\n    const payment = createPaymentService(bus, { simulateTimeout: true });\n    const result = await payment.processPayment('order1', 99.99);\n    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n    expect(result.error).toBeDefined();\n  });\n\n  it('should refund a successful transaction', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 99.99);\n    const refunded = await payment.refund(result.transactionId!);\n    expect(refunded).toBe(true);\n  });\n\n  it('should fail to refund non-existent transaction', async () => {\n    const payment = createPaymentService(bus);\n    const refunded = await payment.refund('non-existent');\n    expect(refunded).toBe(false);\n  });\n\n  it('should emit payment processed event', async () => {\n    const payment = createPaymentService(bus);\n    await payment.processPayment('order1', 50);\n    const log = bus.getLog();\n    const paymentEvents = log.filter(e => e.event === 'payment:processed');\n    expect(paymentEvents).toHaveLength(1);\n  });\n});\n===== tests/pricing.test.ts =====\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createPricingService } from '../src/pricing/index.js';\n\ndescribe('PricingService (unit)', () => {\n  let bus: EventBus;\n  let pricing: ReturnType<typeof createPricingService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    pricing = createPricingService(bus);\n  });\n\n  it('should calculate subtotal correctly', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 2, price: 10 },\n      { productId: 'p2', quantity: 1, price: 20 },\n    ]);\n    expect(result.subtotal).toBe(40);\n  });\n\n  it('should apply 10% tax', () => {\n    const result = pricing.calculateTotal([\n      { productId: 'p1', quantity: 1, price: 100 },\n    ]);\n    expect(result.tax).toBe(10);\n    expect(result.total).toBe(110);\n  });\n\n  it('should apply discount codes', () => {\n    pricing.addDiscountCode('SAVE10', 10);\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 100 }],\n      'SAVE10'\n    );\n    expect(result.discount).toBe(10);\n    expect(result.subtotal).toBe(100);\n    // After discount: 90, tax: 9, total: 99\n    expect(result.tax).toBe(9);\n    expect(result.total).toBe(99);\n  });\n\n  it('should ignore invalid discount codes', () => {\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 100 }],\n      'INVALID'\n    );\n    expect(result.discount).toBe(0);\n    expect(result.total).toBe(110);\n  });\n\n  it('should handle empty items list', () => {\n    const result = pricing.calculateTotal([]);\n    expect(result.subtotal).toBe(0);\n    expect(result.discount).toBe(0);\n    expect(result.tax).toBe(0);\n    expect(result.total).toBe(0);\n  });\n\n  it('should track prices from product created events', async () => {\n    await bus.emit('product:created', { productId: 'p1', name: 'Widget', price: 25.99, category: 'gadgets' });\n    expect(pricing.getPrice('p1')).toBe(25.99);\n    expect(pricing.getPrice('unknown')).toBe(0);\n  });\n});\n","numLines":894,"startLine":1,"totalLines":894}}}
