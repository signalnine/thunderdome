+/**
+ * Shared identifier helper.
+ *
+ * This module holds no domain state and is intentionally free of any service
+ * knowledge, so depending on it does not couple services to one another.
+ */
+
+let counter = 0;
+
+/**
+ * Generates a process-unique, human-readable identifier such as `order_3_k29fj1a8`.
+ */
+export function generateId(prefix: string): string {
+  counter += 1;
+  const random = Math.random().toString(36).slice(2, 10);
+  return `${prefix}_${counter.toString(36)}_${random}`;
+}
