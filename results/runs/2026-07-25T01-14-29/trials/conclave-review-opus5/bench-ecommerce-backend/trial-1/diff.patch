@@ -0,0 +1,95 @@
+import { EventBus } from '../bus.js';
+import { emitEvent } from '../common/emit.js';
+import {
+  Events,
+  InventoryService,
+  InventoryUpdatedEvent,
+  LowStockAlertEvent,
+} from '../types.js';
+
+/**
+ * Stock ledger. Every quantity change is published as `inventory:updated`, and
+ * any product that lands at or below its configured threshold also raises
+ * `inventory:low_stock`.
+ */
+export function createInventoryService(bus: EventBus): InventoryService {
+  const stock = new Map<string, number>();
+  const thresholds = new Map<string, number>();
+
+  const assertQuantity = (quantity: number, label: string): void => {
+    if (!Number.isFinite(quantity) || quantity < 0) {
+      throw new Error(`Invalid ${label}: ${quantity}`);
+    }
+  };
+
+  const currentStock = (productId: string): number => stock.get(productId) ?? 0;
+
+  const checkLowStock = (productId: string): void => {
+    const threshold = thresholds.get(productId);
+    if (threshold === undefined) return;
+
+    const quantity = currentStock(productId);
+    if (quantity > threshold) return;
+
+    const alert: LowStockAlertEvent = {
+      productId,
+      currentQuantity: quantity,
+      threshold,
+    };
+    emitEvent(bus, Events.LOW_STOCK_ALERT, alert);
+  };
+
+  const publishStock = (productId: string): void => {
+    const quantity = currentStock(productId);
+
+    const updated: InventoryUpdatedEvent = { productId, quantity };
+    emitEvent(bus, Events.INVENTORY_UPDATED, updated);
+
+    checkLowStock(productId);
+  };
+
+  return {
+    setStock(productId: string, quantity: number): void {
+      assertQuantity(quantity, 'stock quantity');
+
+      // First registration is always announced; afterwards only real changes are.
+      const changed = !stock.has(productId) || stock.get(productId) !== quantity;
+      stock.set(productId, quantity);
+      if (changed) publishStock(productId);
+    },
+
+    getStock(productId: string): number {
+      return currentStock(productId);
+    },
+
+    reserve(productId: string, quantity: number): boolean {
+      assertQuantity(quantity, 'reserve quantity');
+
+      const available = currentStock(productId);
+      if (available < quantity) {
+        return false;
+      }
+
+      if (quantity === 0) return true;
+
+      stock.set(productId, available - quantity);
+      publishStock(productId);
+      return true;
+    },
+
+    release(productId: string, quantity: number): void {
+      assertQuantity(quantity, 'release quantity');
+      if (quantity === 0) return;
+
+      stock.set(productId, currentStock(productId) + quantity);
+      publishStock(productId);
+    },
+
+    setLowStockThreshold(productId: string, threshold: number): void {
+      assertQuantity(threshold, 'low stock threshold');
+      thresholds.set(productId, threshold);
+      // A newly configured threshold may already be breached.
+      checkLowStock(productId);
+    },
+  };
+}
