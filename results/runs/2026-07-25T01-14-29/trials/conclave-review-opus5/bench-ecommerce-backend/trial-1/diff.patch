@@ -0,0 +1,75 @@
+import { EventBus } from '../bus.js';
+import { fromCents, toCents } from '../common/money.js';
+import { Events, PricingService, ProductCreatedEvent } from '../types.js';
+
+const TAX_RATE = 0.1;
+
+/**
+ * Price calculation. Keeps a read model of product prices sourced from
+ * `product:created` events, and applies percentage discount codes before tax.
+ */
+export function createPricingService(bus: EventBus): PricingService {
+  const prices = new Map<string, number>();
+  const discountCodes = new Map<string, number>();
+
+  const normalizeCode = (code: string): string => code.trim().toUpperCase();
+
+  bus.on(Events.PRODUCT_CREATED, (payload: unknown) => {
+    const { productId, price } = payload as ProductCreatedEvent;
+    prices.set(productId, price);
+  });
+
+  return {
+    calculateTotal(
+      items: Array<{ productId: string; quantity: number; price: number }>,
+      discountCode?: string,
+    ): { subtotal: number; discount: number; tax: number; total: number } {
+      for (const item of items) {
+        if (!Number.isFinite(item.price) || item.price < 0) {
+          throw new Error(`Invalid price for ${item.productId}: ${item.price}`);
+        }
+        if (!Number.isFinite(item.quantity) || item.quantity < 0) {
+          throw new Error(`Invalid quantity for ${item.productId}: ${item.quantity}`);
+        }
+      }
+
+      // All arithmetic happens in cents; each figure is converted back once.
+      const subtotal = items.reduce(
+        (sum, item) => sum + Math.round(toCents(item.price) * item.quantity),
+        0,
+      );
+
+      const percentage =
+        discountCode === undefined ? undefined : discountCodes.get(normalizeCode(discountCode));
+      const discount = percentage === undefined ? 0 : Math.round((subtotal * percentage) / 100);
+
+      // Discounts apply to the pre-tax amount, so tax is charged on what is owed.
+      const discounted = subtotal - discount;
+      const tax = Math.round(discounted * TAX_RATE);
+
+      return {
+        subtotal: fromCents(subtotal),
+        discount: fromCents(discount),
+        tax: fromCents(tax),
+        total: fromCents(discounted + tax),
+      };
+    },
+
+    addDiscountCode(code: string, percentage: number): void {
+      if (!Number.isFinite(percentage) || percentage < 0 || percentage > 100) {
+        throw new Error(`Invalid discount percentage: ${percentage}`);
+      }
+
+      const normalized = normalizeCode(code);
+      if (normalized.length === 0) {
+        throw new Error('Discount code must not be empty');
+      }
+
+      discountCodes.set(normalized, percentage);
+    },
+
+    getPrice(productId: string): number {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
