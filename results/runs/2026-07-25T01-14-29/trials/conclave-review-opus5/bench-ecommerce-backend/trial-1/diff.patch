@@ -0,0 +1,17 @@
+/**
+ * Currency helpers.
+ *
+ * Monetary arithmetic is done in integer cents so repeated additions and
+ * percentage splits cannot accumulate binary floating point error, and so
+ * derived figures (subtotal - discount + tax === total) agree exactly.
+ *
+ * Inputs are expected to be currency amounts with at most cent precision;
+ * for those, `amount * 100` is always within half a cent of its integer value.
+ */
+export function toCents(amount: number): number {
+  return Math.round(amount * 100);
+}
+
+export function fromCents(cents: number): number {
+  return cents / 100;
+}
