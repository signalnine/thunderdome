);\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 't1' });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 't1' });\n    expect(analytics.getRevenue()).toBe(100);\n  });\n\n  it('HIGH2b: duplicate order:created does not double count leaderboard/conversion', async () => {\n    const bus = new EventBus();\n    const analytics = createAnalyticsService(bus);\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [{ productId: 'p1', quantity: 2 }] });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 10 });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 10 });\n    expect(analytics.getTopProducts(5)).toEqual([{ productId: 'p1', count: 2 }]);\n    expect(analytics.getConversionRate()).toBe(1);\n    expect(analytics.getRevenue()).toBe(0);\n  });\n\n  it('MED1: throwing subscriber does not reject processPayment', async () => {\n    const bus = new EventBus();\n    const payment = createPaymentService(bus);\n    bus.on(Events.PAYMENT_PROCESSED, () => {\n      throw new Error('subscriber boom');\n    });\n    const result = await payment.processPayment('o1', 50);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n  });\n\n  it('MED2: money invariant holds for awkward values', () => {\n    const bus = new EventBus();\n    const pricing = createPricingService(bus);\n    pricing.addDiscountCode('ODD', 33.333);\n    for (const [price, qty] of [[0.07, 3], [19.99, 7], [1.05, 13], [999.99, 2]] as const) {\n      for (const code of [undefined, 'ODD']) {\n        const r = pricing.calculateTotal([{ productId: 'p', quantity: qty, price }], code);\n        expect(Math.round((r.subtotal - r.discount + r.tax) * 100)).toBe(Math.round(r.total * 100));\n        expect(r.subtotal).toBe(Math.round(price * 100 * qty) / 100);\n      }\n    }\n  });\n\n  it('MED3: pricing rejects negative inputs', () => {\n    const pricing = createPricingService(new EventBus());\n    expect(() => pricing.calculateTotal([{ productId: 'p', quantity: -1, price: 10 }])).toThrow();\n    expect(() => pricing.calculateTotal([{ productId: 'p', quantity: 1, price: -10 }])).toThrow();\n  });\n\n  it('MED4: analytics event data is decoupled from publisher payload', async () => {\n    const bus = new EventBus();\n    createAnalyticsService(bus);\n    const payload = { productId: 'p1', name: 'W', price: 10, category: 'c' };\n    await bus.emit(Events.PRODUCT_CREATED, payload);\n    payload.price = 999;\n    const logged = bus.getLog().find(e => e.event === Events.ANALYTICS_EVENT);\n    expect((logged!.payload as { data: { price: number } }).data.price).toBe(10);\n  });\n\n  it('MED5: ordered carts count in the conversion denominator', () => {\n    const bus = new EventBus();\n    const cart = createCartService(bus);\n    const orders = createOrderService(bus);\n    const analytics = createAnalyticsService(bus);\n\n    const c1 = cart.createCart('u1');\n    const c2 = cart.createCart('u2');\n    cart.addItem(c1, 'p1', 1);\n    cart.addItem(c2, 'p2', 1);\n    orders.createOrder('u1', c1, 10);\n    expect(analytics.getConversionRate()).toBe(0.5);\n  });\n\n  it('LOW: inventory skips no-op emissions but announces registration', () => {\n    const bus = new EventBus();\n    const inv = createInventoryService(bus);\n    inv.setStock('p1', 0);\n    inv.setStock('p1', 5);\n    inv.setStock('p1', 5);\n    expect(inv.reserve('p1', 0)).toBe(true);\n    const updates = bus.getLog().filter(e => e.event === Events.INVENTORY_UPDATED);\n    expect(updates).toHaveLength(2);\n    expect(inv.getStock('p1')).toBe(5);\n  });\n\n  it('notifications: repeat subscribe keeps history, unsubscribed stays empty', async () => {\n    const bus = new EventBus();\n    const notifications = createNotificationService(bus);\n    notifications.subscribe('u1');\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 5 });\n    await bus.emit(Events.ORDER_STATUS_CHANGED, { orderId: 'o1', status: OrderStatus.CONFIRMED, previousStatus: OrderStatus.PENDING });\n    notifications.subscribe('u1');\n    expect(notifications.getNotifications('u1')).toHaveLength(1);\n    expect(notifications.getNotifications('nobody')).toHaveLength(0);\n  });\n\n  it('notifications: pending buffer is bounded', async () => {\n    const bus = new EventBus();\n    const notifications = createNotificationService(bus);\n    notifications.subscribe('u1');\n    for (let i = 0; i < 500; i++) {\n      await bus.emit(Events.PAYMENT_PROCESSED, { orderId: `ghost${i}`, status: PaymentStatus.FAILED, error: 'x' });\n    }\n    // The oldest ghosts were evicted; a recent one still flushes on introduction.\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'ghost499', userId: 'u1', cartId: 'c', total: 1 });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'ghost0', userId: 'u1', cartId: 'c', total: 1 });\n    expect(notifications.getNotifications('u1')).toHaveLength(1);\n  });\n\n  it('orders: illegal transitions rejected', () => {\n    const orders = createOrderService(new EventBus());\n    const id = orders.createOrder('u1', 'c1', 10);\n    expect(() => orders.updateStatus(id, OrderStatus.DELIVERED)).toThrow();\n    expect(() => orders.updateStatus(id, OrderStatus.PENDING)).toThrow();\n    orders.updateStatus(id, OrderStatus.CANCELLED);\n    expect(() => orders.updateStatus(id, OrderStatus.CONFIRMED)).toThrow();\n    expect(() => orders.updateStatus('nope', OrderStatus.CONFIRMED)).toThrow();\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":591,"cache_read_input_tokens":93067,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemera