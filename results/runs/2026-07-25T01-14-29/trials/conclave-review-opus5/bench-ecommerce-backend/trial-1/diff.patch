@@ -0,0 +1,107 @@
+import { EventBus } from '../bus.js';
+import { emitEventAwaited } from '../common/emit.js';
+import { generateId } from '../common/id.js';
+import { Events, PaymentProcessedEvent, PaymentService, PaymentStatus } from '../types.js';
+
+export interface PaymentServiceOptions {
+  /** Every charge is declined instead of authorised. */
+  simulateFailure?: boolean;
+  /** Every charge stalls and resolves as a gateway timeout. */
+  simulateTimeout?: boolean;
+  /** Artificial latency of a normal authorisation, in milliseconds. */
+  processingDelayMs?: number;
+  /** How long a stalled charge waits before giving up, in milliseconds. */
+  timeoutMs?: number;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  refunded: boolean;
+}
+
+type PaymentResult = { status: PaymentStatus; transactionId?: string; error?: string };
+
+function delay(ms: number): Promise<void> {
+  if (ms <= 0) return Promise.resolve();
+  return new Promise<void>(resolve => {
+    setTimeout(resolve, ms);
+  });
+}
+
+/**
+ * Payment gateway adapter. The outcome of a charge is driven by the options so
+ * failure and timeout paths are exercisable without a real gateway. The
+ * `payment:processed` event is awaited before the caller gets its result, so
+ * subscribers have already observed the outcome once the promise settles.
+ */
+export function createPaymentService(
+  bus: EventBus,
+  options: PaymentServiceOptions = {},
+): PaymentService {
+  const {
+    simulateFailure = false,
+    simulateTimeout = false,
+    processingDelayMs = 0,
+    timeoutMs = 10,
+  } = options;
+
+  const transactions = new Map<string, Transaction>();
+
+  const publish = async (orderId: string, result: PaymentResult): Promise<PaymentResult> => {
+    const event: PaymentProcessedEvent = {
+      orderId,
+      status: result.status,
+      ...(result.transactionId !== undefined ? { transactionId: result.transactionId } : {}),
+      ...(result.error !== undefined ? { error: result.error } : {}),
+    };
+    await emitEventAwaited(bus, Events.PAYMENT_PROCESSED, event);
+    return result;
+  };
+
+  return {
+    async processPayment(orderId: string, amount: number): Promise<PaymentResult> {
+      // A charge the gateway would never accept is a domain failure, not an
+      // exception: callers handle it on the same path as a declined card.
+      if (!Number.isFinite(amount) || amount <= 0) {
+        return publish(orderId, {
+          status: PaymentStatus.FAILED,
+          error: `Invalid payment amount: ${amount}`,
+        });
+      }
+
+      if (simulateTimeout) {
+        await delay(timeoutMs);
+        return publish(orderId, {
+          status: PaymentStatus.TIMEOUT,
+          error: `Payment gateway timed out after ${timeoutMs}ms`,
+        });
+      }
+
+      await delay(processingDelayMs);
+
+      if (simulateFailure) {
+        return publish(orderId, {
+          status: PaymentStatus.FAILED,
+          error: 'Payment was declined by the gateway',
+        });
+      }
+
+      const transactionId = generateId('txn');
+      transactions.set(transactionId, { transactionId, orderId, amount, refunded: false });
+
+      return publish(orderId, { status: PaymentStatus.SUCCESS, transactionId });
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const transaction = transactions.get(transactionId);
+      if (!transaction || transaction.refunded) {
+        return false;
+      }
+
+      transaction.refunded = true;
+      return true;
+    },
+  };
+}
