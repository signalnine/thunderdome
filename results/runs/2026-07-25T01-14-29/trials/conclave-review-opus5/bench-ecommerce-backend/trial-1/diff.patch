@@ -0,0 +1,109 @@
+import { EventBus } from '../bus.js';
+import { emitEvent } from '../common/emit.js';
+import { generateId } from '../common/id.js';
+import { CartService, CartUpdatedEvent, Events } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+/**
+ * Shopping carts. Every mutation that actually changes the cart publishes a
+ * `cart:updated` event carrying the full item list, which is what analytics
+ * uses to attribute products to an order later on.
+ */
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  const requireCart = (cartId: string): Cart => {
+    const cart = carts.get(cartId);
+    if (!cart) {
+      throw new Error(`Unknown cart: ${cartId}`);
+    }
+    return cart;
+  };
+
+  const publishUpdate = (cart: Cart): void => {
+    const event: CartUpdatedEvent = {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map(item => ({ ...item })),
+    };
+    emitEvent(bus, Events.CART_UPDATED, event);
+  };
+
+  return {
+    createCart(userId: string): string {
+      const id = generateId('cart');
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      if (!Number.isFinite(quantity) || quantity <= 0) {
+        throw new Error(`Invalid quantity: ${quantity}`);
+      }
+
+      const cart = requireCart(cartId);
+      const existing = cart.items.find(item => item.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+
+      publishUpdate(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = requireCart(cartId);
+      const index = cart.items.findIndex(item => item.productId === productId);
+      if (index === -1) return;
+
+      cart.items.splice(index, 1);
+      publishUpdate(cart);
+    },
+
+    getCart(cartId: string): Cart | null {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return { ...cart, items: cart.items.map(item => ({ ...item })) };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = requireCart(cartId);
+      if (cart.items.length === 0) return;
+
+      cart.items = [];
+      publishUpdate(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      if (!Number.isFinite(quantity) || quantity < 0) {
+        throw new Error(`Invalid quantity: ${quantity}`);
+      }
+
+      const cart = requireCart(cartId);
+      const index = cart.items.findIndex(item => item.productId === productId);
+      if (index === -1) {
+        throw new Error(`Product ${productId} is not in cart ${cartId}`);
+      }
+
+      // A quantity of zero is the conventional way to drop a line item.
+      if (quantity === 0) {
+        cart.items.splice(index, 1);
+      } else {
+        cart.items[index].quantity = quantity;
+      }
+
+      publishUpdate(cart);
+    },
+  };
+}
