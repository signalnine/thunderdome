+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HQ4bkMnVLXFefwCAGwmqPp","type":"tool_result","content":"=====FILE: src/common/emit.ts=====\n     1\timport { EventBus } from '../bus.js';\n     2\t\n     3\t/**\n     4\t * Publishes an event from a synchronous code path.\n     5\t *\n     6\t * `EventBus.emit` records the event and invokes the first handler synchronously,\n     7\t * so callers that emit before returning are still observable in `bus.getLog()`\n     8\t * immediately. Handlers that reject would otherwise surface as an unhandled\n     9\t * rejection, so failures are isolated here: one misbehaving subscriber must not\n    10\t * break the publisher.\n    11\t */\n    12\texport function emitEvent(bus: EventBus, event: string, payload: unknown): void {\n    13\t  void bus.emit(event, payload).catch((error: unknown) => {\n    14\t    console.error(`[bus] handler failed while processing \"${event}\":`, error);\n    15\t  });\n    16\t}\n=====FILE: src/common/id.ts=====\n     1\t/**\n     2\t * Shared identifier helper.\n     3\t *\n     4\t * This module holds no domain state and is intentionally free of any service\n     5\t * knowledge, so depending on it does not couple services to one another.\n     6\t */\n     7\t\n     8\tlet counter = 0;\n     9\t\n    10\t/**\n    11\t * Generates a process-unique, human-readable identifier such as `order_3_k29fj1a8`.\n    12\t */\n    13\texport function generateId(prefix: string): string {\n    14\t  counter += 1;\n    15\t  const random = Math.random().toString(36).slice(2, 10);\n    16\t  return `${prefix}_${counter.toString(36)}_${random}`;\n    17\t}\n=====FILE: src/catalog/index.ts=====\n     1\timport { EventBus } from '../bus.js';\n     2\timport { emitEvent } from '../common/emit.js';\n     3\timport { generateId } from '../common/id.js';\n     4\timport { CatalogService, Events, ProductCreatedEvent } from '../types.js';\n     5\t\n     6\tinterface Product {\n     7\t  id: string;\n     8\t  name: string;\n     9\t  price: number;\n    10\t  category: string;\n    11\t}\n    12\t\n    13\t/**\n    14\t * Product catalog. Owns the canonical product record and announces new\n    15\t * products on the bus so downstream services (pricing, analytics) can react.\n    16\t */\n    17\texport function createCatalogService(bus: EventBus): CatalogService {\n    18\t  const products = new Map<string, Product>();\n    19\t\n    20\t  const snapshot = (product: Product): Product => ({ ...product });\n    21\t\n    22\t  return {\n    23\t    createProduct(name: string, price: number, category: string): string {\n    24\t      if (!Number.isFinite(price) || price < 0) {\n    25\t        throw new Error(`Invalid product price: ${price}`);\n    26\t      }\n    27\t\n    28\t      const id = generateId('prod');\n    29\t      products.set(id, { id, name, price, category });\n    30\t\n    31\t      const event: ProductCreatedEvent = { productId: id, name, price, category };\n    32\t      emitEvent(bus, Events.PRODUCT_CREATED, event);\n    33\t\n    34\t      return id;\n    35\t    },\n    36\t\n    37\t    getProduct(productId: string): Product | null {\n    38\t      const product = products.get(productId);\n    39\t      return product ? snapshot(product) : null;\n    40\t    },\n    41\t\n    42\t    listProducts(category?: string): Product[] {\n    43\t      const all = [...products.values()];\n    44\t      const filtered = category === undefined ? all : all.filter(p => p.category === category);\n    45\t      return filtered.map(snapshot);\n    46\t    },\n    47\t\n    48\t    searchProducts(query: string): Product[] {\n    49\t      const needle = query.trim().toLowerCase();\n    50\t      return [...products.values()]\n    51\t        .filter(\n    52\t          p =>\n    53\t            p.name.toLowerCase().includes(needle) ||\n    54\t            p.category.toLowerCase().includes(needle),\n    55\t        )\n    56\t        .map(snapshot);\n    57\t    },\n    58\t\n    59\t    updateProduct(\n    60\t      productId: string,\n    61\t      updates: Partial<{ name: string; price: number; category: string }>,\n    62\t    ): void {\n    63\t      const product = products.get(productId);\n    64\t      if (!product) {\n    65\t        throw new Error(`Unknown product: ${productId}`);\n    66\t      }\n    67\t\n    68\t      if (updates.price !== undefined && (!Number.isFinite(updates.price) || updates.price < 0)) {\n    69\t        throw new Error(`Invalid product price: ${updates.price}`);\n    70\t      }\n    71\t\n    72\t      if (updates.name !== undefined) product.name = updates.name;\n    73\t      if (updates.price !== undefined) product.price = updates.price;\n    74\t      if (updates.category !== undefined) product.category = updates.category;\n    75\t    },\n    76\t\n    77\t    removeProduct(productId: string): boolean {\n    78\t      return products.delete(productId);\n    79\t    },\n    80\t  };\n    81\t}\n=====FILE: src/inventory/index.ts=====\n     1\timport { EventBus } from '../bus.js';\n     2\timport { emitEvent } from '../common/emit.js';\n     3\timport {\n     4\t  Events,\n     5\t  InventoryService,\n     6\t  InventoryUpdatedEvent,\n     7\t  LowStockAlertEvent,\n     8\t} from '../types.js';\n     9\t\n    10\t/**\n    11\t * Stock ledger. Every quantity change is published as `inventory:updated`, and\n    12\t * any product that lands at or below its configured threshold also raises\n    13\t * `inventory:low_stock`.\n    14\t */\n    15\texport function createInventoryService(bus: EventBus): InventoryService {\n    16\t  const stock = new Map<string, number>();\n    17\t  const thresholds = new Map<string, number>();\n    18\t\n    19\t  const assertQuantity = (quantity: number, label: string): void => {\n    20\t    if (!Number.isFinite(quantity) || quantity < 0) {\n    21\t      throw new Error(`Invalid ${label}: ${quantity}`);\n    22\t    }\n    23\t  };\n    24\t\n    25\t  const currentStock = (productId: string): number => stock.get(productId) ?? 0;\n    26\t\n    27\t  const checkLowStock = (productId: string): void => {\n    28\t    const threshold = thresholds.get(productId);\n    29\t    if (threshold === undefined) return;\n    30\t\n    31\t    const quantity = currentStock(productId);\n    32\t    if (quantity > threshold) return;\n    33\t\n    34\t    const alert: LowStockAlertEvent = {\n    35\t      productId,\n    36\t      currentQuantity: quantity,\n    37\t      threshold,\n    38\t    };\n    39\t    emitEvent(bus, Events.LOW_STOCK_ALERT, alert);\n    40\t  };\n    41\t\n    42\t  const publishStock = (productId: string): void => {\n    43\t    const quantity = currentStock(productId);\n    44\t\n    45\t    const updated: InventoryUpdatedEvent = { productId, quantity };\n    46\t    emitEvent(bus, Events.INVENTORY_UPDATED, updated);\n    47\t\n    48\t    checkLowStock(productId);\n    49\t  };\n    50\t\n    51\t  return {\n    52\t    setStock(productId: string, quantity: number): void {\n    53\t      assertQuantity(quantity, 'stock quantity');\n    54\t      stock.set(productId, quantity);\n    55\t      publishStock(productId);\n    56\t    },\n    57\t\n    58\t    getStock(productId: string): number {\n    59\t      return currentStock(productId);\n    60\t    },\n    61\t\n    62\t    reserve(productId: string, quantity: number): boolean {\n    63\t      assertQuantity(quantity, 'reserve quantity');\n    64\t\n    65\t      const available = currentStock(productId);\n    66\t      if (available < quantity) {\n    67\t        return false;\n    68\t      }\n    69\t\n    70\t      stock.set(productId, available - quantity);\n    71\t      publishStock(productId);\n    72\t      return true;\n    73\t    },\n    74\t\n    75\t    release(productId: string, quantity: number): void {\n    76\t      assertQuantity(quantity, 'release quantity');\n    77\t      if (quantity === 0) return;\n    78\t\n    79\t      stock.set(productId, currentStock(productId) + quantity);\n    80\t      publishStock(productId);\n    81\t    },\n    82\t\n    83\t    setLowStockThreshold(productId: string, threshold: number): void {\n    84\t      assertQuantity(threshold, 'low stock threshold');\n    85\t      thresholds.set(productId, threshold);\n    86\t      // A newly configured threshold may already be breached.\n    87\t      checkLowStock(productId);\n    88\t    },\n    89\t  };\n    90\t}\n=====FILE: src/cart/index.ts=====\n     1\timport { EventBus } from '../bus.js';\n     2\timport { emitEvent } from '../common/emit.js';\n     3\timport { generateId } from '../common/id.js';\n     4\timport { CartService, CartUpdatedEvent, Events } from '../types.js';\n     5\t\n     6\tinterface CartItem {\n     7\t  productId: string;\n     8\t  quantity: number;\n     9\t}\n    10\t\n    11\tinterface Cart {\n    12\t  id: string;\n    13\t  userId: string;\n    14\t  items: CartItem[];\n    15\t}\n    16\t\n    17\t/**\n    18\t * Shopping carts. Every mutation that actually changes the cart publishes a\n    19\t * `cart:updated` event carrying the full item list, which is what analytics\n    20\t * uses to attribute products to an order later on.\n    21\t */\n    22\texport function createCartService(bus: EventBus): CartService {\n    23\t  const carts = new Map<string, Cart>();\n    24\t\n    25\t  const requireCart = (cartId: string): Cart => {\n    26\t    const cart = carts.get(cartId);\n    27\t    if (!cart) {\n    28\t      throw new Error(`Unknown cart: ${cartId}`);\n    29\t    }\n    30\t    return cart;\n    31\t  };\n    32\t\n    33\t  const publishUpdate = (cart: Cart): void => {\n    34\t    const event: CartUpdatedEvent = {\n    35\t      cartId: cart.id,\n    36\t      userId: cart.userId,\n    37\t      items: cart.items.map(item => ({ ...item })),\n    38\t    };\n    39\t    emitEvent(bus, Events.CART_UPDATED, event);\n    40\t  };\n    41\t\n    42\t  return {\n    43\t    createCart(userId: string): string {\n    44\t      const id = generateId('cart');\n    45\t      carts.set(id, { id, userId, items: [] });\n    46\t      return id;\n    47\t    },\n    48\t\n    49\t    addItem(cartId: string, productId: string, quantity: number): void {\n    50\t      if (!Number.isFinite(quantity) || quantity <= 0) {\n    51\t        throw new Error(`Invalid quantity: ${quantity}`);\n    52\t      }\n    53\t\n    54\t      const cart = requireCart(cartId);\n    55\t      const existing = cart.items.find(item => item.productId === productId);\n    56\t      if (existing) {\n    57\t        existing.quantity += quantity;\n    58\t      } else {\n    59\t        cart.items.push({ productId, quantity });\n    60\t      }\n    61\t\n    62\t      publishUpdate(cart);\n    63\t    },\n    64\t\n    65\t    removeItem(cartId: string, productId: string): void {\n    66\t      const cart = requireCart(cartId);\n    67\t      const index = cart.items.findIndex(item => item.productId === productId);\n    68\t      if (index === -1) return;\n    69\t\n    70\t      cart.items.splice(index, 1);\n    71\t      publishUpdate(cart);\n    72\t    },\n    73\t\n    74\t    getCart(cartId: string): Cart | null {\n    75\t      const cart = carts.get(cartId);\n    76\t      if (!cart) return null;\n    77\t      return { ...cart, items: cart.items.map(item => ({ ...item })) };\n    78\t    },\n    79\t\n    80\t    clearCart(cartId: string): void {\n    81\t      const cart = requireCart(cartId);\n    82\t      if (cart.items.length === 0) return;\n    83\t\n    84\t      cart.items = [];\n    85\t      publishUpdate(cart);\n    86\t    },\n    87\t\n    88\t    updateQuantity(cartId: string, productId: string, quantity: number): void {\n    89\t      if (!Number.isFinite(quantity) || quantity < 0) {\n    90\t        throw new Error(`Invalid quantity: ${quantity}`);\n    91\t      }\n    92\t\n    93\t      const cart = requireCart(cartId);\n    94\t      const index = cart.items.findIndex(item => item.productId === productId);\n    95\t      if (index === -1) {\n    96\t        throw new Error(`Product ${productId} is not in cart ${cartId}`);\n    97\t      }\n    98\t\n    99\t      // A quantity of zero is the conventional way to drop a line item.\n   100\t      if (quantity === 0) {\n   101\t        cart.items.splice(index, 1);\n   102\t      } else {\n   103\t        cart.items[index].quantity = quantity;\n   104\t      }\n   105\t\n   106\t      publishUpdate(cart);\n   107\t    },\n   108\t  };\n   109\t}\n=====FILE: src/pricing/index.ts=====\n     1\timport { EventBus } from '../bus.js';\n     2\timport { Events, PricingService, ProductCreatedEvent } from '../types.js';\n     3\t\n     4\tconst TAX_RATE = 0.1;\n     5\t\n     6\t/** Money is rounded to cents at every step so totals never leak float noise. */\n     7\tfunction round(amount: number): number {\n     8\t  return Math.round((amount + Number.EPSILON) * 100) / 100;\n     9\t}\n    10\t\n    11\t/**\n    12\t * Price calculation. Keeps a read model of product prices sourced from\n    13\t * `product:created` events, and applies percentage discount codes before tax.\n    14\t */\n    15\texport function createPricingService(bus: EventBus): PricingService {\n    16\t  const prices = new Map<string, number>();\n    17\t  const discountCodes = new Map<string, number>();\n    18\t\n    19\t  const normalizeCode = (code: string): string => code.trim().toUpperCase();\n    20\t\n    21\t  bus.on(Events.PRODUCT_CREATED, (payload: unknown) => {\n    22\t    const { productId, price } = payload as ProductCreatedEvent;\n    23\t    prices.set(productId, price);\n    24\t  });\n    25\t\n    26\t  return {\n    27\t    calculateTotal(\n    28\t      items: Array<{ productId: string; quantity: number; price: number }>,\n    29\t      discountCode?: string,\n    30\t    ): { subtotal: number; discount: number; tax: number; total: number } {\n    31\t      const subtotal = round(\n    32\t        items.reduce((sum, item) => sum + item.price * item.quantity, 0),\n    33\t      );\n    34\t\n    35\t      const percentage =\n    36\t        discountCode === undefined ? undefined : discountCodes.get(normalizeCode(discountCode));\n    37\t      const discount = percentage === undefined ? 0 : round((subtotal * percentage) / 100);\n    38\t\n    39\t      const discounted = round(subtotal - discount);\n    40\t      const tax = round(discounted * TAX_RATE);\n    41\t      const total = round(discounted + tax);\n    42\t\n    43\t      return { subtotal, discount, tax, total };\n    44\t    },\n    45\t\n    46\t    addDiscountCode(code: string, percentage: number): void {\n    47\t      if (!Number.isFinite(percentage) || percentage < 0 || percentage > 100) {\n    48\t        throw new Error(`Invalid discount percentage: ${percentage}`);\n    49\t      }\n    50\t\n    51\t      const normalized = normalizeCode(code);\n    52\t      if (normalized.length === 0) {\n    53\t        throw new Error('Discount code must not be empty');\n    54\t      }\n    55\t\n    56\t      discountCodes.set(normalized, percentage);\n    57\t    },\n    58\t\n    59\t    getPrice(productId: string): number {\n    60\t      return prices.get(productId) ?? 0;\n    61\t    },\n    62\t  };\n    63\t}","is_error":false}]},"parent_tool_use_id":"toolu_01Tv6p1C71577bdEGQ3s8GTF","session_id":"9acea484-8931-43f9-b4f9-99a255b023a5","uuid":"9a36927e-f4f4-41d4-9649-1da1ec613899","timestamp":"2026-07-25T01:47:47.872Z","subagent_type":"conclave:code-reviewer","task_description":"Review correctness and edge cases"}
