tem.quantity) || item.quantity < 0) {\n          throw new Error(`Invalid quantity for ${item.productId}: ${item.quantity}`);\n        }\n      }\n\n      // All arithmetic happens in cents; each figure is converted back once.\n      const subtotal = items.reduce((sum, item) => sum + toCents(item.price) * item.quantity, 0);\n\n      const percentage =\n        discountCode === undefined ? undefined : discountCodes.get(normalizeCode(discountCode));\n      const discount = percentage === undefined ? 0 : Math.round((subtotal * percentage) / 100);\n\n      // Discounts apply to the pre-tax amount, so tax is charged on what is owed.\n      const discounted = subtotal - discount;\n      const tax = Math.round(discounted * TAX_RATE);\n\n      return {\n        subtotal: fromCents(subtotal),\n        discount: fromCents(discount),\n        tax: fromCents(tax),\n        total: fromCents(discounted + tax),\n      };\n    },\n\n    addDiscountCode(code: string, percentage: number): void {\n      if (!Number.isFinite(percentage) || percentage < 0 || percentage > 100) {\n        throw new Error(`Invalid discount percentage: ${percentage}`);\n      }\n\n      const normalized = normalizeCode(code);\n      if (normalized.length === 0) {\n        throw new Error('Discount code must not be empty');\n      }\n\n      discountCodes.set(normalized, percentage);\n    },\n\n    getPrice(productId: string): number {\n      return prices.get(productId) ?? 0;\n    },\n  };\n}\n","structuredPatch":[{"oldStart":34,"oldLines":7,"newStart":34,"newLines":10,"lines":["       }"," ","       // All arithmetic happens in cents; each figure is converted back once.","-      const subtotal = items.reduce((sum, item) => sum + toCents(item.price) * item.quantity, 0);","+      const subtotal = items.reduce(","+        (sum, item) => sum + Math.round(toCents(item.price) * item.quantity),","+        0,","+      );"," ","       const percentage =","         discountCode === undefined ? undefined : discountCo