+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016WvhwUqcuZuYWu7wLtNRCE","type":"tool_result","content":"     1\timport { describe, it, expect, beforeEach } from 'vitest';\n     2\timport { createHash } from 'crypto';\n     3\timport { readFileSync, readdirSync } from 'fs';\n     4\timport { resolve, dirname } from 'path';\n     5\timport { fileURLToPath } from 'url';\n     6\timport { EventBus } from '../src/bus.js';\n     7\timport { Events, OrderStatus, PaymentStatus } from '../src/types.js';\n     8\timport { createCatalogService } from '../src/catalog/index.js';\n     9\timport { createInventoryService } from '../src/inventory/index.js';\n    10\timport { createCartService } from '../src/cart/index.js';\n    11\timport { createPricingService } from '../src/pricing/index.js';\n    12\timport { createOrderService } from '../src/orders/index.js';\n    13\timport { createPaymentService } from '../src/payment/index.js';\n    14\timport { createNotificationService } from '../src/notifications/index.js';\n    15\timport { createAnalyticsService } from '../src/analytics/index.js';\n    16\t\n    17\tconst __filename = fileURLToPath(import.meta.url);\n    18\tconst __dirname = dirname(__filename);\n    19\tconst srcDir = resolve(__dirname, '..', 'src');\n    20\t\n    21\tfunction sha256(filePath: string): string {\n    22\t  const content = readFileSync(filePath, 'utf-8');\n    23\t  return createHash('sha256').update(content).digest('hex');\n    24\t}\n    25\t\n    26\tdescribe('Integration Tests', () => {\n    27\t  let bus: EventBus;\n    28\t  let catalog: ReturnType<typeof createCatalogService>;\n    29\t  let inventory: ReturnType<typeof createInventoryService>;\n    30\t  let cart: ReturnType<typeof createCartService>;\n    31\t  let pricing: ReturnType<typeof createPricingService>;\n    32\t  let orders: ReturnType<typeof createOrderService>;\n    33\t  let payment: ReturnType<typeof createPaymentService>;\n    34\t  let notifications: ReturnType<typeof createNotificationService>;\n    35\t  let analytics: ReturnType<typeof createAnalyticsService>;\n    36\t\n    37\t  beforeEach(() => {\n    38\t    bus = new EventBus();\n    39\t    catalog = createCatalogService(bus);\n    40\t    inventory = createInventoryService(bus);\n    41\t    cart = createCartService(bus);\n    42\t    pricing = createPricingService(bus);\n    43\t    orders = createOrderService(bus);\n    44\t    payment = createPaymentService(bus);\n    45\t    notifications = createNotificationService(bus);\n    46\t    analytics = createAnalyticsService(bus);\n    47\t  });\n    48\t\n    49\t  // 1-3: Product catalog CRUD through bus events\n    50\t  it('1. should create a product and emit product:created event', () => {\n    51\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    52\t    expect(id).toBeDefined();\n    53\t    const log = bus.getLog();\n    54\t    const createEvents = log.filter(e => e.event === Events.PRODUCT_CREATED);\n    55\t    expect(createEvents).toHaveLength(1);\n    56\t    const payload = createEvents[0].payload as { productId: string; name: string };\n    57\t    expect(payload.productId).toBe(id);\n    58\t    expect(payload.name).toBe('Laptop');\n    59\t  });\n    60\t\n    61\t  it('2. should update a product and retrieve updated data', () => {\n    62\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    63\t    catalog.updateProduct(id, { price: 899.99, name: 'Gaming Laptop' });\n    64\t    const product = catalog.getProduct(id);\n    65\t    expect(product!.price).toBe(899.99);\n    66\t    expect(product!.name).toBe('Gaming Laptop');\n    67\t  });\n    68\t\n    69\t  it('3. should remove a product and confirm deletion', () => {\n    70\t    const id = catalog.createProduct('Laptop', 999.99, 'electronics');\n    71\t    expect(catalog.removeProduct(id)).toBe(true);\n    72\t    expect(catalog.getProduct(id)).toBeNull();\n    73\t    expect(catalog.listProducts()).toHaveLength(0);\n    74\t  });\n    75\t\n    76\t  // 4-5: Inventory management with stock events\n    77\t  it('4. should set stock and emit inventory:updated event', () => {\n    78\t    inventory.setStock('p1', 100);\n    79\t    const log = bus.getLog();\n    80\t    const invEvents = log.filter(e => e.event === Events.INVENTORY_UPDATED);\n    81\t    expect(invEvents.length).toBeGreaterThanOrEqual(1);\n    82\t    const payload = invEvents[0].payload as { productId: string; quantity: number };\n    83\t    expect(payload.productId).toBe('p1');\n    84\t    expect(payload.quantity).toBe(100);\n    85\t  });\n    86\t\n    87\t  it('5. should reserve stock and reflect updated quantity', () => {\n    88\t    inventory.setStock('p1', 10);\n    89\t    const reserved = inventory.reserve('p1', 3);\n    90\t    expect(reserved).toBe(true);\n    91\t    expect(inventory.getStock('p1')).toBe(7);\n    92\t\n    93\t    const failedReserve = inventory.reserve('p1', 100);\n    94\t    expect(failedReserve).toBe(false);\n    95\t    expect(inventory.getStock('p1')).toBe(7);\n    96\t  });\n    97\t\n    98\t  // 6-7: Cart operations emitting cart events\n    99\t  it('6. should add items to cart and emit cart:updated event', () => {\n   100\t    const cartId = cart.createCart('user1');\n   101\t    cart.addItem(cartId, 'p1', 2);\n   102\t    const log = bus.getLog();\n   103\t    const cartEvents = log.filter(e => e.event === Events.CART_UPDATED);\n   104\t    expect(cartEvents).toHaveLength(1);\n   105\t    const payload = cartEvents[0].payload as { cartId: string; items: Array<{ productId: string; quantity: number }> };\n   106\t    expect(payload.cartId).toBe(cartId);\n   107\t    expect(payload.items).toHaveLength(1);\n   108\t  });\n   109\t\n   110\t  it('7. should update cart quantity and reflect in cart data', () => {\n   111\t    const cartId = cart.createCart('user1');\n   112\t    cart.addItem(cartId, 'p1', 2);\n   113\t    cart.updateQuantity(cartId, 'p1', 5);\n   114\t    const c = cart.getCart(cartId);\n   115\t    expect(c!.items[0].quantity).toBe(5);\n   116\t  });\n   117\t\n   118\t  // 8-9: Pricing calculation with discount codes\n   119\t  it('8. should calculate price with tax (10%)', () => {\n   120\t    const result = pricing.calculateTotal([\n   121\t      { productId: 'p1', quantity: 2, price: 50 },\n   122\t    ]);\n   123\t    expect(result.subtotal).toBe(100);\n   124\t    expect(result.tax).toBe(10);\n   125\t    expect(result.total).toBe(110);\n   126\t  });\n   127\t\n   128\t  it('9. should apply discount code and compute correct total', () => {\n   129\t    pricing.addDiscountCode('SAVE20', 20);\n   130\t    const result = pricing.calculateTotal(\n   131\t      [{ productId: 'p1', quantity: 1, price: 200 }],\n   132\t      'SAVE20',\n   133\t    );\n   134\t    expect(result.subtotal).toBe(200);\n   135\t    expect(result.discount).toBe(40);\n   136\t    // After discount: 160, tax: 16, total: 176\n   137\t    expect(result.tax).toBe(16);\n   138\t    expect(result.total).toBe(176);\n   139\t  });\n   140\t\n   141\t  // 10-12: Order creation and status transitions\n   142\t  it('10. should create an order with PENDING status', () => {\n   143\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n   144\t    const order = orders.getOrder(orderId);\n   145\t    expect(order!.status).toBe(OrderStatus.PENDING);\n   146\t    expect(order!.total).toBe(150);\n   147\t  });\n   148\t\n   149\t  it('11. should transition order through status states', () => {\n   150\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n   151\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n   152\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.CONFIRMED);\n   153\t\n   154\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n   155\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.SHIPPED);\n   156\t\n   157\t    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n   158\t    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.DELIVERED);\n   159\t  });\n   160\t\n   161\t  it('12. should emit order:status_changed events with correct previous status', () => {\n   162\t    const orderId = orders.createOrder('user1', 'cart1', 150);\n   163\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n   164\t    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n   165\t\n   166\t    const log = bus.getLog();\n   167\t    const statusEvents = log.filter(e => e.event === Events.ORDER_STATUS_CHANGED);\n   168\t    expect(statusEvents).toHaveLength(2);\n   169\t\n   170\t    const first = statusEvents[0].payload as { previousStatus: string; status: string };\n   171\t    expect(first.previousStatus).toBe(OrderStatus.PENDING);\n   172\t    expect(first.status).toBe(OrderStatus.CONFIRMED);\n   173\t\n   174\t    const second = statusEvents[1].payload as { previousStatus: string; status: string };\n   175\t    expect(second.previousStatus).toBe(OrderStatus.CONFIRMED);\n   176\t    expect(second.status).toBe(OrderStatus.SHIPPED);\n   177\t  });\n   178\t\n   179\t  // 13-14: Payment processing (success and failure)\n   180\t  it('13. should process payment successfully and emit event', async () => {\n   181\t    const result = await payment.processPayment('order1', 99.99);\n   182\t    expect(result.status).toBe(PaymentStatus.SUCCESS);\n   183\t    expect(result.transactionId).toBeDefined();\n   184\t\n   185\t    const log = bus.getLog();\n   186\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n   187\t    expect(payEvents).toHaveLength(1);\n   188\t  });\n   189\t\n   190\t  it('14. should handle payment failure and emit failure event', async () => {\n   191\t    const failPayment = createPaymentService(bus, { simulateFailure: true });\n   192\t    const result = await failPayment.processPayment('order1', 99.99);\n   193\t    expect(result.status).toBe(PaymentStatus.FAILED);\n   194\t\n   195\t    const log = bus.getLog();\n   196\t    const payEvents = log.filter(e => e.event === Events.PAYMENT_PROCESSED);\n   197\t    const failEvent = payEvents.find(e => (e.payload as { status: string }).status === PaymentStatus.FAILED);\n   198\t    expect(failEvent).toBeDefined();\n   199\t  });\n   200\t\n   201\t  // 15-16: Notifications generated for order events\n   202\t  it('15. should send notification on order status change', async () => {\n   203\t    notifications.subscribe('user1');\n   204\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n   205\t\n   206\t    // Wait for event propagation\n   207\t    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n   208\t\n   209\t    // Give async handlers a tick to resolve\n   210\t    await new Promise(resolve => setTimeout(resolve, 10));\n   211\t\n   212\t    const notifs = notifications.getNotifications('user1');\n   213\t    expect(notifs.length).toBeGreaterThanOrEqual(1);\n   214\t    expect(notifs.some(n => n.type === 'order_status')).toBe(true);\n   215\t  });\n   216\t\n   217\t  it('16. should send notification on payment processed', async () => {\n   218\t    notifications.subscribe('user1');\n   219\t    const orderId = orders.createOrder('user1', 'cart1', 100);\n   220\t\n   221\t    await payment.processPayment(orderId, 100);\n   222\t\n   223\t    await new Promise(resolve => setTimeout(resolve, 10));\n   224\t\n   225\t    const notifs = notifications.getNotifications('user1');\n   226\t    expect(notifs.some(n => n.type === 'payment')).toBe(true);\n   227\t  });\n   228\t\n   229\t  // 17-18: Analytics tracking events and computing metrics\n   230\t  it('17. should track event counts through the bus', async () => {\n   231\t    catalog.createProduct('Widget', 10, 'gadgets');\n   232\t    catalog.createProduct('Gizmo', 20, 'gadgets');\n   233\t\n   234\t    // Wait for async propagation\n   235\t    await new Promise(resolve => setTimeout(resolve, 10));\n   2