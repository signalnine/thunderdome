new file mode 100644
index 0000000..3fbfcb0
--- /dev/null
+++ b/src/common/emit.ts
@@ -0,0 +1,40 @@
+import { EventBus } from '../bus.js';
+
+function reportHandlerFailure(event: string, error: unknown): void {
+  console.error(`[bus] handler failed while processing "${event}":`, error);
+}
+
+/**
+ * Publishes an event from a synchronous code path.
+ *
+ * `EventBus.emit` records the event and invokes the first handler synchronously,
+ * so callers that emit before returning are still observable in `bus.getLog()`
+ * immediately. Handlers that reject would otherwise surface as an unhandled
+ * rejection, so failures are isolated here: one misbehaving subscriber must not
+ * break the publisher.
+ */
+export function emitEvent(bus: EventBus, event: string, payload: unknown): void {
+  void bus.emit(event, payload).catch((error: unknown) => {
+    reportHandlerFailure(event, error);
+  });
+}
+
+/**
+ * Publishes an event and waits for every subscriber to settle, so the caller
+ * can guarantee downstream state is up to date before it returns.
+ *
+ * Failures are isolated for the same reason as {@link emitEvent}: a payment that
+ * was actually captured must not be reported as an error because a notification
+ * subscriber threw.
+ */
+export async function emitEventAwaited(
+  bus: EventBus,
+  event: string,
+  payload: unknown,
+): Promise<void> {
+  try {
+    await bus.emit(event, payload);
+  } catch (error: unknown) {
+    reportHandlerFailure(event, error);
+  }
+}
