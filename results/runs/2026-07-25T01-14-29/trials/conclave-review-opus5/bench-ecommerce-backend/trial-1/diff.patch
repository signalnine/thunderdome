--- /dev/null
+++ b/src/notifications/index.ts
@@ -0,0 +1,121 @@
+import { EventBus } from '../bus.js';
+import { emitEventAwaited } from '../common/emit.js';
+import {
+  Events,
+  NotificationSentEvent,
+  NotificationService,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+interface Notification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+/**
+ * Statuses are read off an untyped bus payload, so an unrecognised value is
+ * possible and falls back to a generic phrasing.
+ */
+const PAYMENT_MESSAGES: Record<string, string> = {
+  [PaymentStatus.PENDING]: 'is being processed',
+  [PaymentStatus.SUCCESS]: 'was successful',
+  [PaymentStatus.FAILED]: 'failed',
+  [PaymentStatus.TIMEOUT]: 'timed out',
+};
+
+/** Upper bound on orders held in the pending buffer, oldest evicted first. */
+const MAX_PENDING_ORDERS = 100;
+
+/**
+ * User-facing notifications. Order and payment events only carry an order id,
+ * so the service keeps an order -> user index built from `order:created` and
+ * uses it to route later events to the right (subscribed) mailbox.
+ *
+ * The bus awaits subscribers one at a time, so `order:created` is not
+ * guaranteed to have reached this service before a status or payment event for
+ * the same order does — that depends on service construction order. Events for
+ * an order we have not been introduced to are therefore buffered and flushed
+ * once the owner is known, rather than dropped.
+ */
+export function createNotificationService(bus: EventBus): NotificationService {
+  /** Presence in this map *is* the subscription; the value is the mailbox. */
+  const mailboxes = new Map<string, Notification[]>();
+  const orderOwners = new Map<string, string>();
+  const pending = new Map<string, Array<{ type: string; message: string }>>();
+
+  const deliver = async (userId: string, type: string, message: string): Promise<void> => {
+    const mailbox = mailboxes.get(userId);
+    if (!mailbox) return; // not subscribed
+
+    mailbox.push({ type, message, timestamp: Date.now() });
+
+    const event: NotificationSentEvent = { userId, type, message };
+    await emitEventAwaited(bus, Events.NOTIFICATION_SENT, event);
+  };
+
+  const route = async (orderId: string, type: string, message: string): Promise<void> => {
+    const userId = orderOwners.get(orderId);
+    if (userId !== undefined) {
+      await deliver(userId, type, message);
+      return;
+    }
+
+    const queue = pending.get(orderId) ?? [];
+    queue.push({ type, message });
+    pending.set(orderId, queue);
+
+    // Orders that are never announced would otherwise grow the buffer forever.
+    if (pending.size > MAX_PENDING_ORDERS) {
+      const oldest = pending.keys().next().value;
+      if (oldest !== undefined) pending.delete(oldest);
+    }
+  };
+
+  bus.on(Events.ORDER_CREATED, async (payload: unknown) => {
+    const { orderId, userId } = payload as OrderCreatedEvent;
+    orderOwners.set(orderId, userId);
+
+    const queued = pending.get(orderId);
+    if (!queued) return;
+
+    pending.delete(orderId);
+    for (const notification of queued) {
+      await deliver(userId, notification.type, notification.message);
+    }
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, async (payload: unknown) => {
+    const { orderId, status, previousStatus } = payload as OrderStatusChangedEvent;
+    await route(
+      orderId,
+      'order_status',
+      `Order ${orderId} changed from ${previousStatus} to ${status}`,
+    );
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, async (payload: unknown) => {
+    const { orderId, status, error } = payload as PaymentProcessedEvent;
+
+    const outcome = PAYMENT_MESSAGES[status] ?? `finished with status ${status}`;
+    const suffix = error === undefined ? '' : `: ${error}`;
+
+    await route(orderId, 'payment', `Payment for order ${orderId} ${outcome}${suffix}`);
+  });
+
+  return {
+    subscribe(userId: string): void {
+      if (!mailboxes.has(userId)) {
+        mailboxes.set(userId, []);
+      }
+    },
+
+    getNotifications(userId: string): Notification[] {
+      const mailbox = mailboxes.get(userId);
+      return mailbox ? mailbox.map(notification => ({ ...notification })) : [];
+    },
+  };
+}
