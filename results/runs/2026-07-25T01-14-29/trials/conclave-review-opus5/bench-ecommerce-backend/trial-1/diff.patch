+import { EventBus } from '../bus.js';
+import { emitEvent } from '../common/emit.js';
+import { fromCents, toCents } from '../common/money.js';
+import {
+  AnalyticsEvent,
+  AnalyticsService,
+  CartUpdatedEvent,
+  Events,
+  OrderCreatedEvent,
+  PaymentProcessedEvent,
+  PaymentStatus,
+} from '../types.js';
+
+/**
+ * Events this service observes. `analytics:event` is deliberately excluded:
+ * it is the service's own output and subscribing to it would loop forever.
+ */
+const TRACKED_EVENTS: readonly string[] = [
+  Events.PRODUCT_CREATED,
+  Events.INVENTORY_UPDATED,
+  Events.LOW_STOCK_ALERT,
+  Events.CART_UPDATED,
+  Events.PRICE_CALCULATED,
+  Events.ORDER_CREATED,
+  Events.ORDER_STATUS_CHANGED,
+  Events.PAYMENT_PROCESSED,
+  Events.NOTIFICATION_SENT,
+];
+
+/**
+ * Read-only projection over the event stream: event counts, realised revenue,
+ * cart-to-order conversion and a product leaderboard. It never calls another
+ * service; everything it knows it learned from the bus.
+ *
+ * Handlers are order-independent and idempotent by design. The bus awaits
+ * subscribers one at a time, so a service registered after this one can have
+ * its `order:created` handler run *after* the matching `payment:processed`
+ * arrives; replays and retries are possible for the same reason.
+ */
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  const seenCarts = new Set<string>();
+  /** Orders whose revenue has already been booked, so it is only booked once. */
+  const settledOrders = new Set<string>();
+  /** Successful payments seen before their order, replayed once it shows up. */
+  const unmatchedPayments = new Set<string>();
+  let orderCount = 0;
+  let revenueCents = 0;
+
+  const bookRevenue = (orderId: string): void => {
+    if (settledOrders.has(orderId)) return;
+
+    const total = orderTotals.get(orderId);
+    if (total === undefined) {
+      unmatchedPayments.add(orderId);
+      return;
+    }
+
+    settledOrders.add(orderId);
+    revenueCents += toCents(total);
+  };
+
+  for (const eventName of TRACKED_EVENTS) {
+    bus.on(eventName, (payload: unknown) => {
+      eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+
+      const analyticsEvent: AnalyticsEvent = {
+        event: eventName,
+        // Copied: the published event outlives the publisher's payload object.
+        data:
+          typeof payload === 'object' && payload !== null
+            ? { ...(payload as Record<string, unknown>) }
+            : { value: payload },
+        timestamp: Date.now(),
+      };
+      emitEvent(bus, Events.ANALYTICS_EVENT, analyticsEvent);
+    });
+  }
+
+  bus.on(Events.CART_UPDATED, (payload: unknown) => {
+    const { cartId, items } = payload as CartUpdatedEvent;
+    seenCarts.add(cartId);
+    cartItems.set(cartId, items.map(item => ({ ...item })));
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const { orderId, cartId, total } = payload as OrderCreatedEvent;
+    if (orderTotals.has(orderId)) return; // duplicate delivery of the same order
+
+    orderCount += 1;
+    orderTotals.set(orderId, total);
+    // A cart that only ever emitted on checkout still belongs in the denominator.
+    seenCarts.add(cartId);
+
+    // Attribute the ordered cart's contents to the product leaderboard.
+    for (const item of cartItems.get(cartId) ?? []) {
+      productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+    }
+
+    if (unmatchedPayments.delete(orderId)) {
+      bookRevenue(orderId);
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    if (status !== PaymentStatus.SUCCESS) return;
+
+    bookRevenue(orderId);
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return fromCents(revenueCents);
+    },
+
+    getConversionRate(): number {
+      if (seenCarts.size === 0) return 0;
+      return orderCount / seenCarts.size;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      if (!Number.isFinite(limit) || limit <= 0) return [];
+
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count || a.productId.localeCompare(b.productId))
+        .slice(0, limit);
+    },
+  };
+}
