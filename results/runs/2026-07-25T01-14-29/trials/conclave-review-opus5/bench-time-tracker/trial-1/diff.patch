+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BK9uXH2RbZpVwmkwWZm1x6","type":"tool_result","content":"1\timport { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';\n2\timport { dirname } from 'node:path';\n3\t\n4\t/** A single tracked time entry. */\n5\texport interface Entry {\n6\t  /** Name of the tracked task. */\n7\t  taskName: string;\n8\t  /** ISO 8601 timestamp of when tracking started. */\n9\t  startTime: string;\n10\t  /** ISO 8601 timestamp of when tracking stopped, or null while running. */\n11\t  endTime: string | null;\n12\t}\n13\t\n14\t/** Shape of the persisted JSON document. */\n15\tinterface TrackerData {\n16\t  entries: Entry[];\n17\t}\n18\t\n19\tfunction isEntry(value: unknown): value is Entry {\n20\t  if (typeof value !== 'object' || value === null) return false;\n21\t  const candidate = value as Record<string, unknown>;\n22\t  return (\n23\t    typeof candidate.taskName === 'string' &&\n24\t    typeof candidate.startTime === 'string' &&\n25\t    (candidate.endTime === null || typeof candidate.endTime === 'string')\n26\t  );\n27\t}\n28\t\n29\tfunction cloneEntry(entry: Entry): Entry {\n30\t  return {\n31\t    taskName: entry.taskName,\n32\t    startTime: entry.startTime,\n33\t    endTime: entry.endTime,\n34\t  };\n35\t}\n36\t\n37\t/**\n38\t * Tracks time spent on named tasks, persisting entries to a JSON file.\n39\t *\n40\t * Only one task may be active at a time; starting a task while another runs\n41\t * automatically stops the running one.\n42\t */\n43\texport class TimeTracker {\n44\t  private readonly filePath: string;\n45\t  private entries: Entry[];\n46\t\n47\t  constructor(filePath: string) {\n48\t    if (typeof filePath !== 'string' || filePath.length === 0) {\n49\t      throw new Error('filePath must be a non-empty string');\n50\t    }\n51\t    this.filePath = filePath;\n52\t    this.entries = this.load();\n53\t  }\n54\t\n55\t  /**\n56\t   * Starts tracking a new task, auto-stopping any currently running task.\n57\t   *\n58\t   * @throws if `taskName` is empty or blank.\n59\t   */\n60\t  start(taskName: string): Entry {\n61\t    if (typeof taskName !== 'string' || taskName.trim().length === 0) {\n62\t      throw new Error('taskName must be a non-empty string');\n63\t    }\n64\t\n65\t    const now = new Date().toISOString();\n66\t\n67\t    const active = this.findActive();\n68\t    if (active) {\n69\t      active.endTime = now;\n70\t    }\n71\t\n72\t    const entry: Entry = { taskName, startTime: now, endTime: null };\n73\t    this.entries.push(entry);\n74\t    this.save();\n75\t    return cloneEntry(entry);\n76\t  }\n77\t\n78\t  /**\n79\t   * Stops the currently running task.\n80\t   *\n81\t   * @throws if no task is running.\n82\t   */\n83\t  stop(): Entry {\n84\t    const active = this.findActive();\n85\t    if (!active) {\n86\t      throw new Error('No task is currently running');\n87\t    }\n88\t    active.endTime = new Date().toISOString();\n89\t    this.save();\n90\t    return cloneEntry(active);\n91\t  }\n92\t\n93\t  /** Returns the currently running entry, or null if nothing is active. */\n94\t  getActiveTask(): Entry | null {\n95\t    const active = this.findActive();\n96\t    return active ? cloneEntry(active) : null;\n97\t  }\n98\t\n99\t  /**\n100\t   * Returns tracked entries in the order they were started.\n101\t   *\n102\t   * When `options.since` is given, an entry is included if it started on or\n103\t   * after that date, is still running, or ended on or after that date.\n104\t   */\n105\t  getLog(options?: { since?: Date }): Entry[] {\n106\t    const since = options?.since;\n107\t    const entries = this.entries.map(cloneEntry);\n108\t    if (!since) return entries;\n109\t\n110\t    const sinceMs = since.getTime();\n111\t    if (Number.isNaN(sinceMs)) return entries;\n112\t\n113\t    return entries.filter((entry) => {\n114\t      const startMs = Date.parse(entry.startTime);\n115\t      if (!Number.isNaN(startMs) && startMs >= sinceMs) return true;\n116\t      if (entry.endTime === null) return true;\n117\t      const endMs = Date.parse(entry.endTime);\n118\t      return !Number.isNaN(endMs) && endMs >= sinceMs;\n119\t    });\n120\t  }\n121\t\n122\t  /**\n123\t   * Returns total tracked milliseconds per task name. Running tasks are\n124\t   * measured up to the current time.\n125\t   */\n126\t  getSummary(): Record<string, number> {\n127\t    const now = Date.now();\n128\t    const summary: Record<string, number> = {};\n129\t\n130\t    for (const entry of this.entries) {\n131\t      const startMs = Date.parse(entry.startTime);\n132\t      if (Number.isNaN(startMs)) continue;\n133\t\n134\t      const endMs = entry.endTime === null ? now : Date.parse(entry.endTime);\n135\t      if (Number.isNaN(endMs)) continue;\n136\t\n137\t      const duration = Math.max(0, endMs - startMs);\n138\t      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;\n139\t    }\n140\t\n141\t    return summary;\n142\t  }\n143\t\n144\t  private findActive(): Entry | undefined {\n145\t    for (let i = this.entries.length - 1; i >= 0; i -= 1) {\n146\t      if (this.entries[i].endTime === null) return this.entries[i];\n147\t    }\n148\t    return undefined;\n149\t  }\n150\t\n151\t  private load(): Entry[] {\n152\t    if (!existsSync(this.filePath)) return [];\n153\t\n154\t    let raw: string;\n155\t    try {\n156\t      raw = readFileSync(this.filePath, 'utf8');\n157\t    } catch {\n158\t      return [];\n159\t    }\n160\t\n161\t    if (raw.trim().length === 0) return [];\n162\t\n163\t    let parsed: unknown;\n164\t    try {\n165\t      parsed = JSON.parse(raw);\n166\t    } catch {\n167\t      throw new Error(`Tracker file at ${this.filePath} contains invalid JSON`);\n168\t    }\n169\t\n170\t    const list = Array.isArray(parsed)\n171\t      ? parsed\n172\t      : (parsed as Partial<TrackerData> | null)?.entries;\n173\t\n174\t    if (!Array.isArray(list)) return [];\n175\t    return list.filter(isEntry).map(cloneEntry);\n176\t  }\n177\t\n178\t  private save(): void {\n179\t    const dir = dirname(this.filePath);\n180\t    if (dir && !existsSync(dir)) {\n181\t      mkdirSync(dir, { recursive: true });\n182\t    }\n183\t    const data: TrackerData = { entries: this.entries };\n184\t    writeFileSync(this.filePath, `${JSON.stringify(data, null, 2)}\\n`, 'utf8');\n185\t  }\n186\t}\n187\t\n188\texport default TimeTracker;\n189\t"}]},"parent_tool_use_id":"toolu_017LFE8sBh3JqwfWtxb9Umay","session_id":"f5c8e4a4-7cd4-436d-913a-1a4f82849400","uuid":"750f324f-a440-4140-a350-e7047eae1057","timestamp":"2026-07-25T01:15:30.228Z","subagent_type":"conclave:code-reviewer","task_description":"Review time tracker implementation"}
