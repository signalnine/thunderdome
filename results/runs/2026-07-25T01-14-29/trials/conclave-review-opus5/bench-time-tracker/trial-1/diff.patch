+import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+
+/** A single tracked time entry. */
+export interface Entry {
+  /** Name of the tracked task. */
+  taskName: string;
+  /** ISO 8601 timestamp of when tracking started. */
+  startTime: string;
+  /** ISO 8601 timestamp of when tracking stopped, or null while running. */
+  endTime: string | null;
+}
+
+/** Shape of the persisted JSON document. */
+interface TrackerData {
+  entries: Entry[];
+}
+
+function isTimestamp(value: unknown): value is string {
+  return typeof value === 'string' && !Number.isNaN(Date.parse(value));
+}
+
+function isEntry(value: unknown): value is Entry {
+  if (typeof value !== 'object' || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return (
+    typeof candidate.taskName === 'string' &&
+    isTimestamp(candidate.startTime) &&
+    (candidate.endTime === null || isTimestamp(candidate.endTime))
+  );
+}
+
+/**
+ * Copies an entry so callers cannot mutate the tracker's internal state.
+ *
+ * The spread also preserves any extra fields written by a newer version of the
+ * format, so unknown data survives a load/save round trip. It is a shallow
+ * copy, which is sufficient while every `Entry` field is a primitive.
+ */
+function cloneEntry(entry: Entry): Entry {
+  return { ...entry };
+}
+
+/**
+ * Tracks time spent on named tasks, persisting entries to a JSON file.
+ *
+ * Only one task may be active at a time; starting a task while another runs
+ * automatically stops the running one. The file is the source of truth: every
+ * public method re-reads it first, so several tracker instances (or several
+ * CLI invocations) may share one path without clobbering each other.
+ */
+export class TimeTracker {
+  private readonly filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    if (typeof filePath !== 'string' || filePath.length === 0) {
+      throw new Error('filePath must be a non-empty string');
+    }
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  /**
+   * Starts tracking a new task, auto-stopping any currently running task.
+   * The name is stored verbatim; only blank names are rejected.
+   *
+   * @throws if `taskName` is empty or contains only whitespace.
+   */
+  start(taskName: string): Entry {
+    if (typeof taskName !== 'string' || taskName.trim().length === 0) {
+      throw new Error('taskName must be a non-empty string');
+    }
+
+    this.entries = this.load();
+    const now = new Date().toISOString();
+    this.closeOpenEntries(now);
+
+    const entry: Entry = { taskName, startTime: now, endTime: null };
+    this.entries.push(entry);
+    this.save();
+    return cloneEntry(entry);
+  }
+
+  /**
+   * Stops the currently running task and returns it.
+   *
+   * @throws if no task is running.
+   */
+  stop(): Entry {
+    this.entries = this.load();
+    const now = new Date().toISOString();
+    const stopped = this.closeOpenEntries(now);
+    if (stopped.length === 0) {
+      throw new Error('No task is currently running');
+    }
+    this.save();
+    return cloneEntry(stopped[stopped.length - 1]);
+  }
+
+  /** Returns the currently running entry, or null if nothing is active. */
+  getActiveTask(): Entry | null {
+    this.entries = this.load();
+    const active = this.findActive();
+    return active ? cloneEntry(active) : null;
+  }
+
+  /**
+   * Returns tracked entries in the order they were recorded.
+   *
+   * When `options.since` is given, an entry is included if it started on or
+   * after that date, is still running, or ended on or after that date. Running
+   * entries are included unconditionally — per the spec they always span the
+   * boundary, even when `since` lies in the future.
+   *
+   * @throws if `options.since` is not a valid Date.
+   */
+  getLog(options?: { since?: Date }): Entry[] {
+    const since = options?.since;
+    this.entries = this.load();
+    const entries = this.entries.map(cloneEntry);
+    if (since === undefined) return entries;
+
+    const sinceMs = since instanceof Date ? since.getTime() : Number.NaN;
+    if (Number.isNaN(sinceMs)) {
+      throw new Error('options.since must be a valid Date');
+    }
+
+    return entries.filter((entry) => {
+      if (Date.parse(entry.startTime) >= sinceMs) return true;
+      if (entry.endTime === null) return true;
+      return Date.parse(entry.endTime) >= sinceMs;
+    });
+  }
+
+  /**
+   * Returns total tracked milliseconds per task name. Running tasks are
+   * measured up to the current time.
+   */
+  getSummary(): Record<string, number> {
+    this.entries = this.load();
+    const now = Date.now();
+    // Null-prototype accumulator: task names like "constructor" or "toString"
+    // would otherwise read inherited members instead of starting at zero.
+    const totals = Object.create(null) as Record<string, number>;
+
+    for (const entry of this.entries) {
+      const startMs = Date.parse(entry.startTime);
+      const endMs = entry.endTime === null ? now : Date.parse(entry.endTime);
+      // Clamp so a hand-edited or clock-skewed entry cannot subtract from a total.
+      const duration = Math.max(0, endMs - startMs);
+      totals[entry.taskName] = (totals[entry.taskName] ?? 0) + duration;
+    }
+
+    // Spread copies own keys onto a normal object, so callers get the plain
+    // `Record<string, number>` they expect (and a real own "__proto__" key).
+    return { ...totals };
+  }
+
+  /** Ends every open entry at `now`, returning them in recorded order. */
+  private closeOpenEntries(now: string): Entry[] {
+    const closed: Entry[] = [];
+    for (const entry of this.entries) {
+      if (entry.endTime === null) {
+        entry.endTime = now;
+        closed.push(entry);
+      }
+    }
+    return closed;
+  }
+
+  private findActive(): Entry | undefined {
+    for (let i = this.entries.length - 1; i >= 0; i -= 1) {
+      if (this.entries[i].endTime === null) return this.entries[i];
+    }
+    return undefined;
+  }
+
+  /**
+   * Reads the persisted entries. A missing or empty file yields no entries;
+   * malformed content throws rather than being silently discarded, since the
+   * next write would otherwise erase it.
+   */
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) return [];
+
+    const raw = readFileSync(this.filePath, 'utf8');
+    if (raw.trim().length === 0) return [];
+
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      throw new Error(`Tracker file at ${this.filePath} contains invalid JSON`);
+    }
+
+    const list = Array.isArray(parsed)
+      ? parsed
+      : (parsed as Partial<TrackerData> | null)?.entries;
+
+    if (!Array.isArray(list)) {
+      throw new Error(`Tracker file at ${this.filePath} is not a valid tracker document`);
+    }
+
+    return list.map((value, index) => {
+      if (!isEntry(value)) {
+        throw new Error(`Tracker file at ${this.filePath} has a malformed entry at index ${index}`);
+      }
+      return cloneEntry(value);
+    });
+  }
+
+  /** Writes the entries via a temporary file so a crash cannot truncate the data. */
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (dir && !existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+
+    const data: TrackerData = { entries: this.entries };
+    const tempPath = join(dir, `.${process.pid}-${this.entries.length}.tmp`);
+    try {
+      writeFileSync(tempPath, `${JSON.stringify(data, null, 2)}\n`, 'utf8');
+      renameSync(tempPath, this.filePath);
+    } catch (error) {
+      rmSync(tempPath, { force: true });
+      throw error;
+    }
+  }
+}
+
+export default TimeTracker;
