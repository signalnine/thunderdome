+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DfHZp9YHedXXDTC97exrJd","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n2\timport { TimeTracker } from '../src/index.js';\n3\timport { mkdtempSync, rmSync, existsSync } from 'fs';\n4\timport { join } from 'path';\n5\timport { tmpdir } from 'os';\n6\t\n7\tlet tempDir: string;\n8\tlet filePath: string;\n9\t\n10\tbeforeEach(() => {\n11\t  tempDir = mkdtempSync(join(tmpdir(), 'tracker-test-'));\n12\t  filePath = join(tempDir, 'tracker.json');\n13\t});\n14\t\n15\tafterEach(() => {\n16\t  rmSync(tempDir, { recursive: true, force: true });\n17\t});\n18\t\n19\tdescribe('TimeTracker', () => {\n20\t  // 1. start(\"task name\") creates an active entry with start time\n21\t  it('start() creates an active entry with start time', () => {\n22\t    const tracker = new TimeTracker(filePath);\n23\t    const entry = tracker.start('my task');\n24\t    expect(entry.taskName).toBe('my task');\n25\t    expect(entry.startTime).toBeTruthy();\n26\t    expect(new Date(entry.startTime).getTime()).not.toBeNaN();\n27\t    expect(entry.endTime).toBeNull();\n28\t  });\n29\t\n30\t  // 2. stop() sets end time on active entry\n31\t  it('stop() sets end time on active entry', () => {\n32\t    const tracker = new TimeTracker(filePath);\n33\t    tracker.start('my task');\n34\t    const stopped = tracker.stop();\n35\t    expect(stopped.endTime).toBeTruthy();\n36\t    expect(new Date(stopped.endTime!).getTime()).not.toBeNaN();\n37\t  });\n38\t\n39\t  // 3. Starting a new task while one is running auto-stops the previous one\n40\t  it('starting a new task auto-stops the previous one', () => {\n41\t    const tracker = new TimeTracker(filePath);\n42\t    tracker.start('task 1');\n43\t    const entry2 = tracker.start('task 2');\n44\t    const log = tracker.getLog();\n45\t    const task1 = log.find(e => e.taskName === 'task 1');\n46\t    expect(task1).toBeDefined();\n47\t    expect(task1!.endTime).toBeTruthy();\n48\t    expect(entry2.taskName).toBe('task 2');\n49\t    expect(entry2.endTime).toBeNull();\n50\t  });\n51\t\n52\t  // 4. stop() when nothing is running throws/returns error\n53\t  it('stop() when nothing is running throws an error', () => {\n54\t    const tracker = new TimeTracker(filePath);\n55\t    expect(() => tracker.stop()).toThrow();\n56\t  });\n57\t\n58\t  // 5. getLog() returns all entries\n59\t  it('getLog() returns all entries', () => {\n60\t    const tracker = new TimeTracker(filePath);\n61\t    tracker.start('task 1');\n62\t    tracker.stop();\n63\t    tracker.start('task 2');\n64\t    tracker.stop();\n65\t    const log = tracker.getLog();\n66\t    expect(log).toHaveLength(2);\n67\t    expect(log[0].taskName).toBe('task 1');\n68\t    expect(log[1].taskName).toBe('task 2');\n69\t  });\n70\t\n71\t  // 6. getLog({ since: date }) filters to entries starting on or after that date\n72\t  it('getLog({ since }) filters entries starting on or after that date', () => {\n73\t    const tracker = new TimeTracker(filePath);\n74\t    tracker.start('old task');\n75\t    tracker.stop();\n76\t\n77\t    // Manually modify the first entry to be old\n78\t    const log = tracker.getLog();\n79\t    const oldDate = new Date('2020-01-01T00:00:00.000Z');\n80\t    log[0].startTime = oldDate.toISOString();\n81\t    log[0].endTime = new Date('2020-01-01T01:00:00.000Z').toISOString();\n82\t\n83\t    // Create a new tracker to write the modified data\n84\t    // Instead, let's use a different approach: start tasks at known times\n85\t    const tracker2 = new TimeTracker(filePath);\n86\t    tracker2.start('new task');\n87\t    tracker2.stop();\n88\t\n89\t    const since = new Date(Date.now() - 1000); // 1 second ago\n90\t    const filtered = tracker2.getLog({ since });\n91\t    // The 'new task' should be included, the manually-dated one depends on timing\n92\t    expect(filtered.length).toBeGreaterThanOrEqual(1);\n93\t    expect(filtered.some(e => e.taskName === 'new task')).toBe(true);\n94\t  });\n95\t\n96\t  // 7. getLog({ since }) includes entries that span the boundary (started before, still running)\n97\t  it('getLog({ since }) includes running entries started before the since date', () => {\n98\t    const tracker = new TimeTracker(filePath);\n99\t    tracker.start('spanning task');\n100\t    // Task is still running (no endTime), started now\n101\t    // A running task started before the since date but still active should be included\n102\t    // The spec says: includes entries that span the boundary (started before, still running after)\n103\t    // So a running task with no endTime should be included if it's still active\n104\t    const since = new Date(Date.now() + 60000); // 1 minute from now\n105\t    const filtered = tracker.getLog({ since });\n106\t    expect(filtered.some(e => e.taskName === 'spanning task')).toBe(true);\n107\t  });\n108\t\n109\t  // 8. getSummary() returns object keyed by task name with total duration in ms\n110\t  it('getSummary() returns object keyed by task name with total duration in ms', () => {\n111\t    const tracker = new TimeTracker(filePath);\n112\t    tracker.start('coding');\n113\t    // Small delay to ensure non-zero duration\n114\t    const startTime = Date.now();\n115\t    while (Date.now() - startTime < 10) { /* busy wait */ }\n116\t    tracker.stop();\n117\t    const summary = tracker.getSummary();\n118\t    expect(summary).toHaveProperty('coding');\n119\t    expect(typeof summary['coding']).toBe('number');\n120\t    expect(summary['coding']).toBeGreaterThanOrEqual(0);\n121\t  });\n122\t\n123\t  // 9. getSummary() combines multiple entries for the same task name\n124\t  it('getSummary() combines multiple entries for the same task name', () => {\n125\t    const tracker = new TimeTracker(filePath);\n126\t    tracker.start('coding');\n127\t    const s1 = Date.now();\n128\t    while (Date.now() - s1 < 10) { /* busy wait */ }\n129\t    tracker.stop();\n130\t    track