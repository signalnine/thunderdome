+++ b/src/registry/index.ts
@@ -0,0 +1,192 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entry_point: string;
+  permissions: string;
+}
+
+const SCHEMA = `
+  CREATE TABLE IF NOT EXISTS plugins (
+    name         TEXT NOT NULL,
+    version      TEXT NOT NULL,
+    description  TEXT NOT NULL DEFAULT '',
+    author       TEXT NOT NULL DEFAULT '',
+    dependencies TEXT NOT NULL DEFAULT '{}',
+    entry_point  TEXT NOT NULL DEFAULT '',
+    permissions  TEXT NOT NULL DEFAULT '[]',
+    PRIMARY KEY (name, version)
+  );
+`;
+
+function parseJson<T>(raw: string, fallback: T): T {
+  try {
+    const parsed = JSON.parse(raw) as T;
+    return parsed === null || parsed === undefined ? fallback : parsed;
+  } catch {
+    return fallback;
+  }
+}
+
+function toManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: parseJson<Record<string, string>>(row.dependencies, {}),
+    entryPoint: row.entry_point,
+    permissions: parseJson<string[]>(row.permissions, []),
+  };
+}
+
+/**
+ * Strict semver first so prerelease tags are preserved (`1.0.0-alpha` must sort
+ * below `1.0.0`); `coerce` is only a fallback for versions semver can't parse.
+ */
+function normalizeVersion(version: string): string | null {
+  return semver.valid(version) ?? semver.valid(semver.coerce(version) ?? '');
+}
+
+/** Newest first: parseable versions sort above unparseable ones, ties broken lexically. */
+function compareVersionsDesc(a: string, b: string): number {
+  const va = normalizeVersion(a);
+  const vb = normalizeVersion(b);
+  if (va && vb) {
+    const cmp = semver.rcompare(va, vb);
+    if (cmp !== 0) return cmp;
+  } else if (va) {
+    return -1;
+  } else if (vb) {
+    return 1;
+  }
+  return b.localeCompare(a);
+}
+
+function isPrerelease(version: string): boolean {
+  const normalized = normalizeVersion(version);
+  return normalized !== null && (semver.prerelease(normalized)?.length ?? 0) > 0;
+}
+
+/**
+ * Creates a plugin registry backed by an in-memory SQLite database.
+ * Plugins are keyed by the (name, version) pair, so a single name may hold
+ * many versions simultaneously.
+ */
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+  db.pragma('journal_mode = MEMORY');
+  db.exec(SCHEMA);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO plugins (name, version, description, author, dependencies, entry_point, permissions)
+    VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+    ON CONFLICT (name, version) DO UPDATE SET
+      description  = excluded.description,
+      author       = excluded.author,
+      dependencies = excluded.dependencies,
+      entry_point  = excluded.entry_point,
+      permissions  = excluded.permissions
+  `);
+  const getVersionStmt = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+  const getByNameStmt = db.prepare('SELECT * FROM plugins WHERE name = ?');
+  const listStmt = db.prepare('SELECT * FROM plugins ORDER BY name, version');
+  const searchStmt = db.prepare(
+    "SELECT * FROM plugins WHERE instr(lower(name), ?) > 0 OR instr(lower(description), ?) > 0 ORDER BY name, version"
+  );
+  const removeStmt = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+
+  function validate(manifest: PluginManifest): void {
+    if (!manifest || typeof manifest !== 'object') {
+      throw new Error('Invalid manifest: expected an object');
+    }
+    if (!manifest.name) {
+      throw new Error('Invalid manifest: name is required');
+    }
+    if (!manifest.version) {
+      throw new Error('Invalid manifest: version is required');
+    }
+  }
+
+  function rowsFor(name: string): PluginRow[] {
+    return getByNameStmt.all(name) as PluginRow[];
+  }
+
+  function getVersion(name: string, version: string): PluginManifest | null {
+    const row = getVersionStmt.get(name, version) as PluginRow | undefined;
+    return row ? toManifest(row) : null;
+  }
+
+  function persist(manifest: PluginManifest): void {
+    insertStmt.run({
+      name: manifest.name,
+      version: manifest.version,
+      description: manifest.description ?? '',
+      author: manifest.author ?? '',
+      dependencies: JSON.stringify(manifest.dependencies ?? {}),
+      entryPoint: manifest.entryPoint ?? '',
+      permissions: JSON.stringify(manifest.permissions ?? []),
+    });
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      validate(manifest);
+      persist(manifest);
+    },
+
+    /**
+     * Returns the highest *stable* registered version of `name`, mirroring npm's
+     * `latest` tag: prereleases are only surfaced when nothing else exists.
+     * Null when the name is unknown.
+     */
+    get(name: string): PluginManifest | null {
+      const rows = rowsFor(name);
+      if (rows.length === 0) return null;
+      const stable = rows.filter(row => !isPrerelease(row.version));
+      const candidates = stable.length > 0 ? stable : rows;
+      const sorted = [...candidates].sort((a, b) => compareVersionsDesc(a.version, b.version));
+      return toManifest(sorted[0]);
+    },
+
+    getVersion,
+
+    list(): PluginManifest[] {
+      return (listStmt.all() as PluginRow[]).map(toManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const needle = (query ?? '').toLowerCase();
+      // An empty needle matches every row under `instr`; return nothing rather
+      // than silently aliasing `search('')` to `list()`.
+      if (needle === '') return [];
+      return (searchStmt.all(needle, needle) as PluginRow[]).map(toManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      return removeStmt.run(name, version).changes > 0;
+    },
+
+    /** All registered versions of `name`, oldest first. */
+    listVersions(name: string): string[] {
+      return rowsFor(name)
+        .map(row => row.version)
+        .sort((a, b) => compareVersionsDesc(b, a));
+    },
+
+    /** Merges `updates` into an existing (name, version) row; identity fields stay pinned. */
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const existing = getVersion(name, version);
+      if (!existing) {
+        throw new Error(`Plugin not found: ${name}@${version}`);
+      }
+      persist({ ...existing, ...updates, name, version });
+    },
+  };
+}
