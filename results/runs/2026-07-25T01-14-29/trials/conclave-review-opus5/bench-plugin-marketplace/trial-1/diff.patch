rating, @comment, 0, @createdAt)\n  `);\n  const byIdStmt = db.prepare('SELECT * FROM reviews WHERE id = ?');\n  const byPluginStmt = db.prepare('SELECT * FROM reviews WHERE plugin_name = ? ORDER BY id');\n  const byUserStmt = db.prepare('SELECT * FROM reviews WHERE user_id = ? ORDER BY id');\n  const flaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id');\n  const avgStmt = db.prepare(\n    'SELECT AVG(rating) AS avg FROM reviews WHERE plugin_name = ? AND flagged = 0'\n  );\n  const countStmt = db.prepare('SELECT COUNT(*) AS count FROM reviews WHERE plugin_name = ?');\n  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');\n  const deleteStmt = db.prepare('DELETE FROM reviews WHERE id = ?');\n\n  return {\n    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {\n      if (!review || typeof review !== 'object') {\n        throw new Error('Invalid review: expected an object');\n      }\n      if (!review.pluginName) {\n        throw new Error('Invalid review: pluginName is required');\n      }\n      if (!review.userId) {\n        throw new Error('Invalid review: userId is required');\n      }\n      if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5) {\n        throw new Error(`Invalid review: rating must be an integer between 1 and 5`);\n      }\n\n      const createdAt = new Date().toISOString();\n      const info = insertStmt.run({\n        pluginName: review.pluginName,\n        pluginVersion: review.pluginVersion ?? '',\n        userId: review.userId,\n        rating: review.rating,\n        comment: review.comment ?? '',\n        createdAt,\n      });\n\n      return {\n        id: Number(info.lastInsertRowid),\n        pluginName: review.pluginName,\n        pluginVersion: review.pluginVersion ?? '',\n        userId: review.userId,\n        rating: review.rating,\n        comment: review.comment ?? '',\n        flagged: false,\n        createdAt,\n      };\n    },\n\n    getReviews(pluginName: string): Review[] {\n      return (byPluginStmt.all(pluginName) as ReviewRow[]).map(toReview);\n    },\n\n    /** Mean rating over unflagged reviews for every version; 0 when there are none. */\n    getAverageRating(pluginName: string): number {\n      const row = avgStmt.get(pluginName) as { avg: number | null } | undefined;\n      return row?.avg == null ? 0 : row.avg;\n    },\n\n    flagReview(reviewId: number): void {\n      const changes = flagStmt.run(reviewId).changes;\n      if (changes === 0) {\n        throw new Error(`Review not found: ${reviewId}`);\n      }\n    },\n\n    getFlaggedReviews(): Review[] {\n      return (flaggedStmt.all() as ReviewRow[]).map(toReview);\n    },\n\n    removeReview(reviewId: number): boolean {\n      return deleteStmt.run(reviewId).changes > 0;\n    },\n\n    getReviewsByUser(userId: string): Review[] {\n      return (byUserStmt.all(userId) as ReviewRow[]).map(toReview);\n    },\n\n    /** Counts every review for the plugin, flagged ones included. */\n    getReviewCount(pluginName: string): number {\n      const row = countStmt.get(pluginName) as { count: number } | undefined;\n      return row?.count ?? 0;\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":1890,"cache_read_input_tokens":42643,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1890},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"eb125859-4d44-410e-8c6f-c8eb947d3c46","request_id":"req_011CdMutWUX9r7xHJ9ZpJErg"}
