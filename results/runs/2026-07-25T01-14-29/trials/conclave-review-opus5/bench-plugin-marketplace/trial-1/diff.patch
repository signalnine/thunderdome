w Error('Invalid manifest: expected a manifest object');\n59\t  }\n60\t  const missing = (['name', 'version', 'entryPoint'] as const).filter(field => {\n61\t    const value = manifest[field];\n62\t    return typeof value !== 'string' || value.trim() === '';\n63\t  });\n64\t  if (missing.length > 0) {\n65\t    throw new Error(`Invalid manifest: missing required field(s): ${missing.join(', ')}`);\n66\t  }\n67\t  if (manifest.dependencies !== undefined && typeof manifest.dependencies !== 'object') {\n68\t    throw new Error('Invalid manifest: dependencies must be an object');\n69\t  }\n70\t}\n71\t\n72\t/**\n73\t * Composes the five independent modules into a single marketplace facade.\n74\t * The modules themselves never reference one another — wiring happens only\n75\t * here, and only through the interfaces in `types.ts`.\n76\t */\n77\texport function createMarketplace(): Marketplace {\n78\t  const registry = createRegistry();\n79\t  const resolver = createResolver();\n80\t  const runner = createRunner();\n81\t  const reviews = createReviewSystem();\n82\t  const deps = createDepsService();\n83\t\n84\t  async function installPlugin(\n85\t    manifest: PluginManifest,\n86\t    timeoutMs: number = DEFAULT_INSTALL_TIMEOUT_MS\n87\t  ): Promise<InstallResult> {\n88\t    assertValidManifest(manifest);\n89\t\n90\t    // The plugin must be in the registry before the graph can be walked, so\n91\t    // roll the registration back if a later step rejects it.\n92\t    const preexisting = registry.getVersion(manifest.name, manifest.version);\n93\t    registry.register(manifest);\n94\t\n95\t    try {\n96\t      const dependencies = manifest.dependencies ?? {};\n97\t      const constraints: VersionConstraint[] = Object.entries(dependencies).map(\n98\t        ([name, range]) => ({ name, range })\n99\t      );\n100\t\n101\t      const available: Record<string, string[]> = {};\n102\t      for (const { name } of constraints) {\n103\t        available[name] = registry.listVersions(name);\n104\t      }\n105\t\n106\t      const resolved = resolver.resolve(constraints, available);\n107\t\n108\t      if (deps.hasCircularDependency(manifest.name, registry)) {\n109\t        const cycles = deps.detectCycles(manifest.name, registry) ?? [];\n110\t        const rendered = cycles.map(cycle => cycle.join(' -> ')).join('; ');\n111\t        throw new Error(`Circular dependency detected for \"${manifest.name}\": ${rendered}`);\n112\t      }\n113\t\n114\t      const sandboxResult = await runner.executeWithTimeout(manifest.entryPoint, timeoutMs, {\n115\t        pluginName: manifest.name,\n116\t        pluginVersion: manifest.version,\n117\t        dependencies: resolved.map(r => ({ name: r.name, version: r.version })),\n118\t      });\n119\t\n120\t      return { manifest, resolved, sandboxResult };\n121\t    } catch (error) {\n122\t      if (preexisting) {\n123\t        registry.register(preexisting);\n124\t      } else {\n125\t        registry.remove(manifest.name, manifest.version);\n126\t      }\n127\t      throw error;\n128\t    }\n129\t  }\n130\t\n131\t  return { registry, resolver, runner, reviews, deps, installPlugin };\n132\t}\n133\t"}]},"parent_tool_use_id":"toolu_01PCGco5432dKTnnExswrjrG","session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"798b19d8-c2a6-4319-a9aa-111bcb52aebe","timestamp":"2026-07-25T01:33:50.873Z","subagent_type":"conclave:code-reviewer","task_description":"Review marketplace implementation"}
