+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S4gcJ1HDedxPoZitBRYV6A","type":"tool_result","content":"1\timport Database from 'better-sqlite3';\n2\timport type { Review, ReviewService } from '../types.js';\n3\t\n4\tinterface ReviewRow {\n5\t  id: number;\n6\t  plugin_name: string;\n7\t  plugin_version: string;\n8\t  user_id: string;\n9\t  rating: number;\n10\t  comment: string;\n11\t  flagged: number;\n12\t  created_at: string;\n13\t}\n14\t\n15\tconst SCHEMA = `\n16\t  CREATE TABLE IF NOT EXISTS reviews (\n17\t    id             INTEGER PRIMARY KEY AUTOINCREMENT,\n18\t    plugin_name    TEXT NOT NULL,\n19\t    plugin_version TEXT NOT NULL,\n20\t    user_id        TEXT NOT NULL,\n21\t    rating         INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 5),\n22\t    comment        TEXT NOT NULL DEFAULT '',\n23\t    flagged        INTEGER NOT NULL DEFAULT 0,\n24\t    created_at     TEXT NOT NULL\n25\t  );\n26\t  CREATE INDEX IF NOT EXISTS idx_reviews_plugin ON reviews (plugin_name);\n27\t  CREATE INDEX IF NOT EXISTS idx_reviews_user ON reviews (user_id);\n28\t`;\n29\t\n30\tfunction toReview(row: ReviewRow): Review {\n31\t  return {\n32\t    id: row.id,\n33\t    pluginName: row.plugin_name,\n34\t    pluginVersion: row.plugin_version,\n35\t    userId: row.user_id,\n36\t    rating: row.rating,\n37\t    comment: row.comment,\n38\t    flagged: row.flagged !== 0,\n39\t    createdAt: row.created_at,\n40\t  };\n41\t}\n42\t\n43\t/**\n44\t * Creates a review store backed by an in-memory SQLite database. Ratings are\n45\t * aggregated per plugin name across every version, and flagged (moderated)\n46\t * reviews are excluded from the average.\n47\t */\n48\texport function createReviewSystem(): ReviewService {\n49\t  const db = new Database(':memory:');\n50\t  db.pragma('journal_mode = MEMORY');\n51\t  db.exec(SCHEMA);\n52\t\n53\t  const insertStmt = db.prepare(`\n54\t    INSERT INTO reviews (plugin_name, plugin_version, user_id, rating, comment, flagged, created_at)\n55\t    VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)\n56\t  `);\n57\t  const byPluginStmt = db.prepare('SELECT * FROM reviews WHERE plugin_name = ? ORDER BY id');\n58\t  const byUserStmt = db.prepare('SELECT * FROM reviews WHERE user_id = ? ORDER BY id');\n59\t  const flaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id');\n60\t  const avgStmt = db.prepare(\n61\t    'SELECT AVG(rating) AS avg FROM reviews WHERE plugin_name = ? AND flagged = 0'\n62\t  );\n63\t  const countStmt = db.prepare('SELECT COUNT(*) AS count FROM reviews WHERE plugin_name = ?');\n64\t  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');\n65\t  const deleteStmt = db.prepare('DELETE FROM reviews WHERE id = ?');\n66\t\n67\t  return {\n68\t    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {\n69\t      if (!review || typeof review !== 'object') {\n70\t        throw new Error('Invalid review: expected an object');\n71\t      }\n72\t      if (!review.pluginName) {\n73\t        throw new Error('Invalid review: pluginName is required');\n74\t      }\n75\t      if (!review.userId) {\n76\t        throw new Error('Invalid review: userId is required');\n77\t      }\n78\t      if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5) {\n79\t        throw new Error('Invalid review: rating must be an integer between 1 and 5');\n80\t      }\n81\t\n82\t      const createdAt = new Date().toISOString();\n83\t      const info = insertStmt.run({\n84\t        pluginName: review.pluginName,\n85\t        pluginVersion: review.pluginVersion ?? '',\n86\t        userId: review.userId,\n87\t        rating: review.rating,\n88\t        comment: review.comment ?? '',\n89\t        createdAt,\n90\t      });\n91\t\n92\t      return {\n93\t        id: Number(info.lastInsertRowid),\n94\t        pluginName: review.pluginName,\n95\t        pluginVersion: review.pluginVersion ?? '',\n96\t        userId: review.userId,\n97\t        rating: review.rating,\n98\t        comment: review.comment ?? '',\n99\t        flagged: false,\n100\t        createdAt,\n101\t      };\n102\t    },\n103\t\n104\t    getReviews(pluginName: string): Review[] {\n105\t      return (byPluginStmt.all(pluginName) as ReviewRow[]).map(toReview);\n106\t    },\n107\t\n108\t    /** Mean rating over unflagged reviews for every version; 0 when there are none. */\n109\t    getAverageRating(pluginName: string): number {\n110\t      const row = avgStmt.get(pluginName) as { avg: number | null } | undefined;\n111\t      return row?.avg == null ? 0 : row.avg;\n112\t    },\n113\t\n114\t    flagReview(reviewId: number): void {\n115\t      const changes = flagStmt.run(reviewId).changes;\n116\t      if (changes === 0) {\n117\t        throw new Error(`Review not found: ${reviewId}`);\n118\t      }\n119\t    },\n120\t\n121\t    getFlaggedReviews(): Review[] {\n122\t      return (flaggedStmt.all() as ReviewRow[]).map(toReview);\n123\t    },\n124\t\n125\t    removeReview(reviewId: number): boolean {\n126\t      return deleteStmt.run(reviewId).changes > 0;\n127\t    },\n128\t\n129\t    getReviewsByUser(userId: string): Review[] {\n130\t      return (byUserStmt.all(userId) as ReviewRow[]).map(toReview);\n131\t    },\n132\t\n133\t    /** Counts every review for the plugin, flagged ones included. */\n134\t    getReviewCount(pluginName: string): number {\n135\t      const row = countStmt.get(pluginName) as { count: number } | undefined;\n136\t      return row?.count ?? 0;\n137\t    },\n138\t  };\n139\t}\n140\t"}]},"parent_tool_use_id":"toolu_01PCGco5432dKTnnExswrjrG","session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"77d1de88-d284-4154-be78-9ef05584195c","timestamp":"2026-07-25T01:33:49.162Z","subagent_type":"conclave:code-reviewer","task_description":"Review marketplace implementation"}
