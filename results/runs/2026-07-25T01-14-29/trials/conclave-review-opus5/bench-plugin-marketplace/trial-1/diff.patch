@@ -0,0 +1,164 @@
+import vm from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+/**
+ * Wraps user code in a function body so `return` is legal at the top level,
+ * mirroring how a plugin entry point is written.
+ */
+function wrap(code: string): string {
+  return `(function () {\n${code}\n})()`;
+}
+
+function heapUsed(): number {
+  return process.memoryUsage().heapUsed;
+}
+
+function messageOf(error: unknown): string {
+  // Errors thrown inside a vm context belong to another realm, so `instanceof
+  // Error` is false for them — duck-type on `message` instead.
+  if (typeof error === 'object' && error !== null) {
+    const { message, name } = error as { message?: unknown; name?: unknown };
+    if (typeof message === 'string' && message !== '') return message;
+    if (typeof name === 'string' && name !== '') return name;
+
+    // Plugins commonly throw plain objects; "[object Object]" tells nobody anything.
+    try {
+      const json = JSON.stringify(error);
+      if (json !== undefined && json !== '{}') return json;
+    } catch {
+      // Circular or non-serializable — fall through to String().
+    }
+  }
+  return String(error);
+}
+
+function isThenable(value: unknown): value is PromiseLike<unknown> {
+  return (
+    (typeof value === 'object' || typeof value === 'function') &&
+    value !== null &&
+    typeof (value as PromiseLike<unknown>).then === 'function'
+  );
+}
+
+/**
+ * Deep-copies caller bindings so plugin code cannot mutate host state through
+ * a shared reference. Throws on values that carry behaviour (functions, class
+ * instances with methods) — handing those to untrusted code would give it a
+ * callable path straight back into the host.
+ */
+function isolateContext(context: Record<string, unknown>): Record<string, unknown> {
+  try {
+    return structuredClone(context);
+  } catch {
+    throw new Error('Sandbox context values must be structured-cloneable (plain data only)');
+  }
+}
+
+/**
+ * `vm`'s `timeout` option only interrupts synchronous execution, so plugin
+ * code that returns a promise needs a separate deadline.
+ */
+function withDeadline(promise: PromiseLike<unknown>, timeoutMs: number): Promise<unknown> {
+  const settled = Promise.resolve(promise);
+  // Keeps a lost race from surfacing as an unhandled rejection at process level.
+  settled.catch(() => undefined);
+
+  return new Promise<unknown>((resolve, reject) => {
+    // Deliberately not unref'd: a plugin that never settles would otherwise let
+    // the process exit with the deadline unfired. `clearTimeout` on settle keeps
+    // the loop from being held open any longer than the budget.
+    const timer = setTimeout(() => {
+      reject(new Error(`Script execution timed out after ${timeoutMs}ms`));
+    }, Math.max(0, timeoutMs));
+
+    settled.then(
+      value => {
+        clearTimeout(timer);
+        resolve(value);
+      },
+      error => {
+        clearTimeout(timer);
+        reject(error);
+      }
+    );
+  });
+}
+
+/**
+ * Creates a sandboxed runner backed by Node's `vm` module. Every execution
+ * gets a fresh context, so nothing leaks between runs.
+ *
+ * `vm` isolates scope, not the process: it is a robustness boundary against
+ * buggy plugins, not a security boundary against hostile ones.
+ */
+export function createRunner(): RunnerService {
+  async function run(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown>
+  ): Promise<SandboxResult> {
+    const startMemory = heapUsed();
+    const start = process.hrtime.bigint();
+
+    const elapsed = (): number => Number(process.hrtime.bigint() - start) / 1e6;
+    // `memoryUsed` is a whole-process heap delta, not a per-sandbox figure:
+    // `vm` shares the host heap, so treat it as a coarse hint only.
+    const memoryDelta = (): number => Math.max(0, heapUsed() - startMemory);
+
+    if (typeof code !== 'string') {
+      return {
+        success: false,
+        output: undefined,
+        duration: elapsed(),
+        memoryUsed: 0,
+        error: 'Plugin code must be a string',
+      };
+    }
+
+    try {
+      // Only the caller-supplied bindings are in scope; no require, process, or host globals.
+      const sandbox = isolateContext(context);
+      const raw: unknown = vm.runInNewContext(wrap(code), vm.createContext(sandbox), {
+        timeout: timeoutMs,
+        displayErrors: true,
+      });
+
+      // Async plugins get whatever is left of the budget after synchronous work.
+      const output = isThenable(raw)
+        ? await withDeadline(raw, Math.max(0, Math.round(timeoutMs - elapsed())))
+        : raw;
+
+      return {
+        success: true,
+        output,
+        duration: elapsed(),
+        memoryUsed: memoryDelta(),
+      };
+    } catch (error) {
+      return {
+        success: false,
+        output: undefined,
+        duration: elapsed(),
+        memoryUsed: memoryDelta(),
+        error: messageOf(error),
+      };
+    }
+  }
+
+  return {
+    async execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+      return run(code, DEFAULT_TIMEOUT_MS, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      const limit = Number.isFinite(timeoutMs) && timeoutMs > 0 ? timeoutMs : DEFAULT_TIMEOUT_MS;
+      return run(code, limit, context);
+    },
+  };
+}
