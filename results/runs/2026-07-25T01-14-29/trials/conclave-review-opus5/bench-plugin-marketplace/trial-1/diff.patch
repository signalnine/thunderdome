rrent);\n45\t      for (const dep of Object.keys(manifest.dependencies ?? {})) {\n46\t        if (ancestors.has(dep)) {\n47\t          const cyclic = registry.get(dep);\n48\t          node.dependencies.push({\n49\t            name: dep,\n50\t            version: cyclic ? cyclic.version : UNRESOLVED,\n51\t            dependencies: [],\n52\t          });\n53\t          continue;\n54\t        }\n55\t        node.dependencies.push(walk(dep, ancestors, depth + 1));\n56\t      }\n57\t      ancestors.delete(current);\n58\t\n59\t      return node;\n60\t    };\n61\t\n62\t    return walk(name, new Set<string>(), 0);\n63\t  }\n64\t\n65\t  function detectCycles(name: string, registry: RegistryService): string[][] | null {\n66\t    const cycles: string[][] = [];\n67\t    const seenCycles = new Set<string>();\n68\t    const finished = new Set<string>();\n69\t    const onPath = new Set<string>();\n70\t    const path: string[] = [];\n71\t\n72\t    const visit = (current: string): void => {\n73\t      if (finished.has(current)) return;\n74\t\n75\t      if (onPath.has(current)) {\n76\t        const cycle = path.slice(path.indexOf(current));\n77\t        // Rotate to a canonical starting point so the same loop reached from\n78\t        // different entry nodes is only reported once.\n79\t        const pivot = cycle.indexOf([...cycle].sort()[0]);\n80\t        const canonical = [...cycle.slice(pivot), ...cycle.slice(0, pivot)];\n81\t        const key = canonical.join('>');\n82\t        if (!seenCycles.has(key)) {\n83\t          seenCycles.add(key);\n84\t          cycles.push(cycle);\n85\t        }\n86\t        return;\n87\t      }\n88\t\n89\t      onPath.add(current);\n90\t      path.push(current);\n91\t      for (const dep of dependencyNamesOf(current, registry)) {\n92\t        visit(dep);\n93\t      }\n94\t      path.pop();\n95\t      onPath.delete(current);\n96\t      finished.add(current);\n97\t    };\n98\t\n99\t    visit(name);\n100\t    return cycles.length > 0 ? cycles : null;\n101\t  }\n102\t\n103\t  function topologicalSort(name: string, registry: RegistryService): string[] {\n104\t    const sorted: string[] = [];\n105\t    const finished = new Set<string>();\n106\t    const onPath = new Set<string>();\n107\t\n108\t    const visit = (current: string): void => {\n109\t      if (finished.has(current)) return;\n110\t      if (onPath.has(current)) {\n111\t        throw new Error(`Circular dependency detected involving \"${current}\"`);\n112\t      }\n113\t\n114\t      onPath.add(current);\n115\t      for (const dep of dependencyNamesOf(current, registry)) {\n116\t        visit(dep);\n117\t      }\n118\t      onPath.delete(current);\n119\t      finished.add(current);\n120\t      // Post-order: every dependency is appended before the node needing it.\n121\t      sorted.push(current);\n122\t    };\n123\t\n124\t    visit(name);\n125\t    return sorted;\n126\t  }\n127\t\n128\t  function flattenDependencies(name: string, registry: RegistryService): string[] {\n129\t    const seen = new Set<string>();\n130\t    const queue = [...dependencyNamesOf(name, registry)];\n131\t\n132\t    while (queue.length > 0) {\n133\t      const current = queue.shift() as string;\n134\t      if (current === name || seen.has(current)) continue;\n135\t      seen.add(current);\n136\t      queue.push(...dependencyNamesOf(current, registry));\n137\t    }\n138\t\n139\t    return [...seen];\n140\t  }\n141\t\n142\t  function hasCircularDependency(name: string, registry: RegistryService): boolean {\n143\t    return detectCycles(name, registry) !== null;\n144\t  }\n145\t\n146\t  return {\n147\t    buildTree,\n148\t    detectCycles,\n149\t    topologicalSort,\n150\t    flattenDependencies,\n151\t    hasCircularDependency,\n152\t  };\n153\t}\n154\t"}]},"parent_tool_use_id":"toolu_01PCGco5432dKTnnExswrjrG","session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"20f16310-7864-4f23-ae27-8145d3eb7cd8","timestamp":"2026-07-25T01:33:50.869Z","subagent_type":"conclave:code-reviewer","