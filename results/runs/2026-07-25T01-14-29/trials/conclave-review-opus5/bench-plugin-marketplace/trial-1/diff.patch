+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013GKZvhMc92KaPwtjouV55A","type":"tool_result","content":"import { describe, it, expect } from 'vitest';\nimport { createDepsService } from '../src/deps/index.js';\nimport { createRegistry } from '../src/registry/index.js';\nimport type { PluginManifest } from '../src/types.js';\n\nfunction makeManifest(name: string, deps: Record<string, string> = {}): PluginManifest {\n  return {\n    name,\n    version: '1.0.0',\n    description: `Plugin ${name}`,\n    author: 'tester',\n    dependencies: deps,\n    entryPoint: 'return true;',\n    permissions: [],\n  };\n}\n\ndescribe('Dependency Graph', () => {\n  const depsService = createDepsService();\n\n  it('buildTree creates correct dependency tree', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B', { C: '^1.0.0' }));\n    registry.register(makeManifest('C'));\n\n    const tree = depsService.buildTree('A', registry);\n    expect(tree.name).toBe('A');\n    expect(tree.dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].name).toBe('B');\n    expect(tree.dependencies[0].dependencies).toHaveLength(1);\n    expect(tree.dependencies[0].dependencies[0].name).toBe('C');\n  });\n\n  it('detectCycles finds circular dependencies', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('X', { Y: '^1.0.0' }));\n    registry.register(makeManifest('Y', { X: '^1.0.0' }));\n\n    const cycles = depsService.detectCycles('X', registry);\n    expect(cycles).not.toBeNull();\n    expect(cycles!.length).toBeGreaterThan(0);\n    // The cycle should contain both X and Y\n    const flatCycle = cycles!.flat();\n    expect(flatCycle).toContain('X');\n    expect(flatCycle).toContain('Y');\n  });\n\n  it('detectCycles returns null for no cycles', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B'));\n\n    const cycles = depsService.detectCycles('A', registry);\n    expect(cycles).toBeNull();\n  });\n\n  it('topologicalSort returns correct order', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0', C: '^1.0.0' }));\n    registry.register(makeManifest('B', { C: '^1.0.0' }));\n    registry.register(makeManifest('C'));\n\n    const sorted = depsService.topologicalSort('A', registry);\n    expect(sorted.indexOf('C')).toBeLessThan(sorted.indexOf('B'));\n    expect(sorted.indexOf('B')).toBeLessThan(sorted.indexOf('A'));\n  });\n\n  it('flattenDependencies returns all transitive deps', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('root', { mid: '^1.0.0' }));\n    registry.register(makeManifest('mid', { leaf: '^1.0.0' }));\n    registry.register(makeManifest('leaf'));\n\n    const deps = depsService.flattenDependencies('root', registry);\n    expect(deps).toContain('mid');\n    expect(deps).toContain('leaf');\n    expect(deps).not.toContain('root');\n  });\n\n  it('hasCircularDependency returns true for cycles', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B', { A: '^1.0.0' }));\n\n    expect(depsService.hasCircularDependency('A', registry)).toBe(true);\n  });\n\n  it('hasCircularDependency returns false for acyclic', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest('A', { B: '^1.0.0' }));\n    registry.register(makeManifest('B'));\n\n    expect(depsService.hasCircularDependency('A', registry)).toBe(false);\n  });\n\n  it('topologicalSort handles diamond dependencies', () => {\n    const registry = createRegistry();\n    // A -> B, A -> C, B -> D, C -> D (diamond)\n    registry.register(makeManifest('A', { B: '^1.0.0', C: '^1.0.0' }));\n    registry.register(makeManifest('B', { D: '^1.0.0' }));\n    registry.register(makeManifest('C', { D: '^1.0.0' }));\n    registry.register(makeManifest('D'));\n\n    const sorted = depsService.topologicalSort('A', registry);\n    expect(sorted).toHaveLength(4);\n    // D must come before B and C, and A must be last\n    expect(sorted.indexOf('D')).toBeLessThan(sorted.indexOf('B'));\n    expect(sorted.indexOf('D')).toBeLessThan(sorted.indexOf('C'));\n    expect(sorted.indexOf('A')).toBe(sorted.length - 1);\n  });\n});","is_error":false}]},"parent_tool_use_id":"toolu_01PCGco5432dKTnnExswrjrG","session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"64d8d6dc-051e-4f83-a6db-6c31dcd888bc","timestamp":"2026-07-25T01:33:54.513Z","subagent_type":"conclave:code-reviewer","task_description":"Review marketplace implementation"}
