+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BdZt3iX6TFTuYXmGw17jwA","type":"tool_result","content":"1\timport semver from 'semver';\n2\timport type { ResolvedVersion, ResolverService, VersionConstraint } from '../types.js';\n3\t\n4\t/**\n5\t * Creates a pure semver constraint resolver. Each constraint is resolved\n6\t * independently against the versions on offer — there is no cross-constraint\n7\t * unification, so two constraints on the same name may pick different versions.\n8\t */\n9\texport function createResolver(): ResolverService {\n10\t  function satisfies(version: string, range: string): boolean {\n11\t    return semver.satisfies(version, range, { includePrerelease: false });\n12\t  }\n13\t\n14\t  function maxSatisfying(versions: string[], range: string): string | null {\n15\t    if (!Array.isArray(versions) || versions.length === 0) return null;\n16\t    if (!semver.validRange(range)) return null;\n17\t    return semver.maxSatisfying(versions, range);\n18\t  }\n19\t\n20\t  function validRange(range: string): boolean {\n21\t    return semver.validRange(range) !== null;\n22\t  }\n23\t\n24\t  return {\n25\t    satisfies,\n26\t    maxSatisfying,\n27\t    validRange,\n28\t\n29\t    /** Throws when any constraint has no satisfying version in `available`. */\n30\t    resolve(constraints: VersionConstraint[], available: Record<string, string[]>): ResolvedVersion[] {\n31\t      return constraints.map(constraint => {\n32\t        const { name, range } = constraint;\n33\t        if (!validRange(range)) {\n34\t          throw new Error(`Invalid version range for \"${name}\": ${range}`);\n35\t        }\n36\t        const versions = available[name];\n37\t        if (!versions || versions.length === 0) {\n38\t          throw new Error(`No available versions for \"${name}\"`);\n39\t        }\n40\t        const version = maxSatisfying(versions, range);\n41\t        if (version === null) {\n42\t          throw new Error(\n43\t            `Unsatisfiable constraint: \"${name}@${range}\" (available: ${versions.join(', ')})`\n44\t          );\n45\t        }\n46\t        return { name, version, satisfies: range };\n47\t      });\n48\t    },\n49\t  };\n50\t}\n51\t"}]},"parent_tool_use_id":"toolu_01PCGco5432dKTnnExswrjrG","session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"cecbfb1f-76ac-4a49-91d3-f98483342a9b","timestamp":"2026-07-25T01:33:48.650Z","subagent_type":"conclave:code-reviewer","task_description":"Review marketplace implementation"}
