+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+/**
+ * Hard ceiling on dependency tree depth. Cycles are already cut short by the
+ * ancestor check, so hitting this means a legitimately pathological graph.
+ */
+const MAX_DEPTH = 100;
+
+/** Version reported for a dependency that is named but not present in the registry. */
+const UNRESOLVED = 'unresolved';
+
+function dependencyNamesOf(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  if (!manifest || !manifest.dependencies) return [];
+  return Object.keys(manifest.dependencies);
+}
+
+/**
+ * Creates the dependency graph service. It owns no state of its own: every
+ * query walks the registry handed to it, so it stays valid as plugins come
+ * and go.
+ */
+export function createDepsService(): DepsService {
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const root = registry.get(name);
+    if (!root) {
+      throw new Error(`Plugin not found: ${name}`);
+    }
+
+    // `ancestors` is the current root-to-node path, so a repeated name means a
+    // cycle: emit it as a leaf instead of recursing forever.
+    const walk = (current: string, ancestors: Set<string>, depth: number): DependencyNode => {
+      const manifest = registry.get(current);
+      const node: DependencyNode = {
+        name: current,
+        version: manifest ? manifest.version : UNRESOLVED,
+        dependencies: [],
+      };
+      if (!manifest) return node;
+      if (depth >= MAX_DEPTH) {
+        throw new Error(`Dependency tree for "${name}" exceeds maximum depth of ${MAX_DEPTH}`);
+      }
+
+      ancestors.add(current);
+      for (const dep of Object.keys(manifest.dependencies ?? {})) {
+        if (ancestors.has(dep)) {
+          const cyclic = registry.get(dep);
+          node.dependencies.push({
+            name: dep,
+            version: cyclic ? cyclic.version : UNRESOLVED,
+            dependencies: [],
+          });
+          continue;
+        }
+        node.dependencies.push(walk(dep, ancestors, depth + 1));
+      }
+      ancestors.delete(current);
+
+      return node;
+    };
+
+    return walk(name, new Set<string>(), 0);
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+    const seenCycles = new Set<string>();
+    const finished = new Set<string>();
+    const onPath = new Set<string>();
+    const path: string[] = [];
+
+    const visit = (current: string): void => {
+      if (finished.has(current)) return;
+
+      if (onPath.has(current)) {
+        const cycle = path.slice(path.indexOf(current));
+        // Rotate to a canonical starting point so the same loop reached from
+        // different entry nodes is only reported once.
+        const pivot = cycle.indexOf([...cycle].sort()[0]);
+        const canonical = [...cycle.slice(pivot), ...cycle.slice(0, pivot)];
+        const key = canonical.join('>');
+        if (!seenCycles.has(key)) {
+          seenCycles.add(key);
+          cycles.push(cycle);
+        }
+        return;
+      }
+
+      onPath.add(current);
+      path.push(current);
+      for (const dep of dependencyNamesOf(current, registry)) {
+        visit(dep);
+      }
+      path.pop();
+      onPath.delete(current);
+      finished.add(current);
+    };
+
+    visit(name);
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const sorted: string[] = [];
+    const finished = new Set<string>();
+    const onPath = new Set<string>();
+
+    const visit = (current: string): void => {
+      if (finished.has(current)) return;
+      if (onPath.has(current)) {
+        throw new Error(`Circular dependency detected involving "${current}"`);
+      }
+
+      onPath.add(current);
+      for (const dep of dependencyNamesOf(current, registry)) {
+        visit(dep);
+      }
+      onPath.delete(current);
+      finished.add(current);
+      // Post-order: every dependency is appended before the node needing it.
+      sorted.push(current);
+    };
+
+    visit(name);
+    return sorted;
+  }
+
+  /** Breadth-first transitive closure, cycle-safe. The root is never included. */
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    const seen = new Set<string>();
+    const queue = [...dependencyNamesOf(name, registry)];
+
+    while (queue.length > 0) {
+      const current = queue.shift() as string;
+      if (seen.has(current)) continue;
+      seen.add(current);
+      queue.push(...dependencyNamesOf(current, registry));
+    }
+
+    // A self-edge would otherwise put the root in its own dependency list.
+    seen.delete(name);
+    return [...seen];
+  }
+
+  function hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
