+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019hedreq6R4G5tSDqEskBwC","type":"tool_result","content":"1\timport Database from 'better-sqlite3';\n2\timport semver from 'semver';\n3\timport type { PluginManifest, RegistryService } from '../types.js';\n4\t\n5\tinterface PluginRow {\n6\t  name: string;\n7\t  version: string;\n8\t  description: string;\n9\t  author: string;\n10\t  dependencies: string;\n11\t  entry_point: string;\n12\t  permissions: string;\n13\t}\n14\t\n15\tconst SCHEMA = `\n16\t  CREATE TABLE IF NOT EXISTS plugins (\n17\t    name         TEXT NOT NULL,\n18\t    version      TEXT NOT NULL,\n19\t    description  TEXT NOT NULL DEFAULT '',\n20\t    author       TEXT NOT NULL DEFAULT '',\n21\t    dependencies TEXT NOT NULL DEFAULT '{}',\n22\t    entry_point  TEXT NOT NULL DEFAULT '',\n23\t    permissions  TEXT NOT NULL DEFAULT '[]',\n24\t    PRIMARY KEY (name, version)\n25\t  );\n26\t`;\n27\t\n28\tfunction parseJson<T>(raw: string, fallback: T): T {\n29\t  try {\n30\t    const parsed = JSON.parse(raw) as T;\n31\t    return parsed === null || parsed === undefined ? fallback : parsed;\n32\t  } catch {\n33\t    return fallback;\n34\t  }\n35\t}\n36\t\n37\tfunction toManifest(row: PluginRow): PluginManifest {\n38\t  return {\n39\t    name: row.name,\n40\t    version: row.version,\n41\t    description: row.description,\n42\t    author: row.author,\n43\t    dependencies: parseJson<Record<string, string>>(row.dependencies, {}),\n44\t    entryPoint: row.entry_point,\n45\t    permissions: parseJson<string[]>(row.permissions, []),\n46\t  };\n47\t}\n48\t\n49\t/** Newest first: valid semver sorts above anything unparseable, ties broken lexically. */\n50\tfunction compareVersionsDesc(a: string, b: string): number {\n51\t  const va = semver.valid(semver.coerce(a) ?? '');\n52\t  const vb = semver.valid(semver.coerce(b) ?? '');\n53\t  if (va && vb) {\n54\t    const cmp = semver.rcompare(va, vb);\n55\t    if (cmp !== 0) return cmp;\n56\t  } else if (va) {\n57\t    return -1;\n58\t  } else if (vb) {\n59\t    return 1;\n60\t  }\n61\t  return b.localeCompare(a);\n62\t}\n63\t\n64\t/**\n65\t * Creates a plugin registry backed by an in-memory SQLite database.\n66\t * Plugins are keyed by the (name, version) pair, so a single name may hold\n67\t * many versions simultaneously.\n68\t */\n69\texport function createRegistry(): RegistryService {\n70\t  const db = new Database(':memory:');\n71\t  db.pragma('journal_mode = MEMORY');\n72\t  db.exec(SCHEMA);\n73\t\n74\t  const insertStmt = db.prepare(`\n75\t    INSERT INTO plugins (name, version, description, author, dependencies, entry_point, permissions)\n76\t    VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)\n77\t    ON CONFLICT (name, version) DO UPDATE SET\n78\t      description  = excluded.description,\n79\t      author       = excluded.author,\n80\t      dependencies = excluded.dependencies,\n81\t      entry_point  = excluded.entry_point,\n82\t      permissions  = excluded.permissions\n83\t  `);\n84\t  const getVersionStmt = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');\n85\t  const getByNameStmt = db.prepare('SELECT * FROM plugins WHERE name = ?');\n86\t  const listStmt = db.prepare('SELECT * FROM plugins ORDER BY name, version');\n87\t  const searchStmt = db.prepare(\n88\t    \"SELECT * FROM plugins WHERE instr(lower(name), ?) > 0 OR instr(lower(description), ?) > 0 ORDER BY name, version\"\n89\t  );\n90\t  const removeStmt = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');\n91\t\n92\t  function validate(manifest: PluginManifest): void {\n93\t    if (!manifest || typeof manifest !== 'object') {\n94\t      throw new Error('Invalid manifest: expected an object');\n95\t    }\n96\t    if (!manifest.name) {\n97\t      throw new Error('Invalid manifest: name is required');\n98\t    }\n99\t    if (!manifest.version) {\n100\t      throw new Error('Invalid manifest: version is required');\n101\t    }\n102\t  }\n103\t\n104\t  function rowsFor(name: string): PluginRow[] {\n105\t    return getByNameStmt.all(name) as PluginRow[];\n106\t  }\n107\t\n108\t  function getVersion(name: string, version: string): PluginManifest | null {\n109\t    const row = getVersionStmt.get(name, version) as PluginRow | undefined;\n110\t    return row ? toManifest(row) : null;\n111\t  }\n112\t\n113\t  function persist(manifest: PluginManifest): void {\n114\t    insertStmt.run({\n115\t      name: manifest.name,\n116\t      version: manifest.version,\n117\t      description: manifest.description ?? '',\n118\t      author: manifest.author ?? '',\n119\t      dependencies: JSON.stringify(manifest.dependencies ?? {}),\n120\t      entryPoint: manifest.entryPoint ?? '',\n121\t      permissions: JSON.stringify(manifest.permissions ?? []),\n122\t    });\n123\t  }\n124\t\n125\t  return {\n126\t    register(manifest: PluginManifest): void {\n127\t      validate(manifest);\n128\t      persist(manifest);\n129\t    },\n130\t\n131\t    /** Returns the highest registered version of `name`, or null when unknown. */\n132\t    get(name: string): PluginManifest | null {\n133\t      const rows = rowsFor(name);\n134\t      if (rows.length === 0) return null;\n135\t      const sorted = [...rows].sort((a, b) => compareVersionsDesc(a.version, b.version));\n136\t      return toManifest(sorted[0]);\n137\t    },\n138\t\n139\t    getVersion,\n140\t\n141\t    list(): PluginManifest[] {\n142\t      return (listStmt.all() as PluginRow[]).map(toManifest);\n143\t    },\n144\t\n145\t    search(query: string): PluginManifest[] {\n146\t      const needle = (query ?? '').toLowerCase();\n147\t      if (needle === '') return [];\n148\t      return (searchStmt.all(needle, needle) as PluginRow[]).map(toManifest);\n149\t    },\n150\t\n151\t    remove(name: string, version: string): boolean {\n152\t      return removeStmt.run(name, version).changes > 0;\n153\t    },\n154\t\n155\t    listVersions(name: string): string[] {\n156\t      return rowsFor(name)\n157\t        .map(row => row.version)\n158\t        .sort(compareVersionsDesc)\n159\t        .reverse();\n160\t    },\n161\t\n162\t    /** Merges `updates` into an existing (name, version) row; identity fields stay pinned. */\n163\t    update(name: string, version: string, updates: Partial<PluginManifest>): void {\n164\t      const existing = getVersion(name, version);\n165\t      if (!existing) {\n166\t        throw new Error(`Plugin not found: ${name}@${version}`);\n167\t      }\n168\t      persist({ ...existing, ...updates, name, version });\n169\t    },\n170\t  };\n171\t}\n172\t"}]},"parent_tool_use_id":"toolu_01PCGco5432dKTnnExswrjrG","session_id":"d6588523-39cb-4758-b12c-c1d9fc9187a8","uuid":"ffe501d2-f6ed-45c1-b8da-e98ec7afe28e","timestamp":"2026-07-25T01:33:46.901Z","subagent_type":"conclave:code-reviewer","task_description":"Review marketplace implementation"}
