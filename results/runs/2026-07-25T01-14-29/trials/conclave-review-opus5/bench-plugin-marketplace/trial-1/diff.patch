@@ -0,0 +1,140 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolvedVersion,
+  ResolverService,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+
+export type {
+  DependencyNode,
+  DepsService,
+  PluginManifest,
+  RegistryService,
+  ResolvedVersion,
+  ResolverService,
+  Review,
+  ReviewService,
+  RunnerService,
+  SandboxResult,
+  VersionConstraint,
+} from './types.js';
+
+export { createRegistry } from './registry/index.js';
+export { createResolver } from './resolver/index.js';
+export { createRunner } from './runner/index.js';
+export { createReviewSystem } from './reviews/index.js';
+export { createDepsService } from './deps/index.js';
+
+/** Default wall-clock budget for a plugin entry point during install. */
+export const DEFAULT_INSTALL_TIMEOUT_MS = 5000;
+
+export interface InstallResult {
+  manifest: PluginManifest;
+  resolved: ResolvedVersion[];
+  sandboxResult: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest, timeoutMs?: number): Promise<InstallResult>;
+}
+
+function assertValidManifest(manifest: PluginManifest): void {
+  if (!manifest || typeof manifest !== 'object') {
+    throw new Error('Invalid manifest: expected a manifest object');
+  }
+  const missing = (['name', 'version', 'entryPoint'] as const).filter(field => {
+    const value = manifest[field];
+    return typeof value !== 'string' || value.trim() === '';
+  });
+  if (missing.length > 0) {
+    throw new Error(`Invalid manifest: missing required field(s): ${missing.join(', ')}`);
+  }
+  const { dependencies } = manifest;
+  if (dependencies !== undefined && dependencies !== null) {
+    if (typeof dependencies !== 'object' || Array.isArray(dependencies)) {
+      throw new Error('Invalid manifest: dependencies must be a name -> range object');
+    }
+    for (const [depName, range] of Object.entries(dependencies)) {
+      if (typeof range !== 'string' || range.trim() === '') {
+        throw new Error(`Invalid manifest: dependency "${depName}" needs a version range`);
+      }
+    }
+  }
+}
+
+/**
+ * Composes the five independent modules into a single marketplace facade.
+ * The modules themselves never reference one another — wiring happens only
+ * here, and only through the interfaces in `types.ts`.
+ */
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem();
+  const deps = createDepsService();
+
+  async function installPlugin(
+    manifest: PluginManifest,
+    timeoutMs: number = DEFAULT_INSTALL_TIMEOUT_MS
+  ): Promise<InstallResult> {
+    assertValidManifest(manifest);
+
+    // The plugin must be in the registry before the graph can be walked, so
+    // roll the registration back if a later step rejects it.
+    const preexisting = registry.getVersion(manifest.name, manifest.version);
+    registry.register(manifest);
+
+    try {
+      const dependencies = manifest.dependencies ?? {};
+      const constraints: VersionConstraint[] = Object.entries(dependencies).map(
+        ([name, range]) => ({ name, range })
+      );
+
+      const available: Record<string, string[]> = {};
+      for (const { name } of constraints) {
+        available[name] = registry.listVersions(name);
+      }
+
+      const resolved = resolver.resolve(constraints, available);
+
+      if (deps.hasCircularDependency(manifest.name, registry)) {
+        const cycles = deps.detectCycles(manifest.name, registry) ?? [];
+        const rendered = cycles.map(cycle => cycle.join(' -> ')).join('; ');
+        throw new Error(`Circular dependency detected for "${manifest.name}": ${rendered}`);
+      }
+
+      const sandboxResult = await runner.executeWithTimeout(manifest.entryPoint, timeoutMs, {
+        pluginName: manifest.name,
+        pluginVersion: manifest.version,
+        dependencies: resolved.map(r => ({ name: r.name, version: r.version })),
+      });
+
+      return { manifest, resolved, sandboxResult };
+    } catch (error) {
+      if (preexisting) {
+        registry.register(preexisting);
+      } else {
+        registry.remove(manifest.name, manifest.version);
+      }
+      throw error;
+    }
+  }
+
+  return { registry, resolver, runner, reviews, deps, installPlugin };
+}
