@@ -0,0 +1,54 @@
+import semver from 'semver';
+import type { ResolvedVersion, ResolverService, VersionConstraint } from '../types.js';
+
+/**
+ * Creates a pure semver constraint resolver. Each constraint is resolved
+ * independently against the versions on offer — there is no cross-constraint
+ * unification, so two constraints on the same name may pick different versions.
+ */
+export function createResolver(): ResolverService {
+  function satisfies(version: string, range: string): boolean {
+    return semver.satisfies(version, range, { includePrerelease: false });
+  }
+
+  function maxSatisfying(versions: string[], range: string): string | null {
+    if (!Array.isArray(versions) || versions.length === 0) return null;
+    if (!semver.validRange(range)) return null;
+    return semver.maxSatisfying(versions, range);
+  }
+
+  function validRange(range: string): boolean {
+    return semver.validRange(range) !== null;
+  }
+
+  return {
+    satisfies,
+    maxSatisfying,
+    validRange,
+
+    /** Throws when any constraint has no satisfying version in `available`. */
+    resolve(constraints: VersionConstraint[], available: Record<string, string[]>): ResolvedVersion[] {
+      if (!Array.isArray(constraints)) {
+        throw new Error('Invalid constraints: expected an array');
+      }
+      const offered = available ?? {};
+      return constraints.map(constraint => {
+        const { name, range } = constraint;
+        if (!validRange(range)) {
+          throw new Error(`Invalid version range for "${name}": ${range}`);
+        }
+        const versions = offered[name];
+        if (!versions || versions.length === 0) {
+          throw new Error(`No available versions for "${name}"`);
+        }
+        const version = maxSatisfying(versions, range);
+        if (version === null) {
+          throw new Error(
+            `Unsatisfiable constraint: "${name}@${range}" (available: ${versions.join(', ')})`
+          );
+        }
+        return { name, version, satisfies: range };
+      });
+    },
+  };
+}
