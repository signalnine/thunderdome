onst at = a.availableAt.getTime();\n297\t    const bt = b.availableAt.getTime();\n298\t    if (at !== bt) return at - bt;\n299\t    return a.seq - b.seq;\n300\t  }\n301\t\n302\t  // ---------------------------------------------------- complete / fail\n303\t\n304\t  complete(taskId: string): Task | null {\n305\t    const task = this.tasks.get(taskId);\n306\t    if (!task) throw new Error(`Unknown task: ${taskId}`);\n307\t    if (task.status !== 'processing' && task.status !== 'pending') return task;\n308\t\n309\t    const queue = this.getOrCreateQueue(task.queueName);\n310\t    this.removeFromPending(queue, task.id);\n311\t    queue.processing.delete(task.id);\n312\t\n313\t    task.status = 'completed';\n314\t    task.completedAt = new Date();\n315\t\n316\t    if (this.shutdownState) {\n317\t      this.shutdownState.completed += 1;\n318\t      this.maybeFinishShutdown();\n319\t    }\n320\t    return task;\n321\t  }\n322\t\n323\t  fail(taskId: string, error?: unknown): Task | null {\n324\t    const task = this.tasks.get(taskId);\n325\t    if (!task) throw new Error(`Unknown task: ${taskId}`);\n326\t    // Cancelled / already-settled tasks are never retried.\n327\t    if (task.status !== 'processing' && task.status !== 'pending') return task;\n328\t\n329\t    const queue = this.getOrCreateQueue(task.queueName);\n330\t    this.removeFromPending(queue, task.id);\n331\t    queue.processing.delete(task.id);\n332\t\n333\t    task.failCount += 1;\n334\t    if (error !== undefined) {\n335\t      task.lastError = error instanceof Error ? error.message : (error as string);\n336\t    }\n337\t\n338\t    const retriesUsed = Math.max(0, task.attempts - 1);\n339\t    if (retriesUsed < task.maxRetries) {\n340\t      const backoff = task.backoffMs * Math.pow(2, Math.max(0, task.attempts - 1));\n341\t      task.status = 'pending';\n342\t      task.availableAt = new Date(Date.now() + backoff);\n343\t      queue.pending.push(task);\n344\t    } else {\n345\t      task.status = 'failed';\n