+   * that deep dependency chains cannot overflow the stack.
+   */
+  private validateDependencies(newTaskId: string, dependsOn: string[]): void {
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+    if (dependsOn.length === 0) return;
+
+    const done = new Set<string>();
+    const onPath = new Set<string>([newTaskId]);
+    // Each frame is [id, enter?] — enter frames push children, exit frames pop the path.
+    const stack: Array<{ id: string; exiting: boolean }> = [];
+    for (let i = dependsOn.length - 1; i >= 0; i--) {
+      stack.push({ id: dependsOn[i], exiting: false });
+    }
+
+    while (stack.length > 0) {
+      const frame = stack.pop()!;
+      if (frame.exiting) {
+        onPath.delete(frame.id);
+        done.add(frame.id);
+        continue;
+      }
+      if (onPath.has(frame.id)) {
+        throw new Error(`Circular dependency detected involving task ${frame.id}`);
+      }
+      if (done.has(frame.id)) continue;
+
+      onPath.add(frame.id);
+      stack.push({ id: frame.id, exiting: true });
