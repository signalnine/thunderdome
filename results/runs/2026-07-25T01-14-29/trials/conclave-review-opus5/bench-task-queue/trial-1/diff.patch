vate dependenciesSatisfied(task: Task): boolean {\n404\t    for (const depId of task.dependsOn) {\n405\t      const dep = this.tasks.get(depId);\n406\t      if (!dep || dep.status !== 'completed') return false;\n407\t    }\n408\t    return true;\n409\t  }\n410\t\n411\t  /**\n412\t   * Ensures every dependency exists and that adding `newTaskId` with these\n413\t   * dependencies introduces no cycle (direct or transitive).\n414\t   */\n415\t  private validateDependencies(newTaskId: string, dependsOn: string[]): void {\n416\t    for (const depId of dependsOn) {\n417\t      if (!this.tasks.has(depId)) {\n418\t        throw new Error(`Dependency task not found: ${depId}`);\n419\t      }\n420\t    }\n421\t\n422\t    const stack = new Set<string>([newTaskId]);\n423\t    const visited = new Set<string>();\n424\t\n425\t    const visit = (id: string): void => {\n426\t      if (stack.has(id)) {\n427\t        throw new Error(`Circular dependency detected involving task ${id}`);\n428\t      }\n429\t      if (visited.has(id)) return;\n430\t      visited.add(id);\n431\t      stack.add(id);\n432\t      const task = this.tasks.get(id);\n433\t      if (task) {\n434\t        for (const depId of task.dependsOn) visit(depId);\n435\t      }\n436\t      stack.delete(id);\n437\t    };\n438\t\n439\t    for (const depId of dependsOn) visit(depId);\n440\t  }\n441\t\n442\t  // ----------------------------------------------------------- concurrency\n443\t\n444\t  setConcurrency(queueName: string, limit: number): void {\n445\t    if (typeof limit !== 'number' || Number.isNaN(limit) || limit < 0) {\n446\t      throw new Error(`Invalid concurrency limit: ${String(limit)}`);\n447\t    }\n448\t    const queue = this.getOrCreateQueue(queueName);\n449\t    // 0 means \"no limit\", matching getConcurrency's Infinity reporting.\n450\t    queue.concurrency = limit === 0 ? Infinity : limit;\n451\t  }\n452\t\n453\t  getConcurrency(queueName: string = DEFAULT_QUEUE): ConcurrencyInfo {\n454\t    const queue 