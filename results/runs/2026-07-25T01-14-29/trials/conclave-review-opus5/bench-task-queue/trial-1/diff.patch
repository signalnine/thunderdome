58\t      created.push(this.enqueue(entry.queueName, clonePayload(entry.taskTemplate)));\n559\t    }\n560\t    return created;\n561\t  }\n562\t\n563\t  // ----------------------------------------------------------- middleware\n564\t\n565\t  use(queueName: string, middleware: Middleware): void {\n566\t    if (typeof middleware !== 'function') {\n567\t      throw new Error('Middleware must be a function');\n568\t    }\n569\t    this.getOrCreateQueue(queueName).middleware.push(middleware);\n570\t  }\n571\t\n572\t  /**\n573\t   * Dequeue one task from `queueName` and run it through the queue's\n574\t   * middleware pipeline followed by `handler`. Resolves with the processed\n575\t   * task, or null when nothing was available.\n576\t   */\n577\t  async process(queueName: string, handler: TaskHandler): Promise<Task | null> {\n578\t    const task = this.dequeue(queueName);\n579\t    if (!task) return null;\n580\t\n581\t    const middleware = [...this.getOrCreateQueue(queueName).middleware];\n582\t    let dispatched = -1;\n583\t\n584\t    const dispatch = async (index: number): Promise<void> => {\n585\t      if (index <= dispatched) {\n586\t        throw new Error('next() called multiple times in the same middleware');\n587\t      }\n588\t      dispatched = index;\n589\t\n590\t      if (index === middleware.length) {\n591\t        await handler(task);\n592\t        return;\n593\t      }\n594\t      await middleware[index](task, () => dispatch(index + 1));\n595\t    };\n596\t\n597\t    try {\n598\t      await dispatch(0);\n599\t    } catch (error) {\n600\t      this.fail(task.id, error);\n601\t      return task;\n602\t    }\n603\t\n604\t    // A middleware that never calls next() skips the handler; either way the\n605\t    // task is settled here unless the handler already settled it.\n606\t    if (task.status === 'processing') {\n607\t      this.complete(task.id);\n608\t    }\n609\t    return task;\n610\t  }\n611\t\n612\t  // ------------------------------------------------------------- shutdown\n613\t\n614\t  onShutdown(callback: ShutdownCallback): () => void {\n615\t    this.shutdownCallbacks.push(callback);\n616\t    return () => {\n617\t      const index = this.shutdownCallbacks.indexOf(callback);\n618\t      if (index !== -1) this.shutdownCallbacks.splice(index, 1);\n619\t    };\n620\t  }\n621\t\n622\t  shutdown(timeout: number = DEFAULT_SHUTDOWN_TIMEOUT_MS): Promise<ShutdownSummary> {\n623\t    if (this.shutdownPromise) return this.shutdownPromise;\n624\t\n625\t    this.shuttingDown = true;\n626\t\n627\t    let resolveFn!: (summary: ShutdownSummary) => void;\n628\t    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {\n629\t      resolveFn = resolve;\n630\t    });\n631\t\n632\t    const state: ShutdownState = {\n633\t      completed: 0,\n634\t      cancelled: 0,\n635\t      startedAt: Date.now(),\n636\t      finished: false,\n637\t      timer: null,\n638\t      resolve: resolveFn,\n639\t    };\n640\t    this.shutdownState = state;\n641\t\n642\t    for (const callback of this.shutdownCallbacks) {\n643\t      try {\n644\t        void callback();\n645\t      } catch {\n646\t        // Shutdown hooks must never block shutdown.\n647\t      }\n648\t    }\n649\t\n650\t    if (this.countProcessing() === 0) {\n651\t      this.finishShutdown(state);\n652\t    } else {\n653\t      state.timer = setTimeout(() => {\n654\t        this.forceCancelProcessing(state);\n655\t        this.finishShutdown(state);\n656\t      }, Math.max(0, timeout));\n657\t    }\n658\t\n659\t    return this.shutdownPromise;\n660\t  }\n661\t\n662\t  private countProcessing(): number {\n663\t    let total = 0;\n664\t    for (const queue of this.queues.values()) total += queue.processing.size;\n665\t    return total;\n666\t  }\n667\t\n668\t  private maybeFinishShutdown(): void {\n669\t    const state = this.shutdownState;\n670\t    if (!state || state.finished) return;\n671\t    if (this.countProcessing() > 0) return;\n672\t    this.finishShutdown(state)