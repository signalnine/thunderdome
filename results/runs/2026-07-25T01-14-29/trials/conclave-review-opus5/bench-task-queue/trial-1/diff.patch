respected by process (slot released)', async () => {\n    q.setConcurrency('w', 1);\n    q.enqueue('w', 1);\n    q.enqueue('w', 2);\n    await q.process('w', () => {});\n    expect(q.getConcurrency('w').current).toBe(0);\n    expect(await q.process('w', () => {})).not.toBeNull();\n  });\n\n  it('E10: process throwing non-Error rejection value', async () => {\n    const t = q.enqueue('w', 'x', { maxRetries: 0 });\n    await q.process('w', () => {\n      // eslint-disable-next-line @typescript-eslint/no-throw-literal\n      throw 'string error';\n    });\n    expect(t.lastError).toBe('string error');\n  });\n\n  // ---------- shutdown ----------\n  it('F1: shutdown waits for processing then completes', async () => {\n    q.enqueue('w', 1);\n    const d = q.dequeue('w')!;\n    const p = q.shutdown(5000);\n    q.complete(d.id);\n    const s = await p;\n    expect(s.completed).toBe(1);\n    expect(s.cancelled).toBe(0);\n  });\n\n  it('F2: complete AFTER shutdown resolved -> miscount / throw?', async () => {\n    q.enqueue('w', 1);\n    q.enqueue('w', 2);\n    const d1 = q.dequeue('w')!;\n    const d2 = q.dequeue('w')!;\n    const p = q.shutdown(5000);\n    q.complete(d1.id);\n    q.complete(d2.id);\n    const s = await p;\n    expect(s.completed).toBe(2);\n    // now shutdown has resolved; complete another? all settled. Try fail on pending\n    // (there are pending tasks in queue at shutdown -- are they cancelled?)\n    expect(q.queueSize('w')).toBe(0);\n  });\n\n  it('F3: pending tasks at shutdown are left dangling', async () => {\n    q.enqueue('w', 1);\n    q.enqueue('w', 2);\n    const s = await q.shutdown(1000);\n    expect(s.cancelled).toBe(0);\n    expect(q.queueSize('w')).toBe(2); // still pending forever\n  });\n\n  it('F4: force cancel on timeout', async () => {\n    q.enqueue('w', 1);\n    const d = q.dequeue('w')!;\n    const p = q.shutdown(1000);\n    vi.advanceTimersByTime(1000);\n    const s = await p;\n    expect(s.cancelled).toBe(1);\n    expect(d.statu