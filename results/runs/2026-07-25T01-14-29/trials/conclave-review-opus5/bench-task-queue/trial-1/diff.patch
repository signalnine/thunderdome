once at creation; tick() must not re-parse on every call. */\n  spec: CronSpec;\n}\n\ninterface QueueState {\n  name: string;\n  /** Tasks with status 'pending' belonging to this queue, unordered. */\n  pending: Task[];\n  /** Ids of tasks currently in 'processing' status. */\n  processing: Set<string>;\n  dlq: Task[];\n  concurrency: number;\n  middleware: Middleware[];\n}\n\ninterface ShutdownState {\n  completed: number;\n  cancelled: number;\n  startedAt: number;\n  finished: boolean;\n  timer: ReturnType<typeof setTimeout> | null;\n  /** Tasks that were processing when shutdown began; the summary counts only these. */\n  inFlight: Set<string>;\n  resolve: (summary: ShutdownSummary) => void;\n}\n\nexport class TaskQueue {\n  private readonly queues = new Map<string, QueueState>();\n  private readonly tasks = new Map<string, Task>();\n  private readonly progress = new Map<string, ProgressInfo>();\n  private readonly progressListeners = new Map<string, Set<ProgressCallback>>();\n  private readonly schedules = new Map<string, ScheduleEntry>();\n  private readonly shutdownCallbacks: ShutdownCallback[] = [];\n\n  private seqCounter = 0;\n  private shuttingDown = false;\n  private shutdownPromise: Promise<ShutdownSummary> | null = null;\n  private shutdownState: ShutdownState | null = null;\n\n  // ---------------------------------------------------------------- queues\n\n  /** Names of every queue that has been created. */\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  /** Number of pending tasks in a queue. */\n  queueSize(queueName: string = DEFAULT_QUEUE): number {\n    const queue = this.queues.get(queueName);\n    return queue ? queue.pending.length : 0;\n  }\n\n  /** Number of pending tasks, defaulting to the `default` queue. */\n  size(queueName: string = DEFAULT_QUEUE): number {\n    return this.queueSize(queueName);\n  }\n\n  /** Look up a task by id regardless of status. */\n  getTask(taskId: string): Task | null {\n    return this.tasks.get(taskId) ?? null;\n  }\n\n  private getOrCreateQueue(queueName: string): QueueState {\n    let queue = this.queues.get(queueName);\n    if (!queue) {\n      queue = {\n        name: queueName,\n        pending: [],\n        processing: new Set(),\n        dlq: [],\n        concurrency: Infinity,\n        middleware: [],\n      };\n      this.queues.set(queueName, queue);\n    }\n    return queue;\n  }\n\n  // --------------------------------------------------------------- enqueue\n\n  enqueue(queueName: string, payload?: TaskPayload, options?: EnqueueOptions): Task;\n  enqueue(payload: TaskPayload, options?: EnqueueOptions): Task;\n  enqueue(first?: unknown, second?: unknown, third?: unknown): Task {\n    let queueName = DEFAULT_QUEUE;\n    let payload: TaskPayload;\n    let options: EnqueueOptions;\n\n    // A leading string is a queue name (phase 2). The single-argument\n    // back-compat form therefore only covers non-string payloads; pass\n    // enqueue('default', 'my-string') to enqueue a string payload.\n    if (typeof first === 'string') {\n      queueName = first;\n      payload = second as TaskPayload;\n      options = (third as EnqueueOptions | undefined) ?? {};\n    } else {\n      payload = first as TaskPayload;\n      options = (second as EnqueueOptions | undefined) ?? {};\n    }\n\n    if (this.shuttingDown) {\n      throw new Error('TaskQueue is shutting down; enqueue is no longer accepted');\n    }\n\n    const priority = options.priority ?? DEFAULT_PRIORITY;\n    if (typeof priority !== 'number' || !Number.isFinite(priority)) {\n      throw new Error(`Invalid priority: ${String(options.priority)}`);\n    }\n    if (priority < 1 || priority > 10) {\n      throw new Error(`Priority must be between 1 and 10, received ${priority}`);\n    }\n\n    const maxRetries = options.maxRetries ?? DEFAULT_MAX_RETRIES;\n    if (!Number.isInteger(maxRetries) || maxRetries < 0) {\n      throw new Error(`maxRetries must be a non-negative integer, received ${String(options.maxRetries)}`);\n    }\n\n    const backoffMs = options.backoffMs ?? DEFAULT_BACKOFF_MS;\n    if (!Number.isFinite(backoffMs) || backoffMs < 0) {\n      throw new Error(`backoffMs must be a non-negative finite number, received ${String(options.backoffMs)}`);\n    }\n\n    const now = Date.now();\n    let availableAt = now;\n    if (options.delay !== undefined) {\n      if (!Number.isFinite(options.delay) || options.delay < 0) {\n        throw new Error(`delay must be a non-negative finite number, received ${String(options.delay)}`);\n      }\n      availableAt = now + options.delay;\n    }\n    if (options.runAt !== undefined) {\n      const runAt = options.runAt instanceof Date ? options.runAt : new Date(options.runAt);\n      if (Number.isNaN(runAt.getTime())) {\n        throw new Error('runAt must be a valid Date');\n      }\n      availableAt = Math.max(availableAt, runAt.getTime());\n    }\n\n    const dependsOn = options.dependsOn ? [...options.dependsOn] : [];\n    const id = randomUUID();\n    this.validateDependencies(id, dependsOn);\n\n    const task: Task = {\n      id,\n      queueName,\n      payload,\n      status: 'pending',\n      priority,\n      createdAt: new Date(now),\n      availableAt: new Date(availableAt),\n      attempts: 0,\n      maxRetries,\n      backoffMs,\n      dependsOn,\n      failCount: 0,\n      retriesUsed: 0,\n      seq: this.seqCounter++,\n    };\n\n    const queue = this.getOrCreateQueue(queueName);\n    queue.pending.push(task);\n    this.tasks.set(task.id, task);\n    return task;\n  }\n\n  // --------------------------------------------------------------- dequeue\n\n  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {\n    if (this.shuttingDown) return null;\n\n    const queue = this.queues.get(queueName);\n    if (!queue) return null;\n    if (queue.processing.size >= queue.concurrency) return null;\n\n    const now = Date.now();\n    let best: Task | null = null;\n    let bestIndex = -1;\n\n    for (let i = 0; i < queue.pending.length; i++) {\n      const task = queue.pending[i];\n      if (!this.isAvailable(task, now)) continue;\n      if (best === null || comparePending(task, best) < 0) {\n        best = task;\n        bestIndex = i;\n      }\n    }\n\n    if (best === null) return null;\n\n    queue.pending.splice(bestIndex, 1);\n    best.status = 'processing';\n    best.attempts += 1;\n    queue.processing.add(best.id);\n    return best;\n  }\n\n  private isAvailable(task: Task, now: number): boolean {\n    if (task.status !== 'pending') return false;\n    const availableAt = task.availableAt.getTime();\n    if (!Number.isFinite(availableAt) || availableAt > now) return false;\n    return this.dependenciesSatisfied(task);\n  }\n\n  // ---------------------------------------------------- complete / fail\n\n  complete(taskId: string): Task | null {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Unknown task: ${taskId}`);\n\n    // Release the slot before the status guard: a caller (or middleware) may\n    // have mutated status/queueName, and a stale processing entry would\n    // otherwise starve the queue forever.\n    this.detachTask(task.id);\n    if (task.status !== 'processing') return task;\n\n    task.status = 'completed';\n    task.completedAt = new Date();\n\n    this.recordShutdownSettle(task.id, 'completed');\n    this.maybeFinishShutdown();\n    return task;\n  }\n\n  fail(taskId: string, error?: unknown): Task | null {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Unknown task: ${taskId}`);\n\n    this.detachTask(task.id);\n    // Only in-flight tasks can fail; cancelled and already-settled tasks are\n    // never retried, and a pending task has no attempt to fail.\n    if (task.status !== 'processing') return task;\n\n    task.failCount += 1;\n    if (error !== undefined) {\n      task.lastError = error instanceof Error ? error.message : String(error);\n    }\n\n    const retriesUsed = task.retriesUsed;\n    const canRetry = retriesUsed < task.maxRetries;\n\n    if (canRetry && this.shuttingDown) {\n      // Retrying is pointless once dequeue is closed; treat it as cancelled so\n      // the shutdown summary accounts for the task instead of orphaning it.\n      task.status = 'cancelled';\n      this.recordShutdownSettle(task.id, 'cancelled');\n    } else if (canRetry) {\n      const backoff = Math.min(task.backoffMs * Math.pow(2, retriesUsed), MAX_BACKOFF_MS);\n      task.retriesUsed = retriesUsed + 1;\n      task.status = 'pending';\n      task.availableAt = new Date(Date.now() + backoff);\n      this.getOrCreateQueue(task.queueName).pending.push(task);\n    } else {\n      task.status = 'failed';\n      this.getOrCreateQueue(task.queueName).dlq.push(task);\n      this.recordShutdownSettle(task.id, 'ignored');\n    }\n\n    this.maybeFinishShutdown();\n    return task;\n  }\n\n  /**\n   * Removes a task from every queue's pending list and processing set.\n   * Queue-agnostic on purpose: middleware is allowed to mutate `queueName`,\n   * so the task's current queue may not be the one holding its slot.\n   */\n  private detachTask(taskId: string): void {\n    for (const queue of this.queues.values()) {\n      queue.processing.delete(taskId);\n      const index = queue.pending.findIndex((t) => t.id === taskId);\n      if (index !== -1) queue.pending.splice(index, 1);\n    }\n  }\n\n  // ------------------------------------------------------------------- DLQ\n\n  getDLQ(queueName: string = DEFAULT_QUEUE): Task[] {\n    const queue = this.queues.get(queueName);\n    return queue ? [...queue.dlq] : [];\n  }\n\n  retryDLQ(taskId: string): Task {\n    if (this.shuttingDown) {\n      throw new Error('TaskQueue is shutting down; retryDLQ is no longer accepted');\n    }\n\n    for (const queue of this.queues.values()) {\n      const index = queue.dlq.findIndex((t) => t.id === taskId);\n      if (index === -1) continue;\n\n      const [task] = queue.dlq.splice(index, 1);\n      task.status = 'pending';\n      task.attempts = 0;\n      // Fresh retry budget; failCount stays cumulative as failure history.\n      task.retriesUsed = 0;\n      task.availableAt = new Date(Date.now());\n      delete task.completedAt;\n      this.progress.delete(task.id);\n      queue.pending.push(task);\n      return task;\n    }\n    throw new Error(`Task ${taskId} is not in any dead letter queue`);\n  }\n\n  clearDLQ(queueName: string = DEFAULT_QUEUE): number {\n    const queue = this.queues.get(queueName);\n    if (!queue) return 0;\n    const removed = queue.dlq.length;\n    queue.dlq = [];\n    return removed;\n  }\n\n  // ---------------------------------------------------------- dependencies\n\n  getDependencies(taskId: string): DependencyInfo[] {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Unknown task: ${taskId}`);\n    return task.dependsOn.map((depId) => ({\n      taskId: depId,\n      status: this.tasks.get(depId)?.status ?? 'unknown',\n    }));\n  }\n\n  private dependenciesSatisfied(task: Task): boolean {\n    for (const depId of task.dependsOn) {\n      const dep = this.tasks.get(depId);\n      if (!dep || dep.status !== 'completed') return false;\n    }\n    return true;\n  }\n\n  /**\n   * Ensures every dependency exists and that adding `newTaskId` with these\n   * dependencies introduces no cycle (direct or transitive). Iterative DFS so\n   * that deep dependency chains cannot overflow the stack.\n   */\n  private validateDependencies(newTaskId: string, dependsOn: string[]): void {\n    for (const depId of dependsOn) {\n      if (!this.tasks.has(depId)) {\n        throw new Error(`Dependency task not found: ${depId}`);\n      }\n    }\n    if (dependsOn.length === 0) return;\n\n    const done = new Set<string>();\n    const onPath = new Set<string>([newTaskId]);\n    // Each frame is [id, enter?] — enter frames push children, exit frames pop the path.\n    const stack: Array<{ id: string; exiting: boolean }> = [];\n    for (let i = dependsOn.length - 1; i >= 0; i--) {\n      stack.push({ id: dependsOn[i], exiting: false });\n    }\n\n    while (stack.length > 0) {\n      const frame = stack.pop()!;\n      if (frame.exiting) {\n        onPath.delete(frame.id);\n        done.add(frame.id);\n        continue;\n      }\n      if (onPath.has(frame.id)) {\n        throw new Error(`Circular dependency detected involving task ${frame.id}`);\n      }\n      if (done.has(frame.id)) continue;\n\n      onPath.add(frame.id);\n      stack.push({ id: frame.id, exiting: true });\n\n      const deps = this.tasks.get(frame.id)?.dependsOn ?? [];\n      for (let i = deps.length - 1; i >= 0; i--) {\n        stack.push({ id: deps[i], exiting: false });\n      }\n    }\n  }\n\n  // ----------------------------------------------------------- concurrency\n\n  setConcurrency(queueName: string, limit: number): void {\n    if (!Number.isInteger(limit) || limit < 0) {\n      throw new Error(`Concurrency limit must be a non-negative integer, received ${String(limit)}`);\n    }\n    const queue = this.getOrCreateQueue(queueName);\n    // 0 means \"no limit\", matching getConcurrency's Infinity reporting.\n    queue.concurrency = limit === 0 ? Infinity : limit;\n  }\n\n  getConcurrency(queueName: string = DEFAULT_QUEUE): ConcurrencyInfo {\n    const queue = this.queues.get(queueName);\n    if (!queue) return { current: 0, max: Infinity };\n    return { current: queue.processing.size, max: queue.concurrency };\n  }\n\n  // ----------------------------------------------- progress / cancellation\n\n  updateProgress(taskId: string, percent: number, message?: string): ProgressInfo {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Unknown task: ${taskId}`);\n    if (typeof percent !== 'number' || Number.isNaN(percent)) {\n      throw new Error(`Progress percent must be a number, received ${String(percent)}`);\n    }\n    if (percent < 0 || percent > 100) {\n      throw new Error(`Progress percent must be between 0 and 100, received ${percent}`);\n    }\n\n    const info: ProgressInfo = { percent, message, updatedAt: new Date() };\n    this.progress.set(taskId, info);\n\n    const listeners = this.progressListeners.get(taskId);\n    if (listeners) {\n      for (const listener of [...listeners]) {\n        try {\n          listener({ ...info });\n        } catch {\n          // One misbehaving subscriber must not hide progress from the others.\n        }\n      }\n    }\n    return info;\n  }\n\n  getProgress(taskId: string): ProgressInfo | null {\n    return this.progress.get(taskId) ?? null;\n  }\n\n  onProgress(taskId: string, callback: ProgressCallback): () => void {\n    let listeners = this.progressListeners.get(taskId);\n    if (!listeners) {\n      listeners = new Set();\n      this.progressListeners.set(taskId, listeners);\n    }\n    listeners.add(callback);\n    return () => {\n      const current = this.progressListeners.get(taskId);\n      if (!current) return;\n      current.delete(callback);\n      if (current.size === 0) this.progressListeners.delete(taskId);\n    };\n  }\n\n  cancel(taskId: string): Task | null {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Unknown task: ${taskId}`);\n\n    this.detachTask(task.id);\n    if (task.status !== 'pending' && task.status !== 'processing') return task;\n\n    task.status = 'cancelled';\n    this.recordShutdownSettle(task.id, 'cancelled');\n    this.maybeFinishShutdown();\n    return task;\n  }\n\n  // ------------------------------------------------------------ schedules\n\n  schedule(queueName: string, cronExpression: string, taskTemplate: TaskPayload): Schedule {\n    const spec = parseCron(cronExpression);\n    const entry: ScheduleEntry = {\n      id: randomUUID(),\n      queueName,\n      cronExpression,\n      taskTemplate,\n      active: true,\n      nextRunAt: nextOccurrence(spec, Date.now()),\n      spec,\n    };\n    this.schedules.set(entry.id, entry);\n    this.getOrCreateQueue(queueName);\n    return entry;\n  }\n\n  unschedule(scheduleId: string): boolean {\n    const entry = this.schedules.get(scheduleId);\n    if (!entry || !entry.active) return false;\n    entry.active = false;\n    return true;\n  }\n\n  listSchedules(queueName?: string): Schedule[] {\n    const all = [...this.schedules.values()].filter((s) => s.active);\n    return queueName === undefined ? all : all.filter((s) => s.queueName === queueName);\n  }\n\n  /** Enqueue a task for every active schedule that is now due. */\n  tick(): Task[] {\n    if (this.shuttingDown) return [];\n\n    const now = Date.now();\n    const created: Task[] = [];\n\n    for (const entry of this.schedules.values()) {\n      if (!entry.active) continue;\n      if (entry.nextRunAt.getTime() > now) continue;\n\n      const nextRunAt = nextOccurrence(entry.spec, now);\n      try {\n        created.push(this.enqueue(entry.queueName, clonePayload(entry.taskTemplate)));\n      } catch {\n        // Leave nextRunAt untouched so the occurrence is retried on the next\n        // tick, and let sibling schedules still fire.\n        continue;\n      }\n      entry.nextRunAt = nextRunAt;\n    }\n    return created;\n  }\n\n  // ----------------------------------------------------------- middleware\n\n  use(queueName: string, middleware: Middleware): void {\n    if (typeof middleware !== 'function') {\n      throw new Error('Middleware must be a function');\n    }\n    this.getOrCreateQueue(queueName).middleware.push(middleware);\n  }\n\n  /**\n   * Dequeue one task from `queueName` and run it through the queue's\n   * middleware pipeline followed by `handler`. Resolves with the processed\n   * task, or null when nothing was available.\n   *\n   * A middleware that never calls next() skips processing: the task is\n   * returned to the queue rather than silently marked completed.\n   */\n  async process(queueName: string, handler: TaskHandler): Promise<Task | null> {\n    const task = this.dequeue(queueName);\n    if (!task) return null;\n\n    const middleware = [...this.getOrCreateQueue(queueName).middleware];\n    let dispatched = -1;\n    let handlerRan = false;\n\n    const dispatch = async (index: number): Promise<void> => {\n      if (index <= dispatched) {\n        throw new MiddlewareContractError(\n          'next() called more than once in the same middleware',\n        );\n      }\n      dispatched = index;\n\n      if (index === middleware.length) {\n        handlerRan = true;\n        await handler(task);\n        return;\n      }\n      await middleware[index](task, () => dispatch(index + 1));\n    };\n\n    try {\n      await dispatch(0);\n    } catch (error) {\n      // A broken pipeline is a programming error, not a task failure: surface\n      // it instead of burning a retry on a task that may already have run.\n      if (error instanceof MiddlewareContractError) throw error;\n      this.fail(task.id, error);\n      return task;\n    }\n\n    if (task.status === 'processing') {\n      if (handlerRan) this.complete(task.id);\n      else this.requeueSkipped(task);\n    }\n    return task;\n  }\n\n  /** Return an unprocessed task to its queue, freeing its concurrency slot. */\n  private requeueSkipped(task: Task): void {\n    this.detachTask(task.id);\n    task.status = 'pending';\n    this.getOrCreateQueue(task.queueName).pending.push(task);\n  }\n\n  // ------------------------------------------------------------- shutdown\n\n  onShutdown(callback: ShutdownCallback): () => void {\n    this.shutdownCallbacks.push(callback);\n    return () => {\n      const index = this.shutdownCallbacks.indexOf(callback);\n      if (index !== -1) this.shutdownCallbacks.splice(index, 1);\n    };\n  }\n\n  shutdown(timeout: number = DEFAULT_SHUTDOWN_TIMEOUT_MS): Promise<ShutdownSummary> {\n    if (this.shutdownPromise) return this.shutdownPromise;\n\n    this.shuttingDown = true;\n\n    let resolveFn!: (summary: Shut