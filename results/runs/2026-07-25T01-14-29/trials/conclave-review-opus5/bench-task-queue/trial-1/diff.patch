ies: 0 });\n    const d = q.dequeue('w')!;\n    expect(q.getConcurrency('w').current).toBe(1);\n    q.fail(d.id);\n    expect(q.getConcurrency('w').current).toBe(0);\n    q.retryDLQ(t.id);\n    expect(q.getConcurrency('w').current).toBe(0);\n  });\n\n  it('A5: fail() a PENDING (never dequeued) task -> attempts 0', () => {\n    const t = q.enqueue('w', 'x', { maxRetries: 3, backoffMs: 1000 });\n    q.fail(t.id, 'err');\n    // attempts is 0, retriesUsed = 0 < 3 -> pending w/ backoff 1000*2^0\n    expect(t.status).toBe('pending');\n    expect(t.availableAt.getTime()).toBe(Date.now() + 1000);\n    expect(q.queueSize('w')).toBe(1);\n  });\n\n  it('A6: double fail of same processing task -> duplicate in pending?', () => {\n    const t = q.enqueue('w', 'x');\n    const d = q.dequeue('w')!;\n    q.fail(d.id, 'e1');\n    expect(q.queueSize('w')).toBe(1);\n    // status now pending; fail again (allowed since status pending)\n    q.fail(t.id, 'e2');\n    expect(q.queueSize('w')).toBe(1); // duplicates?\n    expect(t.failCount).toBe(2);\n  });\n\n  it('A7: exceed concurrency by dequeueing then setConcurrency lower', () => {\n    q.setConcurrency('w', 3);\n    q.enqueue('w', 1);\n    q.enqueue('w', 2);\n    q.enqueue('w', 3);\n    q.dequeue('w');\n    q.dequeue('w');\n    q.setConcurrency('w', 1);\n    expect(q.dequeue('w')).toBeNull();\n  });\n\n  it('A8: concurrency 0 = unlimited?', () => {\n    q.setConcurrency('w', 0);\n    q.enqueue('w', 1);\n    q.enqueue('w', 2);\n    expect(q.dequeue('w')).not.toBeNull();\n    expect(q.dequeue('w')).not.toBeNull();\n    expect(q.getConcurrency('w').max).toBe(Infinity);\n  });\n\n  // ---------- dependencies ----------\n  it('B1: dependency cancelled -> dependent blocked forever', () => {\n    const a = q.enqueue('w', 'a');\n    const b = q.enqueue('w', 'b', { dependsOn: [a.id] });\n    q.cancel(a.id);\n    expect(q.dequeue('w')).toBeNull();\n    expect(q.getDependencies(b.id)).toEqual([{ taskId: a.id, status: 'cancelled' }]);\n  });\n\n  it('B2: dependency in DLQ -> dependent blocked; retryDLQ+complete unblocks', () => {\n    const a = q.enqueue('w', 'a', { maxRetries: 0 });\n    const b = q.enqueue('w', 'b', { dependsOn: [a.id] });\n    const d = q.dequeue('w')!;\n    q.fail(d.id, 'x');\n    expect(q.dequeue('w')).toBeNull();\n    q.retryDLQ(a.id);\n    const d2 = q.dequeue('w')!;\n    expect(d2.id).toBe(a.id);\n    q.complete(a.id);\n    expect(q.dequeue('w')!.id).toBe(b.id);\n  });\n\n  it('B3: cycle detection with self dependency', () => {\n    // depend on own (unknown) id -> throws not found\n    expect(() => q.enqueue('w', 'a', { dependsOn: ['nope'] })).toThrow();\n  });\n\n  it('B4: cycle A->B, then B->A via re-enqueue impossible; check diamond not false positive', () => {\n    const c = q.enqueue('w', 'c');\n    const b1 = q.enqueue('w', 'b1', { dependsOn: [c.id] });\n    const b2 = q.enqueue('w', 'b2', { dependsOn: [c.id] });\n    // diamond: a depends on b1 and b2 (both depend on c) -> should NOT throw\n    expect(() => q.enqueue('w', 'a', { dependsOn: [b1.id, b2.id] })).not.toThrow();\n  });\n\n  it('B5: duplicate dep ids in list', () => {\n    const c = q.enqueue('w', 'c');\n    expect(() => q.enqueue('w', 'a', { dependsOn: [c.id, c.id] })).not.toThrow();\n  });\n\n  it('B6: getDependencies for unknown dep reports failed', () => {\n    const a = q.enqueue('w', 'a');\n    const b = q.enqueue('w', 'b', { dependsOn: [a.id] });\n    // there is no removal API, so simulate: fine\n    expect(q.getDependencies(b.id)[0].status).toBe('pending');\n  });\n\n  it('B7: dependency across queues', () => {\n    const a = q.enqueue('qa', 'a');\n    const b = q.enqueue('qb', 'b', { dependsOn: [a.id] });\n    expect(q.dequeue('qb')).toBeNull();\n    const d = q.dequeue('qa')!;\n    q.complete(d.id);\n    expect(q.dequeue('qb')!.id).toBe(b.id);\n  });\n\n  // ---------- retry / DLQ interactions ----------\n  it('C1: retryDLQ then fail repeatedly -> back to DLQ', () => {\n    const t = q.enqueue('w', 'x',