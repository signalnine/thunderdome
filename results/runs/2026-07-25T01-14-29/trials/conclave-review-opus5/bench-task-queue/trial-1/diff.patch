Retries: 5, backoffMs: 1e300 });\n    q.fail(q.dequeue('w')!.id, 'boom');\n    expect(Number.isFinite(t.availableAt.getTime())).toBe(true);\n    expect(q.dequeue('w')).toBeNull();\n    vi.advanceTimersByTime(7 * 24 * 60 * 60 * 1000);\n    expect(q.dequeue('w')).not.toBeNull();\n  });\n\n  it('M1: middleware skipping next() requeues instead of completing', async () => {\n    q.setConcurrency('w', 1);\n    q.use('w', async () => {\n      /* never calls next */\n    });\n    const t = q.enqueue('w', { job: 'blocked' });\n    await q.process('w', async () => {\n      throw new Error('handler must not run');\n    });\n    expect(t.status).toBe('pending');\n    expect(q.queueSize('w')).toBe(1);\n    expect(q.getConcurrency('w').current).toBe(0);\n  });\n\n  it('M2: double next() surfaces a contract error and does not fail the task', async () => {\n    q.use('w', async (_t, next) => {\n      await next();\n      await next();\n    });\n    const t = q.enqueue('w', {}, { maxRetries: 0 });\n    let calls = 0;\n    await expect(\n      q.process('w', async () => {\n        calls++;\n      }),\n    ).rejects.toBeInstanceOf(MiddlewareContractError);\n    expect(calls).toBe(1);\n    expect(t.status).not.toBe('failed');\n    expect(q.getDLQ('w').length).toBe(0);\n  });\n\n  it('M3: tick() after shutdown is a no-op and does not lose occurrences', async () => {\n    const s1 = q.schedule('w', '*/1 * * * *', { a: 1 });\n    const s2 = q.schedule('w', '*/1 * * * *', { b: 2 });\n    const before = [s1.nextRunAt.getTime(), s2.nextRunAt.getTime()];\n    vi.advanceTimersByTime(120_000);\n    await q.shutdown(10);\n    expect(q.tick()).toEqual([]);\n    expect([s1.nextRunAt.getTime(), s2.nextRunAt.getTime()]).toEqual(before);\n  });\n\n  it('M4: retryDLQ is rejected after shutdown', async () => {\n    q.enqueue('w', 1, { maxRetries: 0 });\n    const t = q.dequeue('w')!;\n    q.fail(t.id, 'e');\n    await q.shutdown(0);\n    expect(() => q.retryDLQ(t.id)).toThrow();\n  });\n\n  it('M4b: shutdown summary counts only in-flight tasks', async () => {\n    q.enqueue('w', 'inflight');\n    const inflight = q.dequeue('w')!;\n    const pending = [q.enqueue('w', 'p1'), q.enqueue('w', 'p2')];\n    const p = q.shutdown(5000);\n    for (const t of pending) q.complete(t.id);\n    q.complete(inflight.id);\n    const s = await p;\n    expect(s.completed).toBe(1);\n    expect(s.cancelled).toBe(0);\n  });\n\n  it('M5: cancel and fail during shutdown are accounted for', async () => {\n    q.enqueue('w', 'a');\n    q.enqueue('w', 'b');\n    const a = q.dequeue('w')!;\n    const b = q.dequeue('w')!;\n    const p = q.shutdown(5000);\n    q.cancel(a.id);\n    q.fail(b.id, 'transient');\n    const s = await p;\n    expect(s).toEqual({ completed: 0, cancelled: 2, elapsed: 0 });\n    expect(b.status).toBe('cancelled');\n    expect(q.queueSize('w')).toBe(0);\n  });\n\n  it('M6: async onShutdown rejection does not become an unhandled rejection', async () => {\n    const seen: string[] = [];\n    process.once('unhandledRejection', () => seen.push('unhandled'));\n    q.onShutdown(async () => {\n      throw new Error('async hook boom');\n    });\n    await q.shutdown(1000);\n    await Promise.resolve();\n    expect(seen).toEqual([]);\n  });\n\n  it('M7/M8: invalid numeric options are rejected', () => {\n    expect(() => q.enqueue('w', 1, { maxRetries: NaN })).toThrow();\n    expect(() => q.enqueue('w', 1, { backoffMs: NaN })).toThrow();\n    expect(() => q.enqueue('w', 1, { delay: NaN })).toThrow();\n    expect(() => q.enqueue('w', 1, { maxRetries: 2.5 })).toThrow();\n    expect(() => q.setConcurrency('w', 1.5)).toThrow();\n    const t = q.enqueue('w', 1);\n    q.dequeue('w');\n    q.fail(t.id, { code: 500 });\n    expect(typeof t.lastError).toBe('string');\n  });\n\n  it('M8b: shutdown(NaN) falls back to the default timeout', async () => {\n    q.enqueue('w', 1);\n    const t = q.dequeue('w')!;\n    const p = q.shutdown(NaN);\n    vi.advanceTimersByTime(1000);\n    await Promise.resolve();\n    expect(t.status).toBe('processing');\n    q.complete(t.id);\n    expect((await p).completed).toBe(1);\n  });\n\n  it('L1: deep dependency chains do not overflow the stack', () => {\n    let prev = q.enqueue('w', 0);\n    for (let i = 1; i < 5000; i++) {\n      prev = q.enqueue('w', i, { dependsOn: [prev.id] });\n    }\n    expect(prev.dependsOn.length).toBe(1);\n    // cycles are still caught\n    const a = q.enqueue('c', 'a');\n    const b = q.enqueue('c', 'b', { dependsOn: [a.id] });\n    a.dependsOn.push(b.id); // corrupt graph on purpose\n    expect(() => q.enqueue('c', 'c', { dependsOn: [b.id] })).toThrow(/[Cc]ircular/);\n  });\n\n  it('L2: getDependencies reports unknown deps as unknown', () => {\n    const dep = q.enqueue('w', 'dep');\n    const t = q.enqueue('w', 't', { dependsOn: [dep.id] });\n    t.dependsOn.push('ghost');\n    expect(q.getDependencies(t.id)).toContainEqual({ taskId: 'ghost', status: 'unknown' });\n  });\n\n  it('L5: schedule templates keep Dates and survive cycles', () => {\n    const tpl: Record<string, unknown> = { when: new Date('2020-05-05T00:00:00Z') };\n    tpl.self = tpl;\n    q.schedule('w', '*/1 * * * *', tpl);\n    vi.advanceTimersByTime(60_000);\n    expect(() => q.tick()).not.toThrow();\n    const task = q.dequeue('w')!;\n    expect(task.payload.when).toBeInstanceOf(Date);\n    expect(task.payload.self).toBe(task.payload);\n    expect(task.payload).not.toBe(tpl);\n  });\n\n  it('DLQ: retryDLQ gives a fresh budget while failCount stays cumulative', () => {\n    q.enqueue('w', 1, { maxRetries: 1 });\n    const t = q.dequeue('w')!;\n    q.fail(t.id, 'e1');\n    vi.advanceTimersByTime(1000);\n    q.fail(q.dequeue('w')!.id, 'e2');\n    expect(t.failCount).toBe(2);\n    q.retryDLQ(t.id);\n    expect(q.dequeue('w')!.attempts).toBe(1);\n    q.fail(t.id, 'e3');\n    expect(t.failCount).toBe(3);\n    vi.advanceTimersByTime(1000);\n    expect(q.dequeue('w')).not.toBeNull(); // fresh retry was granted\n    q.fail(t.id, 'e4');\n    expect(q.getDLQ('w').length).toBe(1); // and budget re-exhausts correctly\n  });\n\n  it('ordering: priority dominates among available tasks, availableAt breaks ties', () => {\n    q.enqueue('w', 'late-high', { delay: 5000, priority: 1 });\n    q.enqueue('w', 'early-low', { delay: 1000, priority: 9 });\n    q.enqueue('w', 'later-same', { delay: 4000 });\n    q.enqueue('w', 'sooner-same', { delay: 2000 });\n    vi.advanceTimersByTime(5000);\n    expect(q.dequeue('w')!.payload).toBe('late-high');\n    expect(q.dequeue('w')!.payload).toBe('sooner-same');\n    expect(q.dequeue('w')!.payload).toBe('later-same');\n    expect(q.dequeue('w')!.payload).toBe('early-low');\n  });\n\n  it('cron: hourly and daily fire at exact boundaries', () => {\n    vi.setSystemTime(new Date('2025-03-10T10:30:00.000Z'));\n    const h = q.schedule('h', '0 * * * *', { k: 'h' });\n    const d = q.schedule('d', '0 0 * * *', { k: 'd' });\n    expect(q.tick()).toEqual([]);\n    vi.setSystemTime(new Date('2025-03-10T11:00:00.000Z'));\n    expect(q.tick().length).toBe(1);\n    expect(h.nextRunAt.getTime()).toBe(new Date('2025-03-10T12:00:00.000Z').getTime());\n    vi.setSystemTime(new Date('2025-03-11T00:00:00.000Z'));\n    const created = q.tick();\n    expect(created.length).toBe(2);\n    expect(d.nextRunAt.getTime()).toBe(new Date('2025-03-12T00:00:00.000Z').getTime());\n    // repeated ticks at the same instant do not duplicate\n    expect(q.tick()).toEqual([]);\n  });\n\n  it('back-compat: single-argument enqueue uses the default queue', () => {\n    const t = q.enqueue({ fallback: true });\n    expect(t.queueName).toBe('default');\n    expect(q.size()).toBe(1);\n    expect(q.dequeue()!.id).toBe(t.id);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":157,"cache_read_input_tokens":102805,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":157},"output_t