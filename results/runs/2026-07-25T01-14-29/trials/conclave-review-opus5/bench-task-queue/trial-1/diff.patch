  const d = q.dequeue('w')!;\n    q.fail(d.id);\n    expect(q.clearDLQ('w')).toBe(1);\n    expect(() => q.retryDLQ(t.id)).toThrow();\n    expect(t.status).toBe('failed');\n  });\n\n  // ---------- delayed + priority ----------\n  it('D1: spec says availableAt ordering BEFORE priority for delayed tasks', () => {\n    // phase-04: \"When multiple delayed tasks are available, they are ordered by\n    // their availability time (earliest first), then by priority, then FIFO\"\n    const later = q.enqueue('w', 'later-highprio', { delay: 100, priority: 1 });\n    const sooner = q.enqueue('w', 'sooner-lowprio', { delay: 10, priority: 9 });\n    vi.advanceTimersByTime(200);\n    const d = q.dequeue('w')!;\n    expect(d.id).toBe(sooner.id); // per phase-04 wording\n    void later;\n  });\n\n  it('D2: non-delayed before not-yet-available delayed', () => {\n    q.enqueue('w', 'delayed', { delay: 1000, priority: 1 });\n    const n = q.enqueue('w', 'now', { priority: 10 });\n    expect(q.dequeue('w')!.id).toBe(n.id);\n  });\n\n  it('D3: runAt in the past', () => {\n    const t = q.enqueue('w', 'x', { runAt: new Date(Date.now() - 5000) });\n    expect(q.dequeue('w')!.id).toBe(t.id);\n  });\n\n  it('D4: delay + runAt both', () => {\n    const t = q.enqueue('w', 'x', { delay: 100, runAt: new Date(Date.now() + 50) });\n    expect(t.availableAt.getTime()).toBe(Date.now() + 100);\n  });\n\n  // ---------- middleware / process ----------\n  it('E1: middleware calling next() twice', async () => {\n    let handlerCalls = 0;\n    q.use('w', async (_t, next) => {\n      await next();\n      await next();\n    });\n    const t = q.enqueue('w', 'x');\n    const r = await q.process('w', () => {\n      handlerCalls++;\n    });\n    expect(handlerCalls).toBe(1);\n    expect(r!.id).toBe(t.id);\n    expect(t.status).toBe('failed'); // error -> fail path\n  });\n\n  it('E2: handler throws -> failed & retried', async () => {\n    const t = q.enqueue('w', 'x', { maxRetries: 1 });\n    await q.process