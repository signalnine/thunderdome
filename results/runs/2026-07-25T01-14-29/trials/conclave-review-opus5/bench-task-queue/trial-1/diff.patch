71\texport type ShutdownCallback = () => Promise<void> | void;\n72\t\n73\texport interface Schedule {\n74\t  id: string;\n75\t  queueName: string;\n76\t  cronExpression: string;\n77\t  taskTemplate: TaskPayload;\n78\t  active: boolean;\n79\t  nextRunAt: Date;\n80\t}\n81\t\n82\texport interface ShutdownSummary {\n83\t  completed: number;\n84\t  cancelled: number;\n85\t  elapsed: number;\n86\t}\n87\t\n88\tconst DEFAULT_QUEUE = 'default';\n89\tconst DEFAULT_PRIORITY = 5;\n90\tconst DEFAULT_MAX_RETRIES = 3;\n91\tconst DEFAULT_BACKOFF_MS = 1000;\n92\tconst DEFAULT_SHUTDOWN_TIMEOUT_MS = 30000;\n93\t\n94\tinterface CronSpec {\n95\t  kind: 'minutes' | 'hourly' | 'daily';\n96\t  every: number;\n97\t}\n98\t\n99\tinterface QueueState {\n100\t  name: string;\n101\t  /** Tasks with status 'pending' belonging to this queue, unordered. */\n102\t  pending: Task[];\n103\t  /** Ids of tasks currently in 'processing' status. */\n104\t  processing: Set<string>;\n105\t  dlq: Task[];\n106\t  concurrency: number;\n107\t  middleware: Middleware[];\n108\t}\n109\t\n110\tinterface ShutdownState {\n111\t  completed: number;\n112\t  cancelled: number;\n113\t  startedAt: number;\n114\t  finished: boolean;\n115\t  timer: ReturnType<typeof setTimeout> | null;\n116\t  resolve: (summary: ShutdownSummary) => void;\n117\t}\n118\t\n119\texport class TaskQueue {\n120\t  private readonly queues = new Map<string, QueueState>();\n121\t  private readonly tasks = new Map<string, Task>();\n122\t  private readonly progress = new Map<string, ProgressInfo>();\n123\t  private readonly progressListeners = new Map<string, Set<ProgressCallback>>();\n124\t  private readonly schedules = new Map<string, Schedule>();\n125\t  private readonly shutdownCallbacks: ShutdownCallback[] = [];\n126\t\n127\t  private seqCounter = 0;\n128\t  private shuttingDown = false;\n129\t  private shutdownPromise: Promise<ShutdownSummary> | null = null;\n130\t  private shutdownState: ShutdownState | null = null;\n131\t\n132\t  // ---------------------------------------------------------------- queues\n133\t\n134\t  /** Names of every queue that has been created. */\n135\t  listQueues(): string[] {\n136\t    return [...this.queues.keys()];\n137\t  }\n138\t\n139\t  /** Number of pending tasks in a queue. */\n140\t  queueSize(queueName: string = DEFAULT_QUEUE): number {\n141\t    const queue = this.queues.get(queueName);\n142\t    return queue ? queue.pending.length : 0;\n143\t  }\n144\t\n145\t  /** Number of pending tasks, defaulting to the `default` queue. */\n146\t  size(queueName: string = DEFAULT_QUEUE): number {\n147\t    return this.queueSize(queueName);\n148\t  }\n149\t\n150\t  /** Look up a task by id regardless of status. */\n151\t  getTask(taskId: string): Task | null {\n152\t    return this.tasks.get(taskId) ?? null;\n153\t  }\n154\t\n155\t  private getOrCreateQueue(queueName: string): QueueState {\n156\t    let queue = this.queues.get(queueName);\n157\t    if (!queue) {\n158\t      queue = {\n159\t        name: queueName,\n160\t        pending: [],\n161\t        processing: new Set(),\n162\t        dlq: [],\n163\t        concurrency: Infinity,\n164\t        middleware: [],\n165\t      };\n166\t      this.queues.set(queueName, queue);\n167\t    }\n168\t    return queue;\n169\t  }\n170\t\n171\t  // --------------------------------------------------------------- enqueue\n172\t\n173\t  enqueue(queueName: string, payload?: TaskPayload, options?: EnqueueOptions): Task;\n174\t  enqueue(payload: TaskPayload, options?: EnqueueOptions): Task;\n175\t  enqueue(first?: unknown, second?: unknown, third?: unknown): Task {\n176\t    let queueName = DEFAULT_QUEUE;\n177\t    let payload: TaskPayload;\n178\t    let options: EnqueueOptions;\n179\t\n180\t    if (typeof first === 'string') {\n181\t      queueName = first;\n182\t      payload = second as TaskPayload;\n183\t      options = (third as EnqueueOptions | undefined) ?? {};\n184\t    } else {\n185\t      payload = first as TaskPayload;\n186\t      options = (second as EnqueueOptions | undefined) ?? {};\n187\t    }\n188\t\n189\t    if (this.shuttingDown) {\n190\t      throw new Error('TaskQueue is shutting down; enqueue is no longer accepted');\n191\t    }\n192\t\n193\t    const priority = options.priority ?? DEFAULT_PRIORITY;\n194\t    if (typeof priority !== 'number' || !Number.isFinite(priority)) {\n195\t      throw new Error(`Invalid priority: ${String(options.priority)}`);\n196\t    }\n197\t    if (priority < 1 || priority > 10) {\n198\t      throw new Error(`Priority must be between 1 and 10, received ${priority}`);\n199\t    }\n200\t\n201\t    const maxRetries = options.maxRetries ?? DEFAULT_MAX_RETRIES;\n202\t    if (maxRetries < 0) {\n203\t      throw new Error(`maxRetries must be >= 0, received ${maxRetries}`);\n204\t    }\n205\t\n206\t    const backoffMs = options.backoffMs ?? DEFAULT_BACKOFF_MS;\n207\t    if (backoffMs < 0) {\n208\t      throw new Error(`backoffMs must be >= 0, received ${backoffMs}`);\n209\t    }\n210\t\n211\t    const now = Date.now();\n212\t    let availableAt = now;\n213\t    if (options.delay !== undefined) {\n214\t      if (options.delay < 0) {\n215\t        throw new Error(`delay must be >= 0, received ${options.delay}`);\n216\t      }\n217\t      availableAt = now + options.delay;\n218\t    }\n219\t    if (options.runAt !== undefined) {\n220\t      const runAt = options.runAt instanceof Date ? options.runAt : new Date(options.runAt);\n221\t      if (Number.isNaN(runAt.getTime())) {\n222\t        throw new Error('runAt must be a valid Date');\n223\t      }\n224\t      availableAt = Math.max(availableAt, runAt.getTime());\n225\t    }\n226\t\n227\t    const dependsOn = options.dependsOn ? [...options.dependsOn] : [];\n228\t    const id = randomUUID();\n229\t    this.validateDependencies(id, dependsOn);\n230\t\n231\t    const task: Task = {\n232\t      id,\n233\t      queueName,\n234\t      payload,\n235\t      status: 'pending',\n236\t      priority,\n237\t      createdAt: new Date(no