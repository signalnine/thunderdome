ordered by availability time', () => {\n    queue.enqueue('work', { name: 'later' }, { delay: 10000 });\n    queue.enqueue('work', { name: 'sooner' }, { delay: 3000 });\n\n    vi.advanceTimersByTime(10000);\n\n    const first = queue.dequeue('work');\n    const second = queue.dequeue('work');\n\n    expect(first!.payload).toEqual({ name: 'sooner' });\n    expect(second!.payload).toEqual({ name: 'later' });\n  });\n\n  it('delay works with named queues', () => {\n    queue.enqueue('fast', { name: 'fast-delayed' }, { delay: 2000 });\n    queue.enqueue('slow', { name: 'slow-delayed' }, { delay: 8000 });\n\n    vi.advanceTimersByTime(2000);\n\n    expect(queue.dequeue('fast')).not.toBeNull();\n    expect(queue.dequeue('slow')).toBeNull();\n\n    vi.advanceTimersByTime(6000);\n\n    expect(queue.dequeue('slow')).not.toBeNull();\n  });\n});\n======== phase-05.test.ts\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 5: Retry with Backoff', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('fail marks a processing task as failed', () => {\n    queue.enqueue('work', { job: 'test' }, { maxRetries: 0 });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'something went wrong');\n\n    // With maxRetries: 0, no retry - task stays failed\n    expect(task.status).toBe('failed');\n  });\n\n  it('failed task is re-enqueued automatically when retries remain', () => {\n    queue.enqueue('work', { job: 'retry-me' });\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'transient error');\n\n    // After backoff delay, task should be available again\n    vi.advanceTimersByTime(1000); // first retry: 1000ms\n    const retried = queue.dequeue('work');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n  });\n\n  it('task attempts count is incremented on each retry', () => {\n    queue.enqueue('work', { job: 'count-attempts' });\n    const task = queue.dequeue('work')!;\n    expect(task.attempts).toBe(1);\n\n    queue.fail(task.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    const retry1 = queue.dequeue('work')!;\n    expect(retry1.attempts).toBe(2);\n  });\n\n  it('backoff delay increases exponentially between retries', () => {\n    queue.enqueue('work', { job: 'backoff-test' });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n\n    // First retry after 1000ms (1000 * 2^0)\n    vi.advanceTimersByTime(999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n\n    queue.fail(task.id, 'error 2');\n\n    // Second retry after 2000ms (1000 * 2^1)\n    vi.advanceTimersByTime(1999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n\n    queue.fail(task.id, 'error 3');\n\n    // Third retry after 4000ms (1000 * 2^2)\n    vi.advanceTimersByTime(3999);\n    expect(queue.dequeue('work')).toBeNull();\n    vi.advanceTimersByTime(1);\n    expect(queue.dequeue('work')).not.toBeNull();\n  });\n\n  it('respects maxRetries limit (default 3)', () => {\n    queue.enqueue('work', { job: 'limited' });\n\n    for (let i = 0; i < 3; i++) {\n      const task = queue.dequeue('work')!;\n      expect(task).not.toBeNull();\n      queue.fail(task.id, `error ${i + 1}`);\n      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    }\n\n    // Fourth attempt\n    const lastAttempt = queue.dequeue('work')!;\n    expect(lastAttempt).not.toBeNull();\n    queue.fail(lastAttempt.id, 'final error');\n\n    // No more retries - should not re-appear\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('accepts custom maxRetries option', () => {\n    queue.enqueue('work', { job: 'custom' }, { maxRetries: 1 });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n\n    // Second attempt (1 retry)\n    const retry = queue.dequeue('work')!;\n    expect(retry).not.toBeNull();\n    queue.fail(retry.id, 'error 2');\n\n    // No more retries\n    vi.advanceTimersByTime(100000);\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('retry preserves the original queue name', () => {\n    queue.enqueue('special-queue', { job: 'preserve-queue' });\n    const task = queue.dequeue('special-queue')!;\n    queue.fail(task.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    // Should appear in the same queue\n    const retried = queue.dequeue('special-queue');\n    expect(retried).not.toBeNull();\n    expect(retried!.id).toBe(task.id);\n\n    // Should not appear in other queues\n    expect(queue.dequeue('default')).toBeNull();\n  });\n\n  it('retry preserves the original priority', () => {\n    queue.enqueue('work', { job: 'high-pri' }, { priority: 1 });\n    queue.enqueue('work', { job: 'low-pri' }, { priority: 9 });\n\n    const highPri = queue.dequeue('work')!;\n    expect(highPri.payload).toEqual({ job: 'high-pri' });\n    queue.fail(highPri.id, 'error');\n    vi.advanceTimersByTime(1000);\n\n    // The retried high-priority task should still come before low-priority\n    const next = queue.dequeue('work')!;\n    expect(next.payload).toEqual({ job: 'high-pri' });\n  });\n});\n======== phase-06.test.ts\nimport { describe, it, expect, beforeEach, vi, afterEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 6: Dead Letter Queue', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    queue = new TaskQueue();\n  });\n\n  afterEach(() => {\n    vi.useRealTimers();\n  });\n\n  it('task moves to DLQ after exhausting all retries', () => {\n    queue.enqueue('work', { job: 'doomed' }, { maxRetries: 1 });\n\n    // First attempt\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n\n    // Second attempt (1 retry)\n    const retry = queue.dequeue('work')!;\n    queue.fail(retry.id, 'error 2');\n\n    // Should be in DLQ now\n    const dlq = queue.getDLQ('work');\n    expect(dlq.length).toBe(1);\n    expect(dlq[0].id).toBe(task.id);\n  });\n\n  it('getDLQ returns all dead-letter tasks for a queue', () => {\n    queue.enqueue('work', { job: 'doomed1' }, { maxRetries: 0 });\n    queue.enqueue('work', { job: 'doomed2' }, { maxRetries: 0 });\n\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error');\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq.length).toBe(2);\n  });\n\n  it('retryDLQ moves task back to its original queue', () => {\n    queue.enqueue('emails', { job: 'retry-dlq' }, { maxRetries: 0 });\n\n    const task = queue.dequeue('emails')!;\n    queue.fail(task.id, 'error');\n\n    expect(queue.getDLQ('emails').length).toBe(1);\n\n    const retried = queue.retryDLQ(task.id);\n    expect(retried).not.toBeNull();\n\n    // DLQ should be empty now\n    expect(queue.getDLQ('emails').length).toBe(0);\n\n    // Task should be back in the queue\n    const dequeued = queue.dequeue('emails');\n    expect(dequeued).not.toBeNull();\n    expect(dequeued!.id).toBe(task.id);\n  });\n\n  it('clearDLQ removes all DLQ tasks for a queue', () => {\n    queue.enqueue('work', { job: 'clear1' }, { maxRetries: 0 });\n    queue.enqueue('work', { job: 'clear2' }, { maxRetries: 0 });\n\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error');\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error');\n\n    expect(queue.getDLQ('work').length).toBe(2);\n    queue.clearDLQ('work');\n    expect(queue.getDLQ('work').length).toBe(0);\n  });\n\n  it('DLQ task retains original error information', () => {\n    queue.enqueue('work', { job: 'error-info' }, { maxRetries: 0 });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'specific error message');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq[0].lastError).toBe('specific error message');\n  });\n\n  it('DLQ task tracks failure count', () => {\n    queue.enqueue('work', { job: 'count-fails' }, { maxRetries: 2 });\n\n    // Fail through all retries\n    for (let i = 0; i < 2; i++) {\n      const task = queue.dequeue('work')!;\n      queue.fail(task.id, `error ${i}`);\n      vi.advanceTimersByTime(1000 * Math.pow(2, i));\n    }\n    const lastAttempt = queue.dequeue('work')!;\n    queue.fail(lastAttempt.id, 'final error');\n\n    const dlq = queue.getDLQ('work');\n    expect(dlq[0].failCount).toBe(3); // original + 2 retries = 3 failures\n  });\n\n  it('retried DLQ task gets a fresh retry count', () => {\n    queue.enqueue('work', { job: 'fresh-retries' }, { maxRetries: 1 });\n\n    // Exhaust retries\n    const t1 = queue.dequeue('work')!;\n    queue.fail(t1.id, 'error 1');\n    vi.advanceTimersByTime(1000);\n    const t2 = queue.dequeue('work')!;\n    queue.fail(t2.id, 'error 2');\n\n    // Should be in DLQ\n    expect(queue.getDLQ('work').length).toBe(1);\n\n    // Retry from DLQ\n    queue.retryDLQ(t1.id);\n    const retried = queue.dequeue('work')!;\n    expect(retried).not.toBeNull();\n    expect(retried.attempts).toBe(1); // fresh attempt count\n\n    // Should have fresh retries available\n    queue.fail(retried.id, 'new error');\n    vi.advanceTimersByTime(1000);\n    const retry = queue.dequeue('work');\n    expect(retry).not.toBeNull(); // can retry again\n  });\n});\n======== phase-07.test.ts\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { TaskQueue } from '../src/index.js';\n\ndescribe('Phase 7: Task Dependencies', () => {\n  let queue: TaskQueue;\n\n  beforeEach(() => {\n    queue = new TaskQueue();\n  });\n\n  it('task with dependencies is not available until deps complete', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    // Dequeue should return the dependency first (no deps blocking it)\n    const first = queue.dequeue('work');\n    expect(first!.payload).toEqual({ name: 'dependency' });\n\n    // Dependent should not be available yet\n    const second = queue.dequeue('work');\n    expect(second).toBeNull();\n  });\n\n  it('completing a dependency makes dependent task available', () => {\n    const dep = queue.enqueue('work', { name: 'dependency' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep.id] });\n\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    // Now the dependent should be available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('all dependencies must complete before dependent is available', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    queue.enqueue('work', { name: 'dependent' }, { dependsOn: [dep1.id, dep2.id] });\n\n    // Process dep1\n    const task1 = queue.dequeue('work')!;\n    queue.complete(task1.id);\n\n    // dep2 should be available but dependent should not\n    const task2 = queue.dequeue('work')!;\n    expect(task2.payload).toEqual({ name: 'dep2' });\n\n    // Dependent still blocked (dep2 not completed yet)\n    expect(queue.dequeue('work')).toBeNull();\n\n    // Complete dep2\n    queue.complete(task2.id);\n\n    // Now dependent is available\n    const dependent = queue.dequeue('work');\n    expect(dependent).not.toBeNull();\n    expect(dependent!.payload).toEqual({ name: 'dependent' });\n  });\n\n  it('circular dependency throws an error', () => {\n    const a = queue.enqueue('work', { name: 'A' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [a.id] });\n\n    // Trying to make A depend on B creates a cycle\n    expect(() =>\n      queue.enqueue('work', { name: 'C' }, { dependsOn: [b.id, a.id] })\n    ).not.toThrow(); // C -> B -> A is fine, no cycle\n\n    // Direct cycle: X depends on Y, Y depends on X\n    const x = queue.enqueue('work', { name: 'X' });\n    queue.enqueue('work', { name: 'Y' }, { dependsOn: [x.id] });\n\n    // This should not throw since there's no actual circular dependency here\n    // A true circular dependency:\n    const m = queue.enqueue('work', { name: 'M' });\n    const n = queue.enqueue('work', { name: 'N' }, { dependsOn: [m.id] });\n    expect(() =>\n      queue.enqueue('work', { name: 'O' }, { dependsOn: [n.id, m.id] })\n    ).not.toThrow(); // O -> N -> M is fine\n\n    // Real cycle detection test\n    const p = queue.enqueue('other', { name: 'P' });\n    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n    // Cycle detection is verified above; with forward-only enqueue,\n    // cycles can only be detected at enqueue time through transitive dep chains.\n  });\n\n  it('getDependencies returns dependency info with statuses', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep1.id, dep2.id],\n    });\n\n    const deps = queue.getDependencies(dependent.id);\n    expect(deps).toHaveLength(2);\n    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n\n    // After completing one\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    const updatedDeps = queue.getDependencies(dependent.id);\n    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n    expect(completedDep!.status).toBe('completed');\n  });\n\n  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n    const c = queue.enqueue('work', { name: 'C' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n\n    // Only C is available\n    const taskC = queue.dequeue('work')!;\n    expect(taskC.payload).toEqual({ name: 'C' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskC.id);\n\n    // Now B is available\n    const taskB = queue.dequeue('work')!;\n    expect(taskB.payload).toEqual({ name: 'B' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskB.id);\n\n    // Now A is available\n    const taskA = queue.dequeue('work')!;\n    expect(taskA.payload).toEqual({ name: 'A' });\n    expect(taskA.id).toBe(a.id);\n  });\n\n  it('failed dependency does not auto-fail the dependent task', () => {\n    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep.id],\n    });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'dep failed');\n\n    // Dependent stays blocked (not failed)\n    expect(dependent.status).toBe('pending');\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('dependency on non-existent task throws an error', () => {\n    expect(() =>\n      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n    ).toThrow();\n  });\n});","is_error":false}]},"parent_tool_use_id":"toolu_012dTQdcT1k6rrfUoBmaJ1q4","session_id":"2dbaa2cb-485d-41ba-ae15-3484acaf3773","uuid":"543029a5-8e30-410d-8b70-84e40b952bff","timestamp":"2026-07-25T01:28:25.438Z","subagent_type":"conclave:code-reviewer","task_description":"Review implementation correctness"}
