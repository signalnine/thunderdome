+      queueName,
+      payload,
+      status: 'pending',
+      priority,
+      createdAt: new Date(now),
+      availableAt: new Date(availableAt),
+      attempts: 0,
+      maxRetries,
+      backoffMs,
+      dependsOn,
+      failCount: 0,
+      retriesUsed: 0,
+      seq: this.seqCounter++,
