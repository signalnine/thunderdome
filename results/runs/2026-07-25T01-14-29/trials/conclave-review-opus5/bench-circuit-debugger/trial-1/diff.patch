+import { compile, type Circuit } from './circuit.js';
+import { AdderTester, type SignalKind, type WireValues } from './tester.js';
+import { misnamedGates } from './roles.js';
+import { OP_AND, OP_OR, OP_XOR, type Gate } from './types.js';
+
+/** The puzzle always swaps exactly four pairs of gate outputs. */
+const SWAP_PAIRS = 4;
+
+/** Test vectors used while searching (32 per lane) and for final confirmation. */
+const SEARCH_WORDS = 4;
+const VERIFY_WORDS = 16;
+
+/** At most this many gates are considered as the source of a given signal. */
+const MAX_SIGNAL_SOURCES = 3;
+
+/** How far back along the carry chain a single repair may reach. */
+const MAX_REPAIR_DEPTH = 10;
+
+/**
+ * Safety valve so a pathological input can never run away. Reaching it makes
+ * the search give up, which reads as "no repair exists" and falls back to the
+ * structural answer. Real circuits need a few thousand evaluations at most.
+ */
+const MAX_EVALUATIONS = 400_000;
+
+/** One repair attempt: a set of gate pairs whose outputs get exchanged. */
+type Repair = Array<[number, number]>;
+
+/**
+ * Locate the eight wires whose gate outputs were swapped in a ripple-carry
+ * adder.
+ *
+ * The circuit is repaired from the least significant bit upwards. At each step
+ * the lowest output bit that adds incorrectly is found, and repairs are
+ * proposed for exactly that bit: a correct adder's internal signals are known
+ * functions of the inputs, so simulating the broken circuit reveals which gate
+ * *should* be driving the sum for that bit and which wires *should* be feeding
+ * it. Any repair that does not push the first failing bit higher is discarded,
+ * the search backtracks over plausible-but-wrong repairs, and the result is
+ * confirmed against an independent set of test vectors before it is accepted.
+ *
+ * Repairs are proposed rather than enumerated, so the cost grows with the size
+ * of the circuit rather than with the number of possible swap combinations.
+ *
+ * For a well-formed puzzle this returns exactly eight wire names. If no set of
+ * four swaps turns the circuit into an adder — because it is not a swapped
+ * adder at all, or because more than four pairs were exchanged — the answer
+ * falls back to the wires that are provably misnamed, which is a subset of the
+ * culprits and so may hold fewer than eight names.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const circuit = compile(gates);
+  if (circuit.numGates === 0 || circuit.numBits === 0 || circuit.numZ === 0) return [];
+
+  const found = searchSwaps(circuit);
+  const gateIndices = found ?? structuralSuspects(circuit);
+  return gateIndices.map((g) => circuit.wireNames[circuit.origOut[g]]).sort();
+}
+
+/** Depth-first search over repairs; returns the eight swapped gate indices. */
+function searchSwaps(circuit: Circuit): number[] | null {
+  const tester = new AdderTester(circuit, SEARCH_WORDS, 0x5eed1234);
+  const verifier = new AdderTester(circuit, VERIFY_WORDS, 0x0badc0de);
+  const outOf = Int32Array.from(circuit.origOut);
+  const used = new Uint8Array(circuit.numGates);
+  const chosen: number[] = [];
+  let evaluations = 0;
+
+  const applyRepair = (repair: Repair): void => {
+    for (const [g, h] of repair) {
+      const tmp = outOf[g];
+      outOf[g] = outOf[h];
+      outOf[h] = tmp;
+      used[g] = 1;
+      used[h] = 1;
+      chosen.push(g, h);
+    }
+  };
+
+  const undoRepair = (repair: Repair): void => {
+    for (let i = repair.length - 1; i >= 0; i--) {
+      const [g, h] = repair[i];
+      const tmp = outOf[g];
+      outOf[g] = outOf[h];
+      outOf[h] = tmp;
+      used[g] = 0;
+      used[h] = 0;
+      chosen.length -= 2;
+    }
+  };
+
+  const dfs = (depth: number): boolean => {
+    const bad = tester.firstBadBit(outOf);
+    if (bad === circuit.numZ) {
+      return depth === SWAP_PAIRS && verifier.isCorrect(outOf);
+    }
+    if (depth === SWAP_PAIRS) return false;
+
+    for (const repair of repairsFor(circuit, tester, outOf, used, bad, SWAP_PAIRS - depth)) {
+      if (++evaluations > MAX_EVALUATIONS) return false;
+      applyRepair(repair);
+      const improved = tester.firstBadBit(outOf) > bad;
+      if (improved && dfs(depth + repair.length)) return true;
+      undoRepair(repair);
+    }
+    return false;
+  };
+
+  return dfs(0) ? chosen.slice() : null;
+}
+
+/**
+ * Repairs worth trying for a wrong output bit, most promising first.
+ *
+ * The signal-directed repairs come first because they are few and precise; the
+ * exhaustive single-swap sweep is a safety net for circuits whose broken state
+ * hides the signals the first strategy looks for.
+ */
+function* repairsFor(
+  circuit: Circuit,
+  tester: AdderTester,
+  outOf: Int32Array,
+  used: Uint8Array,
+  bad: number,
+  budget: number,
+): Generator<Repair> {
+  const seen = new Set<string>();
+  const emit = function* (repair: Repair): Generator<Repair> {
+    if (repair.length === 0 || repair.length > budget) return;
+    const gatesInRepair = repair.flat();
+    if (new Set(gatesInRepair).size !== gatesInRepair.length) return;
+    if (gatesInRepair.some((g) => used[g] === 1)) return;
+    const key = repair
+      .map(([g, h]) => (g < h ? `${g}-${h}` : `${h}-${g}`))
+      .sort()
+      .join(',');
+    if (seen.has(key)) return;
+    seen.add(key);
+    yield repair;
+  };
+
+  // Fewer swaps first: a repair that needs three exchanges to fix one bit is
+  // far more likely to be a coincidence than one that needs a single swap.
+  const signals = signalRepairs(circuit, tester, outOf, bad, budget);
+  signals.sort((a, b) => a.length - b.length);
+  for (const repair of signals) yield* emit(repair);
+  for (const repair of sweepRepairs(circuit, outOf, bad)) yield* emit(repair);
+}
+
+/**
+ * Repairs derived from what a correct adder would compute.
+ *
+ * Bit `bad` is wrong, so the wire named `z{bad}` is not carrying the sum it
+ * should. Either some gate already computes that sum and merely has the wrong
+ * output name, or the gate that ought to drive it is being fed the wrong
+ * wires — in which case the gates driving those wires are swapped with the
+ * gates that do carry the needed signals.
+ */
+function signalRepairs(
+  circuit: Circuit,
+  tester: AdderTester,
+  outOf: Int32Array,
+  bad: number,
+  budget: number,
+): Repair[] {
+  const zWire = circuit.zWire[bad];
+  if (zWire < 0) return [];
+
+  const producer = new Int32Array(circuit.numWires).fill(-1);
+  for (let g = 0; g < circuit.numGates; g++) producer[outOf[g]] = g;
+  if (producer[zWire] < 0) return [];
+
+  const context: RepairContext = {
+    circuit,
+    producer,
+    misnamed: misnamedGates(circuit, outOf),
+    carriers: makeCarrierIndex(circuit, tester, tester.snapshot(outOf), outOf),
+  };
+  // The output bit above the register width is the final carry; the rest are sums.
+  const target: [SignalKind, number] =
+    bad === circuit.numBits ? ['carry', circuit.numBits - 1] : ['sum', bad];
+  return repairsToCarry(context, zWire, target[0], target[1], budget, 0).filter((r) => r.length > 0);
+}
+
+/** Which wires and gates currently carry a given signal of a correct adder. */
+interface Carriers {
+  wires: Uint8Array;
+  gates: number[];
+}
+
+interface RepairContext {
+  circuit: Circuit;
+  producer: Int32Array;
+  /** gates whose output name is structurally impossible, so certainly swapped */
+  misnamed: Uint8Array;
+  carriers: (kind: SignalKind, bit: number) => Carriers | null;
+}
+
+/** Locates the carriers of each signal on demand, remembering the answers. */
+function makeCarrierIndex(
+  circuit: Circuit,
+  tester: AdderTester,
+  wireValues: WireValues,
+  outOf: Int32Array,
+): (kind: SignalKind, bit: number) => Carriers | null {
+  const cache = new Map<string, Carriers | null>();
+  return (kind, bit) => {
+    const key = `${kind}${bit}`;
+    const cached = cache.get(key);
+    if (cached !== undefined) return cached;
+    const values = tester.signal(kind, bit);
+    let carriers: Carriers | null = null;
+    if (values !== null) {
+      const wires = wireValues.markCarriers(values);
+      const gates: number[] = [];
+      for (let g = 0; g < circuit.numGates; g++) {
+        if (wires[outOf[g]] === 1) gates.push(g);
+      }
+      carriers = { wires, gates };
+    }
+    cache.set(key, carriers);
+    return carriers;
+  };
+}
+
+/** How a correct adder builds each signal out of two others. */
+function decompose(
+  kind: SignalKind,
+  bit: number,
+): { op: number; parts: [[SignalKind, number], [SignalKind, number]] } | null {
+  // Bit 0 is a half adder: its sum and carry come straight from the register
+  // bits, so they are produced by a single gate and cannot be broken down.
+  if (bit <= 0) return null;
+  switch (kind) {
+    case 'sum':
+      return { op: OP_XOR, parts: [['partial', bit], ['carry', bit - 1]] };
+    case 'propagate':
+      return { op: OP_AND, parts: [['partial', bit], ['carry', bit - 1]] };
+    case 'carry':
+      return { op: OP_OR, parts: [['generate', bit], ['propagate', bit]] };
+    default:
+      // `partial` and `generate` are read straight off the register bits.
+      return null;
+  }
+}
+
+/**
+ * Ways to make `wire` carry the given signal, using at most `budget` swaps.
+ *
+ * An empty repair means the wire already carries it. Otherwise either some
+ * gate already computes the signal and only needs to be re-pointed at this
+ * wire, or the gate that ought to drive the wire is being fed the wrong
+ * signals, which is fixed the same way one level up.
+ */
+function repairsToCarry(
+  context: RepairContext,
+  wire: number,
+  kind: SignalKind,
+  bit: number,
+  budget: number,
+  depth: number,
+): Repair[] {
+  const { circuit, producer } = context;
+  const target = context.carriers(kind, bit);
+  if (target === null) return [];
+  if (target.wires[wire] === 1) return [[]];
+  if (budget <= 0 || depth >= MAX_REPAIR_DEPTH) return [];
+  const driver = producer[wire];
+  if (driver < 0) return []; // a register input; nothing drives it
+
+  const repairs: Repair[] = [];
+  for (const source of target.gates.slice(0, MAX_SIGNAL_SOURCES)) {
+    if (source !== driver) repairs.push([[driver, source]]);
+  }
+
+  const recipe = decompose(kind, bit);
+  if (recipe === null) return repairs;
+  const [[kindA, bitA], [kindB, bitB]] = recipe.parts;
+  const carriersA = context.carriers(kindA, bitA);
+  const carriersB = context.carriers(kindB, bitB);
+  if (carriersA === null || carriersB === null) return repairs;
+
+  for (const gate of rebuildCandidates(context, recipe.op, driver, carriersA, carriersB, depth)) {
+    const head: Repair = gate === driver ? [] : [[driver, gate]];
+    const left = budget - head.length;
+    if (left < 0) continue;
+    for (const [first, second] of [
+      [circuit.in1[gate], circuit.in2[gate]],
+      [circuit.in2[gate], circuit.in1[gate]],
+    ]) {
+      const fixesFirst = repairsToCarry(context, first, kindA, bitA, left, depth + 1);
+      const fixesSecond = repairsToCarry(context, second, kindB, bitB, left, depth + 1);
+      // A single swap can put both inputs right at once, so half-repairs are
+      // offered as well; whether they are enough is settled by simulation.
+      for (const fixFirst of fixesFirst) {
+        repairs.push([...head, ...fixFirst]);
+        for (const fixSecond of fixesSecond) {
+          if (fixFirst.length + fixSecond.length > left) continue;
+          repairs.push([...head, ...fixFirst, ...fixSecond]);
+        }
+      }
+      for (const fixSecond of fixesSecond) repairs.push([...head, ...fixSecond]);
+    }
+  }
+  return repairs;
+}
+
+/**
+ * Gates that might be the one meant to produce a signal.
+ *
+ * At the top level every gate with the right operation is worth a try. Deeper
+ * in the recursion the list is narrowed to the gate currently driving the
+ * wire, gates that already read one of the two signals they would need, and
+ * gates already known to be misnamed.
+ */
+function rebuildCandidates(
+  context: RepairContext,
+  op: number,
+  driver: number,
+  carriersA: Carriers,
+  carriersB: Carriers,
+  depth: number,
+): number[] {
+  const { circuit, misnamed } = context;
+  const candidates: number[] = [];
+  for (let g = 0; g < circuit.numGates; g++) {
+    if (circuit.op[g] !== op) continue;
+    const reads =
+      carriersA.wires[circuit.in1[g]] === 1 ||
+      carriersA.wires[circuit.in2[g]] === 1 ||
+      carriersB.wires[circuit.in1[g]] === 1 ||
+      carriersB.wires[circuit.in2[g]] === 1;
+    if (depth === 0 || g === driver || misnamed[g] === 1 || reads) candidates.push(g);
+  }
+  return candidates;
+}
+
+/**
+ * Every single swap that could possibly change output bit `bad`: one of the
+ * two gates has to lie in that bit's fan-in cone, otherwise the bit cannot
+ * move. Gates outside the cone of the bit below come first, and partners are
+ * ordered by how close they sit to `bad` in the adder chain.
+ */
+function* sweepRepairs(circuit: Circuit, outOf: Int32Array, bad: number): Generator<Repair> {
+  const producer = new Int32Array(circuit.numWires).fill(-1);
+  for (let g = 0; g < circuit.numGates; g++) producer[outOf[g]] = g;
+
+  const cone = fanInCone(circuit, producer, circuit.zWire[bad]);
+  const lowerCone = bad > 0 ? fanInCone(circuit, producer, circuit.zWire[bad - 1]) : null;
+  const primary: number[] = [];
+  const secondary: number[] = [];
+  for (let g = 0; g < circuit.numGates; g++) {
+    if (cone[g] === 0) continue;
+    if (lowerCone !== null && lowerCone[g] === 1) secondary.push(g);
+    else primary.push(g);
+  }
+
+  const distance = (g: number): number =>
+    circuit.level[g] < 0 ? circuit.numGates : Math.abs(circuit.level[g] - bad);
+  const partners = Array.from({ length: circuit.numGates }, (_, g) => g).sort(
+    (a, b) => distance(a) - distance(b) || a - b,
+  );
+
+  for (const g of primary.concat(secondary)) {
+    for (const h of partners) {
+      if (h !== g) yield [[g, h]];
+    }
+  }
+}
+
+/** Gates that can influence `wire`, marked in a per-gate byte map. */
+function fanInCone(circuit: Circuit, producer: Int32Array, wire: number): Uint8Array {
+  const seen = new Uint8Array(circuit.numGates);
+  if (wire < 0) return seen;
+  const start = producer[wire];
+  if (start < 0) return seen;
+  const stack = [start];
+  seen[start] = 1;
+  while (stack.length > 0) {
+    const g = stack.pop() as number;
+    for (const wireIn of [circuit.in1[g], circuit.in2[g]]) {
+      const source = producer[wireIn];
+      if (source >= 0 && seen[source] === 0) {
+        seen[source] = 1;
+        stack.push(source);
+      }
+    }
+  }
+  return seen;
+}
+
+/**
+ * Fallback for the case where the search cannot repair the circuit, which
+ * should not happen for a well-formed puzzle input: report the gates that are
+ * provably misnamed. That is a subset of the answer rather than all of it, but
+ * everything in it is certainly wrong.
+ */
+function structuralSuspects(circuit: Circuit): number[] {
+  const misnamed = misnamedGates(circuit, circuit.origOut);
+  const suspects: number[] = [];
+  for (let g = 0; g < circuit.numGates; g++) {
+    if (misnamed[g] === 1) suspects.push(g);
+  }
+  return suspects.slice(0, 2 * SWAP_PAIRS);
+}
