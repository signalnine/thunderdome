+import { encodeOp, type Gate } from './types.js';
+
+/**
+ * A circuit compiled into flat typed arrays.
+ *
+ * Gate *inputs* are fixed; only the mapping from gate to output wire changes
+ * while searching for swaps, so everything that depends solely on the inputs
+ * is precomputed once here.
+ */
+export interface Circuit {
+  numGates: number;
+  numWires: number;
+  wireNames: string[];
+  op: Uint8Array;
+  in1: Int32Array;
+  in2: Int32Array;
+  /** output wire of each gate as given (i.e. possibly swapped) */
+  origOut: Int32Array;
+  /** number of inputs of each gate that are driven by another gate */
+  baseMissing: Int32Array;
+  /** gates that depend only on source wires, so they can always fire first */
+  seedGates: Int32Array;
+  /** CSR adjacency: gates that read a given wire */
+  readersStart: Int32Array;
+  readersList: Int32Array;
+  /** true for wires that no gate drives (the x/y register bits) */
+  isSource: Uint8Array;
+  /** wire id of x{i} / y{i} / z{i}, or -1 when absent */
+  xWire: Int32Array;
+  yWire: Int32Array;
+  zWire: Int32Array;
+  /** bit index of each x/y wire, or -1 for other wires */
+  registerBit: Int32Array;
+  /** bit index of each z wire, or -1 for other wires */
+  outputBit: Int32Array;
+  /** number of input bits (x00..x{numBits-1}) */
+  numBits: number;
+  /** number of output bits (z00..z{numZ-1}) */
+  numZ: number;
+  /**
+   * Highest x/y bit index feeding each gate in the circuit as given, or -1.
+   * Only used to order the swap search, so approximation is harmless.
+   */
+  level: Int32Array;
+}
+
+const REGISTER_WIRE = /^([xyz])(\d+)$/;
+
+export function compile(gates: Gate[]): Circuit {
+  const numGates = gates.length;
+  const wireIds = new Map<string, number>();
+  const wireNames: string[] = [];
+  const idOf = (name: string): number => {
+    let id = wireIds.get(name);
+    if (id === undefined) {
+      id = wireNames.length;
+      wireIds.set(name, id);
+      wireNames.push(name);
+    }
+    return id;
+  };
+
+  const op = new Uint8Array(numGates);
+  const in1 = new Int32Array(numGates);
+  const in2 = new Int32Array(numGates);
+  const origOut = new Int32Array(numGates);
+  for (let g = 0; g < numGates; g++) {
+    const gate = gates[g];
+    op[g] = encodeOp(gate.op);
+    in1[g] = idOf(gate.in1);
+    in2[g] = idOf(gate.in2);
+    origOut[g] = idOf(gate.out);
+  }
+
+  const numWires = wireNames.length;
+  const isSource = new Uint8Array(numWires).fill(1);
+  for (let g = 0; g < numGates; g++) {
+    if (isSource[origOut[g]] === 0) {
+      throw new Error(`wire ${wireNames[origOut[g]]} is driven by more than one gate`);
+    }
+    isSource[origOut[g]] = 0;
+  }
+
+  // CSR index of gate inputs, counting a wire twice if a gate reads it twice.
+  const readersStart = new Int32Array(numWires + 1);
+  for (let g = 0; g < numGates; g++) {
+    readersStart[in1[g] + 1]++;
+    readersStart[in2[g] + 1]++;
+  }
+  for (let w = 0; w < numWires; w++) readersStart[w + 1] += readersStart[w];
+  const readersList = new Int32Array(readersStart[numWires]);
+  const cursor = Int32Array.from(readersStart.subarray(0, numWires));
+  for (let g = 0; g < numGates; g++) {
+    readersList[cursor[in1[g]]++] = g;
+    readersList[cursor[in2[g]]++] = g;
+  }
+
+  const baseMissing = new Int32Array(numGates);
+  const seeds: number[] = [];
+  for (let g = 0; g < numGates; g++) {
+    const missing = (isSource[in1[g]] ? 0 : 1) + (isSource[in2[g]] ? 0 : 1);
+    baseMissing[g] = missing;
+    if (missing === 0) seeds.push(g);
+  }
+
+  // Locate the x / y / z register bits.
+  const registerBit = new Int32Array(numWires).fill(-1);
+  const outputBit = new Int32Array(numWires).fill(-1);
+  const bitsOf: Record<string, Map<number, number>> = { x: new Map(), y: new Map(), z: new Map() };
+  for (let w = 0; w < numWires; w++) {
+    const match = REGISTER_WIRE.exec(wireNames[w]);
+    if (match === null) continue;
+    const bit = Number(match[2]);
+    bitsOf[match[1]].set(bit, w);
+    if (match[1] === 'z') outputBit[w] = bit;
+    else registerBit[w] = bit;
+  }
+
+  // The adder is only as wide as its uninterrupted run of input bits, and it
+  // has one output bit more than that. Reading the widths off the highest wire
+  // name instead would let a single stray label such as `z9999` inflate every
+  // per-bit array in the search. Register and output bits past that run are
+  // left out of the per-bit arrays below, so a circuit with a hole in its
+  // inputs is analysed up to the hole and no further.
+  let numBits = 0;
+  while (bitsOf.x.has(numBits) && bitsOf.y.has(numBits)) numBits++;
+  const numZ = numBits === 0 ? 0 : numBits + 1;
+  const toArray = (map: Map<number, number>, size: number): Int32Array => {
+    const arr = new Int32Array(size).fill(-1);
+    for (const [bit, wire] of map) if (bit < size) arr[bit] = wire;
+    return arr;
+  };
+
+  const circuit: Circuit = {
+    numGates,
+    numWires,
+    wireNames,
+    op,
+    in1,
+    in2,
+    origOut,
+    baseMissing,
+    seedGates: Int32Array.from(seeds),
+    readersStart,
+    readersList,
+    isSource,
+    xWire: toArray(bitsOf.x, numBits),
+    yWire: toArray(bitsOf.y, numBits),
+    zWire: toArray(bitsOf.z, numZ),
+    registerBit,
+    outputBit,
+    numBits,
+    numZ,
+    level: new Int32Array(numGates).fill(-1),
+  };
+  computeLevels(circuit);
+  return circuit;
+}
+
+/** Highest x/y bit index in each gate's fan-in cone (as given). */
+function computeLevels(circuit: Circuit): void {
+  const { numGates, numWires, in1, in2, origOut, level } = circuit;
+  const wireLevel = new Int32Array(numWires).fill(-1);
+  for (let w = 0; w < numWires; w++) {
+    const match = REGISTER_WIRE.exec(circuit.wireNames[w]);
+    if (match !== null && match[1] !== 'z') wireLevel[w] = Number(match[2]);
+  }
+
+  const missing = Int32Array.from(circuit.baseMissing);
+  const queue = new Int32Array(numGates);
+  queue.set(circuit.seedGates);
+  let head = 0;
+  let tail = circuit.seedGates.length;
+  while (head < tail) {
+    const g = queue[head++];
+    const out = origOut[g];
+    wireLevel[out] = Math.max(wireLevel[in1[g]], wireLevel[in2[g]]);
+    level[g] = wireLevel[out];
+    for (let p = circuit.readersStart[out]; p < circuit.readersStart[out + 1]; p++) {
+      const reader = circuit.readersList[p];
+      if (--missing[reader] === 0) queue[tail++] = reader;
+    }
+  }
+}
