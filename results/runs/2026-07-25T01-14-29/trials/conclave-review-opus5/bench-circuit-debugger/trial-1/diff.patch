ucer = new Int32Array(circuit.numWires).fill(-1);\n  for (let g = 0; g < circuit.numGates; g++) producer[outOf[g]] = g;\n  if (producer[zWire] < 0) return [];\n\n  const context: RepairContext = { circuit, tester, outOf, producer };\n  // The top output bit is the final carry; every other one is a sum.\n  const target: [SignalKind, number] =\n    bad === circuit.numZ - 1 ? ['carry', circuit.numBits - 1] : ['sum', bad];\n  return repairsToCarry(context, zWire, target[0], target[1], budget, 0).filter((r) => r.length > 0);\n}\n\ninterface RepairContext {\n  circuit: Circuit;\n  tester: AdderTester;\n  outOf: Int32Array;\n  producer: Int32Array;\n}\n\n/** How a correct adder builds each signal out of two others. */\nfunction decompose(\n  kind: SignalKind,\n  bit: number,\n): { op: number; parts: [[SignalKind, number], [SignalKind, number]] } | null {\n  // Bit 0 is a half adder: its sum and carry come straight from the register\n  // bits, so they are produced by a single gate and cannot be broken down.\n  if (bit <= 0) return null;\n  switch (kind) {\n    case 'sum':\n      return { op: OP_XOR, parts: [['partial', bit], ['carry', bit - 1]] };\n    case 'propagate':\n      return { op: OP_AND, parts: [['partial', bit], ['carry', bit - 1]] };\n    case 'carry':\n      return { op: OP_OR, parts: [['generate', bit], ['propagate', bit]] };\n    default:\n      // `partial` and `generate` are read straight off the register bits.\n      return null;\n  }\n}\n\n/**\n * Ways to make `wire` carry the given signal, using at most `budget` swaps.\n *\n * An empty repair means the wire already carries it. Otherwise either some\n * gate already computes the signal and only needs to be re-pointed at this\n * wire, or the gate that ought to drive the wire is being fed the wrong\n * signals, which is fixed the same way one level up.\n */\nfunction repairsToCarry(\n  context: RepairContext,\n  wire: number,\n  kind: SignalKind,\n  bit: number,\n  budget: number,\n  depth: number,\n): Repair[] {\n  const { circuit, tester, outOf, producer } = context;\n  const values = tester.signal(kind, bit);\n  if (values === null) return [];\n  if (tester.wireCarries(wire, values)) return [[]];\n  if (budget <= 0 || depth >= MAX_REPAIR_DEPTH) return [];\n  const driver = producer[wire];\n  if (driver < 0) return []; // a register input; nothing drives it\n\n  const repairs: Repair[] = [];\n  for (const source of tester.gatesCarrying(outOf, values).slice(0, MAX_SIGNAL_SOURCES)) {\n    if (source !== driver) repairs.push([[driver, source]]);\n  }\n\n  const recipe = decompose(kind, bit);\n  if (recipe === null) return repairs;\n  const [[kindA, bitA], [kindB, bitB]] = recipe.parts;\n  const valuesA = tester.signal(kindA, bitA);\n  const valuesB = tester.signal(kindB, bitB);\n  if (valuesA === null || valuesB === null) return repairs;\n\n  for (const gate of rebuildCandidates(context, recipe.op, driver, valuesA, valuesB, depth)) {\n    const head: Repair = gate === driver ? [] : [[driver, gate]];\n    const left = budget - head.length;\n    if (left < 0) continue;\n    for (const [first, second] of [\n      [circuit.in1[gate], circuit.in2[gate]],\n      [circuit.in2[gate], circuit.in1[gate]],\n    ]) {\n      for (const fixFirst of repairsToCarry(context, first, kindA, bitA, left, depth + 1)) {\n        const rest = left - fixFirst.length;\n        if (rest < 0) continue;\n        for (const fixSecond of repairsToCarry(context, second, kindB, bitB, rest, depth + 1)) {\n          if (fixSecond.length > rest) continue;\n          repairs.push([...head, ...fixFirst, ...fixSecond]);\n        }\n      }\n    }\n  }\n  return repairs;\n}\n\n/**\n * Gates that might be the one meant to produce a signal.\n *\n * At the top level every gate with the right operation is worth a try. Deeper\n * in the recursion the list is narrowed to gates that already read one of the\n * two signals they need, plus the gate currently driving the wire.\n */\nfunction rebuildCandidates(\n  context: RepairContext,\n  op: number,\n  driver: number,\n  valuesA: Int32Array,\n  valuesB: Int32Array,\n  depth: number,\n): number[] {\n  const { circuit, tester } = context;\n  const candidates: number[] = [];\n  for (let g = 0; g < circuit.numGates; g++) {\n    if (circuit.op[g] !== op) continue;\n    if (depth === 0 || g === driver) {\n      candidates.push(g);\n      continue;\n    }\n    const reads = (values: Int32Array): boolean =>\n      tester.wireCarries(circuit.in1[g], values) || tester.wireCarries(circuit.in2[g], values);\n    if (reads(valuesA) || reads(valuesB)) candidates.push(g);\n  }\n  return candidates;\n}\n\n/**\n * Every single swap that could possibly change output bit `bad`: one of the\n * two gates has to lie in that bit's fan-in cone, otherwise the bit cannot\n * move. Gates outside the cone of the bit below come first, and partners are\n * ordered by how close they sit to `bad` in the adder chain.\n */\nfunction* sweepRepairs(circuit: Circuit, outOf: Int32Array, bad: number): Generator<Repair> {\n  const producer = new Int32Array(circuit.numWires).fill(-1);\n  for (let g = 0; g < circuit.numGates; g++) producer[outOf[g]] = g;\n\n  const cone = fanInCone(circuit, producer, circuit.zWire[bad]);\n  const lowerCone = bad > 0 ? fanInCone(circuit, producer, circuit.zWire[bad - 1]) : null;\n  const primary: number[] = [];\n  const secondary: number[] = [];\n  for (let g = 0; g < circuit.numGates; g++) {\n    if (cone[g] === 0) continue;\n    if (lowerCone !== null && lowerCone[g] === 1) secondary.push(g);\n    else primary.push(g);\n  }\n\n  const distance = (g: number): number =>\n    circuit.level[g] < 0 ? circuit.numGates : Math.abs(circuit.level[g] - bad);\n  const partners = Array.from({ length: circuit.numGates }, (_, g) => g).sort(\n    (a, b) => distance(a) - distance(b) || a - b,\n  );\n\n  for (const g of primary.concat(secondary)) {\n    for (const h of partners) {\n      if (h !== g) yield [[g, h]];\n    }\n  }\n}\n\n/** Gates that can influence `wire`, marked in a per-gate byte map. */\nfunction fanInCone(circuit: Circuit, producer: Int32Array, wire: number): Uint8Array {\n  const seen = new Uint8Array(circuit.numGates);\n  if (wire < 0) return seen;\n  const start = producer[wire];\n  if (start < 0) return seen;\n  const stack = [start];\n  seen[start] = 1;\n  while (stack.length > 0) {\n    const g = stack.pop() as number;\n    for (const wireIn of [circuit.in1[g], circuit.in2[g]]) {\n      const source = producer[wireIn];\n      if (source >= 0 && seen[source] === 0) {\n        seen[source] = 1;\n        stack.push(source);\n      }\n    }\n  }\n  return seen;\n}\n\n/**\n * Rule-based fallback: gates that violate the shape of a ripple-carry adder.\n *\n * Only used if the search fails to repair the circuit, which should not happen\n * for a well-formed puzzle input.\n */\nfunction structuralSuspects(circuit: Circuit): number[] {\n  const { numGates, numZ, op, in1, in2, origOut, wireNames } = circuit;\n  const isBitZero = (wire: number): boolean => /^[xy]0*0$/.test(wireNames[wire]);\n  const isRegisterBit = (wire: number): boolean => /^[xy]\\d+$/.test(wireNames[wire]);\n  const topZWire = numZ > 0 ? circuit.zWire[numZ - 1] : -1;\n\n  const consumers: number[][] = Array.from({ length: circuit.numWires }, () => []);\n  for (let g = 0; g < numGates; g++) {\n    consumers[in1[g]].push(g);\n    consumers[in2[g]].push(g);\n  }\n\n  const suspects: number[] = [];\n  for (let g = 0; g < numGates; g++) {\n    const out = origOut[g];\n    const fedByRegister = isRegisterBit(in1[g]) && isRegisterBit(in2[g]);\n    const fedByBitZero = isBitZero(in1[g]) && isBitZero(in2[g]);\n    const downstream = consumers[out];\n\n    if (out === topZWire) {\n      // The most significant output bit is the final carry.\n      if (op[g] !== OP_OR && circuit.numBits > 1) suspects.push(g);\n    } else if (/^z\\d+$/.test(wireNames[out])) {\n      // Every other output bit is a sum, so it must come from an XOR.\n      if (