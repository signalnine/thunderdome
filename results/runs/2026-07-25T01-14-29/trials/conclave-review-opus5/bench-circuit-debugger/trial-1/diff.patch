).toEqual(found);\n   127\t  });\n   128\t\n   129\t  it('reports wires whose swap makes the circuit add correctly', () => {\n   130\t    const bits = 12;\n   131\t    const { gates, expected } = makeSwappedCircuit(bits, 4242);\n   132\t    const found = findSwappedWires(gates);\n   133\t    expect(found).toEqual(expected);\n   134\t    expect(somePairingRepairs(gates, found, bits)).toBe(true);\n   135\t  });\n   136\t\n   137\t  it('leaves an already correct adder alone (no swap improves it)', () => {\n   138\t    const bits = 8;\n   139\t    const gates = buildAdder(bits, mulberry32(17));\n   140\t    expect(addsCorrectly(gates, bits, mulberry32(1), 20)).toBe(true);\n   141\t    // With nothing broken the search cannot reach four swaps, so the\n   142\t    // structural fallback answers instead; it must not invent wires.\n   143\t    const found = findSwappedWires(gates);\n   144\t    expect(found).toEqual([]);\n   145\t  });\n   146\t\n   147\t  it('returns an empty array for an empty circuit', () => {\n   148\t    expect(findSwappedWires([])).toEqual([]);\n   149\t  });\n   150\t\n   151\t  it('does not crash on a circuit that is not an adder', () => {\n   152\t    const gates: Gate[] = [\n   153\t      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },\n   154\t      { op: 'OR', in1: 'x00', in2: 'y00', out: 'z01' },\n   155\t    ];\n   156\t    expect(Array.isArray(findSwappedWires(gates))).toBe(true);\n   157\t  });\n   158\t\n   159\t  it('rejects a wire driven by two gates', () => {\n   160\t    const gates: Gate[] = [\n   161\t      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },\n   162\t      { op: 'OR', in1: 'x00', in2: 'y00', out: 'z00' },\n   163\t    ];\n   164\t    expect(() => findSwappedWires(gates)).toThrow(/more than one gate/);\n   165\t  });\n   166\t\n   167\t  it('is unaffected by gate ordering', () => {\n   168\t    const { gates, expected } = makeSwappedCircuit(9, 555);\n   169\t    const shuffled = [...gates].reverse();\n   170\t    expect(findSwappedWires(shuffled)).toEqual(expected);\n   171\t    expect(simulate(shuffled, { x00: 1, y00: 1 }).x00).toBe(1);\n   172\t  });\n   173\t});\n===== package.json =====\n{\n  \"name\": \"bench-circuit-debugger\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Circuit debugger reasoning benchmark\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"lint\": \"eslint src/\",\n    \"test\": \"vitest run\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^25.2.3\",\n    \"@typescript-eslint/eslint-plugin\": \"^7.0.0\",\n    \"@typescript-eslint/parser\": \"^7.0.0\",\n    \"eslint\": \"^8.56.0\",\n    \"typescript\": \"^5.4.0\",\n    \"@vitest/coverage-v8\": \"^2.0.0\",\n    \"vitest\": \"^2.0.0\"\n  }\n}","is_error":false}]},"parent_tool_use_id":"toolu_01REPaQ7Q5E1w126CexppVT1","session_id":"724ec363-51f3-4528-90cb-67dc3f2d949d","uuid":"fc8d6db2-37ee-4c88-bfc1-a781a721a348","timestamp":"2026-07-25T03:21:05.246Z","subagent_type":"conclave:code-reviewer","task_description":"Review circuit debugger implementation"}
