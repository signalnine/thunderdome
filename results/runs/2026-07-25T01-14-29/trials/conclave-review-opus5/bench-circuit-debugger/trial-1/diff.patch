 (recipe === null) return repairs;\n  const [[kindA, bitA], [kindB, bitB]] = recipe.parts;\n  const valuesA = tester.signal(kindA, bitA);\n  const valuesB = tester.signal(kindB, bitB);\n  if (valuesA === null || valuesB === null) return repairs;\n\n  for (const gate of rebuildCandidates(context, recipe.op, driver, valuesA, valuesB, depth)) {\n    const head: Repair = gate === driver ? [] : [[driver, gate]];\n    const left = budget - head.length;\n    if (left < 0) continue;\n    for (const [first, second] of [\n      [circuit.in1[gate], circuit.in2[gate]],\n      [circuit.in2[gate], circuit.in1[gate]],\n    ]) {\n      const fixesFirst = repairsToCarry(context, first, kindA, bitA, left, depth + 1);\n      const fixesSecond = repairsToCarry(context, second, kindB, bitB, left, depth + 1);\n      // A single swap can put both inputs right at once, so half-repairs are\n      // offered as well; whether they are enough is settled by simulation.\n      for (const fixFirst of fixesFirst) {\n        repairs.push([...head, ...fixFirst]);\n        for (const fixSecond of fixesSecond) {\n          if (fixFirst.length + fixSecond.length > left) continue;\n          repairs.push([...head, ...fixFirst, ...fixSecond]);\n        }\n      }\n      for (const fixSecond of fixesSecond) repairs.push([...head, ...fixSecond]);\n    }\n  }\n  return repairs;\n}\n\n/**\n * Gates that might be the one meant to produce a signal.\n *\n * At the top level every gate with the right operation is worth a try. Deeper\n * in the recursion the list is narrowed to the gate currently driving the\n * wire, gates that already read one of the two signals they would need, and\n * gates already known to be misnamed.\n */\nfunction rebuildCandidates(\n  context: RepairContext,\n  op: number,\n  driver: number,\n  valuesA: Int32Array,\n  valuesB: Int32Array,\n  depth: number,\n): number[] {\n  const { circuit, tester, misnamed } = context;\n  const candidates: number[] = [];\n  for (let g = 0; g < circuit.n