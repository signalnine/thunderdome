+++ b/src/simulate.ts
@@ -0,0 +1,74 @@
+import type { Gate } from './types.js';
+
+function apply(op: Gate['op'], a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+    default:
+      throw new Error(`unknown gate operation: ${String(op)}`);
+  }
+}
+
+/**
+ * Evaluate a combinational circuit.
+ *
+ * Gates fire in dependency order — a gate only fires once both of its input
+ * wires have a value. A wire that no gate drives takes its value from
+ * `inputs`; a wire that a gate drives takes the gate's value, so seeding one
+ * in `inputs` does not short-circuit the gates that read it. Gates whose
+ * inputs never resolve (which cannot happen for the acyclic, fully driven
+ * circuits this is used with) are simply left out of the result.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values = new Map<string, number>();
+  for (const wire of Object.keys(inputs)) {
+    values.set(wire, inputs[wire] ? 1 : 0);
+  }
+
+  const driven = new Set<string>();
+  for (const gate of gates) {
+    if (driven.has(gate.out)) {
+      throw new Error(`wire ${gate.out} is driven by more than one gate`);
+    }
+    driven.add(gate.out);
+  }
+  const resolved = new Set([...values.keys()].filter((wire) => !driven.has(wire)));
+
+  // For each unresolved wire, the gates that are waiting on it.
+  const waiting = new Map<string, number[]>();
+  const missing = new Int32Array(gates.length);
+  const ready: number[] = [];
+
+  for (let i = 0; i < gates.length; i++) {
+    const gate = gates[i];
+    let pending = 0;
+    for (const wire of [gate.in1, gate.in2]) {
+      if (resolved.has(wire)) continue;
+      pending++;
+      const list = waiting.get(wire);
+      if (list === undefined) waiting.set(wire, [i]);
+      else list.push(i);
+    }
+    missing[i] = pending;
+    if (pending === 0) ready.push(i);
+  }
+
+  while (ready.length > 0) {
+    const gate = gates[ready.pop() as number];
+    values.set(gate.out, apply(gate.op, values.get(gate.in1) as number, values.get(gate.in2) as number));
+    resolved.add(gate.out);
+    const dependents = waiting.get(gate.out);
+    if (dependents === undefined) continue;
+    for (const dependent of dependents) {
+      if (--missing[dependent] === 0) ready.push(dependent);
+    }
+  }
+
+  const result: Record<string, number> = {};
+  for (const [wire, value] of values) result[wire] = value;
+  return result;
+}
