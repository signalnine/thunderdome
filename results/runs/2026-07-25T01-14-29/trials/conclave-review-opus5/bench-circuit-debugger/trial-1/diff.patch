 so a single pass over the gates checks `32 * words` additions.\n */\nexport class AdderTester {\n  readonly numTests: number;\n  private readonly words: number;\n  private readonly circuit: Circuit;\n  /** wire values, `words` lanes per wire */\n  private readonly vals: Int32Array;\n  /** initial wire values (only the x/y register bits are set) */\n  private readonly seedVals: Int32Array;\n  private readonly known: Uint8Array;\n  private readonly knownSeed: Uint8Array;\n  private readonly missing: Int32Array;\n  private readonly stack: Int32Array;\n  /** correct value of each z bit, `words` lanes per bit */\n  private readonly expected: Int32Array;\n  /** value of each internal signal of a correct adder, per bit */\n  private readonly signals: Record<SignalKind, Int32Array[]> = {\n    partial: [],\n    generate: [],\n    propagate: [],\n    carry: [],\n    sum: [],\n  };\n\n  constructor(circuit: Circuit, words: number, seed: number) {\n    this.circuit = circuit;\n    this.words = words;\n    this.numTests = words * 32;\n    this.vals = new Int32Array(circuit.numWires * words);\n    this.seedVals = new Int32Array(circuit.numWires * words);\n    this.known = new Uint8Array(circuit.numWires);\n    this.knownSeed = Uint8Array.from(circuit.isSource);\n    this.missing = new Int32Array(circuit.numGates);\n    this.stack = new Int32Array(circuit.numGates);\n    this.expected = new Int32Array(circuit.numZ * words);\n    this.fillTestVectors(seed);\n    this.buildSignals();\n  }\n\n  /** Values a correct adder would carry on each of its internal signals. */\n  private buildSignals(): void {\n    const { numBits, xWire, yWire } = this.circuit;\n    const w = this.words;\n    const lanesOf = (wire: number): Int32Array => this.seedVals.subarray(wire * w, wire * w + w);\n    const combine = (a: Int32Array, b: Int32Array, fn: (x: number, y: number) => number): Int32Array => {\n      const out = new Int32Array(w);\n      for (let k = 0; k < w; k++) out[k] = fn(a[k], b[k]);\n      return out;\n    };\n\n    let carry: Int32Array = new Int32Array(w);\n    for (let i = 0; i < numBits; i++) {\n      const x = lanesOf(xWire[i]);\n      const y = lanesOf(yWire[i]);\n      const partial = combine(x, y, (p, q) => p ^ q);\n      const generate = combine(x, y, (p, q) => p & q);\n      const propagate = combine(partial, carry, (p, q) => p & q);\n      const sum = combine(partial, carry, (p, q) => p ^ q);\n      carry = combine(generate, propagate, (p, q) => p | q);\n      this.signals.partial.push(partial);\n      this.signals.generate.push(generate);\n      this.signals.propagate.push(propagate);\n      this.signals.sum.push(sum);\n      this.signals.carry.push(carry);\n    }\n  }\n\n  /**\n   * Value a correct adder carries on signal `kind` of bit `bit`, or null when\n   * the bit is out of range. `carry` of bit -1 is the constant zero.\n   */\n  signal(kind: SignalKind, bit: number): Int32Array | null {\n    if (kind === 'carry' && bit === -1) return new Int32Array(this.words);\n    const list = this.signals[kind];\n    return bit >= 0 && bit < list.length ? list[bit] : null;\n  }\n\n  /** Recompute every wire value for the given output mapping. */\n  refresh(outOf: Int32Array): void {\n    this.evaluate(outOf);\n  }\n\n  /** True when `wire` currently carries exactly the given values. */\n  wireCarries(wire: number, values: Int32Array): boolean {\n    if (wire < 0 || this.known[wire] === 0) return false;\n    const base = wire * this.words;\n    for (let k = 0; k < this.words; k++) {\n      if (this.vals[base + k] !== values[k]) return false;\n    }\n    return true;\n  }\n\n  /** Flags every wire that currently carries the given values. */\n  markWiresCarrying(values: Int32Array): Uint8Array {\n    const marks = new Uint8Array(this.circuit.numWires);\n    for (let w = 0; w < this.circuit.numWires; w++) {\n      if (this.wireCarries(w, values)) marks[w] = 1;\n    }\n    return marks;\n  }\n\n  private fillTestVectors(seed: number): void {\n    const { numBits, numZ, xWire, yWire } = this.circuit;\n    const random = mulberry32(seed);\n    const mask = (1n << BigInt(numBits)) - 1n;\n    const randomValue = (): bigint => {\n      let v = 0n;\n      for (let i = 0; i < numBits; i += 30) {\n        v |= BigInt(Math.floor(random() * (1 << 30))) << BigInt(i);\n      }\n      return v & mask;\n    };\n\n    // A few structured vectors that stress carry propagation, then random ones.\n    const fixed: Array<[bigint, bigint]> = [\n      [0n, 0n],\n      [mask, 0n],\n      [0n, mask],\n      [mask, 1n],\n      [1n, mask],\n      [mask, mask],\n      [mask >> 1n, 1n],\n      [1n, 1n],\n    ];\n\n    for (let t = 0; t < this.numTests; t++) {\n      const [x, y] = t < fixed.length ? fixed[t] : [randomValue(), randomValue()];\n      const sum = x + y;\n      const lane = t >>> 5;\n      const bit = 1 << (t & 31);\n      for (let i = 0; i < numBits; i++) {\n        if ((x >> BigInt(i)) & 1n) this.seedVals[xWire[i] * this.words + lane] |= bit;\n        if ((y >> BigInt(i)) & 1n) this.seedVals[yWire[i] * this.words + lane] |= bit;\n      }\n      for (let i = 0; i < numZ; i++) {\n        if ((sum >> BigInt(i)) & 1n) this.expected[i * this.words + lane] |= bit;\n      }\n    }\n  }\n\n  /** Evaluate the circuit with `outOf[g]` as gate g's output wire. */\n  private evaluate(outOf: Int32Array): void {\n    const { op, in1, in2, baseMissing, seedGates, readersStart, readersList } = this.circuit;\n    const { vals, known, missing, stack, words } = this;\n    vals.set(this.seedVals);\n    known.set(this.knownSeed);\n    missing.set(baseMissing);\n    let sp = 0;\n    for (let i = 0; i < seedGates.length; i++) stack[sp++] = seedGates[i];\n\n    while (sp > 0) {\n      const g = stack[--sp];\n      const a = in1[g] * words;\n      const b = in2[g] * words;\n      const outWire = outOf[g];\n      const o = outWire * words;\n      const gateOp = op[g];\n      if (gateOp === OP_AND) {\n        for (let k = 0; k < words; k++) vals[o + k] = vals[a + k] & vals[b + k];\n      } else if (gateOp === OP_OR) {\n        for (let k = 0; k < words; k++) vals[o + k] = vals[a + k] | vals[b + k];\n      } else {\n        for (let k = 0; k < words; k++) vals[o + k] = vals[a + k] ^ vals[b + k];\n      }\n      known[outWire] = 1;\n      for (let p = readersStart[outWire], end = readersStart[outWire + 1]; p < end; p++) {\n        const reader = readersList[p];\n        if (--missing[reader] === 0) stack[sp++] = reader;\n      }\n    }\n  }\n\n  /**\n   * Index of the lowest output bit that is wrong (or never driven) for at\n   * least one test vector; `numZ` when the circuit adds correctly.\n   */\n  firstBadBit(outOf: Int32Array): number {\n    this.evaluate(outOf);\n    const { zWire, numZ } = this.circuit;\n    const { vals, known, expected, words } = this;\n    for (let i = 0; i < numZ; i++) {\n      const w = zWire[i];\n      if (w < 0 || known[w] === 0) return i;\n      const base = w * words;\n      const exp = i * words;\n      for (let k = 0; k < words; k++) {\n        if (vals[base + k] !== expected[exp + k]) return i;\n      }\n    }\n    return numZ;\n  }\n\n  isCorrect(outOf: Int32Array): boolean {\n    return this.firstBadBit(outOf) === this.circuit.numZ;\n  }\n}\n","structuredPatch":[{"oldStart":93,"oldLines":10,"newStart":93,"newLines":9,"lines":[" ","   /**","    * Value a correct adder carries on signal `kind` of bit `bit`, or null when","-   * the bit is out of range. `carry` of bit -1 is the constant zero.","+   * the bit is out of range.","    */","   signal(kind: SignalKind, bit: number): Int32Array | null {","-    if (kind === 'carry' && bit === -1) return new Int32Array(this.words);","     const list = this.signals[kind];","     return bit >= 0 && bit < list.length ? list[bit] : null;","   }"]}],"userModified":false,"replaceAll":false}}
