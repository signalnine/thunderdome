+import { describe, expect, it } from 'vitest';
+import { simulate } from '../src/index.js';
+import type { Gate } from '../src/index.js';
+import { addWithCircuit, buildAdder, mulberry32 } from './helpers.js';
+
+describe('simulate', () => {
+  it('applies each operation', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });
+  });
+
+  it('resolves gates in dependency order regardless of listing order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'q', in2: 'r', out: 'final' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'r' },
+      { op: 'OR', in1: 'a', in2: 'c', out: 'q' },
+    ];
+    const values = simulate(gates, { a: 0, b: 1, c: 1 });
+    expect(values).toEqual({ a: 0, b: 1, c: 1, q: 1, r: 1, final: 1 });
+  });
+
+  it('handles a deep chain of dependencies', () => {
+    const gates: Gate[] = [];
+    for (let i = 0; i < 500; i++) {
+      gates.push({ op: 'XOR', in1: `w${i}`, in2: 'one', out: `w${i + 1}` });
+    }
+    gates.reverse();
+    const values = simulate(gates, { w0: 0, one: 1 });
+    expect(values.w500).toBe(0);
+    expect(values.w499).toBe(1);
+  });
+
+  it('coerces truthy input values to 1', () => {
+    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];
+    expect(simulate(gates, { a: 1, b: 5 as number }).c).toBe(1);
+  });
+
+  it('lets a gate override a seeded value for the wire it drives', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'c', in2: 'one', out: 'd' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'c' },
+    ];
+    // `c` is seeded to 1 but the XOR drives it to 0, and `d` must see that 0.
+    expect(simulate(gates, { a: 1, b: 1, one: 1, c: 1 })).toEqual({
+      a: 1,
+      b: 1,
+      one: 1,
+      c: 0,
+      d: 0,
+    });
+  });
+
+  it('leaves unresolvable gates out of the result', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'missing', out: 'c' },
+      { op: 'OR', in1: 'c', in2: 'a', out: 'd' },
+    ];
+    expect(simulate(gates, { a: 1 })).toEqual({ a: 1 });
+  });
+
+  it('returns an empty result for no gates and no inputs', () => {
+    expect(simulate([], {})).toEqual({});
+  });
+
+  it('rejects a wire driven by two gates', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'c' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'c' },
+    ];
+    expect(() => simulate(gates, { a: 1, b: 0 })).toThrow(/more than one gate/);
+  });
+
+  it('rejects an unknown operation', () => {
+    const gates = [{ op: 'NAND', in1: 'a', in2: 'b', out: 'c' }] as unknown as Gate[];
+    expect(() => simulate(gates, { a: 1, b: 1 })).toThrow(/unknown gate operation/);
+  });
+
+  it('reproduces the example from the AoC-style puzzle', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'XOR', in1: 'x01', in2: 'y01', out: 'z01' },
+      { op: 'OR', in1: 'x02', in2: 'y02', out: 'z02' },
+    ];
+    const values = simulate(gates, { x00: 1, x01: 1, x02: 1, y00: 0, y01: 1, y02: 0 });
+    expect([values.z02, values.z01, values.z00]).toEqual([1, 0, 0]);
+  });
+
+  it('adds correctly through a generated ripple-carry adder', () => {
+    const bits = 8;
+    const gates = buildAdder(bits, mulberry32(42));
+    for (const [x, y] of [
+      [0n, 0n],
+      [1n, 1n],
+      [255n, 1n],
+      [255n, 255n],
+      [123n, 45n],
+    ] as Array<[bigint, bigint]>) {
+      expect(addWithCircuit(gates, bits, x, y)).toBe(x + y);
+    }
+  });
+});
