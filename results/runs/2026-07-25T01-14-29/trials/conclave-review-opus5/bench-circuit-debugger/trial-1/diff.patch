  first.out = b;\n    second.out = a;\n  }\n  return swapped;\n}\n\ndescribe('findSwappedWires', () => {\n  it('solves the four-bit adder from the task description', () => {\n    const gates = swapOutputs(fourBitAdder(), [\n      ['z00', 'c00'],\n      ['t02', 'a02'],\n      ['z03', 'b03'],\n      ['z01', 'a03'],\n    ]);\n    expect(findSwappedWires(gates)).toEqual([\n      'a02',\n      'a03',\n      'b03',\n      'c00',\n      't02',\n      'z00',\n      'z01',\n      'z03',\n    ]);\n    expect(addsCorrectly(fourBitAdder(), 4, mulberry32(2), 10)).toBe(true);\n    expect(addsCorrectly(gates, 4, mulberry32(2), 10)).toBe(false);\n  });\n\n  it('finds the swapped wires in a small adder', () => {\n    const { gates, expected } = makeSwappedCircuit(6, 7);\n    expect(findSwappedWires(gates)).toEqual(expected);\n  });\n\n  it('finds the swapped wires across many random circuits', () => {\n    for (let seed = 1; seed <= 25; seed++) {\n      const bits = 5 + (seed % 12);\n      const { gates, expected } = makeSwappedCircuit(bits, seed * 131);\n      expect(findSwappedWires(gates), `seed ${seed} (${bits} bits)`).toEqual(expected);\n    }\n  });\n\n  it('handles a 45-bit adder within the time budget', () => {\n    const { gates, expected } = makeSwappedCircuit(45, 20250725);\n    expect(gates.length).toBeGreaterThan(200);\n    const started = performance.now();\n    const found = findSwappedWires(gates);\n    const elapsed = performance.now() - started;\n    expect(found).toEqual(expected);\n    expect(elapsed).toBeLessThan(5000);\n  });\n\n  it('stays fast across several 45-bit circuits', () => {\n    for (const seed of [11, 222, 3333]) {\n      const { gates, expected } = makeSwappedCircuit(45, seed);\n      const started = performance.now();\n      expect(findSwappedWires(gates), `seed ${seed}`).toEqual(expected);\n      expect(performance.now() - started).toBeLessThan(5000);\n    }\n  });\n\n  it('returns wires sorted and de-duplicated', () => {\n    const { gates } = 