(gates, { a: 1, b: 1 })).toEqual({ a: 1, b: 1, and: 1, or: 1, xor: 0 });\n    15\t    expect(simulate(gates, { a: 0, b: 0 })).toEqual({ a: 0, b: 0, and: 0, or: 0, xor: 0 });\n    16\t  });\n    17\t\n    18\t  it('resolves gates in dependency order regardless of listing order', () => {\n    19\t    const gates: Gate[] = [\n    20\t      { op: 'AND', in1: 'q', in2: 'r', out: 'final' },\n    21\t      { op: 'XOR', in1: 'a', in2: 'b', out: 'r' },\n    22\t      { op: 'OR', in1: 'a', in2: 'c', out: 'q' },\n    23\t    ];\n    24\t    const values = simulate(gates, { a: 0, b: 1, c: 1 });\n    25\t    expect(values).toEqual({ a: 0, b: 1, c: 1, q: 1, r: 1, final: 1 });\n    26\t  });\n    27\t\n    28\t  it('handles a deep chain of dependencies', () => {\n    29\t    const gates: Gate[] = [];\n    30\t    for (let i = 0; i < 500; i++) {\n    31\t      gates.push({ op: 'XOR', in1: `w${i}`, in2: 'one', out: `w${i + 1}` });\n    32\t    }\n    33\t    gates.reverse();\n    34\t    const values = simulate(gates, { w0: 0, one: 1 });\n    35\t    expect(values.w500).toBe(0);\n    36\t    expect(values.w499).toBe(1);\n    37\t  });\n    38\t\n    39\t  it('coerces truthy input values to 1', () => {\n    40\t    const gates: Gate[] = [{ op: 'AND', in1: 'a', in2: 'b', out: 'c' }];\n    41\t    expect(simulate(gates, { a: 1, b: 5 as number }).c).toBe(1);\n    42\t  });\n    43\t\n    44\t  it('leaves unresolvable gates out of the result', () => {\n    45\t    const gates: Gate[] = [\n    46\t      { op: 'AND', in1: 'a', in2: 'missing', out: 'c' },\n    47\t      { op: 'OR', in1: 'c', in2: 'a', out: 'd' },\n    48\t    ];\n    49\t    expect(simulate(gates, { a: 1 })).toEqual({ a: 1 });\n    50\t  });\n    51\t\n    52\t  it('returns an empty result for no gates and no inputs', () => {\n    53\t    expect(simulate([], {})).toEqual({});\n    54\t  });\n    55\t\n    56\t  it('rejects an unknown operation', () => {\n    57\t    const gates = [{ op: 'NAND', in1: 'a', in2: 'b', out: 'c' 