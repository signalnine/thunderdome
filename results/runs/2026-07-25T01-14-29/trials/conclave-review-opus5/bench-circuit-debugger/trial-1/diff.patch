BigInt(Math.floor(random() * (1 << 30))) << BigInt(i);\n    83\t    return v & mask;\n    84\t  };\n    85\t  const cases: Array<[bigint, bigint]> = [\n    86\t    [0n, 0n],\n    87\t    [mask, 1n],\n    88\t    [mask, mask],\n    89\t  ];\n    90\t  for (let i = 0; i < trials; i++) cases.push([randomValue(), randomValue()]);\n    91\t  for (const [x, y] of cases) {\n    92\t    try {\n    93\t      if (addWithCircuit(gates, bits, x, y) !== x + y) return false;\n    94\t    } catch {\n    95\t      return false;\n    96\t    }\n    97\t  }\n    98\t  return true;\n    99\t}\n   100\t\n   101\t/** True when every gate output resolves, i.e. the circuit has no cycle. */\n   102\texport function isAcyclic(gates: Gate[], bits: number): boolean {\n   103\t  const inputs: Record<string, number> = {};\n   104\t  for (let i = 0; i < bits; i++) {\n   105\t    inputs[`x${pad(i)}`] = 0;\n   106\t    inputs[`y${pad(i)}`] = 0;\n   107\t  }\n   108\t  const values = simulate(gates, inputs);\n   109\t  return gates.every((g) => values[g.out] !== undefined);\n   110\t}\n   111\t\n   112\texport interface SwappedCircuit {\n   113\t  gates: Gate[];\n   114\t  expected: string[];\n   115\t}\n   116\t\n   117\t/**\n   118\t * Apply four independently detectable output swaps to a correct adder.\n   119\t * Retries until every swap on its own breaks the adder, so the answer is\n   120\t * unambiguous.\n   121\t */\n   122\texport function makeSwappedCircuit(bits: number, seed: number): SwappedCircuit {\n   123\t  const random = mulberry32(seed);\n   124\t  const base = buildAdder(bits, random);\n   125\t\n   126\t  for (let attempt = 0; attempt < 500; attempt++) {\n   127\t    const picks: number[] = [];\n   128\t    const taken = new Set<number>();\n   129\t    while (picks.length < 8) {\n   130\t      const g = Math.floor(random() * base.length);\n   131\t      if (!taken.has(g)) {\n   132\t        taken.add(g);\n   133\t        picks.push(g);\n   134\t      }\n   135\t    }\n   136\t  