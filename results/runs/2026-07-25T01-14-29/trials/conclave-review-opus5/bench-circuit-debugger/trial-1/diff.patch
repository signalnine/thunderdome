 op, in1, in2, baseMissing, seedGates, readersStart, readersList } = this.circuit;\n   176\t    const { vals, known, missing, stack, words } = this;\n   177\t    vals.set(this.seedVals);\n   178\t    known.set(this.knownSeed);\n   179\t    missing.set(baseMissing);\n   180\t    let sp = 0;\n   181\t    for (let i = 0; i < seedGates.length; i++) stack[sp++] = seedGates[i];\n   182\t\n   183\t    while (sp > 0) {\n   184\t      const g = stack[--sp];\n   185\t      const a = in1[g] * words;\n   186\t      const b = in2[g] * words;\n   187\t      const outWire = outOf[g];\n   188\t      const o = outWire * words;\n   189\t      const gateOp = op[g];\n   190\t      if (gateOp === OP_AND) {\n   191\t        for (let k = 0; k < words; k++) vals[o + k] = vals[a + k] & vals[b + k];\n   192\t      } else if (gateOp === OP_OR) {\n   193\t        for (let k = 0; k < words; k++) vals[o + k] = vals[a + k] | vals[b + k];\n   194\t      } else {\n   195\t        for (let k = 0; k < words; k++) vals[o + k] = vals[a + k] ^ vals[b + k];\n   196\t      }\n   197\t      known[outWire] = 1;\n   198\t      for (let p = readersStart[outWire], end = readersStart[outWire + 1]; p < end; p++) {\n   199\t        const reader = readersList[p];\n   200\t        if (--missing[reader] === 0) stack[sp++] = reader;\n   201\t      }\n   202\t    }\n   203\t  }\n   204\t\n   205\t  /**\n   206\t   * Index of the lowest output bit that is wrong (or never driven) for at\n   207\t   * least one test vector; `numZ` when the circuit adds correctly.\n   208\t   */\n   209\t  firstBadBit(outOf: Int32Array): number {\n   210\t    this.evaluate(outOf);\n   211\t    const { zWire, numZ } = this.circuit;\n   212\t    const { vals, known, expected, words } = this;\n   213\t    for (let i = 0; i < numZ; i++) {\n   214\t      const w = zWire[i];\n   215\t      if (w < 0 || known[w] === 0) return i;\n   216\t      const base = w * words;\n   217\t      const exp = i * words;\n   218\t      for (let k = 0; k < words;