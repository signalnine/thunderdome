--- /dev/null
+++ b/src/types.ts
@@ -0,0 +1,31 @@
+/** The three logic operations a gate can perform. */
+export type GateOp = 'AND' | 'OR' | 'XOR';
+
+/** A single two-input logic gate. */
+export interface Gate {
+  op: GateOp;
+  /** input wire name */
+  in1: string;
+  /** input wire name */
+  in2: string;
+  /** output wire name */
+  out: string;
+}
+
+/** Numeric encodings of {@link GateOp}, used by the fast bit-parallel evaluator. */
+export const OP_AND = 0;
+export const OP_OR = 1;
+export const OP_XOR = 2;
+
+export function encodeOp(op: GateOp): number {
+  switch (op) {
+    case 'AND':
+      return OP_AND;
+    case 'OR':
+      return OP_OR;
+    case 'XOR':
+      return OP_XOR;
+    default:
+      throw new Error(`unknown gate operation: ${String(op)}`);
+  }
+}
diff --git a/tests/debugger.test.ts b/tests/debugger.test.ts
new file mode 100644
index 0000000..269853d
--- /dev/null
+++ b/tests/debugger.test.ts
@@ -0,0 +1,193 @@
+import { describe, expect, it } from 'vitest';
+import { findSwappedWires, simulate } from '../src/index.js';
+import type { Gate } from '../src/index.js';
+import { addsCorrectly, buildAdder, makeSwappedCircuit, mulberry32 } from './helpers.js';
+
+/** Every way of splitting a list into unordered pairs. */
+function pairings<T>(items: T[]): Array<Array<[T, T]>> {
+  if (items.length === 0) return [[]];
+  const [first, ...rest] = items;
+  const result: Array<Array<[T, T]>> = [];
+  for (let i = 0; i < rest.length; i++) {
+    const remaining = rest.filter((_, j) => j !== i);
+    for (const tail of pairings(remaining)) result.push([[first, rest[i]], ...tail]);
+  }
+  return result;
+}
+
+/** True when some pairing of the reported wires turns the circuit into an adder. */
+function somePairingRepairs(gates: Gate[], swapped: string[], bits: number): boolean {
+  const indexOf = new Map(gates.map((g, i) => [g.out, i]));
+  return pairings(swapped).some((pairs) => {
+    const fixed = gates.map((g) => ({ ...g }));
+    for (const [a, b] of pairs) {
+      const ia = indexOf.get(a) as number;
+      const ib = indexOf.get(b) as number;
+      fixed[ia].out = b;
+      fixed[ib].out = a;
+    }
+    return addsCorrectly(fixed, bits, mulberry32(3), 10);
+  });
+}
+
+/** The four-bit adder from the task description, wire for wire. */
+function fourBitAdder(): Gate[] {
+  return [
+    { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+    { op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' },
+    { op: 'XOR', in1: 'x01', in2: 'y01', out: 't01' },
+    { op: 'XOR', in1: 't01', in2: 'c00', out: 'z01' },
+    { op: 'AND', in1: 'x01', in2: 'y01', out: 'a01' },
+    { op: 'AND', in1: 't01', in2: 'c00', out: 'b01' },
+    { op: 'OR', in1: 'a01', in2: 'b01', out: 'c01' },
+    { op: 'XOR', in1: 'x02', in2: 'y02', out: 't02' },
+    { op: 'XOR', in1: 't02', in2: 'c01', out: 'z02' },
+    { op: 'AND', in1: 'x02', in2: 'y02', out: 'a02' },
+    { op: 'AND', in1: 't02', in2: 'c01', out: 'b02' },
+    { op: 'OR', in1: 'a02', in2: 'b02', out: 'c02' },
+    { op: 'XOR', in1: 'x03', in2: 'y03', out: 't03' },
+    { op: 'XOR', in1: 't03', in2: 'c02', out: 'z03' },
+    { op: 'AND', in1: 'x03', in2: 'y03', out: 'a03' },
+    { op: 'AND', in1: 't03', in2: 'c02', out: 'b03' },
+    { op: 'OR', in1: 'a03', in2: 'b03', out: 'z04' },
+  ];
+}
+
+function swapOutputs(gates: Gate[], pairs: Array<[string, string]>): Gate[] {
+  const swapped = gates.map((g) => ({ ...g }));
+  for (const [a, b] of pairs) {
+    const first = swapped.find((g) => g.out === a) as Gate;
+    const second = swapped.find((g) => g.out === b) as Gate;
+    first.out = b;
+    second.out = a;
+  }
+  return swapped;
+}
+
+describe('findSwappedWires', () => {
+  it('solves the four-bit adder from the task description', () => {
+    const gates = swapOutputs(fourBitAdder(), [
+      ['z00', 'c00'],
+      ['t02', 'a02'],
+      ['z03', 'b03'],
+      ['z01', 'a03'],
+    ]);
+    expect(findSwappedWires(gates)).toEqual([
+      'a02',
+      'a03',
+      'b03',
+      'c00',
+      't02',
+      'z00',
+      'z01',
+      'z03',
+    ]);
+    expect(addsCorrectly(fourBitAdder(), 4, mulberry32(2), 10)).toBe(true);
+    expect(addsCorrectly(gates, 4, mulberry32(2), 10)).toBe(false);
+  });
+
+  it('finds the swapped wires in a small adder', () => {
+    const { gates, expected } = makeSwappedCircuit(6, 7);
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('finds the swapped wires across many random circuits', () => {
+    for (let seed = 1; seed <= 25; seed++) {
+      const bits = 5 + (seed % 12);
+      const { gates, expected } = makeSwappedCircuit(bits, seed * 131);
+      expect(findSwappedWires(gates), `seed ${seed} (${bits} bits)`).toEqual(expected);
+    }
+  });
+
+  it('finds swaps that stay inside one or two bit positions', () => {
+    for (let seed = 1; seed <= 15; seed++) {
+      const bits = 8 + (seed % 20);
+      const { gates, expected } = makeSwappedCircuit(bits, seed * 7717, true);
+      expect(findSwappedWires(gates), `seed ${seed} (${bits} bits)`).toEqual(expected);
+    }
+  });
+
+  it('handles a 45-bit adder within the time budget', () => {
+    const { gates, expected } = makeSwappedCircuit(45, 20250725);
+    expect(gates.length).toBeGreaterThan(200);
+    const started = performance.now();
+    const found = findSwappedWires(gates);
+    const elapsed = performance.now() - started;
+    expect(found).toEqual(expected);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('stays fast across several 45-bit circuits', () => {
+    for (const seed of [11, 222, 3333]) {
+      const { gates, expected } = makeSwappedCircuit(45, seed);
+      const started = performance.now();
+      expect(findSwappedWires(gates), `seed ${seed}`).toEqual(expected);
+      expect(performance.now() - started).toBeLessThan(5000);
+    }
+  });
+
+  it('returns wires sorted and de-duplicated', () => {
+    const { gates } = makeSwappedCircuit(10, 99);
+    const found = findSwappedWires(gates);
+    expect(found).toHaveLength(8);
+    expect(new Set(found).size).toBe(8);
+    expect([...found].sort()).toEqual(found);
+  });
+
+  it('reports wires whose swap makes the circuit add correctly', () => {
+    const bits = 12;
+    const { gates, expected } = makeSwappedCircuit(bits, 4242);
+    const found = findSwappedWires(gates);
+    expect(found).toEqual(expected);
+    expect(somePairingRepairs(gates, found, bits)).toBe(true);
+  });
+
+  it('leaves an already correct adder alone (no swap improves it)', () => {
+    const bits = 8;
+    const gates = buildAdder(bits, mulberry32(17));
+    expect(addsCorrectly(gates, bits, mulberry32(1), 20)).toBe(true);
+    // With nothing broken the search cannot reach four swaps, so the
+    // structural fallback answers instead; it must not invent wires.
+    const found = findSwappedWires(gates);
+    expect(found).toEqual([]);
+  });
+
+  it('returns an empty array for an empty circuit', () => {
+    expect(findSwappedWires([])).toEqual([]);
+  });
+
+  it('reports only provably misnamed wires when the circuit cannot be repaired', () => {
+    // Not a swapped adder at all: z00 must come from an XOR, so it is reported,
+    // while the OR driving the top bit is a shape a real adder does have.
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'OR', in1: 'x00', in2: 'y00', out: 'z01' },
+    ];
+    expect(findSwappedWires(gates)).toEqual(['z00']);
+  });
+
+  it('is not slowed down by a stray high output-bit name', () => {
+    const gates: Gate[] = [
+      { op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z999999' },
+    ];
+    const started = performance.now();
+    findSwappedWires(gates);
+    expect(performance.now() - started).toBeLessThan(1000);
+  });
+
+  it('rejects a wire driven by two gates', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'x00', in2: 'y00', out: 'z00' },
+      { op: 'OR', in1: 'x00', in2: 'y00', out: 'z00' },
+    ];
+    expect(() => findSwappedWires(gates)).toThrow(/more than one gate/);
+  });
+
+  it('is unaffected by gate ordering', () => {
+    const { gates, expected } = makeSwappedCircuit(9, 555);
+    const shuffled = [...gates].reverse();
+    expect(findSwappedWires(shuffled)).toEqual(expected);
+    expect(simulate(shuffled, { x00: 1, y00: 1 }).x00).toBe(1);
+  });
+});
diff --git a/tests/helpers.ts b/tests/helpers.ts
new file mode 100644
index 0000000..3741f9b
--- /dev/null
+++ b/tests/helpers.ts
@@ -0,0 +1,190 @@
+import { simulate } from '../src/simulate.js';
+import type { Gate } from '../src/types.js';
+
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const pad = (n: number): string => String(n).padStart(2, '0');
+
+/** Build a correct ripple-carry adder over `bits` input bits. */
+export function buildAdder(bits: number, random: () => number = mulberry32(1)): Gate[] {
+  const used = new Set<string>();
+  const randomName = (): string => {
+    for (;;) {
+      let name = '';
+      for (let i = 0; i < 3; i++) name += String.fromCharCode(97 + Math.floor(random() * 26));
+      if (!/^[xyz]/.test(name) && !used.has(name)) {
+        used.add(name);
+        return name;
+      }
+    }
+  };
+
+  const gates: Gate[] = [];
+  // Bit 0 is a half adder.
+  gates.push({ op: 'XOR', in1: `x00`, in2: `y00`, out: 'z00' });
+  let carry = randomName();
+  gates.push({ op: 'AND', in1: `x00`, in2: `y00`, out: carry });
+
+  for (let i = 1; i < bits; i++) {
+    const partial = randomName();
+    const generate = randomName();
+    const propagate = randomName();
+    const nextCarry = i === bits - 1 ? `z${pad(bits)}` : randomName();
+    gates.push({ op: 'XOR', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: partial });
+    gates.push({ op: 'XOR', in1: partial, in2: carry, out: `z${pad(i)}` });
+    gates.push({ op: 'AND', in1: `x${pad(i)}`, in2: `y${pad(i)}`, out: generate });
+    gates.push({ op: 'AND', in1: partial, in2: carry, out: propagate });
+    gates.push({ op: 'OR', in1: generate, in2: propagate, out: nextCarry });
+    carry = nextCarry;
+  }
+  if (bits === 1) {
+    // The lone carry out becomes the top output bit.
+    gates[1] = { ...gates[1], out: 'z01' };
+  }
+
+  // Shuffle gate order and randomly flip input order — neither should matter.
+  for (let i = gates.length - 1; i > 0; i--) {
+    const j = Math.floor(random() * (i + 1));
+    [gates[i], gates[j]] = [gates[j], gates[i]];
+  }
+  return gates.map((g) => (random() < 0.5 ? { ...g, in1: g.in2, in2: g.in1 } : g));
+}
+
+export function addWithCircuit(gates: Gate[], bits: number, x: bigint, y: bigint): bigint {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < bits; i++) {
+    inputs[`x${pad(i)}`] = Number((x >> BigInt(i)) & 1n);
+    inputs[`y${pad(i)}`] = Number((y >> BigInt(i)) & 1n);
+  }
+  const values = simulate(gates, inputs);
+  let out = 0n;
+  for (let i = 0; i <= bits; i++) {
+    const wire = `z${pad(i)}`;
+    if (values[wire] === undefined) throw new Error(`wire ${wire} never resolved`);
+    if (values[wire] === 1) out |= 1n << BigInt(i);
+  }
+  return out;
+}
+
+/** True when the circuit computes x + y for every one of `trials` random inputs. */
+export function addsCorrectly(gates: Gate[], bits: number, random: () => number, trials = 40): boolean {
+  const mask = (1n << BigInt(bits)) - 1n;
+  const randomValue = (): bigint => {
+    let v = 0n;
+    for (let i = 0; i < bits; i += 30) v |= BigInt(Math.floor(random() * (1 << 30))) << BigInt(i);
+    return v & mask;
+  };
+  const cases: Array<[bigint, bigint]> = [
+    [0n, 0n],
+    [mask, 1n],
+    [mask, mask],
+  ];
+  for (let i = 0; i < trials; i++) cases.push([randomValue(), randomValue()]);
+  for (const [x, y] of cases) {
+    try {
+      if (addWithCircuit(gates, bits, x, y) !== x + y) return false;
+    } catch {
+      return false;
+    }
+  }
+  return true;
+}
+
+/** True when every gate output resolves, i.e. the circuit has no cycle. */
+export function isAcyclic(gates: Gate[], bits: number): boolean {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < bits; i++) {
+    inputs[`x${pad(i)}`] = 0;
+    inputs[`y${pad(i)}`] = 0;
+  }
+  const values = simulate(gates, inputs);
+  return gates.every((g) => values[g.out] !== undefined);
+}
+
+export interface SwappedCircuit {
+  gates: Gate[];
+  expected: string[];
+}
+
+/** Highest register bit a gate is named after, used only to group neighbours. */
+function gateBit(gate: Gate): number {
+  const bits = [gate.in1, gate.in2, gate.out]
+    .map((w) => (/^[xyz]\d+$/.test(w) ? Number(w.slice(1)) : -1))
+    .filter((b) => b >= 0);
+  return bits.length > 0 ? Math.max(...bits) : -1;
+}
+
+/** A gate close to the previous pick in the carry chain, to keep swaps local. */
+function nearbyPick(byBit: number[], picks: number[], random: () => number): number {
+  if (picks.length % 2 === 0) return byBit[Math.floor(random() * byBit.length)];
+  const anchor = byBit.indexOf(picks[picks.length - 1]);
+  const spread = 6;
+  const low = Math.max(0, anchor - spread);
+  const high = Math.min(byBit.length - 1, anchor + spread);
+  return byBit[low + Math.floor(random() * (high - low + 1))];
+}
+
+/**
+ * Apply four independently detectable output swaps to a correct adder.
+ * Retries until every swap on its own breaks the adder, so the answer is
+ * unambiguous.
+ *
+ * With `nearby` the two gates of each pair are drawn from the same handful of
+ * neighbouring gates, which keeps the damage inside one or two bit positions —
+ * a noticeably harder case than swaps scattered across the carry chain.
+ */
+export function makeSwappedCircuit(bits: number, seed: number, nearby = false): SwappedCircuit {
+  const random = mulberry32(seed);
+  const base = buildAdder(bits, random);
+  const byBit = [...base.keys()].sort((a, b) => gateBit(base[a]) - gateBit(base[b]));
+
+  for (let attempt = 0; attempt < 500; attempt++) {
+    const picks: number[] = [];
+    const taken = new Set<number>();
+    while (picks.length < 8) {
+      const g = nearby ? nearbyPick(byBit, picks, random) : Math.floor(random() * base.length);
+      if (!taken.has(g)) {
+        taken.add(g);
+        picks.push(g);
+      }
+    }
+    const pairs: Array<[number, number]> = [
+      [picks[0], picks[1]],
+      [picks[2], picks[3]],
+      [picks[4], picks[5]],
+      [picks[6], picks[7]],
+    ];
+
+    const applied = base.map((g) => ({ ...g }));
+    let usable = true;
+    for (const [a, b] of pairs) {
+      const one = base.map((g) => ({ ...g }));
+      one[a].out = base[b].out;
+      one[b].out = base[a].out;
+      // Each swap must break the adder on its own, or the answer is ambiguous.
+      if (!isAcyclic(one, bits) || addsCorrectly(one, bits, mulberry32(seed + 7), 20)) {
+        usable = false;
+        break;
+      }
+      applied[a].out = base[b].out;
+      applied[b].out = base[a].out;
+    }
+    if (!usable) continue;
+    if (!isAcyclic(applied, bits)) continue;
+    if (addsCorrectly(applied, bits, mulberry32(seed + 11), 20)) continue;
+
+    return {
+      gates: applied,
+      expected: picks.map((g) => base[g].out).sort(),
+    };
+  }
+  throw new Error('could not build a swapped circuit');
+}
