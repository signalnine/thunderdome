@@ -0,0 +1,91 @@
+import type { Circuit } from './circuit.js';
+import { OP_AND, OP_OR, OP_XOR } from './types.js';
+
+/**
+ * Gates whose output wire is provably named wrong.
+ *
+ * Swapping output wires never changes which gates *read* a wire, and in a
+ * ripple-carry adder the readers of a wire pin down the role it plays:
+ *
+ * - a partial sum `x^y` and a carry-in are each read by exactly two gates —
+ *   the XOR that produces the sum bit and the AND that produces the carry
+ *   contribution — and both of those read the same pair of wires;
+ * - a carry contribution is read by exactly one gate, the carry OR;
+ * - an output bit is read by nothing.
+ *
+ * A gate's role, meanwhile, follows from its operation and its inputs, which
+ * are also untouched by the swaps. So whenever the readers of a gate's output
+ * disagree with the role that gate plays, the name on that output must have
+ * come from somewhere else — the gate is one of the swapped ones. The reverse
+ * does not hold: two gates with interchangeable roles can be swapped without
+ * leaving any structural trace, which is why this only narrows the field.
+ */
+export function misnamedGates(circuit: Circuit, outOf: Int32Array): Uint8Array {
+  const flagged = new Uint8Array(circuit.numGates);
+  // -1 when the circuit has no wire for the top output bit; since wire ids are
+  // never negative, the comparisons below then simply never match and the
+  // gates that should drive it are flagged, which is the answer we want.
+  const topZ = circuit.numZ > 0 ? circuit.zWire[circuit.numZ - 1] : -1;
+
+  for (let g = 0; g < circuit.numGates; g++) {
+    const out = outOf[g];
+    const bit = registerPairBit(circuit, g);
+    let consistent: boolean;
+
+    if (bit >= 0 && circuit.op[g] === OP_XOR) {
+      // Bit 0 is a half adder, so its XOR is the low output bit itself.
+      consistent = bit === 0 ? out === circuit.zWire[0] : feedsSumAndCarry(circuit, out);
+    } else if (bit >= 0 && circuit.op[g] === OP_AND) {
+      // The carry out of bit 0 is a carry-in; higher bits generate a carry.
+      consistent =
+        bit > 0
+          ? feedsCarryOnly(circuit, out)
+          : circuit.numBits === 1
+            ? out === topZ
+            : feedsSumAndCarry(circuit, out);
+    } else if (circuit.op[g] === OP_XOR) {
+      consistent = circuit.outputBit[out] >= 0; // an XOR off the registers is a sum bit
+    } else if (circuit.op[g] === OP_AND) {
+      consistent = feedsCarryOnly(circuit, out);
+    } else {
+      consistent = out === topZ || feedsSumAndCarry(circuit, out); // a carry, or the final one
+    }
+
+    if (!consistent) flagged[g] = 1;
+  }
+  return flagged;
+}
+
+/** Bit index when a gate reads `x{i}` and `y{i}`, otherwise -1. */
+function registerPairBit(circuit: Circuit, gate: number): number {
+  const a = circuit.in1[gate];
+  const b = circuit.in2[gate];
+  const bit = circuit.registerBit[a];
+  return a !== b && bit >= 0 && bit === circuit.registerBit[b] ? bit : -1;
+}
+
+function readersOf(circuit: Circuit, wire: number): number[] {
+  const readers: number[] = [];
+  for (let p = circuit.readersStart[wire]; p < circuit.readersStart[wire + 1]; p++) {
+    readers.push(circuit.readersList[p]);
+  }
+  return readers;
+}
+
+/** Read by an XOR and an AND that both read the same pair of wires. */
+function feedsSumAndCarry(circuit: Circuit, wire: number): boolean {
+  const readers = readersOf(circuit, wire);
+  if (readers.length !== 2) return false;
+  const [first, second] = readers;
+  const ops = [circuit.op[first], circuit.op[second]];
+  if (!ops.includes(OP_XOR) || !ops.includes(OP_AND)) return false;
+  const partner = (gate: number): number =>
+    circuit.in1[gate] === wire ? circuit.in2[gate] : circuit.in1[gate];
+  return partner(first) === partner(second);
+}
+
+/** Read by exactly one gate, the OR that merges the two carry contributions. */
+function feedsCarryOnly(circuit: Circuit, wire: number): boolean {
+  const readers = readersOf(circuit, wire);
+  return readers.length === 1 && circuit.op[readers[0]] === OP_OR;
+}
