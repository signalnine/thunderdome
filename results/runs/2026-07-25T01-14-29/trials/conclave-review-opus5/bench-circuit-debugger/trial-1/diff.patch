n    41\t  private readonly expected: Int32Array;\n    42\t  /** value of each internal signal of a correct adder, per bit */\n    43\t  private readonly signals: Record<SignalKind, Int32Array[]> = {\n    44\t    partial: [],\n    45\t    generate: [],\n    46\t    propagate: [],\n    47\t    carry: [],\n    48\t    sum: [],\n    49\t  };\n    50\t\n    51\t  constructor(circuit: Circuit, words: number, seed: number) {\n    52\t    this.circuit = circuit;\n    53\t    this.words = words;\n    54\t    this.numTests = words * 32;\n    55\t    this.vals = new Int32Array(circuit.numWires * words);\n    56\t    this.seedVals = new Int32Array(circuit.numWires * words);\n    57\t    this.known = new Uint8Array(circuit.numWires);\n    58\t    this.knownSeed = Uint8Array.from(circuit.isSource);\n    59\t    this.missing = new Int32Array(circuit.numGates);\n    60\t    this.stack = new Int32Array(circuit.numGates);\n    61\t    this.expected = new Int32Array(circuit.numZ * words);\n    62\t    this.fillTestVectors(seed);\n    63\t    this.buildSignals();\n    64\t  }\n    65\t\n    66\t  /** Values a correct adder would carry on each of its internal signals. */\n    67\t  private buildSignals(): void {\n    68\t    const { numBits, xWire, yWire } = this.circuit;\n    69\t    const w = this.words;\n    70\t    const zero = new Int32Array(w);\n    71\t    const lanesOf = (wire: number): Int32Array =>\n    72\t      wire < 0 ? zero : this.seedVals.subarray(wire * w, wire * w + w);\n    73\t    const combine = (a: Int32Array, b: Int32Array, fn: (x: number, y: number) => number): Int32Array => {\n    74\t      const out = new Int32Array(w);\n    75\t      for (let k = 0; k < w; k++) out[k] = fn(a[k], b[k]);\n    76\t      return out;\n    77\t    };\n    78\t\n    79\t    let carry: Int32Array = new Int32Array(w);\n    80\t    for (let i = 0; i < numBits; i++) {\n    81\t      const x = lanesOf(xWire[i]);\n    82\t      const y = lanesOf(yWire[i]);\n    83\t      const partial = c