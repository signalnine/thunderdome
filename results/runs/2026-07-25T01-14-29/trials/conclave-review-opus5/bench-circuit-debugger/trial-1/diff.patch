t  const numGates = gates.length;\n51\t  const wireIds = new Map<string, number>();\n52\t  const wireNames: string[] = [];\n53\t  const idOf = (name: string): number => {\n54\t    let id = wireIds.get(name);\n55\t    if (id === undefined) {\n56\t      id = wireNames.length;\n57\t      wireIds.set(name, id);\n58\t      wireNames.push(name);\n59\t    }\n60\t    return id;\n61\t  };\n62\t\n63\t  const op = new Uint8Array(numGates);\n64\t  const in1 = new Int32Array(numGates);\n65\t  const in2 = new Int32Array(numGates);\n66\t  const origOut = new Int32Array(numGates);\n67\t  for (let g = 0; g < numGates; g++) {\n68\t    const gate = gates[g];\n69\t    op[g] = encodeOp(gate.op);\n70\t    in1[g] = idOf(gate.in1);\n71\t    in2[g] = idOf(gate.in2);\n72\t    origOut[g] = idOf(gate.out);\n73\t  }\n74\t\n75\t  const numWires = wireNames.length;\n76\t  const isSource = new Uint8Array(numWires).fill(1);\n77\t  for (let g = 0; g < numGates; g++) {\n78\t    if (isSource[origOut[g]] === 0) {\n79\t      throw new Error(`wire ${wireNames[origOut[g]]} is driven by more than one gate`);\n80\t    }\n81\t    isSource[origOut[g]] = 0;\n82\t  }\n83\t\n84\t  // CSR index of gate inputs, counting a wire twice if a gate reads it twice.\n85\t  const readersStart = new Int32Array(numWires + 1);\n86\t  for (let g = 0; g < numGates; g++) {\n87\t    readersStart[in1[g] + 1]++;\n88\t    readersStart[in2[g] + 1]++;\n89\t  }\n90\t  for (let w = 0; w < numWires; w++) readersStart[w + 1] += readersStart[w];\n91\t  const readersList = new Int32Array(readersStart[numWires]);\n92\t  const cursor = Int32Array.from(readersStart.subarray(0, numWires));\n93\t  for (let g = 0; g < numGates; g++) {\n94\t    readersList[cursor[in1[g]]++] = g;\n95\t    readersList[cursor[in2[g]]++] = g;\n96\t  }\n97\t\n98\t  const baseMissing = new Int32Array(numGates);\n99\t  const seeds: number[] = [];\n100\t  for (let g = 0; g < numGates; g++) {\n101\t    const missing = (isSource[in1[g]] ? 0 : 1) + (isSource[in2[g]] ? 0 : 1)