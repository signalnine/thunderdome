+import Database from 'better-sqlite3';
+import type { ReviewService, Review } from '../types.js';
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL DEFAULT '',
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  function deserialize(row: Record<string, unknown>): Review {
+    return {
+      id: row.id as number,
+      pluginName: row.pluginName as string,
+      pluginVersion: row.pluginVersion as string,
+      userId: row.userId as string,
+      rating: row.rating as number,
+      comment: row.comment as string,
+      flagged: row.flagged === 1,
+      createdAt: row.createdAt as string,
+    };
+  }
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      const stmt = db.prepare(`
+        INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+        VALUES (?, ?, ?, ?, ?, 0, ?)
+      `);
+      const info = stmt.run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        createdAt
+      );
+      const row = db.prepare('SELECT * FROM reviews WHERE id = ?').get(info.lastInsertRowid);
+      return deserialize(row as Record<string, unknown>);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE pluginName = ? ORDER BY id ASC').all(pluginName) as Record<string, unknown>[];
+      return rows.map(r => deserialize(r));
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = db.prepare(`
+        SELECT AVG(rating) as avgRating FROM reviews
+        WHERE pluginName = ? AND flagged = 0
+      `).get(pluginName) as { avgRating: number | null } | null;
+      if (!row || row.avgRating === null) return 0;
+      return Math.round(row.avgRating);
+    },
+
+    flagReview(reviewId: number): void {
+      db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id ASC').all() as Record<string, unknown>[];
+      return rows.map(r => deserialize(r));
+    },
+
+    removeReview(reviewId: number): boolean {
+      const result = db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE userId = ? ORDER BY id ASC').all(userId) as Record<string, unknown>[];
+      return rows.map(r => deserialize(r));
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = db.prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?').get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
