+import vm from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+      const start = Date.now();
+      const memBefore = process.memoryUsage().heapUsed;
+
+      const sandboxContext = vm.createContext({ ...context });
+
+      try {
+        const wrapped = `(function(){ ${code} })()`;
+        const result = vm.runInContext(wrapped, sandboxContext, { timeout: 30000 });
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        return {
+          success: true,
+          output: result,
+          duration,
+          memoryUsed: memAfter - memBefore,
+        };
+      } catch (err: unknown) {
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        const error = err instanceof Error ? err.message : String(err);
+        return {
+          success: false,
+          output: null,
+          duration,
+          memoryUsed: memAfter - memBefore,
+          error,
+        };
+      }
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      const start = Date.now();
+      const memBefore = process.memoryUsage().heapUsed;
+
+      const sandboxContext = vm.createContext({ ...context });
+
+      try {
+        const wrapped = `(function(){ ${code} })()`;
+        const result = vm.runInContext(wrapped, sandboxContext, { timeout: timeoutMs });
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        return {
+          success: true,
+          output: result,
+          duration,
+          memoryUsed: memAfter - memBefore,
+        };
+      } catch (err: unknown) {
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+        const error = err instanceof Error ? err.message : String(err);
+        return {
+          success: false,
+          output: null,
+          duration,
+          memoryUsed: memAfter - memBefore,
+          error,
+        };
+      }
+    },
+  };
+}
