+import type { DepsService, RegistryService, DependencyNode } from '../types.js';
+
+export function createDepsService(): DepsService {
+  function getDeps(registry: RegistryService, name: string): Record<string, string> {
+    const manifest = registry.get(name);
+    return manifest?.dependencies ?? {};
+  }
+
+  function getDepVersion(registry: RegistryService, name: string): string {
+    const manifest = registry.get(name);
+    return manifest?.version ?? '0.0.0';
+  }
+
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      const visited = new Set<string>();
+      const build = (nodeName: string): DependencyNode => {
+        if (visited.has(nodeName)) {
+          return { name: nodeName, version: getDepVersion(registry, nodeName), dependencies: [] };
+        }
+        visited.add(nodeName);
+        const deps = getDeps(registry, nodeName);
+        const children: DependencyNode[] = [];
+        for (const depName of Object.keys(deps)) {
+          const depManifest = registry.get(depName);
+          if (depManifest) {
+            children.push(build(depName));
+          }
+        }
+        visited.delete(nodeName);
+        return {
+          name: nodeName,
+          version: getDepVersion(registry, nodeName),
+          dependencies: children,
+        };
+      };
+      return build(name);
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const allCycles: string[][] = [];
+      const WHITE = 0, GRAY = 1, BLACK = 2;
+      const color: Map<string, number> = new Map();
+      const path: string[] = [];
+
+      const dfs = (nodeName: string): void => {
+        color.set(nodeName, GRAY);
+        path.push(nodeName);
+        const deps = getDeps(registry, nodeName);
+        for (const depName of Object.keys(deps)) {
+          const depManifest = registry.get(depName);
+          if (!depManifest) continue;
+          const c = color.get(depName);
+          if (c === GRAY) {
+            const cycleStart = path.indexOf(depName);
+            const cycle = path.slice(cycleStart);
+            allCycles.push(cycle);
+          } else if (c === WHITE || c === undefined) {
+            dfs(depName);
+          }
+        }
+        path.pop();
+        color.set(nodeName, BLACK);
+      };
+
+      color.set(name, WHITE);
+      dfs(name);
+      return allCycles.length > 0 ? allCycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const sorted: string[] = [];
+      const visited = new Set<string>();
+      const inStack = new Set<string>();
+
+      const visit = (nodeName: string): void => {
+        if (visited.has(nodeName)) return;
+        if (inStack.has(nodeName)) return; // cycle, skip
+        inStack.add(nodeName);
+        const deps = getDeps(registry, nodeName);
+        for (const depName of Object.keys(deps)) {
+          const depManifest = registry.get(depName);
+          if (depManifest) {
+            visit(depName);
+          }
+        }
+        inStack.delete(nodeName);
+        visited.add(nodeName);
+        sorted.push(nodeName);
+      };
+
+      visit(name);
+      return sorted;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const flattened = new Set<string>();
+      const visited = new Set<string>();
+
+      const visit = (nodeName: string): void => {
+        if (visited.has(nodeName)) return;
+        visited.add(nodeName);
+        const deps = getDeps(registry, nodeName);
+        for (const depName of Object.keys(deps)) {
+          flattened.add(depName);
+          const depManifest = registry.get(depName);
+          if (depManifest) {
+            visit(depName);
+          }
+        }
+      };
+
+      visit(name);
+      return [...flattened];
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      const cycles = this.detectCycles(name, registry);
+      return cycles !== null;
+    },
+  };
+}
