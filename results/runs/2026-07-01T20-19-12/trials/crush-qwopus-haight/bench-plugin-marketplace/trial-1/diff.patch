@@ -0,0 +1,87 @@
+import { createRegistry } from './registry/index.js';
+import { createResolver } from './resolver/index.js';
+import { createRunner } from './runner/index.js';
+import { createReviewSystem } from './reviews/index.js';
+import { createDepsService } from './deps/index.js';
+import type {
+  PluginManifest,
+  SandboxResult,
+  ResolvedVersion,
+  RegistryService,
+  ResolverService,
+  RunnerService,
+  ReviewService,
+  DepsService,
+} from './types.js';
+
+export interface InstallResult {
+  resolved: ResolvedVersion[];
+  sandboxResult: SandboxResult;
+}
+
+export interface Marketplace {
+  registry: RegistryService;
+  resolver: ResolverService;
+  runner: RunnerService;
+  reviews: ReviewService;
+  deps: DepsService;
+  installPlugin(manifest: PluginManifest): Promise<InstallResult>;
+}
+
+export function createMarketplace(): Marketplace {
+  const registry = createRegistry();
+  const resolver = createResolver();
+  const runner = createRunner();
+  const reviews = createReviewSystem();
+  const deps = createDepsService();
+
+  const installPlugin = async (manifest: PluginManifest): Promise<InstallResult> => {
+    // Validate manifest
+    if (!manifest.name || !manifest.version || !manifest.entryPoint) {
+      throw new Error('Invalid manifest: name, version, and entryPoint are required');
+    }
+
+    // Register the plugin
+    registry.register(manifest);
+
+    // Resolve dependency versions
+    const resolved: ResolvedVersion[] = [];
+    if (manifest.dependencies && Object.keys(manifest.dependencies).length > 0) {
+      // Build available versions map from registry
+      const available: Record<string, string[]> = {};
+      for (const depName of Object.keys(manifest.dependencies)) {
+        const versions = registry.listVersions(depName);
+        if (versions.length > 0) {
+          available[depName] = versions;
+        }
+      }
+
+      const constraints = Object.entries(manifest.dependencies).map(([name, range]) => ({
+        name,
+        range,
+      }));
+
+      resolved.push(...resolver.resolve(constraints, available));
+
+      // Check for circular dependencies
+      const cycles = deps.detectCycles(manifest.name, registry);
+      if (cycles) {
+        throw new Error('Circular dependency detected: ' + JSON.stringify(cycles));
+      }
+    }
+
+    // Execute entry point in sandbox
+    const sandboxResult = await runner.execute(manifest.entryPoint);
+
+    return { resolved, sandboxResult };
+  };
+
+  return {
+    registry,
+    resolver,
+    runner,
+    reviews,
+    deps,
+    installPlugin,
+  };
+}
