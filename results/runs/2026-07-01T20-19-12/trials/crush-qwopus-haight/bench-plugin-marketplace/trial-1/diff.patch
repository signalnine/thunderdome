+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL DEFAULT '{}',
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL DEFAULT '[]',
+      PRIMARY KEY (name, version)
+    )
+  `);
+
+  function deserialize(row: Record<string, unknown>): PluginManifest {
+    return {
+      name: row.name as string,
+      version: row.version as string,
+      description: row.description as string,
+      author: row.author as string,
+      dependencies: JSON.parse(row.dependencies as string),
+      entryPoint: row.entryPoint as string,
+      permissions: JSON.parse(row.permissions as string),
+    };
+  }
+
+  return {
+    register(manifest: PluginManifest) {
+      db.prepare(`
+        INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+        VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+      `).run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description,
+        author: manifest.author,
+        dependencies: JSON.stringify(manifest.dependencies),
+        entryPoint: manifest.entryPoint,
+        permissions: JSON.stringify(manifest.permissions),
+      });
+    },
+
+    get(name: string): PluginManifest | null {
+      const row = db.prepare('SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1').get(name);
+      return row ? deserialize(row as Record<string, unknown>) : null;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?').get(name, version);
+      return row ? deserialize(row as Record<string, unknown>) : null;
+    },
+
+    list(): PluginManifest[] {
+      const rows = db.prepare(`
+        SELECT * FROM plugins WHERE (name, version) IN (
+          SELECT name, MAX(version) FROM plugins GROUP BY name
+        )
+      `).all() as Record<string, unknown>[];
+      return rows.map(r => deserialize(r));
+    },
+
+    search(query: string): PluginManifest[] {
+      const q = `%${query}%`;
+      const rows = db.prepare(`
+        SELECT * FROM plugins WHERE (name, version) IN (
+          SELECT name, MAX(version) FROM plugins GROUP BY name
+        ) AND (name LIKE ? OR description LIKE ?)
+      `).all(q, q) as Record<string, unknown>[];
+      return rows.map(r => deserialize(r));
+    },
+
+    remove(name: string, version: string): boolean {
+      const result = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?').run(name, version);
+      return result.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = db.prepare('SELECT version FROM plugins WHERE name = ? ORDER BY version ASC').all(name) as { version: string }[];
+      return rows.map(r => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>) {
+      const existing = this.getVersion(name, version);
+      if (!existing) return;
+      const updated = { ...existing, ...updates };
+      db.prepare(`
+        INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+        VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+      `).run({
+        name: updated.name,
+        version: updated.version,
+        description: updated.description,
+        author: updated.author,
+        dependencies: JSON.stringify(updated.dependencies),
+        entryPoint: updated.entryPoint,
+        permissions: JSON.stringify(updated.permissions),
+      });
+    },
+  };
+}
