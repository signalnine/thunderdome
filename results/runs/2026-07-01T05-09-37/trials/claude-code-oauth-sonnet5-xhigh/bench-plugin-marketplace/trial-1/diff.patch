(`UPDATE reviews SET flagged = 1 WHERE id = ?`);\n  const removeStmt = db.prepare(`DELETE FROM reviews WHERE id = ?`);\n  const countByPluginStmt = db.prepare(`SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?`);\n\n  return {\n    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {\n      const createdAt = new Date().toISOString();\n      const result = insertStmt.run({\n        pluginName: review.pluginName,\n        pluginVersion: review.pluginVersion,\n        userId: review.userId,\n        rating: review.rating,\n        comment: review.comment,\n        createdAt,\n      });\n      const row = getByIdStmt.get(result.lastInsertRowid) as ReviewRow;\n      return rowToReview(row);\n    },\n\n    getReviews(pluginName: string): Review[] {\n      const rows = getByPluginStmt.all(pluginName) as ReviewRow[];\n      return rows.map(rowToReview);\n    },\n\n    getAverageRating(pluginName: string): number {\n      const rows = getUnflaggedByPluginStmt.all(pluginName) as ReviewRow[];\n      if (rows.length === 0) {\n        return 0;\n      }\n      const sum = rows.reduce((total, row) => total + row.rating, 0);\n      return sum / rows.length;\n    },\n\n    flagReview(reviewId: number): void {\n      flagStmt.run(reviewId);\n    },\n\n    getFlaggedReviews(): Review[] {\n      const rows = getFlaggedStmt.all() as ReviewRow[];\n      return rows.map(rowToReview);\n    },\n\n    removeReview(reviewId: number): boolean {\n      const result = removeStmt.run(reviewId);\n      return result.changes > 0;\n    },\n\n    getReviewsByUser(userId: string): Review[] {\n      const rows = getByUserStmt.all(userId) as ReviewRow[];\n      return rows.map(rowToReview);\n    },\n\n    getReviewCount(pluginName: string): number {\n      const row = countByPluginStmt.get(pluginName) as { count: number };\n      return row.count;\n    },\n  };\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_t