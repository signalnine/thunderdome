@@ -0,0 +1,58 @@
+import vm from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+function isErrorLike(value: unknown): value is { message: string } {
+  return typeof value === 'object' && value !== null && typeof (value as { message?: unknown }).message === 'string';
+}
+
+function runInSandbox(
+  code: string,
+  context: Record<string, unknown>,
+  timeoutMs: number
+): SandboxResult {
+  const start = process.hrtime.bigint();
+  const memBefore = process.memoryUsage().heapUsed;
+  const sandbox: Record<string, unknown> = { ...context };
+  const vmContext = vm.createContext(sandbox);
+  const wrapped = `(function() {\n${code}\n})()`;
+
+  try {
+    const script = new vm.Script(wrapped);
+    const output = script.runInContext(vmContext, { timeout: timeoutMs });
+    const durationMs = Number(process.hrtime.bigint() - start) / 1e6;
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: true,
+      output,
+      duration: durationMs,
+      memoryUsed: Math.max(0, memAfter - memBefore),
+    };
+  } catch (err) {
+    const durationMs = Number(process.hrtime.bigint() - start) / 1e6;
+    return {
+      success: false,
+      output: undefined,
+      duration: durationMs,
+      memoryUsed: 0,
+      error: isErrorLike(err) ? err.message : String(err),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+      return runInSandbox(code, context, DEFAULT_TIMEOUT_MS);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context: Record<string, unknown> = {}
+    ): Promise<SandboxResult> {
+      return runInSandbox(code, context, timeoutMs);
+    },
+  };
+}
