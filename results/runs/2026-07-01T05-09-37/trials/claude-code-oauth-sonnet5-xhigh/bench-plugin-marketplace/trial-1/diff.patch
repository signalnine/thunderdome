@@ -0,0 +1,113 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+    VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)
+  `);
+
+  const getByIdStmt = db.prepare(`SELECT * FROM reviews WHERE id = ?`);
+  const getByPluginStmt = db.prepare(`SELECT * FROM reviews WHERE pluginName = ?`);
+  const getUnflaggedByPluginStmt = db.prepare(
+    `SELECT * FROM reviews WHERE pluginName = ? AND flagged = 0`
+  );
+  const getByUserStmt = db.prepare(`SELECT * FROM reviews WHERE userId = ?`);
+  const getFlaggedStmt = db.prepare(`SELECT * FROM reviews WHERE flagged = 1`);
+  const flagStmt = db.prepare(`UPDATE reviews SET flagged = 1 WHERE id = ?`);
+  const removeStmt = db.prepare(`DELETE FROM reviews WHERE id = ?`);
+  const countByPluginStmt = db.prepare(`SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?`);
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      const result = insertStmt.run({
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        createdAt,
+      });
+      const row = getByIdStmt.get(result.lastInsertRowid) as ReviewRow;
+      return rowToReview(row);
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = getByPluginStmt.all(pluginName) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const rows = getUnflaggedByPluginStmt.all(pluginName) as ReviewRow[];
+      if (rows.length === 0) {
+        return 0;
+      }
+      const sum = rows.reduce((total, row) => total + row.rating, 0);
+      return sum / rows.length;
+    },
+
+    flagReview(reviewId: number): void {
+      flagStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = getFlaggedStmt.all() as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const result = removeStmt.run(reviewId);
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = getByUserStmt.all(userId) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countByPluginStmt.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
