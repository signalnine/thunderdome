gger' }));\n    registry.register(makeManifest({ name: 'basic-util' }));\n    const results = registry.search('logger');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('awesome-logger');\n  });\n\n  it('search finds by description', () => {\n    registry.register(makeManifest({ name: 'foo', description: 'A fantastic logging utility' }));\n    registry.register(makeManifest({ name: 'bar', description: 'Math helpers' }));\n    const results = registry.search('logging');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('foo');\n  });\n\n  it('remove deletes plugin version', () => {\n    registry.register(makeManifest({ name: 'removable', version: '1.0.0' }));\n    expect(registry.get('removable')).not.toBeNull();\n    const removed = registry.remove('removable', '1.0.0');\n    expect(removed).toBe(true);\n    expect(registry.get('removable')).toBeNull();\n  });\n\n  it('listVersions returns all versions for a plugin', () => {\n    registry.register(makeManifest({ name: 'multi', version: '1.0.0' }));\n    registry.register(makeManifest({ name: 'multi', version: '1.1.0' }));\n    registry.register(makeManifest({ name: 'multi', version: '2.0.0' }));\n    const versions = registry.listVersions('multi');\n    expect(versions).toHaveLength(3);\n    expect(versions).toContain('1.0.0');\n    expect(versions).toContain('1.1.0');\n    expect(versions).toContain('2.0.0');\n  });\n});\n","numLines":92,"startLine":1,"totalLines":92}}}
