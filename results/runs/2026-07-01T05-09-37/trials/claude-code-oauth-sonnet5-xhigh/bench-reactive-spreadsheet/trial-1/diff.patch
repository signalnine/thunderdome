sheet.get('C1')).toBe(8);\n    expect(sheet.get('C2')).toBe(10);\n  });\n\n  it('supports unary minus and negative literals', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 5);\n    sheet.set('B1', '=-A1');\n    sheet.set('B2', '=-A1+10');\n    sheet.set('B3', '=3 * -2');\n    expect(sheet.get('B1')).toBe(-5);\n    expect(sheet.get('B2')).toBe(5);\n    expect(sheet.get('B3')).toBe(-6);\n  });\n\n  it('divides by zero and produces an error value', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 0);\n    sheet.set('B1', '=A1/A2');\n    expect(sheet.get('B1')).toBe('#DIV/0!');\n  });\n\n  it('treats an empty referenced cell as 0 in arithmetic', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1+5');\n    expect(sheet.get('A1')).toBe(5);\n  });\n});\n\ndescribe('formulas: comparisons and IF', () => {\n  it('evaluates comparison operators', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 10);\n    sheet.set('A2', 20);\n    sheet.set('B1', '=A1>A2');\n    sheet.set('B2', '=A1<A2');\n    sheet.set('B3', '=A1>=10');\n    sheet.set('B4', '=A1<=9');\n    sheet.set('B5', '=A1=10');\n    sheet.set('B6', '=A1<>10');\n    expect(sheet.get('B1')).toBe(false);\n    expect(sheet.get('B2')).toBe(true);\n    expect(sheet.get('B3')).toBe(true);\n    expect(sheet.get('B4')).toBe(false);\n    expect(sheet.get('B5')).toBe(true);\n    expect(sheet.get('B6')).toBe(false);\n  });\n\n  it('IF picks the correct branch based on the condition', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 50);\n    sheet.set('C1', '=IF(A1>30, \"big\", \"small\")');\n    expect(sheet.get('C1')).toBe('big');\n\n    sheet.set('A1', 10);\n    expect(sheet.get('C1')).toBe('small');\n  });\n\n  it('IF condition can be a boolean cell', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', true);\n    sheet.set('B1', '=IF(A1, 1, 2)');\n    expect(sheet.get('B1')).toBe(1);\n  });\n\n