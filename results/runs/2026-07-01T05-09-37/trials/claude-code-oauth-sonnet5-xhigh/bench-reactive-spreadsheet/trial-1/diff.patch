toThrow();\n  });\n\n  it('throws on a direct two-cell cycle', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    expect(() => sheet.set('B1', '=A1')).toThrow();\n  });\n\n  it('throws on an indirect cycle through several cells', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', '=B1');\n    sheet.set('B1', '=C1');\n    expect(() => sheet.set('C1', '=A1')).toThrow();\n  });\n\n  it('does not raise a false positive for a shared (non-circular) dependency', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    sheet.set('C1', '=A1+2');\n    expect(() => sheet.set('D1', '=B1+C1')).not.toThrow();\n    expect(sheet.get('D1')).toBe(5);\n  });\n\n  it('leaves prior state intact after a rejected circular update', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    expect(() => sheet.set('A1', '=B1')).toThrow();\n    expect(sheet.get('A1')).toBe(1);\n    expect(sheet.get('B1')).toBe(2);\n  });\n});\n\ndescribe('getDisplay', () => {\n  it('formats numbers, strings, and booleans', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 30);\n    sheet.set('A2', 'hello');\n    sheet.set('A3', true);\n    sheet.set('A4', false);\n    expect(sheet.getDisplay('A1')).toBe('30');\n    expect(sheet.getDisplay('A2')).toBe('hello');\n    expect(sheet.getDisplay('A3')).toBe('true');\n    expect(sheet.getDisplay('A4')).toBe('false');\n  });\n\n  it('formats decimal numbers', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 3.14);\n    expect(sheet.getDisplay('A1')).toBe('3.14');\n  });\n\n  it('formats empty cells as an empty string', () => {\n    const sheet = new Spreadsheet();\n    expect(sheet.getDisplay('Z1')).toBe('');\n  });\n});\n\ndescribe('getCells', () => {\n  it('returns only non-empty cells with their computed values', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('A2', 2);\n    sheet.set('A3', '=A1+A2');\n\n    const cells = sheet.getCells();\n    expect(cells.size).toBe(3);\n    expect(cells.get('A1')).toBe(1);\n    expect(cells.get('A2')).toBe(2);\n    expect(cells.get('A3')).toBe(3);\n    expect(cells.has('Z9')).toBe(false);\n  });\n\n  it('reflects reactive updates', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('A1', 1);\n    sheet.set('B1', '=A1+1');\n    sheet.set('A1', 10);\n    expect(sheet.getCells().get('B1')).toBe(11);\n  });\n});\n\ndescribe('column references beyond Z', () => {\n  it('supports AA, AZ, BA style column refs', () => {\n    const sheet = new Spreadsheet();\n    sheet.set('AA1', 5);\n    sheet.set('AB1', '=AA1+1');\n    expect(sheet.get('AB1')).toBe(6);\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
