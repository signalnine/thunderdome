new file mode 100644
index 0000000..997edd8
--- /dev/null
+++ b/src/cellRef.ts
@@ -0,0 +1,56 @@
+const CELL_REF_REGEX = /^([A-Za-z]+)([0-9]+)$/;
+
+export function isValidCellRef(ref: string): boolean {
+  return CELL_REF_REGEX.test(ref.trim());
+}
+
+export function columnLettersToIndex(letters: string): number {
+  const upper = letters.toUpperCase();
+  let index = 0;
+  for (let i = 0; i < upper.length; i++) {
+    index = index * 26 + (upper.charCodeAt(i) - 64);
+  }
+  return index - 1;
+}
+
+export function columnIndexToLetters(index: number): string {
+  let n = index + 1;
+  let letters = '';
+  while (n > 0) {
+    const rem = (n - 1) % 26;
+    letters = String.fromCharCode(65 + rem) + letters;
+    n = Math.floor((n - 1) / 26);
+  }
+  return letters;
+}
+
+export function parseCellRef(ref: string): { col: number; row: number } {
+  const match = CELL_REF_REGEX.exec(ref.trim());
+  if (!match) {
+    throw new Error(`Invalid cell reference: '${ref}'`);
+  }
+  const [, colLetters, rowDigits] = match;
+  return { col: columnLettersToIndex(colLetters), row: parseInt(rowDigits, 10) };
+}
+
+export function normalizeCellRef(ref: string): string {
+  const { col, row } = parseCellRef(ref);
+  return `${columnIndexToLetters(col)}${row}`;
+}
+
+export function expandRange(startRef: string, endRef: string): string[] {
+  const start = parseCellRef(startRef);
+  const end = parseCellRef(endRef);
+  const colMin = Math.min(start.col, end.col);
+  const colMax = Math.max(start.col, end.col);
+  const rowMin = Math.min(start.row, end.row);
+  const rowMax = Math.max(start.row, end.row);
+
+  const refs: string[] = [];
+  for (let row = rowMin; row <= rowMax; row++) {
+    for (let col = colMin; col <= colMax; col++) {
+      refs.push(`${columnIndexToLetters(col)}${row}`);
+    }
+  }
+  return refs;
+}
diff --git a/src/evaluator.ts b/src/evaluator.ts
new file mode 100644
index 0000000..2ac45db
--- /dev/null
+++ b/src/evaluator.ts
@@ -0,0 +1,151 @@
+import { ASTNode } from './types.js';
+import { expandRange } from './cellRef.js';
+
+export type CellValue = number | string | boolean | null;
+
+export class EvalError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'EvalError';
+  }
+}
+
+export interface EvalContext {
+  getCellValue(ref: string): CellValue;
+}
+
+export function evaluate(node: ASTNode, ctx: EvalContext): CellValue {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'boolean':
+      return node.value;
+    case 'cellref':
+      return ctx.getCellValue(node.ref);
+    case 'range':
+      throw new EvalError('#VALUE!');
+    case 'unary': {
+      const value = toNumber(evaluate(node.operand, ctx));
+      return node.op === '-' ? -value : value;
+    }
+    case 'binary':
+      return evaluateBinary(node.op, node.left, node.right, ctx);
+    case 'call':
+      return evaluateCall(node.name, node.args, ctx);
+  }
+}
+
+function toNumber(value: CellValue): number {
+  if (value === null) return 0;
+  if (typeof value === 'number') return value;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  const parsed = Number(value);
+  if (Number.isNaN(parsed)) throw new EvalError('#VALUE!');
+  return parsed;
+}
+
+const ARITHMETIC_OPS = new Set(['+', '-', '*', '/']);
+
+function evaluateBinary(op: string, leftNode: ASTNode, rightNode: ASTNode, ctx: EvalContext): CellValue {
+  if (ARITHMETIC_OPS.has(op)) {
+    const left = toNumber(evaluate(leftNode, ctx));
+    const right = toNumber(evaluate(rightNode, ctx));
+    switch (op) {
+      case '+':
+        return left + right;
+      case '-':
+        return left - right;
+      case '*':
+        return left * right;
+      case '/':
+        if (right === 0) throw new EvalError('#DIV/0!');
+        return left / right;
+    }
+  }
+
+  const left = evaluate(leftNode, ctx);
+  const right = evaluate(rightNode, ctx);
+  return compare(op, left, right);
+}
+
+function compare(op: string, left: CellValue, right: CellValue): boolean {
+  const a = toComparable(left);
+  const b = toComparable(right);
+
+  switch (op) {
+    case '>':
+      return a > b;
+    case '<':
+      return a < b;
+    case '>=':
+      return a >= b;
+    case '<=':
+      return a <= b;
+    case '=':
+      return a === b;
+    case '<>':
+      return a !== b;
+    default:
+      throw new EvalError(`Unknown operator '${op}'`);
+  }
+}
+
+function toComparable(value: CellValue): number | string {
+  if (value === null) return 0;
+  if (typeof value === 'boolean') return value ? 1 : 0;
+  return value;
+}
+
+function isTruthy(value: CellValue): boolean {
+  if (value === null) return false;
+  if (typeof value === 'boolean') return value;
+  if (typeof value === 'number') return value !== 0;
+  return value.length > 0;
+}
+
+function collectNumbers(args: ASTNode[], ctx: EvalContext): number[] {
+  const result: number[] = [];
+  for (const arg of args) {
+    if (arg.type === 'range') {
+      for (const ref of expandRange(arg.start, arg.end)) {
+        const value = ctx.getCellValue(ref);
+        if (typeof value === 'number') result.push(value);
+      }
+    } else {
+      const value = evaluate(arg, ctx);
+      if (typeof value === 'number') result.push(value);
+    }
+  }
+  return result;
+}
+
+function evaluateCall(name: string, args: ASTNode[], ctx: EvalContext): CellValue {
+  switch (name) {
+    case 'SUM':
+      return collectNumbers(args, ctx).reduce((a, b) => a + b, 0);
+    case 'AVERAGE': {
+      const nums = collectNumbers(args, ctx);
+      if (nums.length === 0) throw new EvalError('#DIV/0!');
+      return nums.reduce((a, b) => a + b, 0) / nums.length;
+    }
+    case 'MIN': {
+      const nums = collectNumbers(args, ctx);
+      return nums.length ? Math.min(...nums) : 0;
+    }
+    case 'MAX': {
+      const nums = collectNumbers(args, ctx);
+      return nums.length ? Math.max(...nums) : 0;
+    }
+    case 'COUNT':
+      return collectNumbers(args, ctx).length;
+    case 'IF': {
+      if (args.length !== 3) throw new EvalError('#VALUE!');
+      const condition = evaluate(args[0], ctx);
+      return isTruthy(condition) ? evaluate(args[1], ctx) : evaluate(args[2], ctx);
+    }
+    default:
+      throw new EvalError(`#NAME? Unknown function '${name}'`);
+  }
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..c01ed06
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,142 @@
+import { ASTNode } from './types.js';
+import { normalizeCellRef } from './cellRef.js';
+import { parseFormula } from './parser.js';
+import { evaluate, EvalContext, EvalError, CellValue } from './evaluator.js';
+
+export type { CellValue } from './evaluator.js';
+
+type RawCell =
+  | { kind: 'value'; value: number | string | boolean }
+  | { kind: 'formula'; formula: string; ast: ASTNode };
+
+export class Spreadsheet {
+  private raw = new Map<string, RawCell>();
+  private dependencies = new Map<string, Set<string>>();
+  private computed = new Map<string, CellValue>();
+
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cell);
+    const trimmed = typeof value === 'string' ? value.trim() : value;
+
+    if (typeof trimmed === 'string' && trimmed.startsWith('=')) {
+      const { ast, dependencies } = parseFormula(trimmed.slice(1));
+      this.assertNoCycle(ref, dependencies);
+      this.raw.set(ref, { kind: 'formula', formula: trimmed, ast });
+      this.dependencies.set(ref, dependencies);
+    } else {
+      this.raw.set(ref, { kind: 'value', value });
+      this.dependencies.delete(ref);
+    }
+
+    this.recomputeAll();
+  }
+
+  get(cell: string): CellValue {
+    const ref = normalizeCellRef(cell);
+    return this.computed.get(ref) ?? null;
+  }
+
+  getDisplay(cell: string): string {
+    return formatValue(this.get(cell));
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const ref of this.raw.keys()) {
+      result.set(ref, this.computed.get(ref) ?? null);
+    }
+    return result;
+  }
+
+  private assertNoCycle(ref: string, dependencies: Set<string>): void {
+    for (const dep of dependencies) {
+      if (this.canReach(dep, ref)) {
+        throw new Error(`Circular reference detected: setting '${ref}' would create a cycle through '${dep}'`);
+      }
+    }
+  }
+
+  private canReach(from: string, to: string): boolean {
+    const visited = new Set<string>();
+    const stack = [from];
+    while (stack.length > 0) {
+      const node = stack.pop() as string;
+      if (node === to) return true;
+      if (visited.has(node)) continue;
+      visited.add(node);
+      const deps = this.dependencies.get(node);
+      if (deps) {
+        for (const next of deps) stack.push(next);
+      }
+    }
+    return false;
+  }
+
+  private recomputeAll(): void {
+    const order = this.topologicalOrder();
+    const ctx: EvalContext = {
+      getCellValue: (ref: string) => this.computed.get(ref) ?? null,
+    };
+
+    for (const ref of order) {
+      const cell = this.raw.get(ref) as RawCell;
+      if (cell.kind === 'value') {
+        this.computed.set(ref, cell.value);
+        continue;
+      }
+      try {
+        this.computed.set(ref, evaluate(cell.ast, ctx));
+      } catch (err) {
+        this.computed.set(ref, err instanceof EvalError ? err.message : '#ERROR!');
+      }
+    }
+  }
+
+  private topologicalOrder(): string[] {
+    const inDegree = new Map<string, number>();
+    const adjacency = new Map<string, string[]>();
+
+    for (const ref of this.raw.keys()) {
+      inDegree.set(ref, 0);
+      adjacency.set(ref, []);
+    }
+
+    for (const [ref, deps] of this.dependencies) {
+      if (!this.raw.has(ref)) continue;
+      for (const dep of deps) {
+        if (this.raw.has(dep)) {
+          (adjacency.get(dep) as string[]).push(ref);
+          inDegree.set(ref, (inDegree.get(ref) as number) + 1);
+        }
+      }
+    }
+
+    const queue: string[] = [];
+    for (const [ref, degree] of inDegree) {
+      if (degree === 0) queue.push(ref);
+    }
+
+    const order: string[] = [];
+    while (queue.length > 0) {
+      const node = queue.shift() as string;
+      order.push(node);
+      for (const next of adjacency.get(node) ?? []) {
+        const nextDegree = (inDegree.get(next) as number) - 1;
+        inDegree.set(next, nextDegree);
+        if (nextDegree === 0) queue.push(next);
+      }
+    }
+
+    if (order.length !== this.raw.size) {
+      throw new Error('Circular reference detected in spreadsheet graph');
+    }
+
+    return order;
+  }
+}
+
+function formatValue(value: CellValue): string {
+  if (value === null) return '';
+  if (typeof value === 'boolean') return value ? 'true' : 'false';
+  return String(value);
+}
diff --git a/src/lexer.ts b/src/lexer.ts
new file mode 100644
index 0000000..ca09d60
--- /dev/null
+++ b/src/lexer.ts
@@ -0,0 +1,142 @@
+export type TokenType =
+  | 'NUMBER'
+  | 'STRING'
+  | 'IDENT'
+  | 'CELLREF'
+  | 'PLUS'
+  | 'MINUS'
+  | 'STAR'
+  | 'SLASH'
+  | 'LPAREN'
+  | 'RPAREN'
+  | 'COMMA'
+  | 'COLON'
+  | 'GT'
+  | 'LT'
+  | 'GTE'
+  | 'LTE'
+  | 'EQ'
+  | 'NEQ'
+  | 'EOF';
+
+export interface Token {
+  type: TokenType;
+  value: string;
+  pos: number;
+}
+
+const SIMPLE_TOKENS: Record<string, TokenType> = {
+  '(': 'LPAREN',
+  ')': 'RPAREN',
+  ',': 'COMMA',
+  ':': 'COLON',
+  '+': 'PLUS',
+  '-': 'MINUS',
+  '*': 'STAR',
+  '/': 'SLASH',
+};
+
+export function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  const n = input.length;
+  let i = 0;
+
+  while (i < n) {
+    const ch = input[i];
+
+    if (/\s/.test(ch)) {
+      i++;
+      continue;
+    }
+
+    if (ch in SIMPLE_TOKENS) {
+      tokens.push({ type: SIMPLE_TOKENS[ch], value: ch, pos: i });
+      i++;
+      continue;
+    }
+
+    if (ch === '>') {
+      if (input[i + 1] === '=') {
+        tokens.push({ type: 'GTE', value: '>=', pos: i });
+        i += 2;
+      } else {
+        tokens.push({ type: 'GT', value: '>', pos: i });
+        i++;
+      }
+      continue;
+    }
+
+    if (ch === '<') {
+      if (input[i + 1] === '=') {
+        tokens.push({ type: 'LTE', value: '<=', pos: i });
+        i += 2;
+      } else if (input[i + 1] === '>') {
+        tokens.push({ type: 'NEQ', value: '<>', pos: i });
+        i += 2;
+      } else {
+        tokens.push({ type: 'LT', value: '<', pos: i });
+        i++;
+      }
+      continue;
+    }
+
+    if (ch === '=') {
+      tokens.push({ type: 'EQ', value: '=', pos: i });
+      i++;
+      continue;
+    }
+
+    if (ch === '"') {
+      let j = i + 1;
+      let str = '';
+      while (j < n && input[j] !== '"') {
+        str += input[j];
+        j++;
+      }
+      if (j >= n) {
+        throw new Error(`Unterminated string literal at position ${i}`);
+      }
+      tokens.push({ type: 'STRING', value: str, pos: i });
+      i = j + 1;
+      continue;
+    }
+
+    if (/[0-9.]/.test(ch)) {
+      let j = i;
+      let numStr = '';
+      while (j < n && /[0-9.]/.test(input[j])) {
+        numStr += input[j];
+        j++;
+      }
+      tokens.push({ type: 'NUMBER', value: numStr, pos: i });
+      i = j;
+      continue;
+    }
+
+    if (/[A-Za-z]/.test(ch)) {
+      let j = i;
+      let letters = '';
+      while (j < n && /[A-Za-z]/.test(input[j])) {
+        letters += input[j];
+        j++;
+      }
+      if (j < n && /[0-9]/.test(input[j])) {
+        let digits = '';
+        while (j < n && /[0-9]/.test(input[j])) {
+          digits += input[j];
+          j++;
+        }
+        tokens.push({ type: 'CELLREF', value: letters.toUpperCase() + digits, pos: i });
+      } else {
+        tokens.push({ type: 'IDENT', value: letters.toUpperCase(), pos: i });
+      }
+      i = j;
+      continue;
+    }
+
+    throw new Error(`Unexpected character '${ch}' at position ${i}`);
+  }
+
+  tokens.push({ type: 'EOF', value: '', pos: n });
+  return tokens;
+}
diff --git a/src/parser.ts b/src/parser.ts
new file mode 100644
index 0000000..ca1885e
--- /dev/null
+++ b/src/parser.ts
@@ -0,0 +1,187 @@
+import { tokenize, Token, TokenType } from './lexer.js';
+import { ASTNode } from './types.js';
+import { expandRange } from './cellRef.js';
+
+const COMPARISON_TYPES: TokenType[] = ['GT', 'LT', 'GTE', 'LTE', 'EQ', 'NEQ'];
+
+class Parser {
+  private tokens: Token[];
+  private pos = 0;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+  }
+
+  private peek(offset = 0): Token {
+    return this.tokens[Math.min(this.pos + offset, this.tokens.length - 1)];
+  }
+
+  private next(): Token {
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: TokenType): Token {
+    const token = this.next();
+    if (token.type !== type) {
+      throw new Error(`Expected ${type} but got '${token.value || token.type}' at position ${token.pos}`);
+    }
+    return token;
+  }
+
+  isAtEnd(): boolean {
+    return this.peek().type === 'EOF';
+  }
+
+  current(): Token {
+    return this.peek();
+  }
+
+  parseExpression(): ASTNode {
+    return this.parseComparison();
+  }
+
+  private parseComparison(): ASTNode {
+    let left = this.parseAdditive();
+    if (COMPARISON_TYPES.includes(this.peek().type)) {
+      const op = this.next();
+      const right = this.parseAdditive();
+      left = { type: 'binary', op: op.value, left, right };
+    }
+    return left;
+  }
+
+  private parseAdditive(): ASTNode {
+    let left = this.parseTerm();
+    while (this.peek().type === 'PLUS' || this.peek().type === 'MINUS') {
+      const op = this.next();
+      const right = this.parseTerm();
+      left = { type: 'binary', op: op.value, left, right };
+    }
+    return left;
+  }
+
+  private parseTerm(): ASTNode {
+    let left = this.parseUnary();
+    while (this.peek().type === 'STAR' || this.peek().type === 'SLASH') {
+      const op = this.next();
+      const right = this.parseUnary();
+      left = { type: 'binary', op: op.value, left, right };
+    }
+    return left;
+  }
+
+  private parseUnary(): ASTNode {
+    if (this.peek().type === 'MINUS') {
+      this.next();
+      const operand = this.parseUnary();
+      return { type: 'unary', op: '-', operand };
+    }
+    if (this.peek().type === 'PLUS') {
+      this.next();
+      return this.parseUnary();
+    }
+    return this.parsePrimary();
+  }
+
+  private parsePrimary(): ASTNode {
+    const token = this.peek();
+
+    if (token.type === 'NUMBER') {
+      this.next();
+      return { type: 'number', value: parseFloat(token.value) };
+    }
+
+    if (token.type === 'STRING') {
+      this.next();
+      return { type: 'string', value: token.value };
+    }
+
+    if (token.type === 'LPAREN') {
+      this.next();
+      const expr = this.parseExpression();
+      this.expect('RPAREN');
+      return expr;
+    }
+
+    if (token.type === 'CELLREF') {
+      this.next();
+      return { type: 'cellref', ref: token.value };
+    }
+
+    if (token.type === 'IDENT') {
+      this.next();
+      if (token.value === 'TRUE') return { type: 'boolean', value: true };
+      if (token.value === 'FALSE') return { type: 'boolean', value: false };
+
+      if (this.peek().type === 'LPAREN') {
+        this.next();
+        const args: ASTNode[] = [];
+        if (this.peek().type !== 'RPAREN') {
+          args.push(this.parseArg());
+          while (this.peek().type === 'COMMA') {
+            this.next();
+            args.push(this.parseArg());
+          }
+        }
+        this.expect('RPAREN');
+        return { type: 'call', name: token.value, args };
+      }
+
+      throw new Error(`Unknown identifier '${token.value}' at position ${token.pos}`);
+    }
+
+    throw new Error(`Unexpected token '${token.value || token.type}' at position ${token.pos}`);
+  }
+
+  private parseArg(): ASTNode {
+    if (this.peek().type === 'CELLREF' && this.peek(1).type === 'COLON' && this.peek(2).type === 'CELLREF') {
+      const start = this.next().value;
+      this.next();
+      const end = this.next().value;
+      return { type: 'range', start, end };
+    }
+    return this.parseExpression();
+  }
+}
+
+export interface ParsedFormula {
+  ast: ASTNode;
+  dependencies: Set<string>;
+}
+
+export function parseFormula(formulaBody: string): ParsedFormula {
+  const tokens = tokenize(formulaBody);
+  const parser = new Parser(tokens);
+  const ast = parser.parseExpression();
+  if (!parser.isAtEnd()) {
+    const token = parser.current();
+    throw new Error(`Unexpected trailing token '${token.value || token.type}' at position ${token.pos}`);
+  }
+  return { ast, dependencies: collectDependencies(ast) };
+}
+
+function collectDependencies(node: ASTNode, deps: Set<string> = new Set()): Set<string> {
+  switch (node.type) {
+    case 'number':
+    case 'string':
+    case 'boolean':
+      break;
+    case 'cellref':
+      deps.add(node.ref);
+      break;
+    case 'range':
+      for (const ref of expandRange(node.start, node.end)) deps.add(ref);
+      break;
+    case 'binary':
+      collectDependencies(node.left, deps);
+      collectDependencies(node.right, deps);
+      break;
+    case 'unary':
+      collectDependencies(node.operand, deps);
+      break;
+    case 'call':
+      for (const arg of node.args) collectDependencies(arg, deps);
+      break;
+  }
+  return deps;
+}
