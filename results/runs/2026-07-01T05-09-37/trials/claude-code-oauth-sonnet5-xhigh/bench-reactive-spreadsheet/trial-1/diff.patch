diff --git a/src/cellRef.test.ts b/src/cellRef.test.ts
new file mode 100644
index 0000000..3f804c7
--- /dev/null
+++ b/src/cellRef.test.ts
@@ -0,0 +1,86 @@
+import { describe, expect, it } from 'vitest';
+import {
+  columnIndexToLetters,
+  columnLettersToIndex,
+  expandRange,
+  isValidCellRef,
+  normalizeCellRef,
+  parseCellRef,
+} from './cellRef.js';
+
+describe('columnLettersToIndex / columnIndexToLetters', () => {
+  it('converts single letters', () => {
+    expect(columnLettersToIndex('A')).toBe(0);
+    expect(columnLettersToIndex('Z')).toBe(25);
+  });
+
+  it('converts double letters', () => {
+    expect(columnLettersToIndex('AA')).toBe(26);
+    expect(columnLettersToIndex('AZ')).toBe(51);
+    expect(columnLettersToIndex('BA')).toBe(52);
+  });
+
+  it('round-trips indices back to letters', () => {
+    for (const idx of [0, 1, 25, 26, 27, 51, 52, 701, 702]) {
+      expect(columnLettersToIndex(columnIndexToLetters(idx))).toBe(idx);
+    }
+  });
+
+  it('is case-insensitive', () => {
+    expect(columnLettersToIndex('a')).toBe(columnLettersToIndex('A'));
+  });
+});
+
+describe('parseCellRef / normalizeCellRef', () => {
+  it('parses column and row', () => {
+    expect(parseCellRef('A1')).toEqual({ col: 0, row: 1 });
+    expect(parseCellRef('Z100')).toEqual({ col: 25, row: 100 });
+    expect(parseCellRef('AA1')).toEqual({ col: 26, row: 1 });
+  });
+
+  it('normalizes lowercase refs to uppercase', () => {
+    expect(normalizeCellRef('a1')).toBe('A1');
+    expect(normalizeCellRef('aa23')).toBe('AA23');
+  });
+
+  it('throws on invalid refs', () => {
+    expect(() => parseCellRef('1A')).toThrow();
+    expect(() => parseCellRef('A')).toThrow();
+    expect(() => parseCellRef('')).toThrow();
+  });
+});
+
+describe('isValidCellRef', () => {
+  it('validates well-formed refs', () => {
+    expect(isValidCellRef('A1')).toBe(true);
+    expect(isValidCellRef('AA100')).toBe(true);
+    expect(isValidCellRef('1A')).toBe(false);
+    expect(isValidCellRef('A')).toBe(false);
+  });
+});
+
+describe('expandRange', () => {
+  it('expands a column range', () => {
+    expect(expandRange('A1', 'A5')).toEqual(['A1', 'A2', 'A3', 'A4', 'A5']);
+  });
+
+  it('expands a row range', () => {
+    expect(expandRange('A1', 'C1')).toEqual(['A1', 'B1', 'C1']);
+  });
+
+  it('expands a block range', () => {
+    expect(expandRange('A1', 'C3')).toEqual([
+      'A1', 'B1', 'C1',
+      'A2', 'B2', 'C2',
+      'A3', 'B3', 'C3',
+    ]);
+  });
+
+  it('handles reversed start/end', () => {
+    expect(expandRange('C3', 'A1')).toEqual([
+      'A1', 'B1', 'C1',
+      'A2', 'B2', 'C2',
+      'A3', 'B3', 'C3',
+    ]);
+  });
+});
