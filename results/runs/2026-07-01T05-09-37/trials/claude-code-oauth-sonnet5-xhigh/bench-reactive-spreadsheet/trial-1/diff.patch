@@ -0,0 +1,342 @@
+import { describe, expect, it } from 'vitest';
+import { Spreadsheet } from './index.js';
+
+describe('raw values', () => {
+  it('stores and retrieves numbers, strings, and booleans', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('A1', 42);
+    sheet.set('A2', 'hello');
+    sheet.set('A3', true);
+
+    expect(sheet.get('A1')).toBe(42);
+    expect(sheet.get('A2')).toBe('hello');
+    expect(sheet.get('A3')).toBe(true);
+  });
+
+  it('returns null for empty cells', () => {
+    const sheet = new Spreadsheet();
+    expect(sheet.get('Z99')).toBeNull();
+  });
+
+  it('is case-insensitive and column-aware for cell references', () => {
+    const sheet = new Spreadsheet();
+    sheet.set('a1', 5);
+    expect(sheet.get('A1')).toBe(5);
+  });
+});
+
+describe('formulas: arithmetic', () => {
+  it('adds two cells', () => {
+    const sheet = new Spreadsheet();
