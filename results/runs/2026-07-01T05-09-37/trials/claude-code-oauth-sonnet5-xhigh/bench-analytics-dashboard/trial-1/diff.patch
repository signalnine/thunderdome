+import Database from 'better-sqlite3';
+import fs from 'node:fs';
+import path from 'node:path';
+
+let dbInstance: Database.Database | null = null;
+
+export function setDb(database: Database.Database): void {
+  dbInstance = database;
+}
+
+export function getDb(): Database.Database {
+  if (!dbInstance) {
+    throw new Error('Database not initialized. Call setDb() first.');
+  }
+  return dbInstance;
+}
+
+function loadSchema(database: Database.Database): void {
+  const schemaPath = path.join(process.cwd(), 'schema.sql');
+  const schema = fs.readFileSync(schemaPath, 'utf-8');
+  database.exec(schema);
+}
+
+export function createTestDb(): Database.Database {
+  const database = new Database(':memory:');
+  database.pragma('foreign_keys = ON');
+  loadSchema(database);
+  return database;
+}
+
+export function createFileDb(filePath: string): Database.Database {
+  const database = new Database(filePath);
+  database.pragma('foreign_keys = ON');
+  loadSchema(database);
+  return database;
+}
+
+export function closeDb(): void {
+  if (dbInstance) {
+    dbInstance.close();
+    dbInstance = null;
+  }
+}
