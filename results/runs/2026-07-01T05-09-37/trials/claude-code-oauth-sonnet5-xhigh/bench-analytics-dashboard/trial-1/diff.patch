s.push('timestamp >= ?');\n    params.push(filter.start);\n  }\n  if (filter.end) {\n    clauses.push('timestamp <= ?');\n    params.push(filter.end);\n  }\n  return { clauses, params };\n}\n\nrouter.post(\n  '/count',\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const { event_name: eventName, start, end } = req.body ?? {};\n    if (!eventName) {\n      throw new ValidationError('event_name is required');\n    }\n\n    const db = getDb();\n    const { clauses, params } = buildTimeRangeClauses(user.tenantId, { event_name: eventName, start, end });\n    const row = db\n      .prepare(`SELECT COUNT(*) as count FROM events WHERE ${clauses.join(' AND ')}`)\n      .get(...params) as { count: number };\n\n    res.status(200).json({ count: row.count });\n  })\n);\n\nrouter.post(\n  '/timeseries',\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const { event_name: eventName, bucket = 'day', start, end } = req.body ?? {};\n    if (!eventName) {\n      throw new ValidationError('event_name is required');\n    }\n    const format = BUCKET_FORMATS[bucket];\n    if (!format) {\n      throw new ValidationError(`bucket must be one of: ${Object.keys(BUCKET_FORMATS).join(', ')}`);\n    }\n\n    const db = getDb();\n    const { clauses, params } = buildTimeRangeClauses(user.tenantId, { event_name: eventName, start, end });\n    const rows = db\n      .prepare(\n        `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count FROM events WHERE ${clauses.join(' AND ')} GROUP BY bucket ORDER BY bucket`\n      )\n      .all(...params) as { bucket: string; count: number }[];\n\n    res.status(200).json({ data: rows });\n  })\n);\n\nrouter.post(\n  '/breakdown',\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const { event_name: eventName, property_key: propertyKey, start, end } = req.body ?? {};\n    if (!eventName || !propertyKey) {\n      throw new ValidationError('event_name and property_key are required');\n    }\n\n    const db = getDb();\n    const { clauses, params } = buildTimeRangeClauses(user.tenantId, { event_name: eventName, start, end });\n    const rows = db\n      .prepare(`SELECT properties FROM events WHERE ${clauses.join(' AND ')}`)\n      .all(...params) as { properties: string }[];\n\n    const counts = new Map<string, number>();\n    for (const row of rows) {\n      const props = JSON.parse(row.properties) as Record<string, unknown>;\n      const value = props[propertyKey];\n      if (value === undefined) continue;\n      const key = String(value);\n      counts.set(key, (counts.get(key) ?? 0) + 1);\n    }\n\n    const data = [...counts.entries()].map(([property_value, count]) => ({ property_value, count }));\n    res.status(200).json({ data });\n  })\n);\n\nrouter.post(\n  '/funnel',\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const { steps, start, end } = req.body ?? {};\n    if (!Array.isArray(steps) || steps.length === 0) {\n      throw new ValidationError('steps must be a non-empty array');\n    }\n\n    const db = getDb();\n    let carrySet: Set<string> | null = null;\n    const results: { step: string; count: number }[] = [];\n\n    for (const stepName of steps) {\n      const clauses = ['tenant_id = ?', 'name = ?', 'session_id IS NOT NULL'];\n      const params: unknown[] = [user.tenantId, stepName];\n      if (start) {\n        clauses.push('timestamp >= ?');\n        params.push(start);\n      }\n      if (end) {\n        clauses.push('timestamp <= ?');\n        params.push(end);\n      }\n\n      const rows = db\n        .prepare(`SELECT DISTINCT session_id FROM events WHERE ${clauses.join(' AND ')}`)\n        .all(...params) as { session_id: string }[];\n      const stepSet = new Set(rows.map((r) => r.session_id));\n\n      carrySet = carrySet ? new Set([...carrySet].filter((s) => stepSet.has(s))) : stepSet;\n      results.push({ step: stepName, count: carrySet.size });\n    }\n\n    res.status(200).json({ steps: results });\n  })\n);\n\nexport default router;\n","structuredPatch":[{"oldStart":141,"oldLines":7,"newStart":141,"newLines":17,"lines":["         .all(...params) as { session_id: string }[];","       const stepSet = new Set(rows.map((r) => r.session_id));"," ","-      carrySet = carrySet ? new Set([...carrySet].filter((s) => stepSet.has(s))) : stepSet;","+      if (carrySet === null) {","+        carrySet = stepSet;","+      } else {","+        const intersection: Set<string> = new Set();","+        for (const sessionId of carrySet) {","+          if (stepSet.has(sessionId)) {","+            intersection.add(sessionId);","+          }","+        }","+        carrySet = intersection;","+      }","       results.push({ step: stepName, count: carrySet.size });","     }"," "]}],"userModified":false,"replaceAll":false}}
