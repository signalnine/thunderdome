p((key) => {\n        const value = key === 'properties' ? JSON.stringify(event.properties) : record[key];\n        return csvEscape(value);\n      }).join(',')\n    );\n  }\n  return lines.join('\\n');\n}\n\nrouter.get(\n  '/events',\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const format = (req.query.format as string) ?? 'json';\n    if (format !== 'json' && format !== 'csv') {\n      throw new ValidationError('format must be json or csv');\n    }\n\n    const db = getDb();\n    const rows = db\n      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')\n      .all(user.tenantId) as EventRow[];\n    const events = rows.map(toPublicEvent);\n\n    if (format === 'csv') {\n      res.status(200).set('Content-Type', 'text/csv').send(toCsv(events));\n      return;\n    }\n\n    res.status(200).json(events);\n  })\n);\n\nrouter.get(\n  '/dashboard/:id',\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const db = getDb();\n    const dashboard = db\n      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')\n      .get(req.params.id, user.tenantId) as DashboardRow | undefined;\n    if (!dashboard) {\n      throw new NotFoundError('Dashboard not found');\n    }\n\n    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(dashboard.id) as WidgetRow[];\n\n    res.status(200).json({\n      dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },\n      widgets: widgets.map((w) => ({ ...w, config: JSON.parse(w.config) })),\n    });\n  })\n);\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":236,"cache_read_input_tokens":90921,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":236},"output_tokens":54,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":nul