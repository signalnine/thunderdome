ow new ConflictError('Email already registered');\n    }\n\n    const id = uuidv4();\n    db.prepare(\n      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'\n    ).run(id, email, hashPassword(password), tenantId, 'viewer');\n\n    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;\n    res.status(201).json(toPublicUser(row));\n  })\n);\n\nrouter.post(\n  '/login',\n  asyncHandler(async (req, res) => {\n    const { email, password } = req.body ?? {};\n    if (!email || !password) {\n      throw new ValidationError('email and password are required');\n    }\n\n    const db = getDb();\n    const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;\n    if (!row || !verifyPassword(password, row.password_hash)) {\n      throw new AuthError('Invalid email or password');\n    }\n\n    const token = signToken(row.id, row.tenant_id);\n    res.status(200).json({ token, user: toPublicUser(row) });\n  })\n);\n\nrouter.get(\n  '/me',\n  requireAuth,\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const db = getDb();\n    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(user.id) as UserRow | undefined;\n    if (!row) {\n      throw new NotFoundError('User not found');\n    }\n    res.status(200).json(toPublicUser(row));\n  })\n);\n\nrouter.patch(\n  '/:id/role',\n  requireAuth,\n  asyncHandler(async (req, res) => {\n    const user = (req as AuthedRequest).user!;\n    const { role } = req.body ?? {};\n    if (!role || !ROLES.includes(role)) {\n      throw new ValidationError(`role must be one of: ${ROLES.join(', ')}`);\n    }\n\n    const db = getDb();\n    const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(user.id) as UserRow | undefined;\n    if (!requester || requester.role !== 'admin') {\n      throw new ForbiddenError('Admin role required');\n    }\n\n    const target = db\n      .prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?')\n      .get(req.params.id, user.tenantId) as UserRow | undefined;\n    if (!target) {\n      throw new NotFoundError('User not found');\n    }\n\n    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);\n    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;\n    res.status(200).json(toPublicUser(updated));\n  })\n);\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":767,"cache_read_input_tokens":78244,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":767},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"054f1a71-2db8-4fa5-841e-148f1be7c9b4","uuid":"701bd19a-dd3e-431a-933c-a96987938eb0","request_id":"req_011CcamkHKRsGbWvNZBcrrQW"}
