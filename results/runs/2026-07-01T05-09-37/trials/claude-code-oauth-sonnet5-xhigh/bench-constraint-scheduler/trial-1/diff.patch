+import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+interface Interval {
+  start: number;
+  end: number;
+}
+
+interface Candidate {
+  roomId: string;
+  capacity: number;
+  start: number;
+  end: number;
+  isPreferred: boolean;
+}
+
+/** Detects cycles (including self-references) in the prerequisite graph; unknown prerequisite ids are ignored since they can't participate in a cycle. */
+function detectCycle(events: Event[]): void {
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const color = new Map<string, 0 | 1 | 2>();
+  for (const e of events) color.set(e.id, 0);
+
+  function visit(id: string, path: string[]): void {
+    color.set(id, 1);
+    const event = byId.get(id);
+    for (const p of event?.prerequisites ?? []) {
+      if (!byId.has(p)) continue;
+      const state = color.get(p);
+      if (state === 1) {
+        throw new Error(`Cycle detected in prerequisites: ${[...path, p].join(' -> ')}`);
+      }
+      if (state === 0) visit(p, [...path, p]);
+    }
+    color.set(id, 2);
+  }
+
+  for (const e of events) {
+    if (color.get(e.id) === 0) visit(e.id, [e.id]);
+  }
+}
+
+/**
+ * Topologically sorts events so prerequisites always precede their dependents. Ties are broken
+ * by favoring events that unlock more dependents, then shorter events, for better packing during
+ * the search. Events that (transitively) depend on a nonexistent prerequisite id never reach
+ * indegree zero through the normal pass and are appended at the end instead, so every event is
+ * still visited exactly once by the search.
+ */
+function topoOrder(events: Event[]): Event[] {
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const indegree = new Map<string, number>();
+  const dependents = new Map<string, string[]>();
+  for (const e of events) {
+    dependents.set(e.id, []);
+  }
+  for (const e of events) {
+    const prereqs = e.prerequisites ?? [];
+    indegree.set(e.id, prereqs.length);
+    for (const p of prereqs) {
+      if (byId.has(p)) dependents.get(p)!.push(e.id);
+    }
+  }
+
+  const compare = (a: Event, b: Event): number => {
+    const dependentDiff = dependents.get(b.id)!.length - dependents.get(a.id)!.length;
+    if (dependentDiff !== 0) return dependentDiff;
+    return a.duration - b.duration;
+  };
+
+  const queue = events.filter((e) => indegree.get(e.id) === 0);
+  const order: Event[] = [];
+  while (queue.length) {
+    queue.sort(compare);
+    const next = queue.shift()!;
+    order.push(next);
+    for (const depId of dependents.get(next.id)!) {
+      const remaining = indegree.get(depId)! - 1;
+      indegree.set(depId, remaining);
+      if (remaining === 0) queue.push(byId.get(depId)!);
+    }
+  }
+
+  if (order.length < events.length) {
+    const seen = new Set(order.map((e) => e.id));
+    for (const e of events) if (!seen.has(e.id)) order.push(e);
+  }
+  return order;
+}
+
+/**
+ * Finds the earliest start >= lowerBound for a job of the given duration that fits within
+ * an existing set of intervals (with `gap` minutes required on both sides) and before windowEnd.
+ * Scheduling every accepted event as early as possible never hurts later placements, so search
+ * only needs to consider this canonical start time per room.
+ */
+function earliestStart(
+  timeline: Interval[],
+  lowerBound: number,
+  duration: number,
+  windowEnd: number,
+  gap: number,
+): number | null {
+  const sorted = [...timeline].sort((a, b) => a.start - b.start);
+  for (let i = 0; i <= sorted.length; i++) {
+    const prevEnd = i === 0 ? null : sorted[i - 1].end;
+    const nextStart = i === sorted.length ? Infinity : sorted[i].start;
+    const candidateStart = prevEnd === null ? lowerBound : Math.max(lowerBound, prevEnd + gap);
+    if (candidateStart + duration <= windowEnd && candidateStart + duration + gap <= nextStart) {
+      return candidateStart;
+    }
+  }
+  return null;
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  detectCycle(events);
+
+  const gap = options.gap ?? 15;
+  const order = topoOrder(events);
+  const n = order.length;
+
+  const roomTimelines = new Map<string, Interval[]>();
+  for (const r of rooms) roomTimelines.set(r.id, []);
+
+  const scheduledInfo = new Map<string, { roomId: string; start: number; end: number }>();
+
+  // Score weighs scheduled-count far above preferred-room satisfaction, so preference never
+  // costs a scheduled event; it only breaks ties among equally-maximal schedules.
+  const scoreOf = (count: number, preferredCount: number): number => count * (n + 1) + preferredCount;
+
+  let bestScore = -1;
+  let bestAssignments: Assignment[] = [];
+  let bestScheduledIds = new Set<string>();
+
+  const recordIfBetter = (count: number, preferredCount: number): void => {
+    const score = scoreOf(count, preferredCount);
+    if (score > bestScore) {
+      bestScore = score;
+      bestAssignments = Array.from(scheduledInfo.entries()).map(([eventId, info]) => ({
+        eventId,
+        roomId: info.roomId,
+        startTime: info.start,
+        endTime: info.end,
+      }));
+      bestScheduledIds = new Set(scheduledInfo.keys());
+    }
+  };
+
+  let nodeBudget = 300_000;
+
+  function recurse(index: number, count: number, preferredCount: number): void {
+    if (nodeBudget-- <= 0) {
+      recordIfBetter(count, preferredCount);
+      return;
+    }
+    const remaining = n - index;
+    if (scoreOf(count + remaining, preferredCount + remaining) <= bestScore) return;
+    if (index === n) {
+      recordIfBetter(count, preferredCount);
+      return;
+    }
+
+    const event = order[index];
+    const attendees = event.attendees ?? 1;
+    const prereqs = event.prerequisites ?? [];
+    const prereqsSatisfied = prereqs.every((p) => scheduledInfo.has(p));
+
+    if (prereqsSatisfied) {
+      const lowerBound = prereqs.length
+        ? Math.max(options.startTime, ...prereqs.map((p) => scheduledInfo.get(p)!.end + gap))
+        : options.startTime;
+
+      const candidates: Candidate[] = [];
+      for (const room of rooms) {
+        if (room.capacity < attendees) continue;
+        const start = earliestStart(roomTimelines.get(room.id)!, lowerBound, event.duration, options.endTime, gap);
+        if (start !== null) {
+          candidates.push({
+            roomId: room.id,
+            capacity: room.capacity,
+            start,
+            end: start + event.duration,
+            isPreferred: room.id === event.preferredRoom,
+          });
+        }
+      }
+      candidates.sort((a, b) => {
+        if (a.isPreferred !== b.isPreferred) return a.isPreferred ? -1 : 1;
+        if (a.start !== b.start) return a.start - b.start;
+        return a.capacity - b.capacity;
+      });
+
+      for (const candidate of candidates) {
+        scheduledInfo.set(event.id, { roomId: candidate.roomId, start: candidate.start, end: candidate.end });
+        roomTimelines.get(candidate.roomId)!.push({ start: candidate.start, end: candidate.end });
+
+        recurse(index + 1, count + 1, preferredCount + (candidate.isPreferred ? 1 : 0));
+
+        roomTimelines.get(candidate.roomId)!.pop();
+        scheduledInfo.delete(event.id);
+        if (nodeBudget <= 0) return;
+      }
+    }
+
+    recurse(index + 1, count, preferredCount);
+  }
+
+  recurse(0, 0, 0);
+
+  const unscheduled = events.filter((e) => !bestScheduledIds.has(e.id)).map((e) => e.id);
+  return { assignments: bestAssignments, unscheduled };
+}
