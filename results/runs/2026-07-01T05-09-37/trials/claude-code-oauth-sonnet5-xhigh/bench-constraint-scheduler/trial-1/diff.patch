ts that unlock more dependents, then shorter events, for better packing during\n * the search. Events that (transitively) depend on a nonexistent prerequisite id never reach\n * indegree zero through the normal pass and are appended at the end instead, so every event is\n * still visited exactly once by the search.\n */\nfunction topoOrder(events: Event[]): Event[] {\n  const byId = new Map(events.map((e) => [e.id, e]));\n  const indegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n  for (const e of events) {\n    dependents.set(e.id, []);\n  }\n  for (const e of events) {\n    const prereqs = e.prerequisites ?? [];\n    indegree.set(e.id, prereqs.length);\n    for (const p of prereqs) {\n      if (byId.has(p)) dependents.get(p)!.push(e.id);\n    }\n  }\n\n  const compare = (a: Event, b: Event): number => {\n    const dependentDiff = dependents.get(b.id)!.length - dependents.get(a.id)!.length;\n    if (dependentDiff !== 0) return dependentDiff;\n    return a.duration - b.duration;\n  };\n\n  const queue = events.filter((e) => indegree.get(e.id) === 0);\n  const order: Event[] = [];\n  while (queue.length) {\n    queue.sort(compare);\n    const next = queue.shift()!;\n    order.push(next);\n    for (const depId of dependents.get(next.id)!) {\n      const remaining = indegree.get(depId)! - 1;\n      indegree.set(depId, remaining);\n      if (remaining === 0) queue.push(byId.get(depId)!);\n    }\n  }\n\n  if (order.length < events.length) {\n    const seen = new Set(order.map((e) => e.id));\n    for (const e of events) if (!seen.has(e.id)) order.push(e);\n  }\n  return order;\n}","originalFile":"import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';\n\ninterface Interval {\n  start: number;\n  end: number;\n}\n\ninterface Candidate {\n  roomId: string;\n  capacity: number;\n  start: number;\n  end: number;\n  isPreferred: boolean;\n}\n\n/** Detects cycles (including self-references) in the prerequisite graph; unknown prerequisite ids are ignored since they can't participate in a cycle. */\nfunction detectCycle(events: Event[]): void {\n  const byId = new Map(events.map((e) => [e.id, e]));\n  const color = new Map<string, 0 | 1 | 2>();\n  for (const e of events) color.set(e.id, 0);\n\n  function visit(id: string, path: string[]): void {\n    color.set(id, 1);\n    const event = byId.get(id);\n    for (const p of event?.prerequisites ?? []) {\n      if (!byId.has(p)) continue;\n      const state = color.get(p);\n      if (state === 1) {\n        throw new Error(`Cycle detected in prerequisites: ${[...path, p].join(' -> ')}`);\n      }\n      if (state === 0) visit(p, [...path, p]);\n    }\n    color.set(id, 2);\n  }\n\n  for (const e of events) {\n    if (color.get(e.id) === 0) visit(e.id, [e.id]);\n  }\n}\n\n/** Topologically sorts events so prerequisites always precede their dependents. Ties are broken by favoring events that unlock more dependents, then shorter events, for better packing during the search. */\nfunction topoOrder(events: Event[]): Event[] {\n  const byId = new Map(events.map((e) => [e.id, e]));\n  const indegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n  for (const e of events) {\n    dependents.set(e.id, []);\n  }\n  for (const e of events) {\n    const prereqs = (e.prerequisites ?? []).filter((p) => byId.has(p));\n    indegree.set(e.id, prereqs.length);\n    for (const p of prereqs) dependents.get(p)!.push(e.id);\n  }\n\n  const compare = (a: Event, b: Event): number => {\n    const dependentDiff = dependents.get(b.id)!.length - dependents.get(a.id)!.length;\n    if (dependentDiff !== 0) return dependentDiff;\n    return a.duration - b.duration;\n  };\n\n  const queue = events.filter((e) => indegree.get(e.id) === 0);\n  const order: Event[] = [];\n  while (queue.length) {\n    queue.sort(compare);\n    const next = queue.shift()!;\n    order.push(next);\n    for (const depId of dependents.get(next.i