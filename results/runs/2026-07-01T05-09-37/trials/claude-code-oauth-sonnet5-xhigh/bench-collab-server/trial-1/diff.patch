@@ -0,0 +1,30 @@
+export interface Document {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface Version {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export interface InsertOperation {
+  type: 'insert';
+  position: number;
+  text: string;
+}
+
+export interface DeleteOperation {
+  type: 'delete';
+  position: number;
+  count: number;
+}
+
+export type Operation = InsertOperation | DeleteOperation;
diff --git a/src/ot.ts b/src/ot.ts
new file mode 100644
index 0000000..f14c994
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,71 @@
+import type { DeleteOperation, Operation } from './models.js';
+
+/** Maps a position through an already-applied delete, collapsing positions inside the deleted range to its start. */
+function mapPosThroughDelete(pos: number, del: DeleteOperation): number {
+  if (pos <= del.position) return pos;
+  if (pos >= del.position + del.count) return pos - del.count;
+  return del.position;
+}
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/** Transforms op1 so it applies cleanly after op2 has already been applied. */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    const shift = op2.position <= op1.position ? op2.text.length : 0;
+    return { ...op1, position: op1.position + shift };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    return { ...op1, position: mapPosThroughDelete(op1.position, op2) };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    const shiftStart = op2.position <= op1.position ? op2.text.length : 0;
+    const shiftEnd = op2.position <= op1.position + op1.count ? op2.text.length : 0;
+    return { ...op1, position: op1.position + shiftStart, count: op1.count + (shiftEnd - shiftStart) };
+  }
+
+  // delete vs delete
+  const del1 = op1 as DeleteOperation;
+  const del2 = op2 as DeleteOperation;
+  const newStart = mapPosThroughDelete(del1.position, del2);
+  const newEnd = mapPosThroughDelete(del1.position + del1.count, del2);
+  return { ...del1, position: newStart, count: Math.max(0, newEnd - newStart) };
+}
+
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (typeof op !== 'object' || op === null) return false;
+  const candidate = op as Record<string, unknown>;
+
+  if (candidate.type === 'insert') {
+    const { position, text } = candidate;
+    return (
+      typeof position === 'number' &&
+      Number.isInteger(position) &&
+      position >= 0 &&
+      position <= contentLength &&
+      typeof text === 'string'
+    );
+  }
+
+  if (candidate.type === 'delete') {
+    const { position, count } = candidate;
+    return (
+      typeof position === 'number' &&
+      Number.isInteger(position) &&
+      position >= 0 &&
+      typeof count === 'number' &&
+      Number.isInteger(count) &&
+      count >= 0 &&
+      position + count <= contentLength
+    );
+  }
+
+  return false;
+}
diff --git a/src/routes.ts b/src/routes.ts
new file mode 100644
index 0000000..2175077
