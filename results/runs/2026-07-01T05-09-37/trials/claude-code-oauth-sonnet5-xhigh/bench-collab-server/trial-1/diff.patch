+++ b/src/routes.ts
@@ -0,0 +1,110 @@
+import { Router } from 'express';
+import { randomUUID } from 'node:crypto';
+import type Database from 'better-sqlite3';
+import type { Document, Version } from './models.js';
+
+export function createRoutes(db: Database.Database): Router {
+  const router = Router();
+
+  router.post('/docs', (req, res) => {
+    const title = typeof req.body?.title === 'string' ? req.body.title : 'Untitled';
+    const content = typeof req.body?.content === 'string' ? req.body.content : '';
+    const id = randomUUID();
+
+    const insert = db.transaction(() => {
+      db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, content);
+      db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)').run(
+        id,
+        content
+      );
+    });
+    insert();
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Document;
+    res.status(201).json(doc);
+  });
+
+  router.get('/docs', (_req, res) => {
+    const docs = db.prepare('SELECT * FROM documents ORDER BY created_at').all();
+    res.json(docs);
+  });
+
+  router.get('/docs/:id', (req, res) => {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Document | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/docs/:id', (req, res) => {
+    const existing = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Document | undefined;
+    if (!existing) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+
+    const title = typeof req.body?.title === 'string' ? req.body.title : existing.title;
+    const content = typeof req.body?.content === 'string' ? req.body.content : existing.content;
+
+    const update = db.transaction(() => {
+      db.prepare("UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        title,
+        content,
+        req.params.id
+      );
+      if (content !== existing.content) {
+        const nextVersion = db
+          .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')
+          .get(req.params.id) as { v: number };
+        db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(
+          req.params.id,
+          nextVersion.v + 1,
+          content,
+          JSON.stringify({ type: 'replace' })
+        );
+      }
+    });
+    update();
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);
+    res.json(doc);
+  });
+
+  router.delete('/docs/:id', (req, res) => {
+    const existing = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!existing) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);
+    res.status(204).end();
+  });
+
+  router.get('/docs/:id/versions', (req, res) => {
+    const doc = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versions = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version')
+      .all(req.params.id) as Version[];
+    res.json(versions);
+  });
+
+  router.get('/docs/:id/versions/:version', (req, res) => {
+    const versionNum = Number(req.params.version);
+    const row = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')
+      .get(req.params.id, versionNum) as Version | undefined;
+    if (!row) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.json(row);
+  });
+
+  return router;
+}
