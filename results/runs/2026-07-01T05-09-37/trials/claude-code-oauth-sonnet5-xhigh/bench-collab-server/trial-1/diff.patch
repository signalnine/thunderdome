+++ b/src/server.ts
@@ -0,0 +1,55 @@
+import express, { type Express } from 'express';
+import http from 'node:http';
+import type { WebSocketServer } from 'ws';
+import type Database from 'better-sqlite3';
+import { createDb } from './db.js';
+import { createRoutes } from './routes.js';
+import { attachWebSocketServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: http.Server;
+  wss: WebSocketServer;
+  db: Database.Database;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const db = createDb(dbPath);
+  const app = express();
+  app.use(express.json());
+
+  const server = http.createServer(app);
+  const wss = attachWebSocketServer(server, db);
+
+  app.use(createRoutes(db));
+
+  const start = (port = 0): Promise<number> =>
+    new Promise((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(port, () => {
+        const addr = server.address();
+        if (addr && typeof addr === 'object') {
+          resolve(addr.port);
+        } else {
+          reject(new Error('Failed to determine server port'));
+        }
+      });
+    });
+
+  const stop = (): Promise<void> =>
+    new Promise((resolve) => {
+      for (const client of wss.clients) {
+        client.terminate();
+      }
+      wss.close(() => {
+        server.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    });
+
+  return { app, server, wss, db, start, stop };
+}
diff --git a/src/ws.ts b/src/ws.ts
new file mode 100644
index 0000000..aee3913
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,167 @@
+import { randomUUID } from 'node:crypto';
+import type http from 'node:http';
+import type Database from 'better-sqlite3';
+import { WebSocket, WebSocketServer, type RawData } from 'ws';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation } from './models.js';
+
+function send(ws: WebSocket, message: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(message));
+  }
+}
+
+function parseDocId(url: string | undefined): string {
+  const path = (url ?? '/').split('?')[0];
+  return decodeURIComponent(path.replace(/^\//, ''));
+}
+
+function handleOperation(
+  db: Database.Database,
+  rooms: Map<string, Set<WebSocket>>,
+  docId: string,
+  ws: WebSocket,
+  msg: Record<string, unknown>
+): void {
+  const doc = db.prepare('SELECT content FROM documents WHERE id = ?').get(docId) as { content: string } | undefined;
+  if (!doc) {
+    send(ws, { type: 'error', message: `Document '${docId}' not found` });
+    return;
+  }
+
+  const latestRow = db
+    .prepare('SELECT version FROM versions WHERE document_id = ? ORDER BY version DESC LIMIT 1')
+    .get(docId) as { version: number } | undefined;
+  const currentVersion = latestRow ? latestRow.version : 0;
+
+  const clientVersion =
+    typeof msg.version === 'number' && Number.isInteger(msg.version) ? msg.version : currentVersion;
+  const baseVersion = clientVersion >= 0 && clientVersion <= currentVersion ? clientVersion : currentVersion;
+
+  let baselineLength: number;
+  if (baseVersion === currentVersion) {
+    baselineLength = doc.content.length;
+  } else {
+    const baseRow = db
+      .prepare('SELECT content FROM versions WHERE document_id = ? AND version = ?')
+      .get(docId, baseVersion) as { content: string } | undefined;
+    baselineLength = baseRow ? baseRow.content.length : doc.content.length;
+  }
+
+  const rawOp = msg.operation;
+  if (!validateOperation(rawOp, baselineLength)) {
+    send(ws, { type: 'error', message: 'Invalid operation' });
+    return;
+  }
+
+  let finalOp: Operation = rawOp;
+  if (baseVersion < currentVersion) {
+    const history = db
+      .prepare('SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC')
+      .all(docId, baseVersion) as { operation: string | null }[];
+    for (const row of history) {
+      if (!row.operation) continue;
+      const historicOp = JSON.parse(row.operation) as Operation;
+      finalOp = transformOperation(finalOp, historicOp);
+    }
+  }
+
+  if (!validateOperation(finalOp, doc.content.length)) {
+    send(ws, { type: 'error', message: 'Operation could not be applied' });
+    return;
+  }
+
+  const newContent = applyOperation(doc.content, finalOp);
+  const newVersion = currentVersion + 1;
+
+  const apply = db.transaction(() => {
+    db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(
+      docId,
+      newVersion,
+      newContent,
+      JSON.stringify(finalOp)
+    );
+    db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(newContent, docId);
+  });
+  apply();
+
+  send(ws, { type: 'ack', version: newVersion });
+
+  const room = rooms.get(docId);
+  if (room) {
+    for (const client of room) {
+      if (client !== ws) {
+        send(client, { type: 'operation', operation: finalOp, version: newVersion });
+      }
+    }
+  }
+}
+
+function handleMessage(
+  db: Database.Database,
+  rooms: Map<string, Set<WebSocket>>,
+  docId: string,
+  ws: WebSocket,
+  raw: RawData
+): void {
+  let msg: Record<string, unknown>;
+  try {
+    const parsed: unknown = JSON.parse(raw.toString());
+    if (typeof parsed !== 'object' || parsed === null) throw new Error('not an object');
+    msg = parsed as Record<string, unknown>;
+  } catch {
+    send(ws, { type: 'error', message: 'Invalid JSON' });
+    return;
+  }
+
+  if (msg.type !== 'operation') {
+    send(ws, { type: 'error', message: `Unknown message type: ${String(msg.type)}` });
+    return;
+  }
+
+  handleOperation(db, rooms, docId, ws, msg);
+}
+
+export function attachWebSocketServer(server: http.Server, db: Database.Database): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Set<WebSocket>>();
+
+  wss.on('connection', (ws: WebSocket, req: http.IncomingMessage) => {
+    const docId = parseDocId(req.url);
+    const doc = db.prepare('SELECT content FROM documents WHERE id = ?').get(docId) as
+      | { content: string }
+      | undefined;
+
+    if (!doc) {
+      send(ws, { type: 'error', message: `Document '${docId}' not found` });
+      ws.close();
+      return;
+    }
+
+    let room = rooms.get(docId);
+    if (!room) {
+      room = new Set();
+      rooms.set(docId, room);
+    }
+    room.add(ws);
+
+    const connectionId = randomUUID();
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    const version = db
+      .prepare('SELECT version FROM versions WHERE document_id = ? ORDER BY version DESC LIMIT 1')
+      .get(docId) as { version: number } | undefined;
+    send(ws, { type: 'sync', content: doc.content, version: version ? version.version : 0 });
+
+    ws.on('message', (raw: RawData) => {
+      handleMessage(db, rooms, docId, ws, raw);
+    });
+
+    ws.on('close', () => {
+      rooms.get(docId)?.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  });
+
+  return wss;
+}
