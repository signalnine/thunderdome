r\n    23\t  ): void {\n    24\t    this.jobs.set(name, {\n    25\t      name,\n    26\t      handler,\n    27\t      intervalMs,\n    28\t      runCount: 0,\n    29\t      errors: [],\n    30\t    });\n    31\t  }\n    32\t\n    33\t  start(): void {\n    34\t    if (this.running) return;\n    35\t    this.running = true;\n    36\t\n    37\t    for (const [, job] of this.jobs) {\n    38\t      job.timer = setInterval(async () => {\n    39\t        try {\n    40\t          await job.handler();\n    41\t          job.lastRun = new Date();\n    42\t          job.runCount++;\n    43\t        } catch (err) {\n    44\t          job.errors.push(\n    45\t            err instanceof Error ? err.message : String(err)\n    46\t          );\n    47\t        }\n    48\t      }, job.intervalMs);\n    49\t    }\n    50\t  }\n    51\t\n    52\t  stop(): void {\n    53\t    if (!this.running) return;\n    54\t    this.running = false;\n    55\t\n    56\t    for (const [, job] of this.jobs) {\n    57\t      if (job.timer) {\n    58\t        clearInterval(job.timer);\n    59\t        job.timer = undefined;\n    60\t      }\n    61\t    }\n    62\t  }\n    63\t\n    64\t  async runOnce(name: string): Promise<void> {\n    65\t    const job = this.jobs.get(name);\n    66\t    if (!job) {\n    67\t      throw new Error(`Job '${name}' not found`);\n    68\t    }\n    69\t\n    70\t    await job.handler();\n    71\t    job.lastRun = new Date();\n    72\t    job.runCount++;\n    73\t  }\n    74\t\n    75\t  getStatus(): Array<{\n    76\t    name: string;\n    77\t    lastRun: Date | undefined;\n    78\t    runCount: number;\n    79\t    errorCount: number;\n    80\t  }> {\n    81\t    return Array.from(this.jobs.values()).map((job) => ({\n    82\t      name: job.name,\n    83\t      lastRun: job.lastRun,\n    84\t      runCount: job.runCount,\n    85\t      errorCount: job.errors.length,\n    86\t    }));\n    87\t  }\n    88\t\n    89\t  isRunning(): boolean {\n    90\t    return this.running;\n    91\t  }\n    92\t}\n\n=== packages/worker/src/jobs/cleanup.ts ===\n     1\t/**\n     2\t * Cleanup job.\n     3\t * Removes stale data and performs maintenance tasks.\n     4\t */\n     5\t\n     6\timport { getAllUsers } from '@monorepo/core';\n     7\t\n     8\texport interface CleanupResult {\n     9\t  staleRecords: number;\n    10\t  cleanedUp: number;\n    11\t  duration: number;\n    12\t}\n    13\t\n    14\texport async function cleanupJob(): Promise<CleanupResult> {\n    15\t  const startTime = Date.now();\n    16\t\n    17\t  // Get all users to check for stale records\n    18\t  const users = getAllUsers();\n    19\t\n    20\t  let staleRecords = 0;\n    21\t  let cleanedUp = 0;\n    22\t\n    23\t  for (const user of users) {\n    24\t    const createdDate = new Date(user.createdAt);\n    25\t    const now = new Date();\n    26\t    const daysSinceCreation =\n    27\t      (now.getTime() - createdDate.getTime()) / (1000 * 60 * 60 * 24);\n    28\t\n    29\t    // Mark records older than 365 days as stale (simulation)\n    30\t    if (daysSinceCreation > 365) {\n    31\t      staleRecords++;\n    32\t      // In a real app, we'd archive or delete\n    33\t      cleanedUp++;\n    34\t    }\n    35\t  }\n    36\t\n    37\t  const duration = Date.now() - startTime;\n    38\t\n    39\t  console.log(\n    40\t    `Cleanup complete: ${staleRecords} stale, ${cleanedUp} cleaned in ${duration}ms`\n    41\t  );\n    42\t\n    43\t  return { staleRecords, cleanedUp, duration };\n    44\t}\n    45\t\n    46\texport function getCleanupThresholdDays(): number {\n    47\t  return 365;\n    48\t}\n\n=== packages/worker/src/jobs/sync.ts ===\n     1\t/**\n     2\t * Data sync job.\n     3\t * Syncs external user data into the local database.\n     4\t */\n     5\t\n     6\timport {\n     7\t  createUser,\n     8\t  getUserById,\n     9\t  getAllUsers,\n    10\t  type CreateUserInput,\n    11\t} from '@monorepo/core';\n    12\t\n    13\tinterface ExternalUser {\n  