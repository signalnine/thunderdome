+import { EventBus } from '../bus.js';
+import { AnalyticsService, CartUpdatedEvent, Events, OrderCreatedEvent, PaymentProcessedEvent, PaymentStatus } from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const cartIds = new Set<string>();
+  const cartItemsByCartId = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const orderTotals = new Map<string, number>();
+  const productCounts = new Map<string, number>();
+  let orderCount = 0;
+  let revenue = 0;
+
+  function countEvent(eventName: string): void {
+    eventCounts.set(eventName, (eventCounts.get(eventName) ?? 0) + 1);
+  }
+
+  // CART_UPDATED, ORDER_CREATED, and PAYMENT_PROCESSED are handled below by a single
+  // combined listener each (counting + business logic together). EventBus.emit awaits
+  // handlers for an event one at a time, so registering a separate counting handler
+  // ahead of the business-logic handler would defer the latter by an extra microtask
+  // tick relative to other same-event listeners (e.g. notifications), which callers
+  // that don't explicitly wait for propagation (like a bare `await payment.processPayment(...)`)
+  // can observe as stale state.
+  const combinedEvents = new Set<string>([Events.CART_UPDATED, Events.ORDER_CREATED, Events.PAYMENT_PROCESSED]);
+
+  for (const eventName of Object.values(Events)) {
+    if (combinedEvents.has(eventName)) continue;
+    bus.on(eventName, () => countEvent(eventName));
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    countEvent(Events.CART_UPDATED);
+    const { cartId, items } = payload as CartUpdatedEvent;
+    cartIds.add(cartId);
+    cartItemsByCartId.set(cartId, items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    countEvent(Events.ORDER_CREATED);
+    const { orderId, cartId, total } = payload as OrderCreatedEvent;
+    orderCount += 1;
+    orderTotals.set(orderId, total);
+    const items = cartItemsByCartId.get(cartId);
+    if (items) {
+      for (const item of items) {
+        productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+      }
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    countEvent(Events.PAYMENT_PROCESSED);
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    if (status === PaymentStatus.SUCCESS) {
+      revenue += orderTotals.get(orderId) ?? 0;
+    }
+  });
+
+  return {
+    getEventCount(eventType) {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue() {
+      return revenue;
+    },
+
+    getConversionRate() {
+      if (cartIds.size === 0) return 0;
+      return orderCount / cartIds.size;
+    },
+
+    getTopProducts(limit) {
+      return [...productCounts.entries()]
+        .map(([productId, count]) => ({ productId, count }))
+        .sort((a, b) => b.count - a.count)
+        .slice(0, limit);
+    },
+  };
+}
