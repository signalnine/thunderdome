+import { EventBus } from '../bus.js';
+import {
+  Events,
+  NotificationSentEvent,
+  NotificationService,
+  OrderCreatedEvent,
+  OrderStatusChangedEvent,
+  PaymentProcessedEvent,
+} from '../types.js';
+
+interface StoredNotification {
+  type: string;
+  message: string;
+  timestamp: number;
+}
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const orderOwners = new Map<string, string>();
+  const notifications = new Map<string, StoredNotification[]>();
+
+  function notify(userId: string, type: string, message: string): void {
+    if (!subscribers.has(userId)) return;
+    const list = notifications.get(userId) ?? [];
+    list.push({ type, message, timestamp: Date.now() });
+    notifications.set(userId, list);
+    const payload: NotificationSentEvent = { userId, type, message };
+    void bus.emit(Events.NOTIFICATION_SENT, payload);
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, userId } = payload as OrderCreatedEvent;
+    orderOwners.set(orderId, userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, (payload) => {
+    const { orderId, status } = payload as OrderStatusChangedEvent;
+    const userId = orderOwners.get(orderId);
+    if (!userId) return;
+    notify(userId, 'order_status', `Order ${orderId} is now ${status}`);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    const userId = orderOwners.get(orderId);
+    if (!userId) return;
+    notify(userId, 'payment', `Payment for order ${orderId} ${status}`);
+  });
+
+  return {
+    subscribe(userId) {
+      subscribers.add(userId);
+    },
+
+    getNotifications(userId) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
