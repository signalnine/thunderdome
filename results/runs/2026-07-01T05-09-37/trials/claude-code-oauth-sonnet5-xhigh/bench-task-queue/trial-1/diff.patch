+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  queueName: string;
+  dependsOn: string[];
+  lastError?: unknown;
+  failCount: number;
+  /** internal monotonic counter used to break ties when timestamps collide */
+  seq: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface QueueState {
+  name: string;
+  tasks: Task[];
+  dlq: Task[];
+  concurrencyLimit: number;
+  processingCount: number;
+  middlewares: Middleware[];
+}
+
+interface ScheduleInternal extends Schedule {
+  intervalMs: number;
+  createdAt: number;
+  firedCount: number;
+}
+
+type ShutdownOutcome = 'completed' | 'cancelled' | 'other';
+
+const DEFAULT_QUEUE = 'default';
+
+export class TaskQueue {
+  private tasksById = new Map<string, Task>();
+  private queues = new Map<string, QueueState>();
+  private seqCounter = 0;
+
+  private progress = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, Set<ProgressCallback>>();
+
+  private schedules = new Map<string, ScheduleInternal>();
+
+  private isShuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownHooks: Array<() => void> = [];
+  private shutdownSettle: ((taskId: string, outcome: ShutdownOutcome) => void) | null = null;
+
+  // ---------------------------------------------------------------------
+  // Phase 1/2/3/4: enqueue & dequeue
+  // ---------------------------------------------------------------------
+
+  enqueue(payload: unknown): Task;
+  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task;
+  enqueue(...args: [unknown] | [string, unknown, EnqueueOptions?]): Task {
+    if (this.isShuttingDown) {
+      throw new Error('Cannot enqueue: queue is shutting down');
+    }
+
+    let queueName: string;
+    let payload: unknown;
+    let options: EnqueueOptions;
+
+    if (args.length <= 1) {
+      queueName = DEFAULT_QUEUE;
+      payload = args[0];
+      options = {};
+    } else {
+      const [qn, p, opts] = args as [string, unknown, EnqueueOptions?];
+      queueName = qn;
+      payload = p;
+      options = opts ?? {};
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasksById.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    const id = randomUUID();
+    if (this.wouldCreateCycle(id, dependsOn)) {
+      throw new Error('Circular dependency detected');
+    }
+
+    const now = new Date();
+    let availableAt = now;
+    if (typeof options.delay === 'number') {
+      availableAt = new Date(now.getTime() + options.delay);
+    } else if (options.runAt !== undefined) {
+      availableAt = options.runAt;
+    }
+
+    const task: Task = {
+      id,
+      payload,
+      status: 'pending',
+      createdAt: now,
+      priority,
+      availableAt,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      queueName,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasksById.set(id, task);
+    const q = this.getOrCreateQueue(queueName);
+    q.tasks.push(task);
+    return task;
+  }
+
+  dequeue(queueName: string = DEFAULT_QUEUE): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+    if (q.processingCount >= q.concurrencyLimit) return null;
+
+    const now = Date.now();
+    let best: Task | null = null;
+    for (const t of q.tasks) {
+      if (t.status !== 'pending') continue;
+      if (t.availableAt.getTime() > now) continue;
+      if (!this.dependenciesSatisfied(t)) continue;
+      if (best === null || this.compareTasks(t, best) < 0) {
+        best = t;
+      }
+    }
+
+    if (!best) return null;
+    best.status = 'processing';
+    best.attempts += 1;
+    q.processingCount += 1;
+    return best;
+  }
+
+  size(queueName: string = DEFAULT_QUEUE): number {
+    return this.queueSize(queueName);
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  queueSize(queueName: string = DEFAULT_QUEUE): number {
+    const q = this.queues.get(queueName);
+    if (!q) return 0;
+    return q.tasks.filter((t) => t.status === 'pending').length;
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 5/6: retry with backoff & dead letter queue
+  // ---------------------------------------------------------------------
+
+  fail(taskId: string, error?: unknown): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.queues.get(task.queueName);
+    if (q) q.processingCount = Math.max(0, q.processingCount - 1);
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.availableAt = new Date(Date.now() + backoff);
+      task.status = 'pending';
+    } else {
+      task.status = 'failed';
+      if (q) {
+        q.tasks = q.tasks.filter((t) => t.id !== taskId);
+        q.dlq.push(task);
+      }
+    }
+
+    this.settleShutdown(task);
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.queues.get(task.queueName);
+    if (q) {
+      q.processingCount = Math.max(0, q.processingCount - 1);
+      q.tasks = q.tasks.filter((t) => t.id !== taskId);
+    }
+
+    task.status = 'completed';
+    this.settleShutdown(task);
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const q = this.queues.get(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasksById.get(taskId);
+    if (!task) return null;
+    const q = this.queues.get(task.queueName);
+    if (!q) return null;
+
+    const idx = q.dlq.findIndex((t) => t.id === taskId);
+    if (idx === -1) return null;
+
+    q.dlq.splice(idx, 1);
+    task.status = 'pending';
+    task.attempts = 0;
+    task.availableAt = new Date();
+    q.tasks.push(task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.queues.get(queueName);
+    if (q) q.dlq = [];
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 7: dependencies
+  // ---------------------------------------------------------------------
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasksById.get(taskId);
+    if (!task) throw new Error(`Task not found: ${taskId}`);
+
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.tasksById.get(depId)!.status,
+    }));
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 8: concurrency control
+  // ---------------------------------------------------------------------
+
+  setConcurrency(queueName: string, limit: number): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.queues.get(queueName);
+    if (!q) return { current: 0, max: Infinity };
+    return { current: q.processingCount, max: q.concurrencyLimit };
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 9: progress & cancellation
+  // ---------------------------------------------------------------------
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);
+    }
+
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) cb(info);
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = new Set();
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.add(callback);
+    return () => {
+      callbacks!.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+    if (task.status !== 'pending' && task.status !== 'processing') return;
+
+    const wasProcessing = task.status === 'processing';
+    const q = this.queues.get(task.queueName);
+    if (q) {
+      if (wasProcessing) {
+        q.processingCount = Math.max(0, q.processingCount - 1);
+      }
+      q.tasks = q.tasks.filter((t) => t.id !== taskId);
+    }
+
+    task.status = 'cancelled';
+    this.settleShutdown(task);
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 10: recurring tasks (cron)
+  // ---------------------------------------------------------------------
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const intervalMs = this.parseCronInterval(cronExpression);
+    const id = randomUUID();
+    const scheduleObj: ScheduleInternal = {
+      id,
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      intervalMs,
+      createdAt: Date.now(),
+      firedCount: 0,
+    };
+    this.schedules.set(id, scheduleObj);
+    return scheduleObj;
+  }
+
+  unschedule(scheduleId: string): void {
+    const s = this.schedules.get(scheduleId);
+    if (s) s.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    return Array.from(this.schedules.values()).filter(
+      (s) => s.active && (queueName === undefined || s.queueName === queueName)
+    );
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const s of this.schedules.values()) {
+      if (!s.active) continue;
+      const elapsed = now - s.createdAt;
+      const expected = Math.floor(elapsed / s.intervalMs);
+      if (expected > s.firedCount) {
+        const toFire = expected - s.firedCount;
+        for (let i = 0; i < toFire; i++) {
+          this.enqueue(s.queueName, s.taskTemplate);
+        }
+        s.firedCount = expected;
+      }
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 11: middleware pipeline
+  // ---------------------------------------------------------------------
+
+  use(queueName: string, middleware: Middleware): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.middlewares.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const q = this.queues.get(queueName);
+    const middlewares = q ? q.middlewares : [];
+    let handlerRan = false;
+    let lastIndex = -1;
+
+    const runner = async (i: number): Promise<void> => {
+      if (i <= lastIndex) return;
+      lastIndex = i;
+      if (i < middlewares.length) {
+        await middlewares[i](task, () => runner(i + 1));
+      } else {
+        handlerRan = true;
+        await handler(task);
+      }
+    };
+
+    try {
+      await runner(0);
+      if (handlerRan) {
+        this.complete(task.id);
+      }
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : err);
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // Phase 12: graceful shutdown
+  // ---------------------------------------------------------------------
+
+  onShutdown(callback: () => void): void {
+    this.shutdownHooks.push(callback);
+  }
+
+  shutdown(timeout = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) return this.shutdownPromise;
+    this.isShuttingDown = true;
+    const start = Date.now();
+
+    for (const hook of this.shutdownHooks) {
+      hook();
+    }
+
+    const processingTasks: Task[] = [];
+    for (const q of this.queues.values()) {
+      for (const t of q.tasks) {
+        if (t.status === 'processing') processingTasks.push(t);
+      }
+    }
+
+    let completed = 0;
+    let cancelled = 0;
+    const remaining = new Set(processingTasks.map((t) => t.id));
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      const finish = () => {
+        clearTimeout(timer);
+        this.shutdownSettle = null;
+        resolve({ completed, cancelled, elapsed: Date.now() - start });
+      };
+
+      const timer = setTimeout(() => {
+        for (const id of remaining) {
+          const t = this.tasksById.get(id);
+          if (t && t.status === 'processing') {
+            t.status = 'cancelled';
+            const q = this.queues.get(t.queueName);
+            if (q) {
+              q.processingCount = Math.max(0, q.processingCount - 1);
+              q.tasks = q.tasks.filter((x) => x.id !== id);
+            }
+            cancelled += 1;
+          }
+        }
+        remaining.clear();
+        finish();
+      }, timeout);
+
+      this.shutdownSettle = (taskId: string, outcome: ShutdownOutcome) => {
+        if (!remaining.has(taskId)) return;
+        remaining.delete(taskId);
+        if (outcome === 'completed') completed += 1;
+        else if (outcome === 'cancelled') cancelled += 1;
+        if (remaining.size === 0) finish();
+      };
+
+      if (remaining.size === 0) {
+        finish();
+      }
+    });
+
+    return this.shutdownPromise;
+  }
+
+  // ---------------------------------------------------------------------
+  // internal helpers
+  // ---------------------------------------------------------------------
+
+  private getOrCreateQueue(name: string): QueueState {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = {
+        name,
+        tasks: [],
+        dlq: [],
+        concurrencyLimit: Infinity,
+        processingCount: 0,
+        middlewares: [],
+      };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependsOn.every((id) => this.tasksById.get(id)?.status === 'completed');
+  }
+
+  private compareTasks(a: Task, b: Task): number {
+    if (a.priority !== b.priority) return a.priority - b.priority;
+    const at = a.availableAt.getTime();
+    const bt = b.availableAt.getTime();
+    if (at !== bt) return at - bt;
+    return a.seq - b.seq;
+  }
+
+  private wouldCreateCycle(newTaskId: string, dependsOn: string[]): boolean {
+    const visited = new Set<string>();
+    const dfs = (id: string): boolean => {
+      if (id === newTaskId) return true;
+      if (visited.has(id)) return false;
+      visited.add(id);
+      const t = this.tasksById.get(id);
+      if (!t) return false;
+      return t.dependsOn.some((depId) => dfs(depId));
+    };
+    return dependsOn.some((depId) => dfs(depId));
+  }
+
+  private parseCronInterval(expr: string): number {
+    const parts = expr.trim().split(/\s+/);
+    const [minute, hour] = parts;
+
+    if (minute.startsWith('*/')) {
+      const n = Number(minute.slice(2));
+      return n * 60 * 1000;
+    }
+    if (minute === '0' && hour === '*') {
+      return 60 * 60 * 1000;
+    }
+    if (minute === '0' && hour === '0') {
+      return 24 * 60 * 60 * 1000;
+    }
+
+    throw new Error(`Unsupported cron expression: ${expr}`);
+  }
+
+  private settleShutdown(task: Task): void {
+    if (!this.shutdownSettle) return;
+    const outcome: ShutdownOutcome =
+      task.status === 'completed' ? 'completed' : task.status === 'cancelled' ? 'cancelled' : 'other';
+    this.shutdownSettle(task.id, outcome);
+  }
+}
