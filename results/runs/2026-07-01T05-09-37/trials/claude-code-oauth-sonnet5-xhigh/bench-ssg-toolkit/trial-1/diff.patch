+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,63 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+function categoriesForFile(file: ContentFile, ctx: BuildContext): string[] {
+  const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+  if (tagMap) {
+    const categories: string[] = [];
+    for (const [tag, files] of tagMap) {
+      if (files.some((f) => f.slug === file.slug)) categories.push(tag);
+    }
+    return categories;
+  }
+  return file.tags ?? [];
+}
+
+function renderItem(file: ContentFile, ctx: BuildContext): string {
+  const link = `${ctx.config.baseUrl}/${file.slug}.html`;
+  const pubDate = file.date ? `<pubDate>${new Date(file.date).toUTCString()}</pubDate>\n` : '';
+  const categories = categoriesForFile(file, ctx)
+    .map((c) => `<category>${escapeXml(c)}</category>`)
+    .join('\n');
+  return `<item>
+<title>${escapeXml(file.title)}</title>
+<link>${link}</link>
+<guid>${link}</guid>
+${pubDate}${categories}
+<description><![CDATA[${file.content}]]></description>
+</item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext): void => {
+        const sorted = [...ctx.files].sort((a, b) => {
+          const aTime = a.date ? new Date(a.date).getTime() : 0;
+          const bTime = b.date ? new Date(b.date).getTime() : 0;
+          return bTime - aTime;
+        });
+        const items = sorted.map((file) => renderItem(file, ctx)).join('\n');
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+<channel>
+<title>${escapeXml(ctx.config.title)}</title>
+<link>${ctx.config.baseUrl}</link>
+<description>${escapeXml(ctx.config.title)}</description>
+${items}
+</channel>
+</rss>`;
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
