--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,62 @@
+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+interface FootnoteMap {
+  ids: string[];
+  text: Map<string, string>;
+}
+
+function extractFootnotes(source: string): { text: string; footnotes: FootnoteMap } {
+  const footnotes: FootnoteMap = { ids: [], text: new Map() };
+  const withoutDefinitions = source.replace(
+    /^\[\^([^\]]+)\]:\s*(.+)$/gm,
+    (_match, id: string, text: string) => {
+      footnotes.ids.push(id);
+      footnotes.text.set(id, text.trim());
+      return '';
+    }
+  );
+  return { text: withoutDefinitions, footnotes };
+}
+
+function inlineFootnoteRefs(source: string, footnotes: FootnoteMap): string {
+  return source.replace(/\[\^([^\]]+)\]/g, (match, id: string) => {
+    if (!footnotes.text.has(id)) return match;
+    return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+  });
+}
+
+function renderFootnoteSection(footnotes: FootnoteMap): string {
+  if (footnotes.ids.length === 0) return '';
+  const items = footnotes.ids
+    .map((id) => `<li id="fn-${id}">${footnotes.text.get(id)}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+function renderAdmonitions(source: string): string {
+  return source.replace(
+    /:::(\w+)\n([\s\S]*?)\n:::/g,
+    (_match, type: string, inner: string) => {
+      const innerHtml = (marked.parse(inner.trim()) as string).trim();
+      return `<div class="admonition admonition-${type}">\n${innerHtml}\n</div>`;
+    }
+  );
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile): ContentFile => {
+        const { text: withoutFootnoteDefs, footnotes } = extractFootnotes(file.content);
+        const withRefs = inlineFootnoteRefs(withoutFootnoteDefs, footnotes);
+        const withAdmonitions = renderAdmonitions(withRefs);
+        const html = (marked.parse(withAdmonitions) as string) + renderFootnoteSection(footnotes);
+        return { ...file, content: html };
+      },
+    },
+  };
+}
