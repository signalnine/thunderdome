+++ b/src/routes/documents.ts
@@ -0,0 +1,171 @@
+import { Router } from 'express';
+import { ForbiddenError, NotFoundError } from '../errors.js';
+import { requireAuth } from '../middleware.js';
+import {
+  assertCanGrantRole,
+  effectiveDocumentRole,
+  requireDocumentRole,
+  requireFolderRole,
+} from '../permissions.js';
+import { serializeDocument } from '../serialize.js';
+import { resolveRole, resolveTargetUserId } from '../shareHelpers.js';
+import { nextId, store } from '../store.js';
+import type { Document } from '../types.js';
+import { optionalString, requireString } from '../validation.js';
+
+export const documentRouter = Router();
+documentRouter.use(requireAuth);
+
+function createDocumentInFolder(
+  userId: string,
+  folderId: string,
+  title: string,
+  content: string,
+): Document {
+  requireFolderRole(userId, folderId, 'editor');
+
+  const now = new Date().toISOString();
+  const doc: Document = {
+    id: nextId('doc'),
+    title,
+    content,
+    folderId,
+    ownerId: userId,
+    shares: new Map(),
+    createdAt: now,
+    updatedAt: now,
+  };
+  store.documents.set(doc.id, doc);
+
+  store.logActivity({
+    action: 'document.created',
+    actorId: userId,
+    resourceType: 'document',
+    resourceId: doc.id,
+  });
+
+  return doc;
+}
+
+documentRouter.post('/documents', (req, res) => {
+  const userId = req.userId as string;
+  const title = requireString(req.body?.title, 'title');
+  const content = optionalString(req.body?.content, 'content') ?? '';
+  const folderId = requireString(req.body?.folderId, 'folderId');
+
+  const doc = createDocumentInFolder(userId, folderId, title, content);
+  res.status(201).json(serializeDocument(doc));
+});
+
+documentRouter.post('/folders/:folderId/documents', (req, res) => {
+  const userId = req.userId as string;
+  const title = requireString(req.body?.title, 'title');
+  const content = optionalString(req.body?.content, 'content') ?? '';
+
+  const doc = createDocumentInFolder(userId, req.params.folderId, title, content);
+  res.status(201).json(serializeDocument(doc));
+});
+
+documentRouter.get('/folders/:folderId/documents', (req, res) => {
+  const userId = req.userId as string;
+  requireFolderRole(userId, req.params.folderId, 'viewer');
+
+  const results = store
+    .documentsInFolder(req.params.folderId)
+    .filter((doc) => effectiveDocumentRole(userId, doc.id))
+    .map(serializeDocument);
+
+  res.status(200).json(results);
+});
+
+documentRouter.get('/documents/:id', (req, res) => {
+  const userId = req.userId as string;
+  const doc = requireDocumentRole(userId, req.params.id, 'viewer');
+  res.status(200).json(serializeDocument(doc));
+});
+
+documentRouter.patch('/documents/:id', (req, res) => {
+  const userId = req.userId as string;
+  const doc = requireDocumentRole(userId, req.params.id, 'editor');
+
+  const title = optionalString(req.body?.title, 'title');
+  const content = optionalString(req.body?.content, 'content');
+
+  if (title !== undefined) doc.title = title;
+  if (content !== undefined) doc.content = content;
+  doc.updatedAt = new Date().toISOString();
+
+  store.logActivity({
+    action: 'document.updated',
+    actorId: userId,
+    resourceType: 'document',
+    resourceId: doc.id,
+  });
+
+  res.status(200).json(serializeDocument(doc));
+});
+
+documentRouter.delete('/documents/:id', (req, res) => {
