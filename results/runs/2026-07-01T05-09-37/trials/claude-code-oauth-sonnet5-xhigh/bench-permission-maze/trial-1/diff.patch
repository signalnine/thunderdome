+++ b/src/store.ts
@@ -0,0 +1,77 @@
+import type { ActivityLogEntry, Document, Folder, Session, User } from './types.js';
+
+let idCounter = 0;
+export function nextId(prefix: string): string {
+  idCounter += 1;
+  const random = Math.random().toString(36).slice(2, 10);
+  return `${prefix}_${idCounter}_${random}`;
+}
+
+export class Store {
+  readonly users = new Map<string, User>();
+  readonly usersByUsername = new Map<string, string>();
+  readonly sessions = new Map<string, Session>();
+  readonly folders = new Map<string, Folder>();
+  readonly documents = new Map<string, Document>();
+  readonly activityLog: ActivityLogEntry[] = [];
+
+  reset(): void {
+    this.users.clear();
+    this.usersByUsername.clear();
+    this.sessions.clear();
+    this.folders.clear();
+    this.documents.clear();
+    this.activityLog.length = 0;
+  }
+
+  findUserByUsername(username: string): User | undefined {
+    const id = this.usersByUsername.get(username.toLowerCase());
+    return id ? this.users.get(id) : undefined;
+  }
+
+  logActivity(entry: Omit<ActivityLogEntry, 'id' | 'timestamp'>): ActivityLogEntry {
+    const full: ActivityLogEntry = {
+      ...entry,
+      id: nextId('log'),
+      timestamp: new Date().toISOString(),
+    };
+    this.activityLog.push(full);
+    return full;
+  }
+
+  folderChain(folderId: string | null): Folder[] {
+    const chain: Folder[] = [];
+    let currentId = folderId;
+    const seen = new Set<string>();
+    while (currentId) {
+      if (seen.has(currentId)) break;
+      seen.add(currentId);
+      const folder = this.folders.get(currentId);
+      if (!folder) break;
+      chain.push(folder);
+      currentId = folder.parentId;
+    }
+    return chain;
+  }
+
+  folderDescendants(folderId: string): Folder[] {
+    const result: Folder[] = [];
+    const queue = [folderId];
+    while (queue.length > 0) {
+      const currentId = queue.shift() as string;
+      for (const folder of this.folders.values()) {
+        if (folder.parentId === currentId) {
+          result.push(folder);
+          queue.push(folder.id);
+        }
+      }
+    }
+    return result;
+  }
+
+  documentsInFolder(folderId: string): Document[] {
+    return [...this.documents.values()].filter((doc) => doc.folderId === folderId);
+  }
+}
+
+export const store = new Store();
