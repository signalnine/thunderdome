+++ b/src/routes/auth.ts
@@ -0,0 +1,38 @@
+import { Router } from 'express';
+import { createSession, createUser, verifyPassword } from '../auth.js';
+import { ConflictError, UnauthorizedError } from '../errors.js';
+import { requireAuth } from '../middleware.js';
+import { store } from '../store.js';
+import { requireString } from '../validation.js';
+
+export const authRouter = Router();
+
+authRouter.post('/auth/register', (req, res) => {
+  const username = requireString(req.body?.username, 'username');
+  const password = requireString(req.body?.password, 'password');
+
+  if (store.findUserByUsername(username)) {
+    throw new ConflictError('Username is already taken');
+  }
+
+  const user = createUser(username, password);
+  res.status(201).json({ id: user.id, username: user.username, createdAt: user.createdAt });
+});
+
+authRouter.post('/auth/login', (req, res) => {
+  const username = requireString(req.body?.username, 'username');
+  const password = requireString(req.body?.password, 'password');
+
+  const user = store.findUserByUsername(username);
+  if (!user || !verifyPassword(user, password)) {
+    throw new UnauthorizedError('Invalid username or password');
+  }
+
+  const session = createSession(user.id);
+  res.status(200).json({ token: session.token, userId: user.id, username: user.username });
+});
+
+authRouter.get('/auth/me', requireAuth, (req, res) => {
+  const user = store.users.get(req.userId as string);
+  res.status(200).json({ id: user!.id, username: user!.username });
+});
diff --git a/src/routes/documents.ts b/src/routes/documents.ts
