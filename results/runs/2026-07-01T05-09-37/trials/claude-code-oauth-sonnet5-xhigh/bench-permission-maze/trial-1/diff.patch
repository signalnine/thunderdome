--- /dev/null
+++ b/src/middleware.ts
@@ -0,0 +1,19 @@
+import type { RequestHandler } from 'express';
+import { getUserForToken } from './auth.js';
+import { UnauthorizedError } from './errors.js';
+
+export const requireAuth: RequestHandler = (req, _res, next) => {
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    next(new UnauthorizedError('Missing or invalid Authorization header'));
+    return;
+  }
+  const token = header.slice('Bearer '.length).trim();
+  const user = getUserForToken(token);
+  if (!user) {
+    next(new UnauthorizedError('Invalid or expired token'));
+    return;
+  }
+  req.userId = user.id;
+  next();
+};
diff --git a/src/permissions.ts b/src/permissions.ts
new file mode 100644
index 0000000..04addbc
--- /dev/null
+++ b/src/permissions.ts
@@ -0,0 +1,62 @@
+import { store } from './store.js';
+import { ForbiddenError, NotFoundError } from './errors.js';
+import { maxRole, roleAtLeast, type Document, type Folder, type Role } from './types.js';
+
+export function effectiveFolderRole(userId: string, folderId: string): Role | undefined {
+  const chain = store.folderChain(folderId);
+  let role: Role | undefined;
+  for (const folder of chain) {
+    if (folder.ownerId === userId) role = maxRole(role, 'owner');
+    const shared = folder.shares.get(userId);
+    if (shared) role = maxRole(role, shared);
+  }
+  return role;
+}
+
+export function effectiveDocumentRole(userId: string, documentId: string): Role | undefined {
+  const doc = store.documents.get(documentId);
+  if (!doc) return undefined;
+  let role: Role | undefined;
+  if (doc.ownerId === userId) role = maxRole(role, 'owner');
+  const shared = doc.shares.get(userId);
+  if (shared) role = maxRole(role, shared);
+  role = maxRole(role, effectiveFolderRole(userId, doc.folderId));
+  return role;
+}
+
+/**
+ * Resources the user has no access to are reported as 404 (not 403) so
+ * their existence isn't leaked to users without any granted role.
+ */
+export function requireFolderRole(userId: string, folderId: string, min: Role): Folder {
+  const folder = store.folders.get(folderId);
+  if (!folder) throw new NotFoundError('Folder not found');
+  const role = effectiveFolderRole(userId, folderId);
+  if (!role) throw new NotFoundError('Folder not found');
+  if (!roleAtLeast(role, min)) throw new ForbiddenError('Insufficient permissions on folder');
+  return folder;
+}
+
+export function requireDocumentRole(userId: string, documentId: string, min: Role): Document {
+  const doc = store.documents.get(documentId);
+  if (!doc) throw new NotFoundError('Document not found');
+  const role = effectiveDocumentRole(userId, documentId);
+  if (!role) throw new NotFoundError('Document not found');
+  if (!roleAtLeast(role, min)) throw new ForbiddenError('Insufficient permissions on document');
+  return doc;
+}
+
+/** Editors may only grant viewer/editor roles; only owners may grant/revoke owner access. */
+export function assertCanGrantRole(actorRole: Role, targetRole: Role): void {
+  if (actorRole === 'owner') return;
+  if (actorRole === 'editor' && targetRole !== 'owner') return;
+  throw new ForbiddenError(`Role '${actorRole}' cannot grant role '${targetRole}'`);
+}
+
+export function canView(userId: string, resourceType: 'folder' | 'document', resourceId: string): boolean {
+  const role =
+    resourceType === 'folder'
+      ? effectiveFolderRole(userId, resourceId)
+      : effectiveDocumentRole(userId, resourceId);
+  return Boolean(role);
+}
