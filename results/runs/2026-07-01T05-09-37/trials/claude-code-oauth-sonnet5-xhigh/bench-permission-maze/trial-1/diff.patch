@@ -0,0 +1,177 @@
+import { Router } from 'express';
+import { BadRequestError, ForbiddenError, NotFoundError } from '../errors.js';
+import { requireAuth } from '../middleware.js';
+import {
+  assertCanGrantRole,
+  effectiveFolderRole,
+  requireFolderRole,
+} from '../permissions.js';
+import { serializeFolder } from '../serialize.js';
+import { resolveRole, resolveTargetUserId } from '../shareHelpers.js';
+import { nextId, store } from '../store.js';
+import type { Folder } from '../types.js';
+import { optionalNullableString, requireString } from '../validation.js';
+
+export const folderRouter = Router();
+folderRouter.use(requireAuth);
+
+folderRouter.post('/folders', (req, res) => {
+  const userId = req.userId as string;
+  const name = requireString(req.body?.name, 'name');
+  const parentId = optionalNullableString(req.body?.parentId, 'parentId') ?? null;
+
+  if (parentId) {
+    requireFolderRole(userId, parentId, 'editor');
+  }
+
+  const now = new Date().toISOString();
+  const folder: Folder = {
+    id: nextId('folder'),
+    name,
+    parentId,
+    ownerId: userId,
+    shares: new Map(),
+    createdAt: now,
+    updatedAt: now,
+  };
+  store.folders.set(folder.id, folder);
+
+  store.logActivity({
+    action: 'folder.created',
+    actorId: userId,
+    resourceType: 'folder',
+    resourceId: folder.id,
+  });
+
+  res.status(201).json(serializeFolder(folder));
+});
+
+folderRouter.get('/folders/:id', (req, res) => {
+  const userId = req.userId as string;
+  const folder = requireFolderRole(userId, req.params.id, 'viewer');
+  res.status(200).json(serializeFolder(folder));
+});
+
+folderRouter.patch('/folders/:id', (req, res) => {
+  const userId = req.userId as string;
+  const folder = requireFolderRole(userId, req.params.id, 'editor');
+
+  const name = optionalNullableString(req.body?.name, 'name');
+  const parentId = optionalNullableString(req.body?.parentId, 'parentId');
+
+  if (name !== undefined && name !== null) {
+    folder.name = name;
+  }
+
+  if (parentId !== undefined) {
+    if (parentId === folder.id) {
+      throw new BadRequestError('A folder cannot be its own parent');
+    }
+    if (parentId !== null) {
+      requireFolderRole(userId, parentId, 'editor');
+      const descendants = store.folderDescendants(folder.id);
+      if (descendants.some((d) => d.id === parentId)) {
+        throw new BadRequestError('Cannot move a folder into one of its own descendants');
+      }
+    }
+    folder.parentId = parentId;
+  }
+
+  folder.updatedAt = new Date().toISOString();
+
+  store.logActivity({
+    action: 'folder.updated',
+    actorId: userId,
+    resourceType: 'folder',
+    resourceId: folder.id,
+  });
+
+  res.status(200).json(serializeFolder(folder));
+});
+
+folderRouter.delete('/folders/:id', (req, res) => {
+  const userId = req.userId as string;
+  const folder = requireFolderRole(userId, req.params.id, 'owner');
+
+  const descendants = store.folderDescendants(folder.id);
+  const foldersToDelete = [folder, ...descendants];
+  for (const f of foldersToDelete) {
+    for (const doc of store.documentsInFolder(f.id)) {
+      store.documents.delete(doc.id);
+    }
+    store.folders.delete(f.id);
+  }
+
+  store.logActivity({
+    action: 'folder.deleted',
+    actorId: userId,
+    resourceType: 'folder',
+    resourceId: folder.id,
+  });
+
+  res.status(204).send();
+});
+
+folderRouter.post('/folders/:id/share', (req, res) => {
+  const userId = req.userId as string;
+  const folder = requireFolderRole(userId, req.params.id, 'editor');
+  const actorRole = effectiveFolderRole(userId, folder.id);
+  const targetUserId = resolveTargetUserId(req.body);
+  const role = resolveRole(req.body);
+
+  assertCanGrantRole(actorRole!, role);
+
+  folder.shares.set(targetUserId, role);
+  folder.updatedAt = new Date().toISOString();
+
+  store.logActivity({
+    action: 'folder.shared',
+    actorId: userId,
+    resourceType: 'folder',
+    resourceId: folder.id,
+    details: { targetUserId, role },
+  });
+
+  res.status(200).json(serializeFolder(folder));
+});
+
+folderRouter.delete('/folders/:id/share/:userId', (req, res) => {
+  const userId = req.userId as string;
+  const folder = requireFolderRole(userId, req.params.id, 'owner');
+  const targetUserId = req.params.userId;
+
+  if (!folder.shares.has(targetUserId)) {
+    throw new NotFoundError('Share not found');
+  }
+  if (targetUserId === folder.ownerId) {
+    throw new ForbiddenError('Cannot revoke the resource owner');
+  }
+
+  folder.shares.delete(targetUserId);
+  folder.updatedAt = new Date().toISOString();
+
+  store.logActivity({
+    action: 'folder.unshared',
+    actorId: userId,
+    resourceType: 'folder',
+    resourceId: folder.id,
+    details: { targetUserId },
+  });
+
+  res.status(204).send();
+});
+
+folderRouter.get('/folders', (req, res) => {
+  const userId = req.userId as string;
+  const parentIdFilter = req.query.parentId;
+  const results = [...store.folders.values()]
+    .filter((folder) => effectiveFolderRole(userId, folder.id))
+    .filter((folder) => {
+      if (parentIdFilter === undefined) return true;
+      if (parentIdFilter === 'null' || parentIdFilter === '') return folder.parentId === null;
+      return folder.parentId === parentIdFilter;
+    })
+    .map(serializeFolder);
+
+  res.status(200).json(results);
+});
