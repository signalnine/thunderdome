new file mode 100644
index 0000000..1ae659c
--- /dev/null
+++ b/src/routes/activity.ts
@@ -0,0 +1,74 @@
+import { Router } from 'express';
+import { requireAuth } from '../middleware.js';
+import { canView, requireDocumentRole, requireFolderRole } from '../permissions.js';
+import { store } from '../store.js';
+import type { ActivityLogEntry, ResourceType } from '../types.js';
+
+export const activityRouter = Router();
+activityRouter.use(requireAuth);
+
+function serializeEntry(entry: ActivityLogEntry) {
+  const actor = store.users.get(entry.actorId);
+  return {
+    id: entry.id,
+    action: entry.action,
+    actorId: entry.actorId,
+    actorUsername: actor?.username ?? 'unknown',
+    resourceType: entry.resourceType,
+    resourceId: entry.resourceId,
+    timestamp: entry.timestamp,
+    details: entry.details,
+  };
+}
+
+function isVisibleToUser(userId: string, entry: ActivityLogEntry): boolean {
+  if (entry.actorId === userId) return true;
+  return canView(userId, entry.resourceType, entry.resourceId);
+}
+
+activityRouter.get('/activity', (req, res) => {
+  const userId = req.userId as string;
+  const resourceType = req.query.resourceType as ResourceType | undefined;
+  const resourceId = req.query.resourceId as string | undefined;
+  const limitParam = req.query.limit;
+  const limit = typeof limitParam === 'string' ? Number.parseInt(limitParam, 10) : undefined;
+
+  let entries = store.activityLog.filter((entry) => isVisibleToUser(userId, entry));
+
+  if (resourceType) {
+    entries = entries.filter((entry) => entry.resourceType === resourceType);
+  }
+  if (resourceId) {
+    entries = entries.filter((entry) => entry.resourceId === resourceId);
+  }
+
+  entries = [...entries].reverse();
+
+  if (limit && Number.isFinite(limit) && limit > 0) {
+    entries = entries.slice(0, limit);
+  }
+
+  res.status(200).json(entries.map(serializeEntry));
+});
+
+activityRouter.get('/folders/:id/activity', (req, res) => {
+  const userId = req.userId as string;
+  requireFolderRole(userId, req.params.id, 'viewer');
+
+  const entries = store.activityLog
+    .filter((entry) => entry.resourceType === 'folder' && entry.resourceId === req.params.id)
+    .reverse();
+
+  res.status(200).json(entries.map(serializeEntry));
+});
+
+activityRouter.get('/documents/:id/activity', (req, res) => {
+  const userId = req.userId as string;
+  requireDocumentRole(userId, req.params.id, 'viewer');
+
+  const entries = store.activityLog
+    .filter((entry) => entry.resourceType === 'document' && entry.resourceId === req.params.id)
+    .reverse();
+
+  res.status(200).json(entries.map(serializeEntry));
+});
diff --git a/src/routes/auth.ts b/src/routes/auth.ts
new file mode 100644
index 0000000..5a5d683
