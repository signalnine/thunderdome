@@ -0,0 +1,40 @@
+import { store } from './store.js';
+import type { Document, Folder, Role } from './types.js';
+
+function sharesToObject(shares: Map<string, Role>): Record<string, { userId: string; username: string; role: Role }> {
+  const result: Record<string, { userId: string; username: string; role: Role }> = {};
+  for (const [userId, role] of shares.entries()) {
+    const user = store.users.get(userId);
+    result[userId] = { userId, username: user?.username ?? 'unknown', role };
+  }
+  return result;
+}
+
+export function serializeFolder(folder: Folder) {
+  const owner = store.users.get(folder.ownerId);
+  return {
+    id: folder.id,
+    name: folder.name,
+    parentId: folder.parentId,
+    ownerId: folder.ownerId,
+    ownerUsername: owner?.username ?? 'unknown',
+    shares: sharesToObject(folder.shares),
+    createdAt: folder.createdAt,
+    updatedAt: folder.updatedAt,
+  };
+}
+
+export function serializeDocument(doc: Document) {
+  const owner = store.users.get(doc.ownerId);
+  return {
+    id: doc.id,
+    title: doc.title,
+    content: doc.content,
+    folderId: doc.folderId,
+    ownerId: doc.ownerId,
+    ownerUsername: owner?.username ?? 'unknown',
+    shares: sharesToObject(doc.shares),
+    createdAt: doc.createdAt,
+    updatedAt: doc.updatedAt,
+  };
+}
