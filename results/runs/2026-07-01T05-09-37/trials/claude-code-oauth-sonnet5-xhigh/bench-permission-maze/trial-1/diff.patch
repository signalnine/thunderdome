+
+  assertCanGrantRole(actorRole!, role);
+
+  doc.shares.set(targetUserId, role);
+  doc.updatedAt = new Date().toISOString();
+
+  store.logActivity({
+    action: 'document.shared',
+    actorId: userId,
+    resourceType: 'document',
+    resourceId: doc.id,
+    details: { targetUserId, role },
