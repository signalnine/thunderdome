+import { BadRequestError } from './errors.js';
+import { store } from './store.js';
+import { isRole, type Role } from './types.js';
+
+export function resolveTargetUserId(body: Record<string, unknown> | undefined): string {
+  const userId = body?.userId;
+  if (typeof userId === 'string' && userId.trim().length > 0) {
+    if (!store.users.has(userId)) throw new BadRequestError('Target user not found');
+    return userId;
+  }
+  const username = body?.username;
+  if (typeof username === 'string' && username.trim().length > 0) {
+    const user = store.findUserByUsername(username);
+    if (!user) throw new BadRequestError('Target user not found');
+    return user.id;
+  }
+  throw new BadRequestError("Either 'userId' or 'username' is required");
+}
+
+export function resolveRole(body: Record<string, unknown> | undefined): Role {
+  const role = body?.role;
+  if (!isRole(role)) {
+    throw new BadRequestError("Field 'role' must be one of: viewer, editor, owner");
+  }
+  return role;
+}
