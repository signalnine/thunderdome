+import type { Express } from 'express';
+import request from 'supertest';
+import { beforeEach, describe, expect, it } from 'vitest';
+import { createApp } from '../src/app.js';
+import { auth, registerAndLogin, type TestUser } from './helpers.js';
+
+describe('activity log', () => {
+  let app: Express;
+  let alice: TestUser;
+  let bob: TestUser;
+
+  beforeEach(async () => {
+    app = createApp();
+    alice = await registerAndLogin(app, 'alice');
+    bob = await registerAndLogin(app, 'bob');
+  });
+
+  it('records folder and document creation events', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set(...auth(alice))
+      .send({ name: 'F' })
+      .expect(201);
+    const doc = await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(...auth(alice))
+      .send({ title: 'D', content: 'x' })
+      .expect(201);
+
+    const res = await request(app)
+      .get('/activity')
+      .set(...auth(alice))
+      .expect(200);
+
+    const actions = res.body.map((e: { action: string }) => e.action);
+    expect(actions).toContain('folder.created');
+    expect(actions).toContain('document.created');
+    for (const entry of res.body) {
+      expect(entry.actorId).toBe(alice.userId);
+      expect(entry.timestamp).toBeTruthy();
+    }
+    expect(res.body.some((e: { resourceId: string }) => e.resourceId === doc.body.id)).toBe(true);
+  });
+
+  it('records update, share, and delete events', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set(...auth(alice))
+      .send({ name: 'F' })
+      .expect(201);
+    const doc = await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(...auth(alice))
+      .send({ title: 'D', content: 'x' })
+      .expect(201);
+
+    await request(app)
+      .patch(`/documents/${doc.body.id}`)
+      .set(...auth(alice))
+      .send({ content: 'updated' })
+      .expect(200);
+    await request(app)
+      .post(`/documents/${doc.body.id}/share`)
+      .set(...auth(alice))
+      .send({ userId: bob.userId, role: 'viewer' })
+      .expect(200);
+    await request(app)
+      .delete(`/documents/${doc.body.id}`)
+      .set(...auth(alice))
+      .expect(204);
+
+    const res = await request(app)
+      .get('/activity')
+      .set(...auth(alice))
+      .expect(200);
+    const actions = res.body.map((e: { action: string }) => e.action);
+    expect(actions).toContain('document.updated');
+    expect(actions).toContain('document.shared');
+    expect(actions).toContain('document.deleted');
+  });
+
+  it('hides activity about resources the caller cannot access', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set(...auth(alice))
+      .send({ name: 'Private' })
+      .expect(201);
+    await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(...auth(alice))
+      .send({ title: 'Secret', content: 'x' })
+      .expect(201);
+
+    const res = await request(app)
+      .get('/activity')
+      .set(...auth(bob))
+      .expect(200);
+
+    expect(res.body).toHaveLength(0);
+  });
+
+  it('shows activity for shared resources once access is granted', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set(...auth(alice))
+      .send({ name: 'Shared' })
+      .expect(201);
+
+    let res = await request(app)
+      .get('/activity')
+      .set(...auth(bob))
+      .expect(200);
+    expect(res.body).toHaveLength(0);
+
+    await request(app)
+      .post(`/folders/${folder.body.id}/share`)
+      .set(...auth(alice))
+      .send({ userId: bob.userId, role: 'viewer' })
+      .expect(200);
+
+    res = await request(app)
+      .get('/activity')
+      .set(...auth(bob))
+      .expect(200);
+    expect(res.body.some((e: { resourceId: string }) => e.resourceId === folder.body.id)).toBe(true);
+  });
+
+  it('filters activity by resourceType and resourceId', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set(...auth(alice))
+      .send({ name: 'F' })
+      .expect(201);
+    const doc = await request(app)
+      .post(`/folders/${folder.body.id}/documents`)
+      .set(...auth(alice))
+      .send({ title: 'D', content: 'x' })
+      .expect(201);
+
+    const res = await request(app)
+      .get(`/activity?resourceType=document&resourceId=${doc.body.id}`)
+      .set(...auth(alice))
+      .expect(200);
+
+    expect(res.body.length).toBeGreaterThan(0);
+    for (const entry of res.body) {
+      expect(entry.resourceType).toBe('document');
+      expect(entry.resourceId).toBe(doc.body.id);
+    }
+  });
+
+  it('exposes resource-scoped activity endpoints gated by view permission', async () => {
+    const folder = await request(app)
+      .post('/folders')
+      .set(...auth(alice))
+      .send({ name: 'F' })
+      .expect(201);
+
+    await request(app)
+      .get(`/folders/${folder.body.id}/activity`)
+      .set(...auth(bob))
+      .expect(404);
+
+    const res = await request(app)
+      .get(`/folders/${folder.body.id}/activity`)
+      .set(...auth(alice))
+      .expect(200);
+    expect(res.body.some((e: { action: string }) => e.action === 'folder.created')).toBe(true);
+  });
+});
