 folder the caller owns', async () => {\n    const created = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Reports' })\n      .expect(201);\n\n    const res = await request(app)\n      .get(`/folders/${created.body.id}`)\n      .set(...auth(alice))\n      .expect(200);\n\n    expect(res.body.id).toBe(created.body.id);\n  });\n\n  it('returns 404 for a nonexistent folder', async () => {\n    await request(app)\n      .get('/folders/does-not-exist')\n      .set(...auth(alice))\n      .expect(404);\n  });\n\n  it('returns 404 (not 403) for a folder the caller has no access to', async () => {\n    const created = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Private' })\n      .expect(201);\n\n    await request(app)\n      .get(`/folders/${created.body.id}`)\n      .set(...auth(bob))\n      .expect(404);\n  });\n\n  it('lets the owner rename a folder', async () => {\n    const created = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Old Name' })\n      .expect(201);\n\n    const res = await request(app)\n      .patch(`/folders/${created.body.id}`)\n      .set(...auth(alice))\n      .send({ name: 'New Name' })\n      .expect(200);\n\n    expect(res.body.name).toBe('New Name');\n  });\n\n  it('prevents a folder from being moved into its own descendant', async () => {\n    const root = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Root' })\n      .expect(201);\n    const child = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Child', parentId: root.body.id })\n      .expect(201);\n\n    await request(app)\n      .patch(`/folders/${root.body.id}`)\n      .set(...auth(alice))\n      .send({ parentId: child.body.id })\n      .expect(400);\n  });\n\n  it('only lets the owner delete a folder', async () => {\n    const created = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'ToDelete' })\n      .expect(201);\n\n    await request(app)\n      .post(`/folders/${created.body.id}/share`)\n      .set(...auth(alice))\n      .send({ userId: bob.userId, role: 'editor' })\n      .expect(200);\n\n    await request(app)\n      .delete(`/folders/${created.body.id}`)\n      .set(...auth(bob))\n      .expect(403);\n\n    await request(app)\n      .delete(`/folders/${created.body.id}`)\n      .set(...auth(alice))\n      .expect(204);\n\n    await request(app)\n      .get(`/folders/${created.body.id}`)\n      .set(...auth(alice))\n      .expect(404);\n  });\n\n  it('cascades deletion to nested folders and documents', async () => {\n    const parent = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Parent' })\n      .expect(201);\n    const child = await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Child', parentId: parent.body.id })\n      .expect(201);\n    const doc = await request(app)\n      .post(`/folders/${child.body.id}/documents`)\n      .set(...auth(alice))\n      .send({ title: 'Doc', content: 'hello' })\n      .expect(201);\n\n    await request(app)\n      .delete(`/folders/${parent.body.id}`)\n      .set(...auth(alice))\n      .expect(204);\n\n    await request(app)\n      .get(`/folders/${child.body.id}`)\n      .set(...auth(alice))\n      .expect(404);\n    await request(app)\n      .get(`/documents/${doc.body.id}`)\n      .set(...auth(alice))\n      .expect(404);\n  });\n\n  it('lists only folders the caller can access', async () => {\n    await request(app)\n      .post('/folders')\n      .set(...auth(alice))\n      .send({ name: 'Alice Folder' })\n      .expect(201);\n    await request(app)\n      .post('/folders')\n      .set(...auth(bob))\n      .send({ name: 'Bob Folder' })\n      .expect(201);\n\n    const res = await request(app)\n      .get('/folders')\n      .set(...auth(bob))\n      .expect(200);\n\n    expect(res.body).toHaveLength(1);\n    expect(res.body[0].name).toBe('Bob Folder');\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1094,"cache_read_input_tokens":69388,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1094},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"63f6e91f-1cf8-4dad-927f-8cb35c5b5fe4","uuid":"3ee485c0-8c1d-49ba-adc7-c1e2540aa4ee","request_id":"req_011Ccang34wBEpjbUTchicPf"}
