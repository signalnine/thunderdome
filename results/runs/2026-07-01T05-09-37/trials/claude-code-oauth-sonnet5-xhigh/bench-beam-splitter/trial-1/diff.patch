@@ -0,0 +1,74 @@
+type Dir = 0 | 1 | 2; // 0 = down, 1 = down-left, 2 = down-right
+
+const DELTAS: ReadonlyArray<readonly [number, number]> = [
+  [1, 0],
+  [1, -1],
+  [1, 1],
+];
+
+function findSource(grid: string[][]): [number, number] {
+  const topRow = grid[0] ?? [];
+  for (let c = 0; c < topRow.length; c++) {
+    if (topRow[c] === 'S') return [0, c];
+  }
+  throw new Error('Grid has no source (\'S\') in its top row');
+}
+
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const [sr, sc] = findSource(grid);
+
+  const visitedCells = new Set<string>();
+  const visitedStates = new Set<string>();
+  visitedCells.add(`${sr},${sc}`);
+
+  function visit(r: number, c: number, dir: Dir): void {
+    if (r < 0 || r >= rows || c < 0 || c >= cols) return;
+    const stateKey = `${r},${c},${dir}`;
+    if (visitedStates.has(stateKey)) return;
+    visitedStates.add(stateKey);
+    visitedCells.add(`${r},${c}`);
+
+    if (grid[r][c] === '^') {
+      visit(r + 1, c - 1, 1);
+      visit(r + 1, c + 1, 2);
+    } else {
+      const [dr, dc] = DELTAS[dir];
+      visit(r + dr, c + dc, dir);
+    }
+  }
+
+  visit(sr + 1, sc, 0);
+
+  return visitedCells.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  const cols = rows > 0 ? grid[0].length : 0;
+  const [sr, sc] = findSource(grid);
+
+  const memo = new Map<string, bigint>();
+
+  function countFrom(r: number, c: number, dir: Dir): bigint {
+    if (r < 0 || r >= rows || c < 0 || c >= cols) return 1n;
+
+    const key = `${r},${c},${dir}`;
+    const cached = memo.get(key);
+    if (cached !== undefined) return cached;
+
+    let result: bigint;
+    if (grid[r][c] === '^') {
+      result = countFrom(r + 1, c - 1, 1) + countFrom(r + 1, c + 1, 2);
+    } else {
+      const [dr, dc] = DELTAS[dir];
+      result = countFrom(r + dr, c + dc, dir);
+    }
+
+    memo.set(key, result);
+    return result;
+  }
+
+  return countFrom(sr + 1, sc, 0);
+}
