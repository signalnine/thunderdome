+describe('findSwappedWires', () => {
+  it('returns an empty result on an unswapped adder', () => {
+    const gates = buildAdder(8);
+    expect(findSwappedWires(gates)).toEqual([]);
+  });
+
+  it('finds a single swapped pair', () => {
+    const gates = buildAdder(8);
+    swapOutputs(gates, 'z03', 'a03');
+    expect(findSwappedWires(gates)).toEqual(['a03', 'z03']);
+  });
+
+  it('finds 4 swapped pairs (8 wires) on a small adder', () => {
+    const gates = buildAdder(16);
+    const swaps = buildSafeSwaps(16);
+    for (const [w1, w2] of swaps) swapOutputs(gates, w1, w2);
+
+    const expected = swaps.flat().sort();
+    expect(findSwappedWires(gates)).toEqual(expected);
+  });
+
+  it('finds 4 swapped pairs on a 45-bit adder within the time budget', () => {
+    const gates = buildAdder(45);
+    const swaps = buildSafeSwaps(45);
+    for (const [w1, w2] of swaps) swapOutputs(gates, w1, w2);
+
+    const start = performance.now();
+    const result = findSwappedWires(gates);
+    const elapsed = performance.now() - start;
+
+    expect(result).toEqual(swaps.flat().sort());
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('verifies the identified swap set actually restores correct addition', () => {
+    const bits = 20;
+    const gates = buildAdder(bits);
+    const swaps = buildSafeSwaps(bits);
+    for (const [w1, w2] of swaps) swapOutputs(gates, w1, w2);
+
+    const found = new Set(findSwappedWires(gates));
+    expect(found.size).toBe(8);
+
+    // Un-swap using the found wires paired back via the known swap list,
+    // then confirm the corrected circuit adds correctly.
+    const corrected = gates.map((g) => ({ ...g }));
+    for (const [w1, w2] of swaps) {
+      expect(found.has(w1)).toBe(true);
+      expect(found.has(w2)).toBe(true);
+      swapOutputs(corrected, w1, w2);
+    }
+
+    const inputs: Record<string, number> = {};
+    setRegister(inputs, 'x', 123456, bits);
+    setRegister(inputs, 'y', 654321, bits);
+    const values = simulate(corrected, inputs);
+    expect(readRegister(values, 'z', bits + 1)).toBe(123456 + 654321);
+  });
+
+  it('finds swaps at every valid role-pair and bit position (fuzz)', () => {
+    const bits = 45;
+    for (const [roleA, roleB] of ROLE_PAIRS) {
+      for (const bit of [1, 10, 22, 43]) {
+        const idx = String(bit).padStart(2, '0');
+        const gates = buildAdder(bits);
+        const wireA = `${roleA}${idx}`;
+        const wireB = `${roleB}${idx}`;
+        swapOutputs(gates, wireA, wireB);
+        expect(findSwappedWires(gates)).toEqual([wireA, wireB].sort());
+      }
+    }
+  });
+});
