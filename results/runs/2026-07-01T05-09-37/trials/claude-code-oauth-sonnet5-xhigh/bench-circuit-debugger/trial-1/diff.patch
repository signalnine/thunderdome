+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values: Record<string, number> = { ...inputs };
+  const gateByOutput = new Map<string, Gate>();
+  for (const gate of gates) {
+    gateByOutput.set(gate.out, gate);
+  }
+
+  function resolve(wire: string): number {
+    const known = values[wire];
+    if (known !== undefined) {
+      return known;
+    }
+    const gate = gateByOutput.get(wire);
+    if (!gate) {
+      throw new Error(`No value or gate produces wire "${wire}"`);
+    }
+    const a = resolve(gate.in1);
+    const b = resolve(gate.in2);
+    let result: number;
+    switch (gate.op) {
+      case 'AND':
+        result = a & b;
+        break;
+      case 'OR':
+        result = a | b;
+        break;
+      case 'XOR':
+        result = a ^ b;
+        break;
+    }
+    values[wire] = result;
+    return result;
+  }
+
+  for (const gate of gates) {
+    resolve(gate.out);
+  }
+
+  return values;
+}
+
+const XY_WIRE = /^[xy]\d{2}$/;
+const Z_WIRE = /^z\d{2}$/;
+
+/**
+ * The circuit is a ripple-carry adder built from a fixed pattern of gates
+ * (see TASK.md). Since only `out` names were exchanged between pairs of
+ * gates — the (op, in1, in2) of every gate is untouched — each gate's
+ * expected role can be checked locally against structural invariants of
+ * that pattern, without simulating the circuit or searching swap
+ * combinations:
+ *   - every z output (except the top carry-out bit) is produced by XOR
+ *   - a XOR of two x/y inputs feeds a z output only at bit 0
+ *   - a XOR of two non-x/y inputs (a partial-sum/carry-in combiner) always
+ *     feeds a z output
+ *   - an AND (other than the bit-0 carry generator) always feeds an OR
+ *   - an OR never feeds directly into another OR
+ *   - both inputs of an OR are always produced by AND gates
+ * Any gate violating its rule has an incorrect `out`, i.e. is one half of
+ * a swap.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const consumers = new Map<string, Gate[]>();
+  const producer = new Map<string, Gate>();
+  for (const gate of gates) {
+    producer.set(gate.out, gate);
+    for (const input of [gate.in1, gate.in2]) {
+      const list = consumers.get(input);
+      if (list) {
+        list.push(gate);
+      } else {
+        consumers.set(input, [gate]);
+      }
+    }
+  }
+
+  let maxZ = 0;
+  for (const gate of gates) {
+    if (Z_WIRE.test(gate.out)) {
+      maxZ = Math.max(maxZ, parseInt(gate.out.slice(1), 10));
+    }
+  }
+  const zMax = `z${String(maxZ).padStart(2, '0')}`;
+
+  const feedsGateWithOp = (wire: string, op: Gate['op']): boolean =>
+    (consumers.get(wire) ?? []).some((gate) => gate.op === op);
+
+  const suspects = new Set<string>();
+
+  for (const gate of gates) {
+    const { op, in1, in2, out } = gate;
+    const isBit00Input = (in1 === 'x00' && in2 === 'y00') || (in1 === 'y00' && in2 === 'x00');
+    const isZOutput = Z_WIRE.test(out);
+
+    if (isZOutput && out !== zMax && op !== 'XOR') {
+      suspects.add(out);
+    }
+
+    if (op === 'XOR') {
+      const inputsAreXY = XY_WIRE.test(in1) && XY_WIRE.test(in2);
+      if (inputsAreXY) {
+        if (isBit00Input) {
+          if (out !== 'z00') suspects.add(out);
+        } else if (isZOutput) {
+          suspects.add(out);
+        }
+      } else if (!isZOutput) {
+        suspects.add(out);
+      }
+    }
+
+    if (op === 'AND' && !isBit00Input) {
+      if (!feedsGateWithOp(out, 'OR')) {
+        suspects.add(out);
+      }
+    }
+
+    if (op === 'OR') {
+      if (feedsGateWithOp(out, 'OR')) {
+        suspects.add(out);
+      }
+      for (const input of [in1, in2]) {
+        const producerGate = producer.get(input);
+        if (producerGate && producerGate.op !== 'AND') {
+          suspects.add(input);
+        }
+      }
+    }
+  }
+
+  return Array.from(suspects).sort();
+}
