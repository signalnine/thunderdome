+import { describe, expect, it } from 'vitest';
+import { findSwappedWires, simulate, type Gate } from './index.js';
+
+function buildAdder(bits: number): Gate[] {
+  const gates: Gate[] = [];
+  gates.push({ op: 'XOR', in1: 'x00', in2: 'y00', out: 'z00' });
+  gates.push({ op: 'AND', in1: 'x00', in2: 'y00', out: 'c00' });
+
+  for (let i = 1; i < bits; i++) {
+    const idx = String(i).padStart(2, '0');
+    const prev = String(i - 1).padStart(2, '0');
+    const x = `x${idx}`;
+    const y = `y${idx}`;
+    const t = `t${idx}`;
+    const a = `a${idx}`;
+    const b = `b${idx}`;
+    const carryIn = `c${prev}`;
+    const carryOut = i === bits - 1 ? `z${String(bits).padStart(2, '0')}` : `c${idx}`;
+
+    gates.push({ op: 'XOR', in1: x, in2: y, out: t });
+    gates.push({ op: 'XOR', in1: t, in2: carryIn, out: `z${idx}` });
+    gates.push({ op: 'AND', in1: x, in2: y, out: a });
+    gates.push({ op: 'AND', in1: t, in2: carryIn, out: b });
+    gates.push({ op: 'OR', in1: a, in2: b, out: carryOut });
+  }
+
+  return gates;
+}
+
+function swapOutputs(gates: Gate[], wireA: string, wireB: string): void {
+  const gateA = gates.find((g) => g.out === wireA);
+  const gateB = gates.find((g) => g.out === wireB);
+  if (!gateA || !gateB) throw new Error(`wire not found: ${wireA} / ${wireB}`);
+  gateA.out = wireB;
+  gateB.out = wireA;
+}
+
+function setRegister(inputs: Record<string, number>, prefix: string, value: number, bits: number): void {
+  for (let i = 0; i < bits; i++) {
+    inputs[`${prefix}${String(i).padStart(2, '0')}`] = (value >> i) & 1;
+  }
+}
+
+function readRegister(values: Record<string, number>, prefix: string, bits: number): number {
+  let result = 0;
+  for (let i = 0; i < bits; i++) {
+    result |= values[`${prefix}${String(i).padStart(2, '0')}`] << i;
+  }
+  return result;
+}
+
+// A swap is only recoverable (by any algorithm working from gate structure
+// alone, not just this one) if the two swapped wires play locally
+// distinguishable roles. Within `buildAdder`, t_i/c_i (both feed one XOR and
+// one AND) are mutually indistinguishable, and a_i/b_i (both feed one OR)
+// are mutually indistinguishable. Picking role pairs across those two
+// groups (plus the z output role) keeps every generated test swap solvable.
+const ROLE_PAIRS: [string, string][] = [
+  ['z', 't'],
+  ['z', 'a'],
+  ['c', 'b'],
+  ['t', 'a'],
+];
+
+function buildSafeSwaps(bits: number): [string, string][] {
+  const usable = bits - 2; // avoid bit 0 (special) and the top bit (aliases to z)
+  return ROLE_PAIRS.map(([roleA, roleB], i) => {
+    const bit = String(1 + Math.floor(((i + 1) * usable) / (ROLE_PAIRS.length + 1))).padStart(2, '0');
+    return [`${roleA}${bit}`, `${roleB}${bit}`] as [string, string];
+  });
+}
+
