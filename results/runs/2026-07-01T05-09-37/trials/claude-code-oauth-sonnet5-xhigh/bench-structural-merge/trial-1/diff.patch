+import { describe, it, expect, beforeEach } from 'vitest';
+import { DocumentStore } from '../src/index.js';
+
+describe('CRUD', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('creates and gets a document', () => {
+    store.create('doc1', { a: 1 });
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('throws creating a duplicate id', () => {
+    store.create('doc1', { a: 1 });
+    expect(() => store.create('doc1', { a: 2 })).toThrow();
+  });
+
+  it('throws getting a missing document', () => {
+    expect(() => store.get('nope')).toThrow();
+  });
+
+  it('updates a document', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+  });
+
+  it('throws updating a missing document', () => {
+    expect(() => store.update('nope', { a: 1 })).toThrow();
+  });
+
+  it('deletes a document', () => {
+    store.create('doc1', { a: 1 });
+    store.delete('doc1');
+    expect(() => store.get('doc1')).toThrow();
+  });
+
+  it('throws deleting a missing/already-deleted document', () => {
+    expect(() => store.delete('nope')).toThrow();
+    store.create('doc1', { a: 1 });
+    store.delete('doc1');
+    expect(() => store.delete('doc1')).toThrow();
+  });
+
+  it('allows recreating a deleted document', () => {
+    store.create('doc1', { a: 1 });
+    store.delete('doc1');
+    store.create('doc1', { a: 99 });
+    expect(store.get('doc1')).toEqual({ a: 99 });
+  });
+
+  it('deep clones on write and read to prevent mutation', () => {
+    const content = { a: { nested: 1 } };
+    store.create('doc1', content);
+    content.a.nested = 999;
+    expect(store.get('doc1')).toEqual({ a: { nested: 1 } });
+
+    const got = store.get('doc1') as { a: { nested: number } };
+    got.a.nested = 42;
+    expect(store.get('doc1')).toEqual({ a: { nested: 1 } });
+  });
+});
+
+describe('Version history', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('records versions chronologically', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    store.update('doc1', { a: 3 });
+    const history = store.getHistory('doc1');
+    expect(history.length).toBe(3);
+    expect(history.map((v) => v.content)).toEqual([{ a: 1 }, { a: 2 }, { a: 3 }]);
+    for (let i = 1; i < history.length; i++) {
+      expect(history[i].timestamp).toBeGreaterThanOrEqual(history[i - 1].timestamp);
+    }
+    const ids = history.map((v) => v.id);
+    expect(new Set(ids).size).toBe(ids.length);
+  });
+
+  it('gets a specific version by id', () => {
+    store.create('doc1', { a: 1 });
+    store.update('doc1', { a: 2 });
+    const [v1, v2] = store.getHistory('doc1');
+    expect(store.getVersion('doc1', v1.id)).toEqual({ a: 1 });
+    expect(store.getVersion('doc1', v2.id)).toEqual({ a: 2 });
+  });
+
+  it('throws for unknown version id', () => {
+    store.create('doc1', { a: 1 });
+    expect(() => store.getVersion('doc1', 'bogus')).toThrow();
+  });
+});
+
+describe('Branching', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('defaults to main', () => {
+    expect(store.getBranch()).toBe('main');
+    expect(store.listBranches()).toEqual(['main']);
+  });
+
+  it('creates and switches branches', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    expect(store.listBranches().sort()).toEqual(['feature', 'main']);
+    store.switchBranch('feature');
+    expect(store.getBranch()).toBe('feature');
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('isolates changes between branches', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+    store.switchBranch('main');
+    expect(store.get('doc1')).toEqual({ a: 1 });
+  });
+
+  it('branches from an explicit fromBranch', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('b1');
+    store.switchBranch('b1');
+    store.update('doc1', { a: 2 });
+    store.createBranch('b2', 'b1');
+    store.switchBranch('b2');
+    expect(store.get('doc1')).toEqual({ a: 2 });
+  });
+
+  it('throws creating a duplicate branch name', () => {
+    store.createBranch('feature');
+    expect(() => store.createBranch('feature')).toThrow();
+  });
+
+  it('throws switching to unknown branch', () => {
+    expect(() => store.switchBranch('nope')).toThrow();
+  });
+});
+
+describe('Merging', () => {
+  let store: DocumentStore;
+  beforeEach(() => {
+    store = new DocumentStore();
+  });
+
+  it('is a no-op fast-forward when nothing changed', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged).toEqual({});
+  });
+
+  it('auto-applies non-conflicting changes to different fields', () => {
+    store.create('doc1', { a: 1, b: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 9, b: 1 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 9, b: 2 });
+    expect(store.get('doc1')).toEqual({ a: 9, b: 2 });
+  });
+
+  it('detects a conflict when both sides change the same field differently', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 3 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toEqual([
+      { documentId: 'doc1', path: 'a', base: 1, ours: 3, theirs: 2 },
+    ]);
+    // merged shows ours for the conflicting field
+    expect(result.merged.doc1).toEqual({ a: 3 });
+    // current branch left unchanged
+    expect(store.get('doc1')).toEqual({ a: 3 });
+  });
+
+  it('does not conflict when both sides change a field to the same value', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 2 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: 2 });
+  });
+
+  it('merges nested fields structurally, conflicting only at the differing leaf', () => {
+    store.create('doc1', { a: { b: { c: 1, d: 1 }, e: 1 } });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: { b: { c: 1, d: 2 }, e: 1 } });
+    store.switchBranch('main');
+    store.update('doc1', { a: { b: { c: 99, d: 1 }, e: 1 } });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged.doc1).toEqual({ a: { b: { c: 99, d: 2 }, e: 1 } });
+  });
+
+  it('reports a dot-separated path for nested conflicts', () => {
+    store.create('doc1', { a: { b: { c: 1 } } });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: { b: { c: 2 } } });
+    store.switchBranch('main');
+    store.update('doc1', { a: { b: { c: 3 } } });
+
+    const result = store.merge('feature');
+    expect(result.conflicts[0].path).toBe('a.b.c');
+  });
+
+  it('handles multiple documents independently with no conflicts', () => {
+    store.create('doc1', { a: 1 });
+    store.create('doc2', { x: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    store.switchBranch('main');
+    store.update('doc2', { x: 2 });
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(result.merged).toEqual({ doc1: { a: 2 }, doc2: { x: 2 } });
+    expect(store.get('doc1')).toEqual({ a: 2 });
+    expect(store.get('doc2')).toEqual({ x: 2 });
+  });
+
+  it('merges an added key from one side without conflict', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, newKey: 'from feature' });
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.merged.doc1).toEqual({ a: 1, newKey: 'from feature' });
+  });
+
+  it('does not apply changes to current branch when there are conflicts', () => {
+    store.create('doc1', { a: 1, untouched: 'x' });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2, untouched: 'x' });
+    store.switchBranch('main');
+    store.update('doc1', { a: 3, untouched: 'x' });
+
+    store.merge('feature');
+    expect(store.get('doc1')).toEqual({ a: 3, untouched: 'x' });
+    expect(store.getHistory('doc1').length).toBe(2); // no merge version added
+  });
+
+  it('propagates a one-sided delete with no conflict', () => {
+    store.create('doc1', { a: 1 });
+    store.create('doc2', { b: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.delete('doc1');
+    store.switchBranch('main');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(true);
+    expect(result.conflicts).toEqual([]);
+    expect(() => store.get('doc1')).toThrow();
+    expect(store.get('doc2')).toEqual({ b: 1 });
+  });
+
+  it('conflicts when one side deletes and the other modifies', () => {
+    store.create('doc1', { a: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 2 });
+    store.switchBranch('main');
+    store.delete('doc1');
+
+    const result = store.merge('feature');
+    expect(result.applied).toBe(false);
+    expect(result.conflicts.length).toBe(1);
+    expect(result.conflicts[0].documentId).toBe('doc1');
+  });
+
+  it('supports merging in the reverse direction', () => {
+    store.create('doc1', { a: 1, b: 1 });
+    store.createBranch('feature');
+    store.switchBranch('feature');
+    store.update('doc1', { a: 1, b: 2 });
+    store.switchBranch('main');
+    store.update('doc1', { a: 9, b: 1 });
+
+    store.switchBranch('feature');
+    const result = store.merge('main');
+    expect(result.applied).toBe(true);
+    expect(result.merged.doc1).toEqual({ a: 9, b: 2 });
+    expect(store.get('doc1')).toEqual({ a: 9, b: 2 });
+  });
+
+  it('correctly finds the fork point through an intermediate branch', () => {
+    store.create('doc1', { a: 1, b: 1 });
+    store.createBranch('b1');
+    store.switchBranch('b1');
+    store.update('doc1', { a: 2, b: 1 }); // change on b1
+
+    store.createBranch('b2', 'b1'); // b2 forks from b1 (after a's change)
+    store.switchBranch('b2');
+    store.update('doc1', { a: 2, b: 2 }); // change b only
+
+    store.switchBranch('main');
+    store.update('doc1', { a: 1, b: 9 }); // change b on main too -> conflicts with b2's b change relative to b1's fork base
+
+    // main and b2's common ancestor is main's original state {a:1,b:1}
+    const result = store.merge('b2');
+    // main changed b: 1->9, b2 changed a:1->2 and b:1->2 (relative to true common ancestor {a:1,b:1})
+    // a: only b2 changed -> 2
+    // b: both changed (9 vs 2) -> conflict
+    expect(result.applied).toBe(false);
+    expect(result.conflicts).toEqual([
+      { documentId: 'doc1', path: 'b', base: 1, ours: 9, theirs: 2 },
+    ]);
+    expect(result.merged.doc1).toEqual({ a: 2, b: 9 });
+  });
+
+  it('throws merging from an unknown branch', () => {
+    expect(() => store.merge('nope')).toThrow();
+  });
+});
