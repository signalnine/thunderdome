index 0000000..de8b6fa
--- /dev/null
+++ b/src/merge.ts
@@ -0,0 +1,37 @@
+import { deepEqual, isPlainObject } from './clone.js';
+import type { Conflict } from './types.js';
+
+/**
+ * Recursively three-way merges a single value (a whole document, or a field
+ * within one). Returns the merged value; `undefined` means "absent" (the key
+ * should not appear in the result, e.g. because it was deleted).
+ */
+export function mergeValue(
+  base: unknown,
+  ours: unknown,
+  theirs: unknown,
+  path: string,
+  documentId: string,
+  conflicts: Conflict[],
+): unknown {
+  if (deepEqual(ours, theirs)) return ours;
+  if (deepEqual(ours, base)) return theirs; // only theirs changed this value
+  if (deepEqual(theirs, base)) return ours; // only ours changed this value
+
+  // Both sides changed this value, and disagree. If both are objects, merge
+  // field-by-field so only the truly conflicting leaves are flagged.
+  if (isPlainObject(ours) && isPlainObject(theirs)) {
+    const baseObj = isPlainObject(base) ? base : {};
+    const keys = new Set([...Object.keys(baseObj), ...Object.keys(ours), ...Object.keys(theirs)]);
+    const result: Record<string, unknown> = {};
+    for (const key of keys) {
+      const childPath = path ? `${path}.${key}` : key;
+      const mergedChild = mergeValue(baseObj[key], ours[key], theirs[key], childPath, documentId, conflicts);
+      if (mergedChild !== undefined) result[key] = mergedChild;
+    }
+    return result;
+  }
+
+  conflicts.push({ documentId, path, base, ours, theirs });
+  return ours; // display resolution favors "ours"
+}
diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..33920f9
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,195 @@
+import { deepClone, deepEqual } from './clone.js';
+import { mergeValue } from './merge.js';
+import type { Conflict, MergeResult, Version } from './types.js';
+
+interface DocRecord {
+  versions: Version[];
+  deleted: boolean;
+}
+
+type BranchDocs = Map<string, DocRecord>;
+
+function cloneDocRecord(rec: DocRecord): DocRecord {
+  return {
+    deleted: rec.deleted,
+    versions: rec.versions.map((v) => ({ ...v, content: deepClone(v.content) })),
+  };
+}
+
+function currentContent(rec: DocRecord | undefined): object | undefined {
+  if (!rec || rec.deleted) return undefined;
+  return rec.versions[rec.versions.length - 1].content;
+}
+
+/** Content at the last version shared (by id) between two histories, i.e. the fork point. */
+function commonAncestorContent(oursVersions: Version[], theirsVersions: Version[]): object | undefined {
+  let i = 0;
+  while (i < oursVersions.length && i < theirsVersions.length && oursVersions[i].id === theirsVersions[i].id) {
+    i++;
+  }
+  if (i === 0) return undefined;
+  return oursVersions[i - 1].content;
+}
+
+export class DocumentStore {
+  private branches = new Map<string, BranchDocs>([['main', new Map()]]);
+  private currentBranch = 'main';
+  private versionCounter = 0;
+  private lastTimestamp = 0;
+
+  private nextVersionId(): string {
+    this.versionCounter += 1;
+    return `v${this.versionCounter}`;
+  }
+
+  private nextTimestamp(): number {
+    const now = Date.now();
+    this.lastTimestamp = now > this.lastTimestamp ? now : this.lastTimestamp + 1;
+    return this.lastTimestamp;
+  }
+
+  private docs(): BranchDocs {
+    return this.branches.get(this.currentBranch)!;
+  }
+
+  create(id: string, content: object): void {
+    const docs = this.docs();
+    const existing = docs.get(id);
+    if (existing && !existing.deleted) {
+      throw new Error(`Document "${id}" already exists on branch "${this.currentBranch}"`);
+    }
+    const version: Version = { id: this.nextVersionId(), timestamp: this.nextTimestamp(), content: deepClone(content) };
+    if (existing) {
+      existing.versions.push(version);
+      existing.deleted = false;
+    } else {
+      docs.set(id, { versions: [version], deleted: false });
+    }
+  }
+
+  get(id: string): object {
+    const content = currentContent(this.docs().get(id));
+    if (content === undefined) {
+      throw new Error(`Document "${id}" not found on branch "${this.currentBranch}"`);
+    }
+    return deepClone(content);
+  }
+
+  update(id: string, content: object): void {
+    const rec = this.docs().get(id);
+    if (!rec || rec.deleted) {
+      throw new Error(`Document "${id}" not found on branch "${this.currentBranch}"`);
+    }
+    rec.versions.push({ id: this.nextVersionId(), timestamp: this.nextTimestamp(), content: deepClone(content) });
+  }
+
+  delete(id: string): void {
+    const rec = this.docs().get(id);
+    if (!rec || rec.deleted) {
+      throw new Error(`Document "${id}" not found on branch "${this.currentBranch}"`);
+    }
+    rec.deleted = true;
+  }
+
+  getHistory(id: string): Version[] {
+    const rec = this.docs().get(id);
+    if (!rec) {
+      throw new Error(`Document "${id}" not found on branch "${this.currentBranch}"`);
+    }
+    return rec.versions.map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) }));
+  }
+
+  getVersion(id: string, versionId: string): object {
+    const rec = this.docs().get(id);
+    if (!rec) {
+      throw new Error(`Document "${id}" not found on branch "${this.currentBranch}"`);
+    }
+    const version = rec.versions.find((v) => v.id === versionId);
+    if (!version) {
+      throw new Error(`Version "${versionId}" not found for document "${id}"`);
+    }
+    return deepClone(version.content);
+  }
+
+  createBranch(name: string, fromBranch?: string): void {
+    if (this.branches.has(name)) {
+      throw new Error(`Branch "${name}" already exists`);
+    }
+    const sourceName = fromBranch ?? this.currentBranch;
+    const sourceDocs = this.branches.get(sourceName);
+    if (!sourceDocs) {
+      throw new Error(`Branch "${sourceName}" not found`);
+    }
+    const cloned: BranchDocs = new Map();
+    for (const [id, rec] of sourceDocs) {
+      cloned.set(id, cloneDocRecord(rec));
+    }
+    this.branches.set(name, cloned);
+  }
+
+  switchBranch(name: string): void {
+    if (!this.branches.has(name)) {
+      throw new Error(`Branch "${name}" not found`);
+    }
+    this.currentBranch = name;
+  }
+
+  getBranch(): string {
+    return this.currentBranch;
+  }
+
+  listBranches(): string[] {
+    return [...this.branches.keys()];
+  }
+
+  merge(sourceBranch: string): MergeResult {
+    const theirDocs = this.branches.get(sourceBranch);
+    if (!theirDocs) {
+      throw new Error(`Branch "${sourceBranch}" not found`);
+    }
+    const ourDocs = this.docs();
+
+    const merged: Record<string, object> = {};
+    const conflicts: Conflict[] = [];
+    const resolutions = new Map<string, object | undefined>();
+
+    const ids = new Set([...ourDocs.keys(), ...theirDocs.keys()]);
+    for (const id of ids) {
+      const oursRec = ourDocs.get(id);
+      const theirsRec = theirDocs.get(id);
+      const oursContent = currentContent(oursRec);
+      const theirsContent = currentContent(theirsRec);
+      const base = commonAncestorContent(oursRec?.versions ?? [], theirsRec?.versions ?? []);
+
+      const oursChanged = !deepEqual(oursContent, base);
+      const theirsChanged = !deepEqual(theirsContent, base);
+      if (!oursChanged && !theirsChanged) continue; // neither branch touched this document
+
+      const mergedValue = mergeValue(base, oursContent, theirsContent, '', id, conflicts) as object | undefined;
+
+      resolutions.set(id, mergedValue);
+      if (mergedValue !== undefined) merged[id] = mergedValue;
+    }
+
+    const applied = conflicts.length === 0;
+    if (applied) {
+      for (const [id, mergedValue] of resolutions) {
+        const oursRec = ourDocs.get(id);
+        if (mergedValue === undefined) {
+          if (oursRec && !oursRec.deleted) oursRec.deleted = true;
+          continue;
+        }
+        if (deepEqual(currentContent(oursRec), mergedValue)) continue;
+        const version: Version = { id: this.nextVersionId(), timestamp: this.nextTimestamp(), content: deepClone(mergedValue) };
+        if (oursRec) {
+          oursRec.versions.push(version);
+          oursRec.deleted = false;
+        } else {
+          ourDocs.set(id, { versions: [version], deleted: false });
+        }
+      }
+    }
+
+    return { merged, conflicts, applied };
+  }
+}
