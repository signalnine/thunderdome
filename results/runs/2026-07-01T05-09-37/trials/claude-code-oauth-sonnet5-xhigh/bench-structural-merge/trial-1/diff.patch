ame;\n  }\n\n  getBranch(): string {\n    return this.currentBranch;\n  }\n\n  listBranches(): string[] {\n    return [...this.branches.keys()];\n  }\n\n  merge(sourceBranch: string): MergeResult {\n    const theirDocs = this.branches.get(sourceBranch);\n    if (!theirDocs) {\n      throw new Error(`Branch \"${sourceBranch}\" not found`);\n    }\n    const ourDocs = this.docs();\n\n    const merged: Record<string, object> = {};\n    const conflicts: Conflict[] = [];\n    const resolutions = new Map<string, object | undefined>();\n\n    const ids = new Set([...ourDocs.keys(), ...theirDocs.keys()]);\n    for (const id of ids) {\n      const oursRec = ourDocs.get(id);\n      const theirsRec = theirDocs.get(id);\n      const oursContent = currentContent(oursRec);\n      const theirsContent = currentContent(theirsRec);\n\n      if (deepEqual(oursContent, theirsContent)) continue; // nothing changed for this document\n\n      const base = commonAncestorContent(oursRec?.versions ?? [], theirsRec?.versions ?? []);\n      const mergedValue = mergeValue(base, oursContent, theirsContent, '', id, conflicts) as object | undefined;\n\n      resolutions.set(id, mergedValue);\n      if (mergedValue !== undefined) merged[id] = mergedValue;\n    }\n\n    const applied = conflicts.length === 0;\n    if (applied) {\n      for (const [id, mergedValue] of resolutions) {\n        const oursRec = ourDocs.get(id);\n        if (mergedValue === undefined) {\n          if (oursRec && !oursRec.deleted) oursRec.deleted = true;\n          continue;\n        }\n        if (deepEqual(currentContent(oursRec), mergedValue)) continue;\n        const version: Version = { id: this.nextVersionId(), timestamp: this.nextTimestamp(), content: deepClone(mergedValue) };\n        if (oursRec) {\n          oursRec.versions.push(version);\n          oursRec.deleted = false;\n        } else {\n          ourDocs.set(id, { versions: [version], deleted: false });\n        }\n      }\n    }\n\n    return { merged, co