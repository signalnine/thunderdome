+{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_01BgeLqvA4UnDU8nNga9yivn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Eq8Dvv5rSj8CcaMvZPi81C","name":"Write","input":{"file_path":"/workspace/tests/index.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\ndescribe('CRUD', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('creates and gets a document', () => {\n    store.create('doc1', { a: 1 });\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('throws creating a duplicate id', () => {\n    store.create('doc1', { a: 1 });\n    expect(() => store.create('doc1', { a: 2 })).toThrow();\n  });\n\n  it('throws getting a missing document', () => {\n    expect(() => store.get('nope')).toThrow();\n  });\n\n  it('updates a document', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    expect(store.get('doc1')).toEqual({ a: 2 });\n  });\n\n  it('throws updating a missing document', () => {\n    expect(() => store.update('nope', { a: 1 })).toThrow();\n  });\n\n  it('deletes a document', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(() => store.get('doc1')).toThrow();\n  });\n\n  it('throws deleting a missing/already-deleted document', () => {\n    expect(() => store.delete('nope')).toThrow();\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(() => store.delete('doc1')).toThrow();\n  });\n\n  it('allows recreating a deleted document', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    store.create('doc1', { a: 99 });\n    expect(store.get('doc1')).toEqual({ a: 99 });\n  });\n\n  it('deep clones on write and read to prevent mutation', () => {\n    const content = { a: { nested: 1 } };\n    store.create('doc1', content);\n    content.a.nested = 999;\n    expect(store.get('doc1')).toEqual({ a: { nested: 1 } });\n\n    const got = store.get('doc1') as { a: { nested: number } };\n    got.a.nested = 42;\n    expect(store.get('doc1')).toEqual({ a: { nested: 1 } });\n  });\n});\n\ndescribe('Version history', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('records versions chronologically', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    store.update('doc1', { a: 3 });\n    const history = store.getHistory('doc1');\n    expect(history.length).toBe(3);\n    expect(history.map((v) => v.content)).toEqual([{ a: 1 }, { a: 2 }, { a: 3 }]);\n    for (let i = 1; i < history.length; i++) {\n      expect(history[i].timestamp).toBeGreaterThanOrEqual(history[i - 1].timestamp);\n    }\n    const ids = history.map((v) => v.id);\n    expect(new Set(ids).size).toBe(ids.length);\n  });\n\n  it('gets a specific version by id', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    const [v1, v2] = store.getHistory('doc1');\n    expect(store.getVersion('doc1', v1.id)).toEqual({ a: 1 });\n    expect(store.getVersion('doc1', v2.id)).toEqual({ a: 2 });\n  });\n\n  it('throws for unknown version id', () => {\n    store.create('doc1', { a: 1 });\n    expect(() => store.getVersion('doc1', 'bogus')).toThrow();\n  });\n});\n\ndescribe('Branching', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('defaults to main', () => {\n    expect(store.getBranch()).toBe('main');\n    expect(store.listBranches()).toEqual(['main']);\n  });\n\n  it('creates and switches branches', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    expect(store.listBranches().sort()).toEqual(['feature', 'main']);\n    store.switchBranch('feature');\n    expect(store.getBranch()).toBe('feature');\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('isolates changes between branches', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 2 });\n    expect(store.get('doc1')).toEqual({ a: 2 });\n    store.switchBranch('main');\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('branches from an explicit fromBranch', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('b1');\n    store.switchBranch('b1');\n    store.update('doc1', { a: 2 });\n    store.createBranch('b2', 'b1');\n    store.switchBranch('b2');\n    expect(store.get('doc1')).toEqual({ a: 2 });\n  });\n\n  it('throws creating a duplicate branch name', () => {\n    store.createBranch('feature');\n    expect(() => store.createBranch('feature')).toThrow();\n  });\n\n  it('throws switching to unknown branch', () => {\n    expect(() => store.switchBranch('nope')).toThrow();\n  });\n});\n\ndescribe('Merging', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('is a no-op fast-forward when nothing changed', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged).toEqual({});\n  });\n\n  it('auto-applies non-conflicting changes to different fields', () => {\n    store.create('doc1', { a: 1, b: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, b: 2 });\n    store.switchBranch('main');\n    store.update('doc1', { a: 9, b: 1 });\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged.doc1).toEqual({ a: 9, b: 2 });\n    expect(store.get('doc1')).toEqual({ a: 9, b: 2 });\n  });\n\n  it('detects a conflict when both sides change the same field differen