+import { randomUUID } from 'crypto';
+
+// ─── Types ────────────────────────────────────────────────────────────────────
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  queueName: string;
+  priority: number;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  availableAt: Date;
+  lastError?: string;
+  failCount: number;
+  dependsOn: string[];
+  progress?: {
+    percent: number;
+    message?: string;
+    updatedAt: Date;
+  };
+  // internal
+  _enqueueOrder: number;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+  _lastFired?: Date;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface QueueState {
+  tasks: Task[];
+  dlq: Task[];
+  concurrencyLimit: number | null;
+  middleware: Middleware[];
+  schedules: Schedule[];
+  processingIds: Set<string>;
+  dependents: Map<string, Set<string>>;
+}
+
+// ─── Helpers ──────────────────────────────────────────────────────────────────
+
+function uuid(): string {
+  return randomUUID();
+}
+
+// ─── Class ────────────────────────────────────────────────────────────────────
+
+export class TaskQueue {
+  private queues: Map<string, QueueState> = new Map();
+  private taskStore: Map<string, Task> = new Map();
+  private nextOrder: number = 0;
+  private _shuttingDown: boolean = false;
+  private _shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private _shutdownCallbacks: Array<() => void> = [];
+  private _progressSubs: Map<string, Array<(info: ProgressInfo) => void>> = new Map();
+  private _shutdownResolve: ((summary: ShutdownSummary) => void) | null = null;
+  private _shutdownProcessingTasks: Task[] = [];
+  private _shutdownStartTime: number = 0;
+
+  // ── Phase 1: Basic FIFO ──────────────────────────────────────────────────
+
+  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task {
+    if (this._shuttingDown) {
+      throw new Error('TaskQueue is shutting down');
+    }
+
+    const name = queueName || 'default';
+    const priority = options?.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    // Validate dependsOn
+    const dependsOn: string[] = options?.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.taskStore.has(depId)) {
+        throw new Error(`Dependency task ${depId} does not exist`);
+      }
+    }
+
+    // Circular dependency detection
+    for (const depId of dependsOn) {
+      if (this._hasCircularDependency(depId, new Set([depId]))) {
+        throw new Error(`Circular dependency detected involving task ${depId}`);
+      }
+    }
+
+    const availableAt = this._computeAvailableAt(options);
+    const order = this.nextOrder++;
+
+    const task: Task = {
+      id: uuid(),
+      payload,
+      status: 'pending',
+      createdAt: new Date(),
+      queueName: name,
+      priority,
+      attempts: 0,
+      maxRetries: options?.maxRetries ?? 3,
+      backoffMs: options?.backoffMs ?? 1000,
+      availableAt,
+      failCount: 0,
+      dependsOn,
+      _enqueueOrder: order,
+    };
+
+    this._ensureQueue(name);
+    this.taskStore.set(task.id, task);
+    this.queues.get(name)!.tasks.push(task);
+
+    return task;
+  }
+
+  dequeue(queueName?: string): Task | null {
+    const name = queueName || 'default';
+    const state = this.queues.get(name);
+    if (!state) return null;
+
+    const nowTime = Date.now();
+
+    // Collect available tasks
+    const available: Task[] = [];
+
+    for (const task of state.tasks) {
+      if (task.status !== 'pending') continue;
+
+      // Check availability time
+      if (task.availableAt.getTime() > nowTime) {
+        continue;
+      }
+
+      // Check dependencies
+      if (!this._depsSatisfied(task)) {
+        continue;
+      }
+
+      available.push(task);
+    }
+
+    // Check concurrency limit
+    const currentProcessing = state.processingIds.size;
+    if (state.concurrencyLimit !== null && currentProcessing >= state.concurrencyLimit) {
+      return null;
+    }
+
+    // Sort: priority first (lower = higher priority), then availability time, then FIFO
+    available.sort((a, b) => {
+      if (a.priority !== b.priority) return a.priority - b.priority;
+      const atA = a.availableAt.getTime();
+      const atB = b.availableAt.getTime();
+      if (atA !== atB) return atA - atB;
+      return a._enqueueOrder - b._enqueueOrder;
+    });
+
+    if (available.length === 0) return null;
+
+    const task = available[0];
+    task.status = 'processing';
+    task.attempts += 1;
+    state.processingIds.add(task.id);
+
+    // Remove from queue
+    const idx = state.tasks.indexOf(task);
+    if (idx !== -1) state.tasks.splice(idx, 1);
+
+    return task;
+  }
+
+  size(): number {
+    let total = 0;
+    for (const state of this.queues.values()) {
+      for (const t of state.tasks) {
+        if (t.status === 'pending') total++;
+      }
+    }
+    return total;
+  }
+
+  // ── Phase 2: Named Queues ────────────────────────────────────────────────
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  queueSize(queueName: string): number {
+    const state = this.queues.get(queueName);
+    if (!state) return 0;
+    let count = 0;
+    for (const t of state.tasks) {
+      if (t.status === 'pending') count++;
+    }
+    return count;
+  }
+
+  // ── Phase 5: Retry with Backoff ──────────────────────────────────────────
+
+  fail(taskId: string, error?: string): void {
+    const task = this.taskStore.get(taskId);
+    if (!task) return;
+    if (task.status === 'cancelled') return;
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    // maxRetries is the number of retries allowed (not total attempts)
+    // attempts starts at 1 on first dequeue, so if attempts > maxRetries, no more retries
+    if (task.attempts > task.maxRetries) {
+      // Exhausted retries - move to DLQ
+      task.status = 'failed';
+      this._moveToDLQ(task);
+      // Notify shutdown if active
+      this._checkShutdownCompletion();
+      return;
+    }
+
+    // Re-enqueue with backoff delay
+    const backoffDelay = task.backoffMs * Math.pow(2, task.attempts - 1);
+    task.availableAt = new Date(Date.now() + backoffDelay);
+    task.status = 'pending';
+
+    // Remove from current queue and free concurrency slot
+    const state = this.queues.get(task.queueName);
+    if (state) {
+      state.processingIds.delete(taskId);
+      const idx = state.tasks.indexOf(task);
+      if (idx !== -1) state.tasks.splice(idx, 1);
+    }
+
+    // Re-add to the queue
+    this._ensureQueue(task.queueName);
+    this.queues.get(task.queueName)!.tasks.push(task);
+  }
+
+  complete(taskId: string): void {
+    const task = this.taskStore.get(taskId);
+    if (!task) return;
+
+    task.status = 'completed';
+
+    // Free concurrency slot
+    const state = this.queues.get(task.queueName);
+    if (state) {
+      state.processingIds.delete(taskId);
+    }
+
+    // Check dependents
+    this._notifyDependents(taskId);
+
+    // Notify shutdown if active
+    this._checkShutdownCompletion();
+  }
+
+  // ── Phase 6: Dead Letter Queue ───────────────────────────────────────────
+
+  getDLQ(queueName: string): Task[] {
+    const state = this.queues.get(queueName);
+    return state ? [...state.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    for (const [qName, state] of this.queues) {
+      const idx = state.dlq.findIndex((t) => t.id === taskId);
+      if (idx !== -1) {
+        const task = state.dlq[idx];
+        state.dlq.splice(idx, 1);
+        task.failCount = 0;
+        task.attempts = 0;
+        task.lastError = undefined;
+        task.status = 'pending';
+        task.availableAt = new Date();
+
+        this._ensureQueue(qName);
+        this.queues.get(qName)!.tasks.push(task);
+        return task;
+      }
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    const state = this.queues.get(queueName);
+    if (state) state.dlq = [];
+  }
+
+  // ── Phase 7: Dependencies ────────────────────────────────────────────────
+
+  getDependencies(taskId: string): Array<{ taskId: string; status: TaskStatus }> {
+    const task = this.taskStore.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((depId) => ({
+      taskId: depId,
+      status: this.taskStore.get(depId)?.status ?? 'failed',
+    }));
+  }
+
+  // ── Phase 8: Concurrency Control ─────────────────────────────────────────
+
+  setConcurrency(queueName: string, limit: number): void {
+    this._ensureQueue(queueName);
+    this.queues.get(queueName)!.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const state = this.queues.get(queueName);
+    if (!state) return { current: 0, max: 0 };
+    return {
+      current: state.processingIds.size,
+      max: state.concurrencyLimit ?? 0,
+    };
+  }
+
+  // ── Phase 9: Progress & Cancellation ─────────────────────────────────────
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    const task = this.taskStore.get(taskId);
+    if (!task) return;
+    if (percent < 0 || percent > 100) {
+      throw new Error('Progress must be between 0 and 100');
+    }
+    task.progress = { percent, message, updatedAt: new Date() };
+
+    const subs = this._progressSubs.get(taskId);
+    if (subs) {
+      const info: ProgressInfo = { percent, message, updatedAt: task.progress.updatedAt };
+      for (const cb of subs) {
+        cb(info);
+      }
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    const task = this.taskStore.get(taskId);
+    if (!task?.progress) return null;
+    return { ...task.progress };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.taskStore.get(taskId);
+    if (!task) return;
+
+    task.status = 'cancelled';
+
+    // Remove from queue if pending
+    const state = this.queues.get(task.queueName);
+    if (state) {
+      const idx = state.tasks.indexOf(task);
+      if (idx !== -1) state.tasks.splice(idx, 1);
+      state.processingIds.delete(taskId);
+    }
+  }
+
+  onProgress(taskId: string, callback: (info: ProgressInfo) => void): () => void {
+    if (!this._progressSubs.has(taskId)) {
+      this._progressSubs.set(taskId, []);
+    }
+    this._progressSubs.get(taskId)!.push(callback);
+
+    return () => {
+      const subs = this._progressSubs.get(taskId);
+      if (subs) {
+        const idx = subs.indexOf(callback);
+        if (idx !== -1) subs.splice(idx, 1);
+      }
+    };
+  }
+
+  // ── Phase 10: Recurring Tasks (Cron) ─────────────────────────────────────
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const schedule: Schedule = {
+      id: uuid(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+    };
+
+    this._ensureQueue(queueName);
+    this.queues.get(queueName)!.schedules.push(schedule);
+    return schedule;
+  }
+
+  unschedule(scheduleId: string): void {
+    for (const state of this.queues.values()) {
+      const sched = state.schedules.find((s) => s.id === scheduleId);
+      if (sched) {
+        sched.active = false;
+        return;
+      }
+    }
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const result: Schedule[] = [];
+    for (const state of this.queues.values()) {
+      for (const s of state.schedules) {
+        if (!s.active) continue;
+        if (queueName && s.queueName !== queueName) continue;
+        result.push(s);
+      }
+    }
+    return result;
+  }
+
+  tick(): void {
+    const currentTime = new Date();
+    for (const state of this.queues.values()) {
+      for (const schedule of state.schedules) {
+        if (!schedule.active) continue;
+        if (this._isCronDue(schedule.cronExpression, currentTime, schedule._lastFired)) {
+          this.enqueue(schedule.queueName, schedule.taskTemplate);
+          schedule._lastFired = currentTime;
+        }
+      }
+    }
+  }
+
+  // ── Phase 11: Middleware Pipeline ────────────────────────────────────────
+
+  use(queueName: string, middleware: Middleware): void {
+    this._ensureQueue(queueName);
+    this.queues.get(queueName)!.middleware.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const state = this.queues.get(queueName)!;
+    const middlewares = [...state.middleware];
+
+    try {
+      await this._runMiddleware(middlewares, 0, task, handler);
+    } catch (err: unknown) {
+      task.status = 'failed';
+      task.lastError = (err as Error)?.message || String(err);
+      state.processingIds.delete(task.id);
+    }
+  }
+
+  // ── Phase 12: Graceful Shutdown ──────────────────────────────────────────
+
+  onShutdown(callback: () => void): void {
+    this._shutdownCallbacks.push(callback);
+  }
+
+  async shutdown(timeout?: number): Promise<ShutdownSummary> {
+    if (this._shutdownPromise) {
+      return this._shutdownPromise;
+    }
+
+    this._shuttingDown = true;
+    const startTime = Date.now();
+    const toTimeout = timeout ?? 30000;
+
+    // Collect processing tasks
+    const processingTasks: Task[] = [];
+    for (const task of this.taskStore.values()) {
+      if (task.status === 'processing') {
+        processingTasks.push(task);
+      }
+    }
+
+    this._shutdownProcessingTasks = processingTasks;
+    this._shutdownStartTime = startTime;
+
+    const promise = new Promise<ShutdownSummary>((resolve) => {
+      this._shutdownResolve = (summary) => resolve(summary);
+
+      // Fire shutdown callbacks
+      for (const cb of this._shutdownCallbacks) {
+        try {
+          cb();
+        } catch {
+          // ignore
+        }
+      }
+
+      if (processingTasks.length === 0) {
+        this._shutdownResolve({ completed: 0, cancelled: 0, elapsed: Date.now() - startTime });
+        return;
+      }
+
+      // Set up timeout
+      const timerId = setTimeout(() => {
+        const cancelled: Task[] = [];
+        const completed: Task[] = [];
+        for (const task of processingTasks) {
+          if (task.status === 'processing') {
+            task.status = 'cancelled';
+            cancelled.push(task);
+            const state = this.queues.get(task.queueName);
+            if (state) state.processingIds.delete(task.id);
+          } else {
+            completed.push(task);
+          }
+        }
+        this._shutdownResolve!({
+          completed: completed.length,
+          cancelled: cancelled.length,
+          elapsed: Date.now() - startTime,
+        });
+      }, toTimeout);
+
+      // Check completion periodically
+      const check = () => {
+        const remaining = processingTasks.filter((t) => t.status === 'processing');
+        if (remaining.length === 0) {
+          clearTimeout(timerId);
+          const completed: Task[] = [];
+          const cancelled: Task[] = [];
+          for (const task of processingTasks) {
+            if (task.status === 'completed' || task.status === 'failed') {
+              completed.push(task);
+            } else if (task.status === 'cancelled') {
+              cancelled.push(task);
+            }
+          }
+          this._shutdownResolve!({
+            completed: completed.length,
+            cancelled: cancelled.length,
+            elapsed: Date.now() - startTime,
+          });
+        } else {
+          setTimeout(check, 10);
+        }
+      };
+      setTimeout(check, 0);
+    });
+
+    this._shutdownPromise = promise;
+    return promise;
+  }
+
+  // ── Internal Helpers ─────────────────────────────────────────────────────
+
+  private _ensureQueue(name: string): void {
+    if (!this.queues.has(name)) {
+      this.queues.set(name, {
+        tasks: [],
+        dlq: [],
+        concurrencyLimit: null,
+        middleware: [],
+        schedules: [],
+        processingIds: new Set(),
+        dependents: new Map(),
+      });
+    }
+  }
+
+  private _computeAvailableAt(options?: EnqueueOptions): Date {
+    if (options?.runAt) {
+      return new Date(options.runAt.getTime());
+    }
+    if (options?.delay) {
+      return new Date(Date.now() + options.delay);
+    }
+    return new Date(0); // available immediately
+  }
+
+  private _depsSatisfied(task: Task): boolean {
+    if (task.dependsOn.length === 0) return true;
+    for (const depId of task.dependsOn) {
+      const dep = this.taskStore.get(depId);
+      if (!dep || dep.status !== 'completed') return false;
+    }
+    return true;
+  }
+
+  private _hasCircularDependency(depId: string, visited: Set<string>): boolean {
+    const depTask = this.taskStore.get(depId);
+    if (!depTask) return false;
+    for (const next of depTask.dependsOn) {
+      if (visited.has(next)) return true;
+      visited.add(next);
+      if (this._hasCircularDependency(next, visited)) return true;
+    }
+    return false;
+  }
+
+  private _notifyDependents(_completedTaskId: string): void {
+    // Dependencies are checked in dequeue's _depsSatisfied, so no action needed here
+    // The dependent tasks will become available on the next dequeue() call
+  }
+
+  private _moveToDLQ(task: Task): void {
+    const state = this.queues.get(task.queueName);
+    if (state) {
+      state.processingIds.delete(task.id);
+      state.dlq.push(task);
+      const idx = state.tasks.indexOf(task);
+      if (idx !== -1) state.tasks.splice(idx, 1);
+    }
+  }
+
+  private _checkShutdownCompletion(): void {
+    if (!this._shutdownResolve || this._shutdownProcessingTasks.length === 0) return;
+    const remaining = this._shutdownProcessingTasks.filter((t) => t.status === 'processing');
+    if (remaining.length === 0) {
+      const completed: number = this._shutdownProcessingTasks.filter(
+        (t) => t.status === 'completed' || t.status === 'failed',
+      ).length;
+      const cancelled: number = this._shutdownProcessingTasks.filter(
+        (t) => t.status === 'cancelled',
+      ).length;
+      this._shutdownResolve!({
+        completed,
+        cancelled,
+        elapsed: Date.now() - this._shutdownStartTime,
+      });
+    }
+  }
+
+  private async _runMiddleware(
+    middlewares: Middleware[],
+    index: number,
+    task: Task,
+    handler: (task: Task) => Promise<void>,
+  ): Promise<void> {
+    if (index >= middlewares.length) {
+      await handler(task);
+      if (task.status === 'processing') {
+        task.status = 'completed';
+      }
+      const state = this.queues.get(task.queueName);
+      if (state) {
+        state.processingIds.delete(task.id);
+      }
+      this._notifyDependents(task.id);
+      return;
+    }
+
+    const mw = middlewares[index];
+    await mw(task, () => this._runMiddleware(middlewares, index + 1, task, handler));
+  }
+
+  private _isCronDue(expression: string, currentTime: Date, lastFired?: Date): boolean {
+    const parts = expression.split(' ');
+    if (parts.length < 5) return false;
+
+    const [minutePart, hourPart] = parts;
+    const currentMinute = currentTime.getMinutes();
+    const currentHour = currentTime.getHours();
+
+    if (minutePart === '0' && hourPart === '*') {
+      if (currentMinute !== 0) return false;
+      if (lastFired) {
+        return lastFired.getHours() !== currentHour;
+      }
+      return true;
+    }
+
+    if (minutePart === '0' && hourPart === '0') {
+      if (currentMinute !== 0 || currentHour !== 0) return false;
+      if (lastFired) {
+        return lastFired.getDate() !== currentTime.getDate();
+      }
+      return true;
+    }
+
+    if (minutePart.startsWith('*/')) {
+      const n = parseInt(minutePart.slice(2), 10);
+      if (isNaN(n) || n === 0) return false;
+      if (currentMinute % n !== 0) return false;
+      if (lastFired) {
+        const lastMinute = lastFired.getMinutes();
+        return lastMinute !== currentMinute || lastFired.getHours() !== currentHour;
+      }
+      return true;
+    }
+
+    return false;
+  }
+}
+
+interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
