+            const newSol = new Array(m).fill(0);
+            for (let i = 0; i < m; i++) {
+              const val = ((current[i] + v1 * nb1[i] + v2 * nb2[i]) % modulus + modulus) % modulus;
+              newSol[i] = val;
+            }
+            const total = newSol.reduce((a, b) => a + b, 0);
+            if (total < bestTotal || (total === bestTotal && numArrLexSmaller(newSol, bestSol))) {
+              bestTotal = total;
+              bestSol = [...newSol];
+              current = [...newSol];
+            }
+          }
+        }
+      }
+    }
+  }
+
+  if (bestSol.every((v, i) => v === particular[i])) {
+    // No improvement found, return particular
+    return particular;
+  }
+
+  return bestSol;
+}
+
+function numArrLexSmaller(a: number[], b: number[]): boolean {
+  const len = Math.min(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return a.length < b.length;
+}
