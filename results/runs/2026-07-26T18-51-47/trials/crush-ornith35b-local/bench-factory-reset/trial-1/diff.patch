+interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+/**
+ * Solve the toggle puzzle using Gaussian elimination over GF(2).
+ * Finds minimum-weight, lexicographically smallest solution.
+ */
+export function solveToggle(machine: Machine): number[] | null {
+  const { target, buttons } = machine;
+  const n = target.length;
+  const m = buttons.length;
+
+  if (m === 0) {
+    return target.every(v => !v) ? [] : null;
+  }
+
+  // Build augmented matrix over GF(2) as BigInt rows
+  const rows = new BigInt64Array(n);
+  for (let i = 0; i < n; i++) {
+    let row = BigInt(0);
+    for (let j = 0; j < m; j++) {
+      if (buttons[j].includes(i)) {
+        row |= (1n << BigInt(j));
+      }
+    }
+    if (target[i]) {
+      row |= (1n << BigInt(m));
+    }
+    rows[i] = row;
+  }
+
+  // Gaussian elimination over GF(2) to RREF
+  const pivotCol = new Array(n).fill(-1);
+  let pivotRowIdx = 0;
+  const freeCols: number[] = [];
+  const pivotRowsList: number[] = [];
+
+  for (let col = 0; col < m; col++) {
+    let found = -1;
+    for (let r = pivotRowIdx; r < n; r++) {
+      if (rows[r] & (1n << BigInt(col))) {
+        found = r;
+        break;
+      }
+    }
+    if (found === -1) {
+      freeCols.push(col);
+      continue;
+    }
+    [rows[pivotRowIdx], rows[found]] = [rows[found], rows[pivotRowIdx]];
+    pivotCol[pivotRowIdx] = col;
+    pivotRowsList.push(pivotRowIdx);
+
+    for (let r = 0; r < n; r++) {
+      if (r !== pivotRowIdx && (rows[r] & (1n << BigInt(col)))) {
+        rows[r] ^= rows[pivotRowIdx];
+      }
+    }
+    pivotRowIdx++;
+  }
+
+  // Check consistency
+  for (let r = pivotRowIdx; r < n; r++) {
+    if (rows[r] & (1n << BigInt(m))) {
+      return null;
+    }
+  }
+
+  const numFree = freeCols.length;
+  const numPivots = pivotRowsList.length;
+
+  // Compute particular solution and null space basis
+  const particular = new Array(m).fill(false);
+  const nullBasis: boolean[][] = new Array(numFree);
+
+  for (let r = 0; r < numPivots; r++) {
+    const pr = pivotRowsList[r];
+    const pc = pivotCol[pr];
+    let val = ((rows[pr] >> BigInt(m)) & 1n) === 1n;
+    for (let i = 0; i < numFree; i++) {
+      if (rows[pr] & (1n << BigInt(freeCols[i]))) {
+        val = !val;
+      }
+    }
+    particular[pc] = val;
+  }
+
+  for (let i = 0; i < numFree; i++) {
+    const fc = freeCols[i];
+    const vec = new Array(m).fill(false);
+    vec[fc] = true;
+    for (let r = 0; r < numPivots; r++) {
+      const pr = pivotRowsList[r];
+      const pc = pivotCol[pr];
+      if (rows[pr] & (1n << BigInt(fc))) {
+        vec[pc] = !vec[pc];
+      }
+    }
+    nullBasis[i] = vec;
+  }
+
+  // Enumerate all 2^numFree solutions if feasible
+  if (numFree <= 24) {
+    let bestSolution: number[] | null = null;
+    let bestWeight = m + 1;
+
+    for (let mask = 0; mask < (1 << numFree); mask++) {
+      const solution = xformBool(particular, nullBasis, mask);
+      const weight = popcountBool(solution);
+
+      if (weight < bestWeight ||
+          (weight === bestWeight && bestSolution !== null && indicesLexSmallerArr(solToIndices(solution), bestSolution))) {
+        bestWeight = weight;
+        bestSolution = solToIndices(solution);
+      }
+    }
+
+    if (bestSolution === null) return null;
+    return bestSolution;
+  }
+
+  // For larger numFree, use iterative local search to find minimum weight
+  // Start with particular solution, then try flipping null space vectors
+  // to reduce weight. This is a heuristic but works well in practice.
+  let current = solToIndices(particular);
+  let currentWeight = popcountIndices(current);
+  let bestSol = [...current];
+  let bestWeight = currentWeight;
+
+  // Try all single null space vector flips
+  for (let i = 0; i < numFree; i++) {
+    const candidate = xorIndices(current, solToIndices(nullBasis[i]));
+    const w = popcountIndices(candidate);
+    if (w < bestWeight || (w === bestWeight && indicesLexSmallerArr(candidate, bestSol))) {
+      bestWeight = w;
+      bestSol = candidate;
+    }
+  }
+
+  // Iterative improvement: try pairs, then triples, etc.
+  // For practical purposes, limit to a reasonable search
+  let improved = true;
+  let iteration = 0;
+  while (improved && iteration < 100) {
+    improved = false;
+    iteration++;
+
+    // Try flipping pairs of null space vectors
+    for (let i = 0; i < numFree && !improved; i++) {
+      for (let j = i + 1; j < numFree && !improved; j++) {
+        const nbI = solToIndices(nullBasis[i]);
+        const nbJ = solToIndices(nullBasis[j]);
+        const combined = xorIndices(nbI, nbJ);
+        const candidate = xorIndices(bestSol, combined);
+        const w = popcountIndices(candidate);
+        if (w < bestWeight || (w === bestWeight && indicesLexSmallerArr(candidate, bestSol))) {
+          bestWeight = w;
+          bestSol = candidate;
+          improved = true;
+        }
+      }
+    }
+  }
+
+  return bestSol;
+}
+
+function xformBool(particular: boolean[], nullBasis: boolean[][], mask: number): boolean[] {
+  const m = particular.length;
+  const sol = [...particular];
+  for (let j = 0; j < nullBasis.length; j++) {
+    if (mask & (1 << j)) {
+      const nb = nullBasis[j];
+      for (let i = 0; i < m; i++) {
+        sol[i] = sol[i] !== nb[i];
+      }
+    }
+  }
+  return sol;
+}
+
+function popcountBool(sol: boolean[]): number {
+  let w = 0;
+  for (let i = 0; i < sol.length; i++) {
+    if (sol[i]) w++;
+  }
+  return w;
+}
+
+function solToIndices(sol: boolean[]): number[] {
+  const result: number[] = [];
+  for (let i = 0; i < sol.length; i++) {
+    if (sol[i]) result.push(i);
+  }
+  return result;
+}
+
+function popcountIndices(indices: number[]): number {
+  return indices.length;
+}
+
+function xorIndices(a: number[], b: number[]): number[] {
+  const setA = new Set(a);
+  const setB = new Set(b);
+  const result: number[] = [];
+  const maxLen = Math.max(a.length, b.length);
+  let i = 0, j = 0;
+  while (i < a.length && j < b.length) {
+    if (a[i] < b[j]) { result.push(a[i]); i++; }
+    else if (a[i] > b[j]) { result.push(b[j]); j++; }
+    else { i++; j++; }
+  }
+  while (i < a.length) { result.push(a[i]); i++; }
+  while (j < b.length) { result.push(b[j]); j++; }
+  return result;
+}
+
+function indicesLexSmallerArr(a: number[], b: number[]): boolean {
+  const len = Math.min(a.length, b.length);
+  for (let i = 0; i < len; i++) {
+    if (a[i] < b[i]) return true;
+    if (a[i] > b[i]) return false;
+  }
+  return a.length < b.length;
+}
+
+/**
+ * Solve the counter puzzle using Gaussian elimination over Z_p.
+ * Finds minimum total presses, then lexicographically smallest solution.
+ */
+export function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number,
+): number[] | null {
+  const n = lights.length;
+  const m = buttons.length;
+
+  if (m === 0) {
+    return lights.every(v => v % modulus === 0) ? [] : null;
+  }
+
+  // Build augmented matrix over Z_p
+  const mat: number[][] = [];
+  for (let i = 0; i < n; i++) {
+    mat[i] = new Array(m + 1).fill(0);
+  }
+  for (let j = 0; j < m; j++) {
+    for (const i of buttons[j]) {
+      if (i < n) {
+        mat[i][j] = (mat[i][j] + 1) % modulus;
+      }
+    }
+  }
+  for (let i = 0; i < n; i++) {
+    mat[i][m] = ((lights[i] % modulus) + modulus) % modulus;
+  }
+
+  // Gaussian elimination over Z_p (modulus is prime)
+  const pivotCol = new Array(n).fill(-1);
+  let pivotRowIdx = 0;
+  const freeCols: number[] = [];
+  const pivotRowsList: number[] = [];
+
+  function modInv(a: number): number {
+    let [old_r, r] = [a, modulus];
+    let [old_s, s] = [1, 0];
+    while (r !== 0) {
+      const q = Math.floor(old_r / r);
+      [old_r, r] = [r, old_r - q * r];
+      [old_s, s] = [s, old_s - q * s];
+    }
+    return ((old_s % modulus) + modulus) % modulus;
+  }
+
+  for (let col = 0; col < m; col++) {
+    let found = -1;
+    for (let r = pivotRowIdx; r < n; r++) {
+      if (mat[r][col] % modulus !== 0) {
+        found = r;
+        break;
+      }
+    }
+    if (found === -1) {
+      freeCols.push(col);
+      continue;
+    }
+    [mat[pivotRowIdx], mat[found]] = [mat[found], mat[pivotRowIdx]];
+    pivotCol[pivotRowIdx] = col;
+    pivotRowsList.push(pivotRowIdx);
+
+    const inv = modInv(mat[pivotRowIdx][col]);
+    for (let c = 0; c <= m; c++) {
+      mat[pivotRowIdx][c] = (mat[pivotRowIdx][c] * inv) % modulus;
+    }
+
+    for (let r = 0; r < n; r++) {
+      if (r !== pivotRowIdx && mat[r][col] % modulus !== 0) {
+        const factor = mat[r][col];
+        for (let c = 0; c <= m; c++) {
+          mat[r][c] = ((mat[r][c] - factor * mat[pivotRowIdx][c]) % modulus + modulus) % modulus;
+        }
+      }
+    }
+    pivotRowIdx++;
+  }
+
+  // Check consistency
+  for (let r = pivotRowIdx; r < n; r++) {
+    if (mat[r][m] % modulus !== 0) {
+      return null;
+    }
+  }
+
+  const numFree = freeCols.length;
+  const numPivots = pivotRowsList.length;
+
+  // Build null space basis and particular solution
+  const particular = new Array(m).fill(0);
+  const nullBasis: number[][] = new Array(numFree);
+
+  for (let r = 0; r < numPivots; r++) {
+    const pr = pivotRowsList[r];
+    const pc = pivotCol[pr];
+    particular[pc] = mat[pr][m];
+  }
+
+  for (let i = 0; i < numFree; i++) {
+    const fc = freeCols[i];
+    const vec = new Array(m).fill(0);
+    vec[fc] = 1;
+    for (let r = 0; r < numPivots; r++) {
