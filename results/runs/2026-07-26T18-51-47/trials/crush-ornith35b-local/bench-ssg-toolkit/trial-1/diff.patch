@@ -0,0 +1,32 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+function stripHtml(html: string): string {
+  // Remove HTML tags but keep content of code blocks
+  return html
+    .replace(/<pre><code[^>]*>([\s\S]*?)<\/code><\/pre>/g, (_match, code) => {
+      return code.replace(/<[^>]+>/g, '');
+    })
+    .replace(/<[^>]+>/g, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const entries = ctx.files.map(file => ({
+          title: file.title,
+          slug: file.slug,
+          content: stripHtml(file.content),
+          tags: file.tags,
+        }));
+
+        ctx.output.set('search-index.json', JSON.stringify(entries, null, 2));
+      },
+    },
+  };
+}
