@@ -0,0 +1,56 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const baseUrl = ctx.config.baseUrl.replace(/\/$/, '');
+        const pages: string[] = [];
+
+        // Add content pages (exclude special files)
+        for (const [path] of ctx.output) {
+          if (path === 'feed.xml' || path === 'sitemap.xml' || path === 'search-index.json') continue;
+          pages.push(`${baseUrl}/${path}`);
+        }
+
+        // Add taxonomy tag pages from tag map
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        if (tagMap) {
+          for (const [tag] of tagMap) {
+            pages.push(`${baseUrl}/tags/${tag}.html`);
+          }
+        }
+
+        // Add feed URL
+        if (ctx.output.has('feed.xml')) {
+          pages.push(`${baseUrl}/feed.xml`);
+        }
+
+        let xml = `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+`;
+
+        for (const url of pages) {
+          xml += `  <url>
+    <loc>${escapeXml(url)}</loc>
+  </url>
+`;
+        }
+
+        xml += `</urlset>`;
+        ctx.output.set('sitemap.xml', xml);
+      },
+    },
+  };
+}
