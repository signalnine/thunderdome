+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile | Promise<ContentFile> {
+        let content = file.content;
+
+        // Extract footnotes and replace inline references
+        const footnoteDefs: Map<number, string> = new Map();
+        const footnoteDefRegex = /^\[\^(\d+)\]:\s*(.+)$/gm;
+        let match: RegExpExecArray | null;
+
+        while ((match = footnoteDefRegex.exec(content)) !== null) {
+          const num = parseInt(match[1], 10);
+          footnoteDefs.set(num, match[2].trim());
+        }
+
+        // Replace footnote references with superscript links
+        content = content.replace(/\[\^(\d+)\]/g, (_match: string, num: string) => {
+          const n = parseInt(num, 10);
+          return `<sup><a href="#fn-${n}">${n}</a></sup>`;
+        });
+
+        // Remove footnote definitions from content
+        content = content.replace(/^\[\^(\d+)\]:\s*.+$/gm, '');
+
+        // Build footnote section
+        if (footnoteDefs.size > 0) {
+          const footnotesHtml: string[] = [];
+          for (const [num, text] of footnoteDefs) {
+            footnotesHtml.push(`<li id="fn-${num}">${text}</li>`);
+          }
+          content += `\n\n<section class="footnotes">\n<h2>Footnotes</h2>\n<ol>\n${footnotesHtml.join('\n')}\n</ol>\n</section>`;
+        }
+
+        // Convert admonition containers
+        const admonitionRegex = /:::(note|warning|tip)\s*\n([\s\S]*?)\n:::/g;
+        content = content.replace(admonitionRegex, (_match: string, type: string, body: string) => {
+          return `<div class="admonition admonition-${type}">${body.trim()}</div>`;
+        });
+
+        // Convert markdown to HTML using marked
+        try {
+          content = marked.parse(content, { async: false }) as string;
+        } catch {
+          // If marked fails, keep the content as-is
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
