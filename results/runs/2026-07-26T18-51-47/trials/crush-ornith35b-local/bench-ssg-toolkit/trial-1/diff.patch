+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx): ContentFile | Promise<ContentFile> {
+        let content = file.content;
+
+        // Get or initialize asset manifest
+        let manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        if (!manifest) {
+          manifest = { assets: [] };
+          ctx.data.set('asset-manifest', manifest);
+        }
+
+        // Match relative asset URLs (./something) but not already-rewritten /assets/ paths
+        content = content.replace(/((?:src|href)=")\.\/([^"']+)"/g, (_match: string, prefix: string, asset: string) => {
+          manifest!.assets.push(asset);
+          return `${prefix}/assets/${asset}"`;
+        });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
