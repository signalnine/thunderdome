@@ -0,0 +1,24 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile | Promise<ContentFile> {
+        let content = file.content;
+
+        // Match <pre><code class="language-xxx">...</code></pre> blocks
+        content = content.replace(
+          /<pre><code class="language-([^"]+)">([\s\S]*?)<\/code><\/pre>/g,
+          (_match: string, lang: string, code: string) => {
+            return `<pre><code class="language-${lang} highlighted" data-language="${lang}">${code}</code></pre>`;
+          }
+        );
+
+        return { ...file, content };
+      },
+    },
+  };
+}
