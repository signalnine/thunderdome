+import { BuildContext, Plugin } from '../core/types.js';
+
+interface DevServerRoute {
+  path: string;
+  handler: string;
+}
+
+interface DevServerConfig {
+  port: number;
+  routes: DevServerRoute[];
+  assetPaths: string[];
+  searchIndexPath: string;
+}
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const routes: DevServerRoute[] = [];
+        const assetPaths: string[] = [];
+
+        // Asset routes from asset-pipeline manifest
+        const manifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        if (manifest && manifest.assets) {
+          for (const asset of manifest.assets) {
+            assetPaths.push(asset);
+            routes.push({ path: `/assets/${asset}`, handler: 'asset' });
+          }
+        }
+
+        // Content routes from output
+        for (const [path] of ctx.output) {
+          if (path === 'search-index.json') continue;
+          if (path.endsWith('.html')) {
+            routes.push({ path: `/${path}`, handler: 'static' });
+          }
+        }
+
+        // Search index path
+        const searchIndexPath = ctx.output.has('search-index.json') ? '/search-index.json' : '';
+
+        const config: DevServerConfig = {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath,
+        };
+
+        ctx.data.set('dev-server-config', config);
+      },
+    },
+  };
+}
