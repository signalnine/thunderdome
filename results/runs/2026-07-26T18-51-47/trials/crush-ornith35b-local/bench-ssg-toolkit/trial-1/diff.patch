@@ -0,0 +1,79 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        const tagIndex = new Map<string, string[]>();
+        if (tagMap) {
+          for (const [tag, files] of tagMap) {
+            tagIndex.set(tag, files.map(f => f.slug));
+          }
+        }
+
+        // Sort files by date, newest first; files without dates go last
+        const sorted = [...ctx.files].sort((a, b) => {
+          const da = a.date ? new Date(a.date).getTime() : 0;
+          const db = b.date ? new Date(b.date).getTime() : 0;
+          if (da === 0 && db === 0) return 0;
+          if (da === 0) return 1;
+          if (db === 0) return -1;
+          return db - da;
+        });
+
+        const baseUrl = ctx.config.baseUrl.replace(/\/$/, '');
+        let xml = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${escapeXml(baseUrl)}</link>
+`;
+
+        for (const file of sorted) {
+          xml += `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${escapeXml(baseUrl)}/${file.slug}.html</link>
+      <guid>${escapeXml(baseUrl)}/${file.slug}.html</guid>
+`;
+          if (file.date) {
+            xml += `      <pubDate>${new Date(file.date).toUTCString()}</pubDate>
+`;
+          }
+          if (file.content) {
+            xml += `      <description><![CDATA[${file.content}]]></description>
+`;
+          }
+          // Add categories from taxonomy
+          if (tagIndex) {
+            for (const [tag, slugs] of tagIndex) {
+              if (slugs.includes(file.slug)) {
+                xml += `      <category>${escapeXml(tag)}</category>
+`;
+              }
+            }
+          }
+          xml += `    </item>
+`;
+        }
+
+        xml += `  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
