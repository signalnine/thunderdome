+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+  if (cols === 0) return 0;
+
+  let srcCol = -1;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      srcCol = c;
+      break;
+    }
+  }
+  if (srcCol < 0) return 0;
+
+  const visited = new Set<string>();
+  visited.add(`0,${srcCol}`);
+
+  // BFS with direction: 0=down, 1=down-left, 2=down-right
+  const queue: Array<[number, number, number]> = [[0, srcCol, 0]];
+  let head = 0;
+
+  while (head < queue.length) {
+    const [r, c, dir] = queue[head++];
+
+    let nr: number, nc: number;
+    if (dir === 0) { nr = r + 1; nc = c; }
+    else if (dir === 1) { nr = r + 1; nc = c - 1; }
+    else { nr = r + 1; nc = c + 1; }
+
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;
+
+    visited.add(`${nr},${nc}`);
+
+    if (grid[nr][nc] === '^') {
+      queue.push([nr, nc, 1]);
+      queue.push([nr, nc, 2]);
+    } else {
+      queue.push([nr, nc, dir]);
+    }
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+  if (cols === 0) return 0n;
+
+  let srcCol = -1;
+  for (let c = 0; c < cols; c++) {
+    if (grid[0][c] === 'S') {
+      srcCol = c;
+      break;
+    }
+  }
+  if (srcCol < 0) return 0n;
+
+  let totalPaths = 0n;
+
+  // BFS with direction and count: 0=down, 1=down-left, 2=down-right
+  const queue: Array<[number, number, number, bigint]> = [[0, srcCol, 0, 1n]];
+  let head = 0;
+
+  while (head < queue.length) {
+    const [r, c, dir, count] = queue[head++];
+
+    let nr: number, nc: number;
+    if (dir === 0) { nr = r + 1; nc = c; }
+    else if (dir === 1) { nr = r + 1; nc = c - 1; }
+    else { nr = r + 1; nc = c + 1; }
+
+    if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+      totalPaths += count;
+      continue;
+    }
+
+    if (grid[nr][nc] === '^') {
+      queue.push([nr, nc, 1, count]);
+      queue.push([nr, nc, 2, count]);
+    } else {
+      queue.push([nr, nc, dir, count]);
+    }
+  }
+
+  return totalPaths;
+}
