+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentProcessedEvent, PaymentStatus, Events } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const transactions = new Map<string, { orderId: string; amount: number; status: PaymentStatus }>();
+
+  async function processPayment(orderId: string, amount: number): Promise<{ status: PaymentStatus; transactionId?: string; error?: string }> {
+    const txId = `tx_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
+
+    if (options.simulateTimeout) {
+      const result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+      bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.TIMEOUT, error: result.error } satisfies PaymentProcessedEvent);
+      return result;
+    }
+
+    if (options.simulateFailure) {
+      const result = { status: PaymentStatus.FAILED, error: 'Payment declined' };
+      bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.FAILED, error: result.error } satisfies PaymentProcessedEvent);
+      return result;
+    }
+
+    const result = { status: PaymentStatus.SUCCESS, transactionId: txId };
+    transactions.set(txId, { orderId, amount, status: PaymentStatus.SUCCESS });
+    bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: PaymentStatus.SUCCESS, transactionId: txId } satisfies PaymentProcessedEvent);
+    return result;
+  }
+
+  async function refund(transactionId: string): Promise<boolean> {
+    const tx = transactions.get(transactionId);
+    if (!tx) return false;
+    tx.status = PaymentStatus.FAILED;
+    return true;
+  }
+
+  return { processPayment, refund };
+}
