+import { EventBus } from '../bus.js';
+import { OrderService, OrderCreatedEvent, OrderStatusChangedEvent, OrderStatus, Events } from '../types.js';
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, { id: string; userId: string; cartId: string; status: OrderStatus; total: number }>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = `order_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
+      const order = { id, userId, cartId, status: OrderStatus.PENDING, total };
+      orders.set(id, order);
+      bus.emit(Events.ORDER_CREATED, { orderId: id, userId, cartId, total } satisfies OrderCreatedEvent);
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      const o = orders.get(orderId);
+      if (!o) return null;
+      return { id: o.id, userId: o.userId, status: o.status, total: o.total };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) return;
+      const previousStatus = order.status;
+      order.status = status;
+      bus.emit(Events.ORDER_STATUS_CHANGED, {
+        orderId,
+        status,
+        previousStatus,
+      } satisfies OrderStatusChangedEvent);
+    },
+
+    listOrders(userId: string) {
+      return Array.from(orders.values())
+        .filter(o => o.userId === userId)
+        .map(o => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
