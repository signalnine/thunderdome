+import { EventBus } from '../bus.js';
+import { NotificationService, OrderCreatedEvent, OrderStatusChangedEvent, PaymentProcessedEvent, Events } from '../types.js';
+
+export function createNotificationService(bus: EventBus): NotificationService {
+  const subscribers = new Set<string>();
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+  const orderUserMap = new Map<string, string>(); // orderId -> userId
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const p = payload as OrderCreatedEvent;
+    orderUserMap.set(p.orderId, p.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, async (payload: unknown) => {
+    const p = payload as OrderStatusChangedEvent;
+    const userId = orderUserMap.get(p.orderId);
+    if (userId && subscribers.has(userId)) {
+      const msg = `Order ${p.orderId} status changed from ${p.previousStatus} to ${p.status}`;
+      const notif = { type: 'order_status', message: msg, timestamp: Date.now() };
+      if (!notifications.has(userId)) notifications.set(userId, []);
+      notifications.get(userId)!.push(notif);
+      subscribers.add(userId);
+      bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'order_status', message: msg });
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, async (payload: unknown) => {
+    const p = payload as PaymentProcessedEvent;
+    const userId = orderUserMap.get(p.orderId);
+    if (userId && subscribers.has(userId)) {
+      const msg = `Payment ${p.status} for order ${p.orderId}`;
+      const notif = { type: 'payment', message: msg, timestamp: Date.now() };
+      if (!notifications.has(userId)) notifications.set(userId, []);
+      notifications.get(userId)!.push(notif);
+      subscribers.add(userId);
+      bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'payment', message: msg });
+    }
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+    },
+
+    getNotifications(userId: string) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
