+import { EventBus } from '../bus.js';
+import { OrderCreatedEvent, PaymentProcessedEvent, CartUpdatedEvent, AnalyticsEvent, Events, AnalyticsService } from '../types.js';
+import { PaymentStatus } from '../types.js';
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  let totalRevenue = 0;
+  const cartsCreated = new Set<string>();
+  const ordersCreated = new Set<string>();
+  const productOrderQuantities = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+
+  function trackEvent(eventType: string) {
+    eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+    bus.emit(Events.ANALYTICS_EVENT, { event: eventType, data: {}, timestamp: Date.now() } satisfies AnalyticsEvent);
+  }
+
+  bus.on(Events.PRODUCT_CREATED, () => {
+    trackEvent(Events.PRODUCT_CREATED);
+  });
+
+  bus.on(Events.CART_UPDATED, (payload: unknown) => {
+    trackEvent(Events.CART_UPDATED);
+    cartsCreated.add((payload as CartUpdatedEvent).cartId);
+    // Track product quantities for top products
+    for (const item of (payload as CartUpdatedEvent).items) {
+      productOrderQuantities.set(item.productId, (productOrderQuantities.get(item.productId) ?? 0) + item.quantity);
+    }
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    trackEvent(Events.ORDER_CREATED);
+    ordersCreated.add((payload as OrderCreatedEvent).orderId);
+    orderTotals.set((payload as OrderCreatedEvent).orderId, (payload as OrderCreatedEvent).total);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, () => {
+    trackEvent(Events.ORDER_STATUS_CHANGED);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    trackEvent(Events.PAYMENT_PROCESSED);
+    const p = payload as PaymentProcessedEvent;
+    if (p.status === PaymentStatus.SUCCESS) {
+      const orderTotal = orderTotals.get(p.orderId) ?? 0;
+      totalRevenue += orderTotal;
+    }
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return totalRevenue;
+    },
+
+    getConversionRate(): number {
+      if (cartsCreated.size === 0) return 0;
+      return ordersCreated.size / cartsCreated.size;
+    },
+
+    getTopProducts(limit: number): Array<{ productId: string; count: number }> {
+      const sorted = Array.from(productOrderQuantities.entries())
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, limit)
+        .map(([productId, count]) => ({ productId, count }));
+      return sorted;
+    },
+  };
+}
