+import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+interface StoredEntry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private filePath: string;
+  private entries: StoredEntry[];
+  private activeEntry: StoredEntry | null;
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = [];
+    this.activeEntry = null;
+    this.load();
+  }
+
+  private load(): void {
+    try {
+      if (existsSync(this.filePath)) {
+        const raw = readFileSync(this.filePath, 'utf-8');
+        const data = JSON.parse(raw);
+        if (Array.isArray(data)) {
+          this.entries = data;
+        }
+      }
+    } catch {
+      this.entries = [];
+    }
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify(this.entries), 'utf-8');
+  }
+
+  private now(): string {
+    return new Date().toISOString();
+  }
+
+  start(taskName: string): Entry {
+    if (!taskName || taskName.trim() === '') {
+      throw new Error('Task name cannot be empty');
+    }
+
+    if (this.activeEntry) {
+      this.activeEntry.endTime = this.now();
+      this.entries.push(this.activeEntry);
+      this.activeEntry = null;
+    }
+
+    const entry: StoredEntry = {
+      taskName,
+      startTime: this.now(),
+      endTime: null,
+    };
+
+    this.activeEntry = entry;
+    return { ...entry };
+  }
+
+  stop(): Entry {
+    if (!this.activeEntry) {
+      throw new Error('No active task to stop');
+    }
+
+    this.activeEntry.endTime = this.now();
+    const stopped = { ...this.activeEntry };
+    this.entries.push(this.activeEntry);
+    this.activeEntry = null;
+    this.save();
+    return stopped;
+  }
+
+  getActiveTask(): Entry | null {
+    if (this.activeEntry) {
+      return { ...this.activeEntry };
+    }
+    return null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    const all = [...this.entries];
+    if (this.activeEntry) {
+      all.push(this.activeEntry);
+    }
+
+    if (!options?.since) {
+      return all.map(e => ({ ...e }));
+    }
+
+    const sinceMs = options.since.getTime();
+    return all.filter(e => {
+      const startMs = new Date(e.startTime).getTime();
+      const endMs = e.endTime ? new Date(e.endTime).getTime() : null;
+
+      if (e.endTime === null) {
+        return true;
+      }
+
+      if (startMs >= sinceMs) {
+        return true;
+      }
+
+      if (endMs !== null && endMs >= sinceMs) {
+        return true;
+      }
+
+      return false;
+    }).map(e => ({ ...e }));
+  }
+
+  getSummary(): Record<string, number> {
+    const all = [...this.entries];
+    if (this.activeEntry) {
+      all.push(this.activeEntry);
+    }
+
+    const summary: Record<string, number> = {};
+
+    for (const entry of all) {
+      if (!summary[entry.taskName]) {
+        summary[entry.taskName] = 0;
+      }
+
+      let duration: number;
+      if (entry.endTime !== null) {
+        duration = new Date(entry.endTime).getTime() - new Date(entry.startTime).getTime();
+      } else {
+        duration = Date.now() - new Date(entry.startTime).getTime();
+      }
+
+      summary[entry.taskName] += duration;
+    }
+
+    return summary;
+  }
+}
