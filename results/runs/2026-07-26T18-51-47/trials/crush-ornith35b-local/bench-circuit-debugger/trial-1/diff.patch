+export interface Gate {
+  op: 'AND' | 'OR' | 'XOR';
+  in1: string;
+  in2: string;
+  out: string;
+}
+
+export function simulate(
+  gates: Gate[],
+  inputs: Record<string, number>,
+): Record<string, number> {
+  const wireValues = new Map<string, number>();
+  for (const [k, v] of Object.entries(inputs)) wireValues.set(k, v);
+
+  const outToGate = new Map<string, Gate>();
+  for (const g of gates) outToGate.set(g.out, g);
+
+  const fired = new Set<string>();
+  const ready: string[] = [];
+  for (const g of gates) {
+    if (wireValues.has(g.in1) && wireValues.has(g.in2)) ready.push(g.out);
+  }
+
+  while (ready.length > 0) {
+    const outWire = ready.shift()!;
+    if (fired.has(outWire)) continue;
+    fired.add(outWire);
+    const gate = outToGate.get(outWire)!;
+    const v1 = wireValues.get(gate.in1)!;
+    const v2 = wireValues.get(gate.in2)!;
+    let result: number = 0;
+    switch (gate.op) {
+      case 'AND': result = v1 & v2; break;
+      case 'OR': result = v1 | v2; break;
+      case 'XOR': result = v1 ^ v2; break;
+    }
+    wireValues.set(gate.out, result);
+    for (const g of gates) {
+      if (!fired.has(g.out) && wireValues.has(g.in1) && wireValues.has(g.in2)) {
+        ready.push(g.out);
+      }
+    }
+  }
+
+  const result: Record<string, number> = {};
+  for (const [k, v] of wireValues.entries()) result[k] = v;
+  return result;
+}
+
+function isXWire(n: string): boolean { return /^x\d{2}$/.test(n); }
+function isYWire(n: string): boolean { return /^y\d{2}$/.test(n); }
+function bitOf(n: string): number { return parseInt(n.slice(1), 10); }
+
+/**
+ * Determine if a wire name is a known internal wire (t, a, b, c, z prefix with 2-digit number).
+ */
+function wireBit(n: string): number {
+  const m = n.match(/[a-z](\d{2})$/);
+  return m ? parseInt(m[1], 10) : -1;
+}
+
+function classifyGate(g: Gate): { expected: string | null; role: string } {
+  const in1Prim = isXWire(g.in1) || isYWire(g.in1);
+  const in2Prim = isXWire(g.in2) || isYWire(g.in2);
+  const bothPrimary = in1Prim && in2Prim;
+  const bothSame = g.in1 === g.in2;
+
+  if (bothPrimary) {
+    const bit = Math.max(
+      isXWire(g.in1) ? bitOf(g.in1) : isYWire(g.in1) ? bitOf(g.in1) : -1,
+      isXWire(g.in2) ? bitOf(g.in2) : isYWire(g.in2) ? bitOf(g.in2) : -1,
+    );
+    if (bit === 0) {
+      if (g.op === 'XOR') return { expected: 'z00', role: 'bit0_xor' };
+      if (g.op === 'AND') return { expected: 'c00', role: 'bit0_and' };
+    } else {
+      if (g.op === 'XOR') return { expected: `t${String(bit).padStart(2, '0')}`, role: 'primary_xor' };
+      if (g.op === 'AND') return { expected: `a${String(bit).padStart(2, '0')}`, role: 'primary_and' };
+    }
+  }
+
+  if (bothSame) {
+    const carryBit = wireBit(g.in1);
+    if (carryBit >= 0) {
+      return { expected: `z${String(carryBit + 1).padStart(2, '0')}`, role: 'final_carry' };
+    }
+  }
+
+  if (!in1Prim && !in2Prim) {
+    const b1 = wireBit(g.in1);
+    const b2 = wireBit(g.in2);
+
+    if (g.op === 'XOR') {
+      const tBit = g.in1.startsWith('t') ? b1 : g.in2.startsWith('t') ? b2 : -1;
+      return { expected: `z${String(tBit >= 0 ? tBit : Math.max(b1, b2)).padStart(2, '0')}`, role: 'sum_xor' };
+    }
+
+    if (g.op === 'AND') {
+      const tBit = g.in1.startsWith('t') ? b1 : g.in2.startsWith('t') ? b2 : -1;
+      return { expected: `b${String(tBit >= 0 ? tBit : Math.max(b1, b2)).padStart(2, '0')}`, role: 'propagate_and' };
+    }
+
+    if (g.op === 'OR') {
+      const aBit = g.in1.startsWith('a') ? b1 : g.in2.startsWith('a') ? b2 : -1;
+      const bBit = g.in1.startsWith('b') ? b1 : g.in2.startsWith('b') ? b2 : -1;
+      const bit = aBit >= 0 ? aBit : bBit;
+      return { expected: `c${String(bit >= 0 ? bit : Math.max(b1, b2)).padStart(2, '0')}`, role: 'carry_or' };
+    }
+  }
+
+  return { expected: null, role: 'unknown' };
+}
+
+export function findSwappedWires(gates: Gate[]): string[] {
+  let maxBit = -1;
+  for (const g of gates) {
+    if (isXWire(g.in1) || isYWire(g.in1)) maxBit = Math.max(maxBit, bitOf(g.in1));
+    if (isXWire(g.in2) || isYWire(g.in2)) maxBit = Math.max(maxBit, bitOf(g.in2));
+  }
+
+  // Classify each gate and determine expected output name
+  const mismatches: { expected: string; actual: string }[] = [];
+
+  for (const g of gates) {
+    const { expected } = classifyGate(g);
+    if (expected && expected !== g.out) {
+      mismatches.push({ expected, actual: g.out });
+    }
+  }
+
+  // Match swap pairs: for each mismatched gate with expected=E, actual=A,
+  // find if there's another mismatched gate with expected=A, actual=E.
+  const actualToExpected = new Map<string, string>();
+  for (const m of mismatches) {
+    actualToExpected.set(m.actual, m.expected);
+  }
+
+  const swapped = new Set<string>();
+  for (const m of mismatches) {
+    const partnerExpected = actualToExpected.get(m.actual);
+    if (!partnerExpected) continue;
+    if (actualToExpected.get(partnerExpected) === m.actual) {
+      swapped.add(m.expected);
+      swapped.add(m.actual);
+    }
+  }
+
+  return Array.from(swapped).sort();
+}
