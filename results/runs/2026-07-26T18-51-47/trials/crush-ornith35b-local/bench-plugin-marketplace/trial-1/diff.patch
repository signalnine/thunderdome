@@ -0,0 +1,112 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  const insertStmt = db.prepare(
+    'INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt) VALUES (?, ?, ?, ?, ?, 0, ?)'
+  );
+  const getReviewsStmt = db.prepare('SELECT * FROM reviews WHERE pluginName = ? ORDER BY id');
+  const avgRatingStmt = db.prepare('SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0');
+  const flagReviewStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const getFlaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1 ORDER BY id');
+  const removeStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+  const getByUserStmt = db.prepare('SELECT * FROM reviews WHERE userId = ? ORDER BY id');
+  const countStmt = db.prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?');
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const result = insertStmt.run(
+        review.pluginName,
+        review.pluginVersion,
+        review.userId,
+        review.rating,
+        review.comment,
+        new Date().toISOString()
+      );
+      return {
+        id: Number(result.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        flagged: false,
+        createdAt: new Date().toISOString(),
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = getReviewsStmt.all(pluginName) as ReviewRow[];
+      return rows.map(row => deserializeRow(row));
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = avgRatingStmt.get(pluginName) as { avg: number | null };
+      if (row.avg === null || row.avg === undefined) return 0;
+      return Math.round(row.avg * 100) / 100;
+    },
+
+    flagReview(reviewId: number): void {
+      flagReviewStmt.run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = getFlaggedStmt.all() as ReviewRow[];
+      return rows.map(row => deserializeRow(row));
+    },
+
+    removeReview(reviewId: number): boolean {
+      const result = removeStmt.run(reviewId);
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = getByUserStmt.all(userId) as ReviewRow[];
+      return rows.map(row => deserializeRow(row));
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = countStmt.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+
+  function deserializeRow(row: ReviewRow): Review {
+    return {
+      id: row.id,
+      pluginName: row.pluginName,
+      pluginVersion: row.pluginVersion,
+      userId: row.userId,
+      rating: row.rating,
+      comment: row.comment,
+      flagged: Boolean(row.flagged),
+      createdAt: row.createdAt,
+    };
+  }
+}
