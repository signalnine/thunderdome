@@ -0,0 +1,123 @@
+import Database from 'better-sqlite3';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+}
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    )
+  `);
+
+  const stmt = db.prepare(
+    'INSERT INTO plugins (name, version, description, author, dependencies, entryPoint, permissions) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+  const getByNameAndVersion = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+  const listAll = db.prepare('SELECT * FROM plugins');
+  const search = db.prepare('SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ?');
+  const remove = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+  const listVersions = db.prepare('SELECT DISTINCT version FROM plugins WHERE name = ? ORDER BY version');
+  const update = db.prepare(
+    'UPDATE plugins SET description = ?, author = ?, dependencies = ?, entryPoint = ?, permissions = ? WHERE name = ? AND version = ?'
+  );
+
+  function serialize(obj: unknown): string {
+    return JSON.stringify(obj);
+  }
+
+  function deserialize(str: string): unknown {
+    return JSON.parse(str);
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      stmt.run(
+        manifest.name,
+        manifest.version,
+        manifest.description,
+        manifest.author,
+        serialize(manifest.dependencies),
+        manifest.entryPoint,
+        serialize(manifest.permissions)
+      );
+    },
+
+    get(name: string): PluginManifest | null {
+      // Return the latest version for the name
+      const rows = db.prepare('SELECT * FROM plugins WHERE name = ? ORDER BY version DESC LIMIT 1').all(name) as PluginRow[];
+      if (rows.length === 0) return null;
+      return deserializeRow(rows[0]);
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = getByNameAndVersion.get(name, version) as PluginRow | undefined;
+      if (!row) return null;
+      return deserializeRow(row);
+    },
+
+    list(): PluginManifest[] {
+      const rows = listAll.all() as PluginRow[];
+      return rows.map(deserializeRow);
+    },
+
+    search(query: string): PluginManifest[] {
+      const pattern = `%${query}%`;
+      const rows = search.all(pattern, pattern) as PluginRow[];
+      return rows.map(deserializeRow);
+    },
+
+    remove(name: string, version: string): boolean {
+      const result = remove.run(name, version);
+      return result.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = listVersions.all(name) as { version: string }[];
+      return rows.map(r => r.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const existing = getByNameAndVersion.get(name, version) as PluginRow | undefined;
+      if (!existing) return;
+
+      const description = updates.description !== undefined ? updates.description : existing.description;
+      const author = updates.author !== undefined ? updates.author : existing.author;
+      const entryPoint = updates.entryPoint !== undefined ? updates.entryPoint : existing.entryPoint;
+
+      const deps = updates.dependencies !== undefined ? serialize(updates.dependencies) : existing.dependencies;
+      const permissions = updates.permissions !== undefined ? serialize(updates.permissions) : existing.permissions;
+
+      update.run(description, author, deps, entryPoint, permissions, name, version);
+    },
+  };
+
+  function deserializeRow(row: PluginRow): PluginManifest {
+    return {
+      name: row.name,
+      version: row.version,
+      description: row.description,
+      author: row.author,
+      dependencies: deserialize(row.dependencies) as Record<string, string>,
+      entryPoint: row.entryPoint,
+      permissions: deserialize(row.permissions) as string[],
+    };
+  }
+}
