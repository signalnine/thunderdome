+import express, { Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { readFileSync } from 'fs';
+import { resolve } from 'path';
+import jwt from 'jsonwebtoken';
+import usersRouter from './users/router';
+import ingestRouter from './ingest/router';
+import queryRouter from './query/router';
+import dashboardsRouter from './dashboards/router';
+import exportRouter from './export/router';
+import { errorHandler } from './errors';
+import { AppError } from './errors';
+
+let db: Database.Database | null = null;
+
+export function setDb(database: Database.Database): void {
+  db = database;
+}
+
+export function getDb(): Database.Database {
+  if (!db) {
+    throw new Error('Database not initialized');
+  }
+  return db;
+}
+
+export function closeDb(): void {
+  if (db) {
+    db.close();
+    db = null;
+  }
+}
+
+export function createTestDb(): Database.Database {
+  const schema = readFileSync(resolve(__dirname, '..', 'schema.sql'), 'utf-8');
+  const database = new Database(':memory:');
+  database.exec(schema);
+  return database;
+}
+
+const JWT_SECRET = 'analytics-dashboard-secret-key';
+
+function authMiddleware(req: Request, _res: Response, next: (err?: Error) => void): void {
+  // If user is already set (e.g., by unit test mock auth), skip
+  if (req.user) {
+    next();
+    return;
+  }
+
+  try {
+    const authHeader = req.headers.authorization;
+    if (!authHeader || !authHeader.startsWith('Bearer ')) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication token');
+    }
+
+    const token = authHeader.slice(7);
+    const decoded = jwt.verify(token, JWT_SECRET) as {
+      sub: string;
+      tid: string;
+      role?: string;
+    };
+
+    req.user = {
+      id: decoded.sub,
+      tenantId: decoded.tid,
+      role: decoded.role,
+    };
+    next();
+  } catch (err) {
+    if (err instanceof AppError) {
+      next(err);
+    } else {
+      next(new AppError(401, 'AUTH_ERROR', 'Invalid or expired token'));
+    }
+  }
+}
+
+export function createApp() {
+  const app = express();
+  app.use(express.json());
+
+  // Apply auth middleware to all routes except /users (register/login are public)
+  app.use((req, res, next) => {
+    if (req.path.startsWith('/users') && (req.method === 'POST')) {
+      next();
+      return;
+    }
+    authMiddleware(req, res, next);
+  });
+
+  app.use('/users', usersRouter);
+  app.use('/events', ingestRouter);
+  app.use('/query', queryRouter);
+  app.use('/dashboards', dashboardsRouter);
+  app.use('/export', exportRouter);
+
+  app.use(errorHandler);
+
+  return app;
+}
