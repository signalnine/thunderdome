+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.post('/count', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { event_name, start, end } = req.body as {
+      event_name: string;
+      start?: string;
+      end?: string;
+    };
+
+    if (!event_name) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'event_name is required');
+    }
+
+    const db = getDb();
+    let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+    const params: unknown[] = [user.tenantId, event_name];
+
+    if (start) {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (end) {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    const result = db.prepare(sql).get(...params) as { count: number };
+
+    res.status(200).json({ count: result.count });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/timeseries', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { event_name, start, end, bucket } = req.body as {
+      event_name: string;
+      start?: string;
+      end?: string;
+      bucket?: string;
+    };
+
+    if (!event_name) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'event_name is required');
+    }
+
+    const db = getDb();
+    const b = bucket || 'day';
+
+    let dateFunc: string;
+    switch (b) {
+      case 'hour':
+        dateFunc = "strftime('%Y-%m-%dT%H:00:00', timestamp)";
+        break;
+      case 'week':
+        dateFunc = "strftime('%Y-W%W', timestamp)";
+        break;
+      case 'month':
+        dateFunc = "strftime('%Y-%m-01', timestamp)";
+        break;
+      case 'day':
+      default:
+        dateFunc = "strftime('%Y-%m-%d', timestamp)";
+        break;
+    }
+
+    let sql = `SELECT ${dateFunc} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+    const params: unknown[] = [user.tenantId, event_name];
+
+    if (start) {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (end) {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    sql += ` GROUP BY ${dateFunc} ORDER BY bucket`;
+
+    const rows = db.prepare(sql).all(...params) as Array<{ bucket: string; count: number }>;
+
+    res.status(200).json({ data: rows });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/breakdown', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { event_name, property_key, start, end } = req.body as {
+      event_name: string;
+      property_key: string;
+      start?: string;
+      end?: string;
+    };
+
+    if (!event_name) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'event_name is required');
+    }
+    if (!property_key) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'property_key is required');
+    }
+
+    const db = getDb();
+    let sql = `SELECT json_extract(properties, ?) as property_value, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+    const params: unknown[] = [`$.${property_key}`, user.tenantId, event_name];
+
+    if (start) {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (end) {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    sql += ` GROUP BY property_value HAVING property_value IS NOT NULL ORDER BY count DESC`;
+
+    const rows = db.prepare(sql).all(...params) as Array<{ property_value: string; count: number }>;
+
+    res.status(200).json({ data: rows });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/funnel', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { steps, start, end } = req.body as {
+      steps: string[];
+      start?: string;
+      end?: string;
+    };
+
+    if (!steps || steps.length === 0) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'steps array is required');
+    }
+
+    const db = getDb();
+
+    const funnelSteps = steps.map((eventName) => {
+      let sql = `SELECT COUNT(DISTINCT user_id) as count FROM events WHERE tenant_id = ? AND name = ?`;
+      const params: unknown[] = [user.tenantId, eventName];
+
+      if (start) {
+        sql += ' AND timestamp >= ?';
+        params.push(start);
+      }
+      if (end) {
+        sql += ' AND timestamp <= ?';
+        params.push(end);
+      }
+
+      const result = db.prepare(sql).get(...params) as { count: number };
+
+      return {
+        step: eventName,
+        count: result.count,
+      };
+    });
+
+    res.status(200).json({ steps: funnelSteps });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
