+
+    const id = uuidv4();
+
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(
+      id,
+      dashboardId,
+      type,
+      JSON.stringify(config || {}),
+      position_x || 0,
+      position_y || 0,
+      width || 1,
+      height || 1
+    );
+
+    const widget = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as Record<string, unknown>;
