+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import jwt from 'jsonwebtoken';
+import bcrypt from 'bcrypt';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const JWT_SECRET = 'analytics-dashboard-secret-key';
+const TOKEN_EXPIRY = '24h';
+
+export function requireAuth(
+  req: Request,
+  _res: Response,
+  next: (err?: Error) => void
+): void {
+  try {
+    const authHeader = req.headers.authorization;
+    if (!authHeader || !authHeader.startsWith('Bearer ')) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication token');
+    }
+
+    const token = authHeader.slice(7);
+    const decoded = jwt.verify(token, JWT_SECRET) as {
+      sub: string;
+      tid: string;
+      role?: string;
+    };
+
+    req.user = {
+      id: decoded.sub,
+      tenantId: decoded.tid,
+      role: decoded.role,
+    };
+    next();
+  } catch (err: unknown) {
+    if (err instanceof AppError) {
+      next(err as Error);
+    } else {
+      next(new AppError(401, 'AUTH_ERROR', 'Invalid or expired token'));
+    }
+  }
+}
+
+function hashPassword(password: string): string {
+  return bcrypt.hashSync(password, 10);
+}
+
+function comparePassword(password: string, hash: string): boolean {
+  return bcrypt.compareSync(password, hash);
+}
+
+function createUserToken(user: { id: string; tenant_id: string; role: string }): string {
+  return jwt.sign(
+    { sub: user.id, tid: user.tenant_id, role: user.role },
+    JWT_SECRET,
+    { expiresIn: TOKEN_EXPIRY }
+  );
+}
+
+const router = Router();
+
+// POST /users - Register
+router.post('/', (req: Request, res: Response, next: (err?: Error) => void) => {
+  try {
+    const { email, password, tenant_id } = req.body as {
+      email: string;
+      password: string;
+      tenant_id: string;
+    };
+
+    if (!email || !password || !tenant_id) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'email, password, and tenant_id are required');
+    }
+
+    const db = getDb();
+    const id = uuidv4();
+    const passwordHash = hashPassword(password);
+
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, email, passwordHash, tenant_id, 'viewer');
+
+    const user = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as Record<string, unknown>;
+
+    res.status(201).json({
+      id: user.id as string,
+      email: user.email as string,
+      tenant_id: user.tenant_id as string,
+      role: user.role as string,
+      created_at: user.created_at as string,
+    });
+  } catch (err: unknown) {
+    next(err as Error);
+  }
+});
+
+// POST /users/login
+router.post('/login', (req: Request, res: Response, next: (err?: Error) => void) => {
+  try {
+    const { email, password } = req.body as { email: string; password: string };
+
+    if (!email || !password) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'email and password are required');
+    }
+
+    const db = getDb();
+    const userRow = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as
+      | Record<string, unknown>
+      | undefined;
+
+    if (!userRow || !comparePassword(password, userRow.password_hash as string)) {
+      throw new AppError(401, 'AUTH_ERROR', 'Invalid email or password');
+    }
+
+    const token = createUserToken({
+      id: userRow.id as string,
+      tenant_id: userRow.tenant_id as string,
+      role: userRow.role as string,
+    });
+
+    res.status(200).json({
+      token,
+      user: {
+        id: userRow.id as string,
+        email: userRow.email as string,
+        tenant_id: userRow.tenant_id as string,
+        role: userRow.role as string,
+      },
+    });
+  } catch (err: unknown) {
+    next(err as Error);
+  }
+});
+
+// GET /users/me
+router.get('/me', (req: Request, res: Response, next: (err?: Error) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const db = getDb();
+    const userRow = db.prepare('SELECT * FROM users WHERE id = ?').get(user.id) as
+      | Record<string, unknown>
+      | undefined;
+
+    if (!userRow) {
+      throw new AppError(404, 'NOT_FOUND', 'User not found');
+    }
+
+    res.status(200).json({
+      id: userRow.id as string,
+      email: userRow.email as string,
+      tenant_id: userRow.tenant_id as string,
+      role: userRow.role as string,
+      created_at: userRow.created_at as string,
+    });
+  } catch (err: unknown) {
+    next(err as Error);
+  }
+});
+
+// PATCH /users/:id/role
+router.patch('/:id/role', (req: Request, res: Response, next: (err?: Error) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const db = getDb();
+    const authUserRow = db.prepare('SELECT role FROM users WHERE id = ?').get(user.id) as
+      | { role: string }
+      | undefined;
+
+    if (!authUserRow || authUserRow.role !== 'admin') {
+      throw new AppError(403, 'FORBIDDEN', 'Admin role required');
+    }
+
+    const { id } = req.params;
+    const { role } = req.body as { role: string };
+
+    if (!role || !['admin', 'editor', 'viewer'].includes(role)) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'Valid role required (admin, editor, viewer)');
+    }
+
+    const result = db
+      .prepare('UPDATE users SET role = ? WHERE id = ?')
+      .run(role, id);
+
+    if (result.changes === 0) {
+      throw new AppError(404, 'NOT_FOUND', 'User not found');
+    }
+
+    const userRow = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as Record<string, unknown>;
+
+    res.status(200).json({
+      id: userRow.id as string,
+      email: userRow.email as string,
+      tenant_id: userRow.tenant_id as string,
+      role: userRow.role as string,
+    });
+  } catch (err: unknown) {
+    next(err as Error);
+  }
+});
+
+// Handle unique constraint violation for duplicate email
+router.use((err: Error, _req: Request, res: Response, next: (err: Error) => void) => {
+  if (err.message && err.message.includes('UNIQUE constraint failed')) {
+    res.status(409).json({ error: 'Email already registered', code: 'DUPLICATE_EMAIL' });
+    return;
+  }
+  next(err);
+});
+
+export default router;
