+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.post('/', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { name, properties, timestamp, user_id, session_id } = req.body as {
+      name: string;
+      properties: Record<string, unknown>;
+      timestamp?: string;
+      user_id?: string;
+      session_id?: string;
+    };
+
+    if (!name) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'Event name is required');
+    }
+
+    const db = getDb();
+    const id = uuidv4();
+    const ts = timestamp || new Date().toISOString();
+
+    db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, user.tenantId, name, JSON.stringify(properties || {}), ts, user_id || null, session_id || null);
+
+    res.status(201).json({
+      id,
+      tenant_id: user.tenantId,
+      name,
+      properties: properties || {},
+      timestamp: ts,
+      user_id: user_id || null,
+      session_id: session_id || null,
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { events } = req.body as { events: Array<{ name: string; properties?: Record<string, unknown>; timestamp?: string }> };
+
+    if (!events || events.length === 0) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'Events array is required and cannot be empty');
+    }
+
+    const db = getDb();
+    const insert = db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    );
+
+    const insertedEvents = events.map((event) => {
+      if (!event.name) {
+        throw new AppError(400, 'VALIDATION_ERROR', 'Event name is required for each event');
+      }
+
+      const id = uuidv4();
+      const ts = event.timestamp || new Date().toISOString();
+
+      insert.run(id, user.tenantId, event.name, JSON.stringify(event.properties || {}), ts, null, null);
+
+      return {
+        id,
+        tenant_id: user.tenantId,
+        name: event.name,
+        properties: event.properties || {},
+        timestamp: ts,
+      };
+    });
+
+    res.status(201).json({
+      inserted: insertedEvents.length,
+      events: insertedEvents,
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
