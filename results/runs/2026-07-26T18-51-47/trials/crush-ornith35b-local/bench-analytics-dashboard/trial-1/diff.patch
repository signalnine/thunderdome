+
+    const db = getDb();
+    const dashboards = db.prepare(
+      'SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY updated_at DESC'
+    ).all(user.tenantId) as Record<string, unknown>[];
+
+    const result = dashboards.map((d) => ({
+      id: d.id as string,
+      tenant_id: d.tenant_id as string,
+      name: d.name as string,
+      owner_id: d.owner_id as string,
+      config: JSON.parse(d.config as string),
