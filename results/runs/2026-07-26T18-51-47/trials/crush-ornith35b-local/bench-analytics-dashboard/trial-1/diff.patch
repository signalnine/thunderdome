+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.get('/events', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { format } = req.query as { format?: string };
+
+    if (!format || !['csv', 'json'].includes(format)) {
+      throw new AppError(400, 'VALIDATION_ERROR', 'Format must be "csv" or "json"');
+    }
+
+    const db = getDb();
+    const events = db.prepare(
+      'SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp DESC'
+    ).all(user.tenantId) as Record<string, unknown>[];
+
+    if (format === 'csv') {
+      const header = 'id,tenant_id,name,properties,timestamp,user_id,session_id';
+      const rows = events.map((e) =>
+        `${e.id},${e.tenant_id},${e.name},${JSON.stringify(e.properties).replace(/"/g, '""')},${e.timestamp},${e.user_id || ''},${e.session_id || ''}`
+      );
+      const csv = [header, ...rows].join('\n');
+      res.setHeader('Content-Type', 'text/csv');
+      res.status(200).send(csv);
+    } else {
+      const result = events.map((e) => ({
+        id: e.id as string,
+        tenant_id: e.tenant_id as string,
+        name: e.name as string,
+        properties: JSON.parse(e.properties as string),
+        timestamp: e.timestamp as string,
+        user_id: e.user_id as string | null,
+        session_id: e.session_id as string | null,
+      }));
+      res.status(200).json(result);
+    }
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response, next: (err: unknown) => void) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new AppError(401, 'AUTH_ERROR', 'Missing authentication');
+    }
+
+    const { id } = req.params;
+    const db = getDb();
+
+    const dashboard = db.prepare(
+      'SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?'
+    ).get(id, user.tenantId) as Record<string, unknown> | undefined;
+
+    if (!dashboard) {
+      throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+    }
+
+    const widgets = db.prepare(
+      'SELECT * FROM widgets WHERE dashboard_id = ? ORDER BY position_y, position_x'
+    ).all(id) as Record<string, unknown>[];
+
+    res.status(200).json({
+      dashboard: {
+        id: dashboard.id as string,
+        tenant_id: dashboard.tenant_id as string,
+        name: dashboard.name as string,
+        owner_id: dashboard.owner_id as string,
+        config: JSON.parse(dashboard.config as string),
+        created_at: dashboard.created_at as string,
+        updated_at: dashboard.updated_at as string,
+      },
+      widgets: widgets.map((w) => ({
+        id: w.id as string,
+        dashboard_id: w.dashboard_id as string,
+        type: w.type as string,
+        config: JSON.parse(w.config as string),
+        position_x: w.position_x as number,
+        position_y: w.position_y as number,
+        width: w.width as number,
+        height: w.height as number,
+      })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
