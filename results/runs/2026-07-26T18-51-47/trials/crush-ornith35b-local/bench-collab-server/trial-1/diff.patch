+import { Router } from 'express';
+import Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+
+// We use crypto.randomUUID() instead of importing uuid
+
+export function createRoutes(db: Database.Database): Router {
+  const router = Router();
+
+  // POST /docs — create document
+  router.post('/docs', (req, res) => {
+    const { title, content = '' } = req.body as { title?: string; content?: string };
+    if (!title) {
+      return res.status(400).json({ error: 'title is required' });
+    }
+    const id = randomUUID();
+    db.prepare(
+      `INSERT INTO documents (id, title, content) VALUES (?, ?, ?)`
+    ).run(id, title, content);
+
+    // Create version 0
+    db.prepare(
+      `INSERT INTO versions (document_id, version, content) VALUES (?, 0, ?)`
+    ).run(id, content);
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as Record<string, unknown>;
+    return res.status(201).json({
+      id: doc.id,
+      title: doc.title,
+      content: doc.content,
+      created_at: doc.created_at,
+      updated_at: doc.updated_at,
+    });
+  });
+
+  // GET /docs — list all documents
+  router.get('/docs', (_req, res) => {
+    const docs = db.prepare(
+      `SELECT id, title, content, created_at, updated_at FROM documents ORDER BY created_at DESC`
+    ).all() as Record<string, unknown>[];
+    return res.status(200).json(docs);
+  });
+
+  // GET /docs/:id — get document
+  router.get('/docs/:id', (req, res) => {
+    const doc = db.prepare(
+      `SELECT id, title, content, created_at, updated_at FROM documents WHERE id = ?`
+    ).get(req.params.id) as Record<string, unknown> | undefined;
+    if (!doc) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    return res.status(200).json(doc);
+  });
+
+  // PUT /docs/:id — update document
+  router.put('/docs/:id', (req, res) => {
+    const { title, content } = req.body as { title?: string; content?: string };
+    const existing = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as Record<string, unknown> | undefined;
+    if (!existing) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+
+    const newTitle = title !== undefined ? title : existing.title;
+    const newContent = content !== undefined ? content : existing.content;
+
+    db.prepare(
+      `UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?`
+    ).run(newTitle, newContent, req.params.id);
+
+    // Record version
+    const currentVersion = db.prepare(
+      `SELECT COALESCE(MAX(version), -1) as maxVersion FROM versions WHERE document_id = ?`
+    ).get(req.params.id) as { maxVersion: number };
+    const newVersion = currentVersion.maxVersion + 1;
+
+    db.prepare(
+      `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`
+    ).run(req.params.id, newVersion, newContent, null);
+
+    const updated = db.prepare('SELECT id, title, content, created_at, updated_at FROM documents WHERE id = ?').get(req.params.id) as Record<string, unknown>;
+    return res.status(200).json({
+      id: updated.id,
+      title: updated.title,
+      content: updated.content,
+      created_at: updated.created_at,
+      updated_at: updated.updated_at,
+    });
+  });
+
+  // DELETE /docs/:id
+  router.delete('/docs/:id', (req, res) => {
+    const existing = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id) as Record<string, unknown> | undefined;
+    if (!existing) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);
+    return res.status(204).send();
+  });
+
+  // GET /docs/:id/versions — list version history
+  router.get('/docs/:id/versions', (req, res) => {
+    const existing = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id) as Record<string, unknown> | undefined;
+    if (!existing) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    const versions = db.prepare(
+      `SELECT version, content, operation, created_at FROM versions WHERE document_id = ? ORDER BY version ASC`
+    ).all(req.params.id) as Record<string, unknown>[];
+    return res.status(200).json(versions);
+  });
+
+  // GET /docs/:id/versions/:version — get specific version
+  router.get('/docs/:id/versions/:version', (req, res) => {
+    const existing = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id) as Record<string, unknown> | undefined;
+    if (!existing) {
+      return res.status(404).json({ error: 'Document not found' });
+    }
+    const versionNum = parseInt(req.params.version, 10);
+    const version = db.prepare(
+      `SELECT version, content, operation, created_at FROM versions WHERE document_id = ? AND version = ?`
+    ).get(req.params.id, versionNum) as Record<string, unknown> | undefined;
+    if (!version) {
+      return res.status(404).json({ error: 'Version not found' });
+    }
+    return res.status(200).json(version);
+  });
+
+  return router;
+}
