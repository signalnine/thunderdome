+import WebSocket, { WebSocketServer } from 'ws';
+import { Server as HttpServer } from 'node:http';
+import Database from 'better-sqlite3';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation } from './models.js';
+
+interface Room {
+  clients: Set<WebSocket>;
+  lock: Mutex;
+}
+
+class Mutex {
+  private queue: Array<() => void> = [];
+  private locked = false;
+
+  async acquire(): Promise<void> {
+    if (!this.locked) {
+      this.locked = true;
+      return;
+    }
+    await new Promise<void>((resolve) => {
+      this.queue.push(resolve);
+    });
+    this.locked = true;
+  }
+
+  release(): void {
+    this.locked = false;
+    const next = this.queue.shift();
+    if (next) {
+      next();
+    }
+  }
+}
+
+const rooms = new Map<string, Room>();
+
+export function setupWebSocket(server: HttpServer, db: Database.Database): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+
+  wss.on('connection', (ws: WebSocket, req: import('http').IncomingMessage) => {
+    // Extract document ID from URL path: /:docId
+    const url = req.url || '';
+    const docId = url.split('/')[1];
+
+    if (!docId) {
+      sendWs(ws, { type: 'error', message: 'Document ID is required' });
+      ws.close();
+      return;
+    }
+
+    // Validate document exists
+    const doc = db.prepare('SELECT id, content FROM documents WHERE id = ?').get(docId) as { id: string; content: string } | undefined;
+    if (!doc) {
+      sendWs(ws, { type: 'error', message: `Document '${docId}' not found` });
+      ws.close();
+      return;
+    }
+
+    // Get current version
+    const versionRow = db.prepare(
+      `SELECT COALESCE(MAX(version), 0) as maxVersion FROM versions WHERE document_id = ?`
+    ).get(docId) as { maxVersion: number };
+    const currentVersion = versionRow.maxVersion;
+
+    // Track connection
+    db.prepare(
+      `INSERT OR REPLACE INTO active_connections (id, document_id) VALUES (?, ?)`
+    ).run(docId, docId);
+
+    // Join room
+    if (!rooms.has(docId)) {
+      rooms.set(docId, { clients: new Set(), lock: new Mutex() });
+    }
+    const room = rooms.get(docId)!;
+    room.clients.add(ws);
+
+    // Send sync message
+    sendWs(ws, {
+      type: 'sync',
+      content: doc.content,
+      version: currentVersion,
+    });
+
+    ws.on('message', (data: WebSocket.Data) => {
+      let parsed: Record<string, unknown>;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        sendWs(ws, { type: 'error', message: 'Invalid JSON' });
+        return;
+      }
+
+      if (parsed.type !== 'operation') {
+        sendWs(ws, { type: 'error', message: 'Expected operation message' });
+        return;
+      }
+
+      const rawOp = parsed.operation as Record<string, unknown>;
+      if (!rawOp || typeof rawOp.type !== 'string') {
+        sendWs(ws, { type: 'error', message: 'Operation must have a type' });
+        return;
+      }
+
+      // Validate operation structure first (before locking)
+      if (rawOp.type !== 'insert' && rawOp.type !== 'delete') {
+        sendWs(ws, { type: 'error', message: `Invalid operation type: ${rawOp.type}` });
+        return;
+      }
+
+      const op = rawOp as unknown as Operation;
+
+      // Serialize operations per document via mutex
+      room.lock.acquire().then(async () => {
+        try {
+          // Re-read current doc state from DB (after lock)
+          const currentDoc = db.prepare('SELECT content FROM documents WHERE id = ?').get(docId) as { content: string } | undefined;
+          if (!currentDoc) {
+            sendWs(ws, { type: 'error', message: 'Document not found' });
+            return;
+          }
+
+          // Validate operation against current content
+          const validation = validateOperation(op, currentDoc.content.length);
+          if (!validation.valid) {
+            sendWs(ws, { type: 'error', message: validation.error });
+            return;
+          }
+
+          // If client sent a version, transform the operation against any concurrent changes
+          let effectiveOp = op;
+          if (parsed.version !== undefined && typeof parsed.version === 'number') {
+            const clientVersion = parsed.version;
+            const latestVersionRow = db.prepare(
+              `SELECT COALESCE(MAX(version), 0) as maxVersion FROM versions WHERE document_id = ?`
+            ).get(docId) as { maxVersion: number };
+
+            if (clientVersion < latestVersionRow.maxVersion) {
+              // There have been concurrent changes — transform
+              const ops = db.prepare(
+                `SELECT operation FROM versions WHERE document_id = ? AND version > ? ORDER BY version ASC`
+              ).all(docId, clientVersion) as { operation: string }[];
+
+              let transformedOp = op;
+              for (const row of ops) {
+                if (!row.operation) continue;
+                try {
+                  const priorOp = JSON.parse(row.operation) as Operation;
+                  transformedOp = transformOperation(transformedOp, priorOp);
+                } catch {
+                  // skip malformed ops
+                }
+              }
+              effectiveOp = transformedOp;
+
+              // Re-validate against current content length
+              const newValidation = validateOperation(effectiveOp, currentDoc.content.length);
+              if (!newValidation.valid) {
+                sendWs(ws, { type: 'error', message: newValidation.error });
+                return;
+              }
+            }
+          }
+
+          // Apply operation to current content
+          const newContent = applyOperation(currentDoc.content, effectiveOp);
+
+          // Update document in DB
+          db.prepare(
+            `UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?`
+          ).run(newContent, docId);
+
+          // Record version
+          const newVersionRow = db.prepare(
+            `SELECT COALESCE(MAX(version), -1) as maxVersion FROM versions WHERE document_id = ?`
+          ).get(docId) as { maxVersion: number };
+          const newVersion = newVersionRow.maxVersion + 1;
+
+          db.prepare(
+            `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`
+          ).run(docId, newVersion, newContent, JSON.stringify(effectiveOp));
+
+          // Acknowledge to sender
+          sendWs(ws, {
+            type: 'ack',
+            version: newVersion,
+          });
+
+          // Broadcast to all OTHER clients in the room
+          const broadcastMsg = JSON.stringify({
+            type: 'operation',
+            operation: effectiveOp,
+            version: newVersion,
+          });
+
+          for (const client of room.clients) {
+            if (client !== ws && client.readyState === WebSocket.OPEN) {
+              client.send(broadcastMsg);
+            }
+          }
+        } finally {
+          room.lock.release();
+        }
+      });
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      try {
+        db.prepare(`DELETE FROM active_connections WHERE id = ?`).run(docId);
+      } catch {
+        // ignore if db closed
+      }
+
+      // Clean up empty rooms
+      if (room.clients.size === 0) {
+        rooms.delete(docId);
+      }
+    });
+  });
+
+  return wss;
+}
+
+function sendWs(ws: WebSocket, msg: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(msg));
+  }
+}
