+import type { Operation } from './models.js';
+
+// ============================================================
+// applyOperation
+// ============================================================
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  if (op.type === 'delete') {
+    return content.slice(0, op.position) + content.slice(op.position + op.count);
+  }
+  return content;
+}
+
+// ============================================================
+// transformOperation — transform op1 so it can be applied after op2
+// op1 and op2 are both based on the same prior state.
+// Returns the transformed op1.
+// ============================================================
+
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    // If op1 is at or after op2's position, shift op1 forward by op2's text length
+    if (op1.position >= op2.position) {
+      return {
+        type: 'insert',
+        position: op1.position + op2.text.length,
+        text: op1.text,
+      };
+    }
+    return { ...op1 };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    if (op1.position > op2.position + op2.count) {
+      // op1 is after the deleted range, shift left
+      return {
+        type: 'insert',
+        position: op1.position - op2.count,
+        text: op1.text,
+      };
+    }
+    if (op1.position >= op2.position) {
+      // op1 is inside the deleted range — clamp to the start
+      return {
+        type: 'insert',
+        position: op2.position,
+        text: op1.text,
+      };
+    }
+    return { ...op1 };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    if (op1.position >= op2.position + op2.text.length) {
+      // op1 is after the insertion, shift right
+      return {
+        type: 'delete',
+        position: op1.position + op2.text.length,
+        count: op1.count,
+      };
+    }
+    if (op1.position >= op2.position) {
+      // op1 starts inside the inserted range — shift to end of insertion
+      return {
+        type: 'delete',
+        position: op2.position + op2.text.length,
+        count: op1.count,
+      };
+    }
+    return { ...op1 };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'delete') {
+    // Two deletes — handle overlapping ranges
+    const op1Start = op1.position;
+    const op1End = op1.position + op1.count;
+    const op2Start = op2.position;
+    const op2End = op2.position + op2.count;
+
+    if (op1End <= op2Start) {
+      // op1 is entirely before op2 — no change
+      return { ...op1 };
+    }
+    if (op1Start >= op2End) {
+      // op1 is entirely after op2 — shift left by op2's count
+      return {
+        type: 'delete',
+        position: op1.position - op2.count,
+        count: op1.count,
+      };
+    }
+
+    // Overlapping deletes
+    const newStart = Math.min(op1Start, op2Start);
+    const newEnd = Math.max(op1End, op2End);
+    return {
+      type: 'delete',
+      position: newStart,
+      count: newEnd - newStart,
+    };
+  }
+
+  return { ...op1 };
+}
+
+// ============================================================
+// validateOperation
+// ============================================================
+
+export function validateOperation(op: Operation, contentLength: number): { valid: boolean; error?: string } {
+  if (op.type === 'insert') {
+    if (op.position < 0 || op.position > contentLength) {
+      return { valid: false, error: `Insert position ${op.position} out of bounds [0, ${contentLength}]` };
+    }
+    return { valid: true };
+  }
+  if (op.type === 'delete') {
+    if (op.position < 0 || op.position >= contentLength) {
+      return { valid: false, error: `Delete position ${op.position} out of bounds` };
+    }
+    if (op.count <= 0) {
+      return { valid: false, error: 'Delete count must be positive' };
+    }
+    if (op.position + op.count > contentLength) {
+      return { valid: false, error: `Delete range [${op.position}, ${op.position + op.count}) exceeds content length ${contentLength}` };
+    }
+    return { valid: true };
+  }
+  return { valid: false, error: `Unknown operation type: ${(op as Operation).type}` };
+}
