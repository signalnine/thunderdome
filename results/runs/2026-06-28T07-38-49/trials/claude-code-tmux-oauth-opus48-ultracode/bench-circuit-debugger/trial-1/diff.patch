@@ -0,0 +1,77 @@
+import { Gate, Op } from './types.js';
+
+function apply(op: Op, a: number, b: number): number {
+  switch (op) {
+    case 'AND':
+      return a & b;
+    case 'OR':
+      return a | b;
+    case 'XOR':
+      return a ^ b;
+  }
+}
+
+/**
+ * Evaluate the circuit and return the value of every wire.
+ *
+ * Starts from the provided input wire values and fires gates as soon as both of
+ * their inputs are known, propagating values until no more gates can fire. The
+ * circuits are guaranteed acyclic, so every reachable gate eventually fires.
+ */
+export function simulate(gates: Gate[], inputs: Record<string, number>): Record<string, number> {
+  const values = new Map<string, number>();
+  for (const [wire, value] of Object.entries(inputs)) {
+    values.set(wire, value & 1);
+  }
+
+  // Index gates by each input wire so that resolving a wire only re-examines the
+  // gates that actually depend on it (rather than rescanning the whole list).
+  const dependents = new Map<string, number[]>();
+  const remaining = new Int8Array(gates.length); // unresolved input count per gate
+  const ready: number[] = [];
+
+  for (let i = 0; i < gates.length; i++) {
+    const g = gates[i];
+    let missing = 0;
+    if (!values.has(g.in1)) {
+      missing++;
+      addDependent(dependents, g.in1, i);
+    }
+    if (!values.has(g.in2)) {
+      missing++;
+      addDependent(dependents, g.in2, i);
+    }
+    remaining[i] = missing;
+    if (missing === 0) ready.push(i);
+  }
+
+  while (ready.length > 0) {
+    const i = ready.pop() as number;
+    const g = gates[i];
+    const a = values.get(g.in1) as number;
+    const b = values.get(g.in2) as number;
+    const result = apply(g.op, a, b);
+
+    // First writer wins: a wire keeps the value it was first given (an input
+    // seed, or its single driving gate). Well-formed circuits drive each wire
+    // exactly once, so this only disambiguates malformed inputs — and keeps the
+    // returned value consistent with what downstream gates actually consumed.
+    if (!values.has(g.out)) {
+      values.set(g.out, result);
+      const waiting = dependents.get(g.out);
+      if (waiting) {
+        for (const j of waiting) {
+          if (--remaining[j] === 0) ready.push(j);
+        }
+      }
+    }
+  }
+
+  return Object.fromEntries(values);
+}
+
+function addDependent(map: Map<string, number[]>, wire: string, gateIndex: number): void {
+  const list = map.get(wire);
+  if (list) list.push(gateIndex);
+  else map.set(wire, [gateIndex]);
+}
