@@ -0,0 +1,467 @@
+import { Gate, Op } from './types.js';
+
+/** Two-digit (or more) zero-padded bit index, matching wire names like `x07`. */
+function pad(i: number): string {
+  return i < 10 ? '0' + i : String(i);
+}
+
+/** Canonical key for a gate identity: its (unordered input pair, op). */
+function mkKey(a: string, b: string, op: Op): string {
+  return a < b ? `${a} ${b} ${op}` : `${b} ${a} ${op}`;
+}
+
+interface Layout {
+  /** Number of addend bits (indices 0..N-1); the final carry is z(N). */
+  n: number;
+  /** Highest-indexed z wire, e.g. `z45` — the final carry output. */
+  topZ: string;
+}
+
+function detectLayout(gates: Gate[]): Layout {
+  let maxZ = -1;
+  let maxX = -1;
+  for (const g of gates) {
+    for (const w of [g.in1, g.in2, g.out]) {
+      const z = /^z(\d+)$/.exec(w);
+      if (z) maxZ = Math.max(maxZ, Number(z[1]));
+      const x = /^x(\d+)$/.exec(w);
+      if (x) maxX = Math.max(maxX, Number(x[1]));
+    }
+  }
+  // The final z bit is the carry out of the top addend bit: maxZ == addend bits.
+  // Fall back to the x register width if z naming is unexpectedly sparse.
+  const n = maxZ >= 0 ? maxZ : maxX + 1;
+  return { n, topZ: 'z' + pad(n) };
+}
+
+interface ForwardResult {
+  /** Lowest bit index that fails to match the adder template (n => all bits matched). */
+  bits: number;
+  /** Whether the whole circuit is a structurally correct ripple-carry adder. */
+  valid: boolean;
+  /** The carry wire flowing into the failing bit (undefined at bit 0). */
+  carry: string | undefined;
+}
+
+/**
+ * Walk the ripple-carry adder template bit by bit, looking each expected gate up
+ * by its (inputs, op) — which swaps never alter, since only output names move.
+ * Stops at the first bit whose wiring does not match the template.
+ */
+function forwardConstruct(byKey: Map<string, string>, layout: Layout): ForwardResult {
+  const { n, topZ } = layout;
+
+  // Bit 0 is a half adder: z00 = x00 ^ y00, carry = x00 & y00.
+  if (byKey.get(mkKey('x00', 'y00', 'XOR')) !== 'z00') {
+    return { bits: 0, valid: false, carry: undefined };
+  }
+  let carry = byKey.get(mkKey('x00', 'y00', 'AND'));
+  if (carry === undefined) return { bits: 0, valid: false, carry: undefined };
+
+  for (let i = 1; i < n; i++) {
+    const xi = 'x' + pad(i);
+    const yi = 'y' + pad(i);
+    const zi = 'z' + pad(i);
+
+    const m = byKey.get(mkKey(xi, yi, 'XOR')); // partial sum  (t_i)
+    if (m === undefined) return { bits: i, valid: false, carry };
+    const g = byKey.get(mkKey(xi, yi, 'AND')); // generate     (a_i)
+    if (g === undefined) return { bits: i, valid: false, carry };
+
+    const sum = byKey.get(mkKey(m, carry, 'XOR')); // final sum -> z_i
+    if (sum !== zi) return { bits: i, valid: false, carry };
+    const prop = byKey.get(mkKey(m, carry, 'AND')); // propagate (b_i)
+    if (prop === undefined) return { bits: i, valid: false, carry };
+
+    const nextCarry = byKey.get(mkKey(g, prop, 'OR')); // carry out (c_i)
+    if (nextCarry === undefined) return { bits: i, valid: false, carry };
+    carry = nextCarry;
+  }
+
+  // The carry out of the top addend bit must be the most significant output bit.
+  if (carry !== topZ) return { bits: n, valid: false, carry };
+  return { bits: n, valid: true, carry };
+}
+
+function buildByKey(gates: Gate[], keys: string[]): Map<string, string> {
+  const m = new Map<string, string>();
+  for (let i = 0; i < gates.length; i++) m.set(keys[i], gates[i].out);
+  return m;
+}
+
+function buildOutIndex(gates: Gate[]): Map<string, number> {
+  const m = new Map<string, number>();
+  for (let i = 0; i < gates.length; i++) m.set(gates[i].out, i);
+  return m;
+}
+
+function buildConsumers(gates: Gate[]): Map<string, number[]> {
+  const m = new Map<string, number[]>();
+  for (let i = 0; i < gates.length; i++) {
+    for (const w of [gates[i].in1, gates[i].in2]) {
+      const list = m.get(w);
+      if (list) list.push(i);
+      else m.set(w, [i]);
+    }
+  }
+  return m;
+}
+
+/**
+ * Gates whose output wire participates in the computation around `bit`. One of
+ * the two wires of any swap that must be undone to fix `bit` always lands here.
+ */
+function candidatesAt(
+  bit: number,
+  carry: string | undefined,
+  layout: Layout,
+  byKey: Map<string, string>,
+  outIndex: Map<string, number>,
+  consumers: Map<string, number[]>,
+  used: Set<number>,
+): number[] {
+  const out = new Set<number>();
+  const addByOut = (wire: string | undefined) => {
+    if (wire === undefined) return;
+    const idx = outIndex.get(wire);
+    if (idx !== undefined) out.add(idx);
+  };
+  const addConsumers = (wire: string | undefined) => {
+    if (wire === undefined) return;
+    const list = consumers.get(wire);
+    if (list) for (const idx of list) out.add(idx);
+  };
+
+  if (bit < layout.n) {
+    const xi = 'x' + pad(bit);
+    const yi = 'y' + pad(bit);
+    addByOut('z' + pad(bit)); // whoever currently drives z_bit
+    const m = byKey.get(mkKey(xi, yi, 'XOR'));
+    const g = byKey.get(mkKey(xi, yi, 'AND'));
+    addByOut(m); // partial-sum gate
+    addByOut(g); // generate gate
+    addConsumers(m); // gates fed by the partial sum
+    addConsumers(g); // gates fed by the generate term
+    if (carry !== undefined) {
+      addByOut(carry); // gate that produced the incoming carry
+      addConsumers(carry); // gates fed by the incoming carry
+      if (m !== undefined) {
+        addByOut(byKey.get(mkKey(m, carry, 'XOR')));
+        addByOut(byKey.get(mkKey(m, carry, 'AND')));
+      }
+    }
+  } else {
+    // Final carry didn't reach the top output bit.
+    addByOut(layout.topZ);
+    addByOut(carry);
+    addConsumers(carry);
+  }
+
+  const result: number[] = [];
+  for (const idx of out) if (!used.has(idx)) result.push(idx);
+  return result;
+}
+
+/**
+ * Gates within `hops` producer/consumer steps of any gate in `seed`. Bounds the
+ * partner pool for tangled swaps to the neighbourhood of the failing bit.
+ */
+function expandPool(
+  seed: Iterable<number>,
+  gates: Gate[],
+  outIndex: Map<string, number>,
+  consumers: Map<string, number[]>,
+  hops: number,
+): Set<number> {
+  const pool = new Set<number>(seed);
+  let frontier = [...pool];
+  for (let h = 0; h < hops && frontier.length > 0; h++) {
+    const next: number[] = [];
+    for (const idx of frontier) {
+      const g = gates[idx];
+      for (const w of [g.in1, g.in2]) {
+        const p = outIndex.get(w);
+        if (p !== undefined && !pool.has(p)) {
+          pool.add(p);
+          next.push(p);
+        }
+      }
+      const cs = consumers.get(g.out);
+      if (cs) {
+        for (const c of cs) {
+          if (!pool.has(c)) {
+            pool.add(c);
+            next.push(c);
+          }
+        }
+      }
+    }
+    frontier = next;
+  }
+  return pool;
+}
+
+/** True iff the gates form a correct ripple-carry adder for X + Y = Z. */
+export function isValidAdder(gates: Gate[]): boolean {
+  const layout = detectLayout(gates);
+  return forwardConstruct(buildByKey(gates, gates.map((g) => mkKey(g.in1, g.in2, g.op))), layout)
+    .valid;
+}
+
+const MAX_SWAPS = 4;
+const POOL_HOPS = 4; // partner-pool radius for two-swap fixes on large circuits
+// At or below this gate count the second swap of a two-swap fix may pair with any
+// gate (~20 addend bits); above it, four swaps stay shallow and a local pool suffices.
+// Two-swap second-partner scope is "all gates" only inside this gate-count band:
+// above SMALL_CIRCUIT (tiny ones use the exhaustive fallback) and at/below
+// DENSE_CIRCUIT (~20 addend bits; larger ones never tangle that deep).
+const SMALL_CIRCUIT = 24;
+const DENSE_CIRCUIT = 100;
+// Wall-clock caps (ms from start). The guided search yields at the soft cap so the
+// exhaustive fallback still has a window; the hard cap keeps us under the 5 s budget.
+const SOFT_DEADLINE_MS = 3500;
+const HARD_DEADLINE_MS = 4500;
+
+interface SearchCtx {
+  gates: Gate[];
+  keys: string[];
+  layout: Layout;
+  consumers: Map<string, number[]>;
+  deadline: number; // soft cap for the guided search
+  hardDeadline: number; // cap for the exhaustive fallback
+}
+
+/** Swap two gates' outputs; returns the two wire names exchanged. */
+function applySwap(gates: Gate[], i: number, j: number): [string, string] {
+  const a = gates[i].out;
+  const b = gates[j].out;
+  gates[i].out = b;
+  gates[j].out = a;
+  return [a, b];
+}
+
+function undoSwap(gates: Gate[], i: number, j: number): void {
+  const a = gates[i].out;
+  gates[i].out = gates[j].out;
+  gates[j].out = a;
+}
+
+/**
+ * Find the 8 wire names involved in the 4 output-wire swaps that corrupt the
+ * adder. Returns them sorted.
+ *
+ * Strategy: locate the lowest bit where the ripple-carry template breaks, then
+ * repair that bit with the smallest set of output-wire swaps that pushes the
+ * boundary higher — a single swap for the common (well-separated) case, or two
+ * swaps committed atomically when several swaps collide on one bit. Recurse until
+ * the whole circuit matches a correct adder. A wall-clock deadline plus an
+ * exhaustive small-circuit fallback bound the worst case.
+ */
+export function findSwappedWires(gates: Gate[]): string[] {
+  const layout = detectLayout(gates);
+  // Inputs and ops never change under a swap, so each gate's identity key is fixed.
+  const keys = gates.map((g) => mkKey(g.in1, g.in2, g.op));
+  // Consumers depend only on inputs, which swaps never touch — compute once.
+  const consumers = buildConsumers(gates);
+
+  const start = Date.now();
+  const ctx: SearchCtx = {
+    gates,
+    keys,
+    layout,
+    consumers,
+    deadline: start + SOFT_DEADLINE_MS,
+    hardDeadline: start + HARD_DEADLINE_MS,
+  };
+
+  let solution = solve(ctx, MAX_SWAPS, new Set<number>());
+  if (solution === null) solution = bruteForce(ctx);
+  if (solution === null) {
+    throw new Error('No set of 4 swaps produces a valid adder');
+  }
+  return [...solution].sort();
+}
+
+function solve(ctx: SearchCtx, swapsLeft: number, used: Set<number>): string[] | null {
+  const { gates, keys, layout, consumers } = ctx;
+
+  const byKey = buildByKey(gates, keys);
+  const fc = forwardConstruct(byKey, layout);
+  if (fc.valid) return [];
+  if (swapsLeft === 0 || Date.now() > ctx.deadline) return null;
+
+  const outIndex = buildOutIndex(gates);
+  const cone = candidatesAt(fc.bits, fc.carry, layout, byKey, outIndex, consumers, used);
+  const total = gates.length;
+
+  // --- One-swap fixes: a single swap that advances the broken-bit boundary. ---
+  // The near end is in the failing bit's cone; the far end may be any gate.
+  const singles: { i: number; j: number; score: number }[] = [];
+  const seen = new Set<number>();
+  for (const i of cone) {
+    for (let j = 0; j < total; j++) {
+      if (j === i || used.has(j) || keys[j] === keys[i]) continue;
+      const k = i < j ? i * total + j : j * total + i;
+      if (seen.has(k)) continue;
+      seen.add(k);
+
+      const [a, b] = applySwap(gates, i, j);
+      byKey.set(keys[i], b);
+      byKey.set(keys[j], a);
+      const trial = forwardConstruct(byKey, layout);
+      byKey.set(keys[i], a);
+      byKey.set(keys[j], b);
+      undoSwap(gates, i, j);
+
+      if (trial.valid) singles.push({ i, j, score: Number.POSITIVE_INFINITY });
+      else if (trial.bits > fc.bits) singles.push({ i, j, score: trial.bits });
+    }
+  }
+  singles.sort((x, y) => y.score - x.score);
+
+  for (const { i, j } of singles) {
+    if (Date.now() > ctx.deadline) return null;
+    const [a, b] = applySwap(gates, i, j);
+    used.add(i);
+    used.add(j);
+    const rest = solve(ctx, swapsLeft - 1, used);
+    used.delete(i);
+    used.delete(j);
+    undoSwap(gates, i, j);
+    if (rest !== null) return [...rest, a, b];
+  }
+
+  // --- Two-swap fixes: needed when swaps tangle on the same bit, so no single
+  // swap advances. The first swap is "neutral" (keeps the broken-bit boundary
+  // exactly where it is) and its far partner may be any gate — a tangling swap
+  // can pair, e.g., this bit's generate term with a distant bit's. The second
+  // swap then advances the boundary, and its partner is local to the bit. Both
+  // are committed atomically. (Improving first swaps are already covered by the
+  // single-swap recursion above, so only neutral ones are tried here.) ---
+  if (swapsLeft >= 2) {
+    // The second swap's far partner. On mid-sized circuits it ranges over every
+    // gate, which makes the two-swap search complete for "both ends distant"
+    // tangles. The tiniest circuits fall back to the exhaustive bruteForce()
+    // instead (scanning all gates there explodes the neutral-first recursion),
+    // and the largest never tangle deep enough to need more than a local pool.
+    let secondPartners: number[];
+    if (total > SMALL_CIRCUIT && total <= DENSE_CIRCUIT) {
+      secondPartners = [];
+      for (let j = 0; j < total; j++) secondPartners.push(j);
+    } else {
+      secondPartners = [...expandPool(cone, gates, outIndex, consumers, POOL_HOPS)];
+    }
+
+    for (const i1 of cone) {
+      for (let j1 = 0; j1 < total; j1++) {
+        if (j1 === i1 || used.has(j1) || keys[j1] === keys[i1]) continue;
+        if (Date.now() > ctx.deadline) return null;
+
+        const [a1, b1] = applySwap(gates, i1, j1);
+        const byKey1 = buildByKey(gates, keys);
+        const fc1 = forwardConstruct(byKey1, layout);
+        if (fc1.bits !== fc.bits) {
+          undoSwap(gates, i1, j1);
+          continue; // keep only neutral first swaps (regressions and advances handled elsewhere)
+        }
+        used.add(i1);
+        used.add(j1);
+
+        const outIndex1 = buildOutIndex(gates);
+        const cone1 = candidatesAt(fc1.bits, fc1.carry, layout, byKey1, outIndex1, consumers, used);
+
+        let committed: string[] | null = null;
+        outer: for (const i2 of cone1) {
+          for (const j2 of secondPartners) {
+            if (j2 === i2 || used.has(j2) || keys[j2] === keys[i2]) continue;
+            const [a2, b2] = applySwap(gates, i2, j2);
+            byKey1.set(keys[i2], b2); // gate i2 now drives j2's old wire
+            byKey1.set(keys[j2], a2); // gate j2 now drives i2's old wire
+            const trial = forwardConstruct(byKey1, layout);
+            // restore byKey1 to its pre-swap2 state for the next probe
+            byKey1.set(keys[i2], a2);
+            byKey1.set(keys[j2], b2);
+
+            if (trial.valid || trial.bits > fc.bits) {
+              used.add(i2);
+              used.add(j2);
+              const rest = solve(ctx, swapsLeft - 2, used);
+              used.delete(i2);
+              used.delete(j2);
+              if (rest !== null) {
+                committed = [...rest, a1, b1, a2, b2];
+                undoSwap(gates, i2, j2);
+                break outer;
+              }
+            }
+            undoSwap(gates, i2, j2);
+            if (Date.now() > ctx.deadline) break outer;
+          }
+        }
+
+        used.delete(i1);
+        used.delete(j1);
+        undoSwap(gates, i1, j1);
+        if (committed !== null) return committed;
+      }
+    }
+  }
+
+  return null;
+}
+
+/**
+ * Exhaustive fallback for the rare densely-tangled small circuit the guided
+ * search can't crack within the deadline. Enumerates 4 disjoint output-wire
+ * swaps until one yields a valid adder. Restricted to small gate counts, which
+ * is exactly where dense tangling occurs.
+ */
+function bruteForce(ctx: SearchCtx): string[] | null {
+  const { gates, keys, layout } = ctx;
+  const n = gates.length;
+  if (n > 18) return null; // ~4 addend bits; beyond this the enumeration is infeasible in time
+
+  // Maintain byKey incrementally as swaps are applied/undone — only two entries
+  // change per swap — so each leaf check is a single O(gates) template walk.
+  const byKey = buildByKey(gates, keys);
+  const used = new Array<boolean>(n).fill(false);
+  const chosen: [number, number][] = [];
+  let checks = 0;
+
+  const rec = (start: number, depth: number): string[] | null => {
+    if (depth === MAX_SWAPS) {
+      if (forwardConstruct(byKey, layout).valid) {
+        const wires: string[] = [];
+        for (const [i, j] of chosen) wires.push(gates[i].out, gates[j].out);
+        return wires;
+      }
+      return null;
+    }
+    if ((++checks & 0x3fff) === 0 && Date.now() > ctx.hardDeadline) return null;
+    for (let i = start; i < n; i++) {
+      if (used[i]) continue;
+      used[i] = true;
+      for (let j = i + 1; j < n; j++) {
+        if (used[j]) continue;
+        applySwap(gates, i, j);
+        byKey.set(keys[i], gates[i].out);
+        byKey.set(keys[j], gates[j].out);
+        used[j] = true;
+        chosen.push([i, j]);
+
+        const res = rec(i + 1, depth + 1);
+
+        chosen.pop();
+        used[j] = false;
+        undoSwap(gates, i, j);
+        byKey.set(keys[i], gates[i].out);
+        byKey.set(keys[j], gates[j].out);
+        if (res !== null) return res;
+      }
+      used[i] = false;
+    }
+    return null;
+  };
+
+  return rec(0, 0);
+}
