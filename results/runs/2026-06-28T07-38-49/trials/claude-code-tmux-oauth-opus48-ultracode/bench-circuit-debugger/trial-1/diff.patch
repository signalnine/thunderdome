+import type { Gate, Op } from '../src/types.js';
+
+/** Deterministic PRNG (mulberry32) so generated cases are reproducible. */
+export function rng(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function pad(i: number): string {
+  return i < 10 ? '0' + i : String(i);
+}
+
+export interface GeneratedAdder {
+  gates: Gate[];
+  n: number; // addend bit width
+}
+
+/**
+ * Build a correct N-bit ripple-carry adder with randomly named intermediate
+ * wires (the x/y/z wires keep their canonical names).
+ */
+export function makeAdder(n: number, rand: () => number): GeneratedAdder {
+  const used = new Set<string>();
+  for (let i = 0; i <= n; i++) {
+    used.add('x' + pad(i));
+    used.add('y' + pad(i));
+    used.add('z' + pad(i));
+  }
+  const name = (): string => {
+    for (;;) {
+      let s = '';
+      for (let k = 0; k < 3; k++) s += String.fromCharCode(97 + Math.floor(rand() * 26));
+      if (!used.has(s)) {
+        used.add(s);
+        return s;
+      }
+    }
+  };
+
+  const gates: Gate[] = [];
+  const add = (op: Op, in1: string, in2: string, out: string) => gates.push({ op, in1, in2, out });
+
+  // Bit 0: half adder.
+  add('XOR', 'x00', 'y00', 'z00');
+  let carry = name();
+  add('AND', 'x00', 'y00', carry);
+
+  for (let i = 1; i < n; i++) {
+    const xi = 'x' + pad(i);
+    const yi = 'y' + pad(i);
+    const t = name();
+    const a = name();
+    const b = name();
+    add('XOR', xi, yi, t);
+    add('AND', xi, yi, a);
+    add('XOR', t, carry, 'z' + pad(i));
+    add('AND', t, carry, b);
+    const c = i === n - 1 ? 'z' + pad(n) : name();
+    add('OR', a, b, c);
+    carry = c;
+  }
+
+  return { gates, n };
+}
+
+/** Deep copy so callers can mutate freely. */
+export function cloneGates(gates: Gate[]): Gate[] {
+  return gates.map((g) => ({ ...g }));
+}
+
+import { simulate } from '../src/simulate.js';
+
+/** Run all gates from all-zero inputs; true iff every z wire resolves (i.e. acyclic). */
+export function isAcyclicComplete(gates: Gate[], n: number): boolean {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < n; i++) {
+    inputs['x' + pad(i)] = 0;
+    inputs['y' + pad(i)] = 0;
+  }
+  const values = simulate(gates, inputs);
+  for (let i = 0; i <= n; i++) {
+    if (!(('z' + pad(i)) in values)) return false;
+  }
+  return true;
+}
+
+export function readZ(values: Record<string, number>, n: number): bigint {
+  let z = 0n;
+  for (let i = n; i >= 0; i--) {
+    z = (z << 1n) | BigInt(values['z' + pad(i)] ?? 0);
+  }
+  return z;
+}
+
+export function setXY(x: bigint, y: bigint, n: number): Record<string, number> {
+  const inputs: Record<string, number> = {};
+  for (let i = 0; i < n; i++) {
+    inputs['x' + pad(i)] = Number((x >> BigInt(i)) & 1n);
+    inputs['y' + pad(i)] = Number((y >> BigInt(i)) & 1n);
+  }
+  return inputs;
+}
+
+export const padIdx = pad;
