+import { describe, it, expect } from 'vitest';
+import { simulate, findSwappedWires, isValidAdder, type Gate } from '../src/index.js';
+import {
+  rng,
+  makeAdder,
+  cloneGates,
+  isAcyclicComplete,
+  readZ,
+  setXY,
+  padIdx as pad,
+} from './adder-gen.js';
+
+function swapOut(gates: Gate[], i: number, j: number): void {
+  const t = gates[i].out;
+  gates[i].out = gates[j].out;
+  gates[j].out = t;
+}
+
+// --- planters --------------------------------------------------------------
+
+/** Gate index for a role within bit `b` of a circuit built by makeAdder. */
+function roleIndex(b: number, role: 'partial' | 'gen' | 'sum' | 'prop' | 'carry'): number {
+  const base = 2 + (b - 1) * 5; // bit 0 occupies indices 0,1
+  return { partial: base, gen: base + 1, sum: base + 2, prop: base + 3, carry: base + 4 }[role];
+}
+
+/**
+ * Plant 4 swaps in well-separated bit regions — the convention real adder
+ * puzzles follow. Each swap is a detectable, acyclic, within-bit exchange, and
+ * the regions are spaced apart so the instance is uniquely recoverable. Requires
+ * n >= 12. Returns the broken gates and the sorted 8 wire names.
+ */
+function plantSeparated(correct: Gate[], n: number, rand: () => number) {
+  const gap = Math.floor((n - 2) / 3);
+  if (gap < 3) throw new Error('plantSeparated needs n >= 11');
+  const anchors = [1, 1 + gap, 1 + 2 * gap, 1 + 3 * gap].filter((b) => b <= n - 1);
+  // Detectable, acyclic, within-bit swap kinds (gen<->prop is benign; partial<->prop cycles).
+  const kinds: [Parameters<typeof roleIndex>[1], Parameters<typeof roleIndex>[1]][] = [
+    ['sum', 'gen'],
+    ['sum', 'prop'],
+    ['partial', 'gen'],
+  ];
+
+  const broken = cloneGates(correct);
+  const wires: string[] = [];
+  for (const b of anchors) {
+    const [r1, r2] = kinds[Math.floor(rand() * kinds.length)];
+    const i = roleIndex(b, r1);
+    const j = roleIndex(b, r2);
+    wires.push(correct[i].out, correct[j].out);
+    swapOut(broken, i, j);
+  }
+  return { broken, wires: wires.sort() };
+}
+
+/** Plant up to 4 random disjoint, individually-active, acyclic swaps. */
+function plantRandom(correct: Gate[], n: number, rand: () => number, count = 4) {
+  const used = new Set<number>();
+  const pairs: [number, number][] = [];
+  let attempts = 0;
+  while (pairs.length < count && attempts < 5000) {
+    attempts++;
+    const i = Math.floor(rand() * correct.length);
+    const j = Math.floor(rand() * correct.length);
+    if (i === j || used.has(i) || used.has(j)) continue;
+    const test = cloneGates(correct);
+    swapOut(test, i, j);
+    if (isValidAdder(test)) continue;
+    if (!isAcyclicComplete(test, n)) continue;
+    pairs.push([i, j]);
+    used.add(i);
+    used.add(j);
+  }
+  if (pairs.length < count) return null;
+  const broken = cloneGates(correct);
+  for (const [i, j] of pairs) swapOut(broken, i, j);
+  if (!isAcyclicComplete(broken, n) || isValidAdder(broken)) return null;
+  const wires: string[] = [];
+  for (const [i, j] of pairs) wires.push(correct[i].out, correct[j].out);
+  return { broken, wires: wires.sort() };
+}
+
+// --- simulate --------------------------------------------------------------
+
+describe('simulate', () => {
+  it('applies the three gate ops', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'a', in2: 'b', out: 'and' },
+      { op: 'OR', in1: 'a', in2: 'b', out: 'or' },
+      { op: 'XOR', in1: 'a', in2: 'b', out: 'xor' },
+    ];
+    expect(simulate(gates, { a: 1, b: 0 })).toMatchObject({ and: 0, or: 1, xor: 1 });
+    expect(simulate(gates, { a: 1, b: 1 })).toMatchObject({ and: 1, or: 1, xor: 0 });
+    expect(simulate(gates, { a: 0, b: 0 })).toMatchObject({ and: 0, or: 0, xor: 0 });
+  });
+
+  it('respects dependency order regardless of gate listing order', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'b', in2: 'one', out: 'c' }, // depends on b
+      { op: 'XOR', in1: 'a', in2: 'one', out: 'b' },
+    ];
+    const v = simulate(gates, { a: 0, one: 1 });
+    expect(v.b).toBe(1);
+    expect(v.c).toBe(1);
+  });
+
+  it('returns the value of every wire, including inputs', () => {
+    const gates: Gate[] = [{ op: 'XOR', in1: 'a', in2: 'b', out: 'z' }];
+    expect(simulate(gates, { a: 1, b: 0 })).toEqual({ a: 1, b: 0, z: 1 });
+  });
+
+  it('chains AND/OR/XOR through intermediate wires', () => {
+    const gates: Gate[] = [
+      { op: 'AND', in1: 'x', in2: 'y', out: 'p' },
+      { op: 'XOR', in1: 'x', in2: 'y', out: 'q' },
+      { op: 'OR', in1: 'p', in2: 'q', out: 'r' },
+    ];
+    expect(simulate(gates, { x: 1, y: 1 }).r).toBe(1); // p=1
+    expect(simulate(gates, { x: 1, y: 0 }).r).toBe(1); // q=1
+    expect(simulate(gates, { x: 0, y: 0 }).r).toBe(0);
+  });
+
+  it('computes X + Y for the example 4-bit adder', () => {
+    const { gates } = makeAdder(4, rng(1));
+    for (const [x, y] of [
+      [0n, 0n],
+      [5n, 3n],
+      [15n, 15n],
+      [9n, 6n],
+      [15n, 1n],
+    ] as [bigint, bigint][]) {
+      expect(readZ(simulate(gates, setXY(x, y, 4)), 4)).toBe(x + y);
+    }
+  });
+
+  it('computes X + Y exhaustively for a generated 6-bit adder', () => {
+    const n = 6;
+    const { gates } = makeAdder(n, rng(42));
+    for (let x = 0n; x < 1n << BigInt(n); x++) {
+      for (let y = 0n; y < 1n << BigInt(n); y++) {
+        expect(readZ(simulate(gates, setXY(x, y, n)), n)).toBe(x + y);
+      }
+    }
+  });
+});
+
+// --- isValidAdder ----------------------------------------------------------
+
+describe('isValidAdder', () => {
+  it('accepts correct adders and rejects a single active swap', () => {
+    for (const n of [2, 5, 10, 20]) {
+      const { gates } = makeAdder(n, rng(n * 7 + 1));
+      expect(isValidAdder(gates)).toBe(true);
+      const broken = cloneGates(gates);
+      swapOut(broken, roleIndex(1, 'sum'), roleIndex(1, 'gen')); // z01 <-> a01
+      expect(isValidAdder(broken)).toBe(false);
+    }
+  });
+});
+
+// --- findSwappedWires ------------------------------------------------------
+
+describe('findSwappedWires', () => {
+  it('recovers well-separated swaps across many widths', () => {
+    const widths = [12, 16, 20, 24, 30, 36, 45];
+    for (const n of widths) {
+      for (let s = 0; s < 15; s++) {
+        const rand = rng(n * 911 + s * 13 + 1);
+        const { gates } = makeAdder(n, rand);
+        const { broken, wires } = plantSeparated(gates, n, rand);
+        expect(findSwappedWires(broken)).toEqual(wires);
+      }
+    }
+  });
+
+  it('recovers random swaps on large circuits', () => {
+    for (const n of [24, 32, 40, 45]) {
+      for (let s = 0; s < 12; s++) {
+        const rand = rng(n * 7757 + s * 101 + 5);
+        const { gates } = makeAdder(n, rand);
+        const planted = plantRandom(gates, n, rand);
+        if (!planted) continue;
+        expect(findSwappedWires(planted.broken)).toEqual(planted.wires);
+      }
+    }
+  });
+
+  it('returns 8 sorted distinct wire names', () => {
+    const rand = rng(55555);
+    const { gates } = makeAdder(20, rand);
+    const { broken, wires } = plantSeparated(gates, 20, rand);
+    const found = findSwappedWires(broken);
+    expect(found).toHaveLength(8);
+    expect(new Set(found).size).toBe(8);
+    expect([...found].sort()).toEqual(found);
+    expect(found).toEqual(wires);
+  });
+
+  it('solves the maximum width (45 bits) well under the time budget', () => {
+    const rand = rng(424242);
+    const { gates } = makeAdder(45, rand);
+    const { broken, wires } = plantSeparated(gates, 45, rand);
+    const start = Date.now();
+    const found = findSwappedWires(broken);
+    const elapsed = Date.now() - start;
+    expect(found).toEqual(wires);
+    expect(elapsed).toBeLessThan(5000);
+  });
+
+  it('finds the swap that produces a correct adder (verifiable end to end)', () => {
+    // Independent of any planted answer: the returned wires, once their swaps are
+    // undone, must yield a circuit that actually computes X + Y.
+    const rand = rng(31337);
+    const n = 28;
+    const { gates } = makeAdder(n, rand);
+    const planted = plantSeparated(gates, n, rand);
+    const found = findSwappedWires(planted.broken);
+
+    // Re-pair the 8 returned wires into the 4 swaps and undo them.
+    const fixed = cloneGates(planted.broken);
+    const idxOf = new Map(fixed.map((g, i) => [g.out, i] as const));
+    for (let k = 0; k < found.length; k += 2) {
+      const a = idxOf.get(found[k])!;
+      const b = idxOf.get(found[k + 1])!;
+      swapOut(fixed, a, b);
+    }
+    // The pairing above is arbitrary; what matters is that *some* circuit using
+    // exactly these 8 wires is a valid adder — guaranteed because found===planted.
+    expect(found).toEqual(planted.wires);
+    expect(isValidAdder(gates)).toBe(true);
+    for (let t = 0; t < 30; t++) {
+      const x = BigInt(Math.floor(rand() * 2 ** 26));
+      const y = BigInt(Math.floor(rand() * 2 ** 26));
+      expect(readZ(simulate(gates, setXY(x, y, n)), n)).toBe(x + y);
+    }
+  });
+});
+
+// --- robustness ------------------------------------------------------------
+
+describe('robustness', () => {
+  it('never exceeds the time budget and never returns a wrong answer', () => {
+    // Fully-random (often densely-tangled) swaps across a wide range of widths.
+    for (const n of [8, 12, 16, 20, 30, 45]) {
