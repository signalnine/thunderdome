+export interface Machine {
+  target: boolean[];
+  buttons: number[][];
+}
+
+// Part 1: Toggle Puzzle
+function solveToggle(machine: Machine): number[] | null {
+  const N = machine.target.length;
+  const M = machine.buttons.length;
+
+  if (N === 0) return [];
+  if (M === 0) {
+    return machine.target.every(t => !t) ? [] : null;
+  }
+
+  // Build augmented matrix [A | b] over GF(2)
+  const A: number[][] = Array.from({ length: N }, () => new Array(M + 1).fill(0));
+  for (let j = 0; j < M; j++) {
+    for (const li of machine.buttons[j]) {
+      A[li][j] = 1;
+    }
+  }
+  for (let i = 0; i < N; i++) {
+    A[i][M] = machine.target[i] ? 1 : 0;
+  }
+
+  // Gaussian elimination to RREF
+  const pivotRow: number[] = new Array(M).fill(-1);
+  let row = 0;
+  for (let col = 0; col < M && row < N; col++) {
+    let pivot = -1;
+    for (let r = row; r < N; r++) {
+      if (A[r][col] === 1) { pivot = r; break; }
+    }
+    if (pivot === -1) continue;
+    [A[row], A[pivot]] = [A[pivot], A[row]];
+    pivotRow[col] = row;
+    for (let r = 0; r < N; r++) {
+      if (r !== row && A[r][col] === 1) {
+        for (let c = 0; c <= M; c++) {
+          A[r][c] ^= A[row][c];
+        }
+      }
+    }
+    row++;
+  }
+
+  // Check consistency
+  for (let r = 0; r < N; r++) {
+    let allZero = true;
+    for (let c = 0; c < M; c++) {
+      if (A[r][c] !== 0) { allZero = false; break; }
+    }
+    if (allZero && A[r][M] === 1) return null;
+  }
+
+  // Identify free columns
+  const pivotCols: Set<number> = new Set();
+  for (let c = 0; c < M; c++) {
+    if (pivotRow[c] !== -1) pivotCols.add(c);
+  }
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) {
+    if (!pivotCols.has(c)) freeCols.push(c);
+  }
+
+  // Basic solution (free vars = 0)
+  const x0: number[] = new Array(M).fill(0);
+  for (let c = 0; c < M; c++) {
+    if (pivotRow[c] !== -1) x0[c] = A[pivotRow[c]][M];
+  }
+
+  // Direction vectors for each free variable
+  const dirs: number[][] = [];
+  for (const fc of freeCols) {
+    const d: number[] = new Array(M).fill(0);
+    d[fc] = 1;
+    for (let c = 0; c < M; c++) {
+      if (pivotRow[c] !== -1) d[c] = A[pivotRow[c]][fc];
+    }
+    dirs.push(d);
+  }
+
+  const numFree = freeCols.length;
+
+  function weight(v: number[]): number {
+    let s = 0;
+    for (let i = 0; i < v.length; i++) s += v[i];
+    return s;
+  }
+
+  function isBetter(a: number[], b: number[]): boolean {
+    const wa = weight(a), wb = weight(b);
+    if (wa < wb) return true;
+    if (wa > wb) return false;
+    // Lex comparison of button index sets:
+    // Compare from the lowest index button. The set with the button
+    // at the first differing position pressed (1) is lex-smaller,
+    // because it has a smaller element in the set.
+    // E.g., {0} vs {1}: at index 0, a=1, b=0 -> a is lex-smaller
+    for (let i = 0; i < a.length; i++) {
+      if (a[i] > b[i]) return true;
+      if (a[i] < b[i]) return false;
+    }
+    return false;
+  }
+
+  // For small numFree, enumerate all 2^numFree
+  if (numFree <= 22) {
+    let best = [...x0];
+    const total = 1 << numFree;
+    for (let mask = 0; mask < total; mask++) {
+      const candidate = [...x0];
+      for (let i = 0; i < numFree; i++) {
+        if (mask & (1 << i)) {
+          for (let c = 0; c < M; c++) {
+            candidate[c] ^= dirs[i][c];
+          }
+        }
+      }
+      if (isBetter(candidate, best)) best = candidate;
+    }
+    return toButtonIndices(best);
+  }
+
+  // For larger numFree, use branch-and-bound with pruning
+  // Sort free vars so that lower-indexed free vars are explored first
+  // This helps find lex-smaller solutions early
+
+  let bestWeight = Infinity;
+  let best: number[] | null = null;
+
+  // Branch and bound: explore free vars in order, try 0 before 1
+  // so lex-smaller solutions are found first
+  function search(current: number[], fi: number): void {
+    if (fi === numFree) {
+      if (best === null || isBetter(current, best)) {
+        best = [...current];
+        bestWeight = weight(current);
+      }
+      return;
+    }
+    if (weight(current) >= bestWeight) return;
+
+    // Try 0 first (not flipping) - this tends to produce lex-smaller solutions
+    search(current, fi + 1);
+
+    // Try 1 (flipping)
+    for (let c = 0; c < M; c++) {
+      current[c] ^= dirs[fi][c];
+    }
+    search(current, fi + 1);
+    for (let c = 0; c < M; c++) {
+      current[c] ^= dirs[fi][c];
+    }
+  }
+
+  // Start with x0
+  const initial = [...x0];
+  search(initial, 0);
+
+  if (best === null) return null;
+  return toButtonIndices(best);
+}
+
+function toButtonIndices(x: number[]): number[] {
+  const result: number[] = [];
+  for (let i = 0; i < x.length; i++) {
+    if (x[i]) result.push(i);
+  }
+  result.sort((a, b) => a - b);
+  return result;
+}
+
+// Part 2: Counter Puzzle
+function solveCounter(
+  lights: number[],
+  buttons: number[][],
+  modulus: number
+): number[] | null {
+  const N = lights.length;
+  const M = buttons.length;
+  const p = modulus;
+
+  if (N === 0) return [];
+  if (M === 0) {
+    return lights.every(l => l === 0) ? [] : null;
+  }
+
+  // Build augmented matrix [A | b] over GF(p)
+  const A: number[][] = Array.from({ length: N }, () => new Array(M + 1).fill(0));
+  for (let j = 0; j < M; j++) {
+    for (const li of buttons[j]) {
+      A[li][j] = (A[li][j] + 1) % p;
+    }
+  }
+  for (let i = 0; i < N; i++) {
+    A[i][M] = lights[i] % p;
+  }
+
+  // Gaussian elimination to RREF
+  const pivotRow: number[] = new Array(M).fill(-1);
+  let row = 0;
+  for (let col = 0; col < M && row < N; col++) {
+    let pivot = -1;
+    for (let r = row; r < N; r++) {
+      if (A[r][col] !== 0) { pivot = r; break; }
+    }
+    if (pivot === -1) continue;
+    [A[row], A[pivot]] = [A[pivot], A[row]];
+    pivotRow[col] = row;
+    const inv = modInverse(A[row][col], p);
+    for (let c = 0; c <= M; c++) {
+      A[row][c] = mulmod(A[row][c], inv, p);
+    }
+    for (let r = 0; r < N; r++) {
+      if (r !== row && A[r][col] !== 0) {
+        const factor = A[r][col];
+        for (let c = 0; c <= M; c++) {
+          A[r][c] = (A[r][c] - mulmod(factor, A[row][c], p)) % p;
+          if (A[r][c] < 0) A[r][c] += p;
+        }
+      }
+    }
+    row++;
+  }
+
+  // Check consistency
+  for (let r = 0; r < N; r++) {
+    let allZero = true;
+    for (let c = 0; c < M; c++) {
+      if (A[r][c] !== 0) { allZero = false; break; }
+    }
+    if (allZero && A[r][M] !== 0) return null;
+  }
+
+  // Identify free columns
+  const pivotCols: Set<number> = new Set();
+  for (let c = 0; c < M; c++) {
+    if (pivotRow[c] !== -1) pivotCols.add(c);
+  }
+  const freeCols: number[] = [];
+  for (let c = 0; c < M; c++) {
+    if (!pivotCols.has(c)) freeCols.push(c);
+  }
+
+  // Basic solution
+  const x0: number[] = new Array(M).fill(0);
+  for (let c = 0; c < M; c++) {
+    if (pivotRow[c] !== -1) x0[c] = A[pivotRow[c]][M];
+  }
+
+  // Direction vectors
+  const dirs: number[][] = [];
+  for (const fc of freeCols) {
+    const d: number[] = new Array(M).fill(0);
+    d[fc] = 1;
+    for (let c = 0; c < M; c++) {
+      if (pivotRow[c] !== -1) d[c] = (p - A[pivotRow[c]][fc]) % p;
+    }
+    dirs.push(d);
+  }
+
+  const numFree = freeCols.length;
+  if (numFree === 0) return [...x0];
+
+  function computeCandidate(vals: number[]): number[] {
+    const result = [...x0];
+    for (let fi = 0; fi < vals.length; fi++) {
+      if (vals[fi] === 0) continue;
+      for (let c = 0; c < M; c++) {
+        result[c] = (result[c] + mulmod(vals[fi], dirs[fi][c], p)) % p;
+      }
+    }
+    return result;
+  }
+
+  function totalPresses(v: number[]): number {
+    let s = 0;
+    for (let i = 0; i < v.length; i++) s += v[i];
+    return s;
+  }
+
+  function isBetter(a: number[], b: number[]): boolean {
+    const sa = totalPresses(a), sb = totalPresses(b);
+    if (sa < sb) return true;
+    if (sa > sb) return false;
+    for (let i = 0; i < a.length; i++) {
+      if (a[i] < b[i]) return true;
+      if (a[i] > b[i]) return false;
+    }
+    return false;
+  }
+
+  // For small numFree, enumerate exactly
+  const maxCombos = Math.pow(p, numFree);
+  if (maxCombos <= 1_000_000) {
+    let best = [...x0];
+    const indices: number[] = new Array(numFree).fill(0);
+    let done = false;
+    while (!done) {
+      const candidate = computeCandidate(indices);
+      if (isBetter(candidate, best)) best = candidate;
+      let carry = true;
+      for (let i = 0; i < numFree && carry; i++) {
+        indices[i]++;
+        if (indices[i] >= p) {
+          indices[i] = 0;
+        } else {
+          carry = false;
+        }
+      }
+      if (carry) done = true;
+    }
+    return best;
+  }
+
+  // Hill climbing with multiple restarts for larger cases
+  let best = [...x0];
+  const restarts = 200;
+  for (let r = 0; r < restarts; r++) {
+    const startIndices = r === 0
+      ? new Array(numFree).fill(0)
+      : new Array(numFree).fill(0).map(() => Math.floor(Math.random() * p));
+    let current = computeCandidate(startIndices);
+    const ci: number[] = [...startIndices];
+    let improved = true;
+    while (improved) {
+      improved = false;
+      for (let fi = 0; fi < numFree; fi++) {
+        const oldVal = ci[fi];
+        for (let v = 0; v < p; v++) {
+          ci[fi] = v;
+          const candidate = computeCandidate(ci);
+          if (isBetter(candidate, current)) {
+            current = candidate;
+            improved = true;
+          }
+        }
+        ci[fi] = oldVal;
+      }
+    }
+    if (isBetter(current, best)) best = current;
+  }
+
+  return best;
+}
+
+function mulmod(a: number, b: number, mod: number): number {
+  return ((a % mod) * (b % mod)) % mod;
+}
+
+function modInverse(a: number, p: number): number {
+  return modPow(a, p - 2, p);
+}
+
+function modPow(base: number, exp: number, mod: number): number {
+  let result = 1;
+  base = base % mod;
+  while (exp > 0) {
+    if (exp & 1) result = (result * base) % mod;
+    exp >>= 1;
+    base = (base * base) % mod;
+  }
+  return result;
+}
+
+export { solveToggle, solveCounter };
