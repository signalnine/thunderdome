+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+
+export function createCartService(bus: EventBus) {
+  const carts = new Map<string, { id: string; userId: string; items: Array<{ productId: string; quantity: number }> }>();
+
+  function emitUpdate(cartId: string): void {
+    const cart = carts.get(cartId);
+    if (cart) {
+      bus.emit(Events.CART_UPDATED, { cartId, userId: cart.userId, items: cart.items });
+    }
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = uuidv4();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find(i => i.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cartId);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = cart.items.filter(i => i.productId !== productId);
+      emitUpdate(cartId);
+    },
+
+    getCart(cartId: string) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return { id: cart.id, userId: cart.userId, items: [...cart.items] };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (cart) {
+        cart.items = [];
+        emitUpdate(cartId);
+      }
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const item = cart.items.find(i => i.productId === productId);
+      if (item) {
+        item.quantity = quantity;
+      }
+      emitUpdate(cartId);
+    },
+  };
+}
