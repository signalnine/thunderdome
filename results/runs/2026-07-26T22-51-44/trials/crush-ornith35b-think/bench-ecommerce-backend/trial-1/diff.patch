+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { Events, PaymentStatus } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}) {
+  const transactions = new Map<string, { orderId: string; amount: number; status: PaymentStatus }>();
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      let status: PaymentStatus;
+      let error: string | undefined;
+      let transactionId: string | undefined;
+
+      if (options.simulateTimeout) {
+        status = PaymentStatus.TIMEOUT;
+        error = 'Payment timed out';
+      } else if (options.simulateFailure) {
+        status = PaymentStatus.FAILED;
+        error = 'Payment declined';
+      } else {
+        status = PaymentStatus.SUCCESS;
+        transactionId = uuidv4();
+      }
+
+      if (transactionId) {
+        transactions.set(transactionId, { orderId, amount, status });
+      }
+
+      const result = { status, transactionId, error };
+      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status, transactionId, error });
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const tx = transactions.get(transactionId);
+      if (!tx) return false;
+      tx.status = PaymentStatus.FAILED;
+      return true;
+    },
+  };
+}
