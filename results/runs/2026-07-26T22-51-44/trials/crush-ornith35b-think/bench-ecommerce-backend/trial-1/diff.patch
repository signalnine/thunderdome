+import { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+
+export function createNotificationService(bus: EventBus) {
+  const subscribers = new Set<string>();
+  const userIdMap = new Map<string, string>(); // orderId -> userId
+  const notifications = new Map<string, Array<{ type: string; message: string; timestamp: number }>>();
+
+  function getOrCreateNotifications(userId: string) {
+    if (!notifications.has(userId)) {
+      notifications.set(userId, []);
+    }
+    return notifications.get(userId)!;
+  }
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const p = payload as { orderId: string; userId: string };
+    userIdMap.set(p.orderId, p.userId);
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, async (payload: unknown) => {
+    const p = payload as { orderId: string; status: string; previousStatus: string };
+    const userId = userIdMap.get(p.orderId);
+    if (!userId || !subscribers.has(userId)) return;
+    getOrCreateNotifications(userId).push({
+      type: 'order_status',
+      message: `Order ${p.orderId} status changed from ${p.previousStatus} to ${p.status}`,
+      timestamp: Date.now(),
+    });
+    await bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'order_status', message: `Order ${p.orderId} status changed from ${p.previousStatus} to ${p.status}` });
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, async (payload: unknown) => {
+    const p = payload as { orderId: string; status: string };
+    const userId = userIdMap.get(p.orderId);
+    if (!userId || !subscribers.has(userId)) return;
+    const message = p.status === 'success'
+      ? `Payment successful for order ${p.orderId}`
+      : `Payment failed for order ${p.orderId}`;
+    getOrCreateNotifications(userId).push({
+      type: 'payment',
+      message,
+      timestamp: Date.now(),
+    });
+    await bus.emit(Events.NOTIFICATION_SENT, { userId, type: 'payment', message });
+  });
+
+  return {
+    subscribe(userId: string): void {
+      subscribers.add(userId);
+    },
+
+    getNotifications(userId: string) {
+      return notifications.get(userId) ?? [];
+    },
+  };
+}
