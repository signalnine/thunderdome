+import { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+
+export function createPricingService(bus: EventBus) {
+  const prices = new Map<string, number>();
+  const discountCodes = new Map<string, number>();
+
+  bus.on(Events.PRODUCT_CREATED, (payload: unknown) => {
+    const p = payload as { productId: string; price: number };
+    prices.set(p.productId, p.price);
+  });
+
+  return {
+    calculateTotal(
+      items: Array<{ productId: string; quantity: number; price: number }>,
+      discountCode?: string
+    ) {
+      const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
+      let discount = 0;
+      if (discountCode && discountCodes.has(discountCode)) {
+        discount = subtotal * (discountCodes.get(discountCode)! / 100);
+      }
+      const afterDiscount = subtotal - discount;
+      const tax = afterDiscount * 0.1;
+      const total = afterDiscount + tax;
+      return { subtotal, discount, tax, total };
+    },
+
+    addDiscountCode(code: string, percentage: number): void {
+      discountCodes.set(code, percentage);
+    },
+
+    getPrice(productId: string): number {
+      return prices.get(productId) ?? 0;
+    },
+  };
+}
