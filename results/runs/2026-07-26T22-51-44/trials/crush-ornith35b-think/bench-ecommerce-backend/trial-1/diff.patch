+import { EventBus } from '../bus.js';
+import { Events } from '../types.js';
+import { PaymentStatus } from '../types.js';
+
+export function createAnalyticsService(bus: EventBus) {
+  const eventCounts = new Map<string, number>();
+  let revenue = 0;
+  const uniqueCarts = new Set<string>();
+  const orderCarts = new Set<string>();
+  const productOrderQuantities = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+
+  bus.on(Events.PRODUCT_CREATED, () => {
+    eventCounts.set(Events.PRODUCT_CREATED, (eventCounts.get(Events.PRODUCT_CREATED) ?? 0) + 1);
+  });
+
+  bus.on(Events.INVENTORY_UPDATED, () => {
+    eventCounts.set(Events.INVENTORY_UPDATED, (eventCounts.get(Events.INVENTORY_UPDATED) ?? 0) + 1);
+  });
+
+  bus.on(Events.LOW_STOCK_ALERT, () => {
+    eventCounts.set(Events.LOW_STOCK_ALERT, (eventCounts.get(Events.LOW_STOCK_ALERT) ?? 0) + 1);
+  });
+
+  bus.on(Events.CART_UPDATED, (payload: unknown) => {
+    const p = payload as { cartId: string; items: Array<{ productId: string; quantity: number }> };
+    eventCounts.set(Events.CART_UPDATED, (eventCounts.get(Events.CART_UPDATED) ?? 0) + 1);
+    uniqueCarts.add(p.cartId);
+    cartItems.set(p.cartId, p.items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload: unknown) => {
+    const p = payload as { orderId: string; cartId: string; total: number };
+    eventCounts.set(Events.ORDER_CREATED, (eventCounts.get(Events.ORDER_CREATED) ?? 0) + 1);
+    orderCarts.add(p.cartId);
+    orderTotals.set(p.orderId, p.total);
+
+    const items = cartItems.get(p.cartId);
+    if (items) {
+      for (const item of items) {
+        productOrderQuantities.set(item.productId, (productOrderQuantities.get(item.productId) ?? 0) + item.quantity);
+      }
+    }
+  });
+
+  bus.on(Events.ORDER_STATUS_CHANGED, () => {
+    eventCounts.set(Events.ORDER_STATUS_CHANGED, (eventCounts.get(Events.ORDER_STATUS_CHANGED) ?? 0) + 1);
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {
+    const p = payload as { orderId: string; status: string };
+    eventCounts.set(Events.PAYMENT_PROCESSED, (eventCounts.get(Events.PAYMENT_PROCESSED) ?? 0) + 1);
+    if (p.status === PaymentStatus.SUCCESS) {
+      const total = orderTotals.get(p.orderId) ?? 0;
+      revenue += total;
+    }
+  });
+
+  bus.on(Events.NOTIFICATION_SENT, () => {
+    eventCounts.set(Events.NOTIFICATION_SENT, (eventCounts.get(Events.NOTIFICATION_SENT) ?? 0) + 1);
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (uniqueCarts.size === 0) return 0;
+      return orderCarts.size / uniqueCarts.size;
+    },
+
+    getTopProducts(limit: number) {
+      const sorted = Array.from(productOrderQuantities.entries())
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, limit)
+        .map(([productId, count]) => ({ productId, count }));
+      return sorted;
+    },
+  };
+}
