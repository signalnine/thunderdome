+import { v4 as uuidv4 } from 'uuid';
+import { EventBus } from '../bus.js';
+import { Events, OrderStatus } from '../types.js';
+
+export function createOrderService(bus: EventBus) {
+  const orders = new Map<string, { id: string; userId: string; cartId: string; total: number; status: OrderStatus }>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = uuidv4();
+      orders.set(id, { id, userId, cartId, total, status: OrderStatus.PENDING });
+      bus.emit(Events.ORDER_CREATED, { orderId: id, userId, cartId, total });
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      const order = orders.get(orderId);
+      if (!order) return null;
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) return;
+      const previousStatus = order.status;
+      order.status = status;
+      bus.emit(Events.ORDER_STATUS_CHANGED, { orderId, status, previousStatus });
+    },
+
+    listOrders(userId: string) {
+      return Array.from(orders.values())
+        .filter(o => o.userId === userId)
+        .map(o => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
