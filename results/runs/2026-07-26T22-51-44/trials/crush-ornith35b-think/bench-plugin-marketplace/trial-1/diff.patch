+import type { DepsService, DependencyNode, RegistryService } from '../types.js';
+
+export function createDepsService(): DepsService {
+  function getLatest(name: string, registry: RegistryService): { version: string; manifest: ReturnType<RegistryService['get']> } | null {
+    const manifest = registry.get(name);
+    if (!manifest) return null;
+    return { version: manifest.version, manifest };
+  }
+
+  function buildTreeRecursive(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>
+  ): DependencyNode {
+    const info = getLatest(name, registry);
+    if (!info) {
+      return { name, version: 'unknown', dependencies: [] };
+    }
+
+    const deps: DependencyNode[] = [];
+    for (const depName of Object.keys(info.manifest!.dependencies)) {
+      if (visited.has(depName)) continue;
+      visited.add(depName);
+      deps.push(buildTreeRecursive(depName, registry, visited));
+      visited.delete(depName);
+    }
+
+    return {
+      name,
+      version: info.version,
+      dependencies: deps,
+    };
+  }
+
+  function detectCyclesRecursive(
+    name: string,
+    registry: RegistryService,
+    path: string[],
+    visited: Set<string>,
+    onPath: Set<string>
+  ): string[][] {
+    const info = getLatest(name, registry);
+    if (!info) return [];
+
+    const cycles: string[][] = [];
+    path.push(name);
+    onPath.add(name);
+
+    for (const depName of Object.keys(info.manifest!.dependencies)) {
+      if (onPath.has(depName)) {
+        const cycleStart = path.indexOf(depName);
+        cycles.push(path.slice(cycleStart));
+      } else if (!visited.has(depName)) {
+        visited.add(depName);
+        cycles.push(...detectCyclesRecursive(depName, registry, path, visited, onPath));
+        visited.delete(depName);
+      }
+    }
+
+    path.pop();
+    onPath.delete(name);
+    return cycles;
+  }
+
+  function topoSortRecursive(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+    result: string[]
+  ): void {
+    if (visited.has(name)) return;
+    visited.add(name);
+
+    const info = getLatest(name, registry);
+    if (info) {
+      for (const depName of Object.keys(info.manifest!.dependencies)) {
+        if (!visited.has(depName)) {
+          topoSortRecursive(depName, registry, visited, result);
+        }
+      }
+    }
+
+    result.push(name);
+  }
+
+  function flattenRecursive(
+    name: string,
+    registry: RegistryService,
+    visited: Set<string>,
+    result: string[]
+  ): void {
+    if (visited.has(name)) return;
+    visited.add(name);
+
+    const info = getLatest(name, registry);
+    if (info) {
+      for (const depName of Object.keys(info.manifest!.dependencies)) {
+        if (!visited.has(depName)) {
+          result.push(depName);
+          flattenRecursive(depName, registry, visited, result);
+        }
+      }
+    }
+  }
+
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return buildTreeRecursive(name, registry, new Set([name]));
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      const cycles = detectCyclesRecursive(name, registry, [], new Set(), new Set());
+      return cycles.length > 0 ? cycles : null;
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      topoSortRecursive(name, registry, new Set(), result);
+      return result;
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      const result: string[] = [];
+      flattenRecursive(name, registry, new Set(), result);
+      return result;
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      const cycles = detectCyclesRecursive(name, registry, [], new Set(), new Set());
+      return cycles.length > 0;
+    },
+  };
+}
