+import { createContext, runInContext, Script } from 'vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(
+      code: string,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      return this.executeWithTimeout(code, Infinity, context);
+    },
+
+    async executeWithTimeout(
+      code: string,
+      timeoutMs: number,
+      context?: Record<string, unknown>
+    ): Promise<SandboxResult> {
+      const start = Date.now();
+      const memBefore = process.memoryUsage().heapUsed;
+
+      try {
+        const ctx = createContext(context || {});
+        const opts: { timeout?: number } = {};
+        if (timeoutMs !== Infinity) {
+          opts.timeout = timeoutMs;
+        }
+        const script = new Script(code, opts as any);
+        const output = script.runInContext(ctx);
+        const duration = Date.now() - start;
+        const memAfter = process.memoryUsage().heapUsed;
+
+        return {
+          success: true,
+          output,
+          duration,
+          memoryUsed: memAfter - memBefore,
+        };
+      } catch (err) {
+        const duration = Date.now() - start;
+        return {
+          success: false,
+          output: undefined,
+          duration,
+          memoryUsed: 0,
+          error: err instanceof Error ? err.message : String(err),
+        };
+      }
+    },
+  };
+}
