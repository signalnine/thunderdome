+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: { data: Map<string, unknown> }): ContentFile {
+        const content = file.content;
+
+        // Find all relative asset references (src="./..." or href="./...")
+        // but NOT already rewritten (/assets/...)
+        const assetRegex = /((?:src|href)=")(\.\/[^"]+)(")/g;
+        const assets: string[] = [];
+        let match;
+
+        while ((match = assetRegex.exec(content)) !== null) {
+          const assetPath = match[2];
+          const filename = assetPath.replace(/^\.\/+/, '');
+          if (!assets.includes(filename)) {
+            assets.push(filename);
+          }
+        }
+
+        // Rewrite relative paths to /assets/
+        let newContent = content.replace(
+          /((?:src|href)=")(\.\/[^"]+)(")/g,
+          (_match, prefix: string, path: string, suffix: string) => {
+            const filename = path.replace(/^\.\/+/, '');
+            return `${prefix}/assets/${filename}${suffix}`;
+          }
+        );
+
+        // Update asset manifest in context data
+        if (assets.length > 0) {
+          const existingManifest = ctx.data.get('asset-manifest') as
+            | { assets: string[] }
+            | undefined;
+          if (existingManifest) {
+            for (const asset of assets) {
+              if (!existingManifest.assets.includes(asset)) {
+                existingManifest.assets.push(asset);
+              }
+            }
+          } else {
+            ctx.data.set('asset-manifest', { assets });
+          }
+        }
+
+        return { ...file, content: newContent };
+      },
+    },
+  };
+}
