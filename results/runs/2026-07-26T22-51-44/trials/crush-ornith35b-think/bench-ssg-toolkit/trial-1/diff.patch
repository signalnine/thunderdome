+import { ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(str: string): string {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&apos;');
+}
+
+function escapeCdata(str: string): string {
+  return str;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: {
+        config: { title: string; baseUrl: string };
+        files: ContentFile[];
+        output: Map<string, string>;
+        data: Map<string, unknown>;
+      }): void {
+        const files = ctx.files.filter(f => f.date);
+        files.sort((a, b) => {
+          if (!a.date || !b.date) return 0;
+          return new Date(b.date).getTime() - new Date(a.date).getTime();
+        });
+
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+
+        const items = files.map(file => {
+          const categories = tagMap
+            ? Array.from(tagMap.entries())
+                .filter(([, f]) => f.some(x => x.slug === file.slug))
+                .map(([tag]) => `<category>${escapeXml(tag)}</category>`)
+                .join('\n    ')
+            : '';
+
+          const pubDate = file.date
+            ? `<pubDate>${new Date(file.date).toUTCString()}</pubDate>`
+            : '';
+
+          return `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${ctx.config.baseUrl}/${file.slug}.html</link>
+      ${pubDate}
+      ${categories}
+      <description><![CDATA[${escapeCdata(file.content)}]]></description>
+    </item>`;
+        }).join('\n');
+
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${ctx.config.baseUrl}</link>
+    <description>Feed for ${escapeXml(ctx.config.title)}</description>
+${items}
+  </channel>
+</rss>`;
+
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
