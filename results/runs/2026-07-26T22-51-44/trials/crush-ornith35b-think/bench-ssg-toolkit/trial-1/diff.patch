@@ -0,0 +1,26 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        let content = file.content;
+
+        // Match <pre><code class="language-xxx">...</code></pre>
+        // Only process blocks that have a language class
+        const codeBlockRegex =
+          /<pre><code class="language-([^"]+)">([\s\S]*?)<\/code><\/pre>/g;
+
+        content = content.replace(codeBlockRegex, (_match, lang: string, code: string) => {
+          const langClass = `language-${lang}`;
+          return `<pre><code class="${langClass} highlighted" data-language="${lang}">${code}</code></pre>`;
+        });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
