+import { marked } from 'marked';
+import { ContentFile, Plugin } from '../core/types.js';
+
+function extractFootnotes(content: string): { footnoteMap: Map<string, string>, cleanContent: string } {
+  const footnoteMap = new Map<string, string>();
+  let cleanContent = content;
+  let counter = 0;
+
+  // Extract footnote definitions: [^label]: content
+  const defRegex = /\[\^([^]]+)\]:\s*(.+)/g;
+  let match;
+  while ((match = defRegex.exec(cleanContent)) !== null) {
+    counter++;
+    const label = match[1];
+    const def = match[2].trim();
+    footnoteMap.set(label, def);
+  }
+
+  // Replace footnote references [^label] with superscript links
+  cleanContent = cleanContent.replace(/\[\^([^]]+)\]/g, (original, label) => {
+    if (footnoteMap.has(label)) {
+      return `<sup><a href="#fn-${label}">${label}</a></sup>`;
+    }
+    return original;
+  });
+
+  // Remove footnote definitions from content
+  cleanContent = cleanContent.replace(/\[\^([^]]+)\]:\s*.+/g, '');
+
+  return { footnoteMap, cleanContent };
+}
+
+function buildFootnoteSection(footnoteMap: Map<string, string>): string {
+  if (footnoteMap.size === 0) return '';
+  const items = Array.from(footnoteMap.entries()).map(([label, def]) =>
+    `<li id="fn-${label}">${def}</li>`
+  );
+  return `<section class="footnotes">\n<ul>\n${items.join('\n')}\n</ul>\n</section>`;
+}
+
+function processAdmonitions(content: string): string {
+  const admonitionTypes = ['note', 'warning', 'tip', 'caution', 'danger'];
+  let result = content;
+
+  for (const type of admonitionTypes) {
+    const regex = new RegExp(`:::${type}\\n([\\s\\S]*?)\\n:::`, 'g');
+    result = result.replace(regex, (_match, body) => {
+      return `<div class="admonition admonition-${type}">\n${body.trim()}\n</div>`;
+    });
+  }
+
+  return result;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile): ContentFile {
+        let content = file.content;
+
+        // Extract footnotes before markdown processing
+        const { footnoteMap, cleanContent } = extractFootnotes(content);
+
+        // Process admonitions before markdown
+        content = processAdmonitions(cleanContent);
+
+        // Convert markdown to HTML
+        const html = marked(content as string) as string;
+
+        // Append footnote section
+        const footnoteSection = buildFootnoteSection(footnoteMap);
+        content = html + footnoteSection;
+
+        return { ...file, content };
+      },
+    },
+  };
+}
