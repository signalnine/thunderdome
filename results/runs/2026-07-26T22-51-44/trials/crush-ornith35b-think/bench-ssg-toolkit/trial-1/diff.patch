@@ -0,0 +1,49 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createTaxonomyPlugin(): Plugin {
+  return {
+    name: 'taxonomy',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      beforeBuild(ctx: { files: ContentFile[]; data: Map<string, unknown> }): void {
+        const tagMap = new Map<string, ContentFile[]>();
+
+        for (const file of ctx.files) {
+          if (!file.tags) continue;
+          for (const tag of file.tags) {
+            const normalized = tag.toLowerCase();
+            if (!tagMap.has(normalized)) {
+              tagMap.set(normalized, []);
+            }
+            tagMap.get(normalized)!.push(file);
+          }
+        }
+
+        ctx.data.set('taxonomy-tags', tagMap);
+      },
+      afterBuild(ctx: { data: Map<string, unknown>; output: Map<string, string> }): void {
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        if (!tagMap) return;
+
+        for (const [tag, files] of tagMap) {
+          const title = files.map(f => f.title).join(', ');
+          const items = files
+            .map(f => `<li><a href="/${f.slug}.html">${f.title}</a></li>`)
+            .join('\n');
+          const html = `<!DOCTYPE html>
+<html>
+<head><title>Tag: ${tag}</title></head>
+<body>
+<h1>Tag: ${tag}</h1>
+<ul>
+${items}
+</ul>
+</body>
+</html>`;
+          ctx.output.set(`tags/${tag}.html`, html);
+        }
+      },
+    },
+  };
+}
