+import { ContentFile, Plugin } from '../core/types.js';
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild(ctx: {
+        config: { baseUrl: string };
+        output: Map<string, string>;
+        data: Map<string, unknown>;
+      }): void {
+        const baseUrl = ctx.config.baseUrl.replace(/\/$/, '');
+        const urls: string[] = [];
+
+        // Add content pages
+        for (const slug of ctx.output.keys()) {
+          if (slug === 'sitemap.xml' || slug === 'feed.xml' || slug === 'search-index.json') continue;
+          urls.push(`${baseUrl}/${slug}`);
+        }
+
+        // Add taxonomy tag pages
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+        if (tagMap) {
+          for (const tag of tagMap.keys()) {
+            urls.push(`${baseUrl}/tags/${tag}.html`);
+          }
+        }
+
+        // Add feed URL
+        if (ctx.output.has('feed.xml')) {
+          urls.push(`${baseUrl}/feed.xml`);
+        }
+
+        const urlEntries = urls.map(url =>
+          `  <url>\n    <loc>${url}</loc>\n  </url>`
+        ).join('\n');
+
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+${urlEntries}
+</urlset>`;
+
+        ctx.output.set('sitemap.xml', xml);
+      },
+    },
+  };
+}
