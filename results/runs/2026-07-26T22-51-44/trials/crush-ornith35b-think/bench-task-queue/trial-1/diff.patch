@@ -0,0 +1,513 @@
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: unknown;
+  status: TaskStatus;
+  priority: number;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  createdAt: Date;
+  availableAt?: Date;
+  dependsOn?: string[];
+  lastError?: string;
+  failCount?: number;
+  progress?: {
+    percent: number;
+    message?: string;
+    updatedAt: Date;
+  };
+  progressCallbacks?: Array<(info: { percent: number; message?: string }) => void>;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+}
+
+export interface Middleware {
+  (task: Task, next: () => Promise<void>): Promise<void>;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  maxRetries?: number;
+  backoffMs?: number;
+  delay?: number;
+  runAt?: Date;
+  dependsOn?: string[];
+}
+
+export class TaskQueue {
+  private queues: Map<string, Task[]> = new Map();
+  private tasks: Map<string, Task> = new Map();
+  private schedules: Map<string, Schedule> = new Map();
+  private scheduleCounter = 0;
+  private concurrencyLimits: Map<string, number> = new Map();
+  private processingTasks: Map<string, Task> = new Map();
+  private middlewareStacks: Map<string, Middleware[]> = new Map();
+  private shutdownCallbacks: Array<() => void> = [];
+  private isShuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownResolve: ((summary: ShutdownSummary) => void) | null = null;
+  private shutdownTimeout: NodeJS.Timeout | null = null;
+  private processingResolve: (() => void) | null = null;
+
+  private generateId(): string {
+    return `task-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
+  }
+
+  enqueue(queueName: string, payload: unknown, options: EnqueueOptions = {}): Task {
+    if (this.isShuttingDown) {
+      throw new Error('TaskQueue is shutting down');
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const task: Task = {
+      id: this.generateId(),
+      queueName,
+      payload,
+      status: 'pending',
+      priority,
+      attempts: 1,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      createdAt: new Date(),
+      dependsOn: options.dependsOn,
+      progressCallbacks: [],
+    };
+
+    if (options.delay) {
+      task.availableAt = new Date(Date.now() + options.delay);
+    } else if (options.runAt) {
+      task.availableAt = options.runAt;
+    }
+
+    if (!this.queues.has(queueName)) {
+      this.queues.set(queueName, []);
+    }
+    this.queues.get(queueName)!.push(task);
+    this.tasks.set(task.id, task);
+
+    return task;
+  }
+
+  dequeue(queueName: string): Task | null {
+    if (this.isShuttingDown) return null;
+
+    const queue = this.queues.get(queueName);
+    if (!queue || queue.length === 0) return null;
+
+    const now = Date.now();
+    const availableTasks = queue.filter((task) => {
+      if (task.status !== 'pending') return false;
+      if (task.availableAt && task.availableAt.getTime() > now) return false;
+      return true;
+    });
+
+    if (availableTasks.length === 0) return null;
+
+    // Check concurrency limit
+    const concurrencyLimit = this.concurrencyLimits.get(queueName);
+    if (concurrencyLimit !== undefined) {
+      const currentProcessing = Array.from(this.processingTasks).filter(
+        (taskId) => this.tasks.get(taskId)?.queueName === queueName
+      ).length;
+      if (currentProcessing >= concurrencyLimit) return null;
+    }
+
+    // Sort by priority (lower number = higher priority), then by createdAt (FIFO)
+    availableTasks.sort((a, b) => {
+      if (a.priority !== b.priority) return a.priority - b.priority;
+      return a.createdAt.getTime() - b.createdAt.getTime();
+    });
+
+    const task = availableTasks[0];
+    task.status = 'processing';
+    this.processingTasks.set(task.id, task);
+
+    // Resolve any waiting shutdown
+    if (this.processingResolve) {
+      this.processingResolve();
+      this.processingResolve = null;
+    }
+
+    return task;
+  }
+
+  size(): number {
+    let count = 0;
+    for (const [, queue] of this.queues) {
+      count += queue.filter((t) => t.status === 'pending').length;
+    }
+    return count;
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  queueSize(queueName: string): number {
+    const queue = this.queues.get(queueName);
+    return queue ? queue.filter((t) => t.status === 'pending').length : 0;
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    task.status = 'completed';
+    this.processingTasks.delete(taskId);
+
+    // Check if any tasks were waiting on this task's completion
+    this.checkDependencies(task);
+  }
+
+  fail(taskId: string, error?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    task.status = 'failed';
+    task.lastError = error;
+    task.failCount = (task.failCount ?? 0) + 1;
+    this.processingTasks.delete(taskId);
+
+    // Check if retries remain
+    if (task.failCount < task.maxRetries) {
+      // Schedule retry with exponential backoff
+      const backoffTime = task.backoffMs * Math.pow(2, task.failCount - 1);
+      task.availableAt = new Date(Date.now() + backoffTime);
+      task.status = 'pending';
+      task.attempts = task.failCount + 1;
+
+      if (!this.queues.has(task.queueName)) {
+        this.queues.set(task.queueName, []);
+      }
+      this.queues.get(task.queueName)!.push(task);
+    }
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const queue = this.queues.get(queueName);
+    if (!queue) return [];
+    return queue.filter((t) => t.status === 'failed' && t.failCount >= t.maxRetries);
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    // Find the task in any DLQ
+    for (const [, queue] of this.queues) {
+      const task = queue.find((t) => t.id === taskId && t.status === 'failed' && t.failCount >= t.maxRetries);
+      if (task) {
+        task.status = 'pending';
+        task.failCount = 0;
+        task.attempts = 1;
+        task.lastError = undefined;
+        task.availableAt = undefined;
+        return task;
+      }
+    }
+    return null;
+  }
+
+  clearDLQ(queueName: string): void {
+    const queue = this.queues.get(queueName);
+    if (!queue) return;
+    const dlqTasks = queue.filter((t) => t.status === 'failed' && t.failCount >= t.maxRetries);
+    for (const task of dlqTasks) {
+      this.tasks.delete(task.id);
+    }
+    // Remove failed tasks from queue
+    const activeTasks = queue.filter((t) => !(t.status === 'failed' && t.failCount >= t.maxRetries));
+    this.queues.set(queueName, activeTasks);
+  }
+
+  getDependencies(taskId: string): Array<{ taskId: string; status: string }> {
+    const task = this.tasks.get(taskId);
+    if (!task || !task.dependsOn || task.dependsOn.length === 0) return [];
+
+    return task.dependsOn.map((depId) => {
+      const depTask = this.tasks.get(depId);
+      return {
+        taskId: depId,
+        status: depTask ? depTask.status : 'unknown',
+      };
+    });
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    this.concurrencyLimits.set(queueName, limit);
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const limit = this.concurrencyLimits.get(queueName);
+    const current = Array.from(this.processingTasks).filter(
+      (taskId) => this.tasks.get(taskId)?.queueName === queueName
+    ).length;
+
+    return {
+      current,
+      max: limit ?? Infinity,
+    };
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    task.progress = {
+      percent,
+      message,
+      updatedAt: new Date(),
+    };
+
+    // Notify callbacks
+    for (const callback of task.progressCallbacks || []) {
+      callback({ percent, message });
+    }
+  }
+
+  getProgress(taskId: string): { percent: number; message?: string; updatedAt: Date } | null {
+    const task = this.tasks.get(taskId);
+    return task?.progress ?? null;
+  }
+
+  onProgress(taskId: string, callback: (info: { percent: number; message?: string }) => void): () => void {
+    const task = this.tasks.get(taskId);
+    if (!task) return () => {};
+
+    if (!task.progressCallbacks) {
+      task.progressCallbacks = [];
+    }
+    task.progressCallbacks.push(callback);
+
+    return () => {
+      const index = task.progressCallbacks.indexOf(callback);
+      if (index > -1) {
+        task.progressCallbacks.splice(index, 1);
+      }
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    task.status = 'cancelled';
+    this.processingTasks.delete(taskId);
+
+    // Remove from queue if pending
+    const queue = this.queues.get(task.queueName);
+    if (queue) {
+      const index = queue.findIndex((t) => t.id === taskId);
+      if (index > -1) {
+        queue.splice(index, 1);
+      }
+    }
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown, options: ScheduleOptions = {}): Schedule {
+    const schedule: Schedule = {
+      id: `schedule-${++this.scheduleCounter}`,
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: options.active ?? true,
+    };
+
+    this.schedules.set(schedule.id, schedule);
+    return schedule;
+  }
+
+  unschedule(scheduleId: string): void {
+    const schedule = this.schedules.get(scheduleId);
+    if (schedule) {
+      schedule.active = false;
+    }
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const schedules = Array.from(this.schedules.values()).filter((s) => s.active);
+    if (queueName) {
+      return schedules.filter((s) => s.queueName === queueName);
+    }
+    return schedules;
+  }
+
+  tick(): void {
+    const now = new Date();
+    const currentMinute = now.getMinutes();
+    const currentHour = now.getHours();
+    const currentDay = now.getDate();
+    const currentMonth = now.getMonth() + 1;
+    const currentDayOfWeek = now.getDay();
+
+    for (const schedule of this.schedules.values()) {
+      if (!schedule.active) continue;
+
+      if (this.matchesCron(schedule.cronExpression, currentMinute, currentHour, currentDay, currentMonth, currentDayOfWeek)) {
+        this.enqueue(schedule.queueName, schedule.taskTemplate);
+      }
+    }
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    if (!this.middlewareStacks.has(queueName)) {
+      this.middlewareStacks.set(queueName, []);
+    }
+    this.middlewareStacks.get(queueName)!.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void>): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const middlewareStack = this.middlewareStacks.get(queueName) ?? [];
+
+    try {
+      await this.runMiddleware(middlewareStack, 0, task, handler);
+    } catch (error) {
+      task.status = 'failed';
+      task.lastError = error instanceof Error ? error.message : String(error);
+    } finally {
+      this.processingTasks.delete(task.id);
+    }
+  }
+
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  shutdown(timeout: number = 5000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+
+    this.isShuttingDown = true;
+
+    // Notify shutdown callbacks
+    for (const callback of this.shutdownCallbacks) {
+      callback();
+    }
+
+    const startTime = Date.now();
+    let completed = 0;
+    let cancelled = 0;
+
+    this.shutdownPromise = new Promise((resolve) => {
+      this.shutdownResolve = (summary) => resolve(summary);
+
+      // If there are no processing tasks, resolve immediately
+      if (this.processingTasks.size === 0) {
+        const elapsed = Date.now() - startTime;
+        this.shutdownResolve!({ completed, cancelled, elapsed });
+        return;
+      }
+
+      // Wait for all processing tasks to complete
+      this.processingPromise = new Promise((resolveProcessing) => {
+        this.processingResolve = resolveProcessing;
+      });
+
+      // Set timeout for force cancellation
+      this.shutdownTimeout = setTimeout(() => {
+        // Force cancel remaining processing tasks
+        for (const [taskId, task] of this.processingTasks) {
+          task.status = 'cancelled';
+          cancelled++;
+        }
+        this.processingTasks.clear();
+
+        if (this.shutdownResolve) {
+          const elapsed = Date.now() - startTime;
+          this.shutdownResolve({ completed, cancelled, elapsed });
+        }
+      }, timeout);
+
+      // Count already completed tasks
+      for (const task of this.tasks.values()) {
+        if (task.status === 'completed') {
+          completed++;
+        }
+      }
+    });
+
+    return this.shutdownPromise;
+  }
+
+  private checkDependencies(completedTask: Task): void {
+    // Find all tasks that depend on this task
+    for (const [, task] of this.tasks) {
+      if (task.dependsOn?.includes(completedTask.id) && task.status === 'pending') {
+        // Check if all dependencies are completed
+        const allCompleted = task.dependsOn.every((depId) => {
+          const depTask = this.tasks.get(depId);
+          return depTask?.status === 'completed';
+        });
+
+        if (allCompleted) {
+          task.availableAt = undefined;
+        }
+      }
+    }
+  }
+
+  private matchesCron(expression: string, minute: number, hour: number, day: number, month: number, dayOfWeek: number): boolean {
+    const parts = expression.split(' ');
+    if (parts.length !== 5) return false;
+
+    const [minuteExpr, hourExpr, dayExpr, monthExpr, dayOfWeekExpr] = parts;
+
+    return (
+      this.matchCronField(minuteExpr, minute) &&
+      this.matchCronField(hourExpr, hour) &&
+      this.matchCronField(dayExpr, day) &&
+      this.matchCronField(monthExpr, month) &&
+      this.matchCronField(dayOfWeekExpr, dayOfWeek)
+    );
+  }
+
+  private matchCronField(expr: string, value: number): boolean {
+    if (expr === '*') return true;
+    if (expr.startsWith('*/')) {
+      const step = parseInt(expr.slice(2), 10);
+      return step > 0 && value % step === 0;
+    }
+    const num = parseInt(expr, 10);
+    return !isNaN(num) && num === value;
+  }
+
+  private async runMiddleware(
+    middlewareStack: Middleware[],
+    index: number,
+    task: Task,
+    handler: (task: Task) => Promise<void>
+  ): Promise<void> {
+    if (index < middlewareStack.length) {
+      await middlewareStack[index](task, () =>
+        this.runMiddleware(middlewareStack, index + 1, task, handler)
+      );
+    } else {
+      await handler(task);
+    }
+  }
+}
