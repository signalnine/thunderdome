+import crypto from 'crypto';
+import express from 'express';
+import Database from 'better-sqlite3';
+
+function generateId(): string {
+  return crypto.randomUUID();
+}
+
+export function setupRoutes(app: express.Application, db: Database.Database): void {
+  // GET /docs/:id/versions/:version (must be before /docs/:id/versions)
+  app.get('/docs/:id/versions/:version', (req, res) => {
+    const { id, version } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const v = db.prepare(
+      'SELECT * FROM versions WHERE document_id = ? AND version = ?'
+    ).get(id, parseInt(version, 10)) as { content: string; version: number } | undefined;
+    if (!v) {
+      res.status(404).json({ error: 'Version not found' });
+      return;
+    }
+    res.json({ content: v.content, version: v.version });
+  });
+
+  // GET /docs/:id/versions
+  app.get('/docs/:id/versions', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const versions = db.prepare(
+      'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'
+    ).all(id);
+    res.json(versions);
+  });
+
+  // GET /docs
+  app.get('/docs', (_req, res) => {
+    const docs = db.prepare(
+      'SELECT * FROM documents ORDER BY created_at DESC'
+    ).all();
+    res.json(docs);
+  });
+
+  // POST /docs
+  app.post('/docs', (req, res) => {
+    const { title, content = '' } = req.body;
+    const id = generateId();
+    const now = new Date().toISOString();
+    db.prepare(
+      'INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, title, content, now, now);
+    db.prepare(
+      'INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)'
+    ).run(id, content);
+    res.status(201).json({ id, title, content, created_at: now, updated_at: now });
+  });
+
+  // GET /docs/:id
+  app.get('/docs/:id', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  // PUT /docs/:id
+  app.put('/docs/:id', (req, res) => {
+    const { id } = req.params;
+    const body = req.body;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id) as { title: string; content: string; created_at: string } | undefined;
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    const newTitle = (body as { title?: string }).title !== undefined ? (body as { title?: string }).title : doc.title;
+    const newContent = (body as { content?: string }).content !== undefined ? (body as { content?: string }).content : doc.content;
+    const now = new Date().toISOString();
+    db.prepare(
+      'UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?'
+    ).run(newTitle, newContent, now, id);
+    res.json({
+      id,
+      title: newTitle,
+      content: newContent,
+      created_at: doc.created_at,
+      updated_at: now,
+    });
+  });
+
+  // DELETE /docs/:id
+  app.delete('/docs/:id', (req, res) => {
+    const { id } = req.params;
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(id);
+    res.status(204).send();
+  });
+}
