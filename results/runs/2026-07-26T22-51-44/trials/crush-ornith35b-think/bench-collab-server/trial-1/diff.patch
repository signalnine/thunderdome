+import type { InsertOp, DeleteOp } from './models.js';
+
+export function applyOperation(content: string, op: InsertOp | DeleteOp): string {
+  if (op.type === 'insert') {
+    const insertOp = op as InsertOp;
+    return content.slice(0, insertOp.position) + insertOp.text + content.slice(insertOp.position);
+  }
+  if (op.type === 'delete') {
+    const deleteOp = op as DeleteOp;
+    return content.slice(0, deleteOp.position) + content.slice(deleteOp.position + deleteOp.count);
+  }
+  return content;
+}
+
+export function transformOperation(op1: InsertOp | DeleteOp, op2: InsertOp | DeleteOp): InsertOp | DeleteOp {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    if (op1.position <= op2.position) {
+      return op1;
+    }
+    return { ...op1, position: op1.position + (op2 as InsertOp).text.length };
+  }
+
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    const deleteOp = op2 as DeleteOp;
+    if (op1.position <= deleteOp.position) {
+      return op1;
+    }
+    if (op1.position >= deleteOp.position + deleteOp.count) {
+      return { ...op1, position: op1.position - deleteOp.count };
+    }
+    return { ...op1, position: deleteOp.position };
+  }
+
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    return { ...op1, position: op1.position - (op2 as InsertOp).text.length };
+  }
+
+  // delete vs delete
+  const deleteOp1 = op1 as DeleteOp;
+  const deleteOp2 = op2 as DeleteOp;
+  if (deleteOp1.position >= deleteOp2.position + deleteOp2.count) {
+    return { ...deleteOp1, position: deleteOp1.position - deleteOp2.count };
+  }
+  if (deleteOp1.position + deleteOp1.count <= deleteOp2.position) {
+    return deleteOp1;
+  }
+  const newStart = Math.max(deleteOp1.position, deleteOp2.position);
+  const newEnd = Math.min(deleteOp1.position + deleteOp1.count, deleteOp2.position + deleteOp2.count);
+  const newPos = newStart - deleteOp2.position;
+  const newCount = deleteOp1.count - (newEnd - newStart);
+  return { type: 'delete', position: newPos, count: Math.max(0, newCount) };
+}
+
+export function validateOperation(op: InsertOp | DeleteOp, contentLength: number): boolean {
+  if (op.type === 'insert') {
+    const insertOp = op as InsertOp;
+    return insertOp.position >= 0 && insertOp.position <= contentLength;
+  }
+  if (op.type === 'delete') {
+    const deleteOp = op as DeleteOp;
+    return deleteOp.position >= 0 && deleteOp.position + deleteOp.count <= contentLength;
+  }
+  return false;
+}
