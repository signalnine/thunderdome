@@ -0,0 +1,158 @@
+import crypto from 'crypto';
+import { WebSocketServer, WebSocket } from 'ws';
+import Database from 'better-sqlite3';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { InsertOp, DeleteOp } from './models.js';
+
+interface DocState {
+  version: number;
+  ops: (InsertOp | DeleteOp)[];
+  clients: Set<WebSocket>;
+}
+
+const docStates = new Map<string, DocState>();
+
+export function setupWebSocket(
+  wss: WebSocketServer,
+  db: Database.Database
+): void {
+  wss.on('connection', (ws, req) => {
+    const docId = (req.url || '').slice(1);
+
+    const doc = db.prepare(
+      'SELECT * FROM documents WHERE id = ?'
+    ).get(docId) as { id: string; title: string; content: string } | undefined;
+    if (!doc) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));
+      return;
+    }
+
+    let state = docStates.get(docId);
+    if (!state) {
+      const row = db.prepare(
+        'SELECT MAX(version) as max_version FROM versions WHERE document_id = ?'
+      ).get(docId) as { max_version: number | null };
+      state = {
+        version: row.max_version ?? 0,
+        ops: [],
+        clients: new Set<WebSocket>(),
+      };
+      docStates.set(docId, state);
+    }
+
+    const connId = crypto.randomUUID();
+    db.prepare(
+      'INSERT INTO active_connections (id, document_id) VALUES (?, ?)'
+    ).run(connId, docId);
+
+    state.clients.add(ws);
+
+    ws.send(
+      JSON.stringify({
+        type: 'sync',
+        content: doc.content,
+        version: state.version,
+      })
+    );
+
+    ws.on('message', (data) => {
+      let msg: Record<string, unknown>;
+      try {
+        msg = JSON.parse(data.toString());
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' }));
+        return;
+      }
+
+      if (msg.type !== 'operation') {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid message type' }));
+        return;
+      }
+
+      const rawOp = msg.operation as Record<string, unknown> | undefined;
+      if (!rawOp || typeof rawOp.type !== 'string' || !['insert', 'delete'].includes(rawOp.type)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation type' }));
+        return;
+      }
+
+      const op = rawOp as unknown as InsertOp | DeleteOp;
+
+      // Validate against current DB content
+      const currentDoc = db.prepare(
+        'SELECT content FROM documents WHERE id = ?'
+      ).get(docId) as { content: string } | undefined;
+      const currentContent = currentDoc?.content ?? '';
+
+      if (!validateOperation(op, currentContent.length)) {
+        ws.send(
+          JSON.stringify({ type: 'error', message: 'Operation out of bounds' })
+        );
+        return;
+      }
+
+      // Transform against concurrent operations
+      let transformedOp = op;
+      const clientVersion =
+        typeof msg.version === 'number' ? msg.version : undefined;
+      if (clientVersion !== undefined && clientVersion < state.version) {
+        for (let i = clientVersion; i < state.version; i++) {
+          transformedOp = transformOperation(transformedOp, state.ops[i]);
+        }
+      }
+
+      // Re-validate after transform
+      const updatedDoc = db.prepare(
+        'SELECT content FROM documents WHERE id = ?'
+      ).get(docId) as { content: string } | undefined;
+      const updatedContent = updatedDoc?.content ?? '';
+      if (!validateOperation(transformedOp, updatedContent.length)) {
+        ws.send(
+          JSON.stringify({ type: 'error', message: 'Operation out of bounds after transform' })
+        );
+        return;
+      }
+
+      // Apply
+      const newContent = applyOperation(updatedContent, transformedOp);
+      state.version++;
+      state.ops.push(transformedOp);
+
+      // Persist
+      db.prepare(
+        "UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?"
+      ).run(newContent, docId);
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+      ).run(docId, state.version, newContent, JSON.stringify(transformedOp));
+
+      // Ack to sender
+      ws.send(JSON.stringify({ type: 'ack', version: state.version }));
+
+      // Broadcast to others
+      const broadcastMsg = JSON.stringify({
+        type: 'operation',
+        operation: transformedOp,
+        version: state.version,
+      });
+      for (const client of state.clients) {
+        if (client !== ws && client.readyState === WebSocket.OPEN) {
+          client.send(broadcastMsg);
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      state.clients.delete(ws);
+      try {
+        db.prepare(
+          'DELETE FROM active_connections WHERE id = ?'
+        ).run(connId);
+      } catch {
+        // connection may already be gone
+      }
+      if (state.clients.size === 0) {
+        docStates.delete(docId);
+      }
+    });
+  });
+}
