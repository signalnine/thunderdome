+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import jwt from 'jsonwebtoken';
+import crypto from 'crypto';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const JWT_SECRET = process.env.JWT_SECRET || 'analytics-dashboard-secret';
+
+const router = Router();
+
+function hashPassword(password: string): string {
+  return crypto.createHash('sha256').update(password).digest('hex');
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const { email, password, tenant_id } = req.body;
+
+  if (!email || !password || !tenant_id) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'Missing required fields');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  const passwordHash = hashPassword(password);
+
+  try {
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, email, passwordHash, tenant_id, 'viewer');
+  } catch (err: unknown) {
+    if (err instanceof Error && err.message.includes('UNIQUE constraint failed')) {
+      throw new AppError(409, 'DUPLICATE_EMAIL', 'Email already registered');
+    }
+    throw err;
+  }
+
+  res.status(201).json({ id, email, tenant_id, role: 'viewer' });
+});
+
+router.post('/login', (req: Request, res: Response) => {
+  const { email, password } = req.body;
+
+  if (!email || !password) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'Missing required fields');
+  }
+
+  const db = getDb();
+  const passwordHash = hashPassword(password);
+  const user = db
+    .prepare('SELECT * FROM users WHERE email = ? AND password_hash = ?')
+    .get(email, passwordHash) as Record<string, unknown> | undefined;
+
+  if (!user) {
+    throw new AppError(401, 'AUTH_ERROR', 'Invalid credentials');
+  }
+
+  const token = jwt.sign(
+    {
+      sub: user.id as string,
+      tid: user.tenant_id as string,
+      iat: Math.floor(Date.now() / 1000),
+      exp: Math.floor(Date.now() / 1000) + 86400,
+    },
+    JWT_SECRET
+  );
+
+  res.json({ token, user: { id: user.id, email: user.email, tenant_id: user.tenant_id, role: user.role } });
+});
+
+router.get('/me', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const db = getDb();
+  const result = db
+    .prepare('SELECT id, email, tenant_id, role FROM users WHERE id = ?')
+    .get(user.id) as Record<string, unknown> | undefined;
+
+  if (!result) {
+    throw new AppError(404, 'NOT_FOUND', 'User not found');
+  }
+
+  res.json(result);
+});
+
+router.patch('/:id/role', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const db = getDb();
+
+  const currentUser = db
+    .prepare('SELECT role FROM users WHERE id = ?')
+    .get(user.id) as Record<string, unknown> | undefined;
+
+  if (!currentUser || currentUser.role !== 'admin') {
+    throw new AppError(403, 'FORBIDDEN', 'Admin role required');
+  }
+
+  const { id } = req.params;
+  const { role } = req.body;
+
+  if (!['admin', 'viewer', 'editor'].includes(role)) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'Invalid role');
+  }
+
+  db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, id);
+  const updated = db
+    .prepare('SELECT id, email, tenant_id, role FROM users WHERE id = ?')
+    .get(id) as Record<string, unknown> | undefined;
+
+  if (!updated) {
+    throw new AppError(404, 'NOT_FOUND', 'User not found');
+  }
+
+  res.json(updated);
+});
+
+export default router;
