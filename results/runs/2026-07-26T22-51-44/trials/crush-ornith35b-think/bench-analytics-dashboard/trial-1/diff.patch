+import { Router, Request, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.post('/', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { name, properties, timestamp, user_id, session_id } = req.body;
+
+  if (!name) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'Event name is required');
+  }
+
+  const db = getDb();
+  const id = uuidv4();
+  const eventTimestamp = timestamp || new Date().toISOString();
+  const props = properties ? JSON.stringify(properties) : '{}';
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, user.tenantId, name, props, eventTimestamp, user_id || null, session_id || null);
+
+  res.status(201).json({
+    id,
+    name,
+    tenant_id: user.tenantId,
+    timestamp: eventTimestamp,
+    properties: properties || {},
+  });
+});
+
+router.post('/batch', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { events } = req.body;
+
+  if (!events || !Array.isArray(events) || events.length === 0) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'Events array is required and cannot be empty');
+  }
+
+  const db = getDb();
+  const insert = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  );
+
+  const insertedEvents: Record<string, unknown>[] = [];
+
+  db.transaction(() => {
+    for (const event of events) {
+      if (!event.name) {
+        throw new AppError(400, 'VALIDATION_ERROR', 'Each event must have a name');
+      }
+
+      const id = uuidv4();
+      const timestamp = event.timestamp || new Date().toISOString();
+      const properties = event.properties ? JSON.stringify(event.properties) : '{}';
+
+      insert.run(id, user.tenantId, event.name, properties, timestamp, event.user_id || null, event.session_id || null);
+
+      insertedEvents.push({
+        id,
+        name: event.name,
+        tenant_id: user.tenantId,
+        timestamp,
+        properties: event.properties || {},
+      });
+    }
+  })();
+
+  res.status(201).json({ inserted: insertedEvents.length, events: insertedEvents });
+});
+
+export default router;
