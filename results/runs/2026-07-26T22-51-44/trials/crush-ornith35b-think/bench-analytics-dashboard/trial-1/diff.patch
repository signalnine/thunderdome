+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.post('/count', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { event_name, start, end } = req.body;
+
+  if (!event_name) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'event_name is required');
+  }
+
+  const db = getDb();
+  let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+  const params: unknown[] = [user.tenantId, event_name];
+
+  if (start) {
+    sql += ' AND timestamp >= ?';
+    params.push(start);
+  }
+  if (end) {
+    sql += ' AND timestamp <= ?';
+    params.push(end);
+  }
+
+  const result = db.prepare(sql).get(...params) as { count: number };
+  res.json({ count: result.count });
+});
+
+router.post('/timeseries', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { event_name, bucket, start, end } = req.body;
+
+  if (!event_name) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'event_name is required');
+  }
+
+  const db = getDb();
+  let sql = 'SELECT ';
+
+  switch (bucket) {
+    case 'hour':
+      sql += "strftime('%Y-%m-%d %H:00', timestamp) as bucket";
+      break;
+    case 'day':
+      sql += "strftime('%Y-%m-%d', timestamp) as bucket";
+      break;
+    case 'week':
+      sql += "strftime('%Y-W%W', timestamp) as bucket";
+      break;
+    case 'month':
+      sql += "strftime('%Y-%m', timestamp) as bucket";
+      break;
+    default:
+      sql += "strftime('%Y-%m-%d', timestamp) as bucket";
+  }
+
+  sql += ', COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+  const params: unknown[] = [user.tenantId, event_name];
+
+  if (start) {
+    sql += ' AND timestamp >= ?';
+    params.push(start);
+  }
+  if (end) {
+    sql += ' AND timestamp <= ?';
+    params.push(end);
+  }
+
+  sql += ' GROUP BY bucket ORDER BY bucket';
+
+  const rows = db.prepare(sql).all(...params) as Array<{ bucket: string; count: number }>;
+  res.json({ data: rows });
+});
+
+router.post('/breakdown', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { event_name, property_key, start, end } = req.body;
+
+  if (!event_name) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'event_name is required');
+  }
+
+  const db = getDb();
+  const sql = `
+    SELECT 
+      json_extract(properties, '$.' || ?) as property_value,
+      COUNT(*) as count
+    FROM events
+    WHERE tenant_id = ? AND name = ?
+  `;
+
+  const params: unknown[] = [property_key || '', user.tenantId, event_name];
+
+  if (start) {
+    sql += ' AND timestamp >= ?';
+    params.push(start);
+  }
+  if (end) {
+    sql += ' AND timestamp <= ?';
+    params.push(end);
+  }
+
+  sql += ' GROUP BY property_value ORDER BY count DESC';
+
+  const rows = db.prepare(sql).all(...params) as Array<{ property_value: string | null; count: number }>;
+  
+  const data = rows.map(row => ({
+    property_value: row.property_value || '',
+    count: row.count,
+  }));
+
+  res.json({ data });
+});
+
+router.post('/funnel', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { steps, start, end } = req.body;
+
+  if (!steps || !Array.isArray(steps) || steps.length === 0) {
+    throw new AppError(400, 'VALIDATION_ERROR', 'steps array is required');
+  }
+
+  const db = getDb();
+  const funnelSteps = steps.map(step => {
+    let sql = 'SELECT COUNT(DISTINCT session_id) as count FROM events WHERE tenant_id = ? AND name = ?';
+    const params: unknown[] = [user.tenantId, step];
+
+    if (start) {
+      sql += ' AND timestamp >= ?';
+      params.push(start);
+    }
+    if (end) {
+      sql += ' AND timestamp <= ?';
+      params.push(end);
+    }
+
+    const result = db.prepare(sql).get(...params) as { count: number };
+    return { step, count: result.count };
+  });
+
+  res.json({ steps: funnelSteps });
+});
+
+export default router;
