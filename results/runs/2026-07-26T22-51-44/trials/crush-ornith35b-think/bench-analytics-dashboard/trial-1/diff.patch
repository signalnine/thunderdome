+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { AppError } from '../errors';
+
+const router = Router();
+
+router.get('/events', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { format } = req.query;
+
+  if (format !== 'csv' && format !== 'json') {
+    throw new AppError(400, 'VALIDATION_ERROR', 'Format must be csv or json');
+  }
+
+  const db = getDb();
+  const events = db
+    .prepare('SELECT id, name, properties, timestamp, user_id, session_id FROM events WHERE tenant_id = ? ORDER BY timestamp')
+    .all(user.tenantId) as Array<Record<string, unknown>>;
+
+  if (format === 'csv') {
+    const header = 'id,name,properties,timestamp,user_id,session_id';
+    const rows = events.map(e => {
+      const props = e.properties ? JSON.stringify(e.properties) : '{}';
+      return `${e.id},${e.name},${props},${e.timestamp},${e.user_id || ''},${e.session_id || ''}`;
+    });
+
+    res.set('Content-Type', 'text/csv');
+    res.send([header, ...rows].join('\n'));
+  } else {
+    res.json(events);
+  }
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response) => {
+  const user = (req as Record<string, unknown>).user as { id: string; tenantId: string };
+  const { id } = req.params;
+  const db = getDb();
+
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(id, user.tenantId) as Record<string, unknown> | undefined;
+
+  if (!dashboard) {
+    throw new AppError(404, 'NOT_FOUND', 'Dashboard not found');
+  }
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(id) as Array<Record<string, unknown>>;
+
+  res.json({
+    dashboard: {
+      id: dashboard.id,
+      name: dashboard.name,
+      tenant_id: dashboard.tenant_id,
+      owner_id: dashboard.owner_id,
+      config: dashboard.config ? JSON.parse(dashboard.config as string) : {},
+      created_at: dashboard.created_at,
+      updated_at: dashboard.updated_at,
+    },
+    widgets: widgets.map(w => ({
+      id: w.id,
+      type: w.type,
+      config: w.config ? JSON.parse(w.config as string) : {},
+      position_x: w.position_x,
+      position_y: w.position_y,
+      width: w.width,
+      height: w.height,
+    })),
+  });
+});
+
+export default router;
