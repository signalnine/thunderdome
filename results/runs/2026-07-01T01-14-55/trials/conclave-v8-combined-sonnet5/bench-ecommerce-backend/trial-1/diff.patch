+import { randomUUID } from 'crypto';
+import { EventBus } from '../bus.js';
+import { Events, OrderService, OrderStatus } from '../types.js';
+
+interface Order {
+  id: string;
+  userId: string;
+  cartId: string;
+  total: number;
+  status: OrderStatus;
+}
+
+const ALLOWED_TRANSITIONS: Record<OrderStatus, OrderStatus[]> = {
+  [OrderStatus.PENDING]: [OrderStatus.CONFIRMED, OrderStatus.CANCELLED],
+  [OrderStatus.CONFIRMED]: [OrderStatus.SHIPPED, OrderStatus.CANCELLED],
+  [OrderStatus.SHIPPED]: [OrderStatus.DELIVERED, OrderStatus.CANCELLED],
+  [OrderStatus.DELIVERED]: [],
+  [OrderStatus.CANCELLED]: [],
+};
+
+export function createOrderService(bus: EventBus): OrderService {
+  const orders = new Map<string, Order>();
+
+  return {
+    createOrder(userId: string, cartId: string, total: number): string {
+      const id = randomUUID();
+      const order: Order = { id, userId, cartId, total, status: OrderStatus.PENDING };
+      orders.set(id, order);
+      void bus.emit(Events.ORDER_CREATED, { orderId: id, userId, cartId, total });
+      return id;
+    },
+
+    getOrder(orderId: string) {
+      const order = orders.get(orderId);
+      if (!order) return null;
+      return { id: order.id, userId: order.userId, status: order.status, total: order.total };
+    },
+
+    updateStatus(orderId: string, status: OrderStatus): void {
+      const order = orders.get(orderId);
+      if (!order) return;
+      const allowed = ALLOWED_TRANSITIONS[order.status];
+      if (!allowed.includes(status)) {
+        throw new Error(`Invalid order status transition from ${order.status} to ${status}`);
+      }
+      const previousStatus = order.status;
+      order.status = status;
+      void bus.emit(Events.ORDER_STATUS_CHANGED, { orderId, status, previousStatus });
+    },
+
+    listOrders(userId: string) {
+      return [...orders.values()]
+        .filter(o => o.userId === userId)
+        .map(o => ({ id: o.id, status: o.status, total: o.total }));
+    },
+  };
+}
