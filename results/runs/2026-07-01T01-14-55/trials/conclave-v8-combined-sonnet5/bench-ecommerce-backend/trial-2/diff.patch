+import { randomUUID } from 'node:crypto';
+import type { EventBus } from '../bus.js';
+import type { PaymentService } from '../types.js';
+import { Events, PaymentStatus } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+  delayMs?: number;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const successfulTransactions = new Set<string>();
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      if (options.delayMs) {
+        await new Promise((resolve) => setTimeout(resolve, options.delayMs));
+      }
+      void amount;
+
+      if (options.simulateTimeout) {
+        const result = { status: PaymentStatus.TIMEOUT, error: 'Payment processing timed out' };
+        await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: result.status, error: result.error });
+        return result;
+      }
+
+      if (options.simulateFailure) {
+        const result = { status: PaymentStatus.FAILED, error: 'Payment was declined' };
+        await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: result.status, error: result.error });
+        return result;
+      }
+
+      const transactionId = randomUUID();
+      successfulTransactions.add(transactionId);
+      const result = { status: PaymentStatus.SUCCESS, transactionId };
+      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, status: result.status, transactionId });
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      if (!successfulTransactions.has(transactionId)) return false;
+      successfulTransactions.delete(transactionId);
+      return true;
+    },
+  };
+}
