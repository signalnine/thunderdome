+++ b/src/analytics/index.ts
@@ -0,0 +1,65 @@
+import type { EventBus } from '../bus.js';
+import type { AnalyticsService, CartUpdatedEvent, OrderCreatedEvent, PaymentProcessedEvent } from '../types.js';
+import { Events, PaymentStatus } from '../types.js';
+
+const TRACKED_EVENTS: string[] = Object.values(Events);
+
+export function createAnalyticsService(bus: EventBus): AnalyticsService {
+  const eventCounts = new Map<string, number>();
+  const orderTotals = new Map<string, number>();
+  const cartIds = new Set<string>();
+  const cartItems = new Map<string, Array<{ productId: string; quantity: number }>>();
+  const productCounts = new Map<string, number>();
+  let ordersCreated = 0;
+  let revenue = 0;
+
+  for (const eventType of TRACKED_EVENTS) {
+    bus.on(eventType, () => {
+      eventCounts.set(eventType, (eventCounts.get(eventType) ?? 0) + 1);
+    });
+  }
+
+  bus.on(Events.CART_UPDATED, (payload) => {
+    const { cartId, items } = payload as CartUpdatedEvent;
+    cartIds.add(cartId);
+    cartItems.set(cartId, items);
+  });
+
+  bus.on(Events.ORDER_CREATED, (payload) => {
+    const { orderId, cartId, total } = payload as OrderCreatedEvent;
+    orderTotals.set(orderId, total);
+    ordersCreated += 1;
+    const items = cartItems.get(cartId) ?? [];
+    for (const item of items) {
+      productCounts.set(item.productId, (productCounts.get(item.productId) ?? 0) + item.quantity);
+    }
+  });
+
+  bus.on(Events.PAYMENT_PROCESSED, (payload) => {
+    const { orderId, status } = payload as PaymentProcessedEvent;
+    if (status !== PaymentStatus.SUCCESS) return;
+    revenue += orderTotals.get(orderId) ?? 0;
+  });
+
+  return {
+    getEventCount(eventType: string): number {
+      return eventCounts.get(eventType) ?? 0;
+    },
+
+    getRevenue(): number {
+      return revenue;
+    },
+
+    getConversionRate(): number {
+      if (cartIds.size === 0) return 0;
+      return ordersCreated / cartIds.size;
+    },
+
+    getTopProducts(limit: number) {
+      return [...productCounts.entries()]
+        .sort((a, b) => b[1] - a[1])
+        .slice(0, limit)
+        .map(([productId, count]) => ({ productId, count }));
+    },
+  };
+}
