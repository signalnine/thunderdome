@@ -0,0 +1,79 @@
+import { randomUUID } from 'node:crypto';
+import type { EventBus } from '../bus.js';
+import type { CartService } from '../types.js';
+import { Events } from '../types.js';
+
+interface CartItem {
+  productId: string;
+  quantity: number;
+}
+
+interface Cart {
+  id: string;
+  userId: string;
+  items: CartItem[];
+}
+
+export function createCartService(bus: EventBus): CartService {
+  const carts = new Map<string, Cart>();
+
+  function emitUpdate(cart: Cart): void {
+    void bus.emit(Events.CART_UPDATED, {
+      cartId: cart.id,
+      userId: cart.userId,
+      items: cart.items.map((item) => ({ ...item })),
+    });
+  }
+
+  return {
+    createCart(userId: string): string {
+      const id = randomUUID();
+      carts.set(id, { id, userId, items: [] });
+      return id;
+    },
+
+    addItem(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (existing) {
+        existing.quantity += quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cart);
+    },
+
+    removeItem(cartId: string, productId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = cart.items.filter((item) => item.productId !== productId);
+      emitUpdate(cart);
+    },
+
+    getCart(cartId: string) {
+      const cart = carts.get(cartId);
+      if (!cart) return null;
+      return { id: cart.id, userId: cart.userId, items: cart.items.map((item) => ({ ...item })) };
+    },
+
+    clearCart(cartId: string): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      cart.items = [];
+      emitUpdate(cart);
+    },
+
+    updateQuantity(cartId: string, productId: string, quantity: number): void {
+      const cart = carts.get(cartId);
+      if (!cart) return;
+      const existing = cart.items.find((item) => item.productId === productId);
+      if (existing) {
+        existing.quantity = quantity;
+      } else {
+        cart.items.push({ productId, quantity });
+      }
+      emitUpdate(cart);
+    },
+  };
+}
