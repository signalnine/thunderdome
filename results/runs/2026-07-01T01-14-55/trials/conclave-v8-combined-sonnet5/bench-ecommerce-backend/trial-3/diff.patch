new file mode 100644
index 0000000..947d371
--- /dev/null
+++ b/src/payment/index.ts
@@ -0,0 +1,51 @@
+import { randomUUID } from 'crypto';
+import { EventBus } from '../bus.js';
+import { PaymentService, PaymentStatus, Events } from '../types.js';
+
+export interface PaymentServiceOptions {
+  simulateFailure?: boolean;
+  simulateTimeout?: boolean;
+}
+
+interface Transaction {
+  transactionId: string;
+  orderId: string;
+  amount: number;
+  status: PaymentStatus;
+  refunded: boolean;
+}
+
+export function createPaymentService(bus: EventBus, options: PaymentServiceOptions = {}): PaymentService {
+  const transactions = new Map<string, Transaction>();
+
+  return {
+    async processPayment(orderId: string, amount: number) {
+      await new Promise((resolve) => setTimeout(resolve, 1));
+
+      if (options.simulateTimeout) {
+        const result = { status: PaymentStatus.TIMEOUT, error: 'Payment timed out' };
+        await bus.emit(Events.PAYMENT_PROCESSED, { orderId, ...result });
+        return result;
+      }
+
+      if (options.simulateFailure) {
+        const result = { status: PaymentStatus.FAILED, error: 'Payment declined' };
+        await bus.emit(Events.PAYMENT_PROCESSED, { orderId, ...result });
+        return result;
+      }
+
+      const transactionId = randomUUID();
+      transactions.set(transactionId, { transactionId, orderId, amount, status: PaymentStatus.SUCCESS, refunded: false });
+      const result = { status: PaymentStatus.SUCCESS, transactionId };
+      await bus.emit(Events.PAYMENT_PROCESSED, { orderId, ...result });
+      return result;
+    },
+
+    async refund(transactionId: string): Promise<boolean> {
+      const tx = transactions.get(transactionId);
+      if (!tx || tx.status !== PaymentStatus.SUCCESS || tx.refunded) return false;
+      tx.refunded = true;
+      return true;
+    },
+  };
+}
