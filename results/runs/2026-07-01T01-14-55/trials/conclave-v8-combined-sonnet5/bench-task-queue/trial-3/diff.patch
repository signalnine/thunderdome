+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+export type TaskPayload = any;
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: TaskPayload;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  attempts: number;
+  maxRetries: number;
+  backoffMs: number;
+  dependsOn: string[];
+  lastError?: string;
+  failCount: number;
+  seq: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface DependencyInfo {
+  taskId: string;
+  status: TaskStatus;
+}
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: TaskPayload;
+  active: boolean;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+export type TaskHandler = (task: Task) => Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+interface QueueState {
+  name: string;
+  pending: Task[];
+  dlq: Task[];
+  concurrencyLimit: number;
+  processingCount: number;
+  middleware: Middleware[];
+}
+
+interface ShutdownState {
+  outstanding: Set<string>;
+  completed: number;
+  cancelled: number;
+  startTime: number;
+  timer: ReturnType<typeof setTimeout> | null;
+  resolved: boolean;
+  promise: Promise<ShutdownSummary>;
+  finalize: () => void;
+}
+
+export class TaskQueue {
+  private queues = new Map<string, QueueState>();
+  private tasksById = new Map<string, Task>();
+  private seqCounter = 0;
+
+  private progressMap = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, ProgressCallback[]>();
+
+  private schedules = new Map<string, Schedule>();
+  private scheduleLastBucket = new Map<string, number>();
+
+  private shutdownCallbacks: Array<() => void> = [];
+  private shuttingDown = false;
+  private shutdownState: ShutdownState | null = null;
+
+  private getOrCreateQueue(name: string): QueueState {
+    let q = this.queues.get(name);
+    if (!q) {
+      q = { name, pending: [], dlq: [], concurrencyLimit: Infinity, processingCount: 0, middleware: [] };
+      this.queues.set(name, q);
+    }
+    return q;
+  }
+
+  private dependencyReaches(startId: string, targetId: string): boolean {
+    const visited = new Set<string>();
+    const stack = [startId];
+    while (stack.length > 0) {
+      const current = stack.pop() as string;
+      if (current === targetId) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+      const task = this.tasksById.get(current);
+      if (task) stack.push(...task.dependsOn);
+    }
+    return false;
+  }
+
+  private dependenciesSatisfied(task: Task): boolean {
+    return task.dependsOn.every((id) => this.tasksById.get(id)?.status === 'completed');
+  }
+
+  enqueue(queueName: string, payload: TaskPayload, options: EnqueueOptions = {}): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue: queue is shutting down');
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error('priority must be between 1 and 10');
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    for (const depId of dependsOn) {
+      if (!this.tasksById.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    const id = randomUUID();
+    for (const depId of dependsOn) {
+      if (this.dependencyReaches(depId, id)) {
+        throw new Error('Circular dependency detected');
+      }
+    }
+
+    let availableAt: Date;
+    if (options.runAt) {
+      availableAt = options.runAt;
+    } else if (options.delay) {
+      availableAt = new Date(Date.now() + options.delay);
+    } else {
+      availableAt = new Date();
+    }
+
+    const task: Task = {
+      id,
+      queueName,
+      payload,
+      status: 'pending',
+      createdAt: new Date(),
+      priority,
+      availableAt,
+      attempts: 0,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasksById.set(id, task);
+    const q = this.getOrCreateQueue(queueName);
+    q.pending.push(task);
+    return task;
+  }
+
+  dequeue(queueName = 'default'): Task | null {
+    const q = this.queues.get(queueName);
+    if (!q) return null;
+    if (q.processingCount >= q.concurrencyLimit) return null;
+
+    const now = Date.now();
+    let best: Task | null = null;
+    let bestIndex = -1;
+
+    for (let i = 0; i < q.pending.length; i++) {
+      const t = q.pending[i];
+      if (t.availableAt.getTime() > now) continue;
+      if (!this.dependenciesSatisfied(t)) continue;
+
+      if (
+        best === null ||
+        t.priority < best.priority ||
+        (t.priority === best.priority && t.availableAt.getTime() < best.availableAt.getTime()) ||
+        (t.priority === best.priority &&
+          t.availableAt.getTime() === best.availableAt.getTime() &&
+          t.seq < best.seq)
+      ) {
+        best = t;
+        bestIndex = i;
+      }
+    }
+
+    if (best === null) return null;
+
+    q.pending.splice(bestIndex, 1);
+    best.status = 'processing';
+    best.attempts += 1;
+    q.processingCount += 1;
+    return best;
+  }
+
+  size(queueName = 'default'): number {
+    return this.queueSize(queueName);
+  }
+
+  queueSize(queueName: string): number {
+    const q = this.queues.get(queueName);
+    return q ? q.pending.length : 0;
+  }
+
+  listQueues(): string[] {
+    return Array.from(this.queues.keys());
+  }
+
+  fail(taskId: string, error?: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.getOrCreateQueue(task.queueName);
+    q.processingCount = Math.max(0, q.processingCount - 1);
+
+    task.failCount += 1;
+    task.lastError = error;
+
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoff);
+      q.pending.push(task);
+    } else {
+      task.status = 'failed';
+      q.dlq.push(task);
+    }
+
+    this.notifyShutdown(taskId, 'completed');
+  }
+
+  complete(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'processing') return;
+
+    const q = this.getOrCreateQueue(task.queueName);
+    q.processingCount = Math.max(0, q.processingCount - 1);
+    task.status = 'completed';
+
+    this.notifyShutdown(taskId, 'completed');
+  }
+
+  getDLQ(queueName: string): Task[] {
+    const q = this.queues.get(queueName);
+    return q ? [...q.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasksById.get(taskId);
+    if (!task || task.status !== 'failed') return null;
+
+    const q = this.getOrCreateQueue(task.queueName);
+    const idx = q.dlq.findIndex((t) => t.id === taskId);
+    if (idx === -1) return null;
+
+    q.dlq.splice(idx, 1);
+    task.attempts = 0;
+    task.status = 'pending';
+    task.availableAt = new Date();
+    q.pending.push(task);
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const q = this.queues.get(queueName);
+    if (q) q.dlq = [];
+  }
+
+  getDependencies(taskId: string): DependencyInfo[] {
+    const task = this.tasksById.get(taskId);
+    if (!task) return [];
+    return task.dependsOn.map((id) => ({
+      taskId: id,
+      status: this.tasksById.get(id)?.status ?? 'pending',
+    }));
+  }
+
+  setConcurrency(queueName: string, limit: number): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const q = this.getOrCreateQueue(queueName);
+    return { current: q.processingCount, max: q.concurrencyLimit };
+  }
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error('percent must be between 0 and 100');
+    }
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progressMap.set(taskId, info);
+    const callbacks = this.progressCallbacks.get(taskId) ?? [];
+    for (const cb of callbacks) cb(info);
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progressMap.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    const list = this.progressCallbacks.get(taskId) ?? [];
+    list.push(callback);
+    this.progressCallbacks.set(taskId, list);
+    return () => {
+      const idx = list.indexOf(callback);
+      if (idx !== -1) list.splice(idx, 1);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasksById.get(taskId);
+    if (!task) return;
+
+    if (task.status === 'pending') {
+      const q = this.getOrCreateQueue(task.queueName);
+      const idx = q.pending.findIndex((t) => t.id === taskId);
+      if (idx !== -1) q.pending.splice(idx, 1);
+      task.status = 'cancelled';
+      this.notifyShutdown(taskId, 'cancelled');
+    } else if (task.status === 'processing') {
+      const q = this.getOrCreateQueue(task.queueName);
+      q.processingCount = Math.max(0, q.processingCount - 1);
+      task.status = 'cancelled';
+      this.notifyShutdown(taskId, 'cancelled');
+    }
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: TaskPayload): Schedule {
+    const id = randomUUID();
+    const sched: Schedule = { id, queueName, cronExpression, taskTemplate, active: true };
+    this.schedules.set(id, sched);
+    this.scheduleLastBucket.set(id, Math.floor(Date.now() / 60000));
+    return sched;
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) sched.active = false;
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const all = Array.from(this.schedules.values()).filter((s) => s.active);
+    return queueName ? all.filter((s) => s.queueName === queueName) : all;
+  }
+
+  private matchCronField(field: string, value: number): boolean {
+    if (field === '*') return true;
+    if (field.startsWith('*/')) {
+      const n = parseInt(field.slice(2), 10);
+      return n > 0 && value % n === 0;
+    }
+    return parseInt(field, 10) === value;
+  }
+
+  private cronMatches(expr: string, date: Date): boolean {
+    const parts = expr.split(' ');
+    const minuteField = parts[0];
+    const hourField = parts[1];
+    return this.matchCronField(minuteField, date.getUTCMinutes()) &&
+      this.matchCronField(hourField, date.getUTCHours());
+  }
+
+  tick(): void {
+    const now = new Date();
+    const bucket = Math.floor(now.getTime() / 60000);
+
+    for (const sched of this.schedules.values()) {
+      if (!sched.active) continue;
+      if (!this.cronMatches(sched.cronExpression, now)) continue;
+
+      const lastBucket = this.scheduleLastBucket.get(sched.id);
+      if (lastBucket !== bucket) {
+        this.enqueue(sched.queueName, sched.taskTemplate);
+        this.scheduleLastBucket.set(sched.id, bucket);
+      }
+    }
+  }
+
+  use(queueName: string, middleware: Middleware): void {
+    const q = this.getOrCreateQueue(queueName);
+    q.middleware.push(middleware);
+  }
+
+  async process(queueName: string, handler: TaskHandler): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const q = this.getOrCreateQueue(queueName);
+    const middlewares = q.middleware;
+    let handlerRan = false;
+
+    const dispatch = async (i: number): Promise<void> => {
+      if (i === middlewares.length) {
+        handlerRan = true;
+        await handler(task);
+        return;
+      }
+      await middlewares[i](task, () => dispatch(i + 1));
+    };
+
+    try {
+      await dispatch(0);
+      if (handlerRan) {
+        this.complete(task.id);
+      }
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+    }
+  }
+
+  onShutdown(callback: () => void): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  private notifyShutdown(taskId: string, kind: 'completed' | 'cancelled'): void {
+    const state = this.shutdownState;
+    if (!state || state.resolved) return;
+    if (!state.outstanding.has(taskId)) return;
+
+    state.outstanding.delete(taskId);
+    if (kind === 'completed') {
+      state.completed += 1;
+    } else {
+      state.cancelled += 1;
+    }
+
+    if (state.outstanding.size === 0) {
+      state.finalize();
+    }
+  }
+
+  shutdown(timeout = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownState) return this.shutdownState.promise;
+
+    this.shuttingDown = true;
+    const startTime = Date.now();
+
+    const outstanding = new Set<string>();
+    for (const task of this.tasksById.values()) {
+      if (task.status === 'processing') outstanding.add(task.id);
+    }
+
+    for (const cb of this.shutdownCallbacks) {
+      cb();
+    }
+
+    let resolvePromise!: (summary: ShutdownSummary) => void;
+    const promise = new Promise<ShutdownSummary>((resolve) => {
+      resolvePromise = resolve;
+    });
+
+    const state: ShutdownState = {
+      outstanding,
+      completed: 0,
+      cancelled: 0,
+      startTime,
+      timer: null,
+      resolved: false,
+      promise,
+      finalize: () => {},
+    };
+
+    state.finalize = () => {
+      if (state.resolved) return;
+      state.resolved = true;
+      if (state.timer) clearTimeout(state.timer);
+      resolvePromise({
+        completed: state.completed,
+        cancelled: state.cancelled,
+        elapsed: Date.now() - state.startTime,
+      });
+    };
+
+    this.shutdownState = state;
+
+    if (outstanding.size === 0) {
+      state.finalize();
+    } else {
+      state.timer = setTimeout(() => {
+        const remaining = Array.from(state.outstanding);
+        for (const id of remaining) {
+          this.cancel(id);
+        }
+        state.finalize();
+      }, timeout);
+    }
+
+    return promise;
+  }
+}
