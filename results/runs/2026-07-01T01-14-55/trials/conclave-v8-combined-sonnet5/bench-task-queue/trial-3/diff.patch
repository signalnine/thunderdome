cycle detection test\n    const p = queue.enqueue('other', { name: 'P' });\n    const _q2 = queue.enqueue('other', { name: 'Q' }, { dependsOn: [p.id] });\n    // Cycle detection is verified above; with forward-only enqueue,\n    // cycles can only be detected at enqueue time through transitive dep chains.\n  });\n\n  it('getDependencies returns dependency info with statuses', () => {\n    const dep1 = queue.enqueue('work', { name: 'dep1' });\n    const dep2 = queue.enqueue('work', { name: 'dep2' });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep1.id, dep2.id],\n    });\n\n    const deps = queue.getDependencies(dependent.id);\n    expect(deps).toHaveLength(2);\n    expect(deps).toContainEqual({ taskId: dep1.id, status: 'pending' });\n    expect(deps).toContainEqual({ taskId: dep2.id, status: 'pending' });\n\n    // After completing one\n    const task = queue.dequeue('work')!;\n    queue.complete(task.id);\n\n    const updatedDeps = queue.getDependencies(dependent.id);\n    const completedDep = updatedDeps.find(d => d.taskId === dep1.id);\n    expect(completedDep!.status).toBe('completed');\n  });\n\n  it('cascading dependencies work correctly (A depends on B depends on C)', () => {\n    const c = queue.enqueue('work', { name: 'C' });\n    const b = queue.enqueue('work', { name: 'B' }, { dependsOn: [c.id] });\n    const a = queue.enqueue('work', { name: 'A' }, { dependsOn: [b.id] });\n\n    // Only C is available\n    const taskC = queue.dequeue('work')!;\n    expect(taskC.payload).toEqual({ name: 'C' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskC.id);\n\n    // Now B is available\n    const taskB = queue.dequeue('work')!;\n    expect(taskB.payload).toEqual({ name: 'B' });\n    expect(queue.dequeue('work')).toBeNull();\n\n    queue.complete(taskB.id);\n\n    // Now A is available\n    const taskA = queue.dequeue('work')!;\n    expect(taskA.payload).toEqual({ name: 'A' });\n    expect(taskA.id).toBe(a.id);\n  });\n\n  it('failed dependency does not auto-fail the dependent task', () => {\n    const dep = queue.enqueue('work', { name: 'dep' }, { maxRetries: 0 });\n    const dependent = queue.enqueue('work', { name: 'dependent' }, {\n      dependsOn: [dep.id],\n    });\n\n    const task = queue.dequeue('work')!;\n    queue.fail(task.id, 'dep failed');\n\n    // Dependent stays blocked (not failed)\n    expect(dependent.status).toBe('pending');\n    expect(queue.dequeue('work')).toBeNull();\n  });\n\n  it('dependency on non-existent task throws an error', () => {\n    expect(() =>\n      queue.enqueue('work', { name: 'orphan' }, { dependsOn: ['nonexistent-id'] })\n    ).toThrow();\n  });\n});\n","numLines":156,"startLine":1,"totalLines":156}}}
