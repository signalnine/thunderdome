+import { randomUUID } from 'node:crypto';
+
+export type TaskStatus = 'pending' | 'processing' | 'completed' | 'failed' | 'cancelled';
+
+export interface Task {
+  id: string;
+  queueName: string;
+  payload: unknown;
+  status: TaskStatus;
+  createdAt: Date;
+  priority: number;
+  availableAt: Date;
+  maxRetries: number;
+  backoffMs: number;
+  attempts: number;
+  dependsOn: string[];
+  lastError?: unknown;
+  failCount: number;
+  seq: number;
+}
+
+export interface EnqueueOptions {
+  priority?: number;
+  delay?: number;
+  runAt?: Date;
+  maxRetries?: number;
+  backoffMs?: number;
+  dependsOn?: string[];
+}
+
+export interface ProgressInfo {
+  percent: number;
+  message?: string;
+  updatedAt: Date;
+}
+
+export type ProgressCallback = (info: ProgressInfo) => void;
+
+export interface ConcurrencyInfo {
+  current: number;
+  max: number;
+}
+
+export interface Schedule {
+  id: string;
+  queueName: string;
+  cronExpression: string;
+  taskTemplate: unknown;
+  active: boolean;
+}
+
+export type Middleware = (task: Task, next: () => Promise<void>) => Promise<void>;
+
+export interface ShutdownSummary {
+  completed: number;
+  cancelled: number;
+  elapsed: number;
+}
+
+export type ShutdownCallback = () => void;
+
+interface QueueState {
+  name: string;
+  pending: Set<string>;
+  processingCount: number;
+  concurrencyLimit: number;
+  dlq: Task[];
+  middlewares: Middleware[];
+}
+
+interface InternalSchedule extends Schedule {
+  intervalMs: number;
+  nextDue: number;
+}
+
+export class TaskQueue {
+  private tasks = new Map<string, Task>();
+  private queues = new Map<string, QueueState>();
+  private seqCounter = 0;
+
+  private progress = new Map<string, ProgressInfo>();
+  private progressCallbacks = new Map<string, Set<ProgressCallback>>();
+
+  private schedules = new Map<string, InternalSchedule>();
+
+  private shuttingDown = false;
+  private shutdownPromise: Promise<ShutdownSummary> | null = null;
+  private shutdownCallbacks: ShutdownCallback[] = [];
+  private shutdownRemaining: Set<string> | null = null;
+  private resolveShutdownWait: (() => void) | null = null;
+
+  private getQueue(name: string): QueueState {
+    let queue = this.queues.get(name);
+    if (!queue) {
+      queue = {
+        name,
+        pending: new Set(),
+        processingCount: 0,
+        concurrencyLimit: 0,
+        dlq: [],
+        middlewares: [],
+      };
+      this.queues.set(name, queue);
+    }
+    return queue;
+  }
+
+  // ---- Phase 1/2/3/4/5/7: enqueue ----
+
+  enqueue(payload: unknown): Task;
+  enqueue(queueName: string, payload: unknown, options?: EnqueueOptions): Task;
+  enqueue(a: unknown, b?: unknown, c: EnqueueOptions = {}): Task {
+    if (this.shuttingDown) {
+      throw new Error('Cannot enqueue: TaskQueue is shutting down');
+    }
+
+    let queueName: string;
+    let payload: unknown;
+    let options: EnqueueOptions;
+
+    if (arguments.length >= 2 && typeof a === 'string') {
+      queueName = a;
+      payload = b;
+      options = c;
+    } else {
+      queueName = 'default';
+      payload = a;
+      options = {};
+    }
+
+    const priority = options.priority ?? 5;
+    if (priority < 1 || priority > 10) {
+      throw new Error(`Priority must be between 1 and 10, got ${priority}`);
+    }
+
+    const dependsOn = options.dependsOn ?? [];
+    if (dependsOn.length > 0) {
+      this.validateDependencies(dependsOn);
+    }
+
+    const now = new Date();
+    let availableAt = now;
+    if (options.runAt) {
+      availableAt = options.runAt;
+    } else if (options.delay) {
+      availableAt = new Date(now.getTime() + options.delay);
+    }
+
+    const task: Task = {
+      id: randomUUID(),
+      queueName,
+      payload,
+      status: 'pending',
+      createdAt: now,
+      priority,
+      availableAt,
+      maxRetries: options.maxRetries ?? 3,
+      backoffMs: options.backoffMs ?? 1000,
+      attempts: 0,
+      dependsOn,
+      failCount: 0,
+      seq: this.seqCounter++,
+    };
+
+    this.tasks.set(task.id, task);
+    const queue = this.getQueue(queueName);
+    queue.pending.add(task.id);
+
+    return task;
+  }
+
+  dequeue(queueName: string = 'default'): Task | null {
+    const queue = this.queues.get(queueName);
+    if (!queue) return null;
+
+    if (queue.concurrencyLimit > 0 && queue.processingCount >= queue.concurrencyLimit) {
+      return null;
+    }
+
+    const now = Date.now();
+    let best: Task | null = null;
+
+    for (const id of queue.pending) {
+      const task = this.tasks.get(id);
+      if (!task) continue;
+      if (task.availableAt.getTime() > now) continue;
+      if (this.isBlockedByDependencies(task)) continue;
+
+      if (!best) {
+        best = task;
+        continue;
+      }
+
+      if (task.priority !== best.priority) {
+        if (task.priority < best.priority) best = task;
+        continue;
+      }
+
+      const taskAvail = task.availableAt.getTime();
+      const bestAvail = best.availableAt.getTime();
+      if (taskAvail !== bestAvail) {
+        if (taskAvail < bestAvail) best = task;
+        continue;
+      }
+
+      if (task.seq < best.seq) best = task;
+    }
+
+    if (!best) return null;
+
+    queue.pending.delete(best.id);
+    best.status = 'processing';
+    best.attempts += 1;
+    queue.processingCount += 1;
+
+    return best;
+  }
+
+  size(queueName: string = 'default'): number {
+    return this.queueSize(queueName);
+  }
+
+  // ---- Phase 2: named queues ----
+
+  listQueues(): string[] {
+    return [...this.queues.keys()];
+  }
+
+  queueSize(queueName: string): number {
+    const queue = this.queues.get(queueName);
+    return queue ? queue.pending.size : 0;
+  }
+
+  // ---- Phase 5: retry with backoff / Phase 7: complete ----
+
+  complete(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    if (task.status === 'processing') {
+      const queue = this.getQueue(task.queueName);
+      queue.processingCount = Math.max(0, queue.processingCount - 1);
+    }
+
+    task.status = 'completed';
+    this.notifyShutdownSettle(task.id);
+  }
+
+  fail(taskId: string, error?: unknown): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    const queue = this.getQueue(task.queueName);
+    if (task.status === 'processing') {
+      queue.processingCount = Math.max(0, queue.processingCount - 1);
+    }
+
+    task.lastError = error;
+    task.failCount += 1;
+
+    if (task.attempts <= task.maxRetries) {
+      const backoff = task.backoffMs * Math.pow(2, task.attempts - 1);
+      task.status = 'pending';
+      task.availableAt = new Date(Date.now() + backoff);
+      queue.pending.add(task.id);
+    } else {
+      task.status = 'failed';
+      queue.dlq.push(task);
+    }
+
+    this.notifyShutdownSettle(task.id);
+  }
+
+  // ---- Phase 6: dead letter queue ----
+
+  getDLQ(queueName: string): Task[] {
+    const queue = this.queues.get(queueName);
+    return queue ? [...queue.dlq] : [];
+  }
+
+  retryDLQ(taskId: string): Task | null {
+    const task = this.tasks.get(taskId);
+    if (!task) return null;
+
+    const queue = this.getQueue(task.queueName);
+    const idx = queue.dlq.findIndex((t) => t.id === taskId);
+    if (idx === -1) return null;
+
+    queue.dlq.splice(idx, 1);
+    task.attempts = 0;
+    task.status = 'pending';
+    task.availableAt = new Date();
+    queue.pending.add(task.id);
+
+    return task;
+  }
+
+  clearDLQ(queueName: string): void {
+    const queue = this.queues.get(queueName);
+    if (queue) {
+      queue.dlq = [];
+    }
+  }
+
+  // ---- Phase 7: dependencies ----
+
+  private validateDependencies(dependsOn: string[]): void {
+    for (const depId of dependsOn) {
+      if (!this.tasks.has(depId)) {
+        throw new Error(`Dependency task not found: ${depId}`);
+      }
+    }
+
+    const visited = new Set<string>();
+    const stack = new Set<string>();
+
+    const dfs = (id: string): boolean => {
+      if (stack.has(id)) return true;
+      if (visited.has(id)) return false;
+      visited.add(id);
+      stack.add(id);
+      const t = this.tasks.get(id);
+      if (t) {
+        for (const d of t.dependsOn) {
+          if (dfs(d)) return true;
+        }
+      }
+      stack.delete(id);
+      return false;
+    };
+
+    for (const depId of dependsOn) {
+      if (dfs(depId)) {
+        throw new Error(`Circular dependency detected involving task ${depId}`);
+      }
+    }
+  }
+
+  private isBlockedByDependencies(task: Task): boolean {
+    if (task.dependsOn.length === 0) return false;
+    return task.dependsOn.some((id) => {
+      const dep = this.tasks.get(id);
+      return !dep || dep.status !== 'completed';
+    });
+  }
+
+  getDependencies(taskId: string): Array<{ taskId: string; status: TaskStatus }> {
+    const task = this.tasks.get(taskId);
+    if (!task) {
+      throw new Error(`Task not found: ${taskId}`);
+    }
+    return task.dependsOn.map((id) => {
+      const dep = this.tasks.get(id);
+      return { taskId: id, status: dep ? dep.status : 'completed' };
+    });
+  }
+
+  // ---- Phase 8: concurrency control ----
+
+  setConcurrency(queueName: string, limit: number): void {
+    const queue = this.getQueue(queueName);
+    queue.concurrencyLimit = limit;
+  }
+
+  getConcurrency(queueName: string): ConcurrencyInfo {
+    const queue = this.getQueue(queueName);
+    return {
+      current: queue.processingCount,
+      max: queue.concurrencyLimit > 0 ? queue.concurrencyLimit : Infinity,
+    };
+  }
+
+  // ---- Phase 9: progress and cancellation ----
+
+  updateProgress(taskId: string, percent: number, message?: string): void {
+    if (percent < 0 || percent > 100) {
+      throw new Error(`Progress percent must be between 0 and 100, got ${percent}`);
+    }
+
+    const info: ProgressInfo = { percent, message, updatedAt: new Date() };
+    this.progress.set(taskId, info);
+
+    const callbacks = this.progressCallbacks.get(taskId);
+    if (callbacks) {
+      for (const cb of callbacks) {
+        cb(info);
+      }
+    }
+  }
+
+  getProgress(taskId: string): ProgressInfo | null {
+    return this.progress.get(taskId) ?? null;
+  }
+
+  onProgress(taskId: string, callback: ProgressCallback): () => void {
+    let callbacks = this.progressCallbacks.get(taskId);
+    if (!callbacks) {
+      callbacks = new Set();
+      this.progressCallbacks.set(taskId, callbacks);
+    }
+    callbacks.add(callback);
+
+    return () => {
+      callbacks!.delete(callback);
+    };
+  }
+
+  cancel(taskId: string): void {
+    const task = this.tasks.get(taskId);
+    if (!task) return;
+
+    if (task.status === 'pending') {
+      const queue = this.getQueue(task.queueName);
+      queue.pending.delete(task.id);
+      task.status = 'cancelled';
+    } else if (task.status === 'processing') {
+      const queue = this.getQueue(task.queueName);
+      queue.processingCount = Math.max(0, queue.processingCount - 1);
+      task.status = 'cancelled';
+    } else {
+      return;
+    }
+
+    this.notifyShutdownSettle(task.id);
+  }
+
+  // ---- Phase 10: recurring tasks (cron) ----
+
+  private cronIntervalMs(expr: string): number {
+    const parts = expr.trim().split(/\s+/);
+    const [minute, hour] = parts;
+
+    if (minute.startsWith('*/')) {
+      const n = parseInt(minute.slice(2), 10);
+      return n * 60 * 1000;
+    }
+    if (minute === '0' && hour === '*') {
+      return 60 * 60 * 1000;
+    }
+    if (minute === '0' && hour === '0') {
+      return 24 * 60 * 60 * 1000;
+    }
+
+    throw new Error(`Unsupported cron expression: ${expr}`);
+  }
+
+  schedule(queueName: string, cronExpression: string, taskTemplate: unknown): Schedule {
+    const intervalMs = this.cronIntervalMs(cronExpression);
+    const now = Date.now();
+    const nextDue = (Math.floor(now / intervalMs) + 1) * intervalMs;
+
+    const sched: InternalSchedule = {
+      id: randomUUID(),
+      queueName,
+      cronExpression,
+      taskTemplate,
+      active: true,
+      intervalMs,
+      nextDue,
+    };
+
+    this.schedules.set(sched.id, sched);
+
+    return {
+      id: sched.id,
+      queueName: sched.queueName,
+      cronExpression: sched.cronExpression,
+      taskTemplate: sched.taskTemplate,
+      active: sched.active,
+    };
+  }
+
+  unschedule(scheduleId: string): void {
+    const sched = this.schedules.get(scheduleId);
+    if (sched) {
+      sched.active = false;
+    }
+  }
+
+  listSchedules(queueName?: string): Schedule[] {
+    const result: Schedule[] = [];
+    for (const s of this.schedules.values()) {
+      if (!s.active) continue;
+      if (queueName && s.queueName !== queueName) continue;
+      result.push({
+        id: s.id,
+        queueName: s.queueName,
+        cronExpression: s.cronExpression,
+        taskTemplate: s.taskTemplate,
+        active: s.active,
+      });
+    }
+    return result;
+  }
+
+  tick(): void {
+    const now = Date.now();
+    for (const s of this.schedules.values()) {
+      if (!s.active) continue;
+      while (now >= s.nextDue) {
+        this.enqueue(s.queueName, s.taskTemplate);
+        s.nextDue += s.intervalMs;
+      }
+    }
+  }
+
+  // ---- Phase 11: middleware pipeline ----
+
+  use(queueName: string, middleware: Middleware): void {
+    const queue = this.getQueue(queueName);
+    queue.middlewares.push(middleware);
+  }
+
+  async process(queueName: string, handler: (task: Task) => Promise<void> | void): Promise<void> {
+    const task = this.dequeue(queueName);
+    if (!task) return;
+
+    const queue = this.getQueue(queueName);
+    const middlewares = queue.middlewares;
+
+    let handlerCalled = false;
+    const runHandler = async (): Promise<void> => {
+      handlerCalled = true;
+      await handler(task);
+    };
+
+    const dispatch = async (index: number): Promise<void> => {
+      if (index === middlewares.length) {
+        await runHandler();
+        return;
+      }
+      const mw = middlewares[index];
+      await mw(task, () => dispatch(index + 1));
+    };
+
+    try {
+      await dispatch(0);
+    } catch (err) {
+      this.fail(task.id, err instanceof Error ? err.message : String(err));
+      return;
+    }
+
+    if (handlerCalled) {
+      this.complete(task.id);
+    }
+  }
+
+  // ---- Phase 12: graceful shutdown ----
+
+  onShutdown(callback: ShutdownCallback): void {
+    this.shutdownCallbacks.push(callback);
+  }
+
+  private notifyShutdownSettle(taskId: string): void {
+    if (this.shutdownRemaining && this.shutdownRemaining.has(taskId)) {
+      this.shutdownRemaining.delete(taskId);
+      if (this.shutdownRemaining.size === 0 && this.resolveShutdownWait) {
+        this.resolveShutdownWait();
+      }
+    }
+  }
+
+  shutdown(timeout: number = 30000): Promise<ShutdownSummary> {
+    if (this.shutdownPromise) {
+      return this.shutdownPromise;
+    }
+
+    this.shuttingDown = true;
+    const start = Date.now();
+
+    for (const cb of this.shutdownCallbacks) {
+      cb();
+    }
+
+    const processingIds: string[] = [];
+    for (const task of this.tasks.values()) {
+      if (task.status === 'processing') {
+        processingIds.push(task.id);
+      }
+    }
+
+    this.shutdownPromise = new Promise<ShutdownSummary>((resolve) => {
+      if (processingIds.length === 0) {
+        resolve({ completed: 0, cancelled: 0, elapsed: Date.now() - start });
+        return;
+      }
+
+      this.shutdownRemaining = new Set(processingIds);
+      let timer: ReturnType<typeof setTimeout> | null = null;
+
+      const finish = (): void => {
+        if (timer) clearTimeout(timer);
+
+        let completed = 0;
+        let cancelled = 0;
+        for (const id of processingIds) {
+          const task = this.tasks.get(id);
+          if (!task) continue;
+          if (task.status === 'completed') completed++;
+          else if (task.status === 'cancelled') cancelled++;
+        }
+
+        this.shutdownRemaining = null;
+        this.resolveShutdownWait = null;
+        resolve({ completed, cancelled, elapsed: Date.now() - start });
+      };
+
+      this.resolveShutdownWait = finish;
+
+      timer = setTimeout(() => {
+        if (this.shutdownRemaining) {
+          for (const id of this.shutdownRemaining) {
+            const task = this.tasks.get(id);
+            if (task && task.status === 'processing') {
+              const queue = this.getQueue(task.queueName);
+              queue.processingCount = Math.max(0, queue.processingCount - 1);
+              task.status = 'cancelled';
+            }
+          }
+        }
+        finish();
+      }, timeout);
+    });
+
+    return this.shutdownPromise;
+  }
+}
