l({ a: 2, b: 2 });\n  });\n\n  it('new field added independently on both sides with different values conflicts', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, extra: 'theirs' });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 1, extra: 'ours' });\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    expect(result.conflicts[0].path).toBe('extra');\n  });\n\n  it('field removed on one side and unchanged on other is treated as a change (removal wins)', () => {\n    store.create('doc1', { a: 1, b: 2 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1 }); // b removed\n\n    store.switchBranch('main');\n    // main unchanged\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n});","originalFile":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { DocumentStore } from '../src/index.js';\n\ndescribe('Document CRUD', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('create + get round-trips content', () => {\n    store.create('doc1', { a: 1 });\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('create throws on duplicate id', () => {\n    store.create('doc1', { a: 1 });\n    expect(() => store.create('doc1', { a: 2 })).toThrow();\n  });\n\n  it('get throws on missing id', () => {\n    expect(() => store.get('nope')).toThrow();\n  });\n\n  it('get throws on deleted id', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(() => store.get('doc1')).toThrow();\n  });\n\n  it('get returns a deep clone', () => {\n    store.create('doc1', { a: { b: 1 } });\n    const result = store.get('doc1') as any;\n    result.a.b = 999;\n    expect(store.get('doc1')).toEqual({ a: { b: 1 } });\n  });\n\n  it('create deep clones input', () => {\n    const input = { a: { b: 1 } };\n    store.create('doc1', input);\n    input.a.b = 999;\n    expect(store.get('doc1')).toEqual({ a: { b: 1 } });\n  });\n\n  it('update replaces content', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    expect(store.get('doc1')).toEqual({ a: 2 });\n  });\n\n  it('update throws on missing id', () => {\n    expect(() => store.update('nope', { a: 1 })).toThrow();\n  });\n\n  it('delete removes doc and further ops throw', () => {\n    store.create('doc1', { a: 1 });\n    store.delete('doc1');\n    expect(() => store.get('doc1')).toThrow();\n    expect(() => store.update('doc1', { a: 2 })).toThrow();\n    expect(() => store.delete('doc1')).toThrow();\n  });\n\n  it('delete throws on missing id', () => {\n    expect(() => store.delete('nope')).toThrow();\n  });\n});\n\ndescribe('Version history', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('create produces one version', () => {\n    store.create('doc1', { a: 1 });\n    expect(store.getHistory('doc1')).toHaveLength(1);\n  });\n\n  it('update appends versions in chronological order', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    store.update('doc1', { a: 3 });\n    const history = store.getHistory('doc1');\n    expect(history).toHaveLength(3);\n    expect(history.map((v) => v.content)).toEqual([{ a: 1 }, { a: 2 }, { a: 3 }]);\n  });\n\n  it('versions have unique ids and timestamps', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    const history = store.getHistory('doc1');\n    expect(history[0].id).not.toEqual(history[1].id);\n    expect(typeof history[0].timestamp).toBe('number');\n  });\n\n  it('getVersion returns content of specific version', () => {\n    store.create('doc1', { a: 1 });\n    store.update('doc1', { a: 2 });\n    const history = store.getHistory('doc1');\n    expect(store.getVersion('doc1', history[0].id)).toEqual({ a: 1 });\n    expect(store.getVersion('doc1', history[1].id)).toEqual({ a: 2 });\n  });\n\n  it('getVersion throws on bad doc id or version id', () => {\n    store.create('doc1', { a: 1 });\n    expect(() => store.getVersion('nope', 'v1')).toThrow();\n    expect(() => store.getVersion('doc1', 'bad-version')).toThrow();\n  });\n});\n\ndescribe('Branching', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('default branch is main', () => {\n    expect(store.getBranch()).toBe('main');\n    expect(store.listBranches()).toContain('main');\n  });\n\n  it('createBranch branches from current state', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    expect(store.get('doc1')).toEqual({ a: 1 });\n  });\n\n  it('createBranch with fromBranch branches from named branch', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature1');\n    store.switchBranch('feature1');\n    store.update('doc1', { a: 2 });\n\n    store.switchBranch('main');\n    store.createBranch('feature2', 'feature1');\n    store.switchBranch('feature2');\n    expect(store.get('doc1')).toEqual({ a: 2 });\n  });\n\n  it('createBranch throws on duplicate name', () => {\n    store.createBranch('feature');\n    expect(() => store.createBranch('feature')).toThrow();\n  });\n\n  it('switchBranch changes active scope', () => {\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    expect(store.getBranch()).toBe('feature');\n  });\n\n  it('switchBranch throws on unknown branch', () => {\n    expect(() => store.switchBranch('nope')).toThrow();\n  });\n\n  it('listBranches includes all created branches', () => {\n    store.createBranch('feature1');\n    store.createBranch('feature2');\n    expect(store.listBranches().sort()).toEqual(['feature1', 'feature2', 'main']);\n  });\n\n  it('writes on one branch are invisible on another', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 2 });\n    store.create('doc2', { x: true });\n\n    store.switchBranch('main');\n    expect(store.get('doc1')).toEqual({ a: 1 });\n    expect(() => store.get('doc2')).toThrow();\n  });\n});\n\ndescribe('Merge - no conflicts', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('merge with no changes is a no-op', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n  });\n\n  it('change only on source branch is auto-applied', () => {\n    store.create('doc1', { a: 1, b: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 1, b: 2 });\n\n    store.switchBranch('main');\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(result.merged['doc1']).toEqual({ a: 1, b: 2 });\n    expect(store.get('doc1')).toEqual({ a: 1, b: 2 });\n  });\n\n  it('change only on current branch stays and merge applies cleanly', () => {\n    store.create('doc1', { a: 1, b: 1 });\n    store.createBranch('feature');\n    store.update('doc1', { a: 1, b: 2 }); // change on main (current)\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(store.get('doc1')).toEqual({ a: 1, b: 2 });\n  });\n\n  it('same field changed identically on both sides -> no conflict', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc