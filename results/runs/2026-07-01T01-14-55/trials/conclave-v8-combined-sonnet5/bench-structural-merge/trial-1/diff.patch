":"import { deepClone, deepEqual } from './clone.js';\nimport { mergeObjects } from './merge.js';\nimport type { Conflict, IDocumentStore, MergeResult, Version } from './types.js';\n\ninterface DocState {\n  versions: Version[];\n  deleted: boolean;\n}\n\ntype BranchDocs = Map<string, DocState>;\n\ntype PendingAction =\n  | { type: 'set'; id: string; content: object }\n  | { type: 'delete'; id: string }\n  | { type: 'adopt'; id: string; versions: Version[] };\n\nconst MAIN_BRANCH = 'main';\n\nexport class DocumentStore implements IDocumentStore {\n  private branches = new Map<string, BranchDocs>();\n  private currentBranch = MAIN_BRANCH;\n  private versionCounter = 0;\n\n  constructor() {\n    this.branches.set(MAIN_BRANCH, new Map());\n  }\n\n  private nextVersionId(): string {\n    this.versionCounter += 1;\n    return `v${this.versionCounter}`;\n  }\n\n  private currentDocs(): BranchDocs {\n    return this.branches.get(this.currentBranch)!;\n  }\n\n  private requireBranch(name: string): BranchDocs {\n    const docs = this.branches.get(name);\n    if (!docs) throw new Error(`Branch \"${name}\" does not exist`);\n    return docs;\n  }\n\n  private requireDoc(docs: BranchDocs, id: string): DocState {\n    const doc = docs.get(id);\n    if (!doc || doc.deleted) throw new Error(`Document \"${id}\" does not exist`);\n    return doc;\n  }\n\n  private latestContent(doc: DocState): object {\n    return doc.versions[doc.versions.length - 1].content;\n  }\n\n  // ---- Document CRUD ----\n\n  create(id: string, content: object): void {\n    const docs = this.currentDocs();\n    const existing = docs.get(id);\n    if (existing && !existing.deleted) {\n      throw new Error(`Document \"${id}\" already exists on branch \"${this.currentBranch}\"`);\n    }\n    const version: Version = { id: this.nextVersionId(), timestamp: Date.now(), content: deepClone(content) };\n    if (existing) {\n      existing.versions.push(version);\n      existing.deleted = false;\n    } else {\n      docs.set(id, { versions: [version], deleted: false });\n    }\n  }\n\n  get(id: string): object {\n    const doc = this.requireDoc(this.currentDocs(), id);\n    return deepClone(this.latestContent(doc));\n  }\n\n  update(id: string, content: object): void {\n    const doc = this.requireDoc(this.currentDocs(), id);\n    doc.versions.push({ id: this.nextVersionId(), timestamp: Date.now(), content: deepClone(content) });\n  }\n\n  delete(id: string): void {\n    const doc = this.requireDoc(this.currentDocs(), id);\n    doc.deleted = true;\n  }\n\n  // ---- Version history ----\n\n  getHistory(id: string): Version[] {\n    const doc = this.currentDocs().get(id);\n    if (!doc) throw new Error(`Document \"${id}\" does not exist`);\n    return doc.versions.map((v) => ({ id: v.id, timestamp: v.timestamp, content: deepClone(v.content) }));\n  }\n\n  getVersion(id: string, versionId: string): object {\n    const doc = this.currentDocs().get(id);\n    if (!doc) throw new Error(`Document \"${id}\" does not exist`);\n    const version = doc.versions.find((v) => v.id === versionId);\n    if (!version) throw new Error(`Version \"${versionId}\" does not exist for document \"${id}\"`);\n    return deepClone(version.content);\n  }\n\n  // ---- Branching ----\n\n  createBranch(name: string, fromBranch?: string): void {\n    if (this.branches.has(name)) throw new Error(`Branch \"${name}\" already exists`);\n    const sourceName = fromBranch ?? this.currentBranch;\n    const sourceDocs = this.requireBranch(sourceName);\n    const cloned: BranchDocs = new Map();\n    for (const [docId, docState] of sourceDocs) {\n      cloned.set(docId, { versions: [...docState.versions], deleted: docState.deleted });\n    }\n    this.branches.set(name, cloned);\n  }\n\n  switchBranch(name: string): void {\n    this.requireBranch(name);\n    this.currentBranch = name;\n  }\n\n  getBranch(): string {\n    return this.currentBranch;\n  }\n\n  listBranches(): string[] {\n    return [...this.branches.keys()];\n  }\n\n  // ---- Merging ----\n\n  merge(sourceBranch: string): MergeResult {\n    const oursDocs = this.currentDocs();\n    const theirsDocs = this.requireBranch(sourceBranch);\n\n    const allIds = new Set([...oursDocs.keys(), ...theirsDocs.keys()]);\n    const merged: Record<string, object> = {};\n    const conflicts: Conflict[] = [];\n    const actions: PendingAction[] = [];\n\n    for (const id of allIds) {\n      const oursState = oursDocs.get(id);\n      const theirsState = theirsDocs.get(id);\n\n      const oursExists = !!oursState && !oursState.deleted;\n      const theirsExists = !!theirsState && !theirsState.deleted;\n\n      // Doc only known on theirs side (ours never created it).\n      if (!oursState) {\n        if (theirsExists) {\n          const content = this.latestContent(theirsState!);\n          merged[id] = deepClone(content);\n          actions.push({ type: 'adopt', id, versions: [...theirsState!.versions] });\n        }\n        continue;\n      }\n\n      // Doc only known on ours side (theirs never created it) -> nothing to merge.\n      if (!theirsState) {\n        if (oursExists) merged[id] = deepClone(this.latestContent(oursState));\n        continue;\n      }\n\n      // Both branches know this document id.\n      const baseVersion = findCommonAncestor(oursState.versions, theirsState.versions);\n      const baseContent = baseVersion?.content;\n\n      if (!oursExists && !theirsExists) {\n        continue; // deleted on both sides, nothing to do\n      }\n\n      if (!oursExists && theirsExists) {\n        const theirsContent = this.latestContent(theirsState);\n        if (deepEqual(theirsContent, baseContent)) {\n          // theirs unchanged, ours deleted -> keep deletion\n          continue;\n        }\n        conflicts.push({ documentId: id, path: '', base: deepClone(baseContent), ours: undefined, theirs: deepClone(theirsContent) });\n        continue;\n      }\n\n      if (oursExists && !theirsExists) {\n        const oursContent = this.latestContent(oursState);\n        if (deepEqual(oursContent, baseContent)) {\n          // ours unchanged, theirs deleted -> apply deletion\n          merged[id] = undefined as unknown as object;\n          actions.push({ type: 'delete', id });\n          continue;\n        }\n        merged[id] = deepClone(oursContent);\n        conflicts.push({ documentId: id, path: '', base: deepClone(baseContent), ours: deepClone(oursContent), theirs: undefined });\n        continue;\n      }\n\n      // Both sides have live content -> structural three-way field merge.\n      const oursContent = this.latestContent(oursState);\n      const theirsContent = this.latestContent(theirsState);\n      const fieldConflicts: { path: string; base: unknown; ours: unknown; theirs: unknown }[] = [];\n      const mergedContent = mergeObjects(baseContent, oursContent, theirsContent, '', fieldConflicts);\n\n      merged[id] = mergedContent;\n      for (const fc of fieldConflicts) {\n        conflicts.push({ documentId: id, path: fc.path, base: fc.base, ours: fc.ours, theirs: fc.theirs });\n      }\n\n      if (!deepEqual(mergedContent, oursContent)) {\n        actions.push({ type: 'set', id, content: mergedContent });\n      }\n    }\n\n    // `merged` should only reflect documents that still have content.\n    for (const key of Object.keys(merged)) {\n      if (merged[key] === undefined) delete merged[key];\n    }\n\n    const applied = conflicts.length === 0;\n    if (applied) {\n      for (const action of actions) {\n        this.applyAction(oursDocs, action);\n      }\n    }\n\n    return { merged, conflicts, applied };\n  }\n\n  private applyAction(docs: BranchDocs, action: PendingAction): void {\n    if (action.type === 'set') {\n      const doc = docs.get(action.id)!;\n      doc.versions.push({ id: this.nextVersionId(), timestamp: Date.now(), content: deepClone(action.content) });\n      doc.deleted = false;\n    } else if (action.type === 'delete') {\n      const doc = docs.get(action.id)!;\n      doc.deleted = true;\n    } else if (action.type === 'adopt') {\n      docs.set(action.id, { versions: [...action.versions], deleted: false });\n    }\n  }\n}\n\nfunction findCommonAncestor(oursVersions: Version[], theirsVersions: Version[]): Version | undefined {\n  const theirsIds = new Set(theirsVersions.map((v) => v.id));\n  for (let i = oursVersions.length - 1; i >= 0; i--) {\n    if (theirsIds.has(oursVersions[i].id)) return oursVersions[i];\n  }\n  return undefined;\n}\n","numLines":244,"startLine":1,"totalLines":244}}}
