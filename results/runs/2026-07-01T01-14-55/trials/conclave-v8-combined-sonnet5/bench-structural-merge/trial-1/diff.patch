erge('feature');\n    expect(result.applied).toBe(true);\n    expect(() => store.get('doc1')).toThrow();\n  });\n\n  it('unrelated documents changed independently merge cleanly', () => {\n    store.create('doc1', { a: 1 });\n    store.create('doc2', { b: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc2', { b: 2 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 2 });\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(true);\n    expect(result.conflicts).toEqual([]);\n    expect(store.get('doc1')).toEqual({ a: 2 });\n    expect(store.get('doc2')).toEqual({ b: 2 });\n  });\n\n  it('successful merge mutates current branch history', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 2 });\n\n    store.switchBranch('main');\n    const beforeLen = store.getHistory('doc1').length;\n    store.merge('feature');\n    expect(store.getHistory('doc1').length).toBeGreaterThan(beforeLen);\n  });\n});\n\ndescribe('Merge - conflicts', () => {\n  let store: DocumentStore;\n  beforeEach(() => {\n    store = new DocumentStore();\n  });\n\n  it('same field changed to different values -> conflict reported', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranch('feature');\n    store.switchBranch('feature');\n    store.update('doc1', { a: 2 });\n\n    store.switchBranch('main');\n    store.update('doc1', { a: 3 });\n\n    const result = store.merge('feature');\n    expect(result.applied).toBe(false);\n    expect(result.conflicts).toHaveLength(1);\n    const c = result.conflicts[0];\n    expect(c.documentId).toBe('doc1');\n    expect(c.path).toBe('a');\n    expect(c.base).toBe(1);\n    expect(c.ours).toBe(3);\n    expect(c.theirs).toBe(2);\n  });\n\n  it('conflicting merge does not apply changes to current branch', () => {\n    store.create('doc1', { a: 1 });\n    store.createBranc