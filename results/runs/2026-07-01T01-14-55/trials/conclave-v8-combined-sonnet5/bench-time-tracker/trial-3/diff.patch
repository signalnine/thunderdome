ect(task1!.endTime).toBeTruthy();\n48\t    expect(entry2.taskName).toBe('task 2');\n49\t    expect(entry2.endTime).toBeNull();\n50\t  });\n51\t\n52\t  // 4. stop() when nothing is running throws/returns error\n53\t  it('stop() when nothing is running throws an error', () => {\n54\t    const tracker = new TimeTracker(filePath);\n55\t    expect(() => tracker.stop()).toThrow();\n56\t  });\n57\t\n58\t  // 5. getLog() returns all entries\n59\t  it('getLog() returns all entries', () => {\n60\t    const tracker = new TimeTracker(filePath);\n61\t    tracker.start('task 1');\n62\t    tracker.stop();\n63\t    tracker.start('task 2');\n64\t    tracker.stop();\n65\t    const log = tracker.getLog();\n66\t    expect(log).toHaveLength(2);\n67\t    expect(log[0].taskName).toBe('task 1');\n68\t    expect(log[1].taskName).toBe('task 2');\n69\t  });\n70\t\n71\t  // 6. getLog({ since: date }) filters to entries starting on or after that date\n72\t  it('getLog({ since }) filters entries starting on or after that date', () => {\n73\t    const tracker = new TimeTracker(filePath);\n74\t    tracker.start('old task');\n75\t    tracker.stop();\n76\t\n77\t    // Manually modify the first entry to be old\n78\t    const log = tracker.getLog();\n79\t    const oldDate = new Date('2020-01-01T00:00:00.000Z');\n80\t    log[0].startTime = oldDate.toISOString();\n81\t    log[0].endTime = new Date('2020-01-01T01:00:00.000Z').toISOString();\n82\t\n83\t    // Create a new tracker to write the modified data\n84\t    // Instead, let's use a different approach: start tasks at known times\n85\t    const tracker2 = new TimeTracker(filePath);\n86\t    tracker2.start('new task');\n87\t    tracker2.stop();\n88\t\n89\t    const since = new Date(Date.now() - 1000); // 1 second ago\n90\t    const filtered = tracker2.getLog({ since });\n91\t    // The 'new task' should be included, the manually-dated one depends on timing\n92\t    expect(filtered.length).toBeGreaterThanOrEqual(1);\n93\t    expect(filtered.some(e => e