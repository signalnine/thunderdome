ed before, still running after)\n    // So a running task with no endTime should be included if it's still active\n    const since = new Date(Date.now() + 60000); // 1 minute from now\n    const filtered = tracker.getLog({ since });\n    expect(filtered.some(e => e.taskName === 'spanning task')).toBe(true);\n  });\n\n  // 8. getSummary() returns object keyed by task name with total duration in ms\n  it('getSummary() returns object keyed by task name with total duration in ms', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('coding');\n    // Small delay to ensure non-zero duration\n    const startTime = Date.now();\n    while (Date.now() - startTime < 10) { /* busy wait */ }\n    tracker.stop();\n    const summary = tracker.getSummary();\n    expect(summary).toHaveProperty('coding');\n    expect(typeof summary['coding']).toBe('number');\n    expect(summary['coding']).toBeGreaterThanOrEqual(0);\n  });\n\n  // 9. getSummary() combines multiple entries for the same task name\n  it('getSummary() combines multiple entries for the same task name', () => {\n    const tracker = new TimeTracker(filePath);\n    tracker.start('coding');\n    const s1 = Date.now();\n    while (Date.now() - s1 < 10) { /* busy wait */ }\n    tracker.stop();\n    tracker.start('coding');\n    const s2 = Date.now();\n    while (Date.now() - s2 < 10) { /* busy wait */ }\n    tracker.stop();\n    const summary = tracker.getSummary();\n    expect(Object.keys(summary)).toHaveLength(1);\n    expect(summary['coding']).toBeGreaterThanOrEqual(0);\n  });\n\n  // 10. Persistence: save to file, create new instance with same file, data preserved\n  it('persists data across instances', () => {\n    const tracker1 = new TimeTracker(filePath);\n    tracker1.start('persisted task');\n    tracker1.stop();\n\n    const tracker2 = new TimeTracker(filePath);\n    const log = tracker2.getLog();\n    expect(log).toHaveLength(1);\n    expect(log[0].taskName).toBe('persisted task');\n  });\n\n 