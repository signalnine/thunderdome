+import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'fs';
+import { dirname } from 'path';
+
+export interface Entry {
+  taskName: string;
+  startTime: string;
+  endTime: string | null;
+}
+
+export class TimeTracker {
+  private filePath: string;
+  private entries: Entry[];
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = this.load();
+  }
+
+  private load(): Entry[] {
+    if (!existsSync(this.filePath)) {
+      return [];
+    }
+    const raw = readFileSync(this.filePath, 'utf-8');
+    if (!raw.trim()) {
+      return [];
+    }
+    return JSON.parse(raw) as Entry[];
+  }
+
+  private save(): void {
+    const dir = dirname(this.filePath);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    writeFileSync(this.filePath, JSON.stringify(this.entries, null, 2), 'utf-8');
+  }
+
+  start(taskName: string): Entry {
+    if (!taskName) {
+      throw new Error('taskName must not be empty');
+    }
+    if (this.getActiveTask()) {
+      this.stop();
+    }
+    const entry: Entry = {
+      taskName,
+      startTime: new Date().toISOString(),
+      endTime: null,
+    };
+    this.entries.push(entry);
+    this.save();
+    return entry;
+  }
+
+  stop(): Entry {
+    const active = this.entries.find((e) => e.endTime === null);
+    if (!active) {
+      throw new Error('No task is currently running');
+    }
+    active.endTime = new Date().toISOString();
+    this.save();
+    return active;
+  }
+
+  getActiveTask(): Entry | null {
+    return this.entries.find((e) => e.endTime === null) ?? null;
+  }
+
+  getLog(options?: { since?: Date }): Entry[] {
+    if (!options?.since) {
+      return [...this.entries];
+    }
+    const since = options.since.getTime();
+    return this.entries.filter((e) => {
+      if (e.endTime === null) {
+        return true;
+      }
+      if (new Date(e.startTime).getTime() >= since) {
+        return true;
+      }
+      if (new Date(e.endTime).getTime() >= since) {
+        return true;
+      }
+      return false;
+    });
+  }
+
+  getSummary(): Record<string, number> {
+    const summary: Record<string, number> = {};
+    const now = Date.now();
+    for (const entry of this.entries) {
+      const start = new Date(entry.startTime).getTime();
+      const end = entry.endTime === null ? now : new Date(entry.endTime).getTime();
+      const duration = end - start;
+      summary[entry.taskName] = (summary[entry.taskName] ?? 0) + duration;
+    }
+    return summary;
+  }
+}
