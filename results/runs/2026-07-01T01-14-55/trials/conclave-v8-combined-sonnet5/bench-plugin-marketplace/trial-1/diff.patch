@@ -0,0 +1,96 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+function getDependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  return manifest ? Object.keys(manifest.dependencies) : [];
+}
+
+function buildTree(name: string, registry: RegistryService): DependencyNode {
+  function build(n: string, ancestors: Set<string>): DependencyNode {
+    const manifest = registry.get(n);
+    const version = manifest?.version ?? '';
+    if (ancestors.has(n)) {
+      return { name: n, version, dependencies: [] };
+    }
+    const nextAncestors = new Set(ancestors);
+    nextAncestors.add(n);
+    const dependencies = getDependencyNames(n, registry).map((dep) => build(dep, nextAncestors));
+    return { name: n, version, dependencies };
+  }
+  return build(name, new Set());
+}
+
+function detectCycles(name: string, registry: RegistryService): string[][] | null {
+  const cycles: string[][] = [];
+  const visited = new Set<string>();
+  const stack = new Set<string>();
+  const path: string[] = [];
+
+  function visit(n: string): void {
+    visited.add(n);
+    stack.add(n);
+    path.push(n);
+    for (const dep of getDependencyNames(n, registry)) {
+      if (stack.has(dep)) {
+        const idx = path.indexOf(dep);
+        cycles.push([...path.slice(idx), dep]);
+      } else if (!visited.has(dep)) {
+        visit(dep);
+      }
+    }
+    stack.delete(n);
+    path.pop();
+  }
+
+  visit(name);
+  return cycles.length > 0 ? cycles : null;
+}
+
+function topologicalSort(name: string, registry: RegistryService): string[] {
+  const visited = new Set<string>();
+  const result: string[] = [];
+
+  function visit(n: string): void {
+    if (visited.has(n)) return;
+    visited.add(n);
+    for (const dep of getDependencyNames(n, registry)) {
+      visit(dep);
+    }
+    result.push(n);
+  }
+
+  visit(name);
+  return result;
+}
+
+function flattenDependencies(name: string, registry: RegistryService): string[] {
+  const visited = new Set<string>([name]);
+  const result: string[] = [];
+
+  function visit(n: string): void {
+    for (const dep of getDependencyNames(n, registry)) {
+      if (!visited.has(dep)) {
+        visited.add(dep);
+        result.push(dep);
+        visit(dep);
+      }
+    }
+  }
+
+  visit(name);
+  return result;
+}
+
+function hasCircularDependency(name: string, registry: RegistryService): boolean {
+  return detectCycles(name, registry) !== null;
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
