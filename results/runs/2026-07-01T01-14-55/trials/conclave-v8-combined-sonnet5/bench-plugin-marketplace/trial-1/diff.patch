@@ -0,0 +1,109 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+    VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)
+  `);
+  const selectByIdStmt = db.prepare('SELECT * FROM reviews WHERE id = ?');
+  const selectByPluginStmt = db.prepare('SELECT * FROM reviews WHERE pluginName = ?');
+  const avgRatingStmt = db.prepare(
+    'SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0'
+  );
+  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const selectFlaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1');
+  const deleteStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+  const selectByUserStmt = db.prepare('SELECT * FROM reviews WHERE userId = ?');
+  const countByPluginStmt = db.prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?');
+
+  function addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+    const createdAt = new Date().toISOString();
+    const result = insertStmt.run({ ...review, createdAt });
+    const row = selectByIdStmt.get(result.lastInsertRowid) as ReviewRow;
+    return rowToReview(row);
+  }
+
+  function getReviews(pluginName: string): Review[] {
+    const rows = selectByPluginStmt.all(pluginName) as ReviewRow[];
+    return rows.map(rowToReview);
+  }
+
+  function getAverageRating(pluginName: string): number {
+    const row = avgRatingStmt.get(pluginName) as { avg: number | null };
+    return row.avg ?? 0;
+  }
+
+  function flagReview(reviewId: number): void {
+    flagStmt.run(reviewId);
+  }
+
+  function getFlaggedReviews(): Review[] {
+    const rows = selectFlaggedStmt.all() as ReviewRow[];
+    return rows.map(rowToReview);
+  }
+
+  function removeReview(reviewId: number): boolean {
+    const result = deleteStmt.run(reviewId);
+    return result.changes > 0;
+  }
+
+  function getReviewsByUser(userId: string): Review[] {
+    const rows = selectByUserStmt.all(userId) as ReviewRow[];
+    return rows.map(rowToReview);
+  }
+
+  function getReviewCount(pluginName: string): number {
+    const row = countByPluginStmt.get(pluginName) as { count: number };
+    return row.count;
+  }
+
+  return {
+    addReview,
+    getReviews,
+    getAverageRating,
+    flagReview,
+    getFlaggedReviews,
+    removeReview,
+    getReviewsByUser,
+    getReviewCount,
+  };
+}
