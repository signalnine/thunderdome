@@ -0,0 +1,46 @@
+import { Script, createContext } from 'node:vm';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+function runInSandbox(code: string, context: Record<string, unknown>, timeoutMs: number): SandboxResult {
+  const start = Date.now();
+  const memBefore = process.memoryUsage().heapUsed;
+  const sandbox = createContext({ ...context });
+  const wrapped = `(function () {\n${code}\n})()`;
+
+  try {
+    const script = new Script(wrapped);
+    const output = script.runInContext(sandbox, { timeout: timeoutMs });
+    return {
+      success: true,
+      output,
+      duration: Date.now() - start,
+      memoryUsed: Math.max(0, process.memoryUsage().heapUsed - memBefore),
+    };
+  } catch (err) {
+    return {
+      success: false,
+      output: undefined,
+      duration: Date.now() - start,
+      memoryUsed: Math.max(0, process.memoryUsage().heapUsed - memBefore),
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  const DEFAULT_TIMEOUT_MS = 5000;
+
+  async function execute(code: string, context: Record<string, unknown> = {}): Promise<SandboxResult> {
+    return runInSandbox(code, context, DEFAULT_TIMEOUT_MS);
+  }
+
+  async function executeWithTimeout(
+    code: string,
+    timeoutMs: number,
+    context: Record<string, unknown> = {}
+  ): Promise<SandboxResult> {
+    return runInSandbox(code, context, timeoutMs);
+  }
+
+  return { execute, executeWithTimeout };
+}
