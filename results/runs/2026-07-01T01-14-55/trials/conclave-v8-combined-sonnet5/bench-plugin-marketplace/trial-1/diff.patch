@@ -0,0 +1,106 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+}
+
+function rowToManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entryPoint,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+    VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+  `);
+  const selectByNameStmt = db.prepare('SELECT * FROM plugins WHERE name = ?');
+  const selectByNameVersionStmt = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+  const selectAllStmt = db.prepare('SELECT * FROM plugins');
+  const searchStmt = db.prepare('SELECT * FROM plugins WHERE LOWER(name) LIKE ? OR LOWER(description) LIKE ?');
+  const deleteStmt = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+  const listVersionsStmt = db.prepare('SELECT version FROM plugins WHERE name = ?');
+
+  function register(manifest: PluginManifest): void {
+    insertStmt.run({
+      name: manifest.name,
+      version: manifest.version,
+      description: manifest.description,
+      author: manifest.author,
+      dependencies: JSON.stringify(manifest.dependencies),
+      entryPoint: manifest.entryPoint,
+      permissions: JSON.stringify(manifest.permissions),
+    });
+  }
+
+  function get(name: string): PluginManifest | null {
+    const rows = selectByNameStmt.all(name) as PluginRow[];
+    if (rows.length === 0) return null;
+    const manifests = rows.map(rowToManifest);
+    manifests.sort((a, b) => semver.compare(b.version, a.version));
+    return manifests[0];
+  }
+
+  function getVersion(name: string, version: string): PluginManifest | null {
+    const row = selectByNameVersionStmt.get(name, version) as PluginRow | undefined;
+    return row ? rowToManifest(row) : null;
+  }
+
+  function list(): PluginManifest[] {
+    const rows = selectAllStmt.all() as PluginRow[];
+    return rows.map(rowToManifest);
+  }
+
+  function search(query: string): PluginManifest[] {
+    const like = `%${query.toLowerCase()}%`;
+    const rows = searchStmt.all(like, like) as PluginRow[];
+    return rows.map(rowToManifest);
+  }
+
+  function remove(name: string, version: string): boolean {
+    const result = deleteStmt.run(name, version);
+    return result.changes > 0;
+  }
+
+  function listVersions(name: string): string[] {
+    const rows = listVersionsStmt.all(name) as { version: string }[];
+    return rows.map((r) => r.version);
+  }
+
+  function update(name: string, version: string, updates: Partial<PluginManifest>): void {
+    const existing = getVersion(name, version);
+    if (!existing) return;
+    register({ ...existing, ...updates, name, version });
+  }
+
+  return { register, get, getVersion, list, search, remove, listVersions, update };
+}
