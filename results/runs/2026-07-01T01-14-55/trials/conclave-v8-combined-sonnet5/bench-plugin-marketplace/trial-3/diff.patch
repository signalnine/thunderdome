@@ -0,0 +1,49 @@
+import vm from 'node:vm';
+import { performance } from 'node:perf_hooks';
+import type { RunnerService, SandboxResult } from '../types.js';
+
+const DEFAULT_TIMEOUT_MS = 5000;
+
+function runInSandbox(
+  code: string,
+  context: Record<string, unknown>,
+  timeoutMs: number
+): SandboxResult {
+  const start = performance.now();
+  const memBefore = process.memoryUsage().heapUsed;
+
+  try {
+    const sandbox: Record<string, unknown> = { ...context };
+    const vmContext = vm.createContext(sandbox);
+    const script = new vm.Script(`(function () {\n${code}\n})()`);
+    const output = script.runInContext(vmContext, { timeout: timeoutMs });
+    const duration = performance.now() - start;
+    const memAfter = process.memoryUsage().heapUsed;
+    return {
+      success: true,
+      output,
+      duration,
+      memoryUsed: Math.max(0, memAfter - memBefore),
+    };
+  } catch (err) {
+    const duration = performance.now() - start;
+    return {
+      success: false,
+      output: undefined,
+      duration,
+      memoryUsed: 0,
+      error: err instanceof Error ? err.message : String(err),
+    };
+  }
+}
+
+export function createRunner(): RunnerService {
+  return {
+    async execute(code, context = {}) {
+      return runInSandbox(code, context, DEFAULT_TIMEOUT_MS);
+    },
+    async executeWithTimeout(code, timeoutMs, context = {}) {
+      return runInSandbox(code, context, timeoutMs);
+    },
+  };
+}
