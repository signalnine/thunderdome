+++ b/src/registry/index.ts
@@ -0,0 +1,102 @@
+import Database from 'better-sqlite3';
+import semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+}
+
+function rowToManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entryPoint,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+    VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+  `);
+  const getVersionStmt = db.prepare('SELECT * FROM plugins WHERE name = ? AND version = ?');
+  const getAllVersionsStmt = db.prepare('SELECT * FROM plugins WHERE name = ?');
+  const listStmt = db.prepare('SELECT * FROM plugins');
+  const deleteStmt = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?');
+  const listVersionsStmt = db.prepare('SELECT version FROM plugins WHERE name = ?');
+
+  function insertManifest(manifest: PluginManifest): void {
+    insertStmt.run({
+      name: manifest.name,
+      version: manifest.version,
+      description: manifest.description,
+      author: manifest.author,
+      dependencies: JSON.stringify(manifest.dependencies),
+      entryPoint: manifest.entryPoint,
+      permissions: JSON.stringify(manifest.permissions),
+    });
+  }
+
+  const registry: RegistryService = {
+    register(manifest) {
+      insertManifest(manifest);
+    },
+    get(name) {
+      const rows = getAllVersionsStmt.all(name) as PluginRow[];
+      if (rows.length === 0) return null;
+      rows.sort((a, b) => semver.compare(b.version, a.version));
+      return rowToManifest(rows[0]);
+    },
+    getVersion(name, version) {
+      const row = getVersionStmt.get(name, version) as PluginRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+    list() {
+      return (listStmt.all() as PluginRow[]).map(rowToManifest);
+    },
+    search(query) {
+      const q = query.toLowerCase();
+      return registry
+        .list()
+        .filter((m) => m.name.toLowerCase().includes(q) || m.description.toLowerCase().includes(q));
+    },
+    remove(name, version) {
+      const info = deleteStmt.run(name, version);
+      return info.changes > 0;
+    },
+    listVersions(name) {
+      return (listVersionsStmt.all(name) as { version: string }[]).map((r) => r.version);
+    },
+    update(name, version, updates) {
+      const existing = registry.getVersion(name, version);
+      if (!existing) return;
+      insertManifest({ ...existing, ...updates, name, version });
+    },
+  };
+
+  return registry;
+}
