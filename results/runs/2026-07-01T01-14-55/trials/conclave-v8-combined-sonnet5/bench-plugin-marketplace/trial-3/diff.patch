@@ -0,0 +1,92 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  const insertStmt = db.prepare(`
+    INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+    VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)
+  `);
+  const getByIdStmt = db.prepare('SELECT * FROM reviews WHERE id = ?');
+  const getByPluginStmt = db.prepare('SELECT * FROM reviews WHERE pluginName = ?');
+  const flagStmt = db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?');
+  const deleteStmt = db.prepare('DELETE FROM reviews WHERE id = ?');
+  const getByUserStmt = db.prepare('SELECT * FROM reviews WHERE userId = ?');
+  const getFlaggedStmt = db.prepare('SELECT * FROM reviews WHERE flagged = 1');
+  const countByPluginStmt = db.prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?');
+  const ratingsByPluginStmt = db.prepare(
+    'SELECT rating FROM reviews WHERE pluginName = ? AND flagged = 0'
+  );
+
+  return {
+    addReview(review) {
+      const createdAt = new Date().toISOString();
+      const info = insertStmt.run({ ...review, createdAt });
+      const row = getByIdStmt.get(info.lastInsertRowid) as ReviewRow;
+      return rowToReview(row);
+    },
+    getReviews(pluginName) {
+      return (getByPluginStmt.all(pluginName) as ReviewRow[]).map(rowToReview);
+    },
+    getAverageRating(pluginName) {
+      const rows = ratingsByPluginStmt.all(pluginName) as { rating: number }[];
+      if (rows.length === 0) return 0;
+      const sum = rows.reduce((acc, r) => acc + r.rating, 0);
+      return sum / rows.length;
+    },
+    flagReview(reviewId) {
+      flagStmt.run(reviewId);
+    },
+    getFlaggedReviews() {
+      return (getFlaggedStmt.all() as ReviewRow[]).map(rowToReview);
+    },
+    removeReview(reviewId) {
+      const info = deleteStmt.run(reviewId);
+      return info.changes > 0;
+    },
+    getReviewsByUser(userId) {
+      return (getByUserStmt.all(userId) as ReviewRow[]).map(rowToReview);
+    },
+    getReviewCount(pluginName) {
+      const row = countByPluginStmt.get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
