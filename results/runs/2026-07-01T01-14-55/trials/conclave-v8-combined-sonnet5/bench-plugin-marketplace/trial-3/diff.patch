+++ b/src/deps/index.ts
@@ -0,0 +1,106 @@
+import type { DepsService, DependencyNode, RegistryService } from '../types.js';
+
+function directDependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  return manifest ? Object.keys(manifest.dependencies) : [];
+}
+
+function buildTree(name: string, registry: RegistryService, ancestors: Set<string> = new Set()): DependencyNode {
+  const manifest = registry.get(name);
+  const node: DependencyNode = {
+    name,
+    version: manifest ? manifest.version : '',
+    dependencies: [],
+  };
+  if (!manifest || ancestors.has(name)) {
+    return node;
+  }
+  const nextAncestors = new Set(ancestors);
+  nextAncestors.add(name);
+  for (const dep of Object.keys(manifest.dependencies)) {
+    node.dependencies.push(buildTree(dep, registry, nextAncestors));
+  }
+  return node;
+}
+
+function detectCycles(name: string, registry: RegistryService): string[][] | null {
+  const cycles: string[][] = [];
+  const visited = new Set<string>();
+  const stack: string[] = [];
+  const stackSet = new Set<string>();
+
+  function dfs(node: string): void {
+    if (stackSet.has(node)) {
+      const idx = stack.indexOf(node);
+      cycles.push([...stack.slice(idx), node]);
+      return;
+    }
+    if (visited.has(node)) return;
+    visited.add(node);
+    stack.push(node);
+    stackSet.add(node);
+    for (const dep of directDependencyNames(node, registry)) {
+      dfs(dep);
+    }
+    stack.pop();
+    stackSet.delete(node);
+  }
+
+  dfs(name);
+  return cycles.length > 0 ? cycles : null;
+}
+
+function topologicalSort(name: string, registry: RegistryService): string[] {
+  const visited = new Set<string>();
+  const order: string[] = [];
+
+  function dfs(node: string): void {
+    if (visited.has(node)) return;
+    visited.add(node);
+    for (const dep of directDependencyNames(node, registry)) {
+      dfs(dep);
+    }
+    order.push(node);
+  }
+
+  dfs(name);
+  return order;
+}
+
+function flattenDependencies(name: string, registry: RegistryService): string[] {
+  const visited = new Set<string>();
+  const result: string[] = [];
+
+  function dfs(node: string): void {
+    for (const dep of directDependencyNames(node, registry)) {
+      if (!visited.has(dep)) {
+        visited.add(dep);
+        result.push(dep);
+        dfs(dep);
+      }
+    }
+  }
+
+  dfs(name);
+  return result;
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name, registry) {
+      return buildTree(name, registry);
+    },
+    detectCycles(name, registry) {
+      return detectCycles(name, registry);
+    },
+    topologicalSort(name, registry) {
+      return topologicalSort(name, registry);
+    },
+    flattenDependencies(name, registry) {
+      return flattenDependencies(name, registry);
+    },
+    hasCircularDependency(name, registry) {
+      return detectCycles(name, registry) !== null;
+    },
+  };
+}
