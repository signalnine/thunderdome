eps -> run -> review', async () => {\n    // Register a dependency first\n    marketplace.registry.register(makeManifest({ name: 'dep-lib', version: '1.0.0' }));\n    marketplace.registry.register(makeManifest({ name: 'dep-lib', version: '1.2.0' }));\n\n    const plugin = makeManifest({\n      name: 'my-plugin',\n      version: '1.0.0',\n      dependencies: { 'dep-lib': '^1.0.0' },\n      entryPoint: 'return \"installed\";',\n    });\n\n    const result = await marketplace.installPlugin(plugin);\n    expect(result.resolved).toHaveLength(1);\n    expect(result.resolved[0].name).toBe('dep-lib');\n    expect(result.resolved[0].version).toBe('1.2.0');\n    expect(result.sandboxResult.success).toBe(true);\n    expect(result.sandboxResult.output).toBe('installed');\n\n    // Add a review\n    const review = marketplace.reviews.addReview({\n      pluginName: 'my-plugin',\n      pluginVersion: '1.0.0',\n      userId: 'user1',\n      rating: 5,\n      comment: 'Works perfectly!',\n    });\n    expect(review.id).toBeGreaterThan(0);\n  });\n\n  it('version conflict detection across plugins', () => {\n    const resolver = marketplace.resolver;\n    const constraints = [\n      { name: 'shared-lib', range: '^1.0.0' },\n      { name: 'shared-lib', range: '^2.0.0' },\n    ];\n    const available = { 'shared-lib': ['1.0.0', '1.5.0', '2.0.0', '2.1.0'] };\n\n    // Both constraints can be resolved independently; first one gets ^1, second gets ^2\n    // but the resolver resolves each constraint independently\n    const result = resolver.resolve(constraints, available);\n    expect(result).toHaveLength(2);\n    expect(result[0].version).toBe('1.5.0');\n    expect(result[1].version).toBe('2.1.0');\n  });\n\n  it('dependency chain resolution (A depends on B depends on C)', async () => {\n    marketplace.registry.register(makeManifest({ name: 'C', version: '1.0.0' }));\n    marketplace.registry.register(makeManifest({ name: 'B', version: '1.0.0', dependencies: { C: '^1.0.0' } }));\n    marketplace.registry.register(makeManifest({ name: 'A', version: '1.0.0', dependencies: { B: '^1.0.0' } }));\n\n    const sorted = marketplace.deps.topologicalSort('A', marketplace.registry);\n    expect(sorted).toEqual(['C', 'B', 'A']);\n  });\n\n  it('sandbox execution of plugin entry point', async () => {\n    const result = await marketplace.runner.execute('return { status: \"ok\", value: 100 };');\n    expect(result.success).toBe(true);\n    expect(result.output).toEqual({ status: 'ok', value: 100 });\n  });\n\n  it('review aggregation across versions', () => {\n    marketplace.reviews.addReview({ pluginName: 'plugin-x', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'v1 great' });\n    marketplace.reviews.addReview({ pluginName: 'plugin-x', pluginVersion: '2.0.0', userId: 'u2', rating: 3, comment: 'v2 ok' });\n    // getReviews returns all reviews for the plugin name (all versions)\n    const allReviews = marketplace.reviews.getReviews('plugin-x');\n    expect(allReviews).toHaveLength(2);\n    expect(marketplace.reviews.getAverageRating('plugin-x')).toBe(4);\n  });\n\n  it('plugin removal cascades correctly', () => {\n    marketplace.registry.register(makeManifest({ name: 'to-remove', version: '1.0.0' }));\n    marketplace.registry.register(makeManifest({ name: 'to-remove', version: '2.0.0' }));\n    expect(marketplace.registry.listVersions('to-remove')).toHaveLength(2);\n\n    marketplace.registry.remove('to-remove', '1.0.0');\n    expect(marketplace.registry.listVersions('to-remove')).toHaveLength(1);\n    expect(marketplace.registry.getVersion('to-remove', '1.0.0')).toBeNull();\n    expect(marketplace.registry.getVersion('to-remove', '2.0.0')).not.toBeNull();\n  });\n\n  it('search returns relevant results ranked', () => {\n    marketplace.registry.register(makeManifest({ name: 'image-processor', description: 'Process images' }));\n    marketplace.registry.register(makeManifest({ name: 'data-analyzer', description: 'Analyze data' }));\n    marketplace.registry.register(makeManifest({ name: 'image-viewer', description: 'View images' }));\n\n    const results = marketplace.registry.search('image');\n    expect(results.length).toBeGreaterThanOrEqual(2);\n    const names = results.map(r => r.name);\n    expect(names).toContain('image-processor');\n    expect(names).toContain('image-viewer');\n  });\n\n  it('multiple version registration and resolution', () => {\n    marketplace.registry.register(makeManifest({ name: 'lib', version: '1.0.0' }));\n    marketplace.registry.register(makeManifest({ name: 'lib', version: '1.1.0' }));\n    marketplace.registry.register(makeManifest({ name: 'lib', version: '2.0.0' }));\n\n    const versions = marketplace.registry.listVersions('lib');\n    expect(versions).toHaveLength(3);\n\n    const resolved = marketplace.resolver.maxSatisfying(versions, '^1.0.0');\n    expect(resolved).toBe('1.1.0');\n  });\n\n  it('circular dependency detected in install workflow', async () => {\n    // Register A -> B -> A (cycle)\n    marketplace.registry.register(makeManifest({ name: 'cycle-b', version: '1.0.0', dependencies: { 'cycle-a': '^1.0.0' } }));\n\n    const cyclicPlugin = makeManifest({\n      name: 'cycle-a',\n      version: '1.0.0',\n      dependencies: { 'cycle-b': '^1.0.0' },\n      entryPoint: 'return true;',\n    });\n\n    await expect(marketplace.installPlugin(cyclicPlugin)).rejects.toThrow(/[Cc]ircular/);\n  });\n\n  it('plugin with no dependencies installs cleanly', async () => {\n    const plugin = makeManifest({\n      name: 'standalone',\n      version: '1.0.0',\n      entryPoint: 'return \"standalone\";',\n    });\n\n    const result = await marketplace.installPlugin(plugin);\n    expect(result.resolved).toHaveLength(0);\n    expect(result.sandboxResult.success).toBe(true);\n    expect(result.sandboxResult.output).toBe('standalone');\n  });\n\n  it('rating average updates after new review', () => {\n    marketplace.reviews.addReview({ pluginName: 'rated', pluginVersion: '1.0.0', userId: 'u1', rating: 4, comment: 'good' });\n    expect(marketplace.reviews.getAverageRating('rated')).toBe(4);\n\n    marketplace.reviews.addReview({ pluginName: 'rated', pluginVersion: '1.0.0', userId: 'u2', rating: 2, comment: 'meh' });\n    expect(marketplace.reviews.getAverageRating('rated')).toBe(3);\n  });\n\n  it('flagged review excluded from rating', () => {\n    marketplace.reviews.addReview({ pluginName: 'flagtest', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'great' });\n    const badReview = marketplace.reviews.addReview({ pluginName: 'flagtest', pluginVersion: '1.0.0', userId: 'spam', rating: 1, comment: 'spam' });\n\n    expect(marketplace.reviews.getAverageRating('flagtest')).toBe(3);\n    marketplace.reviews.flagReview(badReview.id);\n    expect(marketplace.reviews.getAverageRating('flagtest')).toBe(5);\n  });\n\n  it('timeout enforcement in sandbox', async () => {\n    const result = await marketplace.runner.executeWithTimeout('while(true) {}', 100);\n    expect(result.success).toBe(false);\n    expect(result.error).toBeDefined();\n  });\n\n  it('install workflow rejects invalid manifest', async () => {\n    const invalid = makeManifest({ name: '', version: '1.0.0' });\n    await expect(marketplace.installPlugin(invalid)).rejects.toThrow(/[Ii]nvalid/);\n  });\n\n  it('dependency tree depth limit', () => {\n    // Build a very deep chain that shouldn't exceed the limit\n    const registry = marketplace.registry;\n    registry.register(makeManifest({ name: 'deep-5', version: '1.0.0' }));\n    registry.register(makeManifest({ name: 'deep-4', version: '1.0.0', dependencies: { 'deep-5': '^1.0.0' } }));\n    registry.register(makeManifest({ name: 'deep-3', version: '1.0.0', dependencies: { 'deep-4': '^1.0.0' } }));\n    registry.register(makeManifest({ name: 'deep-2', version: '1.0.0', dependencies: { 'deep-3': '^1.0.0' } }));\n    registry.register(makeManifest({ name: 'deep-1', version: '1.0.0', dependencies: { 'deep-2': '^1.0.0' } }));\n\n    const tree = marketplace.deps.buildTree('deep-1', marketplace.registry);\n    expect(tree.name).toBe('deep-1');\n    expect(tree.dependencies[0].name).toBe('deep-2');\n\n    // Flatten should return all 4 deps\n    const flat = marketplace.deps.flattenDependencies('deep-1', marketplace.registry);\n    expect(flat).toHaveLength(4);\n  });\n});\n","numLines":214,"startLine":1,"totalLines":214}}}
