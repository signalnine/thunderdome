@@ -0,0 +1,126 @@
+import Database from 'better-sqlite3';
+import * as semver from 'semver';
+import type { PluginManifest, RegistryService } from '../types.js';
+
+interface PluginRow {
+  name: string;
+  version: string;
+  description: string;
+  author: string;
+  dependencies: string;
+  entryPoint: string;
+  permissions: string;
+}
+
+function rowToManifest(row: PluginRow): PluginManifest {
+  return {
+    name: row.name,
+    version: row.version,
+    description: row.description,
+    author: row.author,
+    dependencies: JSON.parse(row.dependencies) as Record<string, string>,
+    entryPoint: row.entryPoint,
+    permissions: JSON.parse(row.permissions) as string[],
+  };
+}
+
+export function createRegistry(): RegistryService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE plugins (
+      name TEXT NOT NULL,
+      version TEXT NOT NULL,
+      description TEXT NOT NULL,
+      author TEXT NOT NULL,
+      dependencies TEXT NOT NULL,
+      entryPoint TEXT NOT NULL,
+      permissions TEXT NOT NULL,
+      PRIMARY KEY (name, version)
+    )
+  `);
+
+  return {
+    register(manifest: PluginManifest): void {
+      db.prepare(
+        `INSERT INTO plugins (name, version, description, author, dependencies, entryPoint, permissions)
+         VALUES (@name, @version, @description, @author, @dependencies, @entryPoint, @permissions)
+         ON CONFLICT(name, version) DO UPDATE SET
+           description = excluded.description,
+           author = excluded.author,
+           dependencies = excluded.dependencies,
+           entryPoint = excluded.entryPoint,
+           permissions = excluded.permissions`
+      ).run({
+        name: manifest.name,
+        version: manifest.version,
+        description: manifest.description,
+        author: manifest.author,
+        dependencies: JSON.stringify(manifest.dependencies),
+        entryPoint: manifest.entryPoint,
+        permissions: JSON.stringify(manifest.permissions),
+      });
+    },
+
+    get(name: string): PluginManifest | null {
+      const rows = db.prepare('SELECT * FROM plugins WHERE name = ?').all(name) as PluginRow[];
+      if (rows.length === 0) return null;
+      const sorted = rows.sort((a, b) => semver.rcompare(a.version, b.version));
+      return rowToManifest(sorted[0]);
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const row = db
+        .prepare('SELECT * FROM plugins WHERE name = ? AND version = ?')
+        .get(name, version) as PluginRow | undefined;
+      return row ? rowToManifest(row) : null;
+    },
+
+    list(): PluginManifest[] {
+      const rows = db.prepare('SELECT * FROM plugins').all() as PluginRow[];
+      return rows.map(rowToManifest);
+    },
+
+    search(query: string): PluginManifest[] {
+      const q = query.toLowerCase();
+      const rows = db.prepare('SELECT * FROM plugins').all() as PluginRow[];
+      return rows
+        .filter(
+          row => row.name.toLowerCase().includes(q) || row.description.toLowerCase().includes(q)
+        )
+        .map(rowToManifest);
+    },
+
+    remove(name: string, version: string): boolean {
+      const result = db.prepare('DELETE FROM plugins WHERE name = ? AND version = ?').run(name, version);
+      return result.changes > 0;
+    },
+
+    listVersions(name: string): string[] {
+      const rows = db.prepare('SELECT version FROM plugins WHERE name = ?').all(name) as {
+        version: string;
+      }[];
+      return rows.map(row => row.version);
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const existing = db
+        .prepare('SELECT * FROM plugins WHERE name = ? AND version = ?')
+        .get(name, version) as PluginRow | undefined;
+      if (!existing) return;
+      const merged = { ...rowToManifest(existing), ...updates };
+      db.prepare(
+        `UPDATE plugins SET description = @description, author = @author, dependencies = @dependencies,
+           entryPoint = @entryPoint, permissions = @permissions
+         WHERE name = @name AND version = @version`
+      ).run({
+        name,
+        version,
+        description: merged.description,
+        author: merged.author,
+        dependencies: JSON.stringify(merged.dependencies),
+        entryPoint: merged.entryPoint,
+        permissions: JSON.stringify(merged.permissions),
+      });
+    },
+  };
+}
