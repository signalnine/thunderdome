@@ -0,0 +1,95 @@
+import type { DependencyNode, DepsService, RegistryService } from '../types.js';
+
+function getDependencyNames(name: string, registry: RegistryService): string[] {
+  const manifest = registry.get(name);
+  return manifest ? Object.keys(manifest.dependencies) : [];
+}
+
+function buildTreeInternal(
+  name: string,
+  registry: RegistryService,
+  ancestors: Set<string>
+): DependencyNode {
+  const manifest = registry.get(name);
+  if (!manifest) {
+    return { name, version: 'unknown', dependencies: [] };
+  }
+  if (ancestors.has(name)) {
+    return { name: manifest.name, version: manifest.version, dependencies: [] };
+  }
+  const nextAncestors = new Set(ancestors);
+  nextAncestors.add(name);
+  const dependencies = Object.keys(manifest.dependencies).map(depName =>
+    buildTreeInternal(depName, registry, nextAncestors)
+  );
+  return { name: manifest.name, version: manifest.version, dependencies };
+}
+
+function detectCyclesInternal(name: string, registry: RegistryService): string[][] | null {
+  const visited = new Set<string>();
+  const inStack = new Set<string>();
+  const path: string[] = [];
+  const cycles: string[][] = [];
+
+  function dfs(node: string): void {
+    visited.add(node);
+    inStack.add(node);
+    path.push(node);
+
+    for (const dep of getDependencyNames(node, registry)) {
+      if (!visited.has(dep)) {
+        dfs(dep);
+      } else if (inStack.has(dep)) {
+        const idx = path.indexOf(dep);
+        cycles.push(path.slice(idx).concat(dep));
+      }
+    }
+
+    path.pop();
+    inStack.delete(node);
+  }
+
+  dfs(name);
+  return cycles.length > 0 ? cycles : null;
+}
+
+function topologicalSortInternal(name: string, registry: RegistryService): string[] {
+  const visited = new Set<string>();
+  const result: string[] = [];
+
+  function visit(node: string): void {
+    if (visited.has(node)) return;
+    visited.add(node);
+    for (const dep of getDependencyNames(node, registry)) {
+      visit(dep);
+    }
+    result.push(node);
+  }
+
+  visit(name);
+  return result;
+}
+
+export function createDepsService(): DepsService {
+  return {
+    buildTree(name: string, registry: RegistryService): DependencyNode {
+      return buildTreeInternal(name, registry, new Set());
+    },
+
+    detectCycles(name: string, registry: RegistryService): string[][] | null {
+      return detectCyclesInternal(name, registry);
+    },
+
+    topologicalSort(name: string, registry: RegistryService): string[] {
+      return topologicalSortInternal(name, registry);
+    },
+
+    flattenDependencies(name: string, registry: RegistryService): string[] {
+      return topologicalSortInternal(name, registry).filter(n => n !== name);
+    },
+
+    hasCircularDependency(name: string, registry: RegistryService): boolean {
+      return detectCyclesInternal(name, registry) !== null;
+    },
+  };
+}
