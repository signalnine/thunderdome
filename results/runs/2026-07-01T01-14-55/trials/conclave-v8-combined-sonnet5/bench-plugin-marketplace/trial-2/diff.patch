new file mode 100644
index 0000000..153fb07
--- /dev/null
+++ b/src/resolver/index.ts
@@ -0,0 +1,34 @@
+import * as semver from 'semver';
+import type { ResolvedVersion, ResolverService, VersionConstraint } from '../types.js';
+
+export function createResolver(): ResolverService {
+  return {
+    resolve(
+      constraints: VersionConstraint[],
+      available: Record<string, string[]>
+    ): ResolvedVersion[] {
+      return constraints.map(constraint => {
+        const versions = available[constraint.name] ?? [];
+        const best = semver.maxSatisfying(versions, constraint.range);
+        if (!best) {
+          throw new Error(
+            `Cannot resolve dependency "${constraint.name}" for range "${constraint.range}": no satisfying version available`
+          );
+        }
+        return { name: constraint.name, version: best, satisfies: constraint.range };
+      });
+    },
+
+    satisfies(version: string, range: string): boolean {
+      return semver.satisfies(version, range);
+    },
+
+    maxSatisfying(versions: string[], range: string): string | null {
+      return semver.maxSatisfying(versions, range);
+    },
+
+    validRange(range: string): boolean {
+      return semver.validRange(range) !== null;
+    },
+  };
+}
diff --git a/src/reviews/index.ts b/src/reviews/index.ts
new file mode 100644
index 0000000..8cc8126
--- /dev/null
+++ b/src/reviews/index.ts
@@ -0,0 +1,106 @@
+import Database from 'better-sqlite3';
+import type { Review, ReviewService } from '../types.js';
+
+interface ReviewRow {
+  id: number;
+  pluginName: string;
+  pluginVersion: string;
+  userId: string;
+  rating: number;
+  comment: string;
+  flagged: number;
+  createdAt: string;
+}
+
+function rowToReview(row: ReviewRow): Review {
+  return {
+    id: row.id,
+    pluginName: row.pluginName,
+    pluginVersion: row.pluginVersion,
+    userId: row.userId,
+    rating: row.rating,
+    comment: row.comment,
+    flagged: row.flagged === 1,
+    createdAt: row.createdAt,
+  };
+}
+
+export function createReviewSystem(): ReviewService {
+  const db = new Database(':memory:');
+  db.exec(`
+    CREATE TABLE reviews (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      pluginName TEXT NOT NULL,
+      pluginVersion TEXT NOT NULL,
+      userId TEXT NOT NULL,
+      rating INTEGER NOT NULL,
+      comment TEXT NOT NULL,
+      flagged INTEGER NOT NULL DEFAULT 0,
+      createdAt TEXT NOT NULL
+    )
+  `);
+
+  return {
+    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+      const createdAt = new Date().toISOString();
+      const result = db
+        .prepare(
+          `INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment, flagged, createdAt)
+           VALUES (@pluginName, @pluginVersion, @userId, @rating, @comment, 0, @createdAt)`
+        )
+        .run({ ...review, createdAt });
+      return {
+        id: Number(result.lastInsertRowid),
+        pluginName: review.pluginName,
+        pluginVersion: review.pluginVersion,
+        userId: review.userId,
+        rating: review.rating,
+        comment: review.comment,
+        flagged: false,
+        createdAt,
+      };
+    },
+
+    getReviews(pluginName: string): Review[] {
+      const rows = db
+        .prepare('SELECT * FROM reviews WHERE pluginName = ?')
+        .all(pluginName) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getAverageRating(pluginName: string): number {
+      const row = db
+        .prepare(
+          'SELECT AVG(rating) as avgRating FROM reviews WHERE pluginName = ? AND flagged = 0'
+        )
+        .get(pluginName) as { avgRating: number | null };
+      return row.avgRating ?? 0;
+    },
+
+    flagReview(reviewId: number): void {
+      db.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);
+    },
+
+    getFlaggedReviews(): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE flagged = 1').all() as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    removeReview(reviewId: number): boolean {
+      const result = db.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);
+      return result.changes > 0;
+    },
+
+    getReviewsByUser(userId: string): Review[] {
+      const rows = db.prepare('SELECT * FROM reviews WHERE userId = ?').all(userId) as ReviewRow[];
+      return rows.map(rowToReview);
+    },
+
+    getReviewCount(pluginName: string): number {
+      const row = db
+        .prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?')
+        .get(pluginName) as { count: number };
+      return row.count;
+    },
+  };
+}
