ole).toBe('viewer');\n57\t  });\n58\t\n59\t  it('should reject duplicate email registration', async () => {\n60\t    const app = createPublicApp();\n61\t    await request(app)\n62\t      .post('/users')\n63\t      .send({ email: 'dup@example.com', password: 'pass123', tenant_id: 't1' });\n64\t\n65\t    const res = await request(app)\n66\t      .post('/users')\n67\t      .send({ email: 'dup@example.com', password: 'pass456', tenant_id: 't1' });\n68\t\n69\t    expect(res.status).toBe(409);\n70\t  });\n71\t\n72\t  it('should login with correct credentials', async () => {\n73\t    const app = createPublicApp();\n74\t    await request(app)\n75\t      .post('/users')\n76\t      .send({ email: 'login@example.com', password: 'pass123', tenant_id: 't1' });\n77\t\n78\t    const res = await request(app)\n79\t      .post('/users/login')\n80\t      .send({ email: 'login@example.com', password: 'pass123' });\n81\t\n82\t    expect(res.status).toBe(200);\n83\t    expect(res.body).toHaveProperty('token');\n84\t    expect(res.body.user.email).toBe('login@example.com');\n85\t  });\n86\t\n87\t  it('should reject login with wrong password', async () => {\n88\t    const app = createPublicApp();\n89\t    await request(app)\n90\t      .post('/users')\n91\t      .send({ email: 'wrong@example.com', password: 'pass123', tenant_id: 't1' });\n92\t\n93\t    const res = await request(app)\n94\t      .post('/users/login')\n95\t      .send({ email: 'wrong@example.com', password: 'wrongpass' });\n96\t\n97\t    expect(res.status).toBe(401);\n98\t  });\n99\t\n100\t  it('should get user profile with mock auth', async () => {\n101\t    const publicApp = createPublicApp();\n102\t    const regRes = await request(publicApp)\n103\t      .post('/users')\n104\t      .send({ email: 'me@example.com', password: 'pass123', tenant_id: 't1' });\n105\t\n106\t    const userId = regRes.body.id;\n107\t    const authedApp = createAuthedApp(userId, 't1');\n108\t\n109\t    const res = await request(authedApp).get('/users/