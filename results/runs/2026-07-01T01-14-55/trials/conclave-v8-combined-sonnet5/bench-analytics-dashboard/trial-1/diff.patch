+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BtW2zjhsoyKXQLqVzBr43s","type":"tool_result","content":"-- Multi-tenant analytics dashboard schema\nCREATE TABLE IF NOT EXISTS users (\n  id TEXT PRIMARY KEY,\n  email TEXT NOT NULL UNIQUE,\n  password_hash TEXT NOT NULL,\n  tenant_id TEXT NOT NULL,\n  role TEXT NOT NULL DEFAULT 'viewer' CHECK(role IN ('admin', 'viewer', 'editor')),\n  created_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\n\nCREATE TABLE IF NOT EXISTS events (\n  id TEXT PRIMARY KEY,\n  tenant_id TEXT NOT NULL,\n  name TEXT NOT NULL,\n  properties TEXT NOT NULL DEFAULT '{}',\n  timestamp TEXT NOT NULL DEFAULT (datetime('now')),\n  user_id TEXT,\n  session_id TEXT\n);\n\nCREATE TABLE IF NOT EXISTS dashboards (\n  id TEXT PRIMARY KEY,\n  tenant_id TEXT NOT NULL,\n  name TEXT NOT NULL,\n  owner_id TEXT NOT NULL,\n  config TEXT NOT NULL DEFAULT '{}',\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\n  FOREIGN KEY (owner_id) REFERENCES users(id)\n);\n\nCREATE TABLE IF NOT EXISTS widgets (\n  id TEXT PRIMARY KEY,\n  dashboard_id TEXT NOT NULL,\n  type TEXT NOT NULL CHECK(type IN ('counter', 'timeseries', 'breakdown', 'funnel')),\n  config TEXT NOT NULL DEFAULT '{}',\n  position_x INTEGER NOT NULL DEFAULT 0,\n  position_y INTEGER NOT NULL DEFAULT 0,\n  width INTEGER NOT NULL DEFAULT 1,\n  height INTEGER NOT NULL DEFAULT 1,\n  FOREIGN KEY (dashboard_id) REFERENCES dashboards(id) ON DELETE CASCADE\n);\n\nCREATE INDEX IF NOT EXISTS idx_events_tenant ON events(tenant_id);\nCREATE INDEX IF NOT EXISTS idx_events_name ON events(name);\nCREATE INDEX IF NOT EXISTS idx_events_timestamp ON events(timestamp);\nCREATE INDEX IF NOT EXISTS idx_dashboards_tenant ON dashboards(tenant_id);\nCREATE INDEX IF NOT EXISTS idx_users_tenant ON users(tenant_id);","is_error":false}]},"parent_tool_use_id":"toolu_01Re1E6VZfDpLibGwd7N1FKq","session_id":"30c29c03-ddd3-45f1-83c9-5d9bbc02b946","uuid":"d