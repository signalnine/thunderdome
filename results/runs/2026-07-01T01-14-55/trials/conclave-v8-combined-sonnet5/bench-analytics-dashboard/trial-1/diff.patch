+import { Router } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { getAuthUser } from '../auth';
+import { ValidationError } from '../errors';
+
+const router = Router();
+
+interface EventInput {
+  name?: string;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  session_id?: string;
+}
+
+interface EventOutput {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: Record<string, unknown>;
+  timestamp: string;
+  user_id: string;
+  session_id: string | null;
+}
+
+function insertEvent(
+  db: Database.Database,
+  tenantId: string,
+  userId: string,
+  input: EventInput
+): EventOutput {
+  if (!input || typeof input.name !== 'string' || input.name.length === 0) {
+    throw new ValidationError('Event name is required');
+  }
+  const id = uuidv4();
+  const properties = input.properties ?? {};
+  const timestamp = input.timestamp ?? new Date().toISOString();
+  const sessionId = input.session_id ?? null;
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, input.name, JSON.stringify(properties), timestamp, userId, sessionId);
+  return { id, tenant_id: tenantId, name: input.name, properties, timestamp, user_id: userId, session_id: sessionId };
+}
+
+router.post('/', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const event = insertEvent(db, user.tenantId, user.id, req.body ?? {});
+    res.status(201).json(event);
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const { events } = req.body ?? {};
+    if (!Array.isArray(events) || events.length === 0) {
+      throw new ValidationError('events must be a non-empty array');
+    }
+    const db = getDb();
+    const insertMany = db.transaction((items: EventInput[]) =>
+      items.map((item) => insertEvent(db, user.tenantId, user.id, item))
+    );
+    const inserted = insertMany(events);
+    res.status(201).json({ inserted: inserted.length, events: inserted });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
