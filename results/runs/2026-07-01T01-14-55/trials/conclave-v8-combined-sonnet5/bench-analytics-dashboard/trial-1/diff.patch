+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ULHgRTKgitmuodZYHA7QJh","type":"tool_result","content":"1\timport { Request, Response, NextFunction } from 'express';\n2\timport jwt from 'jsonwebtoken';\n3\timport { AuthError } from './errors';\n4\t\n5\texport const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-change-me';\n6\tconst TOKEN_TTL = '24h';\n7\t\n8\texport interface AuthUser {\n9\t  id: string;\n10\t  tenantId: string;\n11\t}\n12\t\n13\tdeclare module 'express-serve-static-core' {\n14\t  interface Request {\n15\t    user?: AuthUser;\n16\t  }\n17\t}\n18\t\n19\texport function signToken(userId: string, tenantId: string): string {\n20\t  return jwt.sign({ sub: userId, tid: tenantId }, JWT_SECRET, { expiresIn: TOKEN_TTL });\n21\t}\n22\t\n23\tfunction extractToken(req: Request): string | null {\n24\t  const header = req.headers.authorization;\n25\t  if (!header || !header.startsWith('Bearer ')) return null;\n26\t  return header.slice('Bearer '.length);\n27\t}\n28\t\n29\t/** Parses a bearer token if present and attaches req.user. Does not require one. */\n30\texport function optionalAuth(req: Request, _res: Response, next: NextFunction): void {\n31\t  const token = extractToken(req);\n32\t  if (!token) {\n33\t    next();\n34\t    return;\n35\t  }\n36\t  try {\n37\t    const payload = jwt.verify(token, JWT_SECRET) as jwt.JwtPayload;\n38\t    req.user = { id: payload.sub as string, tenantId: payload.tid as string };\n39\t    next();\n40\t  } catch {\n41\t    next(new AuthError('Invalid or expired token'));\n42\t  }\n43\t}\n44\t\n45\t/** Requires a valid bearer token; rejects with 401 otherwise. */\n46\texport function requireAuth(req: Request, res: Response, next: NextFunction): void {\n47\t  optionalAuth(req, res, (err?: unknown) => {\n48\t    if (err) {\n49\t      next(err);\n50\t      return;\n51\t    }\n52\t    if (!req.user) {\n53\t      next(new AuthError('Missing authentication token'));\n54\t      return;\n55\t    }\n56\t    next();\n57\t  });\n58\t}\n59\t\n60\texport function getAuthUser(req: Request): AuthUser {\n61\t  if (!req.user) {\n62\t    throw new AuthError('Missing authentication token');\n63\t  }\n64\t  return req.user;\n65\t}\n66\t"}]},"parent_tool_use_id":"toolu_01Re1E6VZfDpLibGwd7N1FKq","session_id":"30c29c03-ddd3-45f1-83c9-5d9bbc02b946","uuid":"8ddb528e-35d6-49af-8b3e-32c0c6403f2d","timestamp":"2026-07-01T01:35:46.477Z","subagent_type":"general-purpose","task_description":"Adversarial review of analytics dashboard API"}
