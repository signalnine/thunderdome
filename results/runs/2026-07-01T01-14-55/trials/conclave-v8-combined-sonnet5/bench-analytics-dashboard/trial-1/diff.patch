+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BkSANEDftU1RdKFgLMkEo7","type":"tool_result","content":"1\timport { Router } from 'express';\n2\timport Database from 'better-sqlite3';\n3\timport { v4 as uuidv4 } from 'uuid';\n4\timport { getDb } from '../db';\n5\timport { getAuthUser } from '../auth';\n6\timport { NotFoundError, ValidationError } from '../errors';\n7\t\n8\tconst router = Router();\n9\t\n10\tconst WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];\n11\t\n12\tinterface DashboardRow {\n13\t  id: string;\n14\t  tenant_id: string;\n15\t  name: string;\n16\t  owner_id: string;\n17\t  config: string;\n18\t  created_at: string;\n19\t  updated_at: string;\n20\t}\n21\t\n22\tinterface WidgetRow {\n23\t  id: string;\n24\t  dashboard_id: string;\n25\t  type: string;\n26\t  config: string;\n27\t  position_x: number;\n28\t  position_y: number;\n29\t  width: number;\n30\t  height: number;\n31\t}\n32\t\n33\tfunction toDashboard(row: DashboardRow) {\n34\t  return { ...row, config: JSON.parse(row.config) };\n35\t}\n36\t\n37\tfunction toWidget(row: WidgetRow) {\n38\t  return { ...row, config: JSON.parse(row.config) };\n39\t}\n40\t\n41\tfunction findDashboard(db: Database.Database, id: string, tenantId: string): DashboardRow {\n42\t  const row = db.prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?').get(id, tenantId) as\n43\t    | DashboardRow\n44\t    | undefined;\n45\t  if (!row) {\n46\t    throw new NotFoundError('Dashboard not found');\n47\t  }\n48\t  return row;\n49\t}\n50\t\n51\trouter.post('/', (req, res, next) => {\n52\t  try {\n53\t    const user = getAuthUser(req);\n54\t    const { name, config } = req.body ?? {};\n55\t    if (!name) {\n56\t      throw new ValidationError('name is required');\n57\t    }\n58\t    const db = getDb();\n59\t    const id = uuidv4();\n60\t    db.prepare('INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)').run(\n61\t      id,\n62\t      user.tenantId,\n63\t      name,\n64\t      user.id,\n65\t      JSON.stringify(config ?? {})\n66\t    );\n67\t    res.status(201).json(toDashboard(findDashboard(db, id, user.tenantId)));\n68\t  } catch (err) {\n69\t    next(err);\n70\t  }\n71\t});\n72\t\n73\trouter.get('/', (req, res, next) => {\n74\t  try {\n75\t    const user = getAuthUser(req);\n76\t    const db = getDb();\n77\t    const rows = db\n78\t      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at')\n79\t      .all(user.tenantId) as DashboardRow[];\n80\t    res.status(200).json(rows.map(toDashboard));\n81\t  } catch (err) {\n82\t    next(err);\n83\t  }\n84\t});\n85\t\n86\trouter.get('/:id', (req, res, next) => {\n87\t  try {\n88\t    const user = getAuthUser(req);\n89\t    const db = getDb();\n90\t    const row = findDashboard(db, req.params.id, user.tenantId);\n91\t    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(row.id) as WidgetRow[];\n92\t    res.status(200).json({ ...toDashboard(row), widgets: widgets.map(toWidget) });\n93\t  } catch (err) {\n94\t    next(err);\n95\t  }\n96\t});\n97\t\n98\trouter.patch('/:id', (req, res, next) => {\n99\t  try {\n100\t    const user = getAuthUser(req);\n101\t    const db = getDb();\n102\t    const row = findDashboard(db, req.params.id, user.tenantId);\n103\t    const { name, config } = req.body ?? {};\n104\t    const newName = name ?? row.name;\n105\t    const newConfig = config !== undefined ? JSON.stringify(config) : row.config;\n106\t    db.prepare(\"UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?\").run(\n107\t      newName,\n108\t      newConfig,\n109\t      row.id\n110\t    );\n111\t    res.status(200).json(toDashboard(findDashboard(db, row.id, user.tenantId)));\n112\t  } catch (err) {\n113\t    next(err);\n114\t  }\n115\t});\n116\t\n117\trouter.delete('/:id', (req, res, next) => {\n118\t  try {\n119\t    const user = getAuthUser(req);\n120\t    const db = getDb();\n121\t    const row = findDashboard(db, req.params.id, user.tenantId);\n122\t    db.prepare('DELETE FROM dashboards WHERE id = ?').run(row.id);\n123\t    res.status(204).send();\n124\t  } catch (err) {\n125\t    next(err);\n126\t  }\n127\t});\n128\t\n129\trouter.post('/:id/widgets', (req, res, next) => {\n130\t  try {\n131\t    const user = getAuthUser(req);\n132\t    const db = getDb();\n133\t    const dashboard = findDashboard(db, req.params.id, user.tenantId);\n134\t    const { type, config, position_x: positionX = 0, position_y: positionY = 0, width = 1, height = 1 } =\n135\t      req.body ?? {};\n136\t    if (!WIDGET_TYPES.includes(type)) {\n137\t      throw new ValidationError(`type must be one of ${WIDGET_TYPES.join(', ')}`);\n138\t    }\n139\t    const id = uuidv4();\n140\t    db.prepare(\n141\t      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'\n142\t    ).run(id, dashboard.id, type, JSON.stringify(config ?? {}), positionX, positionY, width, height);\n143\t    const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;\n144\t    res.status(201).json(toWidget(row));\n145\t  } catch (err) {\n146\t    next(err);\n147\t  }\n148\t});\n149\t\n150\trouter.delete('/:id/widgets/:widgetId', (req, res, next) => {\n151\t  try {\n152\t    const user = getAuthUser(req);\n153\t    const db = getDb();\n154\t    const dashboard = findDashboard(db, req.params.id, user.tenantId);\n155\t    const widget = db\n156\t      .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')\n157\t      .get(req.params.widgetId, dashboard.id);\n158\t    if (!widget) {\n159\t      throw new NotFoundError('Widget not found');\n160\t    }\n161\t    db.prepare('DELETE FROM widgets WHERE id = ?').run(req.params.widgetId);\n162\t    res.status(204).send();\n163\t  } catch (err) {\n164\t    next(err);\n165\t  }\n166\t});\n167\t\n168\texport default router;\n169\t"}]},"parent_tool_use_id":"too