?? {};\n56\t    if (!email || !password) {\n57\t      throw new ValidationError('email and password are required');\n58\t    }\n59\t    const db = getDb();\n60\t    const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;\n61\t    if (!row || !verifyPassword(password, row.password_hash)) {\n62\t      throw new AuthError('Invalid email or password');\n63\t    }\n64\t    const token = signToken(row.id, row.tenant_id);\n65\t    res.status(200).json({ token, user: toPublicUser(row) });\n66\t  } catch (err) {\n67\t    next(err);\n68\t  }\n69\t});\n70\t\n71\trouter.get('/me', (req, res, next) => {\n72\t  try {\n73\t    const authUser = getAuthUser(req);\n74\t    const db = getDb();\n75\t    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(authUser.id) as UserRow | undefined;\n76\t    if (!row) {\n77\t      throw new NotFoundError('User not found');\n78\t    }\n79\t    res.status(200).json(toPublicUser(row));\n80\t  } catch (err) {\n81\t    next(err);\n82\t  }\n83\t});\n84\t\n85\trouter.patch('/:id/role', (req, res, next) => {\n86\t  try {\n87\t    const authUser = getAuthUser(req);\n88\t    const db = getDb();\n89\t    const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(authUser.id) as UserRow | undefined;\n90\t    if (!requester || requester.role !== 'admin') {\n91\t      throw new ForbiddenError('Admin role required');\n92\t    }\n93\t    const { role } = req.body ?? {};\n94\t    if (!ROLES.includes(role)) {\n95\t      throw new ValidationError(`role must be one of ${ROLES.join(', ')}`);\n96\t    }\n97\t    const target = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow | undefined;\n98\t    if (!target) {\n99\t      throw new NotFoundError('User not found');\n100\t    }\n101\t    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, req.params.id);\n102\t    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow;\n103\t    res.status(200).json(toPublicUser(updated));\n104\t  } catch (err) {\n105\t    next(err);\n106\t  }\n107\t});\n108\t\n109\texport default router;\n110\t"}]},"parent_tool_use_id":"toolu_01Re1E6VZfDpLibGwd7N1FKq","session_id":"30c29c03-ddd3-45f1-83c9-5d9bbc02b946","uuid":"cbda9ba7-6059-46c8-9f88-c95193315d28","timestamp":"2026-07-01T01:35:49.380Z","subagent_type":"general-purpose","task_description":"Adversarial review of analytics dashboard API"}
