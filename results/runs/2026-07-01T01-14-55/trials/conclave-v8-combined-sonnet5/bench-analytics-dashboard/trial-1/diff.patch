new file mode 100644
index 0000000..fda2347
--- /dev/null
+++ b/src/users/router.ts
@@ -0,0 +1,109 @@
+import { Router } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { getAuthUser, signToken } from '../auth';
+import { AuthError, ConflictError, ForbiddenError, NotFoundError, ValidationError } from '../errors';
+import { hashPassword, verifyPassword } from './password';
+
+const router = Router();
+
+const ROLES = ['admin', 'viewer', 'editor'];
+
+interface UserRow {
+  id: string;
+  email: string;
+  password_hash: string;
+  tenant_id: string;
+  role: string;
+  created_at: string;
+}
+
+function toPublicUser(row: UserRow) {
+  return {
+    id: row.id,
+    email: row.email,
+    tenant_id: row.tenant_id,
+    role: row.role,
+    created_at: row.created_at,
+  };
+}
+
+router.post('/', (req, res, next) => {
+  try {
+    const { email, password, tenant_id: tenantId } = req.body ?? {};
+    if (!email || !password || !tenantId) {
+      throw new ValidationError('email, password, and tenant_id are required');
+    }
+    const db = getDb();
+    const existing = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
+    if (existing) {
+      throw new ConflictError('Email already registered');
+    }
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO users (id, email, password_hash, tenant_id, role) VALUES (?, ?, ?, ?, ?)'
+    ).run(id, email, hashPassword(password), tenantId, 'viewer');
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(id) as UserRow;
+    res.status(201).json(toPublicUser(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/login', (req, res, next) => {
+  try {
+    const { email, password } = req.body ?? {};
+    if (!email || !password) {
+      throw new ValidationError('email and password are required');
+    }
+    const db = getDb();
+    const row = db.prepare('SELECT * FROM users WHERE email = ?').get(email) as UserRow | undefined;
+    if (!row || !verifyPassword(password, row.password_hash)) {
+      throw new AuthError('Invalid email or password');
+    }
+    const token = signToken(row.id, row.tenant_id);
+    res.status(200).json({ token, user: toPublicUser(row) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/me', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    const db = getDb();
+    const row = db.prepare('SELECT * FROM users WHERE id = ?').get(authUser.id) as UserRow | undefined;
+    if (!row) {
+      throw new NotFoundError('User not found');
+    }
+    res.status(200).json(toPublicUser(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id/role', (req, res, next) => {
+  try {
+    const authUser = getAuthUser(req);
+    const db = getDb();
+    const requester = db.prepare('SELECT * FROM users WHERE id = ?').get(authUser.id) as UserRow | undefined;
+    if (!requester || requester.role !== 'admin') {
+      throw new ForbiddenError('Admin role required');
+    }
+    const { role } = req.body ?? {};
+    if (!ROLES.includes(role)) {
+      throw new ValidationError(`role must be one of ${ROLES.join(', ')}`);
+    }
+    const target = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow | undefined;
+    if (!target) {
+      throw new NotFoundError('User not found');
+    }
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, req.params.id);
+    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(req.params.id) as UserRow;
+    res.status(200).json(toPublicUser(updated));
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
