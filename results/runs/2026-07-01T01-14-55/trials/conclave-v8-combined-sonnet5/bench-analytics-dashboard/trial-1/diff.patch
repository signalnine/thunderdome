AndLogin(app, 'exp@test.com', 'pass', TENANT_A);\n320\t\n321\t    await request(app)\n322\t      .post('/events')\n323\t      .set('Authorization', `Bearer ${token}`)\n324\t      .send({ name: 'exported_event' });\n325\t\n326\t    const res = await request(app)\n327\t      .get('/export/events?format=json')\n328\t      .set('Authorization', `Bearer ${token}`);\n329\t\n330\t    expect(res.status).toBe(200);\n331\t    expect(res.body).toBeInstanceOf(Array);\n332\t    expect(res.body.length).toBeGreaterThanOrEqual(1);\n333\t  });\n334\t\n335\t  it('should export dashboard data with real JWT', async () => {\n336\t    const token = await registerAndLogin(app, 'expd@test.com', 'pass', TENANT_A);\n337\t\n338\t    const dashRes = await request(app)\n339\t      .post('/dashboards')\n340\t      .set('Authorization', `Bearer ${token}`)\n341\t      .send({ name: 'Export Dash' });\n342\t\n343\t    const dashId = dashRes.body.id;\n344\t\n345\t    await request(app)\n346\t      .post(`/dashboards/${dashId}/widgets`)\n347\t      .set('Authorization', `Bearer ${token}`)\n348\t      .send({ type: 'breakdown', config: { prop: 'page' } });\n349\t\n350\t    const res = await request(app)\n351\t      .get(`/export/dashboard/${dashId}`)\n352\t      .set('Authorization', `Bearer ${token}`);\n353\t\n354\t    expect(res.status).toBe(200);\n355\t    expect(res.body.dashboard.name).toBe('Export Dash');\n356\t    expect(res.body.widgets).toHaveLength(1);\n357\t  });\n358\t\n359\t  // --- Cross-feature: Full Workflow (2 tests) ---\n360\t\n361\t  it('should complete full workflow: register, ingest, query, dashboard, export', async () => {\n362\t    // Register and login\n363\t    const token = await registerAndLogin(app, 'full@test.com', 'pass', TENANT_A);\n364\t\n365\t    // Get profile\n366\t    const meRes = await request(app)\n367\t      .get('/users/me')\n368\t      .set('Authorization', `Bearer ${token}`);\n369\t    expect(meRes.status).toBe(200);\n370\t\n371\t    // Ingest events\n372\t    await request(app)\n373\t      .post('/events/batch')\n374\t      .set('Authorization', `Bearer ${token}`)\n375\t      .send({\n376\t        events: [\n377\t          { name: 'page_view', properties: { page: '/home' }, timestamp: '2024-01-15T10:00:00Z' },\n378\t          { name: 'page_view', properties: { page: '/about' }, timestamp: '2024-01-15T11:00:00Z' },\n379\t          { name: 'click', properties: { button: 'buy' }, timestamp: '2024-01-15T10:30:00Z' },\n380\t        ],\n381\t      });\n382\t\n383\t    // Query count\n384\t    const countRes = await request(app)\n385\t      .post('/query/count')\n386\t      .set('Authorization', `Bearer ${token}`)\n387\t      .send({ event_name: 'page_view' });\n388\t    expect(countRes.body.count).toBe(2);\n389\t\n390\t    // Create dashboard\n391\t    const dashRes = await request(app)\n392\t      .post('/dashboards')\n393\t      .set('Authorization', `Bearer ${token}`)\n394\t      .send({ name: 'Full Workflow Dash' });\n395\t    const dashId = dashRes.body.id;\n396\t\n397\t    // Add widget\n398\t    await request(app)\n399\t      .post(`/dashboards/${dashId}/widgets`)\n400\t      .set('Authorization', `Bearer ${token}`)\n401\t      .send({ type: 'counter', config: { event_name: 'page_view' } });\n402\t\n403\t    // Export events\n404\t    const exportRes = await request(app)\n405\t      .get('/export/events?format=json')\n406\t      .set('Authorization', `Bearer ${token}`);\n407\t    expect(exportRes.body).toHaveLength(3);\n408\t\n409\t    // Export dashboard\n410\t    const dashExportRes = await request(app)\n411\t      .get(`/export/dashboard/${dashId}`)\n412\t      .set('Authorization', `Bearer ${token}`);\n413\t    expect(dashExportRes.body.widgets).toHaveLength(1);\n414\t  });\n415\t\n416\t  it('should handle breakdown and funnel queries in full workflow', async () => {\n417\t    const token = await registerAndLogin(app, 'funnel@test.com', 'pass', TENANT_A);\n418\t\n419\t    // Ingest funnel events with session\n420\t