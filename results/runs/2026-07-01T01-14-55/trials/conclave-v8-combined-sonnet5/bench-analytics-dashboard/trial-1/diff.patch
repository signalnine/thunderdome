+import { Router } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { getAuthUser } from '../auth';
+import { NotFoundError, ValidationError } from '../errors';
+
+const router = Router();
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function toDashboard(row: DashboardRow) {
+  return { ...row, config: JSON.parse(row.config) };
+}
+
+function toWidget(row: WidgetRow) {
+  return { ...row, config: JSON.parse(row.config) };
+}
+
+function findDashboard(db: Database.Database, id: string, tenantId: string): DashboardRow {
+  const row = db.prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?').get(id, tenantId) as
+    | DashboardRow
+    | undefined;
+  if (!row) {
+    throw new NotFoundError('Dashboard not found');
+  }
+  return row;
+}
+
+router.post('/', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const { name, config } = req.body ?? {};
+    if (!name) {
+      throw new ValidationError('name is required');
+    }
+    const db = getDb();
+    const id = uuidv4();
+    db.prepare('INSERT INTO dashboards (id, tenant_id, name, owner_id, config) VALUES (?, ?, ?, ?, ?)').run(
+      id,
+      user.tenantId,
+      name,
+      user.id,
+      JSON.stringify(config ?? {})
+    );
+    res.status(201).json(toDashboard(findDashboard(db, id, user.tenantId)));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const rows = db
+      .prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at')
+      .all(user.tenantId) as DashboardRow[];
+    res.status(200).json(rows.map(toDashboard));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/:id', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const row = findDashboard(db, req.params.id, user.tenantId);
+    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(row.id) as WidgetRow[];
+    res.status(200).json({ ...toDashboard(row), widgets: widgets.map(toWidget) });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.patch('/:id', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const row = findDashboard(db, req.params.id, user.tenantId);
+    const { name, config } = req.body ?? {};
+    const newName = name ?? row.name;
+    const newConfig = config !== undefined ? JSON.stringify(config) : row.config;
+    db.prepare("UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?").run(
+      newName,
+      newConfig,
+      row.id
+    );
+    res.status(200).json(toDashboard(findDashboard(db, row.id, user.tenantId)));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const row = findDashboard(db, req.params.id, user.tenantId);
+    db.prepare('DELETE FROM dashboards WHERE id = ?').run(row.id);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/:id/widgets', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const dashboard = findDashboard(db, req.params.id, user.tenantId);
+    const { type, config, position_x: positionX = 0, position_y: positionY = 0, width = 1, height = 1 } =
+      req.body ?? {};
+    if (!WIDGET_TYPES.includes(type)) {
+      throw new ValidationError(`type must be one of ${WIDGET_TYPES.join(', ')}`);
+    }
+    if (
+      !Number.isInteger(positionX) ||
+      !Number.isInteger(positionY) ||
+      positionX < 0 ||
+      positionY < 0 ||
+      !Number.isInteger(width) ||
+      !Number.isInteger(height) ||
+      width < 1 ||
+      height < 1
+    ) {
+      throw new ValidationError('position_x, position_y must be >= 0 and width, height must be >= 1');
+    }
+    const id = uuidv4();
+    db.prepare(
+      'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, dashboard.id, type, JSON.stringify(config ?? {}), positionX, positionY, width, height);
+    const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;
+    res.status(201).json(toWidget(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.delete('/:id/widgets/:widgetId', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const dashboard = findDashboard(db, req.params.id, user.tenantId);
+    const widget = db
+      .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')
+      .get(req.params.widgetId, dashboard.id);
+    if (!widget) {
+      throw new NotFoundError('Widget not found');
+    }
+    db.prepare('DELETE FROM widgets WHERE id = ?').run(req.params.widgetId);
+    res.status(204).send();
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
