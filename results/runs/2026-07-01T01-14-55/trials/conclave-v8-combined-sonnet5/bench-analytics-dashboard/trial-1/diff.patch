@@ -0,0 +1,104 @@
+import { Router } from 'express';
+import { getDb } from '../db';
+import { getAuthUser } from '../auth';
+import { NotFoundError, ValidationError } from '../errors';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const CSV_COLUMNS = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'] as const;
+
+const FORMULA_PREFIX = /^[=+\-@]/;
+
+function sanitizeCsvField(text: string): string {
+  const escaped = FORMULA_PREFIX.test(text) ? `'${text}` : text;
+  return `"${escaped.replace(/"/g, '""')}"`;
+}
+
+function toCsv(rows: EventRow[]): string {
+  const lines = [CSV_COLUMNS.join(',')];
+  for (const row of rows) {
+    const values = CSV_COLUMNS.map((col) => {
+      const value = row[col];
+      const text = value === null || value === undefined ? '' : String(value);
+      return sanitizeCsvField(text);
+    });
+    lines.push(values.join(','));
+  }
+  return lines.join('\n');
+}
+
+router.get('/events', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const format = (req.query.format as string) ?? 'json';
+    if (format !== 'json' && format !== 'csv') {
+      throw new ValidationError('format must be json or csv');
+    }
+    const db = getDb();
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+      .all(user.tenantId) as EventRow[];
+
+    if (format === 'csv') {
+      res.status(200).setHeader('Content-Type', 'text/csv');
+      res.send(toCsv(rows));
+      return;
+    }
+    res.status(200).json(rows.map((row) => ({ ...row, properties: JSON.parse(row.properties) })));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const db = getDb();
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, user.tenantId) as DashboardRow | undefined;
+    if (!dashboard) {
+      throw new NotFoundError('Dashboard not found');
+    }
+    const widgets = db.prepare('SELECT * FROM widgets WHERE dashboard_id = ?').all(dashboard.id) as WidgetRow[];
+    res.status(200).json({
+      dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },
+      widgets: widgets.map((widget) => ({ ...widget, config: JSON.parse(widget.config) })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
