+import { Router } from 'express';
+import { getDb } from '../db';
+import { getAuthUser } from '../auth';
+import { ValidationError } from '../errors';
+
+const router = Router();
+
+function bucketFormat(bucket: unknown): string {
+  switch (bucket) {
+    case 'hour':
+      return '%Y-%m-%dT%H:00:00';
+    case 'week':
+      return '%Y-%W';
+    case 'day':
+    default:
+      return '%Y-%m-%d';
+  }
+}
+
+function applyTimeRange(sql: string, params: unknown[], start?: string, end?: string): string {
+  let out = sql;
+  if (start) {
+    out += ' AND timestamp >= ?';
+    params.push(start);
+  }
+  if (end) {
+    out += ' AND timestamp <= ?';
+    params.push(end);
+  }
+  return out;
+}
+
+router.post('/count', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const { event_name: eventName, start, end } = req.body ?? {};
+    if (!eventName) {
+      throw new ValidationError('event_name is required');
+    }
+    const db = getDb();
+    const params: unknown[] = [user.tenantId, eventName];
+    let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+    sql = applyTimeRange(sql, params, start, end);
+    const row = db.prepare(sql).get(...params) as { count: number };
+    res.status(200).json({ count: row.count });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/timeseries', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const { event_name: eventName, bucket, start, end } = req.body ?? {};
+    if (!eventName) {
+      throw new ValidationError('event_name is required');
+    }
+    const db = getDb();
+    const format = bucketFormat(bucket);
+    const params: unknown[] = [user.tenantId, eventName];
+    let sql = `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+    sql = applyTimeRange(sql, params, start, end);
+    sql += ' GROUP BY bucket ORDER BY bucket';
+    const rows = db.prepare(sql).all(...params);
+    res.status(200).json({ data: rows });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/breakdown', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const { event_name: eventName, property_key: propertyKey, start, end } = req.body ?? {};
+    if (!eventName || !propertyKey) {
+      throw new ValidationError('event_name and property_key are required');
+    }
+    const db = getDb();
+    const params: unknown[] = [`$.${propertyKey}`, user.tenantId, eventName];
+    let sql =
+      'SELECT json_extract(properties, ?) as property_value, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+    sql = applyTimeRange(sql, params, start, end);
+    sql += ' GROUP BY property_value ORDER BY count DESC';
+    const rows = db.prepare(sql).all(...params);
+    res.status(200).json({ data: rows });
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/funnel', (req, res, next) => {
+  try {
+    const user = getAuthUser(req);
+    const { steps, start, end } = req.body ?? {};
+    if (!Array.isArray(steps) || steps.length === 0) {
+      throw new ValidationError('steps must be a non-empty array');
+    }
+    const db = getDb();
+    const params: unknown[] = [user.tenantId];
+    let sql = 'SELECT session_id, name FROM events WHERE tenant_id = ? AND session_id IS NOT NULL';
+    sql = applyTimeRange(sql, params, start, end);
+    const rows = db.prepare(sql).all(...params) as { session_id: string; name: string }[];
+
+    const sessionEvents = new Map<string, Set<string>>();
+    for (const row of rows) {
+      if (!sessionEvents.has(row.session_id)) {
+        sessionEvents.set(row.session_id, new Set());
+      }
+      sessionEvents.get(row.session_id)!.add(row.name);
+    }
+
+    let qualifying = new Set(sessionEvents.keys());
+    const results = steps.map((step: string) => {
+      qualifying = new Set([...qualifying].filter((sid) => sessionEvents.get(sid)!.has(step)));
+      return { step, count: qualifying.size };
+    });
+
+    res.status(200).json({ steps: results });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
