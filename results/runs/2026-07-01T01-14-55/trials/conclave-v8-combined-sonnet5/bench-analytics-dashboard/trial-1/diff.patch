@@ -0,0 +1,65 @@
+import { Request, Response, NextFunction } from 'express';
+import jwt from 'jsonwebtoken';
+import { AuthError } from './errors';
+
+export const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-change-me';
+const TOKEN_TTL = '24h';
+
+export interface AuthUser {
+  id: string;
+  tenantId: string;
+}
+
+declare module 'express-serve-static-core' {
+  interface Request {
+    user?: AuthUser;
+  }
+}
+
+export function signToken(userId: string, tenantId: string): string {
+  return jwt.sign({ sub: userId, tid: tenantId }, JWT_SECRET, { expiresIn: TOKEN_TTL });
+}
+
+function extractToken(req: Request): string | null {
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) return null;
+  return header.slice('Bearer '.length);
+}
+
+/** Parses a bearer token if present and attaches req.user. Does not require one. */
+export function optionalAuth(req: Request, _res: Response, next: NextFunction): void {
+  const token = extractToken(req);
+  if (!token) {
+    next();
+    return;
+  }
+  try {
+    const payload = jwt.verify(token, JWT_SECRET) as jwt.JwtPayload;
+    req.user = { id: payload.sub as string, tenantId: payload.tid as string };
+    next();
+  } catch {
+    next(new AuthError('Invalid or expired token'));
+  }
+}
+
+/** Requires a valid bearer token; rejects with 401 otherwise. */
+export function requireAuth(req: Request, res: Response, next: NextFunction): void {
+  optionalAuth(req, res, (err?: unknown) => {
+    if (err) {
+      next(err);
+      return;
+    }
+    if (!req.user) {
+      next(new AuthError('Missing authentication token'));
+      return;
+    }
+    next();
+  });
+}
+
+export function getAuthUser(req: Request): AuthUser {
+  if (!req.user) {
+    throw new AuthError('Missing authentication token');
+  }
+  return req.user;
+}
