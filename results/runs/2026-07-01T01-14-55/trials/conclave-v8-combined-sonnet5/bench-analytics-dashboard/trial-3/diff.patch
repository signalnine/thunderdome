nst dashId = dashRes.body.id;\n\n    const widgetRes = await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'counter', config: { event_name: 'page_view' } });\n\n    expect(widgetRes.status).toBe(201);\n    expect(widgetRes.body.type).toBe('counter');\n    expect(widgetRes.body.dashboard_id).toBe(dashId);\n  });\n\n  it('should delete widget from dashboard with real JWT', async () => {\n    const token = await registerAndLogin(app, 'wdel@test.com', 'pass', TENANT_A);\n\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Widget Dash' });\n\n    const dashId = dashRes.body.id;\n\n    const widgetRes = await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'timeseries', config: {} });\n\n    const widgetId = widgetRes.body.id;\n\n    const delRes = await request(app)\n      .delete(`/dashboards/${dashId}/widgets/${widgetId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(delRes.status).toBe(204);\n  });\n\n  // --- Export with Real Auth (2 tests) ---\n\n  it('should export events as JSON with real JWT', async () => {\n    const token = await registerAndLogin(app, 'exp@test.com', 'pass', TENANT_A);\n\n    await request(app)\n      .post('/events')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'exported_event' });\n\n    const res = await request(app)\n      .get('/export/events?format=json')\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body).toBeInstanceOf(Array);\n    expect(res.body.length).toBeGreaterThanOrEqual(1);\n  });\n\n  it('should export dashboard data with real JWT', async () => {\n    const token = await registerAndLogin(app, 'expd@test.com', 'pass', TENANT_A);\n\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Export Dash' });\n\n    const dashId = dashRes.body.id;\n\n    await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .set('Authorization', `Bearer ${token}`)\n      .send({ type: 'breakdown', config: { prop: 'page' } });\n\n    const res = await request(app)\n      .get(`/export/dashboard/${dashId}`)\n      .set('Authorization', `Bearer ${token}`);\n\n    expect(res.status).toBe(200);\n    expect(res.body.dashboard.name).toBe('Export Dash');\n    expect(res.body.widgets).toHaveLength(1);\n  });\n\n  // --- Cross-feature: Full Workflow (2 tests) ---\n\n  it('should complete full workflow: register, ingest, query, dashboard, export', async () => {\n    // Register and login\n    const token = await registerAndLogin(app, 'full@test.com', 'pass', TENANT_A);\n\n    // Get profile\n    const meRes = await request(app)\n      .get('/users/me')\n      .set('Authorization', `Bearer ${token}`);\n    expect(meRes.status).toBe(200);\n\n    // Ingest events\n    await request(app)\n      .post('/events/batch')\n      .set('Authorization', `Bearer ${token}`)\n      .send({\n        events: [\n          { name: 'page_view', properties: { page: '/home' }, timestamp: '2024-01-15T10:00:00Z' },\n          { name: 'page_view', properties: { page: '/about' }, timestamp: '2024-01-15T11:00:00Z' },\n          { name: 'click', properties: { button: 'buy' }, timestamp: '2024-01-15T10:30:00Z' },\n        ],\n      });\n\n    // Query count\n    const countRes = await request(app)\n      .post('/query/count')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ event_name: 'page_view' });\n    expect(countRes.body.count).toBe(2);\n\n    // Create dashboard\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${token}`)\n      .send({ name: 'Full Workflow Dash' });\n    const dashId = dashRes.body.id;\n\n    // Add widget\n    await requ