@@ -0,0 +1,52 @@
+import { Request, Response, NextFunction } from 'express';
+import jwt from 'jsonwebtoken';
+import { AuthError } from './errors';
+import { AuthUser } from './types';
+
+const JWT_SECRET = process.env.JWT_SECRET || 'dev-secret-key-change-in-production';
+
+interface JwtPayload {
+  sub: string;
+  tid: string;
+  iat: number;
+  exp: number;
+}
+
+export function signToken(userId: string, tenantId: string): string {
+  return jwt.sign({ sub: userId, tid: tenantId }, JWT_SECRET, { expiresIn: '24h' });
+}
+
+/**
+ * Populates req.user from a Bearer JWT. If req.user is already set (e.g. by a
+ * test harness's mock auth), verification is skipped so both real and mocked
+ * auth contexts satisfy the same downstream contract.
+ */
+export function authMiddleware(req: Request, _res: Response, next: NextFunction): void {
+  if (req.user) {
+    next();
+    return;
+  }
+
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith('Bearer ')) {
+    throw new AuthError('Missing or invalid authorization header');
+  }
+
+  const token = header.slice('Bearer '.length);
+  let payload: JwtPayload;
+  try {
+    payload = jwt.verify(token, JWT_SECRET) as JwtPayload;
+  } catch {
+    throw new AuthError('Invalid or expired token');
+  }
+
+  req.user = { id: payload.sub, tenantId: payload.tid };
+  next();
+}
+
+export function getUser(req: Request): AuthUser {
+  if (!req.user) {
+    throw new AuthError('Not authenticated');
+  }
+  return req.user;
+}
