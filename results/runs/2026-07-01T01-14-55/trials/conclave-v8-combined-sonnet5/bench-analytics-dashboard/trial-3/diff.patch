, name, user.id, JSON.stringify(config ?? {}));\n\n  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(id) as DashboardRow;\n  res.status(201).json(serializeDashboard(row));\n});\n\nrouter.get('/', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const db = getDb();\n  const rows = db\n    .prepare('SELECT * FROM dashboards WHERE tenant_id = ?')\n    .all(user.tenantId) as DashboardRow[];\n  res.status(200).json(rows.map(serializeDashboard));\n});\n\nrouter.get('/:id', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const db = getDb();\n  const dashboard = getDashboardOrThrow(db, req.params.id, user.tenantId);\n  const widgets = db\n    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')\n    .all(dashboard.id) as WidgetRow[];\n  res.status(200).json({ ...serializeDashboard(dashboard), widgets: widgets.map(serializeWidget) });\n});\n\nrouter.patch('/:id', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const db = getDb();\n  const existing = getDashboardOrThrow(db, req.params.id, user.tenantId);\n  const { name, config } = (req.body ?? {}) as { name?: unknown; config?: unknown };\n\n  const newName = typeof name === 'string' && name.length > 0 ? name : existing.name;\n  const newConfig = config !== undefined ? JSON.stringify(config) : existing.config;\n\n  db.prepare(\"UPDATE dashboards SET name = ?, config = ?, updated_at = datetime('now') WHERE id = ?\").run(\n    newName,\n    newConfig,\n    existing.id\n  );\n\n  const row = db.prepare('SELECT * FROM dashboards WHERE id = ?').get(existing.id) as DashboardRow;\n  res.status(200).json(serializeDashboard(row));\n});\n\nrouter.delete('/:id', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const db = getDb();\n  const existing = getDashboardOrThrow(db, req.params.id, user.tenantId);\n  db.prepare('DELETE FROM dashboards WHERE id = ?').run(existing.id);\n  res.status(204).send();\n});\n\nrouter.post('/:id/widgets', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const db = getDb();\n  const dashboard = getDashboardOrThrow(db, req.params.id, user.tenantId);\n\n  const {\n    type,\n    config,\n    position_x: positionX = 0,\n    position_y: positionY = 0,\n    width = 1,\n    height = 1,\n  } = (req.body ?? {}) as {\n    type?: unknown;\n    config?: unknown;\n    position_x?: number;\n    position_y?: number;\n    width?: number;\n    height?: number;\n  };\n\n  if (typeof type !== 'string' || !VALID_WIDGET_TYPES.includes(type)) {\n    throw new ValidationError('Invalid widget type');\n  }\n\n  const id = uuidv4();\n  db.prepare(\n    'INSERT INTO widgets (id, dashboard_id, type, config, position_x, position_y, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?)'\n  ).run(id, dashboard.id, type, JSON.stringify(config ?? {}), positionX, positionY, width, height);\n\n  const row = db.prepare('SELECT * FROM widgets WHERE id = ?').get(id) as WidgetRow;\n  res.status(201).json(serializeWidget(row));\n});\n\nrouter.delete('/:id/widgets/:widgetId', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const db = getDb();\n  const dashboard = getDashboardOrThrow(db, req.params.id, user.tenantId);\n\n  const widget = db\n    .prepare('SELECT * FROM widgets WHERE id = ? AND dashboard_id = ?')\n    .get(req.params.widgetId, dashboard.id);\n  if (!widget) throw new NotFoundError('Widget not found');\n\n  db.prepare('DELETE FROM widgets WHERE id = ?').run(req.params.widgetId);\n  res.status(204).send();\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2194,"cache_read_input_tokens":83032,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2194},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b2aa