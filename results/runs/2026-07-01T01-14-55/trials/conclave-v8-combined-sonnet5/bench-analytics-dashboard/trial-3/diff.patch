+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { ValidationError, NotFoundError } from '../errors';
+import { getUser } from '../auth';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const CSV_COLUMNS = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'] as const;
+
+function csvEscape(value: string): string {
+  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
+    return `"${value.replace(/"/g, '""')}"`;
+  }
+  return value;
+}
+
+router.get('/events', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const format = req.query.format;
+
+  if (format !== 'json' && format !== 'csv') {
+    throw new ValidationError('format must be either "json" or "csv"');
+  }
+
+  const db = getDb();
+  const rows = db
+    .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp')
+    .all(user.tenantId) as EventRow[];
+
+  if (format === 'json') {
+    res.status(200).json(rows.map((row) => ({ ...row, properties: JSON.parse(row.properties) })));
+    return;
+  }
+
+  const lines = [CSV_COLUMNS.join(',')];
+  for (const row of rows) {
+    lines.push(CSV_COLUMNS.map((col) => csvEscape(String(row[col] ?? ''))).join(','));
+  }
+  res.status(200).set('Content-Type', 'text/csv').send(lines.join('\n'));
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const db = getDb();
+
+  const dashboard = db
+    .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+    .get(req.params.id, user.tenantId) as DashboardRow | undefined;
+  if (!dashboard) throw new NotFoundError('Dashboard not found');
+
+  const widgets = db
+    .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+    .all(dashboard.id) as WidgetRow[];
+
+  res.status(200).json({
+    dashboard: { ...dashboard, config: JSON.parse(dashboard.config) },
+    widgets: widgets.map((widget) => ({ ...widget, config: JSON.parse(widget.config) })),
+  });
+});
+
+export default router;
