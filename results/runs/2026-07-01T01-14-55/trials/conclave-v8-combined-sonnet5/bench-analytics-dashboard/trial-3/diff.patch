t decoded = jwt.decode(token) as Record<string, unknown>;\n55\t\n56\t    expect(decoded).toHaveProperty('sub');\n57\t    expect(decoded).toHaveProperty('tid');\n58\t    expect(decoded).toHaveProperty('iat');\n59\t    expect(decoded).toHaveProperty('exp');\n60\t    expect(decoded.tid).toBe(TENANT_A);\n61\t  });\n62\t\n63\t  // --- Auth Error Format Consistency (2 tests) ---\n64\t\n65\t  it('should return consistent error format for missing auth', async () => {\n66\t    const endpoints = [\n67\t      { method: 'get' as const, url: '/users/me' },\n68\t      { method: 'post' as const, url: '/events' },\n69\t      { method: 'post' as const, url: '/query/count' },\n70\t      { method: 'get' as const, url: '/dashboards' },\n71\t      { method: 'get' as const, url: '/export/events?format=json' },\n72\t    ];\n73\t\n74\t    for (const ep of endpoints) {\n75\t      const res = await request(app)[ep.method](ep.url);\n76\t      expect(res.status).toBe(401);\n77\t      expect(res.body).toHaveProperty('error');\n78\t      expect(res.body).toHaveProperty('code');\n79\t      expect(typeof res.body.error).toBe('string');\n80\t      expect(typeof res.body.code).toBe('string');\n81\t    }\n82\t  });\n83\t\n84\t  it('should return consistent error format for invalid token', async () => {\n85\t    const endpoints = [\n86\t      { method: 'get' as const, url: '/users/me' },\n87\t      { method: 'post' as const, url: '/events' },\n88\t      { method: 'get' as const, url: '/dashboards' },\n89\t    ];\n90\t\n91\t    for (const ep of endpoints) {\n92\t      const res = await request(app)\n93\t        [ep.method](ep.url)\n94\t        .set('Authorization', 'Bearer invalid-token-here');\n95\t\n96\t      expect(res.status).toBe(401);\n97\t      expect(res.body).toHaveProperty('error');\n98\t      expect(res.body).toHaveProperty('code');\n99\t      expect(res.body.code).toBe('AUTH_ERROR');\n100\t    }\n101\t  });\n102\t\n103\t  // --- Ingest with Real Auth (2 tests) ---\n104\t\n105\t  it('should ingest a single event with real JWT', async () => {\n106\t    const token = await registerAndLogin(app, 'ingest@test.com', 'pass', TENANT_A);\n107\t\n108\t    const res = await request(app)\n109\t      .post('/events')\n110\t      .set('Authorization', `Bearer ${token}`)\n111\t      .send({ name: 'page_view', properties: { page: '/home' } });\n112\t\n113\t    expect(res.status).toBe(201);\n114\t    expect(res.body.name).toBe('page_view');\n115\t    expect(res.body.tenant_id).toBe(TENANT_A);\n116\t  });\n117\t\n118\t  it('should ingest batch events with real JWT', async () => {\n119\t    const token = await registerAndLogin(app, 'batch@test.com', 'pass', TENANT_A);\n120\t\n121\t    const res = await request(app)\n122\t      .post('/events/batch')\n123\t      .set('Authorization', `Bearer ${token}`)\n124\t      .send({\n125\t        events: [\n126\t          { name: 'view', properties: { p: '1' } },\n127\t          { name: 'click', properties: { p: '2' } },\n128\t        ],\n129\t      });\n130\t\n131\t    expect(res.status).toBe(201);\n132\t    expect(res.body.inserted).toBe(2);\n133\t  });\n134\t\n135\t  // --- Query with Real Auth + Tenant Isolation (3 tests) ---\n136\t\n137\t  it('should query event count with real JWT', async () => {\n138\t    const token = await registerAndLogin(app, 'q@test.com', 'pass', TENANT_A);\n139\t\n140\t    // Ingest events\n141\t    await request(app)\n142\t      .post('/events/batch')\n143\t      .set('Authorization', `Bearer ${token}`)\n144\t      .send({\n145\t        events: [\n146\t          { name: 'page_view' },\n147\t          { name: 'page_view' },\n148\t          { name: 'click' },\n149\t        ],\n150\t      });\n151\t\n152\t    const res = await request(app)\n153\t      .post('/query/count')\n154\t      .set('Authorization', `Bearer ${token}`)\n155\t      .send({ event_name: 'page_view' });\n156\t\n157\t    expect(res.status).toBe(200);\n158\t    expect(res.body.count).toBe(2);\n159\t  });\n160\t\n161\t  it('should return timeseries data with real JWT', async () => {\n162\t    const token = await registerAndLogin(app, 'ts@test.com', 'pass', TENANT_A);\n163\t\n164\t    await request(app)\n165\t      .post('/events')\n166\t      .set('Authorization', `Bearer ${token}`)\n167\t      .send({ name: 'view', timestamp: '2024-01-15T10:00:00Z' });\n168\t\n169\t    const res = await request(app)\n170\t      .post('/query/timeseries')\n171\t      .set('Authorization', `Bearer ${token}`)\n172\t      .send({ event_name: 'view', bucket: 'day' });\n173\t\n174\t    expect(res.status).toBe(200);\n175\t    expect(res.body.data).toBeInstanceOf(Array);\n176\t  });\n177\t\n178\t  it('should enforce tenant isolation in queries', async () => {\n179\t    const tokenA = await registerAndLogin(app, 'a@test.com', 'pass', TENANT_A);\n180\t    const tokenB = await registerAndLogin(app, 'b@test.com', 'pass', TENANT_B);\n181\t\n182\t    // Tenant A ingests events\n183\t    await request(app)\n184\t      .post('/events/batch')\n185\t      .set('Authorization', `Bearer ${tokenA}`)\n186\t      .send({\n187\t        events: [{ name: 'secret_event' }, { name: 'secret_event' }],\n188\t      });\n189\t\n190\t    // Tenant B should not see Tenant A's events\n191\t    const res = await request(app)\n192\t      .post('/query/count')\n193\t      .set('Authorization', `Bearer ${tokenB}`)\n194\t      .send({ event_name: 'secret_event' });\n195\t\n196\t    expect(res.status).toBe(200);\n197\t    expect(res.body.count).toBe(0);\n198\t  });\n199\t\n200\t  // --- Dashboard CRUD with Real Auth (3 tests) ---\n201\t\n202\t  it('should create and list dashboards with real JWT', async () => {\n203\t    const token = await registerAndLogin(app, 'dash@test.com', 'pass', TENANT_A);\n204\t\n205\t    const createRes = await request(app)\n206\t      .post('/dashboards')\n207\t      .set('Authorization', `Bearer ${token}`)\n208\t      .send({ name: 'My Dashboard' });\n209\t\n210\t    expect(createRes.status).toBe(201);\n211\t    expect(createRes.body.name).toBe('My Dashboard');\n212\t\n213\t    const listRes = await request(app)\n214\t      .get('/dashboards')\n215\t      .set('Authorization', `Bearer ${token}`);\n216\t\n217\t    expect(listRes.status).toBe(200);\n218\t    expect(listRes.body).toHaveLength(1);\n219\t  });\n220\t\n221\t  it('should get and update dashboard with real JWT', async () => {\n222\t    const token = await registerAndLogin(app, 'dashup@test.com', 'pass', TENANT_A);\n223\t\n224\t    const createRes = await request(app)\n225\t      .post('/dashboards')\n226\t      .set('Authorization', `Bearer ${token}`)\n227\t      .send({ name: 'Original' });\n228\t\n229\t    const dashId = createRes.body.id;\n230\t\n231\t    const updateRes = await request(app)\n232\t      .patch(`/dashboards/${dashId}`)\n233\t      .set('Authorization', `Bearer ${token}`)\n234\t      .send({ name: 'Updated' });\n235\t\n236\t    expect(updateRes.status).toBe(200);\n237\t    expect(updateRes.body.name).toBe('Updated');\n238\t\n239\t    const getRes = await request(app)\n240\t      .get(`/dashboards/${dashId}`)\n241\t      .set('Authorization', `Bearer ${token}`);\n242\t\n243\t    expect(getRes.status).toBe(200);\n244\t    expect(getRes.body.name).toBe('Updated');\n245\t  });\n246\t\n247\t  it('should delete dashboard with real JWT', async () => {\n248\t    const token = await registerAndLogin(app, 'dashdel@test.com', 'pass', TENANT_A);\n249\t\n250\t    const createRes = await request(app)\n251\t      .post('/dashboards')\n252\t      .set('Authorization', `Bearer ${token}`)\n253\t      .send({ name: 'To Delete' });\n254\t\n255\t    const dashId = createRes.body.id;\n256\t\n257\t    const delRes = await request(app)\n258\t      .delete(`/dashboards/${dashId}`)\n259\t      .set('Authorization', `Bearer ${token}`);\n260\t\n261\t    expect(delRes.status).toBe(204);\n262\t\n263\t    const getRes = await request(app)\n264\t      .get(`/dashboards/${dashId}`)\n265\t      .set('Authorization', `Bearer ${token}`);\n266\t\n267\t    expect(getRes.status).toBe(404);\n268\t  });\n269\t\n270\t  // --- Widget Management (2 tests) ---\n271\t\n272\t  it('should add widget to dashboard with real JWT', async () => {\n273\t    const token = await registerAndLogin(app, 'widget@test.com', 'pass', TENANT_A);\n274\t\n275\t    const dashRes = await request(app)\n276\t      .post('/dashboards')\n277\t      .set('Authorization', `Bearer ${token}`)\n278\t      .send({ name: 'Widget Dash' });\n279\t\n280\t    const dashId = dashRes.body.id;\n281\t\n282\t    const widgetRes = await request(app)\n283\t      .post(`/dashboards/${dashId}/widgets`)\n284\t      .set('Authorization', `Bearer ${token}`)\n285\t      .send({ type: 'counter', config: { event_name: 'page_view' } });\n286\t\n287\t    expect(widgetRes.status).toBe(201);\n288\t    expect(widgetRes.body.type).toBe('counter');\n289\t    expect(widgetRes.body.dashboard_id).toBe(dashId);\n290\t  });\n291\t\n292\t  it('should delete widget from dashboard with real JWT', async () => {\n293\t    const token = await registerAndLogin(app, 'wdel@test.com', 'pass', TENANT_A);\n294\t\n295\t    const dashRes = await request(app)\n296\t      .post('/dashboards')\n297\t      .set('Authorization', `Bearer ${token}`)\n298\t      .send({ name: 'Widget Dash' });\n299\t\n300\t    const dashId = dashRes.body.id;\n301\t\n302\t    const widgetRes = await request(app)\n303\t      .post(`/dashboards/${dashId}/widgets`)\n304\t      .set('Authorization', `Bearer ${token}`)\n305\t      .send({ type: 'timeseries', config: {} });\n306\t\n307\t    const widgetId = widgetRes.body.id;\n308\t\n309\t    const delRes = await request(app)\n310\t      .delete(`/dashboards/${dashId}/widgets/${widgetId}`)\n311\t      .set('Authorization', `Bearer ${token}`);\n312\t\n313\t    expect(delRes.status).toBe(204);\n314\t  });\n315\t\n316\t  // --- Export with Real Auth (2 tests) ---\n317\t\n318\t  it('should export events as JSON with real JWT', async () => {\n319\t    const token = await registerAndLogin(app, 'exp@test.com', 'pass', TENANT_A);\n320\t\n321\t    await request(app)\n322\t      .post('/events')\n323\t      .set('Authorization', `Bearer ${token}`)\n324\t      .send({ name: 'exported_event' });\n325\t\n326\t    const res = await request(app)\n327\t      .get('/export/events?format=json')\n328\t      .set('Authorization', `Bearer ${token}`);\n329\t\n330\t    expect(res.status).toBe(200);\n331\t    expect(res.body).toBeInstanceOf(Array);\n332\t    expect(res.body.length).toBeGreaterThanOrEqual(1);\n333\t  });\n334\t\n335\t  it('should export dashboard data with real JWT', async () => {\n336\t    const token = await registerAndLogin(app, 'expd@test.com', 'pass', TENANT_A);\n337\t\n338\t    const dashRes = await request(app)\n339\t      .post('/dashboards')\n340\t      .set('Authorization', `Bearer ${token}`)\n341\t      .send({ name: 'Export Dash' });\n342\t\n343\t    const dashId = dashRes.body.id;\n344\t\n345\t    await request(app)\n346\t      .post(`/dashboards/${dashId}/widgets`)\n347\t      .set('Authorization', `Bearer ${token}`)\n348\t      .send({ type: 'breakdown', config: { prop: 'page' } });\n349\t\n350\t    const res = await request(app)\n351\t      .get(`/export/dashboard/${dashId}`)\n352\t      .set('Authorization', `Bearer ${token}`);\n353\t\n354\t    expect(res.status).toBe(200);\n355\t    expect(res.body.dashboard.name).toBe('Export Dash');\n356\t    expect(res.body.widgets).toHaveLength(1);\n357\t  });\n358\t\n359\t  // --- Cross-feature: Full Workflow (2 tests) ---\n360\t\n361\t  it('should complete full workflow: register, ingest, query, dashboard, export', async () => {\n362\t    // Register and login\n363\t    const token = await registerAndLogin(app, 'full@test.com', 'pass', TENANT_A);\n364\t\n365\t    // Get profile\n366\t    const meRes = await request(app)\n367\t      .get('/users/me')\n368\t      .set('Authorization', `Bearer ${token}`);\n369\t    expect(meRes.status).toBe(200);\n370\t\n371\t    // Ingest events\n372\t    await request(app)\n373\t      .post('/events/batch')\n374\t      .set('Authorization', `Bearer ${token}`)\n375\t      .send({\n376\t        events: [\n377\t          { name: 'page_view', properties: { page: '/home' }, timestamp: '2024-01-15T10:00:00Z' },\n378\t          { name: 'page_view', properties: { page: '/about' }, timestamp: '2024-01-15T11:00:00Z' },\n379\t          { name: 'click', properties: { button: 'buy' }, timestamp: '2024-01-15T10:30:00Z' },\n380\t        ],\n381\t      });\n382\t\n383\t    // Query count\n384\t    const countRes = await request(app)\n385\t      .post('/query/count')\n386\t      .set('Authorization', `Bearer ${token}`)\n387\t      .send({ event_name: 'page_view' });\n388\t    expect(countRes.body.count).toBe(2);\n389\t\n390\t    // Create dashboard\n391\t    const dashRes = await request(app)\n392\t      .post('/dashboards')\n393\t      .set('Authorization', `Bearer ${token}`)\n394\t      .send({ name: 'Full Workflow Dash' });\n395\t    const dashId = dashRes.body.id;\n396\t\n397\t    // Add widget\n398\t    await request(app)\n399\t      .post(`/dashboards/${dashId}/widgets`)\n400\t      .set('Authorization', `Bearer ${token}`)\n401\t      .send({ type: 'counter', config: { event_name: 'page_view' } });\n402\t\n403\t    // Export events\n404\t    const exportRes = await request(app)\n405\t      .get('/export/events?format=json')\n406\t      .set('Authorization', `Bearer ${token}`);\n407\t    expect(exportRes.body).toHaveLength(3);\n408\t\n409\t    // Export dashboard\n410\t    const dashExportRes = await request(app)\n411\t      .get(`/export/dashboard/${dashId}`)\n412\t      .set('Authorization', `Bearer ${token}`);\n413\t    expect(dashExportRes.body.widgets).toHaveLength(1);\n414\t  });\n415\t\n416\t  it('should handle breakdown and funnel queries in full workflow', async () => {\n417\t    const token = await registerAndLogin(app, 'funnel@test.com', 'pass', TENANT_A);\n418\t\n419\t    // Ingest funnel events with session\n420\t