);\n  res.status(201).json(serializeEvent(row));\n});\n\nrouter.post('/batch', (req: Request, res: Response) => {\n  const user = getUser(req);\n  const { events } = (req.body ?? {}) as { events?: EventInput[] };\n\n  if (!Array.isArray(events) || events.length === 0) {\n    throw new ValidationError('events must be a non-empty array');\n  }\n\n  const db = getDb();\n  const rows = events.map((event) => insertEvent(db, user.tenantId, user.id, event));\n  res.status(201).json({ inserted: rows.length, events: rows.map(serializeEvent) });\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1692,"cache_read_input_tokens":76728,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1692},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"b2aa8a77-f38c-4401-8d84-4990c7f25e10","uuid":"f3295ab4-533e-45d3-bef2-09d958af74f1","request_id":"req_011CcaUtKzuRSoJFZcSKEh7m"}
