+import { Router, Request, Response } from 'express';
+import Database from 'better-sqlite3';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+import { getUser } from '../auth';
+
+const router = Router();
+
+interface EventInput {
+  name?: unknown;
+  properties?: Record<string, unknown>;
+  timestamp?: string;
+  session_id?: string;
+}
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function insertEvent(
+  db: Database.Database,
+  tenantId: string,
+  userId: string,
+  input: EventInput
+): EventRow {
+  if (!input.name || typeof input.name !== 'string') {
+    throw new ValidationError('Event name is required');
+  }
+
+  const id = uuidv4();
+  const properties = JSON.stringify(input.properties ?? {});
+  const timestamp = input.timestamp ?? new Date().toISOString();
+  const sessionId = input.session_id ?? null;
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+  ).run(id, tenantId, input.name, properties, timestamp, userId, sessionId);
+
+  return {
+    id,
+    tenant_id: tenantId,
+    name: input.name,
+    properties,
+    timestamp,
+    user_id: userId,
+    session_id: sessionId,
+  };
+}
+
+function serializeEvent(row: EventRow) {
+  return { ...row, properties: JSON.parse(row.properties) };
+}
+
+router.post('/', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const db = getDb();
+  const row = insertEvent(db, user.tenantId, user.id, (req.body ?? {}) as EventInput);
+  res.status(201).json(serializeEvent(row));
+});
+
+router.post('/batch', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const { events } = (req.body ?? {}) as { events?: EventInput[] };
+
+  if (!Array.isArray(events) || events.length === 0) {
+    throw new ValidationError('events must be a non-empty array');
+  }
+
+  const db = getDb();
+  const rows = events.map((event) => insertEvent(db, user.tenantId, user.id, event));
+  res.status(201).json({ inserted: rows.length, events: rows.map(serializeEvent) });
+});
+
+export default router;
