+import { Router, Request, Response } from 'express';
+import { getDb } from '../db';
+import { ValidationError } from '../errors';
+import { getUser } from '../auth';
+
+const router = Router();
+
+function bucketExpression(bucket: string): string {
+  switch (bucket) {
+    case 'hour':
+      return "strftime('%Y-%m-%dT%H:00:00Z', timestamp)";
+    case 'week':
+      return "strftime('%Y-W%W', timestamp)";
+    case 'month':
+      return "strftime('%Y-%m', timestamp)";
+    case 'day':
+    default:
+      return "strftime('%Y-%m-%d', timestamp)";
+  }
+}
+
+interface TimeRange {
+  start?: string;
+  end?: string;
+}
+
+function applyTimeRange(sql: string, params: unknown[], filter: TimeRange): string {
+  let out = sql;
+  if (filter.start) {
+    out += ' AND timestamp >= ?';
+    params.push(filter.start);
+  }
+  if (filter.end) {
+    out += ' AND timestamp <= ?';
+    params.push(filter.end);
+  }
+  return out;
+}
+
+router.post('/count', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const { event_name: eventName, start, end } = (req.body ?? {}) as TimeRange & { event_name?: unknown };
+  if (!eventName || typeof eventName !== 'string') {
+    throw new ValidationError('event_name is required');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId, eventName];
+  let sql = 'SELECT COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?';
+  sql = applyTimeRange(sql, params, { start, end });
+
+  const row = db.prepare(sql).get(...params) as { count: number };
+  res.status(200).json({ count: row.count });
+});
+
+router.post('/timeseries', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const {
+    event_name: eventName,
+    bucket = 'day',
+    start,
+    end,
+  } = (req.body ?? {}) as TimeRange & { event_name?: unknown; bucket?: string };
+  if (!eventName || typeof eventName !== 'string') {
+    throw new ValidationError('event_name is required');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId, eventName];
+  const bucketExpr = bucketExpression(bucket);
+  let sql = `SELECT ${bucketExpr} as bucket, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?`;
+  sql = applyTimeRange(sql, params, { start, end });
+  sql += ' GROUP BY bucket ORDER BY bucket';
+
+  const rows = db.prepare(sql).all(...params);
+  res.status(200).json({ data: rows });
+});
+
+router.post('/breakdown', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const {
+    event_name: eventName,
+    property_key: propertyKey,
+    start,
+    end,
+  } = (req.body ?? {}) as TimeRange & { event_name?: unknown; property_key?: unknown };
+  if (!eventName || typeof eventName !== 'string') {
+    throw new ValidationError('event_name is required');
+  }
+  if (!propertyKey || typeof propertyKey !== 'string') {
+    throw new ValidationError('property_key is required');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [propertyKey, user.tenantId, eventName];
+  let sql =
+    "SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count FROM events WHERE tenant_id = ? AND name = ?";
+  sql = applyTimeRange(sql, params, { start, end });
+  sql += ' GROUP BY property_value ORDER BY count DESC';
+
+  const rows = db.prepare(sql).all(...params);
+  res.status(200).json({ data: rows });
+});
+
+interface FunnelEventRow {
+  session_id: string | null;
+  name: string;
+  timestamp: string;
+}
+
+router.post('/funnel', (req: Request, res: Response) => {
+  const user = getUser(req);
+  const { steps, start, end } = (req.body ?? {}) as {
+    steps?: unknown;
+    start?: string;
+    end?: string;
+  };
+
+  if (!Array.isArray(steps) || steps.length === 0 || !steps.every((s) => typeof s === 'string')) {
+    throw new ValidationError('steps must be a non-empty array of event names');
+  }
+
+  const db = getDb();
+  const params: unknown[] = [user.tenantId, ...steps];
+  let sql = `SELECT session_id, name, timestamp FROM events WHERE tenant_id = ? AND name IN (${steps
+    .map(() => '?')
+    .join(',')})`;
+  sql = applyTimeRange(sql, params, { start, end });
+  sql += ' ORDER BY session_id, timestamp';
+
+  const rows = db.prepare(sql).all(...params) as FunnelEventRow[];
+
+  const bySession = new Map<string, { name: string; timestamp: string }[]>();
+  let anonCounter = 0;
+  for (const row of rows) {
+    const key = row.session_id ?? `__anon_${anonCounter++}`;
+    const list = bySession.get(key) ?? [];
+    list.push({ name: row.name, timestamp: row.timestamp });
+    bySession.set(key, list);
+  }
+
+  const counts = new Array(steps.length).fill(0);
+  for (const events of bySession.values()) {
+    let searchFrom = 0;
+    for (let stepIndex = 0; stepIndex < steps.length; stepIndex++) {
+      const target = steps[stepIndex];
+      let found = -1;
+      for (let i = searchFrom; i < events.length; i++) {
+        if (events[i].name === target) {
+          found = i;
+          break;
+        }
+      }
+      if (found === -1) break;
+      counts[stepIndex]++;
+      searchFrom = found + 1;
+    }
+  }
+
+  res.status(200).json({
+    steps: steps.map((name, i) => ({ name, count: counts[i] })),
+  });
+});
+
+export default router;
