+import { Router, type Request, type Response, type NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+
+const router = Router();
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+const WIDGET_TYPES = ['counter', 'timeseries', 'breakdown', 'funnel'];
+
+function toPublicDashboard(row: DashboardRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    owner_id: row.owner_id,
+    config: JSON.parse(row.config),
+    created_at: row.created_at,
+    updated_at: row.updated_at,
+  };
+}
+
+function toPublicWidget(row: WidgetRow) {
+  return {
+    id: row.id,
+    dashboard_id: row.dashboard_id,
+    type: row.type,
+    config: JSON.parse(row.config),
+    position_x: row.position_x,
+    position_y: row.position_y,
+    width: row.width,
+    height: row.height,
+  };
+}
+
+function requireUser(req: Request) {
+  const user = req.user;
+  if (!user) {
+    throw new ApiError(401, 'AUTH_ERROR', 'Authentication required');
+  }
+  return user;
+}
+
+function findDashboard(tenantId: string, id: string): DashboardRow {
+  const db = getDb();
