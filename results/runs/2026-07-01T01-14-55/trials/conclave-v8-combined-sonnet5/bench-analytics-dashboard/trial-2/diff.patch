+import { Router, type Request, type Response, type NextFunction } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+function toPublicEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+interface IncomingEvent {
+  name?: unknown;
+  properties?: unknown;
+  timestamp?: unknown;
+  session_id?: unknown;
+}
+
+function validateEvent(event: IncomingEvent): { name: string; properties: string; timestamp: string | null; sessionId: string | null } {
+  if (typeof event.name !== 'string' || !event.name) {
+    throw new ApiError(400, 'VALIDATION_ERROR', 'name is required');
+  }
+  const properties =
+    event.properties !== undefined && event.properties !== null
+      ? JSON.stringify(event.properties)
+      : '{}';
+  const timestamp = typeof event.timestamp === 'string' ? event.timestamp : null;
+  const sessionId = typeof event.session_id === 'string' ? event.session_id : null;
+
+  return { name: event.name, properties, timestamp, sessionId };
+}
+
+function insertEvent(
+  tenantId: string,
+  userId: string,
+  event: IncomingEvent
+): EventRow {
+  const { name, properties, timestamp, sessionId } = validateEvent(event);
+  const db = getDb();
+  const id = uuidv4();
+
+  if (timestamp) {
+    db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?, ?)'
+    ).run(id, tenantId, name, properties, timestamp, userId, sessionId);
+  } else {
+    db.prepare(
+      'INSERT INTO events (id, tenant_id, name, properties, user_id, session_id) VALUES (?, ?, ?, ?, ?, ?)'
+    ).run(id, tenantId, name, properties, userId, sessionId);
+  }
+
+  return db.prepare('SELECT * FROM events WHERE id = ?').get(id) as EventRow;
+}
+
+router.post('/', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new ApiError(401, 'AUTH_ERROR', 'Authentication required');
+    }
+
+    const row = insertEvent(user.tenantId, user.id, req.body ?? {});
+    res.status(201).json(toPublicEvent(row));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.post('/batch', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const user = req.user;
+    if (!user) {
+      throw new ApiError(401, 'AUTH_ERROR', 'Authentication required');
+    }
+
+    const { events } = req.body ?? {};
+    if (!Array.isArray(events) || events.length === 0) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'events must be a non-empty array');
+    }
+
+    const rows = events.map((event: IncomingEvent) => insertEvent(user.tenantId, user.id, event));
+
+    res.status(201).json({
+      inserted: rows.length,
+      events: rows.map(toPublicEvent),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
