dy.name).toBe('New Name');\n  });\n\n  it('should delete a dashboard', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const createRes = await request(app)\n      .post('/dashboards')\n      .send({ name: 'To Delete' });\n    const dashId = createRes.body.id;\n\n    const res = await request(app).delete(`/dashboards/${dashId}`);\n    expect(res.status).toBe(204);\n\n    const getRes = await request(app).get(`/dashboards/${dashId}`);\n    expect(getRes.status).toBe(404);\n  });\n\n  it('should add a widget to a dashboard', async () => {\n    const app = createTestApp('user1', 'tenant1');\n    const createRes = await request(app)\n      .post('/dashboards')\n      .send({ name: 'Widget Dash' });\n    const dashId = createRes.body.id;\n\n    const res = await request(app)\n      .post(`/dashboards/${dashId}/widgets`)\n      .send({\n        type: 'counter',\n        config: { event_name: 'page_view' },\n        position_x: 0,\n        position_y: 0,\n        width: 2,\n        height: 1,\n      });\n\n    expect(res.status).toBe(201);\n    expect(res.body.type).toBe('counter');\n    expect(res.body.dashboard_id).toBe(dashId);\n  });\n});\n","numLines":131,"startLine":1,"totalLines":131}}}
