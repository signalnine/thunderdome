+router.patch('/:id/role', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const requester = requireAuthContext(req);
+    const db = getDb();
+
+    const requesterRow = db.prepare('SELECT * FROM users WHERE id = ?').get(requester.id) as
+      | UserRow
+      | undefined;
+
+    if (!requesterRow || requesterRow.role !== 'admin') {
+      throw new ApiError(403, 'FORBIDDEN', 'Admin role required');
+    }
+
+    const { role } = req.body ?? {};
+    const validRoles = ['admin', 'viewer', 'editor'];
+    if (typeof role !== 'string' || !validRoles.includes(role)) {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'A valid role is required');
+    }
+
+    const target = db.prepare('SELECT * FROM users WHERE id = ? AND tenant_id = ?').get(
+      req.params.id,
+      requesterRow.tenant_id
+    ) as UserRow | undefined;
+
+    if (!target) {
+      throw new ApiError(404, 'NOT_FOUND', 'User not found');
+    }
+
+    db.prepare('UPDATE users SET role = ? WHERE id = ?').run(role, target.id);
+    const updated = db.prepare('SELECT * FROM users WHERE id = ?').get(target.id) as UserRow;
+
+    res.status(200).json(toPublicUser(updated));
+  } catch (err) {
+    next(err);
+  }
+});
