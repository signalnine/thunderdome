ser(req);\n    const body = req.body ?? {};\n    const eventName = requireEventName(body);\n    const bucket = typeof body.bucket === 'string' ? body.bucket : 'day';\n    const format = BUCKET_FORMATS[bucket];\n    if (!format) {\n      throw new ApiError(400, 'VALIDATION_ERROR', `Unsupported bucket: ${bucket}`);\n    }\n\n    const db = getDb();\n    const rows = db\n      .prepare(\n        `SELECT strftime('${format}', timestamp) as bucket, COUNT(*) as count\n         FROM events WHERE tenant_id = ? AND name = ?\n         GROUP BY bucket ORDER BY bucket ASC`\n      )\n      .all(user.tenantId, eventName) as { bucket: string; count: number }[];\n\n    res.status(200).json({ data: rows });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/breakdown', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const user = requireUser(req);\n    const body = req.body ?? {};\n    const eventName = requireEventName(body);\n    const propertyKey = body.property_key;\n    if (typeof propertyKey !== 'string' || !propertyKey) {\n      throw new ApiError(400, 'VALIDATION_ERROR', 'property_key is required');\n    }\n\n    const db = getDb();\n    const rows = db\n      .prepare(\n        `SELECT json_extract(properties, '$.' || ?) as property_value, COUNT(*) as count\n         FROM events WHERE tenant_id = ? AND name = ?\n         GROUP BY property_value ORDER BY count DESC`\n      )\n      .all(propertyKey, user.tenantId, eventName) as { property_value: unknown; count: number }[];\n\n    res.status(200).json({ data: rows });\n  } catch (err) {\n    next(err);\n  }\n});\n\nrouter.post('/funnel', (req: Request, res: Response, next: NextFunction) => {\n  try {\n    const user = requireUser(req);\n    const body = req.body ?? {};\n    const steps = body.steps;\n\n    if (!Array.isArray(steps) || steps.length === 0 || !steps.every((s) => typeof s === 'string')) {\n      throw new ApiError(400, 'VALIDATION_ERROR', 'steps must be a non-empty array of strings');\n    }\n\n    const db = getDb();\n    const placeholders = steps.map(() => '?').join(', ');\n    const rows = db\n      .prepare(\n        `SELECT session_id, name FROM events\n         WHERE tenant_id = ? AND session_id IS NOT NULL AND name IN (${placeholders})`\n      )\n      .all(user.tenantId, ...steps) as { session_id: string; name: string }[];\n\n    const sessionEvents = new Map<string, Set<string>>();\n    for (const row of rows) {\n      if (!sessionEvents.has(row.session_id)) {\n        sessionEvents.set(row.session_id, new Set());\n      }\n      sessionEvents.get(row.session_id)!.add(row.name);\n    }\n\n    const result = steps.map((step: string, index: number) => {\n      const requiredSteps = steps.slice(0, index + 1);\n      let count = 0;\n      for (const names of sessionEvents.values()) {\n        if (requiredSteps.every((s: string) => names.has(s))) {\n          count += 1;\n        }\n      }\n      return { step, count };\n    });\n\n    res.status(200).json({ steps: result });\n  } catch (err) {\n    next(err);\n  }\n});\n\nexport default router;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2634,"cache_read_input_tokens":63476,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2634},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"bd05dea0-301d-4358-923b-0482eb7e0725","uuid":"74121085-826a-4d3c-86cf-1366f712c77b","request_id":"req_011CcaUehkxJNT2NcJB2uWFM"}
