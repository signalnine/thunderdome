+import { Router, type Request, type Response, type NextFunction } from 'express';
+import { getDb } from '../db';
+import { ApiError } from '../errors';
+
+const router = Router();
+
+interface EventRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  properties: string;
+  timestamp: string;
+  user_id: string | null;
+  session_id: string | null;
+}
+
+interface DashboardRow {
+  id: string;
+  tenant_id: string;
+  name: string;
+  owner_id: string;
+  config: string;
+  created_at: string;
+  updated_at: string;
+}
+
+interface WidgetRow {
+  id: string;
+  dashboard_id: string;
+  type: string;
+  config: string;
+  position_x: number;
+  position_y: number;
+  width: number;
+  height: number;
+}
+
+function requireUser(req: Request) {
+  const user = req.user;
+  if (!user) {
+    throw new ApiError(401, 'AUTH_ERROR', 'Authentication required');
+  }
+  return user;
+}
+
+function toPublicEvent(row: EventRow) {
+  return {
+    id: row.id,
+    tenant_id: row.tenant_id,
+    name: row.name,
+    properties: JSON.parse(row.properties),
+    timestamp: row.timestamp,
+    user_id: row.user_id,
+    session_id: row.session_id,
+  };
+}
+
+function toCsv(rows: EventRow[]): string {
+  const headers = ['id', 'tenant_id', 'name', 'properties', 'timestamp', 'user_id', 'session_id'];
+  const escape = (value: unknown): string => {
+    const str = value === null || value === undefined ? '' : String(value);
+    if (/[",\n]/.test(str)) {
+      return `"${str.replace(/"/g, '""')}"`;
+    }
+    return str;
+  };
+
+  const lines = [headers.join(',')];
+  for (const row of rows) {
+    lines.push(headers.map((h) => escape((row as unknown as Record<string, unknown>)[h])).join(','));
+  }
+  return lines.join('\n');
+}
+
+router.get('/events', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const user = requireUser(req);
+    const format = req.query.format;
+
+    if (format !== 'json' && format !== 'csv') {
+      throw new ApiError(400, 'VALIDATION_ERROR', 'format must be json or csv');
+    }
+
+    const db = getDb();
+    const rows = db
+      .prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp ASC')
+      .all(user.tenantId) as EventRow[];
+
+    if (format === 'csv') {
+      res.status(200).set('Content-Type', 'text/csv').send(toCsv(rows));
+      return;
+    }
+
+    res.status(200).json(rows.map(toPublicEvent));
+  } catch (err) {
+    next(err);
+  }
+});
+
+router.get('/dashboard/:id', (req: Request, res: Response, next: NextFunction) => {
+  try {
+    const user = requireUser(req);
+    const db = getDb();
+
+    const dashboard = db
+      .prepare('SELECT * FROM dashboards WHERE id = ? AND tenant_id = ?')
+      .get(req.params.id, user.tenantId) as DashboardRow | undefined;
+
+    if (!dashboard) {
+      throw new ApiError(404, 'NOT_FOUND', 'Dashboard not found');
+    }
+
+    const widgets = db
+      .prepare('SELECT * FROM widgets WHERE dashboard_id = ?')
+      .all(dashboard.id) as WidgetRow[];
+
+    res.status(200).json({
+      dashboard: {
+        id: dashboard.id,
+        tenant_id: dashboard.tenant_id,
+        name: dashboard.name,
+        owner_id: dashboard.owner_id,
+        config: JSON.parse(dashboard.config),
+        created_at: dashboard.created_at,
+        updated_at: dashboard.updated_at,
+      },
+      widgets: widgets.map((w) => ({
+        id: w.id,
+        dashboard_id: w.dashboard_id,
+        type: w.type,
+        config: JSON.parse(w.config),
+        position_x: w.position_x,
+        position_y: w.position_y,
+        width: w.width,
+        height: w.height,
+      })),
+    });
+  } catch (err) {
+    next(err);
+  }
+});
+
+export default router;
