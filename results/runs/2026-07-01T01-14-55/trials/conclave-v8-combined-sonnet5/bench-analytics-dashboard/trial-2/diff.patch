dy).toHaveLength(0);\n\n    // Tenant A's dashboard should not be exportable by Tenant B\n    const dashRes = await request(app)\n      .post('/dashboards')\n      .set('Authorization', `Bearer ${tokenA}`)\n      .send({ name: 'Private Dash' });\n\n    const dashExportRes = await request(app)\n      .get(`/export/dashboard/${dashRes.body.id}`)\n      .set('Authorization', `Bearer ${tokenB}`);\n\n    expect(dashExportRes.status).toBe(404);\n  });\n});\n\n// Helper function to register a user and return their JWT token\nasync function registerAndLogin(\n  app: ReturnType<typeof createApp>,\n  email: string,\n  password: string,\n  tenantId: string\n): Promise<string> {\n  await request(app)\n    .post('/users')\n    .send({ email, password, tenant_id: tenantId });\n\n  const loginRes = await request(app)\n    .post('/users/login')\n    .send({ email, password });\n\n  return loginRes.body.token;\n}\n","numLines":537,"startLine":1,"totalLines":537}}}
