+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SyCvBRyLWXV4Sjpzf2ZFCa","type":"tool_result","content":"1\timport { describe, it, expect, beforeEach, afterEach } from 'vitest';\n2\timport request from 'supertest';\n3\timport jwt from 'jsonwebtoken';\n4\timport Database from 'better-sqlite3';\n5\timport { createApp } from '../src/app';\n6\timport { setDb, createTestDb, closeDb } from '../src/db';\n7\t\n8\tconst TENANT_A = 'tenant-a';\n9\tconst TENANT_B = 'tenant-b';\n10\t\n11\tdescribe('Integration Tests', () => {\n12\t  let app: ReturnType<typeof createApp>;\n13\t  let db: Database.Database;\n14\t\n15\t  beforeEach(() => {\n16\t    db = createTestDb();\n17\t    setDb(db);\n18\t    app = createApp();\n19\t  });\n20\t\n21\t  afterEach(() => {\n22\t    closeDb();\n23\t  });\n24\t\n25\t  // --- Register + Login Flow (2 tests) ---\n26\t\n27\t  it('should register a user and login successfully', async () => {\n28\t    const regRes = await request(app)\n29\t      .post('/users')\n30\t      .send({ email: 'alice@test.com', password: 'secret123', tenant_id: TENANT_A });\n31\t\n32\t    expect(regRes.status).toBe(201);\n33\t    expect(regRes.body.email).toBe('alice@test.com');\n34\t\n35\t    const loginRes = await request(app)\n36\t      .post('/users/login')\n37\t      .send({ email: 'alice@test.com', password: 'secret123' });\n38\t\n39\t    expect(loginRes.status).toBe(200);\n40\t    expect(loginRes.body).toHaveProperty('token');\n41\t    expect(loginRes.body.user.email).toBe('alice@test.com');\n42\t  });\n43\t\n44\t  it('should return JWT with correct shape {sub, tid, iat, exp}', async () => {\n45\t    await request(app)\n46\t      .post('/users')\n47\t      .send({ email: 'jwt@test.com', password: 'secret123', tenant_id: TENANT_A });\n48\t\n49\t    const loginRes = await request(app)\n50\t      .post('/users/login')\n51\t      .send({ email: 'jwt@test.com', password: 'secret123' });\n52\t\n53\t    const token = loginRes.body.token;\n54\t    cons