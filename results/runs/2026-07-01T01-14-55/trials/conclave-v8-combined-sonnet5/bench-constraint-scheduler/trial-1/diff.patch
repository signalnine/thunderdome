+describe('batch optimization', () => {
+  it('maximizes total scheduled events rather than following naive input order', () => {
+    // Rooms: 'large' can hold the big event; 'small' cannot.
+    // Window has exactly two back-to-back slots (gap 0) available across both rooms combined,
+    // enough capacity exists to schedule ALL 3 events if room assignment is chosen well,
+    // but a naive "best-fit smallest room first, input order" greedy strands the big event.
+    const events: Event[] = [
+      { id: 'small1', name: 'S1', duration: 60, attendees: 2 },
+      { id: 'small2', name: 'S2', duration: 60, attendees: 2 },
+      { id: 'big', name: 'Big', duration: 60, attendees: 8 },
