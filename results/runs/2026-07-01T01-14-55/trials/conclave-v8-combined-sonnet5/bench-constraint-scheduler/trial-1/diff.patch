  if (candidate + duration <= windowEnd) return candidate;\n  return null;\n}\n\ntype Comparator = (a: Event, b: Event, validRoomCount: Map<string, number>) => number;\n\nconst attendeesOf = (e: Event): number => e.attendees ?? 1;\n\nconst STRATEGIES: Comparator[] = [\n  // Most constrained first: fewest viable rooms, then longest, then largest.\n  (a, b, counts) =>\n    (counts.get(a.id)! - counts.get(b.id)!) ||\n    (b.duration - a.duration) ||\n    (attendeesOf(b) - attendeesOf(a)) ||\n    a.id.localeCompare(b.id),\n  // Largest attendees first.\n  (a, b) =>\n    (attendeesOf(b) - attendeesOf(a)) || (b.duration - a.duration) || a.id.localeCompare(b.id),\n  // Longest duration first.\n  (a, b) =>\n    (b.duration - a.duration) || (attendeesOf(b) - attendeesOf(a)) || a.id.localeCompare(b.id),\n  // Original input order (stable no-op comparator).\n  () => 0,\n  // Shortest duration first.\n  (a, b) =>\n    (a.duration - b.duration) || (attendeesOf(a) - attendeesOf(b)) || a.id.localeCompare(b.id),\n  // Fewest viable rooms first, then shortest duration.\n  (a, b, counts) =>\n    (counts.get(a.id)! - counts.get(b.id)!) ||\n    (a.duration - b.duration) ||\n    a.id.localeCompare(b.id),\n];\n\nfunction runStrategy(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n  comparator: Comparator,\n): ScheduleResult {\n  const gap = options.gap ?? 15;\n  const byId = new Map(events.map((e) => [e.id, e]));\n\n  const validRoomCount = new Map<string, number>();\n  for (const event of events) {\n    const count = rooms.filter((r) => r.capacity >= attendeesOf(event)).length;\n    validRoomCount.set(event.id, count);\n  }\n\n  const danglingPrereq = new Map<string, boolean>();\n  const inDegree = new Map<string, number>();\n  const dependents = new Map<string, string[]>();\n  for (const event of events) {\n    const prereqs = event.prerequisites ?? [];\n    const validPrereqs = prereqs.filter((p) => byId.has(p));\n    danglingPrereq.set(event.id, validPrereqs.length !== prereqs.length);\n    inDegree.set(event.id, validPrereqs.length);\n    for (const p of validPrereqs) {\n      const list = dependents.get(p) ?? [];\n      list.push(event.id);\n      dependents.set(p, list);\n    }\n  }\n\n  const status = new Map<string, 'scheduled' | 'unscheduled'>();\n  const endTimeOf = new Map<string, number>();\n  const roomBookings = new Map<string, Booking[]>();\n  for (const room of rooms) roomBookings.set(room.id, []);\n  const assignments: Assignment[] = [];\n\n  let ready = events.filter((e) => inDegree.get(e.id) === 0);\n\n  const resolve = (event: Event): void => {\n    const prereqs = event.prerequisites ?? [];\n    const hasFailedPrereq = prereqs.some((p) => status.get(p) === 'unscheduled');\n    if (danglingPrereq.get(event.id) || hasFailedPrereq) {\n      status.set(event.id, 'unscheduled');\n      return;\n    }\n\n    const earliestStart = prereqs.reduce(\n      (acc, p) => Math.max(acc, (endTimeOf.get(p) ?? options.startTime) + gap),\n      options.startTime,\n    );\n\n    const attendees = attendeesOf(event);\n    const candidateRooms = rooms.filter((r) => r.capacity >= attendees);\n    let orderedRooms = [...candidateRooms].sort((a, b) => a.capacity - b.capacity);\n    if (event.preferredRoom) {\n      const preferred = candidateRooms.find((r) => r.id === event.preferredRoom);\n      if (preferred) {\n        orderedRooms = [preferred, ...orderedRooms.filter((r) => r.id !== preferred.id)];\n      }\n    }\n\n    for (const room of orderedRooms) {\n      const bookings = roomBookings.get(room.id)!;\n      const slot = findEarliestSlot(bookings, earliestStart, event.duration, gap, options.endTime);\n      if (slot !== null) {\n        bookings.push({ start: slot, end: slot + event.duration });\n        endTimeOf.set(event.id, slot + event.duration);\n        status.set(event.id, 'scheduled');\n        assignments.push({\n          eventId: event.id,\n          roomId: room.id,\n          startTime: slot,\n          endTime: slot + event.duration,\n        });\n        return;\n      }\n    }\n    status.set(event.id, 'unscheduled');\n  };\n\n  while (ready.length > 0) {\n    ready.sort((a, b) => comparator(a, b, validRoomCount));\n    const next = ready.shift()!;\n    resolve(next);\n    for (const depId of dependents.get(next.id) ?? []) {\n      const remaining = inDegree.get(depId)! - 1;\n      inDegree.set(depId, remaining);\n      if (remaining === 0) ready.push(byId.get(depId)!);\n    }\n  }\n\n  const unscheduled = events.filter((e) => status.get(e.id) === 'unscheduled').map((e) => e.id);\n  assignments.sort((a, b) => a.startTime - b.startTime || a.eventId.localeCompare(b.eventId));\n  return { assignments, unscheduled };\n}\n\nexport function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {\n  if (events.length === 0) return { assignments: [], unscheduled: [] };\n\n  detectCycle(events);\n\n  const preferredCount = (result: ScheduleResult): number => {\n    const byId = new Map(events.map((e) => [e.id, e]));\n    return result.assignments.filter((a) => byId.get(a.eventId)?.preferredRoom === a.roomId).length;\n  };\n\n  let best: ScheduleResult | null = null;\n  for (const comparator of STRATEGIES) {\n    const result = runStrategy(events, rooms, options, comparator);\n    if (\n      best === null ||\n      result.assignments.length > best.assignments.length ||\n      (result.assignments.length === best.assignments.length &&\n        preferredCount(result) > preferredCount(best))\n    ) {\n      best = result;\n    }\n  }\n\n  return best!;\n}\n","structuredPatch":[{"oldStart":115,"oldLines":7,"newStart":115,"newLines":7,"lines":["   for (const room of rooms) roomBookings.set(room.id, []);","   const assignments: Assignment[] = [];"," ","-  let ready = events.filter((e) => inDegree.get(e.id) === 0);","+  const ready = events.filter((e) => inDegree.get(e.id) === 0);"," ","   const resolve = (event: Event): void => {","     const prereqs = 