erequisites: ['A', 'B'] },\n    ];\n    const rooms: Room[] = [room('r1', 5), room('r2', 5), room('r3', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 800, gap: 10 });\n    const a = result.assignments.find((x) => x.eventId === 'A')!;\n    const b = result.assignments.find((x) => x.eventId === 'B')!;\n    const c = result.assignments.find((x) => x.eventId === 'C')!;\n    expect(a && b && c).toBeTruthy();\n    expect(c.startTime).toBeGreaterThanOrEqual(Math.max(a.endTime, b.endTime) + 10);\n  });\n\n  it('treats a prerequisite referencing an unknown event id as impossible without crashing', () => {\n    const events: Event[] = [{ id: 'B', name: 'B', duration: 30, prerequisites: ['ghost'] }];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).not.toThrow();\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700 });\n    expect(result.unscheduled).toEqual(['B']);\n  });\n});\n\ndescribe('cycle detection', () => {\n  it('throws on a self-referencing prerequisite', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 30, prerequisites: ['A'] }];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).toThrow();\n  });\n\n  it('throws on a two-node cycle', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30, prerequisites: ['B'] },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).toThrow();\n  });\n\n  it('throws on a longer cycle', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30, prerequisites: ['C'] },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n      { id: 'C', name: 'C', duration: 30, prerequisites: ['B'] },\n    ];\n    const rooms: Room[] =