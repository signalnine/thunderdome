pacity exists to schedule ALL 3 events if room assignment is chosen well,\n    // but a naive \"best-fit smallest room first, input order\" greedy strands the big event.\n    const events: Event[] = [\n      { id: 'small1', name: 'S1', duration: 60, attendees: 2 },\n      { id: 'small2', name: 'S2', duration: 60, attendees: 2 },\n      { id: 'big', name: 'Big', duration: 60, attendees: 8 },\n    ];\n    const rooms: Room[] = [room('large', 10), room('small', 3)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 660, gap: 0 });\n    // large room: 2 slots (540-600, 600-660); small room: 2 slots (540-600, 600-660)\n    // optimal: big -> large slot1, small1 -> large slot2 or small room, small2 -> remaining slot => all 3 scheduled\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments).toHaveLength(3);\n  });\n\n  it('partitions all event ids disjointly between assignments and unscheduled', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30, attendees: 3 },\n      { id: 'e2', name: 'B', duration: 30, attendees: 100 },\n      { id: 'e3', name: 'C', duration: 30, attendees: 2, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700, gap: 5 });\n    const scheduledIds = result.assignments.map((a) => a.eventId).sort();\n    const allFromBoth = [...scheduledIds, ...result.unscheduled].sort();\n    expect(allFromBoth).toEqual(['e1', 'e2', 'e3']);\n    expect(new Set(allFromBoth).size).toBe(3);\n  });\n});\n\ndescribe('output shape / misc', () => {\n  it('sets endTime = startTime + duration for every assignment', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 37 },\n      { id: 'e2', name: 'B', duration: 22 },\n    ];\n    const rooms: Room[] = [room('r1', 5), room('r2', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 660, gap: 5 });\n    for (const 