result.assignments.find((a) => a.eventId === 'blocker')!;\n    expect(filler.roomId).toBe('r1');\n    expect(blocker.roomId).toBe('r1');\n    expect(filler.startTime).toBe(540);\n    expect(filler.endTime).toBe(570);\n    expect(blocker.startTime).toBe(600);\n  });\n});","originalFile":"import { describe, it, expect } from 'vitest';\nimport { schedule } from './index.js';\nimport type { Event, Room } from './types.js';\n\nconst room = (id: string, capacity: number): Room => ({ id, name: id, capacity });\n\ndescribe('core scheduling', () => {\n  it('schedules a single event in a single room within the window', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Standup', duration: 30 }];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0]).toEqual({\n      eventId: 'e1',\n      roomId: 'r1',\n      startTime: 540,\n      endTime: 570,\n    });\n  });\n\n  it('schedules multiple independent events without overlapping in the same room', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 30 },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700, gap: 15 });\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments).toHaveLength(2);\n    const [a, b] = [...result.assignments].sort((x, y) => x.startTime - y.startTime);\n    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);\n  });\n\n  it('marks an event unscheduled when its duration exceeds the window', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Marathon', duration: 600 }];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments).toEqual([]);\n    expect(result.unscheduled).toEqual(['e1']);\n  });\n\n  it('defaults attendees to 1 when omitted', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Solo', duration: 30 }];\n    const rooms: Room[] = [room('r1', 1)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments[0].roomId).toBe('r1');\n  });\n});\n\ndescribe('room capacity', () => {\n  it('leaves an event unscheduled when it exceeds every room capacity', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Big', duration: 30, attendees: 50 }];\n    const rooms: Room[] = [room('r1', 10), room('r2', 20)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments).toEqual([]);\n    expect(result.unscheduled).toEqual(['e1']);\n  });\n\n  it('places an event into a room whose capacity satisfies attendees', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Mid', duration: 30, attendees: 5 }];\n    const rooms: Room[] = [room('small', 2), room('big', 10)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments[0].roomId).toBe('big');\n  });\n});\n\ndescribe('time window', () => {\n  it('keeps every assignment within [startTime, endTime]', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 45 },\n      { id: 'e3', name: 'C', duration: 20 },\n    ];\n    const rooms: Room[] = [room('r1', 5), room('r2', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 620, gap: 5 });\n    for (const a of result.assignments) {\n      expect(a.startTime).toBeGreaterThanOrEqual(540);\n      expect(a.endTime).toBeLessThanOrEqual(620);\n    }\n  });\n\n  it('schedules an event that exactly fills the window', () => {\n    const events: Event[] = [{ id: 'e1', name: 'Full', duration: 60 }];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments[0]).toMatchObject({ startTime: 540, endTime: 600 });\n  });\n});\n\ndescribe('room gaps', () => {\n  it('enforces the default 15 minute gap between events in the same room', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 30 },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700 });\n    expect(result.unscheduled).toEqual([]);\n    const [a, b] = [...result.assignments].sort((x, y) => x.startTime - y.startTime);\n    expect(b.startTime - a.endTime).toBeGreaterThanOrEqual(15);\n  });\n\n  it('honors a custom gap of 0 allowing back-to-back events', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 30 },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600, gap: 0 });\n    expect(result.unscheduled).toEqual([]);\n    const [a, b] = [...result.assignments].sort((x, y) => x.startTime - y.startTime);\n    expect(b.startTime).toBe(a.endTime);\n  });\n\n  it('honors a larger custom gap', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 30 },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700, gap: 60 });\n    expect(result.unscheduled).toEqual([]);\n    const [a, b] = [...result.assignments].sort((x, y) => x.startTime - y.startTime);\n    expect(b.startTime - a.endTime).toBeGreaterThanOrEqual(60);\n  });\n\n  it('does not apply gap constraints across different rooms', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 30 },\n      { id: 'e2', name: 'B', duration: 30 },\n    ];\n    const rooms: Room[] = [room('r1', 5), room('r2', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 570, gap: 15 });\n    expect(result.unscheduled).toEqual([]);\n    expect(result.assignments[0].startTime).toBe(540);\n    expect(result.assignments[1].startTime).toBe(540);\n    expect(result.assignments[0].roomId).not.toBe(result.assignments[1].roomId);\n  });\n});\n\ndescribe('prerequisites', () => {\n  it('schedules a dependent event after its prerequisite finishes plus gap', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30 },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms: Room[] = [room('r1', 5), room('r2', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700, gap: 15 });\n    const a = result.assignments.find((x) => x.eventId === 'A')!;\n    const b = result.assignments.find((x) => x.eventId === 'B')!;\n    expect(a).toBeDefined();\n    expect(b).toBeDefined();\n    expect(a.endTime + 15).toBeLessThanOrEqual(b.startTime);\n  });\n\n  it('cascades unscheduled status to dependents of an unschedulable prerequisite', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30, attendees: 100 },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700 });\n    expect(result.unscheduled.sort()).toEqual(['A', 'B']);\n  });\n\n  it('waits for the latest of multiple prerequisites', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 20 },\n      { id: 'B', name: 'B', duration: 50 },\n      { id: 'C', name: 'C', duration: 20, prerequisites: ['A', 'B'] },\n    ];\n    const rooms: Room[] = [room('r1', 5), room('r2', 5), room('r3', 5)];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 800, gap: 10 });\n    const a = result.assignments.find((x) => x.eventId === 'A')!;\n    const b = result.assignments.find((x) => x.eventId === 'B')!;\n    const c = result.assignments.find((x) => x.eventId === 'C')!;\n    expect(a && b && c).toBeTruthy();\n    expect(c.startTime).toBeGreaterThanOrEqual(Math.max(a.endTime, b.endTime) + 10);\n  });\n\n  it('treats a prerequisite referencing an unknown event id as impossible without crashing', () => {\n    const events: Event[] = [{ id: 'B', name: 'B', duration: 30, prerequisites: ['ghost'] }];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).not.toThrow();\n    const result = schedule(events, rooms, { startTime: 540, endTime: 700 });\n    expect(result.unscheduled).toEqual(['B']);\n  });\n});\n\ndescribe('cycle detection', () => {\n  it('throws on a self-referencing prerequisite', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 30, prerequisites: ['A'] }];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).toThrow();\n  });\n\n  it('throws on a two-node cycle', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30, prerequisites: ['B'] },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).toThrow();\n  });\n\n  it('throws on a longer cycle', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30, prerequisites: ['C'] },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n      { id: 'C', name: 'C', duration: 30, prerequisites: ['B'] },\n    ];\n    const rooms: Room[] = [room('r1', 5)];\n    expect(() => schedule(events, rooms, { startTime: 540, endTime: 700 })).toThrow();\n  });\n\n  it('does not throw for a valid diamond-shaped DAG', () => {\n    const events: Event[] = [\n      { id: 'A', name: