+  });
+
+  it('never violates the gap constraint for any pair of events in the same room', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'A', duration: 25 },
+      { id: 'e2', name: 'B', duration: 25 },
+      { id: 'e3', name: 'C', duration: 25 },
+      { id: 'e4', name: 'D', duration: 25 },
+    ];
+    const rooms: Room[] = [room('r1', 5)];
+    const result = schedule(events, rooms, { startTime: 540, endTime: 900, gap: 20 });
+    const byRoom = new Map<string, typeof result.assignments>();
+    for (const a of result.assignments) {
+      const list = byRoom.get(a.roomId) ?? [];
+      list.push(a);
+      byRoom.set(a.roomId, list);
+    }
+    for (const list of byRoom.values()) {
+      const sorted = [...list].sort((x, y) => x.startTime - y.startTime);
+      for (let i = 1; i < sorted.length; i++) {
+        expect(sorted[i].startTime - sorted[i - 1].endTime).toBeGreaterThanOrEqual(20);
+      }
+    }
+  });
+
+  it('returns empty result for empty events array', () => {
+    const result = schedule([], [room('r1', 5)], { startTime: 540, endTime: 600 });
+    expect(result).toEqual({ assignments: [], unscheduled: [] });
+  });
+
+  it('marks all events unscheduled when there are no rooms', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'A', duration: 30 },
+      { id: 'e2', name: 'B', duration: 30 },
+    ];
+    const result = schedule(events, [], { startTime: 540, endTime: 600 });
+    expect(result.assignments).toEqual([]);
+    expect(result.unscheduled.sort()).toEqual(['e1', 'e2']);
