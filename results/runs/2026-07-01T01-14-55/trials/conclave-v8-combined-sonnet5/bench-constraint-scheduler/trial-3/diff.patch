e: 0, endTime: 120, gap: 0 });\n    // naive input-order greedy schedules only 'big' (90) then has 30 min left,\n    // fits exactly one more of the 30-min events => 2 total.\n    // An optimizer that skips 'big' schedules both small1 and small2 => 2 total either way in this exact case,\n    // so use a case where skipping big allows strictly more events.\n    expect(result.assignments.length).toBeGreaterThanOrEqual(2);\n  });\n\n  it('prefers scheduling more, smaller events over one large event when it increases count', () => {\n    const events: Event[] = [\n      { id: 'big', name: 'Big', duration: 100 },\n      { id: 's1', name: 'S1', duration: 30 },\n      { id: 's2', name: 'S2', duration: 30 },\n      { id: 's3', name: 'S3', duration: 30 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 5 }];\n    // window is 100 min: either 'big' alone (1 event) or 3 small (90 min, fits with gap=0)\n    const result = schedule(events, rooms, { startTime: 0, endTime: 100, gap: 0 });\n    expect(result.assignments.length).toBe(3);\n    expect(result.assignments.map((a) => a.eventId).sort()).toEqual(['s1', 's2', 's3']);\n  });\n\n  it('assignments.length + unscheduled.length equals total events', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 30 },\n      { id: 'b', name: 'B', duration: 30 },\n      { id: 'c', name: 'C', duration: 1000 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 5 }];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments.length + result.unscheduled.length).toBe(events.length);\n  });\n\n  it('produces no double-booked rooms across a complex scenario', () => {\n    const events: Event[] = [\n      { id: 'a', name: 'A', duration: 45, attendees: 3 },\n      { id: 'b', name: 'B', duration: 30, attendees: 8, prerequisites: ['a'] },\n      { id: 'c', name: 'C', duration: 60, attendees: 2, preferredRoom: 'r1' },\n      { id