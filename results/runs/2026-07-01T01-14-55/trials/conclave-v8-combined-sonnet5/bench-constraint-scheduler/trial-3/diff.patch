+
+function overlaps(a: Assignment, b: Assignment, gap: number): boolean {
+  if (a.roomId !== b.roomId) return false;
+  return a.startTime < b.endTime + gap && b.startTime < a.endTime + gap;
+}
+
+function assertNoDoubleBooking(assignments: Assignment[], gap: number) {
+  for (let i = 0; i < assignments.length; i++) {
+    for (let j = i + 1; j < assignments.length; j++) {
+      expect(overlaps(assignments[i], assignments[j], gap)).toBe(false);
+    }
+  }
+}
