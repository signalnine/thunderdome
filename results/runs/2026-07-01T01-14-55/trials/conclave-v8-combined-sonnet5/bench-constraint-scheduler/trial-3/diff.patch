+++ b/src/index.ts
@@ -0,0 +1,191 @@
+import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';
+
+export type { Event, Room, ScheduleOptions, Assignment, ScheduleResult };
+
+const DEFAULT_GAP = 15;
+
+/**
+ * Computes a topological rank per event (prerequisites always rank lower)
+ * while detecting cycles in the prerequisite graph. References to
+ * nonexistent event ids are treated as permanently unsatisfiable
+ * dependencies, not as cycle participants.
+ */
+function computeRanks(events: Event[]): Map<string, number> {
+  const eventsById = new Map(events.map((e) => [e.id, e]));
+  const color = new Map<string, 0 | 1 | 2>();
+  const rank = new Map<string, number>();
+
+  function visit(id: string): number {
+    const event = eventsById.get(id);
+    if (!event) return -1; // nonexistent prerequisite: no rank contribution
+
+    const state = color.get(id) ?? 0;
+    if (state === 1) {
+      throw new Error(`Prerequisite cycle detected involving event "${id}"`);
+    }
+    if (state === 2) {
+      return rank.get(id) ?? 0;
+    }
+
+    color.set(id, 1);
+    let maxPrereqRank = -1;
+    for (const prereqId of event.prerequisites ?? []) {
+      const r = visit(prereqId);
+      if (r > maxPrereqRank) maxPrereqRank = r;
+    }
+    color.set(id, 2);
+    const myRank = maxPrereqRank + 1;
+    rank.set(id, myRank);
+    return myRank;
+  }
+
+  for (const event of events) visit(event.id);
+  return rank;
+}
+
+/**
+ * Finds the earliest start time >= lowerBound in a room whose existing
+ * bookings (sorted by startTime) leaves `gap` minutes of separation, with
+ * the event fitting entirely inside [.., windowEnd]. Returns null if no
+ * such slot exists.
+ */
+function findSlot(
+  bookings: Assignment[],
+  lowerBound: number,
+  duration: number,
+  gap: number,
+  windowEnd: number,
+): number | null {
+  let prevEnd = lowerBound;
+  for (let i = 0; i <= bookings.length; i++) {
+    const candidateStart = Math.max(prevEnd, lowerBound);
+    const candidateEnd = candidateStart + duration;
+    if (i < bookings.length) {
+      const nextStart = bookings[i].startTime;
+      if (candidateEnd + gap <= nextStart && candidateEnd <= windowEnd) {
+        return candidateStart;
+      }
+      prevEnd = Math.max(prevEnd, bookings[i].endTime + gap);
+    } else if (candidateEnd <= windowEnd) {
+      return candidateStart;
+    }
+  }
+  return null;
+}
+
+function insertSorted(list: Assignment[], assignment: Assignment): void {
+  const idx = list.findIndex((b) => b.startTime > assignment.startTime);
+  if (idx === -1) list.push(assignment);
+  else list.splice(idx, 0, assignment);
+}
+
+function attemptSchedule(orderedEvents: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const scheduled = new Map<string, Assignment>();
+  const roomBookings = new Map<string, Assignment[]>();
+  const unscheduled: string[] = [];
+
+  for (const event of orderedEvents) {
+    const attendees = event.attendees ?? 1;
+
+    let lowerBound = options.startTime;
+    let prereqsSatisfied = true;
+    for (const prereqId of event.prerequisites ?? []) {
+      const prereqAssignment = scheduled.get(prereqId);
+      if (!prereqAssignment) {
+        prereqsSatisfied = false;
+        break;
+      }
+      lowerBound = Math.max(lowerBound, prereqAssignment.endTime + gap);
+    }
+    if (!prereqsSatisfied) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    const candidateRooms = rooms.filter((r) => r.capacity >= attendees);
+    if (candidateRooms.length === 0) {
+      unscheduled.push(event.id);
+      continue;
+    }
+
+    let chosen: { room: Room; start: number } | null = null;
+
+    if (event.preferredRoom) {
+      const preferred = candidateRooms.find((r) => r.id === event.preferredRoom);
+      if (preferred) {
+        const start = findSlot(roomBookings.get(preferred.id) ?? [], lowerBound, event.duration, gap, options.endTime);
+        if (start !== null) chosen = { room: preferred, start };
+      }
+    }
+
+    if (chosen === null) {
+      for (const room of candidateRooms) {
+        const start = findSlot(roomBookings.get(room.id) ?? [], lowerBound, event.duration, gap, options.endTime);
+        if (start === null) continue;
+        if (chosen === null || start < chosen.start || (start === chosen.start && room.capacity < chosen.room.capacity)) {
+          chosen = { room, start };
+        }
+      }
+    }
+
+    if (chosen === null) {
+      unscheduled.push(event.id);
+      continue;
+    }
+    const { room: chosenRoom, start: chosenStart } = chosen;
+
+    const assignment: Assignment = {
+      eventId: event.id,
+      roomId: chosenRoom.id,
+      startTime: chosenStart,
+      endTime: chosenStart + event.duration,
+    };
+    scheduled.set(event.id, assignment);
+    const bookings = roomBookings.get(chosenRoom.id) ?? [];
+    insertSorted(bookings, assignment);
+    roomBookings.set(chosenRoom.id, bookings);
+  }
+
+  return { assignments: [...scheduled.values()], unscheduled };
+}
+
+function buildOrderings(events: Event[], rankMap: Map<string, number>): Event[][] {
+  const withMeta = events.map((e, i) => ({ event: e, index: i, rank: rankMap.get(e.id) ?? 0 }));
+
+  function sortBy(keyFn: (e: Event) => number): Event[] {
+    return [...withMeta]
+      .sort((a, b) => {
+        if (a.rank !== b.rank) return a.rank - b.rank;
+        const ka = keyFn(a.event);
+        const kb = keyFn(b.event);
+        if (ka !== kb) return ka - kb;
+        return a.index - b.index;
+      })
+      .map((x) => x.event);
+  }
+
+  return [
+    sortBy(() => 0), // stable input order within rank
+    sortBy((e) => e.duration), // shortest first
+    sortBy((e) => -e.duration), // longest first
+    sortBy((e) => e.attendees ?? 1), // fewest attendees first
+    sortBy((e) => e.duration * (e.attendees ?? 1)), // smallest footprint first
+  ];
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  const rankMap = computeRanks(events);
+  const orderings = buildOrderings(events, rankMap);
+
+  let best = attemptSchedule(orderings[0], rooms, options);
+  for (let i = 1; i < orderings.length; i++) {
+    const result = attemptSchedule(orderings[i], rooms, options);
+    if (result.assignments.length > best.assignments.length) {
+      best = result;
+    }
+  }
+  return best;
+}
+
+export default schedule;
