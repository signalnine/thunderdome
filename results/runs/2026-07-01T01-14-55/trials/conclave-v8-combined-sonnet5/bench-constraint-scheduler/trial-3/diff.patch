Length(1);\n    expect(result.assignments[0].eventId).toBe('a');\n    expect(result.assignments[0].roomId).toBe('r1');\n  });\n\n  it('respects room capacity - event too big for only room is unscheduled', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 30, attendees: 10 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 5 }];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toEqual(['a']);\n  });\n\n  it('defaults attendees to 1 when omitted', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 1 }];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assignments).toHaveLength(1);\n  });\n\n  it('keeps assignments within the time window', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 30 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 5 }];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    const [a] = result.assignments;\n    expect(a.startTime).toBeGreaterThanOrEqual(540);\n    expect(a.endTime).toBeLessThanOrEqual(600);\n  });\n\n  it('sets endTime = startTime + duration', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 45 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 5 }];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    const [a] = result.assignments;\n    expect(a.endTime).toBe(a.startTime + 45);\n  });\n\n  it('marks event unscheduled if duration exceeds window length', () => {\n    const events: Event[] = [{ id: 'a', name: 'A', duration: 120 }];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room 1', capacity: 5 }];\n    const result = schedule(events, rooms, { startTime: 540, endTime: 600 });\n    expect(result.assign