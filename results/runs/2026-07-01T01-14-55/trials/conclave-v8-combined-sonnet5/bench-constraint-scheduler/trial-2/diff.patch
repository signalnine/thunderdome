] }, id: string): Assignment | undefined {\n  return result.assignments.find((a) => a.eventId === id);\n}\n\ndescribe('schedule export', () => {\n  it('is a function', () => {\n    expect(typeof schedule).toBe('function');\n  });\n});\n\ndescribe('basic scheduling', () => {\n  it('schedules a single unconstrained event within the window', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 60 }];\n    const rooms = roomsOf(10);\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A');\n    expect(a).toBeDefined();\n    expect(result.unscheduled).not.toContain('A');\n    expect(a!.startTime).toBeGreaterThanOrEqual(DAY.startTime);\n    expect(a!.endTime).toBe(a!.startTime + 60);\n    expect(a!.endTime).toBeLessThanOrEqual(DAY.endTime);\n  });\n\n  it('schedules independent events into separate rooms', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60 },\n      { id: 'B', name: 'B', duration: 60 },\n    ];\n    const rooms = roomsOf(10, 10);\n    const result = schedule(events, rooms, DAY);\n    expect(result.assignments).toHaveLength(2);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n});\n\ndescribe('room capacity', () => {\n  it('leaves event unscheduled if no room has enough capacity', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 60, attendees: 100 }];\n    const rooms = roomsOf(10, 20);\n    const result = schedule(events, rooms, DAY);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toEqual(['A']);\n  });\n\n  it('assigns event only to a room with sufficient capacity', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 60, attendees: 15 }];\n    const rooms = [\n      { id: 'small', name: 'Small', capacity: 10 },\n      { id: 'big', name: 'Big', capacity: 20 },\n    ];\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A');\n    expect(a).toBeDefined();\n    expect(a!.roomId).toBe('big');\n  });\n});\n\ndescribe('time window', () => {\n  it('never assigns outside the window', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30 },\n      { id: 'B', name: 'B', duration: 45 },\n    ];\n    const rooms = roomsOf(5);\n    const result = schedule(events, rooms, DAY);\n    for (const a of result.assignments) {\n      expect(a.startTime).toBeGreaterThanOrEqual(DAY.startTime);\n      expect(a.endTime).toBeLessThanOrEqual(DAY.endTime);\n    }\n  });\n\n  it('cannot schedule an event longer than the whole window', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 1000 }];\n    const rooms = roomsOf(5);\n    const result = schedule(events, rooms, DAY);\n    expect(result.unscheduled).toEqual(['A']);\n  });\n});\n\ndescribe('room gap', () => {\n  it('enforces default 15 minute gap between same-room events', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60 },\n      { id: 'B', name: 'B', duration: 60 },\n    ];\n    const rooms = roomsOf(5); // only one room forces sequential scheduling\n    const result = schedule(events, rooms, DAY);\n    expect(result.assignments).toHaveLength(2);\n    const [first, second] = result.assignments.sort((a, b) => a.startTime - b.startTime);\n    expect(second.startTime).toBeGreaterThanOrEqual(first.endTime + 15);\n  });\n\n  it('enforces a custom gap value', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60 },\n      { id: 'B', name: 'B', duration: 60 },\n    ];\n    const rooms = roomsOf(5);\n    const result = schedule(events, rooms, { ...DAY, gap: 30 });\n    expect(result.assignments).toHaveLength(2);\n    const [first, second] = result.assignments.sort((a, b) => a.startTime - b.startTime);\n    expect(second.startTime).toBeGreaterThanOrEqual(first.endTime + 30);\n  });\n});\n\ndescribe('prerequisites', () => {\n  it('schedules dependent event after its prerequisite finishes plus gap', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60 },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms = roomsOf(5, 5);\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A')!;\n    const b = findAssignment(result, 'B')!;\n    expect(a).toBeDefined();\n    expect(b).toBeDefined();\n    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);\n  });\n\n  it('waits for the later of multiple prerequisites', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30 },\n      { id: 'B', name: 'B', duration: 90 },\n      { id: 'C', name: 'C', duration: 30, prerequisites: ['A', 'B'] },\n    ];\n    const rooms = roomsOf(5, 5, 5);\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A')!;\n    const b = findAssignment(result, 'B')!;\n    const c = findAssignment(result, 'C')!;\n    expect(c.startTime).toBeGreaterThanOrEqual(a.endTime + 15);\n    expect(c.startTime).toBeGreaterThanOrEqual(b.endTime + 15);\n  });\n\n  it('enforces prerequisite ordering even across different rooms', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60 },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms = roomsOf(5, 5);\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A')!;\n    const b = findAssignment(result, 'B')!;\n    expect(b.startTime).toBeGreaterThanOrEqual(a.endTime + 15);\n  });\n\n  it('cascades unscheduled prerequisite to its dependents', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60, attendees: 999 }, // impossible capacity\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms = roomsOf(5, 5);\n    const result = schedule(events, rooms, DAY);\n    expect(result.unscheduled).toEqual(expect.arrayContaining(['A', 'B']));\n    expect(findAssignment(result, 'B')).toBeUndefined();\n  });\n});\n\ndescribe('preferred room', () => {\n  it('honors preferred room when feasible', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 30, preferredRoom: 'room2' }];\n    const rooms = roomsOf(5, 5, 5);\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A')!;\n    expect(a.roomId).toBe('room2');\n  });\n\n  it('falls back to another room when preferred room lacks capacity', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 30, attendees: 10, preferredRoom: 'small' }];\n    const rooms = [\n      { id: 'small', name: 'Small', capacity: 5 },\n      { id: 'big', name: 'Big', capacity: 20 },\n    ];\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A')!;\n    expect(a).toBeDefined();\n    expect(a.roomId).toBe('big');\n  });\n\n  it('falls back to another room when preferred room has no free slot', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 480, preferredRoom: 'room1' }, // fills whole window in room1\n      { id: 'B', name: 'B', duration: 30 },\n    ];\n    const rooms = roomsOf(5, 5);\n    const result = schedule(events, rooms, DAY);\n    const a = findAssignment(result, 'A')!;\n    const b = findAssignment(result, 'B')!;\n    expect(a.roomId).toBe('room1');\n    expect(b).toBeDefined();\n    expect(b.roomId).not.toBe('room1');\n  });\n});\n\ndescribe('cycle detection', () => {\n  it('throws on self-referencing prerequisite', () => {\n    const events: Event[] = [{ id: 'A', name: 'A', duration: 30, prerequisites: ['A'] }];\n    const rooms = roomsOf(5);\n    expect(() => schedule(events, rooms, DAY)).toThrow();\n  });\n\n  it('throws on a multi-node cycle', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 30, prerequisites: ['B'] },\n      { id: 'B', name: 'B', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms = roomsOf(5);\n    expect(() => schedule(events, rooms, DAY)).toThrow();\n  });\n\n  it('does not throw for a valid diamond-shaped DAG', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 15 },\n      { id: 'B', name: 'B', duration: 15, prerequisites: ['A'] },\n      { id: 'C', name: 'C', duration: 15, prerequisites: ['A'] },\n      { id: 'D', name: 'D', duration: 15, prerequisites: ['B', 'C'] },\n    ];\n    const rooms = roomsOf(5, 5, 5, 5);\n    expect(() => schedule(events, rooms, DAY)).not.toThrow();\n    const result = schedule(events, rooms, DAY);\n    expect(result.assignments).toHaveLength(4);\n  });\n});\n\ndescribe('batch optimization', () => {\n  it('prefers scheduling more short events over one long event when both cannot fit', () => {\n    // Single room, 8-hour window (480 min). One long event fills the whole window.\n    // Three short events (100 min each = 300 + gaps) could all fit instead.\n    const events: Event[] = [\n      { id: 'long', name: 'Long', duration: 480 },\n      { id: 'short1', name: 'Short1', duration: 100 },\n      { id: 'short2', name: 'Short2', duration: 100 },\n      { id: 'short3', name: 'Short3', duration: 100 },\n    ];\n    const rooms = roomsOf(5);\n    const result = schedule(events, rooms, DAY);\n    expect(result.assignments.length).toBeGreaterThanOrEqual(3);\n    expect(result.unscheduled).toContain('long');\n  });\n});\n\ndescribe('result completeness', () => {\n  it('accounts for every input event exactly once across assignments and unscheduled', () => {\n    const events: Event[] = [\n      { id: 'A', name: 'A', duration: 60 },\n      { id: 'B', name: 'B', duration: 60, attendees: 999 },\n      { id: 'C', name: 'C', duration: 30, prerequisites: ['A'] },\n    ];\n    const rooms = roomsOf(5, 5);\n    const result = schedule(events, rooms, DAY);\n    const allIds = [...result.assignments.map((a) => a.eventId), ...result.unscheduled];\n    expect(allIds.sort()).toEqual(['A', 'B', 'C']);\n    expect(new Set(allIds).size).toBe(3);\n  });\n\n  it('never produces overlapping assignments within the same room', () => {\n    const events: Event[] = Array.from({ length: 10 }, (_, i) => ({\n      id: `E${i}`,\n      name: `E${i}`,\n      duration: 45,\n    }));\n    const rooms = roomsOf(5, 5, 5);\n    const result = schedule(events, rooms, DAY);\n    const byRoom = new Map<string, Assignment[]>();\n    for (const a of result.assignments) {\n      const list = byRoom.get(a.roomId) ?? [];\n      list.push(a);\n      byRoom.set(a.roomId, list);\n    }\n    for (const list of byRoom.values()) {\n      const sorted = list.sort((a, b) => a.startTime - b.startTime);\n      for (let i = 1; i < sorted.length; i++) {\n        expect(sorted[i].startTime).toBeGreaterThanOrEqual(sorted[i - 1].endTime + 15);\n      }\n    }\n  });\n});\n","structuredPatch":[{"oldStart":250,"oldLines":6,"newStart":250,"newLines":29,"lines":["   });"," });"," ","+describe('edge cases', () => {","+  it('treats a reference to a non-existent prerequisite as permanently unresolved', () => {","+    const events: Event[] = [{ id: 'A', name: 'A', duration: 30, prerequisites: ['ghost'] }];","+    const rooms = roomsOf(5);","+    const result = schedule(events, rooms, DAY);","+    expect(result.assignments).toHaveLength(0);","+    expect(result.unscheduled).toEqual(['A']);","+  });","+","+  it('defaults attendees to 1 when omitted', () => {","+    const events: Event[] = [{ id: 'A', name: 'A', duration: 30 }];","+    const rooms = [{ id: 'tiny', name: 'Tiny', capacity: 1 }];","+    const result = schedule(events, rooms, DAY);","+    expect(findAssignment(result, 'A')).toBeDefined();","+  });","+","+  it('handles an empty event list', () => {","+    const result = schedule([], roomsOf(5), DAY);","+    expect(result.assignments).toEqual([]);","+    expect(result.unscheduled).toEqual([]);","+  });","+});","+"," describe('result completeness', () => {","   it('accounts for every input event exactly once across assignme