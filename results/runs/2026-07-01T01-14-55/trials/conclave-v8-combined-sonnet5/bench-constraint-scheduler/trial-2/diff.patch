diff --git a/src/scheduler.ts b/src/scheduler.ts
new file mode 100644
index 0000000..53981d0
--- /dev/null
+++ b/src/scheduler.ts
@@ -0,0 +1,223 @@
+import type { Assignment, Event, Room, ScheduleOptions, ScheduleResult } from './types.js';
+
+const DEFAULT_GAP = 15;
+
+function assertNoPrerequisiteCycles(events: Event[]): void {
+  const byId = new Map(events.map((e) => [e.id, e]));
+  const WHITE = 0;
+  const GRAY = 1;
+  const BLACK = 2;
+  const color = new Map<string, number>(events.map((e) => [e.id, WHITE]));
+
+  function visit(id: string, stack: string[]): void {
+    if (color.get(id) === BLACK) return;
+    if (color.get(id) === GRAY) {
+      const cycleStart = stack.indexOf(id);
+      const cycle = stack.slice(cycleStart).concat(id);
+      throw new Error(`Cycle detected in event prerequisites: ${cycle.join(' -> ')}`);
+    }
+    const event = byId.get(id);
+    if (!event) return; // reference to unknown event; not part of any cycle
+    color.set(id, GRAY);
+    stack.push(id);
+    for (const prereqId of event.prerequisites ?? []) {
+      visit(prereqId, stack);
+    }
+    stack.pop();
+    color.set(id, BLACK);
+  }
+
+  for (const event of events) {
+    visit(event.id, []);
+  }
+}
+
+interface Booking {
+  startTime: number;
+  endTime: number;
+}
+
+/** Earliest start >= earliestStart that fits `duration` minutes in `bookings`, honoring `gap` on both sides, within [windowStart, windowEnd]. Null if no such slot exists. */
+function findEarliestSlot(
+  bookings: Booking[],
+  duration: number,
+  earliestStart: number,
+  windowStart: number,
+  windowEnd: number,
+  gap: number,
+): number | null {
+  const sorted = [...bookings].sort((a, b) => a.startTime - b.startTime);
+  let cursor = Math.max(earliestStart, windowStart);
+  for (const booking of sorted) {
+    if (cursor + duration <= booking.startTime - gap) {
+      return cursor;
+    }
+    cursor = Math.max(cursor, booking.endTime + gap);
+  }
+  if (cursor + duration <= windowEnd) {
+    return cursor;
+  }
+  return null;
+}
+
+type Comparator = (a: Event, b: Event) => number;
+
+function runStrategy(
+  events: Event[],
+  rooms: Room[],
+  options: ScheduleOptions,
+  compare: Comparator,
+): ScheduleResult {
+  const gap = options.gap ?? DEFAULT_GAP;
+  const roomById = new Map(rooms.map((r) => [r.id, r]));
+  const bookingsByRoom = new Map<string, Booking[]>(rooms.map((r) => [r.id, []]));
+
+  const eventById = new Map(events.map((e) => [e.id, e]));
+  const scheduledEnd = new Map<string, number>();
+  const assignments: Assignment[] = [];
+  const unscheduled: string[] = [];
+  const decided = new Set<string>(); // scheduled or given up on
+
+  const unresolvedPrereqs = new Map<string, Set<string>>(
+    events.map((e) => [e.id, new Set(e.prerequisites ?? [])]),
+  );
+
+  const dependents = new Map<string, string[]>(events.map((e) => [e.id, []]));
+  for (const event of events) {
+    for (const prereqId of event.prerequisites ?? []) {
+      dependents.get(prereqId)?.push(event.id);
+    }
+  }
+
+  const ready: Event[] = events.filter((e) => (unresolvedPrereqs.get(e.id)?.size ?? 0) === 0);
+
+  function earliestStartFor(event: Event): number {
+    const prereqIds = event.prerequisites ?? [];
+    let bound = options.startTime;
+    for (const id of prereqIds) {
+      const end = scheduledEnd.get(id);
+      if (end !== undefined) {
+        bound = Math.max(bound, end + gap);
+      }
+    }
+    return bound;
+  }
+
+  function tryPlace(event: Event): Assignment | null {
+    const attendees = event.attendees ?? 1;
+    const earliestStart = earliestStartFor(event);
+    const eligibleRooms = rooms.filter((r) => r.capacity >= attendees);
+    if (eligibleRooms.length === 0) return null;
+
+    if (event.preferredRoom) {
+      const preferred = roomById.get(event.preferredRoom);
+      if (preferred && preferred.capacity >= attendees) {
+        const slot = findEarliestSlot(
+          bookingsByRoom.get(preferred.id) ?? [],
+          event.duration,
+          earliestStart,
+          options.startTime,
+          options.endTime,
+          gap,
+        );
+        if (slot !== null) {
+          return { eventId: event.id, roomId: preferred.id, startTime: slot, endTime: slot + event.duration };
+        }
+      }
+    }
+
+    let best: { roomId: string; start: number; capacity: number } | null = null;
+    for (const room of eligibleRooms) {
+      const slot = findEarliestSlot(
+        bookingsByRoom.get(room.id) ?? [],
+        event.duration,
+        earliestStart,
+        options.startTime,
+        options.endTime,
+        gap,
+      );
+      if (slot === null) continue;
+      if (
+        !best ||
+        slot < best.start ||
+        (slot === best.start && room.capacity < best.capacity) ||
+        (slot === best.start && room.capacity === best.capacity && room.id < best.roomId)
+      ) {
+        best = { roomId: room.id, start: slot, capacity: room.capacity };
+      }
+    }
+    if (!best) return null;
+    return { eventId: event.id, roomId: best.roomId, startTime: best.start, endTime: best.start + event.duration };
+  }
+
+  while (ready.length > 0) {
+    ready.sort(compare);
+    const event = ready.shift() as Event;
+    if (decided.has(event.id)) continue;
+    decided.add(event.id);
+
+    const assignment = tryPlace(event);
+    if (assignment) {
+      assignments.push(assignment);
+      scheduledEnd.set(event.id, assignment.endTime);
+      bookingsByRoom.get(assignment.roomId)?.push({ startTime: assignment.startTime, endTime: assignment.endTime });
+
+      for (const depId of dependents.get(event.id) ?? []) {
+        const unresolved = unresolvedPrereqs.get(depId);
+        unresolved?.delete(event.id);
+        if (unresolved && unresolved.size === 0 && !decided.has(depId)) {
+          const depEvent = eventById.get(depId);
+          if (depEvent) ready.push(depEvent);
+        }
+      }
+    } else {
+      unscheduled.push(event.id);
+    }
+  }
+
+  for (const event of events) {
+    if (!scheduledEnd.has(event.id) && !unscheduled.includes(event.id)) {
+      unscheduled.push(event.id);
+    }
+  }
+
+  return { assignments, unscheduled };
+}
+
+const STRATEGIES: Comparator[] = [
+  (a, b) => a.duration - b.duration || a.id.localeCompare(b.id),
+  (a, b) => b.duration - a.duration || a.id.localeCompare(b.id),
+  (a, b) => (a.attendees ?? 1) - (b.attendees ?? 1) || a.id.localeCompare(b.id),
+];
+
+function countHonoredPreferences(events: Event[], result: ScheduleResult): number {
+  const eventById = new Map(events.map((e) => [e.id, e]));
+  let honored = 0;
+  for (const assignment of result.assignments) {
+    const event = eventById.get(assignment.eventId);
+    if (event?.preferredRoom && event.preferredRoom === assignment.roomId) {
+      honored++;
+    }
+  }
+  return honored;
+}
+
+export function schedule(events: Event[], rooms: Room[], options: ScheduleOptions): ScheduleResult {
+  assertNoPrerequisiteCycles(events);
+
+  let bestResult: ScheduleResult | null = null;
+  let bestHonored = -1;
+  for (const compare of STRATEGIES) {
+    const result = runStrategy(events, rooms, options, compare);
+    const honored = countHonoredPreferences(events, result);
+    if (
+      !bestResult ||
+      result.assignments.length > bestResult.assignments.length ||
+      (result.assignments.length === bestResult.assignments.length && honored > bestHonored)
+    ) {
+      bestResult = result;
+      bestHonored = honored;
+    }
+  }
+  return bestResult as ScheduleResult;
+}
