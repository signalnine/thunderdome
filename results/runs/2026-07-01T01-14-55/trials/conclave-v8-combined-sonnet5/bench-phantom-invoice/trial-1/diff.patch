t  const invoices = stmt.all(customerId) as Invoice[];\n63\t\n64\t  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n65\t\n66\t  return {\n67\t    customer_id: customerId,\n68\t    invoice_count: invoices.length,\n69\t    total_spent: Math.round(totalSpent * 100) / 100,\n70\t    average_invoice: invoices.length > 0\n71\t      ? Math.round((totalSpent / invoices.length) * 100) / 100\n72\t      : 0,\n73\t  };\n74\t}\n75\t\n76\t/**\n77\t * Get total revenue for a date period.\n78\t */\n79\texport function getRevenueByPeriod(\n80\t  db: Database.Database,\n81\t  start: string,\n82\t  end: string,\n83\t): { total: number; count: number } {\n84\t  const stmt = db.prepare(`\n85\t    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n86\t    FROM invoices\n87\t    WHERE date >= ? AND date <= ?\n88\t  `);\n89\t\n90\t  const result = stmt.get(start, end) as { total: number; count: number };\n91\t  return {\n92\t    total: Math.round(result.total * 100) / 100,\n93\t    count: result.count,\n94\t  };\n95\t}\n96\t"}]},"parent_tool_use_id":null,"session_id":"25858360-3f80-44ce-a8c2-06d01e276ae8","uuid":"4d175b93-c1ed-4bec-b3f6-48e9d95fe68a","timestamp":"2026-07-01T01:21:23.573Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/services/reporting.ts","content":"import type Database from 'better-sqlite3';\nimport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n\n/**\n * Generate a monthly revenue report for a given year.\n * Groups invoices by their UTC month and aggregates totals.\n */\nexport function getMonthlyReport(\n  db: Database.Database,\n  year: number,\n): InvoiceSummary[] {\n  const startDate = `${year}-01-01`;\n  const endDate = `${year}-12-31`;\n\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE date >= ? AND date <= ?\n    ORDER BY date ASC\n  `);\n\n  const invoices = stmt.all(startDate, endDate) as Invoice[];\n\n  // Group invoices by month\n  const monthlyMap = new Map<number, { count: number; total: number }>();\n\n  for (const inv of invoices) {\n    const d = new Date(inv.date + 'T00:00:00Z');\n    const month = d.getMonth() + 1; // 1-indexed\n\n    const current = monthlyMap.get(month) || { count: 0, total: 0 };\n    current.count += 1;\n    current.total += inv.total;\n    monthlyMap.set(month, current);\n  }\n\n  // Convert to array of summaries\n  const summaries: InvoiceSummary[] = [];\n  for (const [month, data] of monthlyMap) {\n    summaries.push({\n      month,\n      year,\n      count: data.count,\n      total_revenue: Math.round(data.total * 100) / 100,\n    });\n  }\n\n  return summaries.sort((a, b) => a.month - b.month);\n}\n\n/**\n * Generate a report for a specific customer.\n */\nexport function getCustomerReport(\n  db: Database.Database,\n  customerId: string,\n): CustomerReport {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE customer_id = ?\n  `);\n\n  const invoices = stmt.all(customerId) as Invoice[];\n\n  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n\n  return {\n    customer_id: customerId,\n    invoice_count: invoices.length,\n    total_spent: Math.round(totalSpent * 100) / 100,\n    average_invoice: invoices.length > 0\n      ? Math.round((totalSpent / invoices.length) * 100) / 100\n      : 0,\n  };\n}\n\n/**\n * Get total revenue for a date period.\n */\nexport function getRevenueByPeriod(\n  db: Database.Database,\n  start: string,\n  end: string,\n): { total: number; count: number } {\n  const stmt = db.prepare(`\n    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n    FROM invoices\n    WHERE date >= ? AND date <= ?\n  `);\n\n  const result = stmt.get(start, end) as { total: number; count: number };\n  return {\n    total: Math.round(result.total * 100) / 100,\n    count: result.count,\n  };\n}\n","numLines":96,"startLine":1,"totalLines":96}}}
