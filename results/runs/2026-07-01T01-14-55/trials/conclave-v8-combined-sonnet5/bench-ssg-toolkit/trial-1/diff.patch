@@ -0,0 +1,52 @@
+import { marked } from 'marked';
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function extractFootnotes(markdown: string): { content: string; footnotes: Map<string, string> } {
+  const footnotes = new Map<string, string>();
+  const defRegex = /^\[\^(\w+)\]:\s*(.+)$/gm;
+  const content = markdown.replace(defRegex, (_match, id: string, text: string) => {
+    footnotes.set(id, text.trim());
+    return '';
+  });
+  return { content, footnotes };
+}
+
+function convertAdmonitions(markdown: string): string {
+  const regex = /:::(note|warning|tip)\n([\s\S]*?)\n:::/g;
+  return markdown.replace(regex, (_match, type: string, inner: string) => {
+    return `<div class="admonition admonition-${type}">\n\n${inner.trim()}\n\n</div>`;
+  });
+}
+
+function applyFootnoteRefs(html: string, footnotes: Map<string, string>): string {
+  return html.replace(/\[\^(\w+)\]/g, (match, id: string) => {
+    if (!footnotes.has(id)) return match;
+    return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+  });
+}
+
+function renderFootnoteSection(footnotes: Map<string, string>): string {
+  if (footnotes.size === 0) return '';
+  const items = Array.from(footnotes.entries())
+    .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+    .join('\n');
+  return `\n<section class="footnotes">\n<ol>\n${items}\n</ol>\n</section>`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: async (file: ContentFile, _ctx: BuildContext) => {
+        const { content: withoutFootnotes, footnotes } = extractFootnotes(file.content);
+        const withAdmonitions = convertAdmonitions(withoutFootnotes);
+        let html = await marked.parse(withAdmonitions);
+        html = applyFootnoteRefs(html, footnotes);
+        html += renderFootnoteSection(footnotes);
+        return { ...file, content: html };
+      },
+    },
+  };
+}
diff --git a/src/plugins/rss-feed.ts b/src/plugins/rss-feed.ts
new file mode 100644
index 0000000..2cbec43
--- /dev/null
+++ b/src/plugins/rss-feed.ts
@@ -0,0 +1,54 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(str: string): string {
+  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
+}
+
+function toRfc822(date?: string): string | undefined {
+  if (!date) return undefined;
+  const parsed = new Date(date);
+  if (isNaN(parsed.getTime())) return undefined;
+  return parsed.toUTCString();
+}
+
+function renderItem(file: ContentFile, baseUrl: string): string {
+  const link = `${baseUrl}/${file.slug}.html`;
+  const pubDate = toRfc822(file.date);
+  const categories = (file.tags ?? []).map((tag) => `<category>${escapeXml(tag)}</category>`).join('\n      ');
+  return `    <item>
+      <title>${escapeXml(file.title)}</title>
+      <link>${link}</link>
+      <guid>${link}</guid>
+      ${pubDate ? `<pubDate>${pubDate}</pubDate>` : ''}
+      ${categories}
+      <description><![CDATA[${file.content}]]></description>
+    </item>`;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const sorted = [...ctx.files].sort((a, b) => {
+          const dateA = a.date ? new Date(a.date).getTime() : 0;
+          const dateB = b.date ? new Date(b.date).getTime() : 0;
+          return dateB - dateA;
+        });
+        const items = sorted.map((file) => renderItem(file, ctx.config.baseUrl)).join('\n');
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<rss version="2.0">
+  <channel>
+    <title>${escapeXml(ctx.config.title)}</title>
+    <link>${ctx.config.baseUrl}</link>
+    <description>${escapeXml(ctx.config.title)}</description>
+${items}
+  </channel>
+</rss>`;
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
