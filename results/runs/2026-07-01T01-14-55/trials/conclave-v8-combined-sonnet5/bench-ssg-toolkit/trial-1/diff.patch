@@ -0,0 +1,34 @@
+import { BuildContext, Plugin } from '../core/types.js';
+
+function stripHtml(html: string): string {
+  return html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
+}
+
+interface SearchIndexEntry {
+  slug: string;
+  title: string;
+  content: string;
+  tags?: string[];
+}
+
+export function createSearchIndexPlugin(): Plugin {
+  return {
+    name: 'search-index',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'syntax-highlight'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const index: SearchIndexEntry[] = ctx.files.map((file) => {
+          const entry: SearchIndexEntry = {
+            slug: file.slug,
+            title: file.title,
+            content: stripHtml(file.content),
+          };
+          if (file.tags) entry.tags = file.tags;
+          return entry;
+        });
+        ctx.output.set('search-index.json', JSON.stringify(index));
+      },
+    },
+  };
+}
