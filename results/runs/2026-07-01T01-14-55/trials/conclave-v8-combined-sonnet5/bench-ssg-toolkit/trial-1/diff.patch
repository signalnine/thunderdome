+import { BuildContext, Plugin } from '../core/types.js';
+
+export function createSitemapPlugin(): Plugin {
+  return {
+    name: 'sitemap',
+    version: '1.0.0',
+    dependencies: ['taxonomy', 'rss-feed'],
+    hooks: {
+      afterBuild: (ctx: BuildContext) => {
+        const urls: string[] = [];
+        for (const key of ctx.output.keys()) {
+          if (key.endsWith('.html') || key === 'feed.xml') {
+            urls.push(`${ctx.config.baseUrl}/${key}`);
+          }
+        }
+        const urlEntries = urls.map((url) => `  <url>\n    <loc>${url}</loc>\n  </url>`).join('\n');
+        const xml = `<?xml version="1.0" encoding="UTF-8"?>
+<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
+${urlEntries}
+</urlset>`;
+        ctx.output.set('sitemap.xml', xml);
+      },
+    },
+  };
+}
