diff --git a/src/plugins/asset-pipeline.ts b/src/plugins/asset-pipeline.ts
new file mode 100644
index 0000000..a65d27b
--- /dev/null
+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,26 @@
+import { BuildContext, ContentFile, Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+const ASSET_REF_REGEX = /(src|href)="\.\/([^"]+)"/g;
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file: ContentFile, ctx: BuildContext) => {
+        const manifest = (ctx.data.get('asset-manifest') as AssetManifest | undefined) ?? { assets: [] };
+        const content = file.content.replace(ASSET_REF_REGEX, (_match, attr: string, path: string) => {
+          manifest.assets.push(path);
+          return `${attr}="/assets/${path}"`;
+        });
+        ctx.data.set('asset-manifest', manifest);
+        return { ...file, content };
+      },
+    },
+  };
+}
