@@ -0,0 +1,36 @@
+import { Plugin } from '../core/types.js';
+
+const ASSET_ATTR_RE = /(src|href)="([^"]+)"/g;
+
+function isRewritable(url: string): boolean {
+  if (url.startsWith('/') || url.startsWith('#')) return false;
+  if (/^[a-z][a-z0-9+.-]*:/i.test(url)) return false;
+  return true;
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file, ctx) => {
+        const existing = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        const assets = new Set(existing?.assets ?? []);
+
+        const content = file.content.replace(ASSET_ATTR_RE, (match, attr: string, url: string) => {
+          if (!isRewritable(url)) {
+            return match;
+          }
+          const filename = url.split('/').pop() || url;
+          assets.add(filename);
+          return `${attr}="/assets/${filename}"`;
+        });
+
+        ctx.data.set('asset-manifest', { assets: Array.from(assets) });
+
+        return { ...file, content };
+      },
+    },
+  };
+}
