+import { marked } from 'marked';
+import { Plugin } from '../core/types.js';
+
+const FOOTNOTE_DEF_RE = /^\[\^([^\]]+)\]:\s*(.+)$/gm;
+const FOOTNOTE_REF_RE = /\[\^([^\]]+)\]/g;
+const ADMONITION_RE = /:::(\w+)\n([\s\S]*?)\n:::/g;
+
+function renderMarkdown(md: string): string {
+  return marked(md, { async: false });
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        let source = file.content;
+
+        const footnotes: Array<{ id: string; text: string }> = [];
+        source = source.replace(FOOTNOTE_DEF_RE, (_match, id: string, text: string) => {
+          footnotes.push({ id, text: text.trim() });
+          return '';
+        });
+
+        const admonitions: string[] = [];
+        source = source.replace(ADMONITION_RE, (_match, type: string, body: string) => {
+          const placeholder = `@@ADMONITION_${admonitions.length}@@`;
+          admonitions.push(
+            `<div class="admonition admonition-${type}">${renderMarkdown(body.trim())}</div>`
+          );
+          return placeholder;
+        });
+
+        let html = renderMarkdown(source);
+
+        admonitions.forEach((div, index) => {
+          const placeholder = `@@ADMONITION_${index}@@`;
+          html = html
+            .replace(`<p>${placeholder}</p>`, div)
+            .replace(placeholder, div);
+        });
+
+        html = html.replace(FOOTNOTE_REF_RE, (_match, id: string) => {
+          return `<sup><a href="#fn-${id}">${id}</a></sup>`;
+        });
+
+        if (footnotes.length > 0) {
+          const items = footnotes
+            .map((fn) => `<li id="fn-${fn.id}">${fn.text}</li>`)
+            .join('');
+          html += `<section class="footnotes"><ol>${items}</ol></section>`;
+        }
+
+        return { ...file, content: html };
+      },
+    },
+  };
+}
