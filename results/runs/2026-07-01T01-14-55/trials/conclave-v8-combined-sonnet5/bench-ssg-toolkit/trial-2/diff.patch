+import { Plugin } from '../core/types.js';
+
+export function createDevServerPlugin(): Plugin {
+  return {
+    name: 'dev-server',
+    version: '1.0.0',
+    dependencies: ['asset-pipeline', 'search-index'],
+    hooks: {
+      afterBuild: (ctx) => {
+        const assetManifest = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+        const assetPaths = assetManifest?.assets ?? [];
+
+        const routes: Array<{ path: string; handler: string }> = assetPaths.map((path) => ({
+          path: `/assets/${path}`,
+          handler: 'asset',
+        }));
+
+        for (const key of ctx.output.keys()) {
+          if (key.endsWith('.html')) {
+            routes.push({ path: `/${key}`, handler: 'static' });
+          }
+        }
+
+        const searchIndexPath = ctx.output.has('search-index.json') ? '/search-index.json' : '';
+
+        ctx.data.set('dev-server-config', {
+          port: 3000,
+          routes,
+          assetPaths,
+          searchIndexPath,
+        });
+      },
+    },
+  };
+}
