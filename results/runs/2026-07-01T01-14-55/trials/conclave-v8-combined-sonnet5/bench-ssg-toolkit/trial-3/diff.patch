--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,50 @@
+import { marked } from 'marked';
+import { Plugin } from '../core/types.js';
+
+function extractFootnotes(content: string): { content: string; footnotes: Map<string, string> } {
+  const footnotes = new Map<string, string>();
+  const withoutDefs = content.replace(/^\[\^(\w+)\]:\s*(.+)$/gm, (_match, id: string, text: string) => {
+    footnotes.set(id, text.trim());
+    return '';
+  });
+  return { content: withoutDefs, footnotes };
+}
+
+function replaceFootnoteRefs(content: string): string {
+  return content.replace(/\[\^(\w+)\]/g, (_match, id: string) => `<sup><a href="#fn-${id}">${id}</a></sup>`);
+}
+
+function replaceAdmonitions(content: string): string {
+  return content.replace(/:::(\w+)\n([\s\S]*?)\n:::/g, (_match, type: string, body: string) => {
+    return `<div class="admonition admonition-${type}">\n${body}\n</div>`;
+  });
+}
+
+function renderFootnoteSection(footnotes: Map<string, string>): string {
+  if (footnotes.size === 0) return '';
+  const items = Array.from(footnotes.entries())
+    .map(([id, text]) => `<li id="fn-${id}">${text}</li>`)
+    .join('');
+  return `<section class="footnotes"><ol>${items}</ol></section>`;
+}
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        const { content: withoutDefs, footnotes } = extractFootnotes(file.content);
+        const withRefs = replaceFootnoteRefs(withoutDefs);
+        const withAdmonitions = replaceAdmonitions(withRefs);
+        const html = marked.parse(withAdmonitions, { async: false });
+        const footnoteSection = renderFootnoteSection(footnotes);
+        return {
+          ...file,
+          content: footnoteSection ? `${html}${footnoteSection}` : html,
+        };
+      },
+    },
+  };
+}
