+import { Plugin } from '../core/types.js';
+
+interface AssetManifest {
+  assets: string[];
+}
+
+function isRelativeAssetUrl(url: string): boolean {
+  if (/^[a-z][a-z0-9+.-]*:/i.test(url)) return false; // scheme URL (http:, https:, data:, etc.)
+  if (url.startsWith('//')) return false; // protocol-relative
+  if (url.startsWith('/')) return false; // already root-relative
+  if (url.startsWith('#')) return false;
+  return true;
+}
+
+function getManifest(data: Map<string, unknown>): AssetManifest {
+  let manifest = data.get('asset-manifest') as AssetManifest | undefined;
+  if (!manifest) {
+    manifest = { assets: [] };
+    data.set('asset-manifest', manifest);
+  }
+  return manifest;
+}
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file, ctx) => {
+        const manifest = getManifest(ctx.data);
+        const content = file.content.replace(/(src|href)="([^"]+)"/g, (match, attr: string, url: string) => {
+          if (!isRelativeAssetUrl(url)) return match;
+          const assetPath = url.replace(/^\.\//, '');
+          if (!manifest.assets.includes(assetPath)) {
+            manifest.assets.push(assetPath);
+          }
+          return `${attr}="/assets/${assetPath}"`;
+        });
+        return { ...file, content };
+      },
+    },
+  };
+}
