+import { Plugin } from '../core/types.js';
+
+const CODE_BLOCK_REGEX = /<pre><code class="language-([\w-]+)">([\s\S]*?)<\/code><\/pre>/g;
+
+export function createSyntaxHighlightPlugin(): Plugin {
+  return {
+    name: 'syntax-highlight',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent: (file) => {
+        const content = file.content.replace(CODE_BLOCK_REGEX, (_match, lang: string, code: string) => {
+          return `<pre data-language="${lang}"><code class="language-${lang} highlighted">${code}</code></pre>`;
+        });
+        return { ...file, content };
+      },
+    },
+  };
+}
