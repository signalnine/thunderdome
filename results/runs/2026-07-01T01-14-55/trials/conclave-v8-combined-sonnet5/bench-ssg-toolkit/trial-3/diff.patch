@@ -0,0 +1,37 @@
+import { ContentFile, Plugin } from '../core/types.js';
+
+function escapeXml(text: string): string {
+  return text
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+function fileDate(file: ContentFile): number {
+  return file.date ? new Date(file.date).getTime() : 0;
+}
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild: (ctx) => {
+        const files = [...ctx.files].sort((a, b) => fileDate(b) - fileDate(a));
+        const items = files
+          .map((file) => {
+            const link = `${ctx.config.baseUrl}/${file.slug}.html`;
+            const pubDate = file.date ? `<pubDate>${new Date(file.date).toUTCString()}</pubDate>` : '';
+            const categories = (file.tags || []).map((tag) => `<category>${escapeXml(tag)}</category>`).join('');
+            return `<item><title>${escapeXml(file.title)}</title><link>${link}</link><guid>${link}</guid>${pubDate}${categories}<description><![CDATA[${file.content}]]></description></item>`;
+          })
+          .join('');
+        const xml = `<?xml version="1.0" encoding="UTF-8"?><rss version="2.0"><channel><title>${escapeXml(
+          ctx.config.title
+        )}</title><link>${ctx.config.baseUrl}</link>${items}</channel></rss>`;
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
