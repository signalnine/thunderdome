@@ -0,0 +1,140 @@
+import { WebSocketServer, WebSocket } from 'ws';
+import type { Server } from 'node:http';
+import type Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation, DocumentRecord } from './models.js';
+
+interface Room {
+  docId: string;
+  content: string;
+  version: number;
+  clients: Set<WebSocket>;
+  /** history[v] is the operation that transformed version v into version v+1. */
+  history: Operation[];
+}
+
+interface IncomingMessage {
+  type?: unknown;
+  operation?: unknown;
+  version?: unknown;
+}
+
+function send(ws: WebSocket, msg: unknown): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(msg));
+  }
+}
+
+export function attachWebSocketServer(server: Server, db: Database.Database): WebSocketServer {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Room>();
+
+  function loadRoom(docId: string): Room | null {
+    const existing = rooms.get(docId);
+    if (existing) return existing;
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as DocumentRecord | undefined;
+    if (!doc) return null;
+
+    const latest = db.prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?').get(docId) as {
+      v: number | null;
+    };
+
+    const room: Room = {
+      docId,
+      content: doc.content,
+      version: latest.v ?? 0,
+      clients: new Set(),
+      history: [],
+    };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  wss.on('connection', (ws, req) => {
+    const url = new URL(req.url ?? '/', 'http://localhost');
+    const docId = decodeURIComponent(url.pathname.replace(/^\//, ''));
+
+    const room = loadRoom(docId);
+    if (!room) {
+      send(ws, { type: 'error', message: `Document not found: ${docId}` });
+      ws.close();
+      return;
+    }
+
+    room.clients.add(ws);
+    const connectionId = randomUUID();
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      let parsed: IncomingMessage;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Malformed JSON' });
+        return;
+      }
+
+      if (parsed.type !== 'operation') {
+        send(ws, { type: 'error', message: `Unknown message type: ${String(parsed.type)}` });
+        return;
+      }
+
+      const rawOp = parsed.operation;
+      try {
+        validateOperation(rawOp, room.content.length);
+      } catch (err) {
+        send(ws, { type: 'error', message: err instanceof Error ? err.message : 'Invalid operation' });
+        return;
+      }
+
+      let op = rawOp as Operation;
+      const baseVersion = typeof parsed.version === 'number' ? parsed.version : room.version;
+      const startIdx = Math.max(0, Math.min(baseVersion, room.version));
+      for (let v = startIdx; v < room.version; v++) {
+        op = transformOperation(op, room.history[v]);
+      }
+
+      try {
+        validateOperation(op, room.content.length);
+      } catch (err) {
+        send(ws, { type: 'error', message: err instanceof Error ? err.message : 'Invalid operation' });
+        return;
+      }
+
+      const newContent = applyOperation(room.content, op);
+      room.version += 1;
+      room.history[room.version - 1] = op;
+      room.content = newContent;
+
+      db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)').run(
+        docId,
+        room.version,
+        newContent,
+        JSON.stringify(op)
+      );
+      db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        newContent,
+        docId
+      );
+
+      send(ws, { type: 'ack', version: room.version });
+
+      for (const client of room.clients) {
+        if (client !== ws) {
+          send(client, { type: 'operation', operation: op, version: room.version });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  });
+
+  return wss;
+}
