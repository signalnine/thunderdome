ing' ? req.body.content : doc.content;\n\n    db.prepare(\"UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?\").run(\n      title,\n      content,\n      req.params.id\n    );\n\n    const updated = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);\n    res.json(updated);\n  });\n\n  router.delete('/docs/:id', (req, res) => {\n    const result = db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);\n    if (result.changes === 0) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    res.status(204).send();\n  });\n\n  router.get('/docs/:id/versions', (req, res) => {\n    const doc = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);\n    if (!doc) {\n      res.status(404).json({ error: 'Document not found' });\n      return;\n    }\n    const versions = db.prepare('SELECT * FROM versions WHERE document_id = ? ORDER BY version').all(req.params.id);\n    res.json(versions);\n  });\n\n  router.get('/docs/:id/versions/:version', (req, res) => {\n    const versionNum = Number(req.params.version);\n    const version = db\n      .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')\n      .get(req.params.id, versionNum) as VersionRecord | undefined;\n    if (!version) {\n      res.status(404).json({ error: 'Version not found' });\n      return;\n    }\n    res.json(version);\n  });\n\n  return router;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":367,"cache_read_input_tokens":72005,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":367},"output_tokens":59,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3e4e24be-1ffc-45fe-81da-7a18a6d1f729","uuid":"886e8c43-c1f6-4b09-8a73-8c1832edf897","request_id":"req_