+import type { Operation } from './models.js';
+
+/** Apply an operation to document content, producing the new content. */
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/**
+ * Validate that `op` is a well-formed operation whose bounds fit within a
+ * document of length `contentLength`. Throws a descriptive Error if not.
+ */
+export function validateOperation(op: unknown, contentLength: number): asserts op is Operation {
+  if (typeof op !== 'object' || op === null) {
+    throw new Error('Invalid operation: expected an object');
+  }
+  const o = op as Record<string, unknown>;
+
+  if (o.type !== 'insert' && o.type !== 'delete') {
+    throw new Error(`Invalid operation type: ${String(o.type)}`);
+  }
+
+  if (typeof o.position !== 'number' || !Number.isInteger(o.position) || o.position < 0) {
+    throw new Error('Invalid operation: position must be a non-negative integer');
+  }
+
+  if (o.type === 'insert') {
+    if (typeof o.text !== 'string') {
+      throw new Error('Invalid insert operation: text must be a string');
+    }
+    if (o.position > contentLength) {
+      throw new Error('Invalid insert operation: position out of bounds');
+    }
+    return;
+  }
+
+  if (typeof o.count !== 'number' || !Number.isInteger(o.count) || o.count <= 0) {
+    throw new Error('Invalid delete operation: count must be a positive integer');
+  }
+  if (o.position + o.count > contentLength) {
+    throw new Error('Invalid delete operation: range out of bounds');
+  }
+}
+
+/**
+ * Transform `op1` so it can be applied to a document that already has `op2`
+ * applied to it, where both operations were originally computed against the
+ * same base document state. Ties (identical insert positions) push `op1`
+ * after `op2` so both edits are deterministically preserved.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op2.type === 'insert' && op1.type === 'insert') {
+    if (op1.position >= op2.position) {
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    return { ...op1 };
+  }
+
+  if (op2.type === 'insert' && op1.type === 'delete') {
+    const insertPos = op2.position;
+    const delStart = op1.position;
+    const delEnd = op1.position + op1.count;
+    if (insertPos <= delStart) {
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    if (insertPos >= delEnd) {
+      return { ...op1 };
+    }
+    return { ...op1, count: op1.count + op2.text.length };
+  }
+
+  if (op2.type === 'delete' && op1.type === 'insert') {
+    const delStart = op2.position;
+    const delEnd = op2.position + op2.count;
+    if (op1.position <= delStart) {
+      return { ...op1 };
+    }
+    if (op1.position >= delEnd) {
+      return { ...op1, position: op1.position - op2.count };
+    }
+    return { ...op1, position: delStart };
+  }
+
+  // op1: delete, op2: delete
+  const a = op1 as { type: 'delete'; position: number; count: number };
+  const b = op2 as { type: 'delete'; position: number; count: number };
+  const aStart = a.position;
+  const aEnd = a.position + a.count;
+  const bStart = b.position;
+  const bEnd = b.position + b.count;
+
+  if (aEnd <= bStart) {
+    return { ...a };
+  }
+  if (aStart >= bEnd) {
+    return { ...a, position: aStart - b.count };
+  }
+
+  const overlapStart = Math.max(aStart, bStart);
+  const overlapEnd = Math.min(aEnd, bEnd);
+  const overlap = Math.max(0, overlapEnd - overlapStart);
+  const newPosition = aStart <= bStart ? aStart : bStart;
+  const newCount = Math.max(0, a.count - overlap);
+  return { type: 'delete', position: newPosition, count: newCount };
+}
