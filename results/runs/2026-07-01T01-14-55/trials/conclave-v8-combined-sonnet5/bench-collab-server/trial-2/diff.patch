@@ -0,0 +1,64 @@
+import type { Operation } from './models.js';
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+export function validateOperation(op: unknown, contentLength: number): op is Operation {
+  if (typeof op !== 'object' || op === null) return false;
+  const o = op as Record<string, unknown>;
+
+  if (typeof o.position !== 'number' || !Number.isInteger(o.position) || o.position < 0) {
+    return false;
+  }
+
+  if (o.type === 'insert') {
+    if (typeof o.text !== 'string') return false;
+    return o.position <= contentLength;
+  }
+
+  if (o.type === 'delete') {
+    if (typeof o.count !== 'number' || !Number.isInteger(o.count) || o.count < 0) return false;
+    return o.position + o.count <= contentLength;
+  }
+
+  return false;
+}
+
+function mapPosAfterDelete(pos: number, deletePosition: number, deleteCount: number): number {
+  if (pos <= deletePosition) return pos;
+  if (pos <= deletePosition + deleteCount) return deletePosition;
+  return pos - deleteCount;
+}
+
+/** Transform op1 so it can be applied after op2 has already been applied. */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert') {
+    if (op2.type === 'insert') {
+      const position = op1.position < op2.position ? op1.position : op1.position + op2.text.length;
+      return { ...op1, position };
+    }
+    return { ...op1, position: mapPosAfterDelete(op1.position, op2.position, op2.count) };
+  }
+
+  // op1.type === 'delete'
+  if (op2.type === 'insert') {
+    const deleteEnd = op1.position + op1.count;
+    if (op2.position <= op1.position) {
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    if (op2.position >= deleteEnd) {
+      return op1;
+    }
+    // Insertion landed inside the deleted range - extend the delete to cover it too.
+    return { ...op1, count: op1.count + op2.text.length };
+  }
+
+  // op2.type === 'delete'
+  const newStart = mapPosAfterDelete(op1.position, op2.position, op2.count);
+  const newEnd = mapPosAfterDelete(op1.position + op1.count, op2.position, op2.count);
+  return { type: 'delete', position: newStart, count: Math.max(0, newEnd - newStart) };
+}
