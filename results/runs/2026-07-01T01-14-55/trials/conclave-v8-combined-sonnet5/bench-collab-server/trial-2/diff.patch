+import { WebSocketServer, WebSocket } from 'ws';
+import type { Server } from 'node:http';
+import type Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Operation } from './models.js';
+
+interface Room {
+  content: string;
+  version: number;
+  history: Operation[];
+  clients: Set<WebSocket>;
+}
+
+export interface RoomManager {
+  documentDeleted(docId: string): void;
+}
+
+export interface WsAttachment {
+  wss: WebSocketServer;
+  roomManager: RoomManager;
+}
+
+function send(ws: WebSocket, msg: Record<string, unknown>): void {
+  if (ws.readyState === WebSocket.OPEN) {
+    ws.send(JSON.stringify(msg));
+  }
+}
+
+export function attachWebSocketServer(server: Server, db: Database.Database): WsAttachment {
+  const wss = new WebSocketServer({ server });
+  const rooms = new Map<string, Room>();
+
+  function loadRoom(docId: string): Room | null {
+    const existing = rooms.get(docId);
+    if (existing) return existing;
+
+    const doc = db.prepare('SELECT content FROM documents WHERE id = ?').get(docId) as
+      | { content: string }
+      | undefined;
+    if (!doc) return null;
+
+    const versionRow = db
+      .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')
+      .get(docId) as { v: number | null };
+
+    const room: Room = {
+      content: doc.content,
+      version: versionRow.v ?? 0,
+      history: [],
+      clients: new Set(),
+    };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  wss.on('connection', (ws, req) => {
+    const docId = decodeURIComponent((req.url ?? '/').split('?')[0].replace(/^\//, ''));
+
+    const docExists = db.prepare('SELECT id FROM documents WHERE id = ?').get(docId);
+    if (!docExists) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+
+    const room = loadRoom(docId);
+    if (!room) {
+      send(ws, { type: 'error', message: 'Document not found' });
+      ws.close();
+      return;
+    }
+
+    room.clients.add(ws);
+    const connectionId = randomUUID();
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    send(ws, { type: 'sync', content: room.content, version: room.version });
+
+    ws.on('message', (data) => {
+      let parsed: unknown;
+      try {
+        parsed = JSON.parse(data.toString());
+      } catch {
+        send(ws, { type: 'error', message: 'Malformed JSON' });
+        return;
+      }
+
+      if (
+        typeof parsed !== 'object' ||
+        parsed === null ||
+        (parsed as Record<string, unknown>).type !== 'operation'
+      ) {
+        send(ws, { type: 'error', message: 'Invalid message' });
+        return;
+      }
+
+      const msg = parsed as { type: 'operation'; operation: unknown; version?: number };
+      const rawOp = msg.operation;
+
+      if (!validateOperation(rawOp, Infinity)) {
+        send(ws, { type: 'error', message: 'Invalid operation' });
+        return;
+      }
+
+      let op: Operation = rawOp;
+      let baseVersion = typeof msg.version === 'number' ? msg.version : room.version;
+      if (baseVersion < 0) baseVersion = 0;
+      if (baseVersion > room.version) baseVersion = room.version;
+
+      const concurrentOps = room.history.slice(baseVersion);
+      for (const priorOp of concurrentOps) {
+        op = transformOperation(op, priorOp);
+      }
+
+      if (!validateOperation(op, room.content.length)) {
+        send(ws, { type: 'error', message: 'Operation out of bounds' });
+        return;
+      }
+
+      room.content = applyOperation(room.content, op);
+      room.history.push(op);
+      room.version += 1;
+
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)'
+      ).run(docId, room.version, room.content, JSON.stringify(op));
+      db.prepare("UPDATE documents SET content = ?, updated_at = datetime('now') WHERE id = ?").run(
+        room.content,
+        docId
+      );
+
+      send(ws, { type: 'ack', version: room.version });
+
+      for (const client of room.clients) {
+        if (client !== ws) {
+          send(client, { type: 'operation', operation: op, version: room.version });
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  });
+
+  const roomManager: RoomManager = {
+    documentDeleted(docId: string) {
+      const room = rooms.get(docId);
+      if (room) {
+        for (const client of room.clients) {
+          client.close();
+        }
+        rooms.delete(docId);
+      }
+    },
+  };
+
+  return { wss, roomManager };
+}
