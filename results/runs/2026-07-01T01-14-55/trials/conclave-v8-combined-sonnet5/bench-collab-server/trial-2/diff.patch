+import { Router } from 'express';
+import type Database from 'better-sqlite3';
+import { randomUUID } from 'node:crypto';
+import type { RoomManager } from './ws.js';
+import type { Document } from './models.js';
+
+export function createRoutes(db: Database.Database, roomManager: RoomManager): Router {
+  const router = Router();
+
+  router.post('/', (req, res) => {
+    const { title, content } = req.body ?? {};
+    if (typeof title !== 'string' || title.trim().length === 0) {
+      res.status(400).json({ error: 'title is required' });
+      return;
+    }
+
+    const id = randomUUID();
+    const docContent = typeof content === 'string' ? content : '';
+
+    db.prepare('INSERT INTO documents (id, title, content) VALUES (?, ?, ?)').run(id, title, docContent);
+    db.prepare('INSERT INTO versions (document_id, version, content, operation) VALUES (?, 0, ?, NULL)').run(
+      id,
+      docContent
+    );
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(id);
+    res.status(201).json(doc);
+  });
+
+  router.get('/', (_req, res) => {
+    const docs = db.prepare('SELECT * FROM documents ORDER BY created_at').all();
+    res.json(docs);
+  });
+
+  router.get('/:id', (req, res) => {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  router.put('/:id', (req, res) => {
+    const existing = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id) as
+      | Document
+      | undefined;
+    if (!existing) {
+      res.status(404).json({ error: 'not found' });
+      return;
+    }
+
+    const { title, content } = req.body ?? {};
+    const newTitle = typeof title === 'string' ? title : existing.title;
+    const newContent = typeof content === 'string' ? content : existing.content;
+
+    db.prepare("UPDATE documents SET title = ?, content = ?, updated_at = datetime('now') WHERE id = ?").run(
+      newTitle,
+      newContent,
+      req.params.id
+    );
+
+    if (typeof content === 'string' && content !== existing.content) {
+      const maxVersion = db
+        .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')
+        .get(req.params.id) as { v: number };
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, NULL)'
+      ).run(req.params.id, maxVersion.v + 1, newContent);
+    }
+
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(req.params.id);
+    res.json(doc);
+  });
+
+  router.delete('/:id', (req, res) => {
+    const existing = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!existing) {
+      res.status(404).json({ error: 'not found' });
+      return;
+    }
+    db.prepare('DELETE FROM documents WHERE id = ?').run(req.params.id);
+    roomManager.documentDeleted(req.params.id);
+    res.status(204).send();
+  });
+
+  router.get('/:id/versions', (req, res) => {
+    const doc = db.prepare('SELECT id FROM documents WHERE id = ?').get(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'not found' });
+      return;
+    }
+    const versions = db
+      .prepare(
+        'SELECT id, document_id, version, operation, created_at FROM versions WHERE document_id = ? ORDER BY version'
+      )
+      .all(req.params.id);
+    res.json(versions);
+  });
+
+  router.get('/:id/versions/:version', (req, res) => {
+    const versionNum = Number(req.params.version);
+    if (!Number.isInteger(versionNum)) {
+      res.status(400).json({ error: 'invalid version' });
+      return;
+    }
+    const row = db
+      .prepare('SELECT * FROM versions WHERE document_id = ? AND version = ?')
+      .get(req.params.id, versionNum);
+    if (!row) {
+      res.status(404).json({ error: 'not found' });
+      return;
+    }
+    res.json(row);
+  });
+
+  return router;
+}
