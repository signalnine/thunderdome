@@ -0,0 +1,55 @@
+import express, { type Express } from 'express';
+import http from 'node:http';
+import type { WebSocketServer } from 'ws';
+import type Database from 'better-sqlite3';
+import { createDb } from './db.js';
+import { createRoutes } from './routes.js';
+import { attachWebSocketServer } from './ws.js';
+
+export interface AppInstance {
+  app: Express;
+  server: http.Server;
+  wss: WebSocketServer;
+  db: Database.Database;
+  start: (port?: number) => Promise<number>;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath = ':memory:'): AppInstance {
+  const db = createDb(dbPath);
+  const app = express();
+  app.use(express.json());
+
+  const server = http.createServer(app);
+  const { wss, roomManager } = attachWebSocketServer(server, db);
+
+  app.use('/docs', createRoutes(db, roomManager));
+
+  const start = (port = 0): Promise<number> => {
+    return new Promise((resolve, reject) => {
+      server.once('error', reject);
+      server.listen(port, () => {
+        const addr = server.address();
+        const actualPort = typeof addr === 'object' && addr !== null ? addr.port : port;
+        resolve(actualPort);
+      });
+    });
+  };
+
+  const stop = (): Promise<void> => {
+    return new Promise((resolve) => {
+      for (const client of wss.clients) {
+        client.terminate();
+      }
+      db.prepare('DELETE FROM active_connections').run();
+      wss.close(() => {
+        server.close(() => {
+          db.close();
+          resolve();
+        });
+      });
+    });
+  };
+
+  return { app, server, wss, db, start, stop };
+}
