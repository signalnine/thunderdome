new file mode 100644
index 0000000..1ca4335
--- /dev/null
+++ b/src/ws.ts
@@ -0,0 +1,117 @@
+import { randomUUID } from 'node:crypto';
+import type { Server } from 'node:http';
+import { WebSocket, WebSocketServer } from 'ws';
+import type Database from 'better-sqlite3';
+import { applyOperation, transformOperation, validateOperation } from './ot.js';
+import type { Document, Operation } from './models.js';
+
+interface Room {
+  version: number;
+  history: Operation[];
+  clients: Set<WebSocket>;
+}
+
+function isValidOperationShape(value: unknown): value is Operation {
+  if (!value || typeof value !== 'object') return false;
+  const candidate = value as Record<string, unknown>;
+  if (typeof candidate.position !== 'number') return false;
+  if (candidate.type === 'insert') return typeof candidate.text === 'string';
+  if (candidate.type === 'delete') return typeof candidate.count === 'number';
+  return false;
+}
+
+export function attachWebSocketServer(server: Server, wss: WebSocketServer, db: Database.Database): void {
+  const rooms = new Map<string, Room>();
+
+  function getOrCreateRoom(docId: string): Room {
+    let room = rooms.get(docId);
+    if (room) return room;
+    const maxVersionRow = db
+      .prepare('SELECT MAX(version) as v FROM versions WHERE document_id = ?')
+      .get(docId) as { v: number | null };
+    room = { version: maxVersionRow.v ?? 0, history: [], clients: new Set() };
+    rooms.set(docId, room);
+    return room;
+  }
+
+  function handleConnection(ws: WebSocket, docId: string): void {
+    const doc = db.prepare('SELECT * FROM documents WHERE id = ?').get(docId) as Document | undefined;
+    if (!doc) {
+      ws.send(JSON.stringify({ type: 'error', message: `Document not found: ${docId}` }));
+      ws.close();
+      return;
+    }
+
+    const room = getOrCreateRoom(docId);
+    room.clients.add(ws);
+    const connectionId = randomUUID();
+    db.prepare('INSERT INTO active_connections (id, document_id) VALUES (?, ?)').run(connectionId, docId);
+
+    ws.send(JSON.stringify({ type: 'sync', content: doc.content, version: room.version }));
+
+    ws.on('message', (data) => {
+      let msg: { type?: unknown; operation?: unknown; version?: unknown };
+      try {
+        msg = JSON.parse(data.toString()) as typeof msg;
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' }));
+        return;
+      }
+
+      if (msg.type !== 'operation' || !isValidOperationShape(msg.operation)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid operation' }));
+        return;
+      }
+
+      let op: Operation = msg.operation;
+
+      const currentDoc = db.prepare('SELECT content FROM documents WHERE id = ?').get(docId) as {
+        content: string;
+      };
+      let content = currentDoc.content;
+
+      const baseVersion = typeof msg.version === 'number' ? msg.version : room.version;
+      const startIdx = Math.max(0, Math.min(baseVersion, room.version));
+      for (let v = startIdx; v < room.version; v++) {
+        op = transformOperation(op, room.history[v]);
+      }
+
+      if (!validateOperation(op, content.length)) {
+        ws.send(JSON.stringify({ type: 'error', message: 'Operation out of bounds' }));
+        return;
+      }
+
+      content = applyOperation(content, op);
+      room.version += 1;
+      room.history.push(op);
+
+      const now = new Date().toISOString();
+      db.prepare('UPDATE documents SET content = ?, updated_at = ? WHERE id = ?').run(content, now, docId);
+      db.prepare(
+        'INSERT INTO versions (document_id, version, content, operation, created_at) VALUES (?, ?, ?, ?, ?)'
+      ).run(docId, room.version, content, JSON.stringify(op), now);
+
+      ws.send(JSON.stringify({ type: 'ack', version: room.version }));
+
+      const broadcastMsg = JSON.stringify({ type: 'operation', operation: op, version: room.version });
+      for (const client of room.clients) {
+        if (client !== ws && client.readyState === WebSocket.OPEN) {
+          client.send(broadcastMsg);
+        }
+      }
+    });
+
+    ws.on('close', () => {
+      room.clients.delete(ws);
+      db.prepare('DELETE FROM active_connections WHERE id = ?').run(connectionId);
+    });
+  }
+
+  server.on('upgrade', (req, socket, head) => {
+    const url = new URL(req.url ?? '/', 'http://localhost');
+    const docId = decodeURIComponent(url.pathname.slice(1));
+    wss.handleUpgrade(req, socket, head, (ws) => {
+      handleConnection(ws, docId);
+    });
+  });
+}
