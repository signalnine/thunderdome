docs');\n    const docId = docs.body[0].id;\n    const versions1 = await request(app1.app).get(`/docs/${docId}/versions`);\n\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    await app2.start(0);\n\n    const versions2 = await request(app2.app).get(`/docs/${docId}/versions`);\n    expect(versions2.body.length).toBe(versions1.body.length);\n\n    await app2.stop();\n  });\n\n  it('Active connections cleared on restart', async () => {\n    const app1 = createApp(dbPath);\n    const port1 = await app1.start(0);\n\n    const docs = await request(app1.app).get('/docs');\n    const docId = docs.body[0].id;\n\n    const client = await createWsClient(port1, docId);\n    await waitForMsg(client, 0);\n\n    const connsBefore = app1.db.prepare('SELECT COUNT(*) as cnt FROM active_connections').get() as { cnt: number };\n    expect(connsBefore.cnt).toBeGreaterThan(0);\n\n    await closeClient(client);\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    await app2.start(0);\n\n    const connsAfter = app2.db.prepare('SELECT COUNT(*) as cnt FROM active_connections').get() as { cnt: number };\n    expect(connsAfter.cnt).toBe(0);\n\n    await app2.stop();\n  });\n});\n","numLines":932,"startLine":1,"totalLines":932}}}
