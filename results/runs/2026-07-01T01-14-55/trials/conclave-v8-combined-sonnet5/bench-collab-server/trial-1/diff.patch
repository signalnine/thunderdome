+++ b/src/ot.ts
@@ -0,0 +1,99 @@
+import type { Operation } from './models.js';
+
+export function validateOperation(op: Operation, contentLength: number): boolean {
+  if (!op || typeof op !== 'object') return false;
+
+  if (op.type === 'insert') {
+    return (
+      Number.isInteger(op.position) &&
+      op.position >= 0 &&
+      op.position <= contentLength &&
+      typeof op.text === 'string'
+    );
+  }
+
+  if (op.type === 'delete') {
+    return (
+      Number.isInteger(op.position) &&
+      op.position >= 0 &&
+      Number.isInteger(op.count) &&
+      op.count > 0 &&
+      op.position + op.count <= contentLength
+    );
+  }
+
+  return false;
+}
+
+export function applyOperation(content: string, op: Operation): string {
+  if (op.type === 'insert') {
+    return content.slice(0, op.position) + op.text + content.slice(op.position);
+  }
+  return content.slice(0, op.position) + content.slice(op.position + op.count);
+}
+
+/**
+ * Transform op1 so that it applies correctly to content that already has op2 applied.
+ * op2 is assumed to have been applied to the document before op1.
+ */
+export function transformOperation(op1: Operation, op2: Operation): Operation {
+  if (op1.type === 'insert') {
+    if (op2.type === 'insert') {
+      if (op2.position <= op1.position) {
+        return { ...op1, position: op1.position + op2.text.length };
+      }
+      return op1;
+    }
+
+    // op2 is a delete
+    if (op1.position <= op2.position) {
+      return op1;
+    }
+    if (op1.position >= op2.position + op2.count) {
+      return { ...op1, position: op1.position - op2.count };
+    }
+    return { ...op1, position: op2.position };
+  }
+
+  // op1 is a delete
+  if (op2.type === 'insert') {
+    if (op2.position <= op1.position) {
+      return { ...op1, position: op1.position + op2.text.length };
+    }
+    if (op2.position >= op1.position + op1.count) {
+      return op1;
+    }
+    // The insert landed inside op1's delete range: widen the delete to also
+    // remove the newly inserted text so the deletion's intent is preserved.
+    return { ...op1, count: op1.count + op2.text.length };
+  }
+
+  // op2 is a delete
+  const d1Start = op1.position;
+  const d1End = op1.position + op1.count;
+  const d2Start = op2.position;
+  const d2End = op2.position + op2.count;
+
+  if (d1Start >= d2End) {
+    return { ...op1, position: op1.position - op2.count };
+  }
+  if (d1End <= d2Start) {
+    return op1;
+  }
+
+  const overlapStart = Math.max(d1Start, d2Start);
+  const overlapEnd = Math.min(d1End, d2End);
+  const overlapLen = Math.max(0, overlapEnd - overlapStart);
+  const remainingCount = Math.max(0, op1.count - overlapLen);
+
+  let newPosition: number;
+  if (d1Start < d2Start) {
+    newPosition = d1Start;
+  } else if (d1Start >= d2End) {
+    newPosition = d1Start - op2.count;
+  } else {
+    newPosition = d2Start;
+  }
+
+  return { ...op1, position: newPosition, count: remainingCount };
+}
