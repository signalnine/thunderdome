tores tag map in ctx.data', async () => {\n    97→    const files = [\n    98→      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['alpha'] }),\n    99→    ];\n   100→    const ctx = makeCtx(files);\n   101→    await plugin.hooks.beforeBuild!(ctx);\n   102→    expect(ctx.data.has('taxonomy-tags')).toBe(true);\n   103→  });\n   104→\n   105→  it('handles empty file list', async () => {\n   106→    const ctx = makeCtx([]);\n   107→    await plugin.hooks.beforeBuild!(ctx);\n   108→    await plugin.hooks.afterBuild!(ctx);\n   109→    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n   110→    expect(tagMap.size).toBe(0);\n   111→  });\n   112→\n   113→  it('tags are case-normalized to lowercase', async () => {\n   114→    const files = [\n   115→      makeFile({ slug: 'post-1', title: 'Post 1', tags: ['JavaScript'] }),\n   116→      makeFile({ slug: 'post-2', title: 'Post 2', tags: ['JAVASCRIPT'] }),\n   117→    ];\n   118→    const ctx = makeCtx(files);\n   119→    await plugin.hooks.beforeBuild!(ctx);\n   120→    const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]>;\n   121→    expect(tagMap.has('javascript')).toBe(true);\n   122→    expect(tagMap.get('javascript')).toHaveLength(2);\n   123→    expect(tagMap.has('JavaScript')).toBe(false);\n   124→    expect(tagMap.has('JAVASCRIPT')).toBe(false);\n   125→  });\n   126→});\n   127→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"chatcmpl-tool-8d970cfb0b8866d7","session_id":"4749bb77-0a2a-4de5-8761-981132f57a64","uuid":"eb35725b-cf6c-4ee9-ac08-4b518e3173f9"}
+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-8d970cfb0b8866d7","type":"tool_result","content":[{"type":"text","text":"Here is the complete codebase analysis.\n\n---\n\n## 1. Full Directory Structure\n\n```\n/workspace/\n├── .eslintrc.cjs\n├── .gitignore\n├── TASK.md\n├── package.json\n├── package-lock.json\n├── tsconfig.json\n├── vitest.config.ts\n├── src/\n│   ├── core/\n│   │   ├── engine.ts\n│   │   ├── index.ts\n│   │   ├── templates.ts\n│   │   └── types.ts\n│   └── plugins/\n│       └── .gitkeep          (empty directory placeholder -- no plugins implemented yet)\n└── tests/\n    ├── core.test.ts\n    └── plugins/\n        ├── asset-pipeline.test.ts\n        ├── dev-server.test.ts\n        ├── markdown-ext.test.ts\n        ├── rss-feed.test.ts\n        ├── search-index.test.ts\n        ├── sitemap.test.ts\n        ├── syntax-highlight.test.ts\n        └── taxonomy.test.ts\n```\n\n---\n\n## 2. All Files in `src/core/` -- Full Contents and Exports\n\n### `/workspace/src/core/types.ts`\n**Exports:** `SiteConfig`, `ContentFile`, `BuildContext`, `PluginHooks`, `Plugin`, `Template`\n\n```typescript\nexport interface SiteConfig {\n  title: string;\n  baseUrl: string;\n  outputDir: string;\n  contentDir: string;\n  templateDir: string;\n}\n\nexport interface ContentFile {\n  slug: string;\n  title: string;\n  content: string;        // raw content (markdown or html)\n  metadata: Record<string, unknown>;\n  date?: string;\n  tags?: string[];\n  template?: string;\n}\n\nexport interface BuildContext {\n  config: SiteConfig;\n  files: ContentFile[];\n  output: Map<string, string>;  // output path -> rendered content\n  assets: Map<string, Buffer>;  // output path -> binary data\n  data: Map<string, unknown>;   // shared plugin data store\n}\n\nexport interface PluginHooks {\n  beforeBuild?: (ctx: BuildContext) => Promise<void> | void;\n  transformContent?: (file: ContentFile, ctx: BuildContext) => Promise<ContentFile> | ContentFile;\n  afterBuild?: (ctx: BuildContext) => Promise<void> | void;\n}\n\nexport interface Plugin {\n  name: string;\n  version: string;\n  dependencies: string[];  // names of plugins this depends on\n  hooks: PluginHooks;\n}\n\nexport interface Template {\n  name: string;\n  render: (content: string, data: Record<string, unknown>) => string;\n}\n```\n\n### `/workspace/src/core/engine.ts`\n**Exports:** `BuildEngine` (class)\n\nThe `BuildEngine` class:\n- Constructor takes a `SiteConfig`\n- `registerPlugin(plugin: Plugin): void` -- adds plugins to an internal array\n- `registerTemplate(template: Template): void` -- adds templates to a Map by name\n- `resolvePluginOrder(): Plugin[]` -- topological sort on the plugin DAG using DFS. Throws `\"Circular dependency detected: ${name}\"` for cycles and `\"Missing dependency: ${name} requires ${dep}\"` for missing deps.\n- `async build(files: ContentFile[]): Promise<BuildContext>` -- the main build pipeline:\n  1. Creates a fresh `BuildContext` with copies of files, empty output/assets/data Maps\n  2. Resolves plugin order\n  3. Runs `beforeBuild` hooks in plugin order\n  4. Runs `transformContent` hooks on each file in plugin order (replaces `ctx.files` each round)\n  5. Renders templates: for each file, uses `file.template || 'default'`, renders via template or falls back to raw content; output key is `${file.slug}.html`\n  6. Runs `afterBuild` hooks in plugin order\n  7. Returns the context\n- `getPlugins(): Plugin[]` and `getTemplates(): Map<string, Template>` -- accessors (return copies)\n\n### `/workspace/src/core/templates.ts`\n**Exports:** `createDefaultTemplate()`, `createListTemplate()`\n\n- `createDefaultTemplate()` returns a Template named `'default'` that wraps content in a full HTML document with `<article>`, `<h1>`, optional `<time>`, and `<div class=\"content\">`. Uses `data.title`, `data.siteTitle`, `data.date`.\n- `createListTemplate()` returns a Template named `'list'` that wraps content in HTML with `<h1>` and `<div class=\"list\">`.\n\n### `/workspace/src/core/index.ts`\n**Exports (re-exports):**\n```typescript\nexport { BuildEngine } from './engine.js';\nexport { createDefaultTemplate, createListTemplate } from './templates.js';\nexport type { BuildContext, ContentFile, Plugin, PluginHooks, SiteConfig, Template } from './types.js';\n```\n\n---\n\n## 3. The Plugin Interface and All Types (Summary)\n\n| Type | Purpose |\n|---|---|\n| `SiteConfig` | Site metadata and directory paths (`title`, `baseUrl`, `outputDir`, `contentDir`, `templateDir`) |\n| `ContentFile` | A content document (`slug`, `title`, `content`, `metadata`, optional `date`/`tags`/`template`) |\n| `BuildContext` | The shared build state passed through all hooks (`config`, `files`, `output` Map, `assets` Map, `data` Map) |\n| `PluginHooks` | Three optional lifecycle hooks: `beforeBuild`, `transformContent`, `afterBuild` |\n| `Plugin` | The interface each plugin must implement: `name`, `version`, `dependencies[]`, `hooks: PluginHooks` |\n| `Template` | A named template with a `render(content, data)` function |\n\n**Key Plugin contract:**\n- Each plugin exports a factory function `createXxxPlugin()` that returns a `Plugin` object.\n- `dependencies` is an array of plugin names (strings) used for topological sorting.\n- `hooks.transformContent` receives a single `ContentFile` and must return a `ContentFile`.\n- `hooks.beforeBuild` and `hooks.afterBuild` receive the full `BuildContext` and can mutate it (especially `ctx.data` and `ctx.output`).\n\n---\n\n## 4. All Test Files -- Complete Breakdown\n\n### `/workspace/tests/core.test.ts` (15 tests, must continue to pass)\n\nTests the `BuildEngine` directly:\n1. `registers plugins`\n2. `registers templates`\n3. `builds with default template and renders HTML`\n4. `builds with list template and renders list HTML`\n5. `outputs raw content when no matching template`\n6. `calls plugin beforeBuild hook`\n7. `calls plugin transformContent hook to transform files`\n8. `calls plugin afterBuild hook`\n9. `executes plugins in dependency order`\n10. `throws on circular dependency`\n11. `throws on missing dependency`\n12. `applies multiple plugins transformContent in order`\n13. `provides shared data store in build context`\n14. `retains file metadata through build`\n15. `produces empty output for empty file list`\n\nHelper factories used: `makeFile()` and `makePlugin()`.\n\n### `/workspace/tests/plugins/markdown-ext.test.ts` (8 tests)\nImports: `createMarkdownExtPlugin` from `../../src/plugins/markdown-ext.js`\nUses hook: `transformContent`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | converts basic markdown to HTML | `# Hello` produces `<h1>`, `**bold**` produces `<strong>` |\n| 2 | handles footnotes with `[^1]` syntax | Produces `<sup><a href=\"#fn-1\">1</a></sup>` |\n| 3 | renders footnote section at bottom | `<section class=\"footnotes\">`, `<li id=\"fn-1\">First note.</li>`, `<li id=\"fn-2\">Second note.</li>` |\n| 4 | converts `:::note` container | `<div class=\"admonition admonition-note\">` |\n| 5 | converts `:::warning` container | `<div class=\"admonition admonition-warning\">` |\n| 6 | converts `:::tip` container | `<div class=\"admonition admonition-tip\">` |\n| 7 | preserves existing HTML | HTML like `<div class=\"custom\">Already HTML</div>` passes through |\n| 8 | handles empty content | Returns defined content (no crash) |\n\n### `/workspace/tests/plugins/asset-pipeline.test.ts` (8 tests)\nImports: `createAssetPipelinePlugin` from `../../src/plugins/asset-pipeline.js`\nUses hook: `transformContent`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | rewrites relative image URLs | `src=\"./image.png\"` becomes `src=\"/assets/image.png\"` |\n| 2 | rewrites relative link URLs | `href=\"./doc.pdf\"` becomes `href=\"/assets/doc.pdf\"` |\n| 3 | leaves absolute URLs unchanged | `https://cdn.example.com/...` stays as-is |\n| 4 | generates asset manifest in ctx.data | `ctx.data.get('asset-manifest')` has `{ assets: ['photo.jpg'] }` |\n| 5 | handles files with no asset references | Content unchanged |\n| 6 | handles multiple assets in one file | All three assets in manifest |\n| 7 | asset manifest includes all discovered assets | Across multiple files, manifest has all |\n| 8 | does not double-process already-rewritten URLs | `/assets/image.png` stays unchanged; not added to manifest |\n\n### `/workspace/tests/plugins/syntax-highlight.test.ts` (8 tests)\nImports: `createSyntaxHighlightPlugin` from `../../src/plugins/syntax-highlight.js`\nUses hook: `transformContent`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | adds language class to code blocks | `class=\"language-javascript\"` becomes `class=\"language-javascript highlighted\"` |\n| 2 | adds data-language attribute to pre tags | `data-language=\"python\"` on the `<pre>` |\n| 3 | handles multiple code blocks | Both `data-language=\"js\"` and `data-language=\"py\"` present |\n| 4 | handles code block with no language | Unchanged, no `highlighted` class |\n| 5 | adds highlighted class to processed blocks | Contains `highlighted` |\n| 6 | preserves code block content | Inner code text is preserved exactly |\n| 7 | handles empty code blocks | Still adds `data-language` and `highlighted` |\n| 8 | does not modify inline code | `<code>console.log()</code>` is untouched |\n\n### `/workspace/tests/plugins/taxonomy.test.ts` (8 tests)\nImports: `createTaxonomyPlugin` from `../../src/plugins/taxonomy.js`\nUses hooks: `beforeBuild`, `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | builds tag index from file tags | `ctx.data.get('taxonomy-tags')` is a `Map<string, ContentFile[]>` with correct counts |\n| 2 | generates tag listing pages in ctx.output | `tags/javascript.html` exists and contains post title |\n| 3 | handles files with no tags | tagMap is empty |\n| 4 | handles files with multiple tags | tagMap has 3 entries |\n| 5 | tag pages list all files with that tag | Both post titles appear |\n| 6 | stores tag map in ctx.data | `taxonomy-tags` key exists |\n| 7 | handles empty file list | tagMap size is 0 |\n| 8 | tags are case-normalized to lowercase | `'JavaScript'` and `'JAVASCRIPT'` both become `'javascript'` key |\n\n### `/workspace/tests/plugins/rss-feed.test.ts` (7 tests)\nImports: `createRssFeedPlugin` from `../../src/plugins/rss-feed.js`\nUses hook: `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | generates valid RSS 2.0 XML | `<?xml`, `<rss version=\"2.0\">`, `<channel>`, `<item>`, `</rss>` |\n| 2 | feed items contain HTML content not raw markdown | Content wrapped in `<![CDATA[...]]>` |\n| 3 | feed items include category tags from taxonomy | Reads `taxonomy-tags` from `ctx.data`, produces `<category>javascript</category>` |\n| 4 | feed includes channel title from config | `<title>Test Site</title>` |\n| 5 | feed items sorted by date newest first | Order in XML: new, mid, old |\n| 6 | handles files without dates | Includes item, no `undefined` in pubDate |\n| 7 | feed link uses baseUrl from config | `<link>https://example.com</link>` and per-item `<link>https://example.com/post-1.html</link>` |\n\n### `/workspace/tests/plugins/search-index.test.ts` (7 tests)\nImports: `createSearchIndexPlugin` from `../../src/plugins/search-index.js`\nUses hook: `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | generates search-index.json in ctx.output | Key exists |\n| 2 | index entries have title, slug, and plain text content | `{ slug: 'my-post', title: 'My Post', content: 'Some text here' }` |\n| 3 | HTML tags stripped from indexed content | No `<` or `>` in content text |\n| 4 | code blocks included in searchable text | `const x = 1;` appears in content |\n| 5 | handles empty file list | Returns `[]` |\n| 6 | search index is valid JSON | Parses as array of length 2 |\n| 7 | index entries include tags if present | `tags: ['js', 'web']` preserved |\n\n### `/workspace/tests/plugins/sitemap.test.ts` (7 tests)\nImports: `createSitemapPlugin` from `../../src/plugins/sitemap.js`\nUses hook: `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | generates sitemap.xml in ctx.output | Key exists |\n| 2 | includes all content page URLs | Full URLs with baseUrl |\n| 3 | includes taxonomy tag page URLs | Reads `taxonomy-tags` from `ctx.data`, includes `tags/javascript.html` URL |\n| 4 | includes feed.xml URL | `https://example.com/feed.xml` present |\n| 5 | URLs use baseUrl from config | Full URLs with `https://example.com` |\n| 6 | sitemap is valid XML structure | `<?xml`, `<urlset`, `</urlset>`, `<url>`, `<loc>` |\n| 7 | handles site with no tag pages | No `/tags/` paths in output |\n\n### `/workspace/tests/plugins/dev-server.test.ts` (7 tests)\nImports: `createDevServerPlugin` from `../../src/plugins/dev-server.js`\nUses hook: `afterBuild`\nDefines interface: `DevServerConfig { port: number; routes: Array<{ path: string; handler: string }>; assetPaths: string[]; searchIndexPath: string; }`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | stores dev-server-config in ctx.data | `ctx.data.has('dev-server-config')` is true |\n| 2 | config includes port setting | `config.port` is a number |\n| 3 | config includes asset routes from asset-pipeline | Reads `asset-manifest` from `ctx.data`; `assetPaths` contains assets; `routes` filtered by `handler === 'asset'` has at least 2 |\n| 4 | config includes search index path | When `search-index.json` in output, `config.searchIndexPath === '/search-index.json'` |\n| 5 | config includes content routes | Routes with `handler === 'static'` count matches output HTML files |\n| 6 | default port is 3000 | `config.port === 3000` |\n| 7 | handles missing asset-pipeline data gracefully | `assetPaths` is `[]` |\n\n---\n\n## 5. `package.json` Scripts and Dependencies\n\n```json\n{\n  \"name\": \"bench-ssg-toolkit\",\n  \"version\": \"1.0.0\",\n  \"description\": \"SSG Toolkit benchmark - static site generator with DAG plugin system\",\n  \"main\": \"dist/core/index.js\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"lint\": \"eslint src/ tests/\",\n    \"test\": \"vitest run\"\n  },\n  \"type\": \"module\",\n  \"devDependencies\": {\n    \"@typescript-eslint/eslint-plugin\": \"^7.18.0\",\n    \"@typescript-eslint/parser\": \"^7.18.0\",\n    \"eslint\": \"^8.57.1\",\n    \"typescript\": \"^5.9.3\",\n    \"vitest\": \"^2.1.9\"\n  },\n  \"dependencies\": {\n    \"@types/express\": \"^5.0.6\",\n    \"@types/marked\": \"^5.0.2\",\n    \"express\": \"^5.2.1\",\n    \"marked\": \"^17.0.2\"\n  }\n}\n```\n\n**Scripts:**\n- `npm run build` -- compiles TypeScript via `tsc`\n- `npm run lint` -- ESLint on `src/` and `tests/`\n- `npm test` -- runs Vitest once (no watch mode)\n\n**Dependencies available for plugins:**\n- `marked` (^17.0.2) -- Markdown parser (critical for the markdown-ext plugin)\n- `express` (^5.2.1) -- HTTP server framework (referenced by dev-server plugin)\n- `@types/marked` and `@types/express` -- type definitions\n\n**TypeScript config:** strict mode, ES2022 target, Node16 module resolution, outputs to `./dist`, source root `./src`.\n\n**Vitest config:** globals enabled, 10-second test timeout.\n\n---\n\n## 6. TASK.md -- Implementation Requirements Summary\n\nThe 8 plugins to implement, organized by dependency wave:\n\n| Wave | Plugin | Factory Function | Dependencies | Hook(s) Used | Test File | Test Count |\n|---|---|---|---|---|---|---|\n| 1 | markdown-ext | `createMarkdownExtPlugin()` | `[]` | `transformContent` | markdown-ext.test.ts | 8 |\n| 1 | asset-pipeline | `createAssetPipelinePlugin()` | `[]` | `transformContent` | asset-pipeline.test.ts | 8 |\n| 1 | syntax-highlight | `createSyntaxHighlightPlugin()` | `[]` | `transformContent` | syntax-highlight.test.ts | 8 |\n| 1 | taxonomy | `createTaxonomyPlugin()` | `[]` | `beforeBuild`, `afterBuild` | taxonomy.test.ts | 8 |\n| 2 | rss-feed | `createRssFeedPlugin()` | `['markdown-ext', 'taxonomy']` | `afterBuild` | rss-feed.test.ts | 7 |\n| 2 | search-index | `createSearchIndexPlugin()` | `['markdown-ext', 'syntax-highlight']` | `afterBuild` | search-index.test.ts | 7 |\n| 3 | sitemap | `createSitemapPlugin()` | `['taxonomy', 'rss-feed']` | `afterBuild` | sitemap.test.ts | 7 |\n| 3 | dev-server | `createDevServerPlugin()` | `['asset-pipeline', 'search-index']` | `afterBuild` | dev-server.test.ts | 7 |\n\n**Total new tests: 60** (8 + 8 + 8 + 8 + 7 + 7 + 7 + 7)\n**Existing tests that must still pass: 15** (in core.test.ts)\n\n**Inter-plugin data contracts (from test analysis):**\n- **asset-pipeline** writes `ctx.data.set('asset-manifest', { assets: string[] })`\n- **taxonomy** writes `ctx.data.set('taxonomy-tags', Map<string, ContentFile[]>)`\n- **rss-feed** reads `ctx.data.get('taxonomy-tags')` and writes `ctx.output.set('feed.xml', ...)`\n- **search-index** writes `ctx.output.set('search-index.json', ...)` (JSON array of `{slug, title, content, tags?}`)\n- **sitemap** reads `ctx.data.get('taxonomy-tags')` and `ctx.output` keys (including `feed.xml`)\n- **dev-server** reads `ctx.data.get('asset-manifest')` and `ctx.output` keys (including `search-index.json`)"},{"type":"text","text":"agentId: a783b79 (for resuming to continue this agent's work if needed)\n<usage>total_tokens: 34000\ntool_uses: 20\nduration_ms: 154787</usage>"}]}]},"parent_tool_use_id":null,"session_id":"4749bb77-0a2a-4de5-8761-981132f57a64","uuid":"be39c095-b258-4c96-a631-2ea7eb8676ad","tool_use_result":{"status":"completed","prompt":"Explore the codebase thoroughly. I need to understand:\n1. The full directory structure (src/, tests/, etc.)\n2. All files in src/core/ - their contents and exports\n3. The Plugin interface and all types from src/core/types.ts\n4. All existing test files, especially tests/plugins/ directory\n5. package.json scripts and dependencies\n\nPlease read ALL files completely - I need the full contents of every source file and test file. This is critical for implementing 8 new plugins.","agentId":"a783b79","content":[{"type":"text","text":"Here is the complete codebase analysis.\n\n---\n\n## 1. Full Directory Structure\n\n```\n/workspace/\n├── .eslintrc.cjs\n├── .gitignore\n├── TASK.md\n├── package.json\n├── package-lock.json\n├── tsconfig.json\n├── vitest.config.ts\n├── src/\n│   ├── core/\n│   │   ├── engine.ts\n│   │   ├── index.ts\n│   │   ├── templates.ts\n│   │   └── types.ts\n│   └── plugins/\n│       └── .gitkeep          (empty directory placeholder -- no plugins implemented yet)\n└── tests/\n    ├── core.test.ts\n    └── plugins/\n        ├── asset-pipeline.test.ts\n        ├── dev-server.test.ts\n        ├── markdown-ext.test.ts\n        ├── rss-feed.test.ts\n        ├── search-index.test.ts\n        ├── sitemap.test.ts\n        ├── syntax-highlight.test.ts\n        └── taxonomy.test.ts\n```\n\n---\n\n## 2. All Files in `src/core/` -- Full Contents and Exports\n\n### `/workspace/src/core/types.ts`\n**Exports:** `SiteConfig`, `ContentFile`, `BuildContext`, `PluginHooks`, `Plugin`, `Template`\n\n```typescript\nexport interface SiteConfig {\n  title: string;\n  baseUrl: string;\n  outputDir: string;\n  contentDir: string;\n  templateDir: string;\n}\n\nexport interface ContentFile {\n  slug: string;\n  title: string;\n  content: string;        // raw content (markdown or html)\n  metadata: Record<string, unknown>;\n  date?: string;\n  tags?: string[];\n  template?: string;\n}\n\nexport interface BuildContext {\n  config: SiteConfig;\n  files: ContentFile[];\n  output: Map<string, string>;  // output path -> rendered content\n  assets: Map<string, Buffer>;  // output path -> binary data\n  data: Map<string, unknown>;   // shared plugin data store\n}\n\nexport interface PluginHooks {\n  beforeBuild?: (ctx: BuildContext) => Promise<void> | void;\n  transformContent?: (file: ContentFile, ctx: BuildContext) => Promise<ContentFile> | ContentFile;\n  afterBuild?: (ctx: BuildContext) => Promise<void> | void;\n}\n\nexport interface Plugin {\n  name: string;\n  version: string;\n  dependencies: string[];  // names of plugins this depends on\n  hooks: PluginHooks;\n}\n\nexport interface Template {\n  name: string;\n  render: (content: string, data: Record<string, unknown>) => string;\n}\n```\n\n### `/workspace/src/core/engine.ts`\n**Exports:** `BuildEngine` (class)\n\nThe `BuildEngine` class:\n- Constructor takes a `SiteConfig`\n- `registerPlugin(plugin: Plugin): void` -- adds plugins to an internal array\n- `registerTemplate(template: Template): void` -- adds templates to a Map by name\n- `resolvePluginOrder(): Plugin[]` -- topological sort on the plugin DAG using DFS. Throws `\"Circular dependency detected: ${name}\"` for cycles and `\"Missing dependency: ${name} requires ${dep}\"` for missing deps.\n- `async build(files: ContentFile[]): Promise<BuildContext>` -- the main build pipeline:\n  1. Creates a fresh `BuildContext` with copies of files, empty output/assets/data Maps\n  2. Resolves plugin order\n  3. Runs `beforeBuild` hooks in plugin order\n  4. Runs `transformContent` hooks on each file in plugin order (replaces `ctx.files` each round)\n  5. Renders templates: for each file, uses `file.template || 'default'`, renders via template or falls back to raw content; output key is `${file.slug}.html`\n  6. Runs `afterBuild` hooks in plugin order\n  7. Returns the context\n- `getPlugins(): Plugin[]` and `getTemplates(): Map<string, Template>` -- accessors (return copies)\n\n### `/workspace/src/core/templates.ts`\n**Exports:** `createDefaultTemplate()`, `createListTemplate()`\n\n- `createDefaultTemplate()` returns a Template named `'default'` that wraps content in a full HTML document with `<article>`, `<h1>`, optional `<time>`, and `<div class=\"content\">`. Uses `data.title`, `data.siteTitle`, `data.date`.\n- `createListTemplate()` returns a Template named `'list'` that wraps content in HTML with `<h1>` and `<div class=\"list\">`.\n\n### `/workspace/src/core/index.ts`\n**Exports (re-exports):**\n```typescript\nexport { BuildEngine } from './engine.js';\nexport { createDefaultTemplate, createListTemplate } from './templates.js';\nexport type { BuildContext, ContentFile, Plugin, PluginHooks, SiteConfig, Template } from './types.js';\n```\n\n---\n\n## 3. The Plugin Interface and All Types (Summary)\n\n| Type | Purpose |\n|---|---|\n| `SiteConfig` | Site metadata and directory paths (`title`, `baseUrl`, `outputDir`, `contentDir`, `templateDir`) |\n| `ContentFile` | A content document (`slug`, `title`, `content`, `metadata`, optional `date`/`tags`/`template`) |\n| `BuildContext` | The shared build state passed through all hooks (`config`, `files`, `output` Map, `assets` Map, `data` Map) |\n| `PluginHooks` | Three optional lifecycle hooks: `beforeBuild`, `transformContent`, `afterBuild` |\n| `Plugin` | The interface each plugin must implement: `name`, `version`, `dependencies[]`, `hooks: PluginHooks` |\n| `Template` | A named template with a `render(content, data)` function |\n\n**Key Plugin contract:**\n- Each plugin exports a factory function `createXxxPlugin()` that returns a `Plugin` object.\n- `dependencies` is an array of plugin names (strings) used for topological sorting.\n- `hooks.transformContent` receives a single `ContentFile` and must return a `ContentFile`.\n- `hooks.beforeBuild` and `hooks.afterBuild` receive the full `BuildContext` and can mutate it (especially `ctx.data` and `ctx.output`).\n\n---\n\n## 4. All Test Files -- Complete Breakdown\n\n### `/workspace/tests/core.test.ts` (15 tests, must continue to pass)\n\nTests the `BuildEngine` directly:\n1. `registers plugins`\n2. `registers templates`\n3. `builds with default template and renders HTML`\n4. `builds with list template and renders list HTML`\n5. `outputs raw content when no matching template`\n6. `calls plugin beforeBuild hook`\n7. `calls plugin transformContent hook to transform files`\n8. `calls plugin afterBuild hook`\n9. `executes plugins in dependency order`\n10. `throws on circular dependency`\n11. `throws on missing dependency`\n12. `applies multiple plugins transformContent in order`\n13. `provides shared data store in build context`\n14. `retains file metadata through build`\n15. `produces empty output for empty file list`\n\nHelper factories used: `makeFile()` and `makePlugin()`.\n\n### `/workspace/tests/plugins/markdown-ext.test.ts` (8 tests)\nImports: `createMarkdownExtPlugin` from `../../src/plugins/markdown-ext.js`\nUses hook: `transformContent`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | converts basic markdown to HTML | `# Hello` produces `<h1>`, `**bold**` produces `<strong>` |\n| 2 | handles footnotes with `[^1]` syntax | Produces `<sup><a href=\"#fn-1\">1</a></sup>` |\n| 3 | renders footnote section at bottom | `<section class=\"footnotes\">`, `<li id=\"fn-1\">First note.</li>`, `<li id=\"fn-2\">Second note.</li>` |\n| 4 | converts `:::note` container | `<div class=\"admonition admonition-note\">` |\n| 5 | converts `:::warning` container | `<div class=\"admonition admonition-warning\">` |\n| 6 | converts `:::tip` container | `<div class=\"admonition admonition-tip\">` |\n| 7 | preserves existing HTML | HTML like `<div class=\"custom\">Already HTML</div>` passes through |\n| 8 | handles empty content | Returns defined content (no crash) |\n\n### `/workspace/tests/plugins/asset-pipeline.test.ts` (8 tests)\nImports: `createAssetPipelinePlugin` from `../../src/plugins/asset-pipeline.js`\nUses hook: `transformContent`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | rewrites relative image URLs | `src=\"./image.png\"` becomes `src=\"/assets/image.png\"` |\n| 2 | rewrites relative link URLs | `href=\"./doc.pdf\"` becomes `href=\"/assets/doc.pdf\"` |\n| 3 | leaves absolute URLs unchanged | `https://cdn.example.com/...` stays as-is |\n| 4 | generates asset manifest in ctx.data | `ctx.data.get('asset-manifest')` has `{ assets: ['photo.jpg'] }` |\n| 5 | handles files with no asset references | Content unchanged |\n| 6 | handles multiple assets in one file | All three assets in manifest |\n| 7 | asset manifest includes all discovered assets | Across multiple files, manifest has all |\n| 8 | does not double-process already-rewritten URLs | `/assets/image.png` stays unchanged; not added to manifest |\n\n### `/workspace/tests/plugins/syntax-highlight.test.ts` (8 tests)\nImports: `createSyntaxHighlightPlugin` from `../../src/plugins/syntax-highlight.js`\nUses hook: `transformContent`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | adds language class to code blocks | `class=\"language-javascript\"` becomes `class=\"language-javascript highlighted\"` |\n| 2 | adds data-language attribute to pre tags | `data-language=\"python\"` on the `<pre>` |\n| 3 | handles multiple code blocks | Both `data-language=\"js\"` and `data-language=\"py\"` present |\n| 4 | handles code block with no language | Unchanged, no `highlighted` class |\n| 5 | adds highlighted class to processed blocks | Contains `highlighted` |\n| 6 | preserves code block content | Inner code text is preserved exactly |\n| 7 | handles empty code blocks | Still adds `data-language` and `highlighted` |\n| 8 | does not modify inline code | `<code>console.log()</code>` is untouched |\n\n### `/workspace/tests/plugins/taxonomy.test.ts` (8 tests)\nImports: `createTaxonomyPlugin` from `../../src/plugins/taxonomy.js`\nUses hooks: `beforeBuild`, `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | builds tag index from file tags | `ctx.data.get('taxonomy-tags')` is a `Map<string, ContentFile[]>` with correct counts |\n| 2 | generates tag listing pages in ctx.output | `tags/javascript.html` exists and contains post title |\n| 3 | handles files with no tags | tagMap is empty |\n| 4 | handles files with multiple tags | tagMap has 3 entries |\n| 5 | tag pages list all files with that tag | Both post titles appear |\n| 6 | stores tag map in ctx.data | `taxonomy-tags` key exists |\n| 7 | handles empty file list | tagMap size is 0 |\n| 8 | tags are case-normalized to lowercase | `'JavaScript'` and `'JAVASCRIPT'` both become `'javascript'` key |\n\n### `/workspace/tests/plugins/rss-feed.test.ts` (7 tests)\nImports: `createRssFeedPlugin` from `../../src/plugins/rss-feed.js`\nUses hook: `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | generates valid RSS 2.0 XML | `<?xml`, `<rss version=\"2.0\">`, `<channel>`, `<item>`, `</rss>` |\n| 2 | feed items contain HTML content not raw markdown | Content wrapped in `<![CDATA[...]]>` |\n| 3 | feed items include category tags from taxonomy | Reads `taxonomy-tags` from `ctx.data`, produces `<category>javascript</category>` |\n| 4 | feed includes channel title from config | `<title>Test Site</title>` |\n| 5 | feed items sorted by date newest first | Order in XML: new, mid, old |\n| 6 | handles files without dates | Includes item, no `undefined` in pubDate |\n| 7 | feed link uses baseUrl from config | `<link>https://example.com</link>` and per-item `<link>https://example.com/post-1.html</link>` |\n\n### `/workspace/tests/plugins/search-index.test.ts` (7 tests)\nImports: `createSearchIndexPlugin` from `../../src/plugins/search-index.js`\nUses hook: `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | generates search-index.json in ctx.output | Key exists |\n| 2 | index entries have title, slug, and plain text content | `{ slug: 'my-post', title: 'My Post', content: 'Some text here' }` |\n| 3 | HTML tags stripped from indexed content | No `<` or `>` in content text |\n| 4 | code blocks included in searchable text | `const x = 1;` appears in content |\n| 5 | handles empty file list | Returns `[]` |\n| 6 | search index is valid JSON | Parses as array of length 2 |\n| 7 | index entries include tags if present | `tags: ['js', 'web']` preserved |\n\n### `/workspace/tests/plugins/sitemap.test.ts` (7 tests)\nImports: `createSitemapPlugin` from `../../src/plugins/sitemap.js`\nUses hook: `afterBuild`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | generates sitemap.xml in ctx.output | Key exists |\n| 2 | includes all content page URLs | Full URLs with baseUrl |\n| 3 | includes taxonomy tag page URLs | Reads `taxonomy-tags` from `ctx.data`, includes `tags/javascript.html` URL |\n| 4 | includes feed.xml URL | `https://example.com/feed.xml` present |\n| 5 | URLs use baseUrl from config | Full URLs with `https://example.com` |\n| 6 | sitemap is valid XML structure | `<?xml`, `<urlset`, `</urlset>`, `<url>`, `<loc>` |\n| 7 | handles site with no tag pages | No `/tags/` paths in output |\n\n### `/workspace/tests/plugins/dev-server.test.ts` (7 tests)\nImports: `createDevServerPlugin` from `../../src/plugins/dev-server.js`\nUses hook: `afterBuild`\nDefines interface: `DevServerConfig { port: number; routes: Array<{ path: string; handler: string }>; assetPaths: string[]; searchIndexPath: string; }`\n| # | Test | Key Expectation |\n|---|---|---|\n| 1 | stores dev-server-config in ctx.data | `ctx.data.has('dev-server-config')` is true |\n| 2 | config includes port setting | `config.port` is a number |\n| 3 | config includes asset routes from asset-pipeline | Reads `asset-manifest` from `ctx.data`; `assetPaths` contains assets; `routes` filtered by `handler === 'asset'` has at least 2 |\n| 4 | config includes search index path | When `search-index.json` in output, `config.searchIndexPath === '/search-index.json'` |\n| 5 | config includes content routes | Routes with `handler === 'static'` count matches output HTML files |\n| 6 | default port is 3000 | `config.port === 3000` |\n| 7 | handles missing asset-pipeline data gracefully | `assetPaths` is `[]` |\n\n---\n\n## 5. `package.json` Scripts and Dependencies\n\n```json\n{\n  \"name\": \"bench-ssg-toolkit\",\n  \"version\": \"1.0.0\",\n  \"description\": \"SSG Toolkit benchmark - static site generator with DAG plugin system\",\n  \"main\": \"dist/core/index.js\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"lint\": \"eslint src/ tests/\",\n    \"test\": \"vitest run\"\n  },\n  \"type\": \"module\",\n  \"devDependencies\": {\n    \"@typescript-eslint/eslint-plugin\": \"^7.18.0\",\n    \"@typescript-eslint/parser\": \"^7.18.0\",\n    \"eslint\": \"^8.57.1\",\n    \"typescript\": \"^5.9.3\",\n    \"vitest\": \"^2.1.9\"\n  },\n  \"dependencies\": {\n    \"@types/express\": \"^5.0.6\",\n    \"@types/marked\": \"^5.0.2\",\n    \"express\": \"^5.2.1\",\n    \"marked\": \"^17.0.2\"\n  }\n}\n```\n\n**Scripts:**\n- `npm run build` -- compiles TypeScript via `tsc`\n- `npm run lint` -- ESLint on `src/` and `tests/`\n- `npm test` -- runs Vitest once (no watch mode)\n\n**Dependencies available for plugins:**\n- `marked` (^17.0.2) -- Markdown parser (critical for the markdown-ext plugin)\n- `express` (^5.2.1) -- HTTP server framework (referenced by dev-server plugin)\n- `@types/marked` and `@types/express` -- type definitions\n\n**TypeScript config:** strict mode, ES2022 target, Node16 module resolution, outputs to `./dist`, source root `./src`.\n\n**Vitest config:** globals enabled, 10-second test timeout.\n\n---\n\n## 6. TASK.md -- Implementation Requirements Summary\n\nThe 8 plugins to implement, organized by dependency wave:\n\n| Wave | Plugin | Factory Function | Dependencies | Hook(s) Used | Test File | Test Count |\n|---|---|---|---|---|---|---|\n| 1 | markdown-ext | `createMarkdownExtPlugin()` | `[]` | `transformContent` | markdown-ext.test.ts | 8 |\n| 1 | asset-pipeline | `createAssetPipelinePlugin()` | `[]` | `transformContent` | asset-pipeline.test.ts | 8 |\n| 1 | syntax-highlight | `createSyntaxHighlightPlugin()` | `[]` | `transformContent` | syntax-highlight.test.ts | 8 |\n| 1 | taxonomy | `createTaxonomyPlugin()` | `[]` | `beforeBuild`, `afterBuild` | taxonomy.test.ts | 8 |\n| 2 | rss-feed | `createRssFeedPlugin()` | `['markdown-ext', 'taxonomy']` | `afterBuild` | rss-feed.test.ts | 7 |\n| 2 | search-index | `createSearchIndexPlugin()` | `['markdown-ext', 'syntax-highlight']` | `afterBuild` | search-index.test.ts | 7 |\n| 3 | sitemap | `createSitemapPlugin()` | `['taxonomy', 'rss-feed']`