+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createRssFeedPlugin(): Plugin {
+  return {
+    name: 'rss-feed',
+    version: '1.0.0',
+    dependencies: ['markdown-ext', 'taxonomy'],
+    hooks: {
+      afterBuild(ctx: BuildContext): void {
+        const baseUrl = ctx.config.baseUrl;
+        const title = ctx.config.title;
+
+        // Sort files by date, newest first; files without dates go last
+        const sorted = [...ctx.files].sort((a, b) => {
+          if (a.date && b.date) return b.date.localeCompare(a.date);
+          if (a.date) return -1;
+          if (b.date) return 1;
+          return 0;
+        });
+
+        // Get taxonomy data for categories
+        const tagMap = ctx.data.get('taxonomy-tags') as Map<string, ContentFile[]> | undefined;
+
+        let xml = '<?xml version="1.0" encoding="UTF-8"?>\n';
+        xml += '<rss version="2.0">\n';
+        xml += '  <channel>\n';
+        xml += `    <title>${title}</title>\n`;
+        xml += `    <link>${baseUrl}</link>\n`;
+
+        for (const file of sorted) {
+          xml += '    <item>\n';
+          xml += `      <title>${file.title}</title>\n`;
+          xml += `      <link>${baseUrl}/${file.slug}.html</link>\n`;
+
+          if (file.date) {
+            xml += `      <pubDate>${new Date(file.date).toUTCString()}</pubDate>\n`;
+          }
+
+          xml += `      <description><![CDATA[${file.content}]]></description>\n`;
+
+          // Add category tags from taxonomy
+          if (tagMap && file.tags) {
+            for (const tag of file.tags) {
+              xml += `      <category>${tag.toLowerCase()}</category>\n`;
+            }
+          }
+
+          xml += '    </item>\n';
+        }
+
+        xml += '  </channel>\n';
+        xml += '</rss>';
+
+        ctx.output.set('feed.xml', xml);
+      },
+    },
+  };
+}
