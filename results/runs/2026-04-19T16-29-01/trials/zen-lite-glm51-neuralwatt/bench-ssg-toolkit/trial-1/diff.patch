l')!;\n    94→    const newIdx = feed.indexOf('New Post');\n    95→    const midIdx = feed.indexOf('Mid Post');\n    96→    const oldIdx = feed.indexOf('Old Post');\n    97→    expect(newIdx).toBeLessThan(midIdx);\n    98→    expect(midIdx).toBeLessThan(oldIdx);\n    99→  });\n   100→\n   101→  it('handles files without dates', async () => {\n   102→    const files = [\n   103→      makeFile({ slug: 'no-date', title: 'No Date Post', content: '<p>No date</p>' }),\n   104→    ];\n   105→    const ctx = makeCtx(files);\n   106→    await plugin.hooks.afterBuild!(ctx);\n   107→    const feed = ctx.output.get('feed.xml')!;\n   108→    expect(feed).toContain('No Date Post');\n   109→    expect(feed).not.toContain('<pubDate>undefined</pubDate>');\n   110→  });\n   111→\n   112→  it('feed link uses baseUrl from config', async () => {\n   113→    const files = [makeFile({ slug: 'post-1', title: 'Post 1' })];\n   114→    const ctx = makeCtx(files);\n   115→    await plugin.hooks.afterBuild!(ctx);\n   116→    const feed = ctx.output.get('feed.xml')!;\n   117→    expect(feed).toContain('<link>https://example.com</link>');\n   118→    expect(feed).toContain('<link>https://example.com/post-1.html</link>');\n   119→  });\n   120→});\n   121→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"chatcmpl-tool-8d970cfb0b8866d7","session_id":"4749bb77-0a2a-4de5-8761-981132f57a64","uuid":"54a83c7e-ae73-4490-b862-54f3fa41b6ec"}
