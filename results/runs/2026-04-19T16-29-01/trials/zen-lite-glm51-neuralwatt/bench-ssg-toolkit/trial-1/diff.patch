+++ b/src/plugins/asset-pipeline.ts
@@ -0,0 +1,32 @@
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createAssetPipelinePlugin(): Plugin {
+  return {
+    name: 'asset-pipeline',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, ctx: BuildContext): ContentFile {
+        let content = file.content;
+        const assets: string[] = [];
+
+        // Rewrite relative src="./xxx" and href="./xxx" URLs to /assets/xxx
+        content = content.replace(/(src|href)="\.\/([^"]+)"/g, (_match, attr: string, filename: string) => {
+          assets.push(filename);
+          return `${attr}="/assets/${filename}"`;
+        });
+
+        if (assets.length > 0) {
+          const existing = ctx.data.get('asset-manifest') as { assets: string[] } | undefined;
+          if (existing) {
+            existing.assets.push(...assets);
+          } else {
+            ctx.data.set('asset-manifest', { assets: [...assets] });
+          }
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
