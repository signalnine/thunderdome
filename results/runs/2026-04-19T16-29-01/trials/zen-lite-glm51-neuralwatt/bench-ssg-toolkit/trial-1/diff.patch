--- /dev/null
+++ b/src/plugins/markdown-ext.ts
@@ -0,0 +1,52 @@
+import { marked } from 'marked';
+import type { Plugin, ContentFile, BuildContext } from '../core/types.js';
+
+export function createMarkdownExtPlugin(): Plugin {
+  return {
+    name: 'markdown-ext',
+    version: '1.0.0',
+    dependencies: [],
+    hooks: {
+      transformContent(file: ContentFile, _ctx: BuildContext): ContentFile {
+        if (!file.content) {
+          return { ...file, content: '' };
+        }
+
+        let content = file.content;
+        const footnotes = new Map<number, string>();
+
+        // Extract footnote definitions and remove them
+        content = content.replace(/^\[\^(\d+)\]:\s*(.+)$/gm, (_match, num: string, text: string) => {
+          footnotes.set(parseInt(num, 10), text);
+          return '';
+        });
+
+        // Replace footnote references with superscript links
+        content = content.replace(/\[\^(\d+)\]/g, (_match, num: string) => {
+          return `<sup><a href="#fn-${num}">${num}</a></sup>`;
+        });
+
+        // Convert admonition containers
+        content = content.replace(/^:::(note|warning|tip)\n([\s\S]*?)\n:::/gm, (_match, type: string, body: string) => {
+          return `<div class="admonition admonition-${type}">${body}</div>`;
+        });
+
+        // Convert markdown to HTML
+        content = marked.parse(content) as string;
+
+        // Append footnote section if any footnotes were defined
+        if (footnotes.size > 0) {
+          const sorted = [...footnotes.entries()].sort((a, b) => a[0] - b[0]);
+          let section = '<section class="footnotes"><ol>';
+          for (const [num, text] of sorted) {
+            section += `<li id="fn-${num}">${text}</li>`;
+          }
+          section += '</ol></section>';
+          content += section;
+        }
+
+        return { ...file, content };
+      },
+    },
+  };
+}
