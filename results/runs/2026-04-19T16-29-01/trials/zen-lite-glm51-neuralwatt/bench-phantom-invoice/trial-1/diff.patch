5% tax => 42\n    const total = calculateInvoiceTotal(50, 0.2, 0.05);\n    expect(total).toBe(42);\n  });\n\n  it('date range query includes end date boundary', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-06-30',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    const invoices = getInvoicesByDateRange(db, '2024-06-01', '2024-06-30');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-06-30');\n  });\n\n  it('month boundary grouping assigns first day to correct month', () => {\n    // Invoice on March 1 should be in month 3, not month 2\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-01',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    });\n    const report = getMonthlyReport(db, 2024);\n    const march = report.find(r => r.month === 3);\n    const feb = report.find(r => r.month === 2);\n\n    expect(march).toBeDefined();\n    expect(march!.count).toBe(1);\n    expect(march!.total_revenue).toBe(200);\n    expect(feb).toBeUndefined();\n  });\n\n  it('multiple months reporting shows correct distribution', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1', date: '2024-04-15',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1', date: '2024-05-15',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1', date: '2024-06-15',\n      subtotal: 300, discount_rate: 0, tax_rate: 0, total: 300, status: 'paid',\n    });\n\n    const report = getMonthlyReport(db, 2024);\n    expect(report).toHaveLength(3);\n    expect(report[0].month).toBe(4);\n    expect(report[1].month).toBe(5);\n    expect(report[2].month).toBe(6);\n    expect(report[0].total_revenue).toBe(100);\n    expect(report[1].total_revenue).toBe(200);\n    expect(report[2].total_revenue).toBe(300);\n  });\n\n  it('zero discount rate still calculates correctly', () => {\n    // subtotal=1000, 0% discount => 1000, 7% tax => 1070\n    const total = calculateInvoiceTotal(1000, 0, 0.07);\n    expect(total).toBe(1070);\n  });\n\n  it('100% discount rate results in zero total', () => {\n    const total = calculateInvoiceTotal(500, 1.0, 0.1);\n    expect(total).toBe(0);\n  });\n\n  it('formatDate produces correct ISO string', () => {\n    const date = new Date(Date.UTC(2024, 5, 15)); // June 15, 2024\n    expect(formatDate(date)).toBe('2024-06-15');\n  });\n\n  it('large invoice totals maintain precision', () => {\n    // subtotal=99999.99, 5% discount => 94999.9905, 10% tax => 104499.98955 => 104499.99\n    const total = calculateInvoiceTotal(99999.99, 0.05, 0.1);\n    expect(total).toBe(104499.99);\n  });\n\n  it('date range with single day span returns matching invoices', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-09-15',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-09-16',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    });\n\n    // Single day range should only include the one on that day\n    const invoices = getInvoicesByDateRange(db, '2024-09-15', '2024-09-15');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-09-15');\n  });\n});\n```\n\n---\n\n## Summary\n\nThere are **8 source files** and **3 test files**, for a total of **11 files**.\n\n### Source files (`src/`):\n| File | Purpose |\n|---|---|\n| `/workspace/src/db/connection.ts` | Creates SQLite database with `invoices` and `line_items` tables |\n| `/workspace/src/db/queries.ts` | CRUD query functions: `getInvoicesByDateRange`, `getInvoiceById`, `createInvoice`, `getInvoicesByCustomer` |\n| `/workspace/src/models/invoice.ts` | TypeScript interfaces: `LineItem`, `Invoice`, `InvoiceCreateInput`, `InvoiceSummary`, `CustomerReport` |\n| `/workspace/src/server.ts` | Express HTTP server with REST endpoints for invoices and reports |\n| `/workspace/src/services/billing.ts` | Billing logic: `calculateInvoiceTotal`, `applyDiscount`, `calculateSubtotal`, `generateInvoice` |\n| `/workspace/src/services/reporting.ts` | Reporting: `getMonthlyReport`, `getCustomerReport`, `getRevenueByPeriod` |\n| `/workspace/src/utils/dates.ts` | Date utilities: `formatDate`, `parseDate`, `getMonthRange`, `isDateInRange` |\n| `/workspace/src/utils/format.ts` | Formatting: `formatCurrency`, `formatPercentage`, `calculateTax` (has a known bug) |\n\n### Test files (`tests/`):\n| File | Purpose |\n|---|---|\n| `/workspace/tests/diff-size.test.ts` | Enforces that the solution diff is at most 20 lines changed |\n| `/workspace/tests/invoices.test.ts` | 30 tests covering Invoice CRUD, Billing Calculations, Date Range Queries, and Monthly Reporting |\n| `/workspace/tests/regression.test.ts` | 11 regression tests covering billing totals, date boundary edge cases, and formatting |\n\n### Key behaviors expected by the tests:\n1. **Invoice CRUD** -- create, read by ID, read by customer, read by date range; line items are stored and retrieved correctly; results sorted by date ascending.\n2. **Billing calculations** -- `calculateInvoiceTotal` uses the formula `subtotal * (1 - discountRate) * (1 + taxRate)` with 2-decimal rounding; `applyDiscount` applies discount only; `calculateSubtotal` sums `quantity * unit_price` across line items.\n3. **Date range queries** -- `getInvoicesByDateRange` is documented as inclusive on both ends. The tests expect both the start date and end date to be included in results.\n4. **Monthly reporting** -- `getMonthlyReport` groups invoices by month using UTC-based date parsing, sorts by month ascending, and rounds `total_revenue` to 2 decimals.\n5. **Customer reporting** -- `getCustomerReport` returns `invoice_count`, `total_spent`, and `average_invoice` for a given customer.\n6. **Diff constraint** -- the solution must change at most 20 lines in `src/`."},{"type":"text","text":"agentId: ad6eaec (for resuming to continue this agent's work if needed)\n<usage>total_tokens: 31810\ntool_uses: 13\nduration_ms: 300953</usage>"}]}]},"parent_tool_use_id":null,"session_id":"b05b2ddf-9cd0-4b2e-a4e2-4513919b4a93","uuid":"3f996156-daf2-4154-947d-090a4a028e74","tool_use_result":{"status":"completed","prompt":"Read all files in the src/ directory. List every file and show its full contents. Also read the test files in tests/ directory to understand expected behavior.","agentId":"ad6eaec","content":[{"type":"text","text":"Here is a complete listing of every file in `src/` and `tests/` with their full contents.\n\n---\n\n## src/ Directory (8 files)\n\n---\n\n### 1. `/workspace/src/db/connection.ts`\n\n```typescript\nimport Database from 'better-sqlite3';\n\nexport function createDatabase(filename: string = ':memory:'): Database.Database {\n  const db = new Database(filename);\n\n  db.pragma('journal_mode = WAL');\n\n  db.exec(`\n    CREATE TABLE IF NOT EXISTS invoices (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      customer_id TEXT NOT NULL,\n      date TEXT NOT NULL,\n      subtotal REAL NOT NULL,\n      discount_rate REAL NOT NULL DEFAULT 0,\n      tax_rate REAL NOT NULL DEFAULT 0,\n      total REAL NOT NULL,\n      status TEXT NOT NULL DEFAULT 'draft'\n    );\n\n    CREATE TABLE IF NOT EXISTS line_items (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      invoice_id INTEGER NOT NULL,\n      description TEXT NOT NULL,\n      quantity INTEGER NOT NULL,\n      unit_price REAL NOT NULL,\n      FOREIGN KEY (invoice_id) REFERENCES invoices(id)\n    );\n  `);\n\n  return db;\n}\n```\n\n---\n\n### 2. `/workspace/src/db/queries.ts`\n\n```typescript\nimport type Database from 'better-sqlite3';\nimport type { Invoice, LineItem } from '../models/invoice.js';\n\n/**\n * Retrieve invoices within a date range (inclusive on both ends).\n */\nexport function getInvoicesByDateRange(\n  db: Database.Database,\n  startDate: string,\n  endDate: string,\n): Invoice[] {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE date >= ? AND date < ?\n    ORDER BY date ASC\n  `);\n  return stmt.all(startDate, endDate) as Invoice[];\n}\n\n/**\n * Retrieve a single invoice by ID, including its line items.\n */\nexport function getInvoiceById(\n  db: Database.Database,\n  id: number,\n): (Invoice & { line_items: LineItem[] }) | undefined {\n  const invoiceStmt = db.prepare('SELECT * FROM invoices WHERE id = ?');\n  const invoice = invoiceStmt.get(id) as Invoice | undefined;\n\n  if (!invoice) return undefined;\n\n  const itemsStmt = db.prepare('SELECT * FROM line_items WHERE invoice_id = ?');\n  const line_items = itemsStmt.all(id) as LineItem[];\n\n  return { ...invoice, line_items };\n}\n\n/**\n * Create a new invoice with line items.\n */\nexport function createInvoice(\n  db: Database.Database,\n  data: Invoice & { line_items?: LineItem[] },\n): number {\n  const insertInvoice = db.prepare(`\n    INSERT INTO invoices (customer_id, date, subtotal, discount_rate, tax_rate, total, status)\n    VALUES (?, ?, ?, ?, ?, ?, ?)\n  `);\n\n  const insertLineItem = db.prepare(`\n    INSERT INTO line_items (invoice_id, description, quantity, unit_price)\n    VALUES (?, ?, ?, ?)\n  `);\n\n  const result = insertInvoice.run(\n    data.customer_id,\n    data.date,\n    data.subtotal,\n    data.discount_rate,\n    data.tax_rate,\n    data.total,\n    data.status || 'draft',\n  );\n\n  const invoiceId = result.lastInsertRowid as number;\n\n  if (data.line_items) {\n    for (const item of data.line_items) {\n      insertLineItem.run(invoiceId, item.description, item.quantity, item.unit_price);\n    }\n  }\n\n  return invoiceId;\n}\n\n/**\n * Retrieve all invoices for a specific customer.\n */\nexport function getInvoicesByCustomer(\n  db: Database.Database,\n  customerId: string,\n): Invoice[] {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE customer_id = ?\n    ORDER BY date ASC\n  `);\n  return stmt.all(customerId) as Invoice[];\n}\n```\n\n---\n\n### 3. `/workspace/src/models/invoice.ts`\n\n```typescript\nexport interface LineItem {\n  id?: number;\n  invoice_id?: number;\n  description: string;\n  quantity: number;\n  unit_price: number;\n}\n\nexport interface Invoice {\n  id?: number;\n  customer_id: string;\n  date: string; // ISO date string YYYY-MM-DD\n  subtotal: number;\n  discount_rate: number; // 0.0 to 1.0\n  tax_rate: number; // 0.0 to 1.0\n  total: number;\n  status: 'draft' | 'sent' | 'paid' | 'cancelled';\n  line_items?: LineItem[];\n}\n\nexport interface InvoiceCreateInput {\n  customer_id: string;\n  date: string;\n  discount_rate: number;\n  tax_rate: number;\n  status?: 'draft' | 'sent' | 'paid' | 'cancelled';\n  line_items: LineItem[];\n}\n\nexport interface InvoiceSummary {\n  month: number;\n  year: number;\n  count: number;\n  total_revenue: number;\n}\n\nexport interface CustomerReport {\n  customer_id: string;\n  invoice_count: number;\n  total_spent: number;\n  average_invoice: number;\n}\n```\n\n---\n\n### 4. `/workspace/src/server.ts`\n\n```typescript\nimport express, { type Express } from 'express';\nimport type { Request, Response } from 'express';\nimport type Database from 'better-sqlite3';\nimport { createDatabase } from './db/connection.js';\nimport { getInvoicesByDateRange, getInvoiceById } from './db/queries.js';\nimport { generateInvoice } from './services/billing.js';\nimport { getMonthlyReport, getCustomerReport } from './services/reporting.js';\nimport type { InvoiceCreateInput } from './models/invoice.js';\n\nexport function createApp(dbPath: string = ':memory:'): { app: Express; db: Database.Database } {\n  const app = express();\n  const db = createDatabase(dbPath);\n\n  app.use(express.json());\n\n  // List invoices by date range\n  app.get('/invoices', (req: Request, res: Response) => {\n    const { start, end } = req.query;\n    if (!start || !end) {\n      res.status(400).json({ error: 'start and end query parameters required' });\n      return;\n    }\n    const invoices = getInvoicesByDateRange(db, start as string, end as string);\n    res.json(invoices);\n  });\n\n  // Get invoice by ID\n  app.get('/invoices/:id', (req: Request, res: Response) => {\n    const id = parseInt(req.params.id, 10);\n    if (isNaN(id)) {\n      res.status(400).json({ error: 'Invalid invoice ID' });\n      return;\n    }\n    const invoice = getInvoiceById(db, id);\n    if (!invoice) {\n      res.status(404).json({ error: 'Invoice not found' });\n      return;\n    }\n    res.json(invoice);\n  });\n\n  // Create invoice\n  app.post('/invoices', (req: Request, res: Response) => {\n    const input = req.body as InvoiceCreateInput;\n    if (!input.customer_id || !input.date || !input.line_items?.length) {\n      res.status(400).json({ error: 'customer_id, date, and line_items required' });\n      return;\n    }\n    const id = generateInvoice(db, input);\n    const invoice = getInvoiceById(db, id);\n    res.status(201).json(invoice);\n  });\n\n  // Monthly report\n  app.get('/reports/monthly', (req: Request, res: Response) => {\n    const year = parseInt(req.query.year as string, 10);\n    if (isNaN(year)) {\n      res.status(400).json({ error: 'year query parameter required' });\n      return;\n    }\n    const report = getMonthlyReport(db, year);\n    res.json(report);\n  });\n\n  // Customer report\n  app.get('/reports/customer/:id', (req: Request, res: Response) => {\n    const customerId = req.params.id;\n    const report = getCustomerReport(db, customerId);\n    res.json(report);\n  });\n\n  return { app, db };\n}\n\n// Start server if run directly\nconst isMain = process.argv[1]?.endsWith('server.js') || process.argv[1]?.endsWith('server.ts');\nif (isMain) {\n  const { app } = createApp();\n  const port = process.env.PORT || 3000;\n  app.listen(port, () => {\n    console.log(`Invoice service running on port ${port}`);\n  });\n}\n```\n\n---\n\n### 5. `/workspace/src/services/billing.ts`\n\n```typescript\nimport type Database from 'better-sqlite3';\nimport type { InvoiceCreateInput, Invoice, LineItem } from '../models/invoice.js';\nimport { createInvoice } from '../db/queries.js';\n\n/**\n * Calculate the total for an invoice given subtotal, discount rate, and tax rate.\n *\n * Formula: subtotal * (1 - discountRate) * (1 + taxRate)\n *   - First apply the discount to get the discounted subtotal\n *   - Then apply tax on the discounted amount\n */\nexport function calculateInvoiceTotal(\n  subtotal: number,\n  discountRate: number,\n  taxRate: number,\n): number {\n  const discounted = subtotal * (1 - discountRate);\n  const total = discounted + subtotal * taxRate;\n  return Math.round(total * 100) / 100;\n}\n\n/**\n * Apply a discount to a subtotal.\n */\nexport function applyDiscount(subtotal: number, discountRate: number): number {\n  return Math.round(subtotal * (1 - discountRate) * 100) / 100;\n}\n\n/**\n * Calculate subtotal from line items.\n */\nexport function calculateSubtotal(lineItems: LineItem[]): number {\n  return lineItems.reduce((sum, item) => sum + item.quantity * item.unit_price, 0);\n}\n\n/**\n * Generate an invoice from input data, calculating subtotal and total.\n */\nexport function generateInvoice(\n  db: Database.Database,\n  input: InvoiceCreateInput,\n): number {\n  const subtotal = calculateSubtotal(input.line_items);\n  const total = calculateInvoiceTotal(subtotal, input.discount_rate, input.tax_rate);\n\n  const invoice: Invoice & { line_items: LineItem[] } = {\n    customer_id: input.customer_id,\n    date: input.date,\n    subtotal,\n    discount_rate: input.discount_rate,\n    tax_rate: input.tax_rate,\n    total,\n    status: input.status || 'draft',\n    line_items: input.line_items,\n  };\n\n  return createInvoice(db, invoice);\n}\n```\n\n---\n\n### 6. `/workspace/src/utils/dates.ts`\n\n```typescript\n/**\n * Format a Date object to an ISO date string (YYYY-MM-DD).\n * Uses UTC methods to avoid timezone-related shifts.\n */\n// TODO: fix timezone\nexport function formatDate(date: Date): string {\n  const year = date.getUTCFullYear();\n  const month = String(date.getUTCMonth() + 1).padStart(2, '0');\n  const day = String(date.getUTCDate()).padStart(2, '0');\n  return `${year}-${month}-${day}`;\n}\n\n/**\n * Parse an ISO date string (YYYY-MM-DD) into a Date object.\n * Creates the date in UTC to avoid timezone issues.\n */\nexport function parseDate(str: string): Date {\n  const [year, month, day] = str.split('-').map(Number);\n  return new Date(Date.UTC(year, month - 1, day));\n}\n\n/**\n * Get the start and end dates for a given month.\n * Returns ISO date strings for the first and last day of the month.\n */\nexport function getMonthRange(year: number, month: number): { start: string; end: string } {\n  const start = new Date(Date.UTC(year, month - 1, 1));\n  const end = new Date(Date.UTC(year, month, 0)); // last day of the month\n  return {\n    start: formatDate(start),\n    end: formatDate(end),\n  };\n}\n\n/**\n * Check if a date string falls within a range (inclusive).\n */\nexport function isDateInRange(date: string, start: string, end: string): boolean {\n  return date >= start && date <= end;\n}\n```\n\n---\n\n### 7. `/workspace/src/services/reporting.ts`\n\n```typescript\nimport type Database from 'better-sqlite3';\nimport type { Invoice, InvoiceSummary, CustomerReport } from '../models/invoice.js';\n\n/**\n * Generate a monthly revenue report for a given year.\n * Groups invoices by their UTC month and aggregates totals.\n */\nexport function getMonthlyReport(\n  db: Database.Database,\n  year: number,\n): InvoiceSummary[] {\n  const startDate = `${year}-01-01`;\n  const endDate = `${year}-12-31`;\n\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE date >= ? AND date <= ?\n    ORDER BY date ASC\n  `);\n\n  const invoices = stmt.all(startDate, endDate) as Invoice[];\n\n  // Group invoices by month\n  const monthlyMap = new Map<number, { count: number; total: number }>();\n\n  for (const inv of invoices) {\n    const d = new Date(inv.date + 'T00:00:00Z');\n    const month = d.getMonth() + 1; // 1-indexed\n\n    const current = monthlyMap.get(month) || { count: 0, total: 0 };\n    current.count += 1;\n    current.total += inv.total;\n    monthlyMap.set(month, current);\n  }\n\n  // Convert to array of summaries\n  const summaries: InvoiceSummary[] = [];\n  for (const [month, data] of monthlyMap) {\n    summaries.push({\n      month,\n      year,\n      count: data.count,\n      total_revenue: Math.round(data.total * 100) / 100,\n    });\n  }\n\n  return summaries.sort((a, b) => a.month - b.month);\n}\n\n/**\n * Generate a report for a specific customer.\n */\nexport function getCustomerReport(\n  db: Database.Database,\n  customerId: string,\n): CustomerReport {\n  const stmt = db.prepare(`\n    SELECT * FROM invoices\n    WHERE customer_id = ?\n  `);\n\n  const invoices = stmt.all(customerId) as Invoice[];\n\n  const totalSpent = invoices.reduce((sum, inv) => sum + inv.total, 0);\n\n  return {\n    customer_id: customerId,\n    invoice_count: invoices.length,\n    total_spent: Math.round(totalSpent * 100) / 100,\n    average_invoice: invoices.length > 0\n      ? Math.round((totalSpent / invoices.length) * 100) / 100\n      : 0,\n  };\n}\n\n/**\n * Get total revenue for a date period.\n */\nexport function getRevenueByPeriod(\n  db: Database.Database,\n  start: string,\n  end: string,\n): { total: number; count: number } {\n  const stmt = db.prepare(`\n    SELECT COALESCE(SUM(total), 0) as total, COUNT(*) as count\n    FROM invoices\n    WHERE date >= ? AND date <= ?\n  `);\n\n  const result = stmt.get(start, end) as { total: number; count: number };\n  return {\n    total: Math.round(result.total * 100) / 100,\n    count: result.count,\n  };\n}\n```\n\n---\n\n### 8. `/workspace/src/utils/format.ts`\n\n```typescript\n/**\n * Format a number as a currency string ($X,XXX.XX).\n */\nexport function formatCurrency(amount: number): string {\n  return '$' + amount.toFixed(2).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n}\n\n/**\n * Format a rate (0-1) as a percentage string (XX.X%).\n */\nexport function formatPercentage(rate: number): string {\n  return (rate * 100).toFixed(1) + '%';\n}\n\n/**\n * Calculate tax on an amount.\n * NOTE: This is a legacy utility function, not currently used in the billing pipeline.\n */\nexport function calculateTax(amount: number, rate: number): number {\n  // BUG: applies rate as whole number instead of decimal\n  // e.g., calculateTax(100, 0.08) returns 800 instead of 8\n  return amount * (rate * 100);\n}\n```\n\n---\n\n## tests/ Directory (3 files)\n\n---\n\n### 1. `/workspace/tests/diff-size.test.ts`\n\n```typescript\nimport { describe, it, expect } from 'vitest';\nimport { execSync } from 'child_process';\n\ndescribe('diff constraint', () => {\n  it('solution diff is at most 20 lines', () => {\n    const diff = execSync('git diff HEAD -- src/', { encoding: 'utf-8' });\n    const changedLines = diff\n      .split('\\n')\n      .filter(l => l.startsWith('+') || l.startsWith('-'))\n      .filter(l => !l.startsWith('+++') && !l.startsWith('---')).length;\n    // Skip this test if there's no git diff (solution state)\n    if (changedLines === 0) return;\n    expect(changedLines).toBeLessThanOrEqual(20);\n  });\n});\n```\n\n---\n\n### 2. `/workspace/tests/invoices.test.ts`\n\n```typescript\n// Force a non-UTC timezone so timezone-sensitive bugs are exposed\nprocess.env.TZ = 'America/New_York';\n\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport type Database from 'better-sqlite3';\nimport { createDatabase } from '../src/db/connection.js';\nimport {\n  getInvoicesByDateRange,\n  getInvoiceById,\n  createInvoice,\n  getInvoicesByCustomer,\n} from '../src/db/queries.js';\nimport {\n  calculateInvoiceTotal,\n  applyDiscount,\n  calculateSubtotal,\n  generateInvoice,\n} from '../src/services/billing.js';\nimport { getMonthlyReport, getCustomerReport, getRevenueByPeriod } from '../src/services/reporting.js';\n\nlet db: Database.Database;\n\nbeforeEach(() => {\n  db = createDatabase(':memory:');\n});\n\n// ─── Invoice CRUD (8 tests) ────────────────────────────────────────\n\ndescribe('Invoice CRUD', () => {\n  it('creates an invoice and returns its ID', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-15',\n      subtotal: 100,\n      discount_rate: 0,\n      tax_rate: 0.1,\n      total: 110,\n      status: 'draft',\n    });\n    expect(id).toBe(1);\n  });\n\n  it('retrieves an invoice by ID', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-15',\n      subtotal: 200,\n      discount_rate: 0.1,\n      tax_rate: 0.08,\n      total: 194.40,\n      status: 'sent',\n    });\n    const invoice = getInvoiceById(db, id);\n    expect(invoice).toBeDefined();\n    expect(invoice!.customer_id).toBe('cust-1');\n    expect(invoice!.subtotal).toBe(200);\n  });\n\n  it('returns undefined for non-existent invoice', () => {\n    const invoice = getInvoiceById(db, 999);\n    expect(invoice).toBeUndefined();\n  });\n\n  it('creates an invoice with line items', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-04-01',\n      subtotal: 250,\n      discount_rate: 0,\n      tax_rate: 0.05,\n      total: 262.50,\n      status: 'draft',\n      line_items: [\n        { description: 'Widget A', quantity: 5, unit_price: 30 },\n        { description: 'Widget B', quantity: 2, unit_price: 50 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    expect(invoice!.line_items).toHaveLength(2);\n    expect(invoice!.line_items[0].description).toBe('Widget A');\n  });\n\n  it('lists invoices by customer', () => {\n    createInvoice(db, {\n      customer_id: 'cust-A',\n      date: '2024-01-10',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-B',\n      date: '2024-01-12',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-A',\n      date: '2024-02-05',\n      subtotal: 150, discount_rate: 0, tax_rate: 0, total: 150, status: 'draft',\n    });\n\n    const invoices = getInvoicesByCustomer(db, 'cust-A');\n    expect(invoices).toHaveLength(2);\n    expect(invoices.every(inv => inv.customer_id === 'cust-A')).toBe(true);\n  });\n\n  it('returns invoices sorted by date', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-15',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'draft',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-01-10',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'draft',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-02-20',\n      subtotal: 150, discount_rate: 0, tax_rate: 0, total: 150, status: 'draft',\n    });\n\n    const invoices = getInvoicesByDateRange(db, '2024-01-01', '2024-12-31');\n    expect(invoices[0].date).toBe('2024-01-10');\n    expect(invoices[1].date).toBe('2024-02-20');\n    expect(invoices[2].date).toBe('2024-03-15');\n  });\n\n  it('stores invoice status correctly', () => {\n    const id = createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-06-01',\n      subtotal: 500, discount_rate: 0.05, tax_rate: 0.1, total: 522.50,\n      status: 'paid',\n    });\n    const invoice = getInvoiceById(db, id);\n    expect(invoice!.status).toBe('paid');\n  });\n\n  it('calculates subtotal from line items', () => {\n    const items = [\n      { description: 'Item A', quantity: 3, unit_price: 10 },\n      { description: 'Item B', quantity: 1, unit_price: 25.50 },\n      { description: 'Item C', quantity: 2, unit_price: 7.25 },\n    ];\n    expect(calculateSubtotal(items)).toBe(70);\n  });\n});\n\n// ─── Billing Calculations (8 tests) ────────────────────────────────\n\ndescribe('Billing Calculations', () => {\n  it('calculates total without discount', () => {\n    // subtotal=100, no discount, 10% tax => 110\n    const total = calculateInvoiceTotal(100, 0, 0.1);\n    expect(total).toBe(110);\n  });\n\n  it('calculates total with 10% discount', () => {\n    // subtotal=200, 10% discount => 180, then 8% tax => 194.40\n    const total = calculateInvoiceTotal(200, 0.1, 0.08);\n    expect(total).toBe(194.40);\n  });\n\n  it('calculates total with 25% discount and 8% tax', () => {\n    // subtotal=400, 25% discount => 300, 8% tax => 324\n    const total = calculateInvoiceTotal(400, 0.25, 0.08);\n    expect(total).toBe(324);\n  });\n\n  it('applies discount correctly', () => {\n    expect(applyDiscount(200, 0.15)).toBe(170);\n  });\n\n  it('handles zero tax rate', () => {\n    const total = calculateInvoiceTotal(500, 0.2, 0);\n    expect(total).toBe(400);\n  });\n\n  it('handles zero subtotal', () => {\n    const total = calculateInvoiceTotal(0, 0.1, 0.08);\n    expect(total).toBe(0);\n  });\n\n  it('generates invoice with correct total', () => {\n    const id = generateInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-05-10',\n      discount_rate: 0,\n      tax_rate: 0.08,\n      line_items: [\n        { description: 'Service', quantity: 1, unit_price: 1000 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    // 1000 * 1.0 * 1.08 = 1080\n    expect(invoice!.total).toBe(1080);\n  });\n\n  it('generates invoice with multiple line items and discount', () => {\n    const id = generateInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-07-20',\n      discount_rate: 0.15,\n      tax_rate: 0,\n      line_items: [\n        { description: 'Product A', quantity: 10, unit_price: 50 },\n        { description: 'Product B', quantity: 5, unit_price: 100 },\n      ],\n    });\n    const invoice = getInvoiceById(db, id);\n    // subtotal = 500 + 500 = 1000\n    // discounted = 1000 * 0.85 = 850\n    // total = 850 * 1.0 = 850\n    expect(invoice!.total).toBe(850);\n  });\n});\n\n// ─── Date Range Queries (7 tests) ──────────────────────────────────\n\ndescribe('Date Range Queries', () => {\n  beforeEach(() => {\n    // Seed some invoices across different dates\n    const dates = [\n      '2024-01-15', '2024-01-31', '2024-02-01',\n      '2024-02-28', '2024-03-01', '2024-03-31',\n      '2024-06-30',\n    ];\n    dates.forEach((date, i) => {\n      createInvoice(db, {\n        customer_id: `cust-${i}`,\n        date,\n        subtotal: (i + 1) * 100,\n        discount_rate: 0,\n        tax_rate: 0,\n        total: (i + 1) * 100,\n        status: 'paid',\n      });\n    });\n  });\n\n  it('returns invoices within a date range', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-02-01', '2024-03-15');\n    expect(invoices).toHaveLength(3);\n  });\n\n  it('returns empty array when no invoices match', () => {\n    const invoices = getInvoicesByDateRange(db, '2025-01-01', '2025-12-31');\n    expect(invoices).toHaveLength(0);\n  });\n\n  it('includes invoices on start date boundary', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-01-15', '2024-01-20');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-01-15');\n  });\n\n  it('includes invoices on end date boundary', () => {\n    // Should include the invoice on 2024-03-31\n    const invoices = getInvoicesByDateRange(db, '2024-03-15', '2024-03-31');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-03-31');\n  });\n\n  it('handles single-month range correctly', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-02-01', '2024-02-29');\n    expect(invoices).toHaveLength(2);\n  });\n\n  it('returns all invoices for full year range', () => {\n    const invoices = getInvoicesByDateRange(db, '2024-01-01', '2024-12-31');\n    expect(invoices).toHaveLength(7);\n  });\n\n  it('handles cross-month boundary range', () => {\n    // Jan 15 to Mar 02 should span across months\n    const invoices = getInvoicesByDateRange(db, '2024-01-15', '2024-03-02');\n    expect(invoices).toHaveLength(5);\n  });\n});\n\n// ─── Monthly Reporting (7 tests) ───────────────────────────────────\n\ndescribe('Monthly Reporting', () => {\n  beforeEach(() => {\n    // Seed invoices across months (avoiding 1st-of-month dates in seed data)\n    const data: { date: string; total: number }[] = [\n      { date: '2024-01-10', total: 100 },\n      { date: '2024-01-25', total: 200 },\n      { date: '2024-02-15', total: 300 },\n      { date: '2024-03-10', total: 400 },\n      { date: '2024-03-20', total: 150 },\n    ];\n    data.forEach(({ date, total }) => {\n      createInvoice(db, {\n        customer_id: 'cust-1',\n        date,\n        subtotal: total,\n        discount_rate: 0,\n        tax_rate: 0,\n        total,\n        status: 'paid',\n      });\n    });\n  });\n\n  it('generates monthly report with correct counts', () => {\n    const report = getMonthlyReport(db, 2024);\n    expect(report).toHaveLength(3);\n    expect(report[0].count).toBe(2); // January\n    expect(report[1].count).toBe(1); // February\n    expect(report[2].count).toBe(2); // March\n  });\n\n  it('generates monthly report with correct totals', () => {\n    const report = getMonthlyReport(db, 2024);\n    expect(report[0].total_revenue).toBe(300); // Jan: 100 + 200\n    expect(report[1].total_revenue).toBe(300); // Feb: 300\n    expect(report[2].total_revenue).toBe(550); // Mar: 400 + 150\n  });\n\n  it('returns empty report for year with no invoices', () => {\n    const report = getMonthlyReport(db, 2025);\n    expect(report).toHaveLength(0);\n  });\n\n  it('groups invoices correctly at month boundaries', () => {\n    // Add invoices at exact month boundaries\n    createInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-01-31',\n      subtotal: 50, discount_rate: 0, tax_rate: 0, total: 50, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-2',\n      date: '2024-02-01',\n      subtotal: 75, discount_rate: 0, tax_rate: 0, total: 75, status: 'paid',\n    });\n\n    const report = getMonthlyReport(db, 2024);\n    const jan = report.find(r => r.month === 1)!;\n    const feb = report.find(r => r.month === 2)!;\n\n    // Jan should have 3 invoices (10th, 25th, 31st) = 100 + 200 + 50 = 350\n    expect(jan.count).toBe(3);\n    expect(jan.total_revenue).toBe(350);\n\n    // Feb should have 2 invoices (15th, 1st) = 300 + 75 = 375\n    expect(feb.count).toBe(2);\n    expect(feb.total_revenue).toBe(375);\n  });\n\n  it('reports correct year in summaries', () => {\n    const report = getMonthlyReport(db, 2024);\n    expect(report.every(r => r.year === 2024)).toBe(true);\n  });\n\n  it('calculates customer report correctly', () => {\n    const report = getCustomerReport(db, 'cust-1');\n    expect(report.invoice_count).toBe(5);\n    expect(report.total_spent).toBe(1150);\n    expect(report.average_invoice).toBe(230);\n  });\n\n  it('calculates revenue by period', () => {\n    const result = getRevenueByPeriod(db, '2024-01-01', '2024-02-28');\n    expect(result.count).toBe(3);\n    expect(result.total).toBe(600); // 100 + 200 + 300\n  });\n});\n```\n\n---\n\n### 3. `/workspace/tests/regression.test.ts`\n\n```typescript\n// Force a non-UTC timezone so timezone-sensitive bugs are exposed\nprocess.env.TZ = 'America/New_York';\n\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport type Database from 'better-sqlite3';\nimport { createDatabase } from '../src/db/connection.js';\nimport { createInvoice, getInvoicesByDateRange } from '../src/db/queries.js';\nimport { calculateInvoiceTotal } from '../src/services/billing.js';\nimport { getMonthlyReport } from '../src/services/reporting.js';\nimport { formatDate } from '../src/utils/dates.js';\n\nlet db: Database.Database;\n\nbeforeEach(() => {\n  db = createDatabase(':memory:');\n});\n\ndescribe('Regression Tests', () => {\n  it('discount calculation with 15% rate produces correct total', () => {\n    // subtotal=500, 15% discount => 425, 10% tax => 467.50\n    const total = calculateInvoiceTotal(500, 0.15, 0.1);\n    expect(total).toBe(467.5);\n  });\n\n  it('tax and discount combined for small invoice', () => {\n    // subtotal=50, 20% discount => 40, 5% tax => 42\n    const total = calculateInvoiceTotal(50, 0.2, 0.05);\n    expect(total).toBe(42);\n  });\n\n  it('date range query includes end date boundary', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-06-30',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    const invoices = getInvoicesByDateRange(db, '2024-06-01', '2024-06-30');\n    expect(invoices).toHaveLength(1);\n    expect(invoices[0].date).toBe('2024-06-30');\n  });\n\n  it('month boundary grouping assigns first day to correct month', () => {\n    // Invoice on March 1 should be in month 3, not month 2\n    createInvoice(db, {\n      customer_id: 'cust-1',\n      date: '2024-03-01',\n      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    });\n    const report = getMonthlyReport(db, 2024);\n    const march = report.find(r => r.month === 3);\n    const feb = report.find(r => r.month === 2);\n\n    expect(march).toBeDefined();\n    expect(march!.count).toBe(1);\n    expect(march!.total_revenue).toBe(200);\n    expect(feb).toBeUndefined();\n  });\n\n  it('multiple months reporting shows correct distribution', () => {\n    createInvoice(db, {\n      customer_id: 'cust-1', date: '2024-04-15',\n      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    });\n    createInvoice(db, {\n      customer_id: 'cust-1', date: '2024-05-15',\n  