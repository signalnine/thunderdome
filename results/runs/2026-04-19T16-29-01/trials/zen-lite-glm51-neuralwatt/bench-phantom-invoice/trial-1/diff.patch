;\n    55→    expect(invoice!.customer_id).toBe('cust-1');\n    56→    expect(invoice!.subtotal).toBe(200);\n    57→  });\n    58→\n    59→  it('returns undefined for non-existent invoice', () => {\n    60→    const invoice = getInvoiceById(db, 999);\n    61→    expect(invoice).toBeUndefined();\n    62→  });\n    63→\n    64→  it('creates an invoice with line items', () => {\n    65→    const id = createInvoice(db, {\n    66→      customer_id: 'cust-2',\n    67→      date: '2024-04-01',\n    68→      subtotal: 250,\n    69→      discount_rate: 0,\n    70→      tax_rate: 0.05,\n    71→      total: 262.50,\n    72→      status: 'draft',\n    73→      line_items: [\n    74→        { description: 'Widget A', quantity: 5, unit_price: 30 },\n    75→        { description: 'Widget B', quantity: 2, unit_price: 50 },\n    76→      ],\n    77→    });\n    78→    const invoice = getInvoiceById(db, id);\n    79→    expect(invoice!.line_items).toHaveLength(2);\n    80→    expect(invoice!.line_items[0].description).toBe('Widget A');\n    81→  });\n    82→\n    83→  it('lists invoices by customer', () => {\n    84→    createInvoice(db, {\n    85→      customer_id: 'cust-A',\n    86→      date: '2024-01-10',\n    87→      subtotal: 100, discount_rate: 0, tax_rate: 0, total: 100, status: 'paid',\n    88→    });\n    89→    createInvoice(db, {\n    90→      customer_id: 'cust-B',\n    91→      date: '2024-01-12',\n    92→      subtotal: 200, discount_rate: 0, tax_rate: 0, total: 200, status: 'paid',\n    93→    });\n    94→    createInvoice(db, {\n    95→      customer_id: 'cust-A',\n    96→      date: '2024-02-05',\n    97→      subtotal: 150, discount_rate: 0, tax_rate: 0, total: 150, status: 'draft',\n    98→    });\n    99→\n   100→    const invoices = getInvoicesByCustomer(db, 'cust-A');\n   101→    expect(invoices).toHaveLength(2);\n   102→    expect(invoices.every(inv => inv.customer_id === 'cust-A')).toBe(true);\n   103→  });\n   104→\n   105→  it('returns invoices sorted by d