{\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":[" import { Router, Request, Response, NextFunction } from 'express';"," import Database from 'better-sqlite3';","-import { Note, NoteInput } from './models.js';","+import { Note, NoteInput, SearchResult, SuggestResult } from './models.js';"," import { NotFoundError, ValidationError } from './errors.js';"," "," export function createRoutes(db: Database.Database): Router {"]}],"userModified":false,"replaceAll":false}}
