 ValidationError('Title is required');\n      }\n      if (!input.body || input.body.trim() === '') {\n        throw new ValidationError('Body is required');\n      }\n\n      const tags = input.tags ? JSON.stringify(input.tags) : '[]';\n      const stmt = db.prepare(`\n        INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n      `);\n      const result = stmt.run(input.title, input.body, tags);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(result.lastInsertRowid) as Note;\n      res.status(201).json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // PUT /notes/:id - Update note\n  router.put('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      const input = req.body as Partial<NoteInput>;\n      const title = input.title ?? existing.title;\n      const body = input.body ?? existing.body;\n      const tags = input.tags ? JSON.stringify(input.tags) : existing.tags;\n\n      const stmt = db.prepare(`\n        UPDATE notes SET title = ?, body = ?, tags = ?, updated_at = datetime('now')\n        WHERE id = ?\n      `);\n      stmt.run(title, body, tags, id);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note;\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}\n","structuredPatch":[{"oldStart":31,"oldLines":6,"newStart":31,"newLines":109,"lines":["     }","   });"," ","+  // GET /notes/search - Full-text search","+  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {","+    try {","+      const q = req.query.q as string | undefined;","+","+      if (!q || q.trim() === '') {","+        throw new ValidationError('Search query is required');","+      }","+","+      const page = Math.max(1, parseInt(req.query.page as string) || 1);","+      const perPage = 20;","+      const offset = (page - 1) * perPage;","+","+      // Escape FTS5 special characters for safe querying","+      let ftsQuery = q;","+      // If the query contains quoted phrases, preserve them; otherwise escape special chars","+      if (!/\"/.test(ftsQuery)) {","+        // Remove FTS5 special characters that could cause syntax errors","+        ftsQuery = ftsQuery.replace(/[{}()*+\\-:]/g, ' ').trim();","+        // Split into words and join with OR for broader matching","+        const words = ftsQuery.split(/\\s+/).filter(w => w.length > 0);","+        if (words.length === 0) {","+          res.json({ results: [], total: 0, page, perPage });","+          return;","+        }","+        ftsQuery = words.join(' OR ');","+      } else {","+        // Preserve quoted phrases but escape other special chars outside quotes","+        // Just remove problematic chars outside of quoted sections","+        ftsQuery = ftsQuery.replace(/[{}()*+\\-:]/g, (match, offset) => {","+          // Check if we're inside a quoted phrase","+          const before = ftsQuery.substring(0, offset);","+          const quoteCount = (before.match(/\"/g) || []).length;","+          if (quoteCount % 2 === 1) {","+            return match; // Inside quotes, keep it","+          }","+          return ' '; // Outside quotes, replace with space","+        }).trim();",