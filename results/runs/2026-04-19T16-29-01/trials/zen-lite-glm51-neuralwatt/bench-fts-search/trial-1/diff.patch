ults });\n    } catch (err) {\n      next(err);\n    }\n  });","newString":"  // Helper: build safe FTS5 query string\n  function buildFtsQuery(q: string): string {\n    // Check for quoted phrases\n    const hasQuotes = /\"/.test(q);\n\n    if (hasQuotes) {\n      // Preserve quoted phrases, strip special chars outside quotes\n      let result = '';\n      let inQuote = false;\n      for (let i = 0; i < q.length; i++) {\n        const ch = q[i];\n        if (ch === '\"') {\n          inQuote = !inQuote;\n          result += ch;\n        } else if (inQuote) {\n          result += ch;\n        } else if (/[a-zA-Z0-9\\s]/.test(ch)) {\n          result += ch;\n        }\n        // drop other special chars outside quotes\n      }\n      return result.trim();\n    }\n\n    // No quotes: sanitize individual words and join with OR\n    const words = q.replace(/[^a-zA-Z0-9\\s]/g, ' ').trim().split(/\\s+/).filter(w => w.length > 0);\n    return words.join(' OR ');\n  }\n\n  // GET /notes/search - Full-text search\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string | undefined;\n\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Search query is required');\n      }\n\n      const page = Math.max(1, parseInt(req.query.page as string) || 1);\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      const ftsQuery = buildFtsQuery(q);\n      if (!ftsQuery) {\n        res.json({ results: [], total: 0, page, perPage });\n        return;\n      }\n\n      try {\n        // Count total results\n        const countStmt = db.prepare(`\n          SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n        `);\n        const { total } = countStmt.get(ftsQuery) as { total: number };\n\n        // Get search results with BM25 ranking and snippet highlighting\n        const stmt = db.prepare(`\n          SELECT\n            f.rowid as id,\n           