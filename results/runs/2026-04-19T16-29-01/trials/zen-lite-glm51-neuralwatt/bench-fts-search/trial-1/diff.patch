eInput, SearchResult, SuggestResult } from './models.js';\nimport { NotFoundError, ValidationError } from './errors.js';\n\nexport function createRoutes(db: Database.Database): Router {\n  const router = Router();\n\n  // GET /notes - List all notes (with optional tag filter)\n  router.get('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const tag = req.query.tag as string | undefined;\n\n      let notes: Note[];\n      if (tag) {\n        // Use a join with json_each for tag filtering\n        const tagStmt = db.prepare(`\n          SELECT DISTINCT notes.* FROM notes, json_each(notes.tags)\n          WHERE json_each.value = ?\n          ORDER BY created_at DESC\n        `);\n        notes = tagStmt.all(tag) as Note[];\n      } else {\n        const stmt = db.prepare('SELECT * FROM notes ORDER BY created_at DESC');\n        notes = stmt.all() as Note[];\n      }\n\n      res.json({ notes });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search - Full-text search\n  router.get('/notes/search', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string | undefined;\n\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Search query is required');\n      }\n\n      const page = Math.max(1, parseInt(req.query.page as string) || 1);\n      const perPage = 20;\n      const offset = (page - 1) * perPage;\n\n      // Escape FTS5 special characters for safe querying\n      let ftsQuery = q;\n      // If the query contains quoted phrases, preserve them; otherwise escape special chars\n      if (!/\"/.test(ftsQuery)) {\n        // Remove FTS5 special characters that could cause syntax errors\n        ftsQuery = ftsQuery.replace(/[{}()*+\\-:]/g, ' ').trim();\n        // Split into words and join with OR for broader matching\n        const words = ftsQuery.split(/\\s+/).filter(w => w.length > 0);\n        if (words.length === 0) {\n          res.json({ results: [], total: 0, page, perPage });\n          return;\n        }\n        ftsQuery = words.join(' OR ');\n      } else {\n        // Preserve quoted phrases but escape other special chars outside quotes\n        // Just remove problematic chars outside of quoted sections\n        ftsQuery = ftsQuery.replace(/[{}()*+\\-:]/g, (match, offset) => {\n          // Check if we're inside a quoted phrase\n          const before = ftsQuery.substring(0, offset);\n          const quoteCount = (before.match(/\"/g) || []).length;\n          if (quoteCount % 2 === 1) {\n            return match; // Inside quotes, keep it\n          }\n          return ' '; // Outside quotes, replace with space\n        }).trim();\n      }\n\n      // Count total results\n      const countStmt = db.prepare(`\n        SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n      `);\n      const { total } = countStmt.get(ftsQuery) as { total: number };\n\n      // Get search results with BM25 ranking and snippet highlighting\n      const stmt = db.prepare(`\n        SELECT\n          f.rowid as id,\n          n.title,\n          snippet(notes_fts, 0, '<mark>', '</mark>', '...', 20) as snippet,\n          bm25(notes_fts) as rank\n        FROM notes_fts f\n        JOIN notes n ON f.rowid = n.id\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT ? OFFSET ?\n      `);\n      const results = stmt.all(ftsQuery, perPage, offset) as SearchResult[];\n\n      res.json({ results, total, page, perPage });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/search/suggest - Autocomplete suggestions\n  router.get('/notes/search/suggest', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const q = req.query.q as string | undefined;\n\n      if (!q || q.trim() === '') {\n        throw new ValidationError('Suggest query is required');\n      }\n\n      // Escape FTS5 special characters\n      const prefix = q.replace(/[{}()*+\\-:]/g, ' ').trim();\n      if (prefix.length === 0) {\n        res.json({ results: [] });\n        return;\n      }\n\n      // Use prefix query with * for autocomplete matching\n      const words = prefix.split(/\\s+/).filter(w => w.length > 0);\n      const ftsQuery = words.map(w => w + '*').join(' ');\n\n      const stmt = db.prepare(`\n        SELECT f.rowid as id, n.title\n        FROM notes_fts f\n        JOIN notes n ON f.rowid = n.id\n        WHERE notes_fts MATCH ?\n        ORDER BY rank\n        LIMIT 5\n      `);\n      const results = stmt.all(ftsQuery) as SuggestResult[];\n\n      res.json({ results });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // GET /notes/:id - Get single note\n  router.get('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const stmt = db.prepare('SELECT * FROM notes WHERE id = ?');\n      const note = stmt.get(id) as Note | undefined;\n\n      if (!note) {\n        throw new NotFoundError('Note not found');\n      }\n\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // POST /notes - Create note\n  router.post('/notes', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const input = req.body as NoteInput;\n\n      if (!input.title || input.title.trim() === '') {\n        throw new ValidationError('Title is required');\n      }\n      if (!input.body || input.body.trim() === '') {\n        throw new ValidationError('Body is required');\n      }\n\n      const tags = input.tags ? JSON.stringify(input.tags) : '[]';\n      const stmt = db.prepare(`\n        INSERT INTO notes (title, body, tags) VALUES (?, ?, ?)\n      `);\n      const result = stmt.run(input.title, input.body, tags);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(result.lastInsertRowid) as Note;\n      res.status(201).json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // PUT /notes/:id - Update note\n  router.put('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      const input = req.body as Partial<NoteInput>;\n      const title = input.title ?? existing.title;\n      const body = input.body ?? existing.body;\n      const tags = input.tags ? JSON.stringify(input.tags) : existing.tags;\n\n      const stmt = db.prepare(`\n        UPDATE notes SET title = ?, body = ?, tags = ?, updated_at = datetime('now')\n        WHERE id = ?\n      `);\n      stmt.run(title, body, tags, id);\n\n      const note = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note;\n      res.json({ note });\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  // DELETE /notes/:id - Delete note\n  router.delete('/notes/:id', (req: Request, res: Response, next: NextFunction) => {\n    try {\n      const id = parseInt(req.params.id);\n      const existing = db.prepare('SELECT * FROM notes WHERE id = ?').get(id) as Note | undefined;\n\n      if (!existing) {\n        throw new NotFoundError('Note not found');\n      }\n\n      db.prepare('DELETE FROM notes WHERE id = ?').run(id);\n      res.status(204).send();\n    } catch (err) {\n      next(err);\n    }\n  });\n\n  return router;\n}\n","numLines":226,"startLine":1,"totalLines":226}}}
