 - 1) * perPage;\n    46→\n    47→      // Escape FTS5 special characters for safe querying\n    48→      let ftsQuery = q;\n    49→      // If the query contains quoted phrases, preserve them; otherwise escape special chars\n    50→      if (!/\"/.test(ftsQuery)) {\n    51→        // Remove FTS5 special characters that could cause syntax errors\n    52→        ftsQuery = ftsQuery.replace(/[{}()*+\\-:]/g, ' ').trim();\n    53→        // Split into words and join with OR for broader matching\n    54→        const words = ftsQuery.split(/\\s+/).filter(w => w.length > 0);\n    55→        if (words.length === 0) {\n    56→          res.json({ results: [], total: 0, page, perPage });\n    57→          return;\n    58→        }\n    59→        ftsQuery = words.join(' OR ');\n    60→      } else {\n    61→        // Preserve quoted phrases but escape other special chars outside quotes\n    62→        // Just remove problematic chars outside of quoted sections\n    63→        ftsQuery = ftsQuery.replace(/[{}()*+\\-:]/g, (match, offset) => {\n    64→          // Check if we're inside a quoted phrase\n    65→          const before = ftsQuery.substring(0, offset);\n    66→          const quoteCount = (before.match(/\"/g) || []).length;\n    67→          if (quoteCount % 2 === 1) {\n    68→            return match; // Inside quotes, keep it\n    69→          }\n    70→          return ' '; // Outside quotes, replace with space\n    71→        }).trim();\n    72→      }\n    73→\n    74→      // Count total results\n    75→      const countStmt = db.prepare(`\n    76→        SELECT COUNT(*) as total FROM notes_fts WHERE notes_fts MATCH ?\n    77→      `);\n    78→      const { total } = countStmt.get(ftsQuery) as { total: number };\n    79→\n    80→      // Get search results with BM25 ranking and snippet highlighting\n    81→      const stmt = db.prepare(`\n    82→        SELECT\n    83→          f.rowid as id,\n    84→          n.title,\n    85→          snippet(notes_fts, 0, 