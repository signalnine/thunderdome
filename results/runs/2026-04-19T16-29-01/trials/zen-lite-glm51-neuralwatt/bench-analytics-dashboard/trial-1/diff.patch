+import { Router, Response } from 'express';
+import { v4 as uuidv4 } from 'uuid';
+import { getDatabase } from '../db.js';
+import { authMiddleware, AuthenticatedRequest } from '../auth.js';
+
+const router = Router();
+
+// POST /events - ingest a single event
+router.post('/', authMiddleware, (req: AuthenticatedRequest, res: Response): void => {
+  const { name, properties, timestamp } = req.body;
+  if (!name) {
+    res.status(400).json({ error: 'Event name is required' });
+    return;
+  }
+
+  const db = getDatabase();
+  const id = uuidv4();
+  const props = properties ? JSON.stringify(properties) : '{}';
+  const ts = timestamp ?? new Date().toISOString();
+
+  db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id) VALUES (?, ?, ?, ?, ?, ?)'
+  ).run(id, req.user!.tenantId, name, props, ts, req.user!.userId);
+
+  res.status(201).json({ id, name, properties: properties ?? {}, timestamp: ts });
+});
+
+// POST /events/batch - ingest multiple events
+router.post('/batch', authMiddleware, (req: AuthenticatedRequest, res: Response): void => {
+  const { events } = req.body;
+  if (!Array.isArray(events) || events.length === 0) {
+    res.status(400).json({ error: 'events array is required' });
+    return;
+  }
+
+  const db = getDatabase();
+  const insert = db.prepare(
+    'INSERT INTO events (id, tenant_id, name, properties, timestamp, user_id) VALUES (?, ?, ?, ?, ?, ?)'
+  );
+
+  const results: Array<{ id: string; name: string; timestamp: string }> = [];
+  const insertMany = db.transaction(() => {
+    for (const event of events) {
+      if (!event.name) continue;
+      const id = uuidv4();
+      const props = event.properties ? JSON.stringify(event.properties) : '{}';
+      const ts = event.timestamp ?? new Date().toISOString();
+      insert.run(id, req.user!.tenantId, event.name, props, ts, req.user!.userId);
+      results.push({ id, name: event.name, timestamp: ts });
+    }
+  });
+
+  insertMany();
+  res.status(201).json({ ingested: results.length, events: results });
+});
+
+export default router;
