+const router = Router();
+
+// GET /exports/events
+router.get('/events', authMiddleware, (req: AuthenticatedRequest, res: Response): void => {
+  const db = getDatabase();
+  const format = req.query.format === 'csv' ? 'csv' : 'json';
+  const events = db.prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp DESC').all(req.user!.tenantId) as Array<{
