+{"type":"assistant","message":{"id":"chatcmpl-bad7a1b3a9cb7115","content":[{"type":"tool_use","id":"chatcmpl-tool-96dbceaedad0393a","name":"Write","input":{"file_path":"/workspace/src/routes/exports.ts","content":"import { Router, Response } from 'express';\nimport { getDatabase } from '../db.js';\nimport { authMiddleware, AuthenticatedRequest } from '../auth.js';\n\nconst router = Router();\n\n// GET /exports/events\nrouter.get('/events', authMiddleware, (req: AuthenticatedRequest, res: Response): void => {\n  const db = getDatabase();\n  const format = req.query.format === 'csv' ? 'csv' : 'json';\n  const events = db.prepare('SELECT * FROM events WHERE tenant_id = ? ORDER BY timestamp DESC').all(req.user!.tenantId) as Array<{\n    id: string; tenant_id: string; name: string; properties: string; timestamp: string; user_id: string | null; session_id: string | null;\n  }>;\n\n  if (format === 'csv') {\n    const header = 'id,name,properties,timestamp,user_id,session_id';\n    const rows = events.map(e => {\n      const props = JSON.stringify(JSON.parse(e.properties)).replace(/\"/g, '\"\"');\n      return `${e.id},\"${e.name}\",\"${props}\",\"${e.timestamp}\",\"${e.user_id ?? ''}\",\"${e.session_id ?? ''}\"`;\n    });\n    res.setHeader('Content-Type', 'text/csv');\n    res.setHeader('Content-Disposition', 'attachment; filename=events.csv');\n    res.send([header, ...rows].join('\\n'));\n  } else {\n    res.json(events.map(e => ({\n      id: e.id,\n      name: e.name,\n      properties: JSON.parse(e.properties),\n      timestamp: e.timestamp,\n      userId: e.user_id,\n      sessionId: e.session_id,\n    })));\n  }\n});\n\n// GET /exports/dashboards\nrouter.get('/dashboards', authMiddleware, (req: AuthenticatedRequest, res: Response): void => {\n  const db = getDatabase();\n  const format = req.query.format === 'csv' ? 'csv' : 'json';\n  const dashboards = db.prepare('SELECT * FROM dashboards WHERE tenant_id = ? ORDER BY created_at DESC').all(req.user!.tenantId) as Array<{\n    id: string; tenant_id: string; name: string; owner_id: string; config: string; created_at: string; updated_at: string;\n  }>;\n\n  if (format === 'csv') {\n    const header = 'id,name,owner_id,config,created_at,updated_at';\n    const rows = dashboards.map(d => {\n      const config = JSON.stringify(JSON.parse(d.config)).replace(/\"/g, '\"\"');\n      return `${d.id},\"${d.name}\",\"${d.owner_id}\",\"${config}\",\"${d.created_at}\",\"${d.updated_at}\"`;\n    });\n    res.setHeader('Content-Type', 'text/csv');\n    res.setHeader('Content-Disposition', 'attachment; filename=dashboards.csv');\n    res.send([header, ...rows].join('\\n'));\n  } else {\n    res.json(dashboards.map(d => ({\n      id: d.id,\n      name: d.name,\n      ownerId: d.owner_id,\n      config: JSON.parse(d.config),\n      createdAt: d.created_at,\n      updatedAt: d.updated_at,\n    })));\n  }\n});\n\nexport default router;\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":35723,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"2a14cca7-b0c6-41bf-a0d0-db5ce0123590","uuid":"46dad136-4df1-45ef-9ede-5ff7884d7b0f"}
