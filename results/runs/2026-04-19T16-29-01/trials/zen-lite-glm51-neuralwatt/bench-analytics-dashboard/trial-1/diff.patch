a5-9a46-67967df0df0d","tool_use_result":{"type":"text","file":{"filePath":"/workspace/src/routes/queries.ts","content":"import { Router, Request, Response } from 'express';\nimport { getDatabase } from '../db.js';\nimport { authMiddleware } from '../auth.js';\n\nconst router = Router();\n\nfunction buildWhereClause(tenantId: string, filters: Record<string, unknown>): { sql: string; params: unknown[] } {\n  const conditions = ['e.tenant_id = ?'];\n  const params: unknown[] = [tenantId];\n\n  if (filters.name) {\n    conditions.push('e.name = ?');\n    params.push(filters.name);\n  }\n  if (filters.from) {\n    conditions.push('e.timestamp >= ?');\n    params.push(filters.from);\n  }\n  if (filters.to) {\n    conditions.push('e.timestamp <= ?');\n    params.push(filters.to);\n  }\n\n  return { sql: conditions.join(' AND '), params };\n}\n\n// POST /queries/count\nrouter.post('/count', authMiddleware, (req: Request, res: Response): void => {\n  const { name, from, to } = req.body;\n  const { sql, params } = buildWhereClause(req.user!.tenantId, { name, from, to });\n\n  const db = getDatabase();\n  const row = db.prepare(`SELECT COUNT(*) as count FROM events e WHERE ${sql}`).get(...params) as { count: number };\n  res.json({ count: row.count });\n});\n\n// POST /queries/timeseries\nrouter.post('/timeseries', authMiddleware, (req: Request, res: Response): void => {\n  const { name, from, to, interval } = req.body;\n  const { sql, params } = buildWhereClause(req.user!.tenantId, { name, from, to });\n\n  const db = getDatabase();\n  let dateFormat: string;\n  switch (interval) {\n    case 'hour':\n      dateFormat = '%Y-%m-%d %H:00:00';\n      break;\n    case 'week':\n      dateFormat = '%Y-W%W';\n      break;\n    case 'month':\n      dateFormat = '%Y-%m';\n      break;\n    default:\n      dateFormat = '%Y-%m-%d';\n  }\n\n  const rows = db.prepare(\n    `SELECT strftime('${dateFormat}', e.timestamp) as bucket, COUNT(*) as count FROM events e WHERE ${sql} GROUP BY bucket ORDER BY bucket`\n  ).all(...params) as Array<{ bucket: string; count: number }>;\n\n  res.json({ interval: interval ?? 'day', data: rows });\n});\n\n// POST /queries/breakdown\nrouter.post('/breakdown', authMiddleware, (req: Request, res: Response): void => {\n  const { name, from, to, property } = req.body;\n  if (!property) {\n    res.status(400).json({ error: 'property is required for breakdown queries' });\n    return;\n  }\n\n  const { sql, params } = buildWhereClause(req.user!.tenantId, { name, from, to });\n\n  const db = getDatabase();\n  // Extract property from JSON properties field using json_extract\n  const rows = db.prepare(\n    `SELECT json_extract(e.properties, '$.${property}') as value, COUNT(*) as count FROM events e WHERE ${sql} GROUP BY value ORDER BY count DESC`\n  ).all(...params) as Array<{ value: string | null; count: number }>;\n\n  res.json({ property, data: rows });\n});\n\nexport default router;\n","numLines":85,"startLine":1,"totalLines":85}}}
