+// Direction constants: 0=down, 1=down-left, 2=down-right
+const DR = [1, 1, 1];
+const DC = [0, -1, 1];
+
+function findSource(grid: string[][]): [number, number] | null {
+  if (grid.length === 0 || grid[0].length === 0) return null;
+  for (let c = 0; c < grid[0].length; c++) {
+    if (grid[0][c] === 'S') return [0, c];
+  }
+  return null;
+}
+
+export function countBeamCells(grid: string[][]): number {
+  const rows = grid.length;
+  if (rows === 0) return 0;
+  const cols = grid[0].length;
+  if (cols === 0) return 0;
+
+  const src = findSource(grid);
+  if (!src) return 0;
+  const [sr, sc] = src;
+
+  const visited = new Set<number>();
+  visited.add(sr * cols + sc);
+
+  // Active beams encoded as: row * cols * 3 + col * 3 + dir
+  let active = new Set<number>();
+  active.add(sr * cols * 3 + sc * 3 + 0);
+
+  while (active.size > 0) {
+    const next = new Set<number>();
+    for (const enc of active) {
+      const dir = enc % 3;
+      const rem = (enc - dir) / 3;
+      const c = rem % cols;
+      const r = (rem - c) / cols;
+
+      const nr = r + DR[dir];
+      const nc = c + DC[dir];
+
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;
+
+      visited.add(nr * cols + nc);
+
+      if (grid[nr][nc] === '^') {
+        next.add(nr * cols * 3 + nc * 3 + 1);
+        next.add(nr * cols * 3 + nc * 3 + 2);
+      } else {
+        next.add(nr * cols * 3 + nc * 3 + dir);
+      }
+    }
+    active = next;
+  }
+
+  return visited.size;
+}
+
+export function countBeamPaths(grid: string[][]): bigint {
+  const rows = grid.length;
+  if (rows === 0) return 0n;
+  const cols = grid[0].length;
+  if (cols === 0) return 0n;
+
+  const src = findSource(grid);
+  if (!src) return 0n;
+  const [sr, sc] = src;
+
+  let active = new Map<number, bigint>();
+  active.set(sr * cols * 3 + sc * 3 + 0, 1n);
+
+  let totalPaths = 0n;
+
+  while (active.size > 0) {
+    const next = new Map<number, bigint>();
+    for (const [enc, count] of active) {
+      const dir = enc % 3;
+      const rem = (enc - dir) / 3;
+      const c = rem % cols;
+      const r = (rem - c) / cols;
+
+      const nr = r + DR[dir];
+      const nc = c + DC[dir];
+
+      if (nr < 0 || nr >= rows || nc < 0 || nc >= cols) {
+        totalPaths += count;
+        continue;
+      }
+
+      if (grid[nr][nc] === '^') {
+        const k1 = nr * cols * 3 + nc * 3 + 1;
+        const k2 = nr * cols * 3 + nc * 3 + 2;
+        next.set(k1, (next.get(k1) ?? 0n) + count);
+        next.set(k2, (next.get(k2) ?? 0n) + count);
+      } else {
+        const k = nr * cols * 3 + nc * 3 + dir;
+        next.set(k, (next.get(k) ?? 0n) + count);
+      }
+    }
+    active = next;
+  }
+
+  return totalPaths;
+}
