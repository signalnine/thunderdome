products', () => {\n    catalog.createProduct('A', 1, 'cat1');\n    catalog.createProduct('B', 2, 'cat2');\n    expect(catalog.listProducts()).toHaveLength(2);\n  });\n\n  it('lists products filtered by category', () => {\n    catalog.createProduct('A', 1, 'cat1');\n    catalog.createProduct('B', 2, 'cat2');\n    catalog.createProduct('C', 3, 'cat1');\n    expect(catalog.listProducts('cat1')).toHaveLength(2);\n  });\n\n  it('searches products by name', () => {\n    catalog.createProduct('Apple Pie', 5, 'food');\n    catalog.createProduct('Banana Split', 4, 'food');\n    catalog.createProduct('apple juice', 2, 'drinks');\n    const results = catalog.searchProducts('apple');\n    expect(results).toHaveLength(2);\n  });\n\n  it('updates a product', () => {\n    const id = catalog.createProduct('Old', 10, 'cat');\n    catalog.updateProduct(id, { name: 'New', price: 20 });\n    const product = catalog.getProduct(id)!;\n    expect(product.name).toBe('New');\n    expect(product.price).toBe(20);\n    expect(product.category).toBe('cat');\n  });\n\n  it('removes a product', () => {\n    const id = catalog.createProduct('Del', 5, 'cat');\n    expect(catalog.removeProduct(id)).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n    expect(catalog.removeProduct(id)).toBe(false);\n  });\n});\n\ndescribe('InventoryService', () => {\n  let bus: EventBus;\n  let inventory: ReturnType<typeof createInventoryService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    inventory = createInventoryService(bus);\n  });\n\n  it('sets and gets stock', () => {\n    inventory.setStock('p1', 100);\n    expect(inventory.getStock('p1')).toBe(100);\n  });\n\n  it('returns 0 for unknown product', () => {\n    expect(inventory.getStock('unknown')).toBe(0);\n  });\n\n  it('emits INVENTORY_UPDATED event on setStock', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.INVENTORY_UPDATED, (payload: unknown) => {\n        const e = payload as { productId: string; quantity: number };\n        expect(e.productId).toBe('p1');\n        expect(e.quantity).toBe(50);\n        resolve();\n      });\n      inventory.setStock('p1', 50);\n    });\n  });\n\n  it('reserves stock successfully', () => {\n    inventory.setStock('p1', 100);\n    expect(inventory.reserve('p1', 30)).toBe(true);\n    expect(inventory.reserve('p1', 70)).toBe(true);\n    expect(inventory.reserve('p1', 1)).toBe(false);\n  });\n\n  it('releases reserved stock', () => {\n    inventory.setStock('p1', 100);\n    inventory.reserve('p1', 50);\n    inventory.release('p1', 30);\n    expect(inventory.reserve('p1', 80)).toBe(true);\n  });\n\n  it('emits LOW_STOCK_ALERT when stock falls at or below threshold', async () => {\n    inventory.setLowStockThreshold('p1', 10);\n    await new Promise<void>(resolve => {\n      bus.on(Events.LOW_STOCK_ALERT, (payload: unknown) => {\n        const e = payload as { productId: string; currentQuantity: number; threshold: number };\n        expect(e.productId).toBe('p1');\n        expect(e.currentQuantity).toBe(5);\n        expect(e.threshold).toBe(10);\n        resolve();\n      });\n      inventory.setStock('p1', 5);\n    });\n  });\n\n  it('does not emit LOW_STOCK_ALERT when stock is above threshold', () => {\n    let alerted = false;\n    bus.on(Events.LOW_STOCK_ALERT, () => { alerted = true; });\n    inventory.setLowStockThreshold('p1', 10);\n    inventory.setStock('p1', 50);\n    expect(alerted).toBe(false);\n  });\n});\n\ndescribe('CartService', () => {\n  let bus: EventBus;\n  let cart: ReturnType<typeof createCartService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    cart = createCartService(bus);\n  });\n\n  it('creates a cart', () => {\n    const id = cart.createCart('user1');\n    const c = cart.getCart(id)!;\n    expect(c.userId).toBe('user1');\n    expect(c.items).toEqual([]);\n  });\n\n  it('returns null for non-existent cart', () => {\n    expect(cart.getCart('nope')).toBeNull();\n  });\n\n  it('adds items and consolidates quantities', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p1', 3);\n    const c = cart.getCart(id)!;\n    expect(c.items).toEqual([{ productId: 'p1', quantity: 5 }]);\n  });\n\n  it('removes an item', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.removeItem(id, 'p1');\n    expect(cart.getCart(id)!.items).toEqual([]);\n  });\n\n  it('updates quantity', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.updateQuantity(id, 'p1', 10);\n    expect(cart.getCart(id)!.items).toEqual([{ productId: 'p1', quantity: 10 }]);\n  });\n\n  it('removes item when quantity set to 0', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.updateQuantity(id, 'p1', 0);\n    expect(cart.getCart(id)!.items).toEqual([]);\n  });\n\n  it('clears the cart', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p2', 3);\n    cart.clearCart(id);\n    expect(cart.getCart(id)!.items).toEqual([]);\n  });\n\n  it('emits CART_UPDATED on changes', async () => {\n    const id = cart.createCart('user1');\n    await new Promise<void>(resolve => {\n      bus.on(Events.CART_UPDATED, (payload: unknown) => {\n        const e = payload as { cartId: string; userId: string; items: Array<{ productId: string; quantity: number }> };\n        if (e.items.length > 0) {\n          expect(e.cartId).toBe(id);\n          expect(e.userId).toBe('user1');\n          resolve();\n        }\n      });\n      cart.addItem(id, 'p1', 1);\n    });\n  });\n});\n\ndescribe('PricingService', () => {\n  let bus: EventBus;\n  let pricing: ReturnType<typeof createPricingService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    pricing = createPricingService(bus);\n  });\n\n  it('calculates total with 10% tax', () => {\n    const result = pricing.calculateTotal([{ productId: 'p1', quantity: 2, price: 10 }]);\n    expect(result.subtotal).toBe(20);\n    expect(result.discount).toBe(0);\n    expect(result.tax).toBeCloseTo(2);\n    expect(result.total).toBeCloseTo(22);\n  });\n\n  it('applies discount code before tax', () => {\n    pricing.addDiscountCode('SAVE10', 10);\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 100 }],\n      'SAVE10',\n    );\n    expect(result.subtotal).toBe(100);\n    expect(result.discount).toBeCloseTo(10);\n    expect(result.tax).toBeCloseTo(9); // 90 * 0.1\n    expect(result.total).toBeCloseTo(99); // 90 + 9\n  });\n\n  it('returns 0 discount for unknown code', () => {\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 100 }],\n      'INVALID',\n    );\n    expect(result.discount).toBe(0);\n  });\n\n  it('tracks product prices from PRODUCT_CREATED events', async () => {\n    const catalog = createCatalogService(bus);\n    catalog.createProduct('Test', 42, 'cat');\n    // Give event handlers time to run\n    await new Promise(r => setTimeout(r, 10));\n    expect(pricing.getPrice(catalog.listProducts()[0].id)).toBe(42);\n  });\n\n  it('returns 0 for unknown product price', () => {\n    expect(pricing.getPrice('unknown')).toBe(0);\n  });\n\n  it('emits PRICE_CALCULATED event', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.PRICE_CALCULATED, (payload: unknown) => {\n        const e = payload as { subtotal: number; tax: number; total: number };\n        expect(e.subtotal).toBe(50);\n        resolve();\n      });\n      pricing.calculateTotal([{ productId: 'p1', quantity: 5, price: 10 }]);\n    });\n  });\n});\n\ndescribe('OrderService', () => {\n  let bus: EventBus;\n  let orders: ReturnType<typeof createOrderService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    orders = createOrderService(bus);\n  });\n\n  it('creates an order in PENDING status', () => {\n    const id = orders.createOrder('user1', 'cart1', 99.99);\n    const order = orders.getOrder(id)!;\n    expect(order.status).toBe(OrderStatus.PENDING);\n    expect(order.userId).toBe('user1');\n    expect(order.total).toBe(99.99);\n  });\n\n  it('returns null for non-existent order', () => {\n    expect(orders.getOrder('nope')).toBeNull();\n  });\n\n  it('updates order status', () => {\n    const id = orders.createOrder('user1', 'cart1', 50);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(id)!.status).toBe(OrderStatus.CONFIRMED);\n  });\n\n  it('emits ORDER_CREATED event', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.ORDER_CREATED, (payload: unknown) => {\n        const e = payload as { orderId: string; userId: string; cartId: string; total: number };\n        expect(e.userId).toBe('user1');\n        expect(e.cartId).toBe('c1');\n        expect(e.total).toBe(50);\n        resolve();\n      });\n      orders.createOrder('user1', 'c1', 50);\n    });\n  });\n\n  it('emits ORDER_STATUS_CHANGED with previous status', async () => {\n    const id = orders.createOrder('user1', 'cart1', 50);\n    await new Promise<void>(resolve => {\n      bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {\n        const e = payload as { orderId: string; status: OrderStatus; previousStatus: OrderStatus };\n        expect(e.previousStatus).toBe(OrderStatus.PENDING);\n        expect(e.status).toBe(OrderStatus.CONFIRMED);\n        resolve();\n      });\n      orders.updateStatus(id, OrderStatus.CONFIRMED);\n    });\n  });\n\n  it('lists orders for a user', () => {\n    orders.createOrder('user1', 'c1', 10);\n    orders.createOrder('user1', 'c2', 20);\n    orders.createOrder('user2', 'c3', 30);\n    expect(orders.listOrders('user1')).toHaveLength(2);\n    expect(orders.listOrders('user2')).toHaveLength(1);\n  });\n});\n\ndescribe('PaymentService', () => {\n  let bus: EventBus;\n\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('processes a successful payment', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 100);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeTruthy();\n  });\n\n  it('emits PAYMENT_PROCESSED event on success', async () => {\n    const payment = createPaymentService(bus);\n    await new Promise<void>(resolve => {\n      bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {\n        const e = payload as { orderId: string; status: PaymentStatus; transactionId?: string };\n        expect(e.orderId).toBe('order1');\n        expect(e.status).toBe(PaymentStatus.SUCCESS);\n        expect(e.transactionId).toBeTruthy();\n        resolve();\n      });\n      payment.processPayment('order1', 100);\n    });\n  });\n\n  it('simulates failure', async () => {\n    const payment = createPaymentService(bus, { simulateFailure: true });\n    const result = await payment.processPayment('order1', 100);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n    expect(result.error).toBeTruthy();\n  });\n\n  it('simulates timeout', async () => {\n    const payment = createPaymentService(bus, { simulateTimeout: true });\n    const result = await payment.processPayment('order1', 100);\n    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n  });\n\n  it('refunds a successful transaction', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 100);\n    expect(await payment.refund(result.transactionId!)).toBe(true);\n  });\n\n  it('cannot refund a non-existent transaction', async () => {\n    const payment = createPaymentService(bus);\n    expect(await payment.refund('nope')).toBe(false);\n  });\n\n  it('cannot refund twice', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 100);\n    await payment.refund(result.transactionId!);\n    expect(await payment.refund(result.transactionId!)).toBe(false);\n  });\n});\n\ndescribe('NotificationService', () => {\n  let bus: EventBus;\n  let notifications: ReturnType<typeof createNotificationService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    notifications = createNotificationService(bus);\n  });\n\n  it('sends notification on order status change for subscribed user', async () => {\n    notifications.subscribe('user1');\n    // First create an order so the service knows the user-order mapping\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit(Events.ORDER_STATUS_CHANGED, { orderId: 'o1', status: OrderStatus.CONFIRMED, previousStatus: OrderStatus.PENDING });\n\n    const notes = notifications.getNotifications('user1');\n    expect(notes).toHaveLength(1);\n    expect(notes[0].type).toBe('order_status_changed');\n  });\n\n  it('sends notification on payment processed for subscribed user', async () => {\n    notifications.subscribe('user1');\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 't1' });\n\n    const notes = notifications.getNotifications('user1');\n    expect(notes).toHaveLength(1);\n    expect(notes[0].type).toBe('payment_processed');\n  });\n\n  it('does not send notifications for unsubscribed users', async () => {\n    // user1 is NOT subscribed\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit(Events.ORDER_STATUS_CHANGED, { orderId: 'o1', status: OrderStatus.CONFIRMED, previousStatus: OrderStatus.PENDING });\n\n    expect(notifications.getNotifications('user1')).toHaveLength(0);\n  });\n\n  it('returns empty array for unknown user', () => {\n    expect(notifications.getNotifications('unknown')).toEqual([]);\n  });\n});\n\ndescribe('AnalyticsService', () => {\n  let bus: EventBus;\n  let analytics: ReturnType<typeof createAnalyticsService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    analytics = createAnalyticsService(bus);\n  });\n\n  it('counts events by type', async () => {\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p1', name: 'A', price: 10, category: 'cat' });\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p2', name: 'B', price: 20, category: 'cat' });\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBe(0);\n  });\n\n  it('tracks revenue from successful payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 't1' });\n    expect(analytics.getRevenue()).toBe(100);\n  });\n\n  it('does not count revenue from failed payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.FAILED, error: 'declined' });\n    expect(analytics.getRevenue()).toBe(0);\n  });\n\n  it('calculates conversion rate', async () => {\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [] });\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c2', userId: 'u2', items: [] });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 50 });\n    expect(analytics.getConversionRate()).toBeCloseTo(0.5);\n  });\n\n  it('returns 0 conversion rate with no carts', () => {\n    expect(analytics.getConversionRate()).toBe(0);\n  });\n\n  it('ranks top products by order quantity', async () => {\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [{ productId: 'p1', quantity: 3 }, { productId: 'p2', quantity: 1 }] });\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c2', userId: 'u2', items: [{ productId: 'p1', quantity: 2 }] });\n    const top = analytics.getTopProducts(2);\n    expect(top[0].productId).toBe('p1');\n    expect(top[0].count).toBe(5);\n    expect(top[1].productId).toBe('p2');\n    expect(top[1].count).toBe(1);\n  });\n\n  it('returns 0 for untracked event type', () => {\n    expect(analytics.getEventCount('nonexistent')).toBe(0);\n  });\n});\n\ndescribe('Integration: full order flow', () => {\n  it('processes a complete order lifecycle', async () => {\n    const bus = new EventBus();\n    const catalog = createCatalogService(bus);\n    const inventory = createInventoryService(bus);\n    const cart = createCartService(bus);\n    const pricing = createPricingService(bus);\n    const orders = createOrderService(bus);\n    const payment = createPaymentService(bus);\n    const notifications = createNotificationService(bus);\n    const analytics = createAnalyticsService(bus);\n\n    notifications.subscribe('user1');\n\n    // Create product\n    const productId = catalog.createProduct('Widget', 25, 'gadgets');\n    inventory.setStock(productId, 100);\n    inventory.setLowStockThreshold(productId, 10);\n\n    // Add to cart\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, productId, 3);\n\n    // Calculate total\n    const calc = pricing.calculateTotal([{ productId, quantity: 3, price: 25 }]);\n    expect(calc.subtotal).toBe(75);\n    expect(calc.tax).toBeCloseTo(7.5);\n    expect(calc.total).toBeCloseTo(82.5);\n\n    // Reserve inventory\n    expect(inventory.reserve(productId, 3)).toBe(true);\n\n    // Create order\n    const orderId = orders.createOrder('user1', cartId, calc.total);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.PENDING);\n\n    // Process payment\n    const payResult = await payment.processPayment(orderId, calc.total);\n    expect(payResult.status).toBe(PaymentStatus.SUCCESS);\n\n    // Update order status\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n\n    // Check notifications\n    const userNotes = notifications.getNotifications('user1');\n    expect(userNotes.length).toBeGreaterThanOrEqual(2);\n\n    // Check analytics\n    expect(analytics.getRevenue()).toBeCloseTo(82.5);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBe(1);\n    expect(analytics.getConversionRate()).toBeGreaterThan(0);\n  });\n});\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":27784,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"fd81fee0-187e-4e4c-a1be-d6b34a22c525","uuid":"acda6a32-48eb-4a16-b3c5-78e7e3f7818e"}
+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-81c3c4d5a2d7a25d","type":"tool_result","content":"File created successfully at: /workspace/tests/services.test.ts"}]},"parent_tool_use_id":null,"session_id":"fd81fee0-187e-4e4c-a1be-d6b34a22c525","uuid":"4981320a-df1b-43eb-ad5b-7b8919c4e910","tool_use_result":{"type":"create","filePath":"/workspace/tests/services.test.ts","content":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { EventBus } from '../src/bus.js';\nimport { createCatalogService } from '../src/catalog/index.js';\nimport { createInventoryService } from '../src/inventory/index.js';\nimport { createCartService } from '../src/cart/index.js';\nimport { createPricingService } from '../src/pricing/index.js';\nimport { createOrderService } from '../src/orders/index.js';\nimport { createPaymentService } from '../src/payment/index.js';\nimport { createNotificationService } from '../src/notifications/index.js';\nimport { createAnalyticsService } from '../src/analytics/index.js';\nimport { Events, OrderStatus, PaymentStatus } from '../src/types.js';\n\ndescribe('CatalogService', () => {\n  let bus: EventBus;\n  let catalog: ReturnType<typeof createCatalogService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    catalog = createCatalogService(bus);\n  });\n\n  it('creates a product and returns an id', () => {\n    const id = catalog.createProduct('Widget', 9.99, 'gadgets');\n    expect(id).toBeTruthy();\n    const product = catalog.getProduct(id);\n    expect(product).toEqual({ id, name: 'Widget', price: 9.99, category: 'gadgets' });\n  });\n\n  it('emits PRODUCT_CREATED event', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.PRODUCT_CREATED, (payload: unknown) => {\n        const e = payload as { productId: string; name: string; price: number; category: string };\n        expect(e.name).toBe('Widget');\n        expect(e.price).toBe(9.99);\n        resolve();\n      });\n      catalog.createProduct('Widget', 9.99, 'gadgets');\n    });\n  });\n\n  it('returns null for non-existent product', () => {\n    expect(catalog.getProduct('nope')).toBeNull();\n  });\n\n  it('lists all products', () => {\n    catalog.createProduct('A', 1, 'cat1');\n    catalog.createProduct('B', 2, 'cat2');\n    expect(catalog.listProducts()).toHaveLength(2);\n  });\n\n  it('lists products filtered by category', () => {\n    catalog.createProduct('A', 1, 'cat1');\n    catalog.createProduct('B', 2, 'cat2');\n    catalog.createProduct('C', 3, 'cat1');\n    expect(catalog.listProducts('cat1')).toHaveLength(2);\n  });\n\n  it('searches products by name', () => {\n    catalog.createProduct('Apple Pie', 5, 'food');\n    catalog.createProduct('Banana Split', 4, 'food');\n    catalog.createProduct('apple juice', 2, 'drinks');\n    const results = catalog.searchProducts('apple');\n    expect(results).toHaveLength(2);\n  });\n\n  it('updates a product', () => {\n    const id = catalog.createProduct('Old', 10, 'cat');\n    catalog.updateProduct(id, { name: 'New', price: 20 });\n    const product = catalog.getProduct(id)!;\n    expect(product.name).toBe('New');\n    expect(product.price).toBe(20);\n    expect(product.category).toBe('cat');\n  });\n\n  it('removes a product', () => {\n    const id = catalog.createProduct('Del', 5, 'cat');\n    expect(catalog.removeProduct(id)).toBe(true);\n    expect(catalog.getProduct(id)).toBeNull();\n    expect(catalog.removeProduct(id)).toBe(false);\n  });\n});\n\ndescribe('InventoryService', () => {\n  let bus: EventBus;\n  let inventory: ReturnType<typeof createInventoryService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    inventory = createInventoryService(bus);\n  });\n\n  it('sets and gets stock', () => {\n    inventory.setStock('p1', 100);\n    expect(inventory.getStock('p1')).toBe(100);\n  });\n\n  it('returns 0 for unknown product', () => {\n    expect(inventory.getStock('unknown')).toBe(0);\n  });\n\n  it('emits INVENTORY_UPDATED event on setStock', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.INVENTORY_UPDATED, (payload: unknown) => {\n        const e = payload as { productId: string; quantity: number };\n        expect(e.productId).toBe('p1');\n        expect(e.quantity).toBe(50);\n        resolve();\n      });\n      inventory.setStock('p1', 50);\n    });\n  });\n\n  it('reserves stock successfully', () => {\n    inventory.setStock('p1', 100);\n    expect(inventory.reserve('p1', 30)).toBe(true);\n    expect(inventory.reserve('p1', 70)).toBe(true);\n    expect(inventory.reserve('p1', 1)).toBe(false);\n  });\n\n  it('releases reserved stock', () => {\n    inventory.setStock('p1', 100);\n    inventory.reserve('p1', 50);\n    inventory.release('p1', 30);\n    expect(inventory.reserve('p1', 80)).toBe(true);\n  });\n\n  it('emits LOW_STOCK_ALERT when stock falls at or below threshold', async () => {\n    inventory.setLowStockThreshold('p1', 10);\n    await new Promise<void>(resolve => {\n      bus.on(Events.LOW_STOCK_ALERT, (payload: unknown) => {\n        const e = payload as { productId: string; currentQuantity: number; threshold: number };\n        expect(e.productId).toBe('p1');\n        expect(e.currentQuantity).toBe(5);\n        expect(e.threshold).toBe(10);\n        resolve();\n      });\n      inventory.setStock('p1', 5);\n    });\n  });\n\n  it('does not emit LOW_STOCK_ALERT when stock is above threshold', () => {\n    let alerted = false;\n    bus.on(Events.LOW_STOCK_ALERT, () => { alerted = true; });\n    inventory.setLowStockThreshold('p1', 10);\n    inventory.setStock('p1', 50);\n    expect(alerted).toBe(false);\n  });\n});\n\ndescribe('CartService', () => {\n  let bus: EventBus;\n  let cart: ReturnType<typeof createCartService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    cart = createCartService(bus);\n  });\n\n  it('creates a cart', () => {\n    const id = cart.createCart('user1');\n    const c = cart.getCart(id)!;\n    expect(c.userId).toBe('user1');\n    expect(c.items).toEqual([]);\n  });\n\n  it('returns null for non-existent cart', () => {\n    expect(cart.getCart('nope')).toBeNull();\n  });\n\n  it('adds items and consolidates quantities', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p1', 3);\n    const c = cart.getCart(id)!;\n    expect(c.items).toEqual([{ productId: 'p1', quantity: 5 }]);\n  });\n\n  it('removes an item', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.removeItem(id, 'p1');\n    expect(cart.getCart(id)!.items).toEqual([]);\n  });\n\n  it('updates quantity', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.updateQuantity(id, 'p1', 10);\n    expect(cart.getCart(id)!.items).toEqual([{ productId: 'p1', quantity: 10 }]);\n  });\n\n  it('removes item when quantity set to 0', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.updateQuantity(id, 'p1', 0);\n    expect(cart.getCart(id)!.items).toEqual([]);\n  });\n\n  it('clears the cart', () => {\n    const id = cart.createCart('user1');\n    cart.addItem(id, 'p1', 2);\n    cart.addItem(id, 'p2', 3);\n    cart.clearCart(id);\n    expect(cart.getCart(id)!.items).toEqual([]);\n  });\n\n  it('emits CART_UPDATED on changes', async () => {\n    const id = cart.createCart('user1');\n    await new Promise<void>(resolve => {\n      bus.on(Events.CART_UPDATED, (payload: unknown) => {\n        const e = payload as { cartId: string; userId: string; items: Array<{ productId: string; quantity: number }> };\n        if (e.items.length > 0) {\n          expect(e.cartId).toBe(id);\n          expect(e.userId).toBe('user1');\n          resolve();\n        }\n      });\n      cart.addItem(id, 'p1', 1);\n    });\n  });\n});\n\ndescribe('PricingService', () => {\n  let bus: EventBus;\n  let pricing: ReturnType<typeof createPricingService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    pricing = createPricingService(bus);\n  });\n\n  it('calculates total with 10% tax', () => {\n    const result = pricing.calculateTotal([{ productId: 'p1', quantity: 2, price: 10 }]);\n    expect(result.subtotal).toBe(20);\n    expect(result.discount).toBe(0);\n    expect(result.tax).toBeCloseTo(2);\n    expect(result.total).toBeCloseTo(22);\n  });\n\n  it('applies discount code before tax', () => {\n    pricing.addDiscountCode('SAVE10', 10);\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 100 }],\n      'SAVE10',\n    );\n    expect(result.subtotal).toBe(100);\n    expect(result.discount).toBeCloseTo(10);\n    expect(result.tax).toBeCloseTo(9); // 90 * 0.1\n    expect(result.total).toBeCloseTo(99); // 90 + 9\n  });\n\n  it('returns 0 discount for unknown code', () => {\n    const result = pricing.calculateTotal(\n      [{ productId: 'p1', quantity: 1, price: 100 }],\n      'INVALID',\n    );\n    expect(result.discount).toBe(0);\n  });\n\n  it('tracks product prices from PRODUCT_CREATED events', async () => {\n    const catalog = createCatalogService(bus);\n    catalog.createProduct('Test', 42, 'cat');\n    // Give event handlers time to run\n    await new Promise(r => setTimeout(r, 10));\n    expect(pricing.getPrice(catalog.listProducts()[0].id)).toBe(42);\n  });\n\n  it('returns 0 for unknown product price', () => {\n    expect(pricing.getPrice('unknown')).toBe(0);\n  });\n\n  it('emits PRICE_CALCULATED event', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.PRICE_CALCULATED, (payload: unknown) => {\n        const e = payload as { subtotal: number; tax: number; total: number };\n        expect(e.subtotal).toBe(50);\n        resolve();\n      });\n      pricing.calculateTotal([{ productId: 'p1', quantity: 5, price: 10 }]);\n    });\n  });\n});\n\ndescribe('OrderService', () => {\n  let bus: EventBus;\n  let orders: ReturnType<typeof createOrderService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    orders = createOrderService(bus);\n  });\n\n  it('creates an order in PENDING status', () => {\n    const id = orders.createOrder('user1', 'cart1', 99.99);\n    const order = orders.getOrder(id)!;\n    expect(order.status).toBe(OrderStatus.PENDING);\n    expect(order.userId).toBe('user1');\n    expect(order.total).toBe(99.99);\n  });\n\n  it('returns null for non-existent order', () => {\n    expect(orders.getOrder('nope')).toBeNull();\n  });\n\n  it('updates order status', () => {\n    const id = orders.createOrder('user1', 'cart1', 50);\n    orders.updateStatus(id, OrderStatus.CONFIRMED);\n    expect(orders.getOrder(id)!.status).toBe(OrderStatus.CONFIRMED);\n  });\n\n  it('emits ORDER_CREATED event', async () => {\n    await new Promise<void>(resolve => {\n      bus.on(Events.ORDER_CREATED, (payload: unknown) => {\n        const e = payload as { orderId: string; userId: string; cartId: string; total: number };\n        expect(e.userId).toBe('user1');\n        expect(e.cartId).toBe('c1');\n        expect(e.total).toBe(50);\n        resolve();\n      });\n      orders.createOrder('user1', 'c1', 50);\n    });\n  });\n\n  it('emits ORDER_STATUS_CHANGED with previous status', async () => {\n    const id = orders.createOrder('user1', 'cart1', 50);\n    await new Promise<void>(resolve => {\n      bus.on(Events.ORDER_STATUS_CHANGED, (payload: unknown) => {\n        const e = payload as { orderId: string; status: OrderStatus; previousStatus: OrderStatus };\n        expect(e.previousStatus).toBe(OrderStatus.PENDING);\n        expect(e.status).toBe(OrderStatus.CONFIRMED);\n        resolve();\n      });\n      orders.updateStatus(id, OrderStatus.CONFIRMED);\n    });\n  });\n\n  it('lists orders for a user', () => {\n    orders.createOrder('user1', 'c1', 10);\n    orders.createOrder('user1', 'c2', 20);\n    orders.createOrder('user2', 'c3', 30);\n    expect(orders.listOrders('user1')).toHaveLength(2);\n    expect(orders.listOrders('user2')).toHaveLength(1);\n  });\n});\n\ndescribe('PaymentService', () => {\n  let bus: EventBus;\n\n  beforeEach(() => {\n    bus = new EventBus();\n  });\n\n  it('processes a successful payment', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 100);\n    expect(result.status).toBe(PaymentStatus.SUCCESS);\n    expect(result.transactionId).toBeTruthy();\n  });\n\n  it('emits PAYMENT_PROCESSED event on success', async () => {\n    const payment = createPaymentService(bus);\n    await new Promise<void>(resolve => {\n      bus.on(Events.PAYMENT_PROCESSED, (payload: unknown) => {\n        const e = payload as { orderId: string; status: PaymentStatus; transactionId?: string };\n        expect(e.orderId).toBe('order1');\n        expect(e.status).toBe(PaymentStatus.SUCCESS);\n        expect(e.transactionId).toBeTruthy();\n        resolve();\n      });\n      payment.processPayment('order1', 100);\n    });\n  });\n\n  it('simulates failure', async () => {\n    const payment = createPaymentService(bus, { simulateFailure: true });\n    const result = await payment.processPayment('order1', 100);\n    expect(result.status).toBe(PaymentStatus.FAILED);\n    expect(result.error).toBeTruthy();\n  });\n\n  it('simulates timeout', async () => {\n    const payment = createPaymentService(bus, { simulateTimeout: true });\n    const result = await payment.processPayment('order1', 100);\n    expect(result.status).toBe(PaymentStatus.TIMEOUT);\n  });\n\n  it('refunds a successful transaction', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 100);\n    expect(await payment.refund(result.transactionId!)).toBe(true);\n  });\n\n  it('cannot refund a non-existent transaction', async () => {\n    const payment = createPaymentService(bus);\n    expect(await payment.refund('nope')).toBe(false);\n  });\n\n  it('cannot refund twice', async () => {\n    const payment = createPaymentService(bus);\n    const result = await payment.processPayment('order1', 100);\n    await payment.refund(result.transactionId!);\n    expect(await payment.refund(result.transactionId!)).toBe(false);\n  });\n});\n\ndescribe('NotificationService', () => {\n  let bus: EventBus;\n  let notifications: ReturnType<typeof createNotificationService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    notifications = createNotificationService(bus);\n  });\n\n  it('sends notification on order status change for subscribed user', async () => {\n    notifications.subscribe('user1');\n    // First create an order so the service knows the user-order mapping\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit(Events.ORDER_STATUS_CHANGED, { orderId: 'o1', status: OrderStatus.CONFIRMED, previousStatus: OrderStatus.PENDING });\n\n    const notes = notifications.getNotifications('user1');\n    expect(notes).toHaveLength(1);\n    expect(notes[0].type).toBe('order_status_changed');\n  });\n\n  it('sends notification on payment processed for subscribed user', async () => {\n    notifications.subscribe('user1');\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 't1' });\n\n    const notes = notifications.getNotifications('user1');\n    expect(notes).toHaveLength(1);\n    expect(notes[0].type).toBe('payment_processed');\n  });\n\n  it('does not send notifications for unsubscribed users', async () => {\n    // user1 is NOT subscribed\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'user1', cartId: 'c1', total: 50 });\n    await bus.emit(Events.ORDER_STATUS_CHANGED, { orderId: 'o1', status: OrderStatus.CONFIRMED, previousStatus: OrderStatus.PENDING });\n\n    expect(notifications.getNotifications('user1')).toHaveLength(0);\n  });\n\n  it('returns empty array for unknown user', () => {\n    expect(notifications.getNotifications('unknown')).toEqual([]);\n  });\n});\n\ndescribe('AnalyticsService', () => {\n  let bus: EventBus;\n  let analytics: ReturnType<typeof createAnalyticsService>;\n\n  beforeEach(() => {\n    bus = new EventBus();\n    analytics = createAnalyticsService(bus);\n  });\n\n  it('counts events by type', async () => {\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p1', name: 'A', price: 10, category: 'cat' });\n    await bus.emit(Events.PRODUCT_CREATED, { productId: 'p2', name: 'B', price: 20, category: 'cat' });\n    expect(analytics.getEventCount(Events.PRODUCT_CREATED)).toBe(2);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBe(0);\n  });\n\n  it('tracks revenue from successful payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.SUCCESS, transactionId: 't1' });\n    expect(analytics.getRevenue()).toBe(100);\n  });\n\n  it('does not count revenue from failed payments', async () => {\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });\n    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.FAILED, error: 'declined' });\n    expect(analytics.getRevenue()).toBe(0);\n  });\n\n  it('calculates conversion rate', async () => {\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [] });\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c2', userId: 'u2', items: [] });\n    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 50 });\n    expect(analytics.getConversionRate()).toBeCloseTo(0.5);\n  });\n\n  it('returns 0 conversion rate with no carts', () => {\n    expect(analytics.getConversionRate()).toBe(0);\n  });\n\n  it('ranks top products by order quantity', async () => {\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c1', userId: 'u1', items: [{ productId: 'p1', quantity: 3 }, { productId: 'p2', quantity: 1 }] });\n    await bus.emit(Events.CART_UPDATED, { cartId: 'c2', userId: 'u2', items: [{ productId: 'p1', quantity: 2 }] });\n    const top = analytics.getTopProducts(2);\n    expect(top[0].productId).toBe('p1');\n    expect(top[0].count).toBe(5);\n    expect(top[1].productId).toBe('p2');\n    expect(top[1].count).toBe(1);\n  });\n\n  it('returns 0 for untracked event type', () => {\n    expect(analytics.getEventCount('nonexistent')).toBe(0);\n  });\n});\n\ndescribe('Integration: full order flow', () => {\n  it('processes a complete order lifecycle', async () => {\n    const bus = new EventBus();\n    const catalog = createCatalogService(bus);\n    const inventory = createInventoryService(bus);\n    const cart = createCartService(bus);\n    const pricing = createPricingService(bus);\n    const orders = createOrderService(bus);\n    const payment = createPaymentService(bus);\n    const notifications = createNotificationService(bus);\n    const analytics = createAnalyticsService(bus);\n\n    notifications.subscribe('user1');\n\n    // Create product\n    const productId = catalog.createProduct('Widget', 25, 'gadgets');\n    inventory.setStock(productId, 100);\n    inventory.setLowStockThreshold(productId, 10);\n\n    // Add to cart\n    const cartId = cart.createCart('user1');\n    cart.addItem(cartId, productId, 3);\n\n    // Calculate total\n    const calc = pricing.calculateTotal([{ productId, quantity: 3, price: 25 }]);\n    expect(calc.subtotal).toBe(75);\n    expect(calc.tax).toBeCloseTo(7.5);\n    expect(calc.total).toBeCloseTo(82.5);\n\n    // Reserve inventory\n    expect(inventory.reserve(productId, 3)).toBe(true);\n\n    // Create order\n    const orderId = orders.createOrder('user1', cartId, calc.total);\n    expect(orders.getOrder(orderId)!.status).toBe(OrderStatus.PENDING);\n\n    // Process payment\n    const payResult = await payment.processPayment(orderId, calc.total);\n    expect(payResult.status).toBe(PaymentStatus.SUCCESS);\n\n    // Update order status\n    orders.updateStatus(orderId, OrderStatus.CONFIRMED);\n    orders.updateStatus(orderId, OrderStatus.SHIPPED);\n    orders.updateStatus(orderId, OrderStatus.DELIVERED);\n\n    // Check notifications\n    const userNotes = notifications.getNotifications('user1');\n    expect(userNotes.length).toBeGreaterThanOrEqual(2);\n\n    // Check analytics\n    expect(analytics.getRevenue()).toBeCloseTo(82.5);\n    expect(analytics.getEventCount(Events.ORDER_CREATED)).toBe(1);\n    expect(analytics.getConversionRate()).toBeGreaterThan(0);\n  });\n});\n","structuredPatch":[],"originalFile":null}}
