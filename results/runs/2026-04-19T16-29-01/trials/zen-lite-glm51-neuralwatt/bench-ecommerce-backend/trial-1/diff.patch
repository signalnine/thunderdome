+
+  it('does not count revenue from failed payments', async () => {
+    await bus.emit(Events.ORDER_CREATED, { orderId: 'o1', userId: 'u1', cartId: 'c1', total: 100 });
+    await bus.emit(Events.PAYMENT_PROCESSED, { orderId: 'o1', status: PaymentStatus.FAILED, error: 'declined' });
+    expect(analytics.getRevenue()).toBe(0);
+  });
+
+  it('calculates conversion rate', async () => {
