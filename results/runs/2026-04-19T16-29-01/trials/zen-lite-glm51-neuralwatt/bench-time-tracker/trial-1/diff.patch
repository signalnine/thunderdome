+interface StoredData {
+  entries: TimeEntry[];
+  current: { taskName: string; startTime: number } | null;
+}
+
+export class TimeTracker {
+  private filePath: string;
+  private entries: TimeEntry[];
+  private current: { taskName: string; startTime: number } | null;
+
+  constructor(filePath: string) {
+    this.filePath = filePath;
+    this.entries = [];
+    this.current = null;
+    this.load();
+  }
+
+  start(taskName: string): void {
+    if (!taskName) {
+      throw new Error("Task name cannot be empty");
+    }
+    if (this.current !== null) {
+      this.stop();
+    }
+    this.current = { taskName, startTime: Date.now() };
+    this.save();
+  }
+
+  stop(): TimeEntry {
+    if (this.current === null) {
+      throw new Error("No timer is running");
+    }
+    const entry: TimeEntry = {
+      taskName: this.current.taskName,
+      startTime: this.current.startTime,
+      stopTime: Date.now(),
+    };
+    this.entries.push(entry);
+    this.current = null;
+    this.save();
+    return entry;
+  }
+
+  getEntries(startDate?: Date, endDate?: Date): TimeEntry[] {
+    let result = this.entries;
+    if (startDate !== undefined) {
+      result = result.filter((e) => e.startTime >= startDate.getTime());
+    }
+    if (endDate !== undefined) {
+      result = result.filter((e) => e.startTime < endDate.getTime());
+    }
+    return result;
+  }
+
+  getSummary(): Map<string, number> {
+    const summary = new Map<string, number>();
+    const now = Date.now();
+
+    for (const entry of this.entries) {
+      const duration = (entry.stopTime ?? now) - entry.startTime;
+      summary.set(
+        entry.taskName,
+        (summary.get(entry.taskName) ?? 0) + duration,
+      );
+    }
+
+    if (this.current !== null) {
+      const duration = now - this.current.startTime;
+      summary.set(
+        this.current.taskName,
+        (summary.get(this.current.taskName) ?? 0) + duration,
+      );
+    }
+
+    return summary;
+  }
+
+  private load(): void {
+    try {
+      const raw = readFileSync(this.filePath, "utf-8");
+      const data: StoredData = JSON.parse(raw);
+      this.entries = data.entries ?? [];
+      this.current = data.current ?? null;
+    } catch {
+      this.entries = [];
+      this.current = null;
+    }
+  }
+
+  private save(): void {
+    const data: StoredData = {
+      entries: this.entries,
+      current: this.current,
+    };
+    mkdirSync(dirname(this.filePath), { recursive: true });
+    writeFileSync(this.filePath, JSON.stringify(data, null, 2), "utf-8");
+  }
+}
diff --git a/tests/time-tracker.test.ts b/tests/time-tracker.test.ts
new file mode 100644
index 0000000..e239373
--- /dev/null
+++ b/tests/time-tracker.test.ts
@@ -0,0 +1,200 @@
+import { rmSync, existsSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+import { TimeTracker } from "../src/index.js";
+
+let testDir: string;
+
+beforeEach(() => {
+  testDir = join(tmpdir(), `time-tracker-test-${Date.now()}-${Math.random()}`);
+});
+
+afterEach(() => {
+  rmSync(testDir, { recursive: true, force: true });
+});
+
+function tracker(filename = "data.json"): TimeTracker {
+  return new TimeTracker(join(testDir, filename));
+}
+
+describe("TimeTracker", () => {
+  describe("start and stop", () => {
+    it("starts a timer with a task name", () => {
+      const t = tracker();
+      t.start("coding");
+    });
+
+    it("throws when starting with an empty name", () => {
+      const t = tracker();
+      expect(() => t.start("")).toThrow("Task name cannot be empty");
+    });
+
+    it("stops a running timer and returns an entry", () => {
+      const t = tracker();
+      t.start("coding");
+      const entry = t.stop();
+      expect(entry.taskName).toBe("coding");
+      expect(entry.startTime).toBeTypeOf("number");
+      expect(entry.stopTime).toBeTypeOf("number");
+      expect(entry.stopTime!).toBeGreaterThanOrEqual(entry.startTime);
+    });
+
+    it("throws when stopping with no timer running", () => {
+      const t = tracker();
+      expect(() => t.stop()).toThrow("No timer is running");
+    });
+
+    it("automatically stops previous timer when starting a new one", () => {
+      const t = tracker();
+      t.start("coding");
+      t.start("review");
+      const entries = t.getEntries();
+      expect(entries).toHaveLength(1);
+      expect(entries[0].taskName).toBe("coding");
+      expect(entries[0].stopTime).not.toBeNull();
+    });
+  });
+
+  describe("entries", () => {
+    it("returns all entries", () => {
+      const t = tracker();
+      t.start("a");
+      t.stop();
+      t.start("b");
+      t.stop();
+      expect(t.getEntries()).toHaveLength(2);
+    });
+
+    it("filters entries by date range", () => {
+      vi.useFakeTimers();
+      const t = tracker();
+
+      t.start("a");
+      vi.advanceTimersByTime(100);
+      t.stop();
+
+      vi.advanceTimersByTime(1000);
+
+      t.start("b");
+      vi.advanceTimersByTime(100);
+      t.stop();
+
+      // Filter to only include entries after "a" stopped
+      const afterA = new Date(t.getEntries()[0].stopTime! + 1);
+      const onlySecond = t.getEntries(afterA);
+      expect(onlySecond).toHaveLength(1);
+      expect(onlySecond[0].taskName).toBe("b");
+
+      // Filter to only include entries before "b" started
+      const beforeB = new Date(t.getEntries()[1].startTime);
+      const onlyFirst = t.getEntries(undefined, beforeB);
+      expect(onlyFirst).toHaveLength(1);
+      expect(onlyFirst[0].taskName).toBe("a");
+
+      vi.useRealTimers();
+    });
+  });
+
+  describe("summary", () => {
+    it("sums time per task name", () => {
+      vi.useFakeTimers();
+      const t = tracker();
+
+      t.start("coding");
+      vi.advanceTimersByTime(5000);
+      t.stop();
+
+      t.start("coding");
+      vi.advanceTimersByTime(3000);
+      t.stop();
+
+      t.start("review");
+      vi.advanceTimersByTime(2000);
+      t.stop();
+
+      const summary = t.getSummary();
+      expect(summary.get("coding")).toBe(8000);
+      expect(summary.get("review")).toBe(2000);
+
+      vi.useRealTimers();
+    });
+
+    it("includes running tasks using current time", () => {
+      vi.useFakeTimers();
+      const t = tracker();
+
+      t.start("coding");
+      vi.advanceTimersByTime(3000);
+
+      const summary = t.getSummary();
+      expect(summary.get("coding")).toBe(3000);
+
+      vi.advanceTimersByTime(1000);
+      t.stop();
+
+      vi.useRealTimers();
+    });
+  });
+
+  describe("persistence", () => {
+    it("persists data to a JSON file", () => {
+      const path = join(testDir, "data.json");
+      const t = new TimeTracker(path);
+      t.start("coding");
+      t.stop();
+
+      const t2 = new TimeTracker(path);
+      expect(t2.getEntries()).toHaveLength(1);
+      expect(t2.getEntries()[0].taskName).toBe("coding");
+    });
+
+    it("creates parent directories automatically", () => {
+      const path = join(testDir, "deep", "nested", "data.json");
+      const t = new TimeTracker(path);
+      t.start("coding");
+      t.stop();
+      expect(existsSync(path)).toBe(true);
+    });
+
+    it("persists a running timer across sessions", () => {
+      vi.useFakeTimers();
+
+      const path = join(testDir, "data.json");
+      const t = new TimeTracker(path);
+      t.start("coding");
+      vi.advanceTimersByTime(5000);
+
+      const t2 = new TimeTracker(path);
+      const summary = t2.getSummary();
+      expect(summary.get("coding")).toBeGreaterThanOrEqual(5000);
+
+      t2.stop();
+      vi.useRealTimers();
+    });
+  });
+
+  describe("unicode support", () => {
+    it("handles unicode task names", () => {
+      const t = tracker();
+      t.start("コーディング");
+      t.stop();
+      expect(t.getEntries()[0].taskName).toBe("コーディング");
+
+      t.start("🎉🚀");
+      t.stop();
+      expect(t.getEntries()[1].taskName).toBe("🎉🚀");
+    });
+
+    it("handles unicode in summary", () => {
+      vi.useFakeTimers();
+      const t = tracker();
+      t.start("codificación");
+      vi.advanceTimersByTime(1000);
+      t.stop();
+      const summary = t.getSummary();
+      expect(summary.get("codificación")).toBe(1000);
+      vi.useRealTimers();
+    });
+  });
+});
