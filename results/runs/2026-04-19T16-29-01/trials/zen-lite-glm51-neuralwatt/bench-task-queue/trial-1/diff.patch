string): string {\n    return name ?? DEFAULT_QUEUE;\n  }\n\n  private getOrCreateQueue(name: string): NamedQueue {\n    let q = this.queues.get(name);\n    if (!q) {\n      q = new NamedQueue(name);\n      this.queues.set(name, q);\n    }\n    return q;\n  }\n\n  private getQueue(name: string): NamedQueue | undefined {\n    return this.queues.get(name);\n  }\n\n  private ensureNotShutdown(): void {\n    if (this.shutdownInitiated) {\n      throw new Error('Cannot add tasks after shutdown has been initiated');\n    }\n  }\n\n  // ── Phase 1: Basic FIFO Queue ─────────────────────────────\n\n  addTask<T = unknown>(payload: T, options?: AddTaskOptions): Task<T> {\n    this.ensureNotShutdown();\n\n    const queueName = this.resolveQueueName(options?.queueName);\n    const priority = options?.priority ?? 5;\n    const maxRetries = options?.maxRetries ?? 3;\n    const baseDelay = options?.baseDelay ?? 1000;\n\n    if (priority < 1 || priority > 10) {\n      throw new Error(`Invalid priority: ${priority}. Must be between 1 and 10.`);\n    }\n\n    const now = Date.now();\n\n    // Compute availableAt\n    let availableAt = now;\n    if (options?.availableAt !== undefined) {\n      availableAt = options.availableAt;\n    } else if (options?.delay !== undefined) {\n      availableAt = now + options.delay;\n    }\n\n    // Validate dependencies (Phase 7)\n    const dependencies = options?.dependencies ?? [];\n    for (const depId of dependencies) {\n      const depTask = this.tasks.get(depId);\n      if (!depTask) {\n        throw new Error(`Dependency task not found: ${depId}`);\n      }\n    }\n\n    // Circular dependency check (Phase 7)\n    if (dependencies.length > 0) {\n      const tempId = generateId(); // provisional ID for cycle check\n      // Actually, we need to check using the real task's deps.\n      // Since the new task doesn't exist yet, no existing task depends on it.\n      // But let's do a thorough check: walk the dependency graph from the new task's deps\n      // and see if we ever come back to a dep that is also a dependent.\n      // Since the task doesn't exist yet, cycles can't form through normal add.\n      // We still implement the check for robustness.\n      this.checkCircularDependency(tempId, dependencies);\n    }\n\n    const task: Task<T> = {\n      id: generateId(),\n      payload,\n      status: 'pending' as TaskStatus,\n      createdAt: now,\n      queueName,\n      priority,\n      availableAt,\n      maxRetries,\n      baseDelay,\n      attempts: 0,\n      dependencies,\n      progress: 0,\n      failedCount: 0,\n    };\n\n    // Register in global map\n    this.tasks.set(task.id, task);\n\n    // Add to queue\n    const queue = this.getOrCreateQueue(queueName);\n    queue.pendingIds.push(task.id);\n\n    // Register reverse dependencies\n    for (const depId of dependencies) {\n      let set = this.dependents.get(depId);\n      if (!set) {\n        set = new Set();\n        this.dependents.set(depId, set);\n      }\n      set.add(task.id);\n    }\n\n    return task;\n  }\n\n  private checkCircularDependency(newTaskId: string, deps: string[]): void {\n    // DFS through deps to see if we can reach the new task (which shouldn't be possible\n    // since it doesn't exist yet, but we check for robustness and future-proofing)\n    const visited = new Set<string>();\n    const stack = [...deps];\n\n    while (stack.length > 0) {\n      const current = stack.pop()!;\n      if (current === newTaskId) {\n        throw new Error('Circular dependency detected');\n      }\n      if (visited.has(current)) continue;\n      visited.add(current);\n\n      const task = this.tasks.get(current);\n      if (task && task.dependencies.length > 0) {\n        for (const depId of task.dependencies) {\n          stack.push(depId);\n        }\n      }\n    }\n  }\n\n  process(queueName?: string): Task | null {\n    const name = this.resolveQueueName(queueName);\n    const queue = this.getQueue(name);\n    if (!queue) return null;\n\n    // Check concurrency limit\n    if (queue.concurrency !== null && queue.processingIds.size >= queue.concurrency) {\n      return null;\n    }\n\n    const now = Date.now();\n\n    // Find the best available task\n    const task = this.getNextAvailableTask(queue, now);\n    if (!task) return null;\n\n    // Transition to processing\n    task.attempts++;\n    task.status = 'processing';\n    queue.pendingIds = queue.pendingIds.filter(id => id !== task.id);\n    queue.processingIds.add(task.id);\n\n    // Set up processing promise for shutdown tracking\n    let resolver!: () => void;\n    const promise = new Promise<void>(resolve => {\n      resolver = resolve;\n    });\n    this.processingResolvers.set(task.id, resolver);\n\n    // Run middleware + handler pipeline if registered\n    if (queue.handler || queue.middleware.length > 0) {\n      this.runPipeline(task, queue);\n    }\n\n    return task;\n  }\n\n  private getNextAvailableTask(queue: NamedQueue, now: number): Task | null {\n    const candidates: Task[] = [];\n\n    for (const id of queue.pendingIds) {\n      const task = this.tasks.get(id);\n      if (!task) continue;\n\n      // Must be available\n      if (task.availableAt > now) continue;\n\n      // Must have all dependencies completed\n      if (!this.areDependenciesResolved(task)) continue;\n\n      candidates.push(task);\n    }\n\n    if (candidates.length === 0) return null;\n\n    // Sort: availableAt asc, priority asc, createdAt asc\n    candidates.sort((a, b) => {\n      if (a.availableAt !== b.availableAt) return a.availableAt - b.availableAt;\n      if (a.priority !== b.priority) return a.priority - b.priority;\n      return a.createdAt - b.createdAt;\n    });\n\n    return candidates[0];\n  }\n\n  private areDependenciesResolved(task: Task): boolean {\n    if (task.dependencies.length === 0) return true;\n    return task.dependencies.every(depId => {\n      const dep = this.tasks.get(depId);\n      return dep && dep.status === 'completed';\n    });\n  }\n\n  size(queueName?: string): number {\n    const name = this.resolveQueueName(queueName);\n    const queue = this.getQueue(name);\n    if (!queue) return 0;\n    return queue.pendingIds.length;\n  }\n\n  // ── Phase 2: Named Queues ─────────────────────────────────\n\n  listQueues(): string[] {\n    return [...this.queues.keys()];\n  }\n\n  // ── Phase 3: Priority ─────────────────────────────────────\n  // (handled in addTask and getNextAvailableTask)\n\n  // ── Phase 4: Delayed Tasks ────────────────────────────────\n  // (handled in addTask and getNextAvailableTask)\n\n  // ── Phase 5: Retry with Backoff ───────────────────────────\n\n  complete(taskId: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    const queue = this.getQueue(task.queueName);\n\n    task.status = 'completed';\n    if (queue) {\n      queue.processingIds.delete(taskId);\n    }\n\n    // Resolve processing promise\n    const resolver = this.processingResolvers.get(taskId);\n    if (resolver) {\n      resolver();\n      this.processingResolvers.delete(taskId);\n    }\n\n    // Check if any dependent tasks are now unblocked\n    this.notifyDependents(taskId);\n  }\n\n  fail(taskId: string, error?: unknown): void {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    task.error = error;\n    task.failedCount++;\n\n    const queue = this.getQueue(task.queueName);\n    if (queue) {\n      queue.processingIds.delete(taskId);\n    }\n\n    // Resolve processing promise\n    const resolver = this.processingResolvers.get(taskId);\n    if (resolver) {\n      resolver();\n      this.processingResolvers.delete(taskId);\n    }\n\n    // Check if retries remaining\n    if (task.attempts <= task.maxRetries) {\n      // Retry with exponential backoff\n      const backoffDelay = task.baseDelay * Math.pow(2, task.attempts - 1);\n      task.status = 'pending';\n      task.availableAt = Date.now() + backoffDelay;\n\n      if (queue) {\n        queue.pendingIds.push(taskId);\n      }\n    } else {\n      // No more retries\n      task.status = 'failed';\n\n      // Move to DLQ (Phase 6)\n      if (queue) {\n        queue.dlqIds.push(taskId);\n      }\n    }\n  }\n\n  // ── Phase 6: Dead Letter Queue ────────────────────────────\n\n  getDeadLetteredTasks(queueName?: string): Task[] {\n    const name = this.resolveQueueName(queueName);\n    const queue = this.getQueue(name);\n    if (!queue) return [];\n    return queue.dlqIds.map(id => this.tasks.get(id)!).filter(Boolean);\n  }\n\n  retryDeadLetteredTask(taskId: string): Task {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n    if (task.status !== 'failed') throw new Error(`Task ${taskId} is not in the dead letter queue`);\n\n    const queue = this.getQueue(task.queueName);\n    if (!queue) throw new Error(`Queue not found: ${task.queueName}`);\n\n    // Remove from DLQ\n    queue.dlqIds = queue.dlqIds.filter(id => id !== taskId);\n\n    // Reset for fresh round of retries\n    task.status = 'pending';\n    task.attempts = 0;\n    task.availableAt = Date.now();\n    task.error = undefined;\n\n    // Add back to pending\n    queue.pendingIds.push(taskId);\n\n    return task;\n  }\n\n  clearDeadLetterQueue(queueName?: string): void {\n    const name = this.resolveQueueName(queueName);\n    const queue = this.getQueue(name);\n    if (!queue) return;\n    queue.dlqIds = [];\n  }\n\n  // ── Phase 7: Task Dependencies ────────────────────────────\n\n  getTask(taskId: string): Task | undefined {\n    return this.tasks.get(taskId);\n  }\n\n  getDependencyStatus(taskId: string): { resolved: string[]; unresolved: string[] } {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    const resolved: string[] = [];\n    const unresolved: string[] = [];\n\n    for (const depId of task.dependencies) {\n      const dep = this.tasks.get(depId);\n      if (dep && dep.status === 'completed') {\n        resolved.push(depId);\n      } else {\n        unresolved.push(depId);\n      }\n    }\n\n    return { resolved, unresolved };\n  }\n\n  private notifyDependents(completedTaskId: string): void {\n    const depSet = this.dependents.get(completedTaskId);\n    if (!depSet) return;\n\n    // For each task that depends on the completed task, check if it's now unblocked\n    // No action needed other than making it eligible for processing —\n    // getNextAvailableTask will pick it up on the next process() call\n  }\n\n  // ── Phase 8: Concurrency Control ──────────────────────────\n\n  setConcurrency(queueName: string, limit: number): void {\n    const queue = this.getOrCreateQueue(queueName);\n    queue.concurrency = limit;\n  }\n\n  getConcurrency(queueName: string): number | null {\n    const queue = this.getQueue(queueName);\n    return queue?.concurrency ?? null;\n  }\n\n  getActiveCount(queueName: string): number {\n    const queue = this.getQueue(queueName);\n    return queue?.processingIds.size ?? 0;\n  }\n\n  // ── Phase 9: Progress & Cancellation ──────────────────────\n\n  reportProgress(taskId: string, progress: number, message?: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    task.progress = progress;\n    if (message !== undefined) {\n      task.progressMessage = message;\n    }\n\n    // Notify listeners\n    const queue = this.getQueue(task.queueName);\n    if (queue) {\n      const listeners = queue.progressListeners.get(taskId);\n      if (listeners) {\n        for (const listener of listeners) {\n          listener(progress, message);\n        }\n      }\n    }\n  }\n\n  getProgress(taskId: string): number {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n    return task.progress;\n  }\n\n  onProgress(taskId: string, listener: ProgressListener): ProgressSubscription {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    const queue = this.getOrCreateQueue(task.queueName);\n    let listeners = queue.progressListeners.get(taskId);\n    if (!listeners) {\n      listeners = new Set();\n      queue.progressListeners.set(taskId, listeners);\n    }\n    listeners.add(listener);\n\n    return {\n      unsubscribe: () => {\n        listeners!.delete(listener);\n        if (listeners!.size === 0) {\n          queue.progressListeners.delete(taskId);\n        }\n      },\n    };\n  }\n\n  cancel(taskId: string): void {\n    const task = this.tasks.get(taskId);\n    if (!task) throw new Error(`Task not found: ${taskId}`);\n\n    if (task.status !== 'pending' && task.status !== 'processing') {\n      throw new Error(`Cannot cancel task in ${task.status} state`);\n    }\n\n    const queue = this.getQueue(task.queueName);\n    const wasProcessing = task.status === 'processing';\n\n    task.status = 'cancelled';\n\n    if (task.status === 'pending' || !wasProcessing) {\n      // Remove from pending\n      if (queue) {\n        queue.pendingIds = queue.pendingIds.filter(id => id !== taskId);\n      }\n    }\n\n    if (wasProcessing) {\n      if (queue) {\n        queue.processingIds.delete(taskId);\n      }\n\n      // Resolve processing promise\n      const resolver = this.processingResolvers.get(taskId);\n      if (resolver) {\n        resolver();\n        this.processingResolvers.delete(taskId);\n      }\n    }\n  }\n\n  // ── Phase 10: Recurring Tasks ─────────────────────────────\n\n  addSchedule(options: Omit<CronSchedule, 'id' | 'lastRunAt'>): CronSchedule {\n    this.ensureNotShutdown();\n\n    const schedule: CronSchedule = {\n      id: generateId(),\n      expression: options.expression,\n      queueName: options.queueName,\n      payload: options.payload,\n      taskOptions: options.taskOptions,\n   