+/**
+ * Simple cron expression parser supporting:
+ *   */N * * * *  — every N minutes
+ *   0 * * * *    — every hour on the hour
+ *   0 0 * * *    — every day at midnight
+ */
+
+export interface CronExpression {
+  minute: number | '*';
+  hour: number | '*';
+  dayOfMonth: number | '*';
+  month: number | '*';
+  dayOfWeek: number | '*';
+  everyNMinutes?: number;
+}
+
+export function parseCron(expr: string): CronExpression {
+  const parts = expr.trim().split(/\s+/);
+  if (parts.length !== 5) {
+    throw new Error(`Invalid cron expression: "${expr}" — expected 5 fields`);
+  }
+
+  const [minuteStr, hourStr, dayOfMonthStr, monthStr, dayOfWeekStr] = parts;
+
+  // Check for */N minute pattern
+  const everyNMatch = minuteStr.match(/^\*\/(\d+)$/);
+  if (everyNMatch) {
+    const n = parseInt(everyNMatch[1], 10);
+    if (n <= 0) {
+      throw new Error(`Invalid cron expression: */${n} — N must be positive`);
+    }
+    return {
+      minute: '*',
+      hour: '*',
+      dayOfMonth: '*',
+      month: '*',
+      dayOfWeek: '*',
+      everyNMinutes: n,
+    };
+  }
+
+  return {
+    minute: parseField(minuteStr, 'minute', 0, 59),
+    hour: parseField(hourStr, 'hour', 0, 23),
+    dayOfMonth: parseField(dayOfMonthStr, 'day of month', 1, 31),
+    month: parseField(monthStr, 'month', 1, 12),
+    dayOfWeek: parseField(dayOfWeekStr, 'day of week', 0, 6),
+  };
+}
+
+function parseField(
+  field: string,
+  name: string,
+  min: number,
+  max: number,
+): number | '*' {
+  if (field === '*') return '*';
+  const n = parseInt(field, 10);
+  if (isNaN(n) || n < min || n > max) {
+    throw new Error(
+      `Invalid cron ${name} field: "${field}" — expected ${min}-${max} or "*"`,
+    );
+  }
+  return n;
+}
+
+/**
+ * Returns true if the cron schedule is due at the given time (or now).
+ */
+export function isDue(parsed: CronExpression, now: number): boolean {
+  const d = new Date(now);
+
+  if (parsed.everyNMinutes !== undefined) {
+    return d.getMinutes() % parsed.everyNMinutes === 0 && d.getSeconds() === 0;
+  }
+
+  if (parsed.minute !== '*' && d.getMinutes() !== parsed.minute) return false;
+  if (parsed.hour !== '*' && d.getHours() !== parsed.hour) return false;
+  if (parsed.dayOfMonth !== '*' && d.getDate() !== parsed.dayOfMonth)
+    return false;
+  if (parsed.month !== '*' && d.getMonth() + 1 !== parsed.month) return false;
+  if (parsed.dayOfWeek !== '*' && d.getDay() !== parsed.dayOfWeek)
+    return false;
+
+  return d.getSeconds() === 0;
+}
