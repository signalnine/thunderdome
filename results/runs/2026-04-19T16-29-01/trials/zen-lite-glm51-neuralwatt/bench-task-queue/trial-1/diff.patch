d yet, fail it\n          if (task.status === 'processing') {\n            this.fail(task.id, err);\n          }\n        }\n      } else if (handler) {\n        try {\n          handler(task);\n        } catch (err) {\n          if (task.status === 'processing') {\n            this.fail(task.id, err);\n          }\n        }\n      }\n    };\n\n    runNext();\n  }\n\n  // ── Phase 12: Graceful Shutdown ───────────────────────────\n\n  async shutdown(timeout: number = 30000): Promise<ShutdownSummary> {\n    // Idempotent\n    if (this._shutdownResult) return this._shutdownResult;\n\n    this.shutdownInitiated = true;\n    const start = Date.now();\n\n    // Collect all currently-processing task IDs\n    const processingIds: string[] = [];\n    for (const [, queue] of this.queues) {\n      for (const id of queue.processingIds) {\n        processingIds.push(id);\n      }\n    }\n\n    let forceCancelled = 0;\n\n    if (processingIds.length > 0) {\n      // Wait for all processing promises or timeout\n      const promises = processingIds\n        .map(id => this.processingResolvers.get(id))\n        .filter((r): r is () => void => r !== undefined)\n        .map(r => new Promise<void>(resolve => r = (() => { r(); resolve(); }) as () => void));\n\n      // Rebuild: wait for each resolver to be called\n      const waitPromises = processingIds.map(id =>\n        new Promise<void>(resolve => {\n          const existingResolver = this.processingResolvers.get(id);\n          if (existingResolver) {\n            // Wrap: call the original resolver, then resolve our wait promise\n            this.processingResolvers.set(id, () => {\n              existingResolver();\n              resolve();\n            });\n          } else {\n            resolve();\n          }\n        }),\n      );\n\n      const allDone = Promise.all(waitPromises);\n      const timeoutPromise = new Promise<'timeout'>(resolve =>\n        setTimeout(() => resolve('timeout'), timeout),\n      );\n\n      awa