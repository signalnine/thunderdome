duler.register('sync', syncJob, 60_000);\n  scheduler.register('cleanup', async () => { await cleanupJob(); }, 300_000);\n  return scheduler;\n}\n\nconst isMainModule = process.argv[1]?.includes('worker/dist/index.js');\nif (isMainModule) {\n  console.log('Starting worker...');\n  const worker = createWorker();\n  worker.start();\n  process.on('SIGINT', () => {\n    console.log('Shutting down worker...');\n    worker.stop();\n    process.exit(0);\n  });\n}\n```\n\n#### `/workspace/packages/worker/src/scheduler.ts`\n```ts\n/**\n * Simple job scheduler for background tasks.\n */\n\nexport interface JobDefinition {\n  name: string;\n  handler: () => Promise<void> | void;\n  intervalMs: number;\n  timer?: ReturnType<typeof setInterval>;\n  lastRun?: Date;\n  runCount: number;\n  errors: string[];\n}\n\nexport class Scheduler {\n  private jobs: Map<string, JobDefinition> = new Map();\n  private running = false;\n\n  register(name: string, handler: () => Promise<void> | void, intervalMs: number): void {\n    this.jobs.set(name, { name, handler, intervalMs, runCount: 0, errors: [] });\n  }\n\n  start(): void {\n    if (this.running) return;\n    this.running = true;\n    for (const [, job] of this.jobs) {\n      job.timer = setInterval(async () => {\n        try {\n          await job.handler();\n          job.lastRun = new Date();\n          job.runCount++;\n        } catch (err) {\n          job.errors.push(err instanceof Error ? err.message : String(err));\n        }\n      }, job.intervalMs);\n    }\n  }\n\n  stop(): void {\n    if (!this.running) return;\n    this.running = false;\n    for (const [, job] of this.jobs) {\n      if (job.timer) { clearInterval(job.timer); job.timer = undefined; }\n    }\n  }\n\n  async runOnce(name: string): Promise<void> {\n    const job = this.jobs.get(name);\n    if (!job) { throw new Error(`Job '${name}' not found`); }\n    await job.handler();\n    job.lastRun = new Date();\n    job.runCount++;\n  }\n\n  getStatus(): Array<{ name: s