ed_at TEXT NOT NULL DEFAULT (datetime('now'))\n    );\n    CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);\n    CREATE INDEX IF NOT EXISTS idx_users_role ON users(role);\n  `);\n}\n\nexport function insertUser(\n  conn: DatabaseConnection,\n  user: { name: string; email: string; role: string }\n): User {\n  const stmt = conn.db.prepare(\n    'INSERT INTO users (name, email, role) VALUES (?, ?, ?) RETURNING *'\n  );\n  const row = stmt.get(user.name, user.email, user.role) as {\n    id: number; name: string; email: string; role: string;\n    created_at: string; updated_at: string;\n  };\n  return {\n    id: row.id, name: row.name, email: row.email,\n    role: row.role as User['role'],\n    createdAt: row.created_at, updatedAt: row.updated_at,\n  };\n}\n\nexport function findUserById(conn: DatabaseConnection, id: number): User | null {\n  const stmt = conn.db.prepare('SELECT * FROM users WHERE id = ?');\n  const row = stmt.get(id) as {\n    id: number; name: string; email: string; role: string;\n    created_at: string; updated_at: string;\n  } | undefined;\n  if (!row) return null;\n  return {\n    id: row.id, name: row.name, email: row.email,\n    role: row.role as User['role'],\n    createdAt: row.created_at, updatedAt: row.updated_at,\n  };\n}\n\nexport function findAllUsers(conn: DatabaseConnection): User[] {\n  const stmt = conn.db.prepare('SELECT * FROM users ORDER BY id');\n  const rows = stmt.all() as Array<{\n    id: number; name: string; email: string; role: string;\n    created_at: string; updated_at: string;\n  }>;\n  return rows.map((row) => ({\n    id: row.id, name: row.name, email: row.email,\n    role: row.role as User['role'],\n    createdAt: row.created_at, updatedAt: row.updated_at,\n  }));\n}\n```\n\n#### `/workspace/packages/core/src/permissions.ts`\n```ts\n/**\n * Permission checking and role-based access control.\n */\n\nimport type { Role, Permission } from './types.js';\n\nconst ROLE_PERMISSIONS: Record<Role, Permission[]> = {\n  a