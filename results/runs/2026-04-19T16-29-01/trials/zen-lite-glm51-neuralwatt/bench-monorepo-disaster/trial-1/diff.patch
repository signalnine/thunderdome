g; email: string; role: Role };\n  errors?: string[];\n} {\n  const result = createUserSchema.safeParse(data);\n  if (result.success) {\n    return { success: true, data: result.data };\n  }\n  return {\n    success: false,\n    errors: result.error.errors.map((e) => e.message),\n  };\n}\n\nexport function validateUserId(id: string): {\n  success: boolean;\n  data?: number;\n  errors?: string[];\n} {\n  const result = userIdSchema.safeParse(id);\n  if (result.success) {\n    return { success: true, data: result.data };\n  }\n  return {\n    success: false,\n    errors: result.error.errors.map((e) => e.message),\n  };\n}\n```\n\n**NOTE:** The comment says `z.pipe()` requires zod >= 3.22, but `package.json` pins zod at `3.19.0`. This is breakage #4.\n\n#### `/workspace/packages/core/src/index.ts`\n```ts\n/**\n * @monorepo/core - Shared business logic\n */\n\n// Types\nexport type { User, CreateUserInput, UserFilters, Role, Permission } from './types.js';\n\n// User management\nexport {\n  registerUser,\n  validateUser,\n  getUserById,\n  getAllUsers,\n  canUserPerformAction,\n  getDefaultConnection,\n  resetDefaultConnection,\n} from './user.js';\n\n// Validation\nexport {\n  createUserSchema,\n  userIdSchema,\n  userFiltersSchema,\n  roleSchema,\n  validateCreateUser,\n  validateUserId,\n} from './validation.js';\n\n// Database\nexport {\n  createDatabase,\n  createTables,\n  insertUser,\n  findUserById,\n  findAllUsers,\n  type DatabaseConnection,\n} from './database.js';\n\n// Permissions\nexport {\n  hasPermission,\n  getAllPermissions,\n  canManageUsers,\n  canWrite,\n  canDelete,\n  requirePermission,\n} from './permissions.js';\n```\n\n**NOTE:** The barrel export does NOT export `createUser` -- it exports `registerUser` instead. This confirms the rename. But downstream consumers (`api` and `worker`) still import `createUser`.\n\n#### Core Tests\n\n**`/workspace/packages/core/tests/permissions.test.ts`** -- 7 test cases covering `hasPermission`, `getAllPermissio