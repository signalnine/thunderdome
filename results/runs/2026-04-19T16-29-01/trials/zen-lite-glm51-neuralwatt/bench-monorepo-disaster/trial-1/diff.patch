h is a committed secret. This is one of the 6 known breakages.\n\n#### `/workspace/TASK.md`\nDescribes the challenge: a three-package TypeScript monorepo broken after a botched merge. Lists 6 known breakages:\n1. Circular dependency in `packages/core`\n2. Half-renamed function (`createUser` -> `registerUser` but some call sites still use `createUser`)\n3. Broken tsconfig project references (wrong build order)\n4. Dependency version conflict (pinned version too old for APIs used)\n5. Merge conflict markers in a test file\n6. Committed `.env` file with secrets\n\nSuccess criteria: `npm run build` exits 0, `npm run lint` exits 0, `npm test` passes all tests (35+ unit + 5 structural), no circular deps, no merge conflict markers, no `.env` with passwords/secrets, TypeScript strict mode enabled in all packages.\n\n---\n\n### 3. PACKAGE: @monorepo/core\n\n#### `/workspace/packages/core/package.json`\n```json\n{\n  \"name\": \"@monorepo/core\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"scripts\": {\n    \"build\": \"tsc\"\n  },\n  \"dependencies\": {\n    \"zod\": \"3.19.0\",\n    \"better-sqlite3\": \"^11.0.0\"\n  },\n  \"devDependencies\": {\n    \"@types/better-sqlite3\": \"^7.6.0\",\n    \"typescript\": \"^5.4.0\"\n  }\n}\n```\n\n**NOTE:** `zod` is pinned at `\"3.19.0\"`. The `validation.ts` file uses `z.pipe()` with `z.coerce.number()` which requires zod >= 3.22. This is breakage #4 (dependency version conflict).\n\n#### `/workspace/packages/core/tsconfig.json`\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"Node16\",\n    \"moduleResolution\": \"Node16\",\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"strict\": true,\n    \"composite\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true\n  },\n  \"include\": [\"src/**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\"]\n}\n```\n\n#### `/workspace/packages/core/src/types.ts`\n```ts\n/**\n * Shared types for the monorepo.\n */\n\nimport { getUserById } from './user.js';\n\nexport type Role = 'admin' | 'user' | 'viewer';\n\nexport type Permission =\n  | 'read'\n  | 'write'\n  | 'delete'\n  | 'manage_users'\n  | 'view_reports';\n\nexport interface User {\n  id: number;\n  name: string;\n  email: string;\n  role: Role;\n  createdAt: string;\n  updatedAt: string;\n}\n\nexport interface CreateUserInput {\n  name: string;\n  email: string;\n  role: Role;\n}\n\nexport interface UserFilters {\n  role?: Role;\n  search?: string;\n  limit?: number;\n  offset?: number;\n}\n\n/** Utility to check if a user exists by ID */\nexport function userExists(id: number): boolean {\n  return getUserById(id) !== null;\n}\n```\n\n**NOTE -- CIRCULAR DEPENDENCY (breakage #1):** `types.ts` imports `getUserById` from `./user.js`. Meanwhile, `user.ts` imports types from `./types.js`. This creates a circular dependency: `types.ts` -> `user.ts` -> `types.ts`. The `userExists` function in `types.ts` should be moved elsewhere (e.g., into `user.ts`).\n\n#### `/workspace/packages/core/src/user.ts`\n```ts\n/**\n * User management: creation, validation, and retrieval.\n */\n\nimport type { User, CreateUserInput } from './types.js';\nimport { validateCreateUser } from './validation.js';\nimport { hasPermission } from './permissions.js';\nimport {\n  createDatabase,\n  createTables,\n  insertUser,\n  findUserById,\n  findAllUsers,\n  type DatabaseConnection,\n} from './database.js';\n\nlet defaultConn: DatabaseConnection | null = null;\n\nexport function getDefaultConnection(): DatabaseConnection {\n  if (!defaultConn) {\n    defaultConn = createDatabase(':memory:');\n    createTables(defaultConn);\n  }\n  return defaultConn;\n}\n\nexport function resetDefaultConnection(): void {\n  if (defaultConn) {\n    defaultConn.close();\n    defaultConn = null;\n  }\n}\n\nexport function registerUser(input: CreateUserInput): User {\n  const validation = validateCreateUser(input);\n  if (!validation.success) {\n    throw new Error(`Invalid user data: ${validation.errors?.join(', ')}`);\n  }\n\n  const conn = getDefaultConnection();\n  return insertUser(conn, input);\n}\n\nexport function validateUser(input: unknown): {\n  valid: boolean;\n  errors?: string[];\n} {\n  const result = validateCreateUser(input);\n  return {\n    valid: result.success,\n    errors: result.errors,\n  };\n}\n\nexport function getUserById(id: number): User | null {\n  const conn = getDefaultConnection();\n  return findUserById(conn, id);\n}\n\nexport function getAllUsers(): User[] {\n  const conn = getDefaultConnection();\n  return findAllUsers(conn);\n}\n\nexport function canUserPerformAction(\n  userRole: User['role'],\n  action: 'read' | 'write' | 'delete'\n): boolean {\n  return hasPermission(userRole, action);\n}\n```\n\n**NOTE:** The function is `registerUser`, but the API routes and worker jobs still call `createUser`. This is breakage #2 (half-renamed function).\n\n#### `/workspace/packages/core/src/database.ts`\n```ts\n/**\n * Database connection factory and table creation.\n * Uses better-sqlite3 for a simple embedded database.\n */\n\nimport Database from 'better-sqlite3';\nimport type { User } from './types.js';\n\nexport interface DatabaseConnection {\n  db: Database.Database;\n  close: () => void;\n}\n\nexport function createDatabase(path: string = ':memory:'): DatabaseConnection {\n  const db = new Database(path);\n  db.pragma('journal_mode = WAL');\n  db.pragma('foreign_keys = ON');\n  return {\n    db,\n    close: () => db.close(),\n  };\n}\n\nexport function createTables(conn: DatabaseConnection): void {\n  conn.db.exec(`\n    CREATE TABLE IF NOT EXISTS users (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      name TEXT NOT NULL,\n      email TEXT NOT NULL UNIQUE,\n      role TEXT NOT NULL CHECK(role IN ('admin', 'user', 'viewer')),\n      created_at TEXT NOT NULL DEFAULT (datetime('now')),\n      updated_at TEXT NOT NULL DEFAULT (datetime('now'))\n    );\n    CREATE INDEX IF NOT EXISTS idx_users_email ON users(email);\n    CREATE INDEX IF NOT EXISTS idx_users_role ON users(role);\n  `);\n}\n\nexport function insertUser(\n  conn: DatabaseConnection,\n  user: { name: string; email: string; role: string }\n): User {\n  const stmt = conn.db.prepare(\n    'INSERT INTO users (name, email, role) VALUES (?, ?, ?) RETURNING *'\n  );\n  const row = stmt.get(user.name, user.email, user.role) as {\n    id: number; name: string; email: string; role: string;\n    created_at: string; updated_at: string;\n  };\n  return {\n    id: row.id, name: row.name, email: row.email,\n    role: row.role as User['role'],\n    createdAt: row.created_at, updatedAt: row.updated_at,\n  };\n}\n\nexport function findUserById(conn: DatabaseConnection, id: number): User | null {\n  const stmt = conn.db.prepare('SELECT * FROM users WHERE id = ?');\n  const row = stmt.get(id) as {\n    id: number; name: string; email: string; role: string;\n    created_at: string; updated_at: string;\n  } | undefined;\n  if (!row) return null;\n  return {\n    id: row.id, name: row.name, email: row.email,\n    role: row.role as User['role'],\n    createdAt: row.created_at, updatedAt: row.updated_at,\n  };\n}\n\nexport function findAllUsers(conn: DatabaseConnection): User[] {\n  const stmt = conn.db.prepare('SELECT * FROM users ORDER BY id');\n  const rows = stmt.all() as Array<{\n    id: number; name: string; email: string; role: string;\n    created_at: string; updated_at: string;\n  }>;\n  return rows.map((row) => ({\n    id: row.id, name: row.name, email: row.email,\n    role: row.role as User['role'],\n    createdAt: row.created_at, updatedAt: row.updated_at,\n  }));\n}\n```\n\n#### `/workspace/packages/core/src/permissions.ts`\n```ts\n/**\n * Permission checking and role-based access control.\n */\n\nimport type { Role, Permission } from './types.js';\n\nconst ROLE_PERMISSIONS: Record<Role, Permission[]> = {\n  admin: ['read', 'write', 'delete', 'manage_users', 'view_reports'],\n  user: ['read', 'write', 'view_reports'],\n  viewer: ['read'],\n};\n\nexport function hasPermission(role: Role, permission: Permission): boolean {\n  const permissions = ROLE_PERMISSIONS[role];\n  return permissions.includes(permission);\n}\n\nexport function getAllPermissions(role: Role): Permission[] {\n  return [...ROLE_PERMISSIONS[role]];\n}\n\nexport function canManageUsers(role: Role): boolean {\n  return hasPermission(role, 'manage_users');\n}\n\nexport function canWrite(role: Role): boolean {\n  return hasPermission(role, 'write');\n}\n\nexport function canDelete(role: Role): boolean {\n  return hasPermission(role, 'delete');\n}\n\nexport function requirePermission(role: Role, permission: Permission): void {\n  if (!hasPermission(role, permission)) {\n    throw new Error(\n      `Role '${role}' does not have permission '${permission}'`\n    );\n  }\n}\n```\n\n#### `/workspace/packages/core/src/validation.ts`\n```ts\n/**\n * Schema validation using zod.\n * Uses z.pipe() for string-to-number coercion (requires zod >= 3.22).\n */\n\nimport { z } from 'zod';\nimport type { Role } from './types.js';\n\nexport const roleSchema = z.enum(['admin', 'user', 'viewer']);\n\nexport const createUserSchema = z.object({\n  name: z.string().min(1, 'Name is required').max(100, 'Name must be 100 characters or less'),\n  email: z.string().email('Invalid email address'),\n  role: roleSchema,\n});\n\nexport const userIdSchema = z\n  .string()\n  .pipe(z.coerce.number().int().positive('User ID must be a positive integer'));\n\nexport const userFiltersSchema = z.object({\n  role: roleSchema.optional(),\n  search: z.string().optional(),\n  limit: z.string().pipe(z.coerce.number().int().min(1).max(100)).optional().default('20'),\n  offset: z.string().pipe(z.coerce.number().int().min(0)).optional().default('0'),\n});\n\nexport function validateCreateUser(data: unknown): {\n  success: boolean;\n  data?: { name: string; email: string; role: Role };\n  errors?: string[];\n} {\n  const result = createUserSchema.safeParse(data);\n  if (result.success) {\n    return { success: true, data: result.data };\n  }\n  return {\n    success: false,\n    errors: result.error.errors.map((e) => e.message),\n  };\n}\n\nexport function validateUserId(id: string): {\n  success: boolean;\n  data?: number;\n  errors?: string[];\n} {\n  const result = userIdSchema.safeParse(id);\n  if (result.success) {\n    return { success: true, data: result.data };\n  }\n  return {\n    success: false,\n    errors: result.error.errors.map((e) => e.message),\n  };\n}\n```\n\n**NOTE:** The comment says `z.pipe()` requires zod >= 3.22, but `package.json` pins zod at `3.19.0`. This is breakage #4.\n\n#### `/workspace/packages/core/src/index.ts`\n```ts\n/**\n * @monorepo/core - Shared business logic\n */\n\n// Types\nexport type { User, CreateUserInput, UserFilters, Role, Permission } from './types.js';\n\n// User management\nexport {\n  registerUser,\n  validateUser,\n  getUserById,\n  getAllUsers,\n  canUserPerformAction,\n  getDefaultConnection,\n  resetDefaultConnection,\n} from './user.js';\n\n// Validation\nexport {\n  createUserSchema,\n  userIdSchema,\n  userFiltersSchema,\n  roleSchema,\n  validateCreateUser,\n  validateUserId,\n} from './validation.js';\n\n// Database\nexport {\n  createDatabase,\n  createTables,\n  insertUser,\n  findUserById,\n  findAllUsers,\n  type DatabaseConnection,\n} from './database.js';\n\n// Permissions\nexport {\n  hasPermission,\n  getAllPermissions,\n  canManageUsers,\n  canWrite,\n  canDelete,\n  requirePermission,\n} from './permissions.js';\n```\n\n**NOTE:** The barrel export does NOT export `createUser` -- it exports `registerUser` instead. This confirms the rename. But downstream consumers (`api` and `worker`) still import `createUser`.\n\n#### Core Tests\n\n**`/workspace/packages/core/tests/permissions.test.ts`** -- 7 test cases covering `hasPermission`, `getAllPermissions`, `canManageUsers`, `canWrite`, `canDelete`, `requirePermission`.\n\n**`/workspace/packages/core/tests/user.test.ts`** -- 6 test cases covering `registerUser`, `validateUser`, `getUserById`, `getAllUsers`. Uses `resetDefaultConnection` in `beforeEach`.\n\n**`/workspace/packages/core/tests/validation.test.ts`** -- 5 test cases covering `validateCreateUser`, `validateUserId`, `userFiltersSchema`. Tests the `z.pipe()` coercion behavior.\n\n---\n\n### 4. PACKAGE: @monorepo/api\n\n#### `/workspace/packages/api/package.json`\n```json\n{\n  \"name\": \"@monorepo/api\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\"\n  },\n  \"dependencies\": {\n    \"@monorepo/core\": \"*\",\n    \"express\": \"^4.21.0\"\n  },\n  \"devDependencies\": {\n    \"@types/express\": \"^4.17.0\",\n    \"supertest\": \"^7.0.0\",\n    \"@types/supertest\": \"^6.0.0\",\n    \"typescript\": \"^5.4.0\"\n  }\n}\n```\n\n#### `/workspace/packages/api/tsconfig.json`\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"Node16\",\n    \"moduleResolution\": \"Node16\",\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"strict\": true,\n    \"composite\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true\n  },\n  \"include\": [\"src/**/*.ts\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"tests\"],\n  \"references\": [\n    { \"path\": \"../core\" }\n  ]\n}\n```\n\n#### `/workspace/packages/api/src/index.ts`\n```ts\n/**\n * Express API application setup.\n */\n\nimport express from 'express';\nimport { usersRouter } from './routes/users.js';\nimport { authRouter } from './routes/auth.js';\nimport { authMiddleware } from './middleware/auth.js';\n\nexport function createApp() {\n  const app = express();\n  app.use(express.json());\n  app.get('/health', (_req, res) => { res.json({ status: 'ok' }); });\n  app.use('/auth', authRouter);\n  app.use('/users', authMiddleware, usersRouter);\n  app.use((err: Error, _req: express.Request, res: express.Response, _next: express.NextFunction) => {\n    console.error(err.message);\n    res.status(500).json({ error: 'Internal server error' });\n  });\n  return app;\n}\n\nconst isMainModule = process.argv[1]?.includes('api/dist/index.js');\nif (isMainModule) {\n  const port = process.env['PORT'] || 3000;\n  const app = createApp();\n  app.listen(port, () => { console.log(`API server running on port ${port}`); });\n}\n```\n\n#### `/workspace/packages/api/src/middleware/auth.ts`\n```ts\n/**\n * Authentication middleware using core permissions.\n */\n\nimport type { Request, Response, NextFunction } from 'express';\nimport { hasPermission, type Role, type Permission } from '@monorepo/core';\n\nexport function authMiddleware(req: Request, res: Response, next: NextFunction): void {\n  const token = req.headers['authorization']?.replace('Bearer ', '');\n  if (token?.startsWith('mock-token-') || req.headers['x-user-role']) {\n    next();\n    return;\n  }\n  res.status(401).json({ error: 'Authentication required' });\n}\n\nexport function requirePermissionMiddleware(permission: Permission) {\n  return (req: Request, res: Response, next: NextFunction): void => {\n    const role = (req.headers['x-user-role'] as Role) || 'viewer';\n    if (!hasPermission(role, permission)) {\n      res.status(403).json({ error: `Permission '${permission}' required` });\n      return;\n    }\n    next();\n  };\n}\n```\n\n#### `/workspace/packages/api/src/routes/auth.ts`\n```ts\n/**\n * Authentication routes.\n */\n\nimport { Router, type Request, type Response } from 'express';\nimport { validateCreateUser, registerUser, type Role } from '@monorepo/core';\n\nexport const authRouter = Router();\n\nauthRouter.post('/register', (req: Request, res: Response) => {\n  try {\n    const validation = validateCreateUser({\n      ...req.body,\n      role: 'user',\n    });\n    if (!validation.success) {\n      res.status(400).json({ errors: validation.errors });\n      return;\n    }\n    const user = registerUser({\n      name: req.body.name,\n      email: req.body.email,\n      role: 'user' as Role,\n    });\n    res.status(201).json({ user, token: `mock-token-${user.id}` });\n  } catch (err) {\n    if (err instanceof Error && err.message.includes('UNIQUE')) {\n      res.status(409).json({ error: 'Email already registered' });\n      return;\n    }\n    res.status(500).json({ error: 'Registration failed' });\n  }\n});\n\nauthRouter.post('/login', (req: Request, res: Response) => {\n  try {\n    const { email } = req.body as { email?: string };\n    if (!email) {\n      res.status(400).json({ error: 'Email is required' });\n      return;\n    }\n    res.json({ token: `mock-token-for-${email}`, message: 'Login successful' });\n  } catch (err) {\n    res.status(500).json({ error: 'Login failed' });\n  }\n});\n\nauthRouter.get('/verify', (req: Request, res: Response) => {\n  const token = req.headers['authorization']?.replace('Bearer ', '');\n  if (!token) {\n    res.status(401).json({ error: 'No token provided' });\n    return;\n  }\n  if (token.startsWith('mock-token-')) {\n    res.json({ valid: true, token });\n  } else {\n    res.status(401).json({ valid: false, error: 'Invalid token' });\n  }\n});\n```\n\n**NOTE:** `auth.ts` correctly uses `registerUser`. But `users.ts` (below) still uses `createUser`.\n\n#### `/workspace/packages/api/src/routes/users.ts`\n```ts\n/**\n * User CRUD routes.\n */\n\nimport { Router, type Request, type Response } from 'express';\nimport {\n  createUser,        // <-- BREAKAGE: should be registerUser\n  getUserById,\n  getAllUsers,\n  validateCreateUser,\n  validateUserId,\n  canMan