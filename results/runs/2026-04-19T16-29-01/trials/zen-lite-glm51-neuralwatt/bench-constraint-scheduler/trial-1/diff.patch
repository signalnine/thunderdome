+    ];
+    const result = schedule(events, defaultRooms, defaultOptions);
+    expect(result.assignments).toHaveLength(1);
+    // r1 has capacity 10, r2 has capacity 50, so e1 should go to r2
+    expect(result.assignments[0].roomId).toBe('r2');
+  });
+
+  it('throws on prerequisite cycle', () => {
