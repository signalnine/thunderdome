th in same room\n    expect(a1.roomId).toBe('r1');\n    expect(a2.roomId).toBe('r1');\n    // Gap between them\n    const earliest = a1.startTime < a2.startTime ? a1 : a2;\n    const latest = a1.startTime < a2.startTime ? a2 : a1;\n    expect(earliest.endTime + 15).toBeLessThanOrEqual(latest.startTime);\n  });\n\n  it('respects room capacity constraints', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Big Meeting', duration: 60, attendees: 100 },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    // No room has capacity 100\n    expect(result.unscheduled).toContain('e1');\n    expect(result.assignments).toHaveLength(0);\n  });\n\n  it('assigns event to a room with sufficient capacity', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Medium Meeting', duration: 60, attendees: 30 },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('r2'); // capacity 50\n  });\n\n  it('enforces time window constraints', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Long Meeting', duration: 600 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 0 };\n    const result = schedule(events, rooms, options);\n    // 600 min duration won't fit in 480 min window\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('enforces prerequisite ordering', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Lecture', duration: 60 },\n      { id: 'e2', name: 'Lab', duration: 60, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { ...defaultOptions, gap: 15 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    expect(a1.endTime + 15).toBeLessThanOrEqual(a2.startTime);\n  });\n\n  it('enforces gap between prerequisite events', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Lecture', duration: 60 },\n      { id: 'e2', name: 'Lab', duration: 60, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 30 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    expect(a1.endTime + 30).toBeLessThanOrEqual(a2.startTime);\n  });\n\n  it('honors preferred room when possible', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Meeting', duration: 60, preferredRoom: 'r2' },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('r2');\n  });\n\n  it('falls back from preferred room if capacity insufficient', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Big Meeting', duration: 60, attendees: 30, preferredRoom: 'r1' },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    // r1 has capacity 10, r2 has capacity 50, so e1 should go to r2\n    expect(result.assignments[0].roomId).toBe('r2');\n  });\n\n  it('throws on prerequisite cycle', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e2'] },\n      { id: 'e2', name: 'B', duration: 60, prerequisites: ['e1'] },\n    ];\n    expect(() => schedule(events, defaultRooms, defaultOptions)).toThrow();\n  });\n\n  it('throws on self-referencing prerequisite', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e1'] },\n    ];\n    expect(() => schedule(events, defaultRooms, defaultOptions)).toThrow();\n  });\n\n  it('throws on longer prerequisite cycle', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e3'] },\n      { id: 'e2', name: 'B', duration: 60, prerequisites: ['e1'] },\n      { id: 'e3', name: 'C', duration: 60, prerequisites: ['e2'] },\n    ];\n    expect(() => schedule(events, defaultRooms, defaultOptions)).toThrow();\n  });\n\n  it('lists unscheduled events when constraints conflict', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Meeting 1', duration: 240 },\n      { id: 'e2', name: 'Meeting 2', duration: 240 },\n      { id: 'e3', name: 'Meeting 3', duration: 240 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 15 };\n    // Window is 480 min. Each event is 240 min + 15 gap = 255 min per slot.\n    // 2 events = 240 + 15 + 240 = 495 > 480, so only 1 fits with gap, or 2 without.\n    // Actually: 240 + 15 + 240 = 495 > 480, so at most 1 event fits.\n    // Wait, let me recalculate: start 540, first event ends at 780 (540+240),\n    // gap to 795, second event 795+240=1035 > 1020. So only 1 fits.\n    const result = schedule(events, rooms, options);\n    expect(result.assignments.length).toBeGreaterThanOrEqual(1);\n    expect(result.unscheduled.length).toBeGreaterThan(0);\n  });\n\n  it('uses multiple rooms to schedule more events', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Meeting 1', duration: 480 },\n      { id: 'e2', name: 'Meeting 2', duration: 480 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Room A', capacity: 10 },\n      { id: 'r2', name: 'Room B', capacity: 10 },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 0 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n    // Each event in a different room\n    const roomIds = result.assignments.map(a => a.roomId);\n    expect(new Set(roomIds).size).toBe(2);\n  });\n\n  it('maximizes number of scheduled events', () => {\n    // Three short events and one long event. One room.\n    // If we schedule the long event, we can only fit it.\n    // If we schedule the three short events, we fit more total.\n    const events: Event[] = [\n      { id: 'long', name: 'Long', duration: 400 },\n      { id: 's1', name: 'Short 1', duration: 60 },\n      { id: 's2', name: 'Short 2', duration: 60 },\n      { id: 's3', name: 'Short 3', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 15 };\n    const result = schedule(events, rooms, options);\n    // Should schedule the 3 short events (maximizing count) rather than the long one\n    expect(result.assignments.length).toBeGreaterThanOrEqual(3);\n  });\n\n  it('handles events with no prerequisites or preferred room', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Simple', duration: 30 },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n\n  it('respects default gap of 15 minutes', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'First', duration: 60 },\n      { id: 'e2', name: 'Second', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    // No gap specified, should default to 15\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    const earliest = a1.startTime < a2.startTime ? a1 : a2;\n    const latest = a1.startTime < a2.startTime ? a2 : a1;\n    expect(earliest.endTime + 15).toBeLessThanOrEqual(latest.startTime);\n  });\n\n  it('handles gap of 0', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'First', duration: 60 },\n      { id: 'e2', name: 'Second', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 0 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    const earliest = a1.startTime < a2.startTime ? a1 : a2;\n    const latest = a1.startTime < a2.startTime ? a2 : a1;\n    expect(earliest.endTime).toBeLessThanOrEqual(latest.startTime);\n  });\n\n  it('handles prerequisite chains', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Intro', duration: 30 },\n      { id: 'e2', name: 'Intermediate', duration: 30, prerequisites: ['e1'] },\n      { id: 'e3', name: 'Advanced', duration: 30, prerequisites: ['e2'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 10 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(3);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    const a3 = result.assignments.find(a => a.eventId === 'e3')!;\n    expect(a1.endTime + 10).toBeLessThanOrEqual(a2.startTime);\n    expect(a2.endTime + 10).toBeLessThanOrEqual(a3.startTime);\n  });\n\n  it('event with prerequisite to nonexistent event is unscheduled', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Dependent', duration: 60, prerequisites: ['nonexistent'] },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('schedules events with attendees defaulting to 1', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Small', duration: 60 }, // attendees defaults to 1\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 1 }];\n    const result = schedule(events, rooms, defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n  });\n\n  it('handles empty events list', () => {\n    const result = schedule([], defaultRooms, defaultOptions);\n    expect(result.assignments).toHaveLength(0);\n    expect(result.unscheduled).toHaveLength(0);\n  });\n\n  it('handles empty rooms list', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Meeting', duration: 60 },\n    ];\n    const result = schedule(events, [], defaultOptions);\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('events in different rooms do not require a gap between them', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Room A Meeting', duration: 60, preferredRoom: 'r1' },\n      { id: 'e2', name: 'Room B Meeting', duration: 60, preferredRoom: 'r2' },\n    ];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 30 };\n    const result = schedule(events, defaultRooms, options);\n    expect(result.assignments).toHaveLength(2);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    // In different rooms, so they can overlap or be at the same time\n    expect(a1.roomId).toBe('r1');\n    expect(a2.roomId).toBe('r2');\n  });\n\n  it('schedules events across multiple rooms respecting capacity', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Small', duration: 60, attendees: 5 },\n      { id: 'e2', name: 'Medium', duration: 60, attendees: 30 },\n      { id: 'e3', name: 'Large', duration: 60, attendees: 45 },\n    ];\n    const rooms: Room[] = [\n      { id: 'r1', name: 'Small Room', capacity: 10 },\n      { id: 'r2', name: 'Big Room', capacity: 50 },\n    ];\n    const result = schedule(events, rooms, defaultOptions);\n    expect(result.assignments).toHaveLength(3);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    const a3 = result.assignments.find(a => a.eventId === 'e3')!;\n    // e1 can go in r1 or r2; e2 and e3 must go in r2\n    expect(a2.roomId).toBe('r2');\n    expect(a3.roomId).toBe('r2');\n  });\n\n  it('does not schedule event starting before time window', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Meeting', duration: 60 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 600, endTime: 650 };\n    const result = schedule(events, rooms, options);\n    // 60 min fits in 50 min window? No.\n    expect(result.unscheduled).toContain('e1');\n  });\n});\n","structuredPatch":[],"originalFile":null}}
