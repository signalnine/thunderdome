+
+  it('uses multiple rooms to schedule more events', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'Meeting 1', duration: 480 },
+      { id: 'e2', name: 'Meeting 2', duration: 480 },
+    ];
+    const rooms: Room[] = [
+      { id: 'r1', name: 'Room A', capacity: 10 },
+      { id: 'r2', name: 'Room B', capacity: 10 },
