+    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];
+    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 15 };
+    // Window is 480 min. Each event is 240 min + 15 gap = 255 min per slot.
+    // 2 events = 240 + 15 + 240 = 495 > 480, so only 1 fits with gap, or 2 without.
+    // Actually: 240 + 15 + 240 = 495 > 480, so at most 1 event fits.
+    // Wait, let me recalculate: start 540, first event ends at 780 (540+240),
+    // gap to 795, second event 795+240=1035 > 1020. So only 1 fits.
+    const result = schedule(events, rooms, options);
+    expect(result.assignments.length).toBeGreaterThanOrEqual(1);
+    expect(result.unscheduled.length).toBeGreaterThan(0);
