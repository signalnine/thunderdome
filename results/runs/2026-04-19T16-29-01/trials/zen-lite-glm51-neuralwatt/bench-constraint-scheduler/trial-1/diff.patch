52837bef7","tool_use_result":{"type":"update","filePath":"/workspace/src/scheduler.ts","content":"import type { Event, Room, ScheduleOptions, Assignment, ScheduleResult } from './types.js';\n\ninterface ScheduledSlot {\n  roomId: string;\n  startTime: number;\n  endTime: number;\n}\n\nfunction detectCycle(\n  eventIds: Set<string>,\n  prereqs: Map<string, string[]>,\n): boolean {\n  const WHITE = 0, GRAY = 1, BLACK = 2;\n  const color = new Map<string, number>();\n  for (const id of eventIds) {\n    color.set(id, WHITE);\n  }\n\n  function dfs(node: string): boolean {\n    color.set(node, GRAY);\n    const deps = prereqs.get(node) || [];\n    for (const dep of deps) {\n      if (!eventIds.has(dep)) continue;\n      const c = color.get(dep);\n      if (c === GRAY) return true;\n      if (c === WHITE && dfs(dep)) return true;\n    }\n    color.set(node, BLACK);\n    return false;\n  }\n\n  for (const id of eventIds) {\n    if (color.get(id) === WHITE) {\n      if (dfs(id)) return true;\n    }\n  }\n  return false;\n}\n\nfunction topologicalSort(\n  eventIds: Set<string>,\n  prereqs: Map<string, string[]>,\n): string[] {\n  const visited = new Set<string>();\n  const result: string[] = [];\n\n  function dfs(node: string) {\n    if (visited.has(node)) return;\n    visited.add(node);\n    const deps = prereqs.get(node) || [];\n    for (const dep of deps) {\n      if (eventIds.has(dep)) dfs(dep);\n    }\n    result.push(node);\n  }\n\n  for (const id of eventIds) {\n    dfs(id);\n  }\n  return result;\n}\n\nfunction earliestStartForEvent(\n  eventId: string,\n  assignments: Map<string, Assignment>,\n  prereqs: Map<string, string[]>,\n  gap: number,\n): number {\n  let earliest = 0;\n  const deps = prereqs.get(eventId) || [];\n  for (const depId of deps) {\n    const depAssignment = assignments.get(depId);\n    if (!depAssignment) {\n      return Infinity;\n    }\n    earliest = Math.max(earliest, depAssignment.endTime + gap);\n  }\n  return earliest;\n}\n\nfunction findEarliestSlot(\n  roomSlots: ScheduledSlot[],\n  startTime: number,\n  duration: number,\n  endTime: number,\n  gap: number,\n): number | null {\n  if (startTime + duration > endTime) return null;\n\n  const sorted = [...roomSlots].sort((a, b) => a.startTime - b.startTime);\n\n  let candidate = startTime;\n  for (const slot of sorted) {\n    if (candidate + duration + gap <= slot.startTime) {\n      if (candidate + duration <= endTime) {\n        return candidate;\n      }\n      return null;\n    }\n    candidate = Math.max(candidate, slot.endTime + gap);\n    if (candidate + duration > endTime) return null;\n  }\n\n  if (candidate + duration <= endTime) {\n    return candidate;\n  }\n  return null;\n}\n\nfunction backtrackSchedule(\n  orderedEvents: string[],\n  eventMap: Map<string, Event>,\n  rooms: Room[],\n  options: ScheduleOptions,\n  prereqs: Map<string, string[]>,\n): Map<string, Assignment> {\n  const gap = options.gap ?? 15;\n  let bestCount = 0;\n  let bestAssignments = new Map<string, Assignment>();\n\n  const currentAssignments = new Map<string, Assignment>();\n  const roomSlots = new Map<string, ScheduledSlot[]>();\n\n  function backtrack(index: number) {\n    if (index === orderedEvents.length) {\n      if (currentAssignments.size > bestCount) {\n        bestCount = currentAssignments.size;\n        bestAssignments = new Map(currentAssignments);\n      }\n      return;\n    }\n\n    // Prune: can't beat current best even if we schedule all remaining\n    const remaining = orderedEvents.length - index;\n    if (currentAssignments.size + remaining <= bestCount) {\n      return;\n    }\n\n    const eventId = orderedEvents[index];\n    const event = eventMap.get(eventId)!;\n    const attendees = event.attendees ?? 1;\n\n    const prereqStart = earliestStartForEvent(eventId, currentAssignments, prereqs, gap);\n\n    // If prerequisite not scheduled, skip this event (and its dependents will also fail)\n    if (prereqStart === Infinity) {\n      backtrack(index + 1);\n      return;\n    }\n\n    const eligibleRooms = rooms.filter(r => r.capacity >= attendees);\n    let candidateRooms: Room[];\n    if (event.preferredRoom) {\n      const preferred = eligibleRooms.find(r => r.id === event.preferredRoom);\n      const others = eligibleRooms.filter(r => r.id !== event.preferredRoom);\n      candidateRooms = preferred ? [preferred, ...others] : others;\n    } else {\n      candidateRooms = eligibleRooms;\n    }\n\n    for (const room of candidateRooms) {\n      const slots = roomSlots.get(room.id) ?? [];\n      const effectiveStart = Math.max(prereqStart, options.startTime);\n      const slotStart = findEarliestSlot(slots, effectiveStart, event.duration, options.endTime, gap);\n\n      if (slotStart !== null) {\n        const assignment: Assignment = {\n          eventId,\n          roomId: room.id,\n          startTime: slotStart,\n          endTime: slotStart + event.duration,\n        };\n        currentAssignments.set(eventId, assignment);\n        if (!roomSlots.has(room.id)) roomSlots.set(room.id, []);\n        roomSlots.get(room.id)!.push({\n          roomId: room.id,\n          startTime: slotStart,\n          endTime: slotStart + event.duration,\n        });\n\n        backtrack(index + 1);\n\n        currentAssignments.delete(eventId);\n        roomSlots.get(room.id)!.pop();\n\n        if (bestCount === orderedEvents.length) return;\n      }\n    }\n\n    // Try skipping this event\n    backtrack(index + 1);\n  }\n\n  backtrack(0);\n  return bestAssignments;\n}\n\nfunction greedySchedule(\n  orderedEvents: string[],\n  eventMap: Map<string, Event>,\n  rooms: Room[],\n  options: ScheduleOptions,\n  prereqs: Map<string, string[]>,\n): Map<string, Assignment> {\n  const gap = options.gap ?? 15;\n  const assignments = new Map<string, Assignment>();\n  const roomSlots = new Map<string, ScheduledSlot[]>();\n\n  for (const eventId of orderedEvents) {\n    const event = eventMap.get(eventId)!;\n    const attendees = event.