\n  startTime: number;\n  endTime: number;\n}\n\nfunction detectCycle(\n  eventIds: Set<string>,\n  prereqs: Map<string, string[]>,\n): boolean {\n  const WHITE = 0, GRAY = 1, BLACK = 2;\n  const color = new Map<string, number>();\n  for (const id of eventIds) {\n    color.set(id, WHITE);\n  }\n\n  function dfs(node: string): boolean {\n    color.set(node, GRAY);\n    const deps = prereqs.get(node) || [];\n    for (const dep of deps) {\n      if (!eventIds.has(dep)) continue; // skip non-existent prereqs\n      const c = color.get(dep);\n      if (c === GRAY) return true; // cycle\n      if (c === WHITE && dfs(dep)) return true;\n    }\n    color.set(node, BLACK);\n    return false;\n  }\n\n  for (const id of eventIds) {\n    if (color.get(id) === WHITE) {\n      if (dfs(id)) return true;\n    }\n  }\n  return false;\n}\n\nfunction topologicalSort(\n  eventIds: Set<string>,\n  prereqs: Map<string, string[]>,\n): string[] {\n  const visited = new Set<string>();\n  const result: string[] = [];\n\n  function dfs(node: string) {\n    if (visited.has(node)) return;\n    visited.add(node);\n    const deps = prereqs.get(node) || [];\n    for (const dep of deps) {\n      if (eventIds.has(dep)) dfs(dep);\n    }\n    result.push(node);\n  }\n\n  for (const id of eventIds) {\n    dfs(id);\n  }\n  return result; // leaves first (reverse topological)\n}\n\nfunction earliestStartForEvent(\n  eventId: string,\n  assignments: Map<string, Assignment>,\n  prereqs: Map<string, string[]>,\n  gap: number,\n  eventMap: Map<string, Event>,\n): number {\n  let earliest = 0;\n  const deps = prereqs.get(eventId) || [];\n  for (const depId of deps) {\n    const depAssignment = assignments.get(depId);\n    if (!depAssignment) {\n      // prerequisite not scheduled => this event can't be scheduled yet\n      return Infinity;\n    }\n    earliest = Math.max(earliest, depAssignment.endTime + gap);\n  }\n  return earliest;\n}\n\nfunction findEarliestSlot(\n  roomSlots: ScheduledSlot[],\n  startTime: number,\n  duration: number,\n  endTime: number,\n  gap: number,\n): number | null {\n  // Find earliest time >= startTime where event of given duration fits\n  // without violating gap constraint with existing slots in this room.\n  // The event must end by endTime.\n\n  if (startTime + duration > endTime) return null;\n\n  // Sort slots by start time\n  const sorted = [...roomSlots].sort((a, b) => a.startTime - b.startTime);\n\n  // Try placing before the first slot\n  let candidate = startTime;\n  for (const slot of sorted) {\n    // Can we fit between candidate and this slot?\n    // We need: candidate + duration + gap <= slot.startTime (if before slot)\n    // Or: slot.endTime + gap <= candidate (if after slot)\n    if (candidate + duration + gap <= slot.startTime) {\n      // Fits before this slot\n      if (candidate + duration <= endTime) {\n        return candidate;\n      }\n      return null;\n    }\n    // Move candidate past this slot\n    candidate = Math.max(candidate, slot.endTime + gap);\n    if (candidate + duration > endTime) return null;\n  }\n\n  // Fits after all slots\n  if (candidate + duration <= endTime) {\n    return candidate;\n  }\n  return null;\n}\n\n// Backtracking scheduler that tries to maximize the number of scheduled events\nfunction scheduleBacktrack(\n  orderedEvents: string[],\n  eventMap: Map<string, Event>,\n  rooms: Room[],\n  options: ScheduleOptions,\n  prereqs: Map<string, string[]>,\n  currentAssignments: Map<string, Assignment>,\n  roomSlots: Map<string, ScheduledSlot[]>,\n  bestResult: { count: number; assignments: Map<string, Assignment> } | null,\n): void {\n  // Prune: even if we schedule all remaining events, can we beat the best?\n  const remaining = orderedEvents.length;\n  const currentCount = currentAssignments.size;\n  if (bestResult !== null && currentCount + remaining <= bestResult.count) {\n    return; // Can't beat best even if we schedule everything remaining\n  }\n\n  if (orderedEvents.length === 0) {\n    if (bestResult === null || currentCount > bestResult.count) {\n      bestResult = { count: currentCount, assignments: new Map(currentAssignments) };\n    }\n    return;\n  }\n\n  const [eventId, ...rest] = orderedEvents;\n  const event = eventMap.get(eventId)!;\n  const gap = options.gap ?? 15;\n\n  // Compute earliest start due to prerequisites\n  const prereqStart = earliestStartForEvent(eventId, currentAssignments, prereqs, gap, eventMap);\n\n  // If prerequisite not yet scheduled, we must skip this event for now\n  // But in our topological order, prerequisites come first, so they should be scheduled\n  // If a prerequisite is unschedulable, this event may still be schedulable later\n  // if the prerequisite gets placed. But with topological order, if we skip a prereq,\n  // we should also skip dependents.\n\n  const attendees = event.attendees ?? 1;\n\n  // Collect candidate rooms: preferred room first, then others by capacity\n  const eligibleRooms = rooms.filter(r => r.capacity >= attendees);\n  let candidateRooms: Room[];\n  if (event.preferredRoom) {\n    const preferred = eligibleRooms.find(r => r.id === event.preferredRoom);\n    const others = eligibleRooms.filter(r => r.id !== event.preferredRoom);\n    candidateRooms = preferred ? [preferred, ...others] : others;\n  } else {\n    candidateRooms = eligibleRooms;\n  }\n\n  // Try placing the event in each room\n  for (const room of candidateRooms) {\n    const slots = roomSlots.get(room.id) ?? [];\n    const effectiveStart = Math.max(prereqStart, options.startTime);\n    const slotStart = findEarliestSlot(slots, effectiveStart, event.duration, options.endTime, gap);\n\n    if (slotStart !== null) {\n      // Place the event\n      const assignment: Assignment = {\n        eventId,\n        roomId: room.id,\n        startTime: slotStart,\n        endTime: slotStart + event.duration,\n      };\n      currentAssignments.set(eventId, assignment);\n      if (!roomSlots.has(room.id)) roomSlots.set(room.id, []);\n      roomSlots.get(room.id)!.push({\n        roomId: room.id,\n        startTime: slotStart,\n        endTime: slotStart + event.duration,\n      });\n\n      scheduleBacktrack(rest, eventMap, rooms, options, prereqs, currentAssignments, roomSlots, bestResult);\n\n      // Undo\n      currentAssignments.delete(eventId);\n      roomSlots.get(room.id)!.pop();\n\n      // If we already found optimal, stop\n      if (bestResult !== null && bestResult.count === eventMap.size) return;\n    }\n  }\n\n  // Try skipping this event\n  scheduleBacktrack(rest, eventMap, rooms, options, prereqs, currentAssignments, roomSlots, bestResult);\n}\n\nexport function schedule(\n  events: Event[],\n  rooms: Room[],\n  options: ScheduleOptions,\n): ScheduleResult {\n  const gap = options.gap ?? 15;\n  const eventMap = new Map<string, Event>();\n  const eventIds = new Set<string>();\n  const prereqs = new Map<string, string[]>();\n\n  for (const e of events) {\n    eventMap.set(e.id, e);\n    eventIds.add(e.id);\n    prereqs.set(e.id, e.prerequisites ? [...e.prerequisites] : []);\n  }\n\n  // Check for cycles\n  if (detectCycle(eventIds, prereqs)) {\n    throw new Error('Prerequisite cycle detected');\n  }\n\n  // Topological sort (leaves first - events with no deps first)\n  const sorted = topologicalSort(eventIds, prereqs);\n\n  // Filter to only events that can potentially fit (duration within time window)\n  // and have eligible rooms\n  const schedulable: string[] = [];\n  const unschedulable: string[] = [];\n\n  for (const eventId of sorted) {\n    const event = eventMap.get(eventId)!;\n    const attendees = event.attendees ?? 1;\n    const hasEligibleRoom = rooms.some(r => r.capacity >= attendees);\n    const fitsInWindow = event.duration <= (options.endTime - options.startTime);\n\n    if (!hasEligibleRoom || !fitsInWindow) {\n      unschedulable.push(eventId);\n    } else {\n      schedulable.push(eventId);\n    }\n  }\n\n  // Also mark events whose prerequisites are unschedulable\n  const trulyUnschedulable = new Set(unschedulable);\n  let changed = true;\n  while (changed) {\n    changed = false;\n    for (const eventId of schedulable) {\n      const deps = prereqs.get(eventId) || [];\n      for (const dep of deps) {\n        if (trulyUnschedulable.has(dep) || !eventIds.has(dep)) {\n          trulyUnschedulable.add(eventId);\n          changed = true;\n        }\n      }\n    }\n  }\n\n  const finalSchedulable = schedulable.filter(id => !trulyUnschedulable.has(id));\n  const allUnschedulable = [...trulyUnschedulable];\n\n  // For small inputs, use backtracking to maximize scheduled count\n  // For larger inputs, use a greedy approach with topological ordering\n  let assignments: Map<string, Assignment>;\n\n  if (finalSchedulable.length <= 20) {\n    // Backtracking search\n    const currentAssignments = new Map<string, Assignment>();\n    const roomSlots = new Map<string, ScheduledSlot[]>();\n    let bestResult: { count: number; assignments: Map<string, Assignment> } | null = null;\n\n    scheduleBacktrack(\n      finalSchedulable,\n      eventMap,\n      rooms,\n      options,\n      prereqs,\n      currentAssignments,\n      roomSlots,\n      bestResult,\n    );\n\n    // The backtracking modifies bestResult through closure — but we passed null.\n    // We need to restructure this. Let me use a different approach.\n    assignments = backtrackSchedule(finalSchedulable, eventMap, rooms, options, prereqs);\n  } else {\n    // Greedy approach\n    assignments = greedySchedule(finalSchedulable, eventMap, rooms, options, prereqs);\n  }\n\n  const result: ScheduleResult = {\n    assignments: [...assignments.values()],\n    unscheduled: [\n      ...allUnschedulable,\n      ...finalSchedulable.filter(id => !assignments.has(id)),\n    ],\n  };\n\n  return result;\n}\n\nfunction backtrackSchedule(\n  orderedEvents: string[],\n  eventMap: Map<string, Event>,\n  rooms: Room[],\n  options: ScheduleOptions,\n  prereqs: Map<string, string[]>,\n): Map<string, Assignment> {\n  const gap = options.gap ?? 15;\n  let bestCount = 0;\n  let bestAssignments = new Map<string, Assignment>();\n\n  const currentAssignments = new Map<string, Assignment>();\n  const roomSlots = new Map<string, ScheduledSlot[]>();\n\n  function backtrack(index: number) {\n    if (index === orderedEvents.length) {\n      if (currentAssignments.size > bestCount) {\n        bestCount = currentAssignments.size;\n        bestAssignments = new Map(currentAssignments);\n      }\n      return;\n    }\n\n    // Prune\n    const remaining = orderedEvents.length - index;\n    if (currentAssignments.size + remaining <= bestCount) {\n      return;\n    }\n\n    const eventId = orderedEvents[index];\n    const event = eventMap.get(eventId)!;\n    const attendees = event.attendees ?? 1;\n\n    const prereqStart = earliestStartForEvent(eventId, currentAssignments, prereqs, gap, eventMap);\n\n    const eligibleRooms = rooms.filter(r => r.capacity >= attendees);\n    let candidateRooms: Room[];\n    if (event.preferredRoom) {\n      const preferred = eligibleRooms.find(r => r.id === event.preferredRoom);\n      const others = eligibleRooms.filter(r => r.id !== event.preferredRoom);\n      candidateRooms = preferred ? [preferred, ...others] : others;\n    } else {\n      candidateRooms = eligibleRooms;\n    }\n\n    let placed = false;\n    for (const room of candidateRooms) {\n      const slots = roomSlots.get(room.id) ?? [];\n      const effectiveStart = Math.max(prereqStart, options.startTime);\n      const slotStart = findEarliestSlot(slots, effectiveStart, event.duration, options.endTime, gap);\n\n      if (slotStart !== null) {\n        const assignment: Assignment = {\n          eventId,\n          roomId: room.id,\n          startTime: slotStart,\n          endTime: slotStart + event.duration,\n        };\n        currentAssignments.set(eventId, assignment);\n        if (!roomSlots.has(room.id)) roomSlots.set(room.id, []);\n        roomSlots.get