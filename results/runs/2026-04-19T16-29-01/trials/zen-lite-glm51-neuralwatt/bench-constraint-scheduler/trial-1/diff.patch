Time < a2.startTime ? a2 : a1;\n    expect(earliest.endTime + 15).toBeLessThanOrEqual(latest.startTime);\n  });\n\n  it('respects room capacity constraints', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Big Meeting', duration: 60, attendees: 100 },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    // No room has capacity 100\n    expect(result.unscheduled).toContain('e1');\n    expect(result.assignments).toHaveLength(0);\n  });\n\n  it('assigns event to a room with sufficient capacity', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Medium Meeting', duration: 60, attendees: 30 },\n    ];\n    const result = schedule(events, defaultRooms, defaultOptions);\n    expect(result.assignments).toHaveLength(1);\n    expect(result.assignments[0].roomId).toBe('r2'); // capacity 50\n  });\n\n  it('enforces time window constraints', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Long Meeting', duration: 600 },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { startTime: 540, endTime: 1020, gap: 0 };\n    const result = schedule(events, rooms, options);\n    // 600 min duration won't fit in 480 min window\n    expect(result.unscheduled).toContain('e1');\n  });\n\n  it('enforces prerequisite ordering', () => {\n    const events: Event[] = [\n      { id: 'e1', name: 'Lecture', duration: 60 },\n      { id: 'e2', name: 'Lab', duration: 60, prerequisites: ['e1'] },\n    ];\n    const rooms: Room[] = [{ id: 'r1', name: 'Room A', capacity: 10 }];\n    const options: ScheduleOptions = { ...defaultOptions, gap: 15 };\n    const result = schedule(events, rooms, options);\n    expect(result.assignments).toHaveLength(2);\n\n    const a1 = result.assignments.find(a => a.eventId === 'e1')!;\n    const a2 = result.assignments.find(a => a.eventId === 'e2')!;\n    expect(a1.endTime + 15).toBeLessThanOrEqual(a2.startTime);\n  });\n\n  it('enf