+      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e2'] },
+      { id: 'e2', name: 'B', duration: 60, prerequisites: ['e1'] },
+    ];
+    expect(() => schedule(events, defaultRooms, defaultOptions)).toThrow();
+  });
+
+  it('throws on self-referencing prerequisite', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e1'] },
+    ];
+    expect(() => schedule(events, defaultRooms, defaultOptions)).toThrow();
+  });
+
+  it('throws on longer prerequisite cycle', () => {
+    const events: Event[] = [
+      { id: 'e1', name: 'A', duration: 60, prerequisites: ['e3'] },
+      { id: 'e2', name: 'B', duration: 60, prerequisites: ['e1'] },
+      { id: 'e3', name: 'C', duration: 60, prerequisites: ['e2'] },
+    ];
+    expect(() => schedule(events, defaultRooms, defaultOptions)).toThrow();
+  });
+
+  it('lists unscheduled events when constraints conflict', () => {
