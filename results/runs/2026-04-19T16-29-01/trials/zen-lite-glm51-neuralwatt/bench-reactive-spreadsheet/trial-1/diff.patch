+++ b/src/evaluator.ts
@@ -0,0 +1,178 @@
+import { ASTNode } from './parser.js';
+
+export type CellValue = string | number | boolean | null;
+
+export interface CellAccessor {
+  getCellValue(ref: string): CellValue;
+}
+
+export function evaluate(node: ASTNode, accessor: CellAccessor): CellValue {
+  switch (node.type) {
+    case 'number':
+      return node.value;
+    case 'string':
+      return node.value;
+    case 'boolean':
+      return node.value;
+    case 'cellref': {
+      const val = accessor.getCellValue(node.ref);
+      return val;
+    }
+    case 'unary_minus': {
+      const val = evaluate(node.operand, accessor);
+      if (typeof val !== 'number') throw new Error(`Cannot negate non-number: ${val}`);
+      return -val;
+    }
+    case 'binop': {
+      return evaluateBinOp(node.op, node.left, node.right, accessor);
+    }
+    case 'function': {
+      return evaluateFunction(node.name, node.args, accessor);
+    }
+  }
+}
+
+function evaluateBinOp(op: string, leftNode: ASTNode, rightNode: ASTNode, accessor: CellAccessor): CellValue {
+  // Comparison operators can work with non-numeric types
+  if (['=', '<>', '<', '>', '<=', '>='].includes(op)) {
+    const left = evaluate(leftNode, accessor);
+    const right = evaluate(rightNode, accessor);
+    return evaluateComparison(op, left, right);
+  }
+
+  const left = evaluate(leftNode, accessor);
+  const right = evaluate(rightNode, accessor);
+
+  const leftNum = toNumber(left);
+  const rightNum = toNumber(right);
+
+  if (leftNum === null || rightNum === null) {
+    throw new Error(`Cannot perform arithmetic on non-numeric values: ${left} ${op} ${right}`);
+  }
+
+  switch (op) {
+    case '+': return leftNum + rightNum;
+    case '-': return leftNum - rightNum;
+    case '*': return leftNum * rightNum;
+    case '/':
+      if (rightNum === 0) throw new Error('Division by zero');
+      return leftNum / rightNum;
+    default:
+      throw new Error(`Unknown operator: ${op}`);
+  }
+}
+
+function evaluateComparison(op: string, left: CellValue, right: CellValue): boolean {
+  // Normalize for comparison
+  const l = left ?? 0;
+  const r = right ?? 0;
+
+  switch (op) {
+    case '=': return l === r;
+    case '<>': return l !== r;
+    case '<': return compareValues(l, r) < 0;
+    case '>': return compareValues(l, r) > 0;
+    case '<=': return compareValues(l, r) <= 0;
+    case '>=': return compareValues(l, r) >= 0;
+    default:
+      throw new Error(`Unknown comparison operator: ${op}`);
+  }
+}
+
+function compareValues(a: CellValue, b: CellValue): number {
+  if (typeof a === 'number' && typeof b === 'number') return a - b;
+  if (typeof a === 'string' && typeof b === 'string') return a.localeCompare(b);
+  if (typeof a === 'boolean' && typeof b === 'boolean') return (a ? 1 : 0) - (b ? 1 : 0);
+  // Mixed types: convert to number for comparison
+  const an = toNumber(a) ?? 0;
+  const bn = toNumber(b) ?? 0;
+  return an - bn;
+}
+
+function toNumber(val: CellValue): number | null {
+  if (typeof val === 'number') return val;
+  if (typeof val === 'boolean') return val ? 1 : 0;
+  if (typeof val === 'string') {
+    const n = parseFloat(val);
+    return isNaN(n) ? null : n;
+  }
+  return null;
+}
+
+/**
+ * Flatten args: RANGE nodes get unwrapped so their individual cellrefs
+ * are evaluated separately. Other nodes are left as-is.
+ */
+function flattenArgs(args: ASTNode[]): ASTNode[] {
+  const result: ASTNode[] = [];
+  for (const arg of args) {
+    if (arg.type === 'function' && arg.name === 'RANGE') {
+      result.push(...arg.args);
+    } else {
+      result.push(arg);
+    }
+  }
+  return result;
+}
+
+function collectNumericValues(args: ASTNode[], accessor: CellAccessor): number[] {
+  const flat = flattenArgs(args);
+  const values: number[] = [];
+  for (const arg of flat) {
+    const val = evaluate(arg, accessor);
+    if (typeof val === 'number') {
+      values.push(val);
+    } else if (typeof val === 'boolean') {
+      values.push(val ? 1 : 0);
+    }
+    // strings and nulls are skipped in range aggregation
+  }
+  return values;
+}
+
+function evaluateFunction(name: string, args: ASTNode[], accessor: CellAccessor): CellValue {
+  switch (name) {
+    case 'SUM': {
+      const nums = collectNumericValues(args, accessor);
+      return nums.reduce((a, b) => a + b, 0);
+    }
+    case 'AVERAGE': {
+      const nums = collectNumericValues(args, accessor);
+      if (nums.length === 0) throw new Error('AVERAGE of empty range');
+      return nums.reduce((a, b) => a + b, 0) / nums.length;
+    }
+    case 'MIN': {
+      const nums = collectNumericValues(args, accessor);
+      if (nums.length === 0) throw new Error('MIN of empty range');
+      return Math.min(...nums);
+    }
+    case 'MAX': {
+      const nums = collectNumericValues(args, accessor);
+      if (nums.length === 0) throw new Error('MAX of empty range');
+      return Math.max(...nums);
+    }
+    case 'COUNT': {
+      const nums = collectNumericValues(args, accessor);
+      return nums.length;
+    }
+    case 'IF': {
+      if (args.length !== 3) throw new Error('IF requires 3 arguments');
+      const condition = evaluate(args[0], accessor);
+      if (condition === true || (typeof condition === 'number' && condition !== 0)) {
+        return evaluate(args[1], accessor);
+      } else {
+        return evaluate(args[2], accessor);
+      }
+    }
+    case 'RANGE': {
+      // RANGE is an internal node representing expanded cell references
+      // It shouldn't be evaluated directly as a function - it's only used
+      // as arguments to other functions. When evaluated standalone, return
+      // the last value (shouldn't really happen in practice).
+      const vals = args.map(a => evaluate(a, accessor));
+      return vals.length > 0 ? vals[vals.length - 1] : null;
+    }
+    default:
+      throw new Error(`Unknown function: ${name}`);
+  }
+}
