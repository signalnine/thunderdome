& input[pos] <= 'Z') || (input[pos] >= 'a' && input[pos] <= 'z'))) {\n        pos++;\n      }\n      const word = input.slice(start, pos).toUpperCase();\n      // Check if followed by digits → cell reference\n      if (pos < input.length && input[pos] >= '0' && input[pos] <= '9') {\n        const digitStart = pos;\n        while (pos < input.length && input[pos] >= '0' && input[pos] <= '9') pos++;\n        tokens.push({ type: TokenType.CELL_REF, value: word + input.slice(digitStart, pos) });\n      } else if (word === 'TRUE' || word === 'FALSE') {\n        tokens.push({ type: TokenType.BOOLEAN, value: word });\n      } else {\n        tokens.push({ type: TokenType.IDENT, value: word });\n      }\n      continue;\n    }\n    // Operators\n    if (input[pos] === '<') {\n      if (pos + 1 < input.length && input[pos + 1] === '>') {\n        tokens.push({ type: TokenType.NEQ, value: '<>' });\n        pos += 2;\n      } else if (pos + 1 < input.length && input[pos + 1] === '=') {\n        tokens.push({ type: TokenType.LTE, value: '<=' });\n        pos += 2;\n      } else {\n        tokens.push({ type: TokenType.LT, value: '<' });\n        pos++;\n      }\n      continue;\n    }\n    if (input[pos] === '>') {\n      if (pos + 1 < input.length && input[pos + 1] === '=') {\n        tokens.push({ type: TokenType.GTE, value: '>=' });\n        pos += 2;\n      } else {\n        tokens.push({ type: TokenType.GT, value: '>' });\n        pos++;\n      }\n      continue;\n    }\n    if (input[pos] === '=') {\n      tokens.push({ type: TokenType.EQ, value: '=' });\n      pos++;\n      continue;\n    }\n    if (input[pos] === '+') { tokens.push({ type: TokenType.PLUS, value: '+' }); pos++; continue; }\n    if (input[pos] === '-') { tokens.push({ type: TokenType.MINUS, value: '-' }); pos++; continue; }\n    if (input[pos] === '*') { tokens.push({ type: TokenType.STAR, value: '*' }); pos++; continue; }\n    if (input[pos] === '/') { tokens.push({ type: TokenType.SLASH, value: '/' }); 