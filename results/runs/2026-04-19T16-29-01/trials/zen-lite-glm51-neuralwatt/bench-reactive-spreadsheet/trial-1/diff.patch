+/**
+ * Parse a cell reference like "A1", "B2", "AA100" into column and row.
+ * Columns are 1-based (A=1, B=2, ..., Z=26, AA=27, ...).
+ * Rows are 1-based integers.
+ */
+export interface CellRef {
+  col: number;
+  row: number;
+}
+
+export function parseCellRef(ref: string): CellRef {
+  const match = /^([A-Z]+)(\d+)$/.exec(ref.toUpperCase());
+  if (!match) {
+    throw new Error(`Invalid cell reference: ${ref}`);
+  }
+  const colStr = match[1];
+  const rowStr = match[2];
+  let col = 0;
+  for (let i = 0; i < colStr.length; i++) {
+    col = col * 26 + (colStr.charCodeAt(i) - 64);
+  }
+  return { col, row: parseInt(rowStr, 10) };
+}
+
+export function cellRefToString(ref: CellRef): string {
+  let col = ref.col;
+  let colStr = '';
+  while (col > 0) {
+    col--;
+    colStr = String.fromCharCode(65 + (col % 26)) + colStr;
+    col = Math.floor(col / 26);
+  }
+  return colStr + ref.row;
+}
+
+export function normalizeCellRef(ref: string): string {
+  return ref.toUpperCase();
+}
+
+/**
+ * Expand a range like "A1:C3" into an array of cell reference strings.
+ */
+export function expandRange(start: string, end: string): string[] {
+  const s = parseCellRef(start);
+  const e = parseCellRef(end);
+  const minCol = Math.min(s.col, e.col);
+  const maxCol = Math.max(s.col, e.col);
+  const minRow = Math.min(s.row, e.row);
+  const maxRow = Math.max(s.row, e.row);
+  const cells: string[] = [];
+  for (let row = minRow; row <= maxRow; row++) {
+    for (let col = minCol; col <= maxCol; col++) {
+      cells.push(cellRefToString({ col, row }));
+    }
+  }
+  return cells;
+}
