{\n      const op = this.advance().value;\n      const right = this.multiplication();\n      left = { type: 'binop', op, left, right };\n    }\n    return left;\n  }\n\n  private multiplication(): ASTNode {\n    let left = this.unary();\n    while (this.peek().type === TokenType.STAR || this.peek().type === TokenType.SLASH) {\n      const op = this.advance().value;\n      const right = this.unary();\n      left = { type: 'binop', op, left, right };\n    }\n    return left;\n  }\n\n  private unary(): ASTNode {\n    if (this.peek().type === TokenType.MINUS || this.peek().type === TokenType.PLUS) {\n      const op = this.advance().value;\n      const operand = this.unary();\n      return { type: 'unaryop', op, operand };\n    }\n    return this.primary();\n  }\n\n  private primary(): ASTNode {\n    const token = this.peek();\n    switch (token.type) {\n      case TokenType.NUMBER: {\n        this.advance();\n        return { type: 'number', value: parseFloat(token.value) };\n      }\n      case TokenType.STRING: {\n        this.advance();\n        return { type: 'string', value: token.value };\n      }\n      case TokenType.BOOLEAN: {\n        this.advance();\n        return { type: 'boolean', value: token.value === 'TRUE' };\n      }\n      case TokenType.CELL_REF: {\n        this.advance();\n        // Check for range\n        if (this.peek().type === TokenType.COLON) {\n          this.advance(); // consume colon\n          const endToken = this.expect(TokenType.CELL_REF);\n          return { type: 'range', start: token.value.toUpperCase(), end: endToken.value.toUpperCase() };\n        }\n        return { type: 'cell', ref: token.value.toUpperCase() };\n      }\n      case TokenType.IDENT: {\n        this.advance();\n        this.expect(TokenType.LPAREN);\n        const args: ASTNode[] = [];\n        if (this.peek().type !== TokenType.RPAREN) {\n          args.push(this.expression());\n          while (this.peek().type === TokenType.COMMA) {\n            this.advance