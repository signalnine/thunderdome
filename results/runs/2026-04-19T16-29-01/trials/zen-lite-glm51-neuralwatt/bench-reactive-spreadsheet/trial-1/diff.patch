+import { normalizeCellRef } from './cell.js';
+import { parseFormula, collectDependencies } from './parser.js';
+import { evaluate, CellValue, CellAccessor } from './evaluator.js';
+
+interface CellData {
+  raw: string | number | boolean;
+  computed: CellValue;
+  isFormula: boolean;
+  dependencies: Set<string>;
+}
+
+export class Spreadsheet implements CellAccessor {
+  private cells = new Map<string, CellData>();
+  // dependents: for each cell, which cells depend on it
+  private dependents = new Map<string, Set<string>>();
+
+  set(cell: string, value: string | number | boolean): void {
+    const ref = normalizeCellRef(cell);
+    const isFormula = typeof value === 'string' && value.startsWith('=');
+
+    // Parse formula and check for circular references before making any changes
+    let dependencies = new Set<string>();
+    let ast = null;
+    if (isFormula) {
+      const formulaStr = (value as string).slice(1); // remove '='
+      ast = parseFormula(formulaStr);
+      dependencies = collectDependencies(ast);
+
+      // Check for circular reference
+      if (dependencies.has(ref)) {
+        throw new Error(`Circular reference detected: ${ref} depends on itself`);
+      }
+      // Check transitive dependencies
+      if (this.wouldCreateCycle(ref, dependencies)) {
+        throw new Error(`Circular reference detected involving ${ref}`);
+      }
+    }
+
+    // Remove old dependencies
+    this.removeDependencies(ref);
+
+    // Set the cell data
+    const computed = isFormula
+      ? this.evaluateAST(ast!)
+      : value;
+
+    this.cells.set(ref, {
+      raw: value,
+      computed,
+      isFormula,
+      dependencies,
+    });
+
+    // Register new dependencies
+    this.addDependencies(ref, dependencies);
+
+    // Propagate changes to dependents
+    this.propagate(ref);
+  }
+
+  get(cell: string): CellValue {
+    const ref = normalizeCellRef(cell);
+    const data = this.cells.get(ref);
+    if (!data) return null;
+    return data.computed;
+  }
+
+  getDisplay(cell: string): string {
+    const val = this.get(cell);
+    if (val === null) return '';
+    if (typeof val === 'boolean') return val ? 'TRUE' : 'FALSE';
+    return String(val);
+  }
+
+  getCells(): Map<string, CellValue> {
+    const result = new Map<string, CellValue>();
+    for (const [ref, data] of this.cells) {
+      result.set(ref, data.computed);
+    }
+    return result;
+  }
+
+  getCellValue(ref: string): CellValue {
+    const data = this.cells.get(ref);
+    if (!data) return null;
+    return data.computed;
+  }
+
+  private evaluateAST(ast: ReturnType<typeof parseFormula>): CellValue {
+    return evaluate(ast, this);
+  }
+
+  private removeDependencies(cellRef: string): void {
+    const data = this.cells.get(cellRef);
+    if (!data) return;
+    for (const dep of data.dependencies) {
+      const depSet = this.dependents.get(dep);
+      if (depSet) {
+        depSet.delete(cellRef);
+        if (depSet.size === 0) {
+          this.dependents.delete(dep);
+        }
+      }
+    }
+  }
+
+  private addDependencies(cellRef: string, dependencies: Set<string>): void {
+    for (const dep of dependencies) {
+      if (!this.dependents.has(dep)) {
+        this.dependents.set(dep, new Set());
+      }
+      this.dependents.get(dep)!.add(cellRef);
+    }
+  }
+
+  private propagate(changedCell: string): void {
+    const visited = new Set<string>();
+    const order: string[] = [];
+    this.topologicalSort(changedCell, visited, order);
+
+    // Post-order DFS gives dependents before dependencies;
+    // reverse so we recompute in dependency order (changed cell first).
+    order.reverse();
+
+    for (const ref of order) {
+      const data = this.cells.get(ref);
+      if (data && data.isFormula) {
+        const formulaStr = (data.raw as string).slice(1);
+        const ast = parseFormula(formulaStr);
+        data.computed = this.evaluateAST(ast);
+      }
+    }
+  }
+
+  private topologicalSort(cell: string, visited: Set<string>, order: string[]): void {
+    if (visited.has(cell)) return;
+    visited.add(cell);
+    const deps = this.dependents.get(cell);
+    if (deps) {
+      for (const dep of deps) {
+        this.topologicalSort(dep, visited, order);
+      }
+    }
+    order.push(cell);
+  }
+
+  private wouldCreateCycle(cellRef: string, newDependencies: Set<string>): boolean {
+    // Check if any of the new dependencies transitively depend on cellRef
+    const visited = new Set<string>();
+    const queue: string[] = [...newDependencies];
+
+    while (queue.length > 0) {
+      const current = queue.shift()!;
+      if (current === cellRef) return true;
+      if (visited.has(current)) continue;
+      visited.add(current);
+
+      const data = this.cells.get(current);
+      if (data) {
+        for (const dep of data.dependencies) {
+          queue.push(dep);
+        }
+      }
+    }
+    return false;
+  }
+}
