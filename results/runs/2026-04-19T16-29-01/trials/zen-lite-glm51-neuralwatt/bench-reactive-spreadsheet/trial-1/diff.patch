+import { expandRange, normalizeCellRef } from './cell.js';
+
+// AST node types
+export type ASTNode =
+  | NumberNode
+  | StringNode
+  | BooleanNode
+  | CellRefNode
+  | BinaryOpNode
+  | UnaryMinusNode
+  | FunctionCallNode;
+
+export interface NumberNode {
+  type: 'number';
+  value: number;
+}
+
+export interface StringNode {
+  type: 'string';
+  value: string;
+}
+
+export interface BooleanNode {
+  type: 'boolean';
+  value: boolean;
+}
+
+export interface CellRefNode {
+  type: 'cellref';
+  ref: string;
+}
+
+export interface BinaryOpNode {
+  type: 'binop';
+  op: string;
+  left: ASTNode;
+  right: ASTNode;
+}
+
+export interface UnaryMinusNode {
+  type: 'unary_minus';
+  operand: ASTNode;
+}
+
+export interface FunctionCallNode {
+  type: 'function';
+  name: string;
+  args: ASTNode[];
+}
+
+/**
+ * Collect all cell references from an AST (including those in ranges).
+ */
+export function collectDependencies(node: ASTNode): Set<string> {
+  const deps = new Set<string>();
+  collectDepsRecursive(node, deps);
+  return deps;
+}
+
+function collectDepsRecursive(node: ASTNode, deps: Set<string>): void {
+  switch (node.type) {
+    case 'number':
+    case 'string':
+    case 'boolean':
+      break;
+    case 'cellref':
+      deps.add(normalizeCellRef(node.ref));
+      break;
+    case 'binop':
+      collectDepsRecursive(node.left, deps);
+      collectDepsRecursive(node.right, deps);
+      break;
+    case 'unary_minus':
+      collectDepsRecursive(node.operand, deps);
+      break;
+    case 'function':
+      for (const arg of node.args) {
+        collectDepsRecursive(arg, deps);
+      }
+      break;
+  }
+}
+
+// Token types
+interface Token {
+  type: 'number' | 'string' | 'boolean' | 'cellref' | 'range' | 'op' | 'lparen' | 'rparen' | 'comma' | 'ident' | 'colon';
+  value: string;
+}
+
+function tokenize(input: string): Token[] {
+  const tokens: Token[] = [];
+  let i = 0;
+  while (i < input.length) {
+    // skip whitespace
+    if (/\s/.test(input[i])) {
+      i++;
+      continue;
+    }
+
+    // string literal
+    if (input[i] === '"') {
+      let str = '';
+      i++; // skip opening quote
+      while (i < input.length && input[i] !== '"') {
+        str += input[i];
+        i++;
+      }
+      if (i >= input.length) throw new Error('Unterminated string literal');
+      i++; // skip closing quote
+      tokens.push({ type: 'string', value: str });
+      continue;
+    }
+
+    // number
+    if (/[0-9]/.test(input[i]) || (input[i] === '.' && i + 1 < input.length && /[0-9]/.test(input[i + 1]))) {
+      let num = '';
+      while (i < input.length && /[0-9.]/.test(input[i])) {
+        num += input[i];
+        i++;
+      }
+      tokens.push({ type: 'number', value: num });
+      continue;
+    }
+
+    // cell reference or identifier (function name, boolean)
+    if (/[A-Za-z_]/.test(input[i])) {
+      let ident = '';
+      while (i < input.length && /[A-Za-z0-9_]/.test(input[i])) {
+        ident += input[i];
+        i++;
+      }
+      // Check for boolean
+      if (ident.toUpperCase() === 'TRUE') {
+        tokens.push({ type: 'boolean', value: 'TRUE' });
+        continue;
+      }
+      if (ident.toUpperCase() === 'FALSE') {
+        tokens.push({ type: 'boolean', value: 'FALSE' });
+        continue;
+      }
+      // Check if it's a cell reference (letters followed by digits)
+      const cellMatch = /^([A-Za-z]+)(\d+)$/.exec(ident);
+      if (cellMatch) {
+        tokens.push({ type: 'cellref', value: ident.toUpperCase() });
+        continue;
+      }
+      // Otherwise it's an identifier (function name)
+      tokens.push({ type: 'ident', value: ident.toUpperCase() });
+      continue;
+    }
+
+    // operators
+    if (input[i] === '+') { tokens.push({ type: 'op', value: '+' }); i++; continue; }
+    if (input[i] === '-') { tokens.push({ type: 'op', value: '-' }); i++; continue; }
+    if (input[i] === '*') { tokens.push({ type: 'op', value: '*' }); i++; continue; }
+    if (input[i] === '/') { tokens.push({ type: 'op', value: '/' }); i++; continue; }
+
+    // comparison operators
+    if (input[i] === '<') {
+      if (i + 1 < input.length && input[i + 1] === '>') {
+        tokens.push({ type: 'op', value: '<>' }); i += 2;
+      } else if (i + 1 < input.length && input[i + 1] === '=') {
+        tokens.push({ type: 'op', value: '<=' }); i += 2;
+      } else {
+        tokens.push({ type: 'op', value: '<' }); i++;
+      }
+      continue;
+    }
+    if (input[i] === '>') {
+      if (i + 1 < input.length && input[i + 1] === '=') {
+        tokens.push({ type: 'op', value: '>=' }); i += 2;
+      } else {
+        tokens.push({ type: 'op', value: '>' }); i++;
+      }
+      continue;
+    }
+    if (input[i] === '=') {
+      tokens.push({ type: 'op', value: '=' }); i++;
+      continue;
+    }
+
+    if (input[i] === '(') { tokens.push({ type: 'lparen', value: '(' }); i++; continue; }
+    if (input[i] === ')') { tokens.push({ type: 'rparen', value: ')' }); i++; continue; }
+    if (input[i] === ',') { tokens.push({ type: 'comma', value: ',' }); i++; continue; }
+    if (input[i] === ':') { tokens.push({ type: 'colon', value: ':' }); i++; continue; }
+
+    throw new Error(`Unexpected character: ${input[i]} at position ${i}`);
+  }
+  return tokens;
+}
+
+// Recursive descent parser
+class Parser {
+  private tokens: Token[];
+  private pos: number;
+
+  constructor(tokens: Token[]) {
+    this.tokens = tokens;
+    this.pos = 0;
+  }
+
+  private peek(): Token | null {
+    return this.pos < this.tokens.length ? this.tokens[this.pos] : null;
+  }
+
+  private consume(): Token {
+    if (this.pos >= this.tokens.length) throw new Error('Unexpected end of expression');
+    return this.tokens[this.pos++];
+  }
+
+  private expect(type: Token['type'], value?: string): Token {
+    const tok = this.consume();
+    if (tok.type !== type || (value !== undefined && tok.value !== value)) {
+      throw new Error(`Expected ${type}${value ? ` '${value}'` : ''}, got ${tok.type} '${tok.value}'`);
+    }
+    return tok;
+  }
+
+  parse(): ASTNode {
+    const result = this.parseComparison();
+    if (this.pos < this.tokens.length) {
+      throw new Error(`Unexpected token: ${this.tokens[this.pos].value}`);
+    }
+    return result;
+  }
+
+  // Comparison: lowest precedence (=, <>, <, >, <=, >=)
+  private parseComparison(): ASTNode {
+    let left = this.parseAddSub();
+    while (this.peek()?.type === 'op' && ['=', '<>', '<', '>', '<=', '>='].includes(this.peek()!.value)) {
+      const op = this.consume().value;
+      const right = this.parseAddSub();
+      left = { type: 'binop', op, left, right };
+    }
+    return left;
+  }
+
+  // Addition and subtraction
+  private parseAddSub(): ASTNode {
+    let left = this.parseMulDiv();
+    while (this.peek()?.type === 'op' && (this.peek()!.value === '+' || this.peek()!.value === '-')) {
+      const op = this.consume().value;
+      const right = this.parseMulDiv();
+      left = { type: 'binop', op, left, right };
+    }
+    return left;
+  }
+
+  // Multiplication and division
+  private parseMulDiv(): ASTNode {
+    let left = this.parseUnary();
+    while (this.peek()?.type === 'op' && (this.peek()!.value === '*' || this.peek()!.value === '/')) {
+      const op = this.consume().value;
+      const right = this.parseUnary();
+      left = { type: 'binop', op, left, right };
+    }
+    return left;
+  }
+
+  // Unary minus
+  private parseUnary(): ASTNode {
+    if (this.peek()?.type === 'op' && this.peek()!.value === '-') {
+      this.consume();
+      const operand = this.parseUnary();
+      return { type: 'unary_minus', operand };
+    }
+    return this.parsePrimary();
+  }
+
+  // Primary: number, string, boolean, cellref, function call, parenthesized expression
+  private parsePrimary(): ASTNode {
+    const tok = this.peek();
+    if (!tok) throw new Error('Unexpected end of expression');
+
+    switch (tok.type) {
+      case 'number': {
+        this.consume();
+        return { type: 'number', value: parseFloat(tok.value) };
+      }
+      case 'string': {
+        this.consume();
+        return { type: 'string', value: tok.value };
+      }
+      case 'boolean': {
+        this.consume();
+        return { type: 'boolean', value: tok.value === 'TRUE' };
+      }
+      case 'cellref': {
+        this.consume();
+        // Check for range (cellref : cellref)
+        if (this.peek()?.type === 'colon') {
+          this.consume(); // consume ':'
+          const endRef = this.expect('cellref');
+          // Expand range into a function-like node
+          const cells = expandRange(tok.value, endRef.value);
+          // We'll represent ranges as a special "RANGE" function for evaluation
+          return {
+            type: 'function',
+            name: 'RANGE',
+            args: cells.map(ref => ({ type: 'cellref' as const, ref })),
+          };
+        }
+        return { type: 'cellref', ref: tok.value };
+      }
+      case 'ident': {
+        this.consume();
+        this.expect('lparen');
+        const args: ASTNode[] = [];
+        if (this.peek()?.type !== 'rparen') {
+          args.push(this.parseComparison());
+          while (this.peek()?.type === 'comma') {
+            this.consume();
+            args.push(this.parseComparison());
+          }
+        }
+        this.expect('rparen');
+        return { type: 'function', name: tok.value, args };
+      }
+      case 'lparen': {
+        this.consume();
+        const expr = this.parseComparison();
+        this.expect('rparen');
+        return expr;
+      }
+      default:
+        throw new Error(`Unexpected token: ${tok.type} '${tok.value}'`);
+    }
+  }
+}
+
+/**
+ * Parse a formula string (without the leading '=') into an AST.
+ */
+export function parseFormula(formula: string): ASTNode {
+  const tokens = tokenize(formula);
+  const parser = new Parser(tokens);
+  return parser.parse();
+}
