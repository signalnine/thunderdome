ry),\n      );\n    },\n\n    remove(name: string, version: string): boolean {\n      const versionMap = getVersionMap(name);\n      if (!versionMap) return false;\n      const deleted = versionMap.delete(version);\n      if (versionMap.size === 0) {\n        plugins.delete(name);\n      }\n      return deleted;\n    },\n\n    listVersions(name: string): string[] {\n      const versionMap = getVersionMap(name);\n      if (!versionMap) return [];\n      return Array.from(versionMap.keys());\n    },\n\n    update(name: string, version: string, updates: Partial<PluginManifest>): void {\n      const versionMap = getVersionMap(name);\n      if (!versionMap) return;\n      const existing = versionMap.get(version);\n      if (!existing) return;\n      versionMap.set(version, { ...existing, ...updates });\n    },\n  };\n}\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":18401,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"20b3d314-cc6d-4b32-a23a-ff145d938580","uuid":"826a6e0f-27d5-4d4a-9c71-41ee0ed6d4ee"}
