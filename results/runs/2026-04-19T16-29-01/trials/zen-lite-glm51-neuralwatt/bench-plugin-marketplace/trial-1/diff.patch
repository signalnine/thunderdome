ion || !manifest.entryPoint) {\n      throw new Error('Plugin manifest must have name, version, and entryPoint');\n    }\n\n    // Register the plugin in the catalog\n    registry.register(manifest);\n\n    // Resolve dependency versions against what's available in the registry\n    const depConstraints = Object.entries(manifest.dependencies).map(([name, range]) => ({\n      name,\n      range,\n    }));\n\n    const available: Record<string, string[]> = {};\n    for (const constraint of depConstraints) {\n      if (!available[constraint.name]) {\n        available[constraint.name] = registry.listVersions(constraint.name);\n      }\n    }\n\n    const resolvedDependencies = resolver.resolve(depConstraints, available);\n\n    // Check for circular dependencies\n    if (deps.hasCircularDependency(manifest.name, registry)) {\n      throw new Error(`Circular dependency detected for plugin: ${manifest.name}`);\n    }\n\n    // Execute the plugin's entry point in the sandbox\n    // Since execute is async, we need to handle this synchronously or adjust\n    // For the install workflow, we'll do a synchronous-style call using the runner\n    let executionResult: SandboxResult;\n    const runSync = () => {\n      // We use a trick: since vm.Script is synchronous internally,\n      // we can call the async method and it resolves quickly\n      // But the interface says execute returns Promise<SandboxResult>\n      // Let's handle this properly\n      let result: SandboxResult | null = null;\n      let error: Error | null = null;\n\n      // Create the code that calls the entry point\n      const code = manifest.entryPoint;\n\n      runner.executeWithTimeout(code, timeoutMs).then(\n        (r) => { result = r; },\n        (e) => { error = e instanceof Error ? e : new Error(String(e)); },\n      );\n\n      if (error) {\n        executionResult = {\n          success: false,\n          output: null,\n          duration: 0,\n          memoryUsed: 0,\n          error: error.message,\n        };\n      } else if (result) {\n        executionResult = result;\n      } else {\n        // If promise hasn't resolved yet, create a pending result\n        executionResult = {\n          success: false,\n          output: null,\n          duration: 0,\n          memoryUsed: 0,\n          error: 'Execution did not complete synchronously',\n        };\n      }\n    };\n\n    runSync();\n\n    return {\n      resolvedDependencies,\n      executionResult,\n    };\n  }\n\n  return {\n    registry,\n    resolver,\n    runner,\n    reviews,\n    deps,\n    installPlugin,\n  };\n}\n"}}
