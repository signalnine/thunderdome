@@ -0,0 +1,115 @@
+import type { DependencyNode, DepsService, RegistryService } from './types.js';
+
+export function createDeps(): DepsService {
+  function buildTree(name: string, registry: RegistryService): DependencyNode {
+    const manifest = registry.get(name);
+    if (!manifest) {
+      return { name, version: '', dependencies: [] };
+    }
+
+    const deps: DependencyNode[] = [];
+    for (const depName of Object.keys(manifest.dependencies)) {
+      const depManifest = registry.get(depName);
+      if (depManifest) {
+        deps.push(buildTree(depName, registry));
+      }
+    }
+
+    return {
+      name,
+      version: manifest.version,
+      dependencies: deps,
+    };
+  }
+
+  function detectCycles(name: string, registry: RegistryService): string[][] | null {
+    const cycles: string[][] = [];
+
+    function dfs(current: string, path: string[], visited: Set<string>): void {
+      if (visited.has(current)) {
+        const cycleStart = path.indexOf(current);
+        if (cycleStart !== -1) {
+          cycles.push(path.slice(cycleStart).concat(current));
+        }
+        return;
+      }
+
+      visited.add(current);
+      path.push(current);
+
+      const manifest = registry.get(current);
+      if (manifest) {
+        for (const depName of Object.keys(manifest.dependencies)) {
+          dfs(depName, path, visited);
+        }
+      }
+
+      path.pop();
+      visited.delete(current);
+    }
+
+    dfs(name, [], new Set());
+
+    return cycles.length > 0 ? cycles : null;
+  }
+
+  function topologicalSort(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const visited = new Set<string>();
+    const visiting = new Set<string>();
+
+    function visit(pluginName: string): void {
+      if (visited.has(pluginName)) return;
+      if (visiting.has(pluginName)) return; // skip cycles
+
+      visiting.add(pluginName);
+
+      const manifest = registry.get(pluginName);
+      if (manifest) {
+        for (const depName of Object.keys(manifest.dependencies)) {
+          visit(depName);
+        }
+      }
+
+      visiting.delete(pluginName);
+      visited.add(pluginName);
+      result.push(pluginName);
+    }
+
+    visit(name);
+    return result;
+  }
+
+  function flattenDependencies(name: string, registry: RegistryService): string[] {
+    const result: string[] = [];
+    const seen = new Set<string>();
+
+    function collect(pluginName: string): void {
+      const manifest = registry.get(pluginName);
+      if (!manifest) return;
+
+      for (const depName of Object.keys(manifest.dependencies)) {
+        if (!seen.has(depName)) {
+          seen.add(depName);
+          result.push(depName);
+          collect(depName);
+        }
+      }
+    }
+
+    collect(name);
+    return result;
+  }
+
+  function hasCircularDependency(name: string, registry: RegistryService): boolean {
+    return detectCycles(name, registry) !== null;
+  }
+
+  return {
+    buildTree,
+    detectCycles,
+    topologicalSort,
+    flattenDependencies,
+    hasCircularDependency,
+  };
+}
