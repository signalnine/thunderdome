+import type { Review, ReviewService } from './types.js';
+
+export function createReviewSystem(): ReviewService {
+  let nextId = 1;
+  const reviews = new Map<number, Review>();
+
+  function addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {
+    const entry: Review = {
+      ...review,
+      id: nextId++,
+      flagged: false,
+      createdAt: new Date().toISOString(),
+    };
+    reviews.set(entry.id, entry);
+    return entry;
+  }
+
+  function getReviews(pluginName: string): Review[] {
+    const result: Review[] = [];
+    for (const review of reviews.values()) {
+      if (review.pluginName === pluginName) {
+        result.push(review);
+      }
+    }
+    return result;
+  }
+
+  function getAverageRating(pluginName: string): number {
+    const pluginReviews = getReviews(pluginName).filter((r) => !r.flagged);
+    if (pluginReviews.length === 0) return 0;
+    const total = pluginReviews.reduce((sum, r) => sum + r.rating, 0);
+    return total / pluginReviews.length;
+  }
+
+  function flagReview(reviewId: number): void {
+    const review = reviews.get(reviewId);
+    if (review) {
+      review.flagged = true;
+    }
+  }
+
+  function getFlaggedReviews(): Review[] {
+    const result: Review[] = [];
+    for (const review of reviews.values()) {
+      if (review.flagged) {
+        result.push(review);
+      }
+    }
+    return result;
+  }
+
+  function removeReview(reviewId: number): boolean {
+    return reviews.delete(reviewId);
+  }
+
+  function getReviewsByUser(userId: string): Review[] {
+    const result: Review[] = [];
+    for (const review of reviews.values()) {
+      if (review.userId === userId) {
+        result.push(review);
+      }
+    }
+    return result;
+  }
+
+  function getReviewCount(pluginName: string): number {
+    let count = 0;
+    for (const review of reviews.values()) {
+      if (review.pluginName === pluginName) {
+        count++;
+      }
+    }
+    return count;
+  }
+
+  return {
+    addReview,
+    getReviews,
+    getAverageRating,
+    flagReview,
+    getFlaggedReviews,
+    removeReview,
+    getReviewsByUser,
+    getReviewCount,
+  };
+}
