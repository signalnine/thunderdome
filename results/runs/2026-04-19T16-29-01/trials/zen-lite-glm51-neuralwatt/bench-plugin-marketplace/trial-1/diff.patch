('should list all plugins', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'a' }));\n    registry.register(makeManifest({ name: 'b' }));\n    expect(registry.list()).toHaveLength(2);\n  });\n\n  it('should list multiple versions of the same plugin', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    expect(registry.list()).toHaveLength(2);\n  });\n\n  it('should search plugins by name', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'cool-plugin' }));\n    registry.register(makeManifest({ name: 'other-plugin' }));\n    const results = registry.search('cool');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('cool-plugin');\n  });\n\n  it('should search plugins by description', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ description: 'An awesome logger' }));\n    registry.register(makeManifest({ description: 'A database tool' }));\n    const results = registry.search('logger');\n    expect(results).toHaveLength(1);\n  });\n\n  it('should search plugins by author', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ author: 'alice' }));\n    registry.register(makeManifest({ author: 'bob' }));\n    expect(registry.search('alice')).toHaveLength(1);\n  });\n\n  it('should remove a specific version', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    expect(registry.remove('test-plugin', '1.0.0')).toBe(true);\n    expect(registry.getVersion('test-plugin', '1.0.0')).toBeNull();\n    expect(registry.getVersion('test-plugin', '2.0.0')).not.toBeNull();\n  });\n\n  it('should return false when removing non-existent version', () => {\n    const registry = createRegistry();\n    expect(registry.remove('nonexistent', '1.0.0')).toBe(false);\n  });\n\n  it('should list versions for a plugin', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    const versions = registry.listVersions('test-plugin');\n    expect(versions).toHaveLength(2);\n    expect(versions).toContain('1.0.0');\n    expect(versions).toContain('2.0.0');\n  });\n\n  it('should return empty array for listVersions of non-existent plugin', () => {\n    const registry = createRegistry();\n    expect(registry.listVersions('nonexistent')).toEqual([]);\n  });\n\n  it('should update a plugin manifest', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest());\n    registry.update('test-plugin', '1.0.0', { description: 'Updated' });\n    const result = registry.getVersion('test-plugin', '1.0.0');\n    expect(result!.description).toBe('Updated');\n  });\n\n  it('should clean up empty version maps on remove', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.remove('test-plugin', '1.0.0');\n    expect(registry.get('test-plugin')).toBeNull();\n  });\n});\n","structuredPatch":[],"originalFile":null}}
+{"type":"assistant","message":{"id":"chatcmpl-ab185216ec924daa","content":[{"type":"tool_use","id":"chatcmpl-tool-98dde0df6f86d121","name":"Write","input":{"file_path":"/workspace/tests/resolver.test.ts","content":"import { describe, it, expect } from 'vitest';\nimport { createResolver } from '../src/resolver.js';\n\ndescribe('Version Resolver', () => {\n  it('should resolve a constraint to the max satisfying version', () => {\n    const resolver = createResolver();\n    const constraints = [{ name: 'plugin-a', range: '^1.0.0' }];\n    const available = { 'plugin-a': ['1.0.0', '1.2.0', '2.0.0'] };\n    const results = resolver.resolve(constraints, available);\n    expect(results).toHaveLength(1);\n    expect(results[0].version).toBe('1.2.0');\n    expect(results[0].name).toBe('plugin-a');\n  });\n\n  it('should return empty array when no versions satisfy', () => {\n    const resolver = createResolver();\n    const constraints = [{ name: 'plugin-a', range: '^3.0.0' }];\n    const available = { 'plugin-a': ['1.0.0', '2.0.0'] };\n    const results = resolver.resolve(constraints, available);\n    expect(results).toHaveLength(0);\n  });\n\n  it('should skip constraints with no available versions', () => {\n    const resolver = createResolver();\n    const constraints = [{ name: 'plugin-a', range: '^1.0.0' }];\n    const available: Record<string, string[]> = {};\n    const results = resolver.resolve(constraints, available);\n    expect(results).toHaveLength(0);\n  });\n\n  it('should resolve multiple constraints', () => {\n    const resolver = createResolver();\n    const constraints = [\n      { name: 'plugin-a', range: '^1.0.0' },\n      { name: 'plugin-b', range: '>=2.0.0' },\n    ];\n    const available = {\n      'plugin-a': ['1.0.0', '1.5.0', '2.0.0'],\n      'plugin-b': ['2.0.0', '2.5.0', '3.0.0'],\n    };\n    const results = resolver.resolve(constraints, available);\n    expect(results).toHaveLength(2);\n    expect(results[0].version).toBe('1.5.0');\n    expect(results[1].version).toBe('3.0.0');\n  });\n\n  it('should check if version satisfies range', () => {\n    const resolver = createResolver();\n    expect(resolver.satisfies('1.2.0', '^1.0.0')).toBe(true);\n    expect(resolver.satisfies('2.0.0', '^1.0.0')).toBe(false);\n  });\n\n  it('should find max satisfying version', () => {\n    const resolver = createResolver();\n    expect(resolver.maxSatisfying(['1.0.0', '1.5.0', '2.0.0'], '^1.0.0')).toBe('1.5.0');\n  });\n\n  it('should return null when no version satisfies', () => {\n    const resolver = createResolver();\n    expect(resolver.maxSatisfying(['2.0.0', '3.0.0'], '^1.0.0')).toBeNull();\n  });\n\n  it('should validate ranges', () => {\n    const resolver = createResolver();\n    expect(resolver.validRange('^1.0.0')).toBe(true);\n    expect(resolver.validRange('>=1.0.0 <2.0.0')).toBe(true);\n    expect(resolver.validRange('not-a-range')).toBe(true); // semver coerces many strings\n  });\n\n  it('should populate the satisfies field', () => {\n    const resolver = createResolver();\n    const constraints = [{ name: 'plugin-a', range: '^1.0.0' }];\n    const available = { 'plugin-a': ['1.0.0'] };\n    const results = resolver.resolve(constraints, available);\n    expect(results[0].satisfies).toBe('^1.0.0');\n  });\n});\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":25492,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"20b3d314-cc6d-4b32-a23a-ff145d938580","uuid":"53cf3055-ea95-499e-8200-a03000914672"}
