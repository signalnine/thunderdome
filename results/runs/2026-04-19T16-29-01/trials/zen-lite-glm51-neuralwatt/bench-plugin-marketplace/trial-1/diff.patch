+{"type":"assistant","message":{"id":"chatcmpl-ab185216ec924daa","content":[{"type":"tool_use","id":"chatcmpl-tool-b6bab1ad866b61bd","name":"Write","input":{"file_path":"/workspace/tests/reviews.test.ts","content":"import { describe, it, expect } from 'vitest';\nimport { createReviewSystem } from '../src/reviews.js';\n\ndescribe('Review System', () => {\n  it('should add a review and retrieve it', () => {\n    const reviews = createReviewSystem();\n    const review = reviews.addReview({\n      pluginName: 'my-plugin',\n      pluginVersion: '1.0.0',\n      userId: 'user1',\n      rating: 5,\n      comment: 'Great plugin!',\n    });\n    expect(review.id).toBe(1);\n    expect(review.flagged).toBe(false);\n    expect(review.createdAt).toBeDefined();\n\n    const retrieved = reviews.getReviews('my-plugin');\n    expect(retrieved).toHaveLength(1);\n    expect(retrieved[0].rating).toBe(5);\n  });\n\n  it('should compute average rating excluding flagged reviews', () => {\n    const reviews = createReviewSystem();\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 5, comment: 'Great' });\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u2', rating: 1, comment: 'Bad' });\n    expect(reviews.getAverageRating('p')).toBe(3);\n\n    // Flag the bad review\n    reviews.flagReview(2);\n    expect(reviews.getAverageRating('p')).toBe(5);\n  });\n\n  it('should return 0 for average rating of plugin with no reviews', () => {\n    const reviews = createReviewSystem();\n    expect(reviews.getAverageRating('nonexistent')).toBe(0);\n  });\n\n  it('should flag a review', () => {\n    const reviews = createReviewSystem();\n    reviews.addReview({ pluginName: 'p', pluginVersion: '1.0.0', userId: 'u1', rating: 1, comment: 'Spam' });\n    reviews.flagReview(1);\n    const flagged = reviews.getFlaggedReviews();\n    expect(flagged).toHaveLength(1);\n    expect(flagged[0].id).toBe(1);\n  });\n\n  it('should remove a review', () => {\