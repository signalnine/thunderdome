Name: string): number {\n    let count = 0;\n    for (const review of reviews.values()) {\n      if (review.pluginName === pluginName) {\n        count++;\n      }\n    }\n    return count;\n  }\n\n  return {\n    addReview,\n    getReviews,\n    getAverageRating,\n    flagReview,\n    getFlaggedReviews,\n    removeReview,\n    getReviewsByUser,\n    getReviewCount,\n  };\n}\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":18401,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"20b3d314-cc6d-4b32-a23a-ff145d938580","uuid":"23461a96-c64e-46f7-9cff-b66fda1938d6"}
