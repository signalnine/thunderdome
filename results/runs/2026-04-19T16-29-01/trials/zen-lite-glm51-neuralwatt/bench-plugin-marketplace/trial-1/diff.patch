+import type { PluginManifest, RegistryService } from './types.js';
+
+export function createRegistry(): RegistryService {
+  const plugins = new Map<string, Map<string, PluginManifest>>();
+
+  function getVersionMap(name: string): Map<string, PluginManifest> | undefined {
+    return plugins.get(name);
+  }
+
+  return {
+    register(manifest: PluginManifest): void {
+      let versionMap = getVersionMap(manifest.name);
+      if (!versionMap) {
+        versionMap = new Map();
+        plugins.set(manifest.name, versionMap);
+      }
+      versionMap.set(manifest.version, manifest);
+    },
+
+    get(name: string): PluginManifest | null {
+      const versionMap = getVersionMap(name);
+      if (!versionMap || versionMap.size === 0) return null;
+      // Return the latest registered version (last inserted)
+      let latest: PluginManifest | null = null;
+      for (const manifest of versionMap.values()) {
+        latest = manifest;
+      }
+      return latest;
+    },
+
+    getVersion(name: string, version: string): PluginManifest | null {
+      const versionMap = getVersionMap(name);
+      if (!versionMap) return null;
+      return versionMap.get(version) ?? null;
+    },
+
+    list(): PluginManifest[] {
+      const result: PluginManifest[] = [];
+      for (const versionMap of plugins.values()) {
+        for (const manifest of versionMap.values()) {
+          result.push(manifest);
+        }
+      }
+      return result;
+    },
+
+    search(query: string): PluginManifest[] {
+      const lowerQuery = query.toLowerCase();
+      return this.list().filter(
+        (p) =>
+          p.name.toLowerCase().includes(lowerQuery) ||
+          p.description.toLowerCase().includes(lowerQuery) ||
+          p.author.toLowerCase().includes(lowerQuery),
+      );
+    },
+
+    remove(name: string, version: string): boolean {
+      const versionMap = getVersionMap(name);
+      if (!versionMap) return false;
+      const deleted = versionMap.delete(version);
+      if (versionMap.size === 0) {
+        plugins.delete(name);
+      }
+      return deleted;
+    },
+
+    listVersions(name: string): string[] {
+      const versionMap = getVersionMap(name);
+      if (!versionMap) return [];
+      return Array.from(versionMap.keys());
+    },
+
+    update(name: string, version: string, updates: Partial<PluginManifest>): void {
+      const versionMap = getVersionMap(name);
+      if (!versionMap) return;
+      const existing = versionMap.get(version);
+      if (!existing) return;
+      versionMap.set(version, { ...existing, ...updates });
+    },
+  };
+}
