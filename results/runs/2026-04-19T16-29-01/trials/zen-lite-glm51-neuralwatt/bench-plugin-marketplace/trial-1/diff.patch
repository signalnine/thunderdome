@@ -0,0 +1,102 @@
+import { describe, it, expect } from 'vitest';
+import { createMarketplace } from '../src/index.js';
+import type { PluginManifest } from '../src/types.js';
+
+function makeManifest(overrides: Partial<PluginManifest> = {}): PluginManifest {
+  return {
+    name: 'test-plugin',
+    version: '1.0.0',
+    description: 'A test plugin',
+    author: 'test-author',
+    dependencies: {},
+    entryPoint: '42',
+    permissions: [],
+    ...overrides,
+  };
+}
+
+describe('Marketplace', () => {
+  it('should expose all services', () => {
+    const m = createMarketplace();
+    expect(m.registry).toBeDefined();
+    expect(m.resolver).toBeDefined();
+    expect(m.runner).toBeDefined();
+    expect(m.reviews).toBeDefined();
+    expect(m.deps).toBeDefined();
+  });
+
+  it('should install a plugin with no dependencies', async () => {
+    const m = createMarketplace();
+    const manifest = makeManifest();
+    const result = await m.installPlugin(manifest);
+
+    expect(result.resolvedDependencies).toHaveLength(0);
+    expect(result.executionResult.success).toBe(true);
+    expect(result.executionResult.output).toBe(42);
+    expect(result.resolvedDependencies).toEqual([]);
+  });
+
+  it('should install a plugin and resolve dependencies', async () => {
+    const m = createMarketplace();
+
+    // Register dependency first
+    m.registry.register(makeManifest({ name: 'dep-a', version: '1.2.0' }));
+    m.registry.register(makeManifest({ name: 'dep-a', version: '1.5.0' }));
+
+    const manifest = makeManifest({
+      name: 'my-plugin',
+      dependencies: { 'dep-a': '^1.0.0' },
+      entryPoint: '"hello"',
+    });
+
+    const result = await m.installPlugin(manifest);
+    expect(result.resolvedDependencies).toHaveLength(1);
+    expect(result.resolvedDependencies[0].name).toBe('dep-a');
+    expect(result.resolvedDependencies[0].version).toBe('1.5.0');
+    expect(result.executionResult.success).toBe(true);
+  });
+
+  it('should reject plugin without name', async () => {
+    const m = createMarketplace();
+    await expect(m.installPlugin(makeManifest({ name: '' }))).rejects.toThrow(
+      'Plugin manifest must have name, version, and entryPoint',
+    );
+  });
+
+  it('should reject plugin without version', async () => {
+    const m = createMarketplace();
+    await expect(m.installPlugin(makeManifest({ version: '' }))).rejects.toThrow(
+      'Plugin manifest must have name, version, and entryPoint',
+    );
+  });
+
+  it('should reject plugin without entryPoint', async () => {
+    const m = createMarketplace();
+    await expect(m.installPlugin(makeManifest({ entryPoint: '' }))).rejects.toThrow(
+      'Plugin manifest must have name, version, and entryPoint',
+    );
+  });
+
+  it('should reject plugin with circular dependencies', async () => {
+    const m = createMarketplace();
+
+    // Create circular dependency: a -> b -> a
+    m.registry.register(makeManifest({ name: 'a', dependencies: { b: '^1.0.0' } }));
+    m.registry.register(makeManifest({ name: 'b', dependencies: { a: '^1.0.0' } }));
+
+    const manifest = makeManifest({
+      name: 'c',
+      dependencies: { a: '^1.0.0', b: '^1.0.0' },
+      entryPoint: '42',
+    });
+
+    await expect(m.installPlugin(manifest)).rejects.toThrow('Circular dependency detected');
+  });
+
+  it('should register the plugin in the catalog during install', async () => {
+    const m = createMarketplace();
+    const manifest = makeManifest({ name: 'installed-plugin' });
+    await m.installPlugin(manifest);
+    expect(m.registry.get('installed-plugin')).not.toBeNull();
+  });
+});
