plement all modules, write tests, and iterate. Given the complexity and time constraint, let me write the code efficiently.\n\nLet me think about the directory structure and start implementing:\n\nFor better-sqlite3 with ESM (type: module), I need to be careful. better-sqlite3 is a C++ addon, but it should work with ESM imports.\n\nWait, with `\"module\": \"Node16\"` in tsconfig, I need `.js` extensions in imports. And the package.json has `\"type\": \"module\"`.\n\nLet me think about the in-memory vs SQLite approach. The task says \"Use better-sqlite3 for any persistence needs\". I could use in-memory SQLite databases (`:memory:`) for testing and simplicity.\n\nActually, for the registry and reviews, I'll use better-sqlite3 with `:memory:` databases so each instance is isolated.\n\nLet me start writing the code.\n\n### registry.ts\n\n```typescript\nimport Database from 'better-sqlite3';\nimport type { PluginManifest, RegistryService } from './types.js';\n\nexport function createRegistry(db?: Database.Database): RegistryService {\n  const database = db ?? new Database(':memory:');\n  \n  database.exec(`\n    CREATE TABLE IF NOT EXISTS plugins (\n      name TEXT NOT NULL,\n      version TEXT NOT NULL,\n      description TEXT NOT NULL,\n      author TEXT NOT NULL,\n      dependencies TEXT NOT NULL DEFAULT '{}',\n      entryPoint TEXT NOT NULL,\n      permissions TEXT NOT NULL DEFAULT '[]',\n      PRIMARY KEY (name, version)\n    )\n  `);\n\n  const registerStmt = database.prepare(\n    'INSERT OR REPLACE INTO plugins (name, version, description, author, dependencies, entryPoint, permissions) VALUES (?, ?, ?, ?, ?, ?, ?)'\n  );\n\n  const getVersionStmt = database.prepare(\n    'SELECT * FROM plugins WHERE name = ? AND version = ?'\n  );\n\n  const listVersionsStmt = database.prepare(\n    'SELECT version FROM plugins WHERE name = ?'\n  );\n\n  const removeStmt = database.prepare(\n    'DELETE FROM plugins WHERE name = ? AND version = ?'\n  );\n\n  const updateStmt = database.prepare(\n    'UPDATE plugins SET description = COALESCE(?, description), author = COALESCE(?, author), dependencies = COALESCE(?, dependencies), entryPoint = COALESCE(?, entryPoint), permissions = COALESCE(?, permissions) WHERE name = ? AND version = ?'\n  );\n\n  function rowToManifest(row: Record<string, unknown>): PluginManifest {\n    return {\n      name: row.name as string,\n      version: row.version as string,\n      description: row.description as string,\n      author: row.author as string,\n      dependencies: JSON.parse(row.dependencies as string),\n      entryPoint: row.entryPoint as string,\n      permissions: JSON.parse(row.permissions as string),\n    };\n  }\n\n  return {\n    register(manifest: PluginManifest): void {\n      registerStmt.run(\n        manifest.name,\n        manifest.version,\n        manifest.description,\n        manifest.author,\n        JSON.stringify(manifest.dependencies),\n        manifest.entryPoint,\n        JSON.stringify(manifest.permissions)\n      );\n    },\n\n    get(name: string): PluginManifest | null {\n      // Get the latest version\n      const versions = listVersionsStmt.all(name) as { version: string }[];\n      if (versions.length === 0) return null;\n      // Sort versions and pick the latest\n      // Simple approach: use semver to find max\n      // But we don't want to import semver in registry. Let me just pick the last inserted or sort lexicographically.\n      // Actually, let's sort by semver. But the constraint says modules shouldn't import each other.\n      // Let me just sort them and pick the highest.\n      versions.sort((a, b) => b.version.localeCompare(a.version));\n      return this.getVersion(name, versions[0].version);\n    },\n\n    getVersion(name: string, version: string): PluginManifest | null {\n      const row = getVersionStmt.get(name, version) as Record<string, unknown> | undefined;\n      return row ? rowToManifest(row) : null;\n    },\n\n    list(): PluginManifest[] {\n      const rows = database.prepare('SELECT * FROM plugins').all() as Record<string, unknown>[];\n      return rows.map(rowToManifest);\n    },\n\n    search(query: string): PluginManifest[] {\n      const rows = database.prepare(\n        'SELECT * FROM plugins WHERE name LIKE ? OR description LIKE ? OR author LIKE ?'\n      ).all(`%${query}%`, `%${query}%`, `%${query}%`) as Record<string, unknown>[];\n      return rows.map(rowToManifest);\n    },\n\n    remove(name: string, version: string): boolean {\n      const result = removeStmt.run(name, version);\n      return result.changes > 0;\n    },\n\n    listVersions(name: string): string[] {\n      const rows = listVersionsStmt.all(name) as { version: string }[];\n      return rows.map(r => r.version);\n    },\n\n    update(name: string, version: string, updates: Partial<PluginManifest>): void {\n      // For COALESCE approach with JSON fields, we need to handle null vs undefined\n      const current = this.getVersion(name, version);\n      if (!current) return;\n      \n      const desc = updates.description ?? null;\n      const author = updates.author ?? null;\n      const deps = updates.dependencies !== undefined ? JSON.stringify(updates.dependencies) : null;\n      const entry = updates.entryPoint ?? null;\n      const perms = updates.permissions !== undefined ? JSON.stringify(updates.permissions) : null;\n      \n      updateStmt.run(desc, author, deps, entry, perms, name, version);\n    },\n  };\n}\n```\n\nWait, I realize there's a problem with the `get` method trying to sort versions properly. Let me use semver for that. But the constraint says modules shouldn't import each other. However, importing the `semver` npm package is different from importing another module in the project. The constraint says \"Modules should only share types, not import each other directly\" - so I can import `semver` npm package but not `./resolver.js`.\n\nActually, for `get(name)` which returns the \"latest\" version, I think a reasonable approach is to use semver to find the max satisfying version. Let me import semver directly.\n\nActually wait, let me re-read: \"Modules should only share types, not import each other directly\". This means I can import the `semver` npm package in any module - just not import other modules in the project (like registry shouldn't import resolver).\n\nOK let me just import semver in the registry for proper version sorting.\n\nActually, let me think again. `get(name)` returns `PluginManifest | null`. It probably just returns the latest version. I can sort using semver.\n\nLet me also think about the `update` method more carefully. The COALESCE approach with SQL should work for simple fields, but for JSON fields (dependencies, permissions) I need to handle them specially.\n\nActually, let me simplify the update approach. Just get the current manifest, merge the updates, and re-insert.\n\n```typescript\nupdate(name: string, version: string, updates: Partial<PluginManifest>): void {\n  const current = this.getVersion(name, version);\n  if (!current) return;\n  const merged = { ...current, ...updates };\n  this.register(merged); // INSERT OR REPLACE\n},\n```\n\nThat's much simpler and cleaner.\n\nNow let me plan the resolver:\n\n### resolver.ts\n\n```typescript\nimport semver from 'semver';\nimport type { VersionConstraint, ResolvedVersion, ResolverService } from './types.js';\n\nexport function createResolver(): ResolverService {\n  return {\n    resolve(constraints: VersionConstraint[], available: Record<string, string[]>): ResolvedVersion[] {\n      const results: ResolvedVersion[] = [];\n      for (const constraint of constraints) {\n        const versions = available[constraint.name];\n        if (!versions || versions.length === 0) continue;\n        const max = semver.maxSatisfying(versions, constraint.range);\n        if (max) {\n          results.push({ name: constraint.name, version: max, satisfies: constraint.range });\n        }\n      }\n      return results;\n    },\n\n    satisfies(version: string, range: string): boolean {\n      return semver.satisfies(version, range) ?? false;\n    },\n\n    maxSatisfying(versions: string[], range: string): string | null {\n      return semver.maxSatisfying(versions, range);\n    },\n\n    validRange(range: string): boolean {\n      return semver.validRange(range) !== null;\n    },\n  };\n}\n```\n\n### runner.ts\n\n```typescript\nimport vm from 'vm';\nimport type { SandboxResult, RunnerService } from './types.js';\n\nexport function createRunner(): RunnerService {\n  function executeInternal(code: string, context?: Record<string, unknown>, timeoutMs?: number): SandboxResult {\n    const start = performance.now();\n    let memoryUsed = 0;\n    \n    try {\n      const sandbox: Record<string, unknown> = { ...context };\n      vm.createContext(sandbox);\n      \n      const script = new vm.Script(code);\n      const options: vm.RunningScriptOptions = {};\n      if (timeoutMs) {\n        options.timeout = timeoutMs;\n      }\n      \n      const output = script.runInContext(sandbox, options);\n      \n      // Estimate memory usage\n      memoryUsed = JSON.stringify(output).length; // rough estimate\n      \n      const duration = performance.now() - start;\n      \n      return {\n        success: true,\n        output,\n        duration,\n        memoryUsed,\n      };\n    } catch (err) {\n      const duration = performance.now() - start;\n      return {\n        success: false,\n        output: null,\n        duration,\n        memoryUsed,\n        error: err instanceof Error ? err.message : String(err),\n      };\n    }\n  }\n\n  return {\n    async execute(code: string, context?: Record<string, unknown>): Promise<SandboxResult> {\n      return executeInternal(code, context);\n    },\n\n    async executeWithTimeout(code: string, timeoutMs: number, context?: Record<string, unknown>): Promise<SandboxResult> {\n      return executeInternal(code, context, timeoutMs);\n    },\n  };\n}\n```\n\nWait, the memory measurement... `JSON.stringify(output).length` could fail if output is circular or not serializable. Let me use a simpler approach or try/catch it.\n\nAlso, I should think about how to measure memory more accurately. The `vm` module doesn't give us direct memory stats. I could use `process.memoryUsage()` before and after, but that's the process-wide memory, not specific to the script. Let me use a rough estimate based on the output.\n\nActually, let me use `process.memoryUsage().heapUsed` delta as a rough approximation, or just estimate from the output. The tests probably won't be too strict about the exact memory value.\n\nLet me refine the runner to handle edge cases better.\n\n### reviews.ts\n\n```typescript\nimport Database from 'better-sqlite3';\nimport type { Review, ReviewService } from './types.js';\n\nexport function createReviewSystem(db?: Database.Database): ReviewService {\n  const database = db ?? new Database(':memory:');\n  \n  database.exec(`\n    CREATE TABLE IF NOT EXISTS reviews (\n      id INTEGER PRIMARY KEY AUTOINCREMENT,\n      pluginName TEXT NOT NULL,\n      pluginVersion TEXT NOT NULL,\n      userId TEXT NOT NULL,\n      rating INTEGER NOT NULL,\n      comment TEXT NOT NULL,\n      flagged INTEGER NOT NULL DEFAULT 0,\n      createdAt TEXT NOT NULL DEFAULT (datetime('now'))\n    )\n  `);\n\n  return {\n    addReview(review: Omit<Review, 'id' | 'createdAt' | 'flagged'>): Review {\n      const stmt = database.prepare(\n        'INSERT INTO reviews (pluginName, pluginVersion, userId, rating, comment) VALUES (?, ?, ?, ?, ?)'\n      );\n      const result = stmt.run(review.pluginName, review.pluginVersion, review.userId, review.rating, review.comment);\n      \n      const row = database.prepare('SELECT * FROM reviews WHERE id = ?').get(result.lastInsertRowid) as Record<string, unknown>;\n      return {\n        id: row.id as number,\n        pluginName: row.pluginName as string,\n        pluginVersion: row.pluginVersion as string,\n        userId: row.userId as string,\n        rating: row.rating as number,\n        comment: row.comment as string,\n        flagged: Boolean(row.flagged),\n        createdAt: row.createdAt as string,\n      };\n    },\n\n    getReviews(pluginName: string): Review[] {\n      const rows = database.prepare('SELECT * FROM reviews WHERE pluginName = ?').all(pluginName) as Record<string, unknown>[];\n      return rows.map(rowToReview);\n    },\n\n    getAverageRating(pluginName: string): number {\n      const row = database.prepare(\n        \"SELECT AVG(rating) as avg FROM reviews WHERE pluginName = ? AND flagged = 0\"\n      ).get(pluginName) as { avg: number | null };\n      return row.avg ?? 0;\n    },\n\n    flagReview(reviewId: number): void {\n      database.prepare('UPDATE reviews SET flagged = 1 WHERE id = ?').run(reviewId);\n    },\n\n    getFlaggedReviews(): Review[] {\n      const rows = database.prepare('SELECT * FROM reviews WHERE flagged = 1').all() as Record<string, unknown>[];\n      return rows.map(rowToReview);\n    },\n\n    removeReview(reviewId: number): boolean {\n      const result = database.prepare('DELETE FROM reviews WHERE id = ?').run(reviewId);\n      return result.changes > 0;\n    },\n\n    getReviewsByUser(userId: string): Review[] {\n      const rows = database.prepare('SELECT * FROM reviews WHERE userId = ?').all(userId) as Record<string, unknown>[];\n      return rows.map(rowToReview);\n    },\n\n    getReviewCount(pluginName: string): number {\n      const row = database.prepare('SELECT COUNT(*) as count FROM reviews WHERE pluginName = ?').get(pluginName) as { count: number };\n      return row.count;\n    },\n  };\n}\n\nfunction rowToReview(row: Record<string, unknown>): Review {\n  return {\n    id: row.id as number,\n    pluginName: row.pluginName as string,\n    pluginVersion: row.pluginVersion as string,\n    userId: row.userId as string,\n    rating: row.rating as number,\n    comment: row.comment as string,\n    flagged: Boolean(row.flagged),\n    createdAt: row.createdAt as string,\n  };\n}\n```\n\n### deps.ts\n\n```typescript\nimport type { DependencyNode, DepsService, RegistryService } from './types.js';\n\nexport function createDepsService(): DepsService {\n  return {\n    buildTree(name: string, registry: RegistryService): DependencyNode {\n      const plugin = registry.get(name);\n      if (!plugin) {\n        return { name, version: '', dependencies: [] };\n      }\n      \n      const deps: DependencyNode[] = [];\n      for (const [depName, depRange] of Object.entries(plugin.dependencies)) {\n        // Try to find the best matching version\n        const versions = registry.listVersions(depName);\n        // Just use the first available version or the range as version\n        const depPlugin = registry.get(depName);\n        if (depPlugin) {\n          deps.push(this.buildTree(depName, registry));\n        } else {\n          deps.push({ name: depName, version: depRange, dependencies: [] });\n        }\n      }\n      \n      return { name: plugin.name, version: plugin.version, dependencies: deps };\n    },\n\n    detectCycles(name: string, registry: RegistryService): string[][] | null {\n      const cycles: string[][] = [];\n      const visited = new Set<string>();\n      const path: string[] = [];\n      \n      function dfs(pluginName: string): void {\n        if (path.includes(pluginName)) {\n          const cycleStart = path.indexOf(pluginName);\n          cycles.push([...path.slice(cycleStart), pluginName]);\n          return;\n        }\n        if (visited.has(pluginName)) return;\n        \n        path.push(pluginName);\n        const plugin = registry.get(pluginName);\n        if (plugin) {\n          for (const depName of Object.keys(plugin.dependencies)) {\n            dfs(depName);\n          }\n        }\n        path.pop();\n        visited.add(pluginName);\n      }\n      \n      dfs(name);\n      return cycles.length > 0 ? cycles : null;\n 