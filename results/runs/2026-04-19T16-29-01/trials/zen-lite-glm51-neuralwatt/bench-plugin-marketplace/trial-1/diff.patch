y.list()).toHaveLength(2);\n  });\n\n  it('should list multiple versions of the same plugin', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    expect(registry.list()).toHaveLength(2);\n  });\n\n  it('should search plugins by name', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ name: 'cool-plugin' }));\n    registry.register(makeManifest({ name: 'other-plugin' }));\n    const results = registry.search('cool');\n    expect(results).toHaveLength(1);\n    expect(results[0].name).toBe('cool-plugin');\n  });\n\n  it('should search plugins by description', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ description: 'An awesome logger' }));\n    registry.register(makeManifest({ description: 'A database tool' }));\n    const results = registry.search('logger');\n    expect(results).toHaveLength(1);\n  });\n\n  it('should search plugins by author', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ author: 'alice' }));\n    registry.register(makeManifest({ author: 'bob' }));\n    expect(registry.search('alice')).toHaveLength(1);\n  });\n\n  it('should remove a specific version', () => {\n    const registry = createRegistry();\n    registry.register(makeManifest({ version: '1.0.0' }));\n    registry.register(makeManifest({ version: '2.0.0' }));\n    expect(registry.remove('test-plugin', '1.0.0')).toBe(true);\n    expect(registry.getVersion('test-plugin', '1.0.0')).toBeNull();\n    expect(registry.getVersion('test-plugin', '2.0.0')).not.toBeNull();\n  });\n\n  it('should return false when removing non-existent version', () => {\n    const registry = createRegistry();\n    expect(registry.remove('nonexistent', '1.0.0')).toBe(false);\n  });\n\n  it('should list versions for a plugin', () => {\n    const registry = createRegistry();\n    registry.