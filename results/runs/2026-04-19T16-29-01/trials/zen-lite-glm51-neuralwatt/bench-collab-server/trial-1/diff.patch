new file mode 100644
index 0000000..4b22b81
--- /dev/null
+++ b/src/ot.ts
@@ -0,0 +1,136 @@
+export interface InsertOp {
+  type: 'insert';
+  pos: number;
+  text: string;
+}
+
+export interface DeleteOp {
+  type: 'delete';
+  pos: number;
+  length: number;
+}
+
+export type Op = InsertOp | DeleteOp;
+
+export function applyOp(doc: string, op: Op): string {
+  if (op.type === 'insert') {
+    if (op.pos < 0 || op.pos > doc.length || typeof op.text !== 'string') return doc;
+    return doc.slice(0, op.pos) + op.text + doc.slice(op.pos);
+  } else {
+    if (op.pos < 0 || op.pos > doc.length || op.length <= 0) return doc;
+    const actualLen = Math.min(op.length, doc.length - op.pos);
+    return doc.slice(0, op.pos) + doc.slice(op.pos + actualLen);
+  }
+}
+
+export function applyOps(doc: string, ops: Op[]): string {
+  return ops.reduce((d, op) => applyOp(d, op), doc);
+}
+
+/**
+ * Transform op1 against op2 (op2 has already been applied).
+ * Returns op1' such that: apply(apply(S, op2), op1') converges correctly.
+ */
+export function transform(op1: Op, op2: Op): Op[] {
+  if (op1.type === 'insert' && op2.type === 'insert') {
+    return [transformInsertInsert(op1, op2)];
+  }
+  if (op1.type === 'insert' && op2.type === 'delete') {
+    return [transformInsertDelete(op1, op2)];
+  }
+  if (op1.type === 'delete' && op2.type === 'insert') {
+    return transformDeleteInsert(op1, op2);
+  }
+  if (op1.type === 'delete' && op2.type === 'delete') {
+    return transformDeleteDelete(op1, op2);
+  }
+  return [op1];
+}
+
+function transformInsertInsert(op1: InsertOp, op2: InsertOp): InsertOp {
+  if (op2.pos < op1.pos) {
+    return { ...op1, pos: op1.pos + op2.text.length };
+  }
+  if (op2.pos > op1.pos) {
+    return op1;
+  }
+  // Same position: op2 was applied first, so op1 goes after
+  return { ...op1, pos: op1.pos + op2.text.length };
+}
+
+function transformInsertDelete(op1: InsertOp, op2: DeleteOp): InsertOp {
+  if (op1.pos <= op2.pos) {
+    return op1;
+  }
+  if (op1.pos >= op2.pos + op2.length) {
+    return { ...op1, pos: op1.pos - op2.length };
+  }
+  // Insert was inside the deleted range: place at start of deletion
+  return { ...op1, pos: op2.pos };
+}
+
+function transformDeleteInsert(op1: DeleteOp, op2: InsertOp): Op[] {
+  if (op2.pos <= op1.pos) {
+    return [{ ...op1, pos: op1.pos + op2.text.length }];
+  }
+  if (op2.pos >= op1.pos + op1.length) {
+    return [op1];
+  }
+  // Insert is within the delete range - split around insert to preserve it
+  const beforeLen = op2.pos - op1.pos;
+  const afterLen = op1.length - beforeLen;
+  const result: Op[] = [];
+  if (beforeLen > 0) {
+    result.push({ type: 'delete', pos: op1.pos, length: beforeLen });
+  }
+  if (afterLen > 0) {
+    result.push({ type: 'delete', pos: op2.pos + op2.text.length - beforeLen, length: afterLen });
+  }
+  return result;
+}
+
+function transformDeleteDelete(op1: DeleteOp, op2: DeleteOp): Op[] {
+  const op1End = op1.pos + op1.length;
+  const op2End = op2.pos + op2.length;
+
+  // op1 is entirely before op2
+  if (op1End <= op2.pos) {
+    return [op1];
+  }
+  // op1 is entirely after op2
+  if (op1.pos >= op2End) {
+    return [{ ...op1, pos: op1.pos - op2.length }];
+  }
+  // op1 is entirely within op2 (already deleted)
+  if (op1.pos >= op2.pos && op1End <= op2End) {
+    return [];
+  }
+  // op2 is entirely within op1
+  if (op1.pos < op2.pos && op1End > op2End) {
+    return [{ ...op1, length: op1.length - op2.length }];
+  }
+  // Overlap: op1 starts before op2
+  if (op1.pos < op2.pos) {
+    const overlap = op1End - op2.pos;
+    return [{ ...op1, length: op1.length - overlap }];
+  }
+  // Overlap: op1 starts within op2
+  const overlap = op2End - op1.pos;
+  return [{ type: 'delete', pos: op2.pos, length: op1.length - overlap }];
+}
+
+/**
+ * Transform an operation against a sequence of history operations.
+ * fromRev is the revision the operation is based on (0-indexed history position).
+ */
+export function transformAgainstHistory(op: Op, history: Op[], fromRev: number): Op[] {
+  let ops: Op[] = [op];
+  for (let i = fromRev; i < history.length; i++) {
+    const newOps: Op[] = [];
+    for (const o of ops) {
+      newOps.push(...transform(o, history[i]));
+    }
+    ops = newOps;
+  }
+  return ops;
+}
