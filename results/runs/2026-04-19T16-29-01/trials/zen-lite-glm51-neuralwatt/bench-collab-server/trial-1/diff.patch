+{"type":"assistant","message":{"id":"chatcmpl-aac1f3b545ee3939","content":[{"type":"tool_use","id":"chatcmpl-tool-b1637b94e457f849","name":"Write","input":{"file_path":"/workspace/src/database.ts","content":"import BetterSqlite3 from 'better-sqlite3';\nimport { readFileSync } from 'fs';\nimport { join, dirname } from 'path';\nimport { fileURLToPath } from 'url';\nimport type { Op } from './ot.js';\n\nexport interface DocumentRow {\n  id: string;\n  title: string;\n  content: string;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface VersionRow {\n  id: number;\n  document_id: string;\n  version: number;\n  content: string;\n  operation: string | null;\n  created_at: string;\n}\n\nexport class Database {\n  private db: BetterSqlite3.Database;\n\n  constructor(dbPath?: string) {\n    const path = dbPath || ':memory:';\n    this.db = new BetterSqlite3(path);\n    this.db.pragma('journal_mode = WAL');\n    this.db.pragma('foreign_keys = ON');\n    this.migrate();\n  }\n\n  private migrate(): void {\n    const __dirname = dirname(fileURLToPath(import.meta.url));\n    const schemaPath = join(__dirname, '..', 'schema.sql');\n    let schema: string;\n    try {\n      schema = readFileSync(schemaPath, 'utf-8');\n    } catch {\n      schema = `\nCREATE TABLE IF NOT EXISTS documents (\n  id TEXT PRIMARY KEY,\n  title TEXT NOT NULL,\n  content TEXT NOT NULL DEFAULT '',\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\n  updated_at TEXT NOT NULL DEFAULT (datetime('now'))\n);\n\nCREATE TABLE IF NOT EXISTS versions (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,\n  version INTEGER NOT NULL,\n  content TEXT NOT NULL,\n  operation TEXT,\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\n  UNIQUE(document_id, version)\n);\n\nCREATE TABLE IF NOT EXISTS active_connections (\n  id TEXT PRIMARY KEY,\n  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,\n  connected_at TEXT NOT NULL DEFAULT (datetime('now'))\n);`;\n    }\n    this.db.exec(schema);\n  }\n\n  // Document CRUD\n  createDocument(id: string, title: string, content: string = ''): DocumentRow {\n    const now = new Date().toISOString();\n    const stmt = this.db.prepare(\n      `INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`\n    );\n    stmt.run(id, title, content, now, now);\n    return this.getDocument(id)!;\n  }\n\n  getDocument(id: string): DocumentRow | undefined {\n    const stmt = this.db.prepare('SELECT * FROM documents WHERE id = ?');\n    return stmt.get(id) as DocumentRow | undefined;\n  }\n\n  listDocuments(): DocumentRow[] {\n    const stmt = this.db.prepare('SELECT * FROM documents ORDER BY updated_at DESC');\n    return stmt.all() as DocumentRow[];\n  }\n\n  updateDocument(id: string, title?: string, content?: string): DocumentRow | undefined {\n    const doc = this.getDocument(id);\n    if (!doc) return undefined;\n    const newTitle = title !== undefined ? title : doc.title;\n    const newContent = content !== undefined ? content : doc.content;\n    const now = new Date().toISOString();\n    const stmt = this.db.prepare(\n      `UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?`\n    );\n    stmt.run(newTitle, newContent, now, id);\n    return this.getDocument(id);\n  }\n\n  deleteDocument(id: string): boolean {\n    const stmt = this.db.prepare('DELETE FROM documents WHERE id = ?');\n    const result = stmt.run(id);\n    return result.changes > 0;\n  }\n\n  // Version history\n  addVersion(documentId: string, version: number, content: string, operation: Op | null): void {\n    const stmt = this.db.prepare(\n      `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`\n    );\n    stmt.run(documentId, version, content, operation ? JSON.stringify(operation) : null);\n  }\n\n  getVersions(documentId: string): VersionRow[] {\n    const stmt = this.db.prepare(\n      'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'\n    );\n    return stmt.all(documentId) as VersionRow[];\n  }\n\n  getLatestVersion(documentId: string): number {\n    const stmt = this.db.prepare(\n      'SELECT MAX(version) as v FROM versions WHERE document_id = ?'\n    );\n    const row = stmt.get(documentId) as { v: number | null };\n    return row.v ?? 0;\n  }\n\n  // Connections\n  addConnection(connId: string, documentId: string): void {\n    const stmt = this.db.prepare(\n      'INSERT OR REPLACE INTO active_connections (id, document_id) VALUES (?, ?)'\n    );\n    stmt.run(connId, documentId);\n  }\n\n  removeConnection(connId: string): void {\n    const stmt = this.db.prepare('DELETE FROM active_connections WHERE id = ?');\n    stmt.run(connId);\n  }\n\n  getConnections(documentId: string): string[] {\n    const stmt = this.db.prepare('SELECT id FROM active_connections WHERE document_id = ?');\n    const rows = stmt.all(documentId) as { id: string }[];\n    return rows.map(r => r.id);\n  }\n\n  close(): void {\n    this.db.close();\n  }\n\n  getRawDb(): BetterSqlite3.Database {\n    return this.db;\n  }\n}\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":19937,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b0ad31f0-ad1a-4424-81c3-6607eb9e5527","uuid":"ca0fba0a-461b-4330-92fa-db38797686ca"}
