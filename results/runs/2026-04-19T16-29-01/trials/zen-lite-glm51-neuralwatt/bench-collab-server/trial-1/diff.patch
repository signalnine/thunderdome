+
+    // Connect 10 clients
+    for (let i = 0; i < 10; i++) {
+      const ws = await connectWs(port, 'doc1');
+      await waitForMessage(ws, 'sync');
+      clients.push(ws);
+    }
+
+    // Each client sends an insert at position 0 with their index
+    for (let i = 0; i < 10; i++) {
+      clients[i].send(JSON.stringify({
+        type: 'op',
+        op: { type: 'insert', pos: 0, text: String(i) },
+        revision: 0,
+      }));
+    }
+
+    // Wait for all acks and broadcasts to settle
+    await new Promise(resolve => setTimeout(resolve, 2000));
+
+    // Verify via REST
+    const res = await request(app.app).get('/api/documents/doc1');
+    const content = res.body.content;
+
+    // All 10 characters should be present
+    expect(content.length).toBe(10);
