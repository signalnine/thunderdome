@@ -0,0 +1,193 @@
+import express from 'express';
+import { createServer } from 'http';
+import { WebSocketServer } from 'ws';
+import { randomUUID } from 'crypto';
+import { Database } from './database.js';
+import { DocumentRoom } from './document-room.js';
+
+export interface AppInstance {
+  app: express.Express;
+  start: (port?: number) => number;
+  stop: () => Promise<void>;
+}
+
+export function createApp(dbPath?: string): AppInstance {
+  const app = express();
+  app.use(express.json());
+
+  const db = new Database(dbPath);
+  const rooms = new Map<string, DocumentRoom>();
+  const server = createServer(app);
+  const wss = new WebSocketServer({ server, path: '/ws' });
+
+  let running = false;
+
+  function getRoom(docId: string): DocumentRoom {
+    if (!rooms.has(docId)) {
+      rooms.set(docId, new DocumentRoom(docId, db));
+    }
+    return rooms.get(docId)!;
+  }
+
+  // ---- REST API ----
+
+  // Create document
+  app.post('/api/documents', (req, res) => {
+    const { id, title, content } = req.body;
+    if (!id || !title) {
+      res.status(400).json({ error: 'id and title are required' });
+      return;
+    }
+    if (db.getDocument(id)) {
+      res.status(409).json({ error: 'Document already exists' });
+      return;
+    }
+    const doc = db.createDocument(id, title, content ?? '');
+    // Invalidate room cache
+    rooms.delete(id);
+    res.status(201).json(doc);
+  });
+
+  // Get document
+  app.get('/api/documents/:id', (req, res) => {
+    const doc = db.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(doc);
+  });
+
+  // List documents
+  app.get('/api/documents', (_req, res) => {
+    res.json(db.listDocuments());
+  });
+
+  // Update document
+  app.put('/api/documents/:id', (req, res) => {
+    const { title, content } = req.body;
+    const doc = db.updateDocument(req.params.id, title, content);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    // Invalidate room cache so it reloads from DB
+    rooms.delete(req.params.id);
+    res.json(doc);
+  });
+
+  // Delete document
+  app.delete('/api/documents/:id', (req, res) => {
+    // Close all connections for this document
+    const room = rooms.get(req.params.id);
+    if (room) {
+      rooms.delete(req.params.id);
+    }
+    const deleted = db.deleteDocument(req.params.id);
+    if (!deleted) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.status(204).send();
+  });
+
+  // Get version history
+  app.get('/api/documents/:id/versions', (req, res) => {
+    const doc = db.getDocument(req.params.id);
+    if (!doc) {
+      res.status(404).json({ error: 'Document not found' });
+      return;
+    }
+    res.json(db.getVersions(req.params.id));
+  });
+
+  // ---- WebSocket ----
+
+  wss.on('connection', (ws, req) => {
+    // Parse document ID from URL: /ws/:docId
+    const urlPath = req.url ?? '';
+    const parts = urlPath.split('/');
+    // Expect /ws/{docId}
+    const docId = parts.length >= 3 ? parts[2] : undefined;
+
+    if (!docId) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document ID required in path' }));
+      ws.close();
+      return;
+    }
+
+    const doc = db.getDocument(docId);
+    if (!doc) {
+      ws.send(JSON.stringify({ type: 'error', message: 'Document not found' }));
+      ws.close();
+      return;
+    }
+
+    const connId = randomUUID();
+    const room = getRoom(docId);
+    room.addClient(ws, connId);
+
+    ws.on('message', (raw) => {
+      try {
+        const msg = JSON.parse(raw.toString());
+        if (msg.type === 'op') {
+          room.handleOperation(connId, { op: msg.op, revision: msg.revision });
+        } else {
+          ws.send(JSON.stringify({ type: 'error', message: `Unknown message type: ${msg.type}` }));
+        }
+      } catch {
+        ws.send(JSON.stringify({ type: 'error', message: 'Invalid JSON' }));
+      }
+    });
+
+    ws.on('close', () => {
+      room.removeClient(connId);
+      // Clean up empty rooms
+      if (room.getClientCount() === 0) {
+        rooms.delete(docId);
+      }
+    });
+
+    ws.on('error', () => {
+      room.removeClient(connId);
+    });
+  });
+
+  function start(port?: number): number {
+    const p = port ?? 0;
+    server.listen(p);
+    running = true;
+    const addr = server.address();
+    if (addr && typeof addr === 'object') {
+      return addr.port;
+    }
+    return p;
+  }
+
+  function stop(): Promise<void> {
+    return new Promise((resolve, reject) => {
+      // Close all WebSocket connections
+      wss.clients.forEach(ws => {
+        ws.close();
+      });
+
+      // Close rooms
+      rooms.clear();
+
+      if (!running) {
+        db.close();
+        resolve();
+        return;
+      }
+
+      server.close((err) => {
+        running = false;
+        db.close();
+        if (err) reject(err);
+        else resolve();
+      });
+    });
+  }
+
+  return { app, start, stop };
+}
