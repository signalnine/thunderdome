diff --git a/src/database.ts b/src/database.ts
new file mode 100644
index 0000000..00672a2
--- /dev/null
+++ b/src/database.ts
@@ -0,0 +1,158 @@
+import BetterSqlite3 from 'better-sqlite3';
+import { readFileSync } from 'fs';
+import { join, dirname } from 'path';
+import { fileURLToPath } from 'url';
+import type { Op } from './ot.js';
+
+export interface DocumentRow {
+  id: string;
+  title: string;
+  content: string;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface VersionRow {
+  id: number;
+  document_id: string;
+  version: number;
+  content: string;
+  operation: string | null;
+  created_at: string;
+}
+
+export class Database {
+  private db: BetterSqlite3.Database;
+
+  constructor(dbPath?: string) {
+    const path = dbPath || ':memory:';
+    this.db = new BetterSqlite3(path);
+    this.db.pragma('journal_mode = WAL');
+    this.db.pragma('foreign_keys = ON');
+    this.migrate();
+  }
+
+  private migrate(): void {
+    const __dirname = dirname(fileURLToPath(import.meta.url));
+    const schemaPath = join(__dirname, '..', 'schema.sql');
+    let schema: string;
+    try {
+      schema = readFileSync(schemaPath, 'utf-8');
+    } catch {
+      schema = `
+CREATE TABLE IF NOT EXISTS documents (
+  id TEXT PRIMARY KEY,
+  title TEXT NOT NULL,
+  content TEXT NOT NULL DEFAULT '',
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  updated_at TEXT NOT NULL DEFAULT (datetime('now'))
+);
+
+CREATE TABLE IF NOT EXISTS versions (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  version INTEGER NOT NULL,
+  content TEXT NOT NULL,
+  operation TEXT,
+  created_at TEXT NOT NULL DEFAULT (datetime('now')),
+  UNIQUE(document_id, version)
+);
+
+CREATE TABLE IF NOT EXISTS active_connections (
+  id TEXT PRIMARY KEY,
+  document_id TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
+  connected_at TEXT NOT NULL DEFAULT (datetime('now'))
+);`;
+    }
+    this.db.exec(schema);
+  }
+
+  // Document CRUD
+  createDocument(id: string, title: string, content: string = ''): DocumentRow {
+    const now = new Date().toISOString();
+    const stmt = this.db.prepare(
+      `INSERT INTO documents (id, title, content, created_at, updated_at) VALUES (?, ?, ?, ?, ?)`
+    );
+    stmt.run(id, title, content, now, now);
+    return this.getDocument(id)!;
+  }
+
+  getDocument(id: string): DocumentRow | undefined {
+    const stmt = this.db.prepare('SELECT * FROM documents WHERE id = ?');
+    return stmt.get(id) as DocumentRow | undefined;
+  }
+
+  listDocuments(): DocumentRow[] {
+    const stmt = this.db.prepare('SELECT * FROM documents ORDER BY updated_at DESC');
+    return stmt.all() as DocumentRow[];
+  }
+
+  updateDocument(id: string, title?: string, content?: string): DocumentRow | undefined {
+    const doc = this.getDocument(id);
+    if (!doc) return undefined;
+    const newTitle = title !== undefined ? title : doc.title;
+    const newContent = content !== undefined ? content : doc.content;
+    const now = new Date().toISOString();
+    const stmt = this.db.prepare(
+      `UPDATE documents SET title = ?, content = ?, updated_at = ? WHERE id = ?`
+    );
+    stmt.run(newTitle, newContent, now, id);
+    return this.getDocument(id);
+  }
+
+  deleteDocument(id: string): boolean {
+    const stmt = this.db.prepare('DELETE FROM documents WHERE id = ?');
+    const result = stmt.run(id);
+    return result.changes > 0;
+  }
+
+  // Version history
+  addVersion(documentId: string, version: number, content: string, operation: Op | null): void {
+    const stmt = this.db.prepare(
+      `INSERT INTO versions (document_id, version, content, operation) VALUES (?, ?, ?, ?)`
+    );
+    stmt.run(documentId, version, content, operation ? JSON.stringify(operation) : null);
+  }
+
+  getVersions(documentId: string): VersionRow[] {
+    const stmt = this.db.prepare(
+      'SELECT * FROM versions WHERE document_id = ? ORDER BY version ASC'
+    );
+    return stmt.all(documentId) as VersionRow[];
+  }
+
+  getLatestVersion(documentId: string): number {
+    const stmt = this.db.prepare(
+      'SELECT MAX(version) as v FROM versions WHERE document_id = ?'
+    );
+    const row = stmt.get(documentId) as { v: number | null };
+    return row.v ?? 0;
+  }
+
+  // Connections
+  addConnection(connId: string, documentId: string): void {
+    const stmt = this.db.prepare(
+      'INSERT OR REPLACE INTO active_connections (id, document_id) VALUES (?, ?)'
+    );
+    stmt.run(connId, documentId);
+  }
+
+  removeConnection(connId: string): void {
+    const stmt = this.db.prepare('DELETE FROM active_connections WHERE id = ?');
+    stmt.run(connId);
+  }
+
+  getConnections(documentId: string): string[] {
+    const stmt = this.db.prepare('SELECT id FROM active_connections WHERE document_id = ?');
+    const rows = stmt.all(documentId) as { id: string }[];
+    return rows.map(r => r.id);
+  }
+
+  close(): void {
+    this.db.close();
+  }
+
+  getRawDb(): BetterSqlite3.Database {
+    return this.db;
+  }
+}
diff --git a/src/document-room.ts b/src/document-room.ts
new file mode 100644
index 0000000..e4c4a05
--- /dev/null
+++ b/src/document-room.ts
@@ -0,0 +1,146 @@
+import type { WebSocket } from 'ws';
+import type { Database } from './database.js';
+import { applyOps, transformAgainstHistory, type Op } from './ot.js';
+
+interface Client {
+  ws: WebSocket;
+  connId: string;
+}
+
+export class DocumentRoom {
+  private clients: Map<string, Client> = new Map();
+  private history: Op[] = [];
+  private documentId: string;
+  private db: Database;
+  private content: string;
+
+  constructor(documentId: string, db: Database) {
+    this.documentId = documentId;
+    this.db = db;
+    const doc = db.getDocument(documentId);
+    this.content = doc?.content ?? '';
+    // Load history from DB versions
+    this.loadHistory();
+  }
+
+  private loadHistory(): void {
+    const versions = this.db.getVersions(this.documentId);
+    for (const v of versions) {
+      if (v.operation) {
+        try {
+          this.history.push(JSON.parse(v.operation));
+        } catch {
+          // skip malformed
+        }
+      }
+    }
+  }
+
+  getContent(): string {
+    return this.content;
+  }
+
+  getRevision(): number {
+    return this.history.length;
+  }
+
+  addClient(ws: WebSocket, connId: string): void {
+    this.clients.set(connId, { ws, connId });
+    this.db.addConnection(connId, this.documentId);
+
+    // Send sync message with current state
+    this.sendToClient(ws, {
+      type: 'sync',
+      content: this.content,
+      revision: this.history.length,
+    });
+  }
+
+  removeClient(connId: string): void {
+    this.clients.delete(connId);
+    this.db.removeConnection(connId);
+  }
+
+  getClientCount(): number {
+    return this.clients.size;
+  }
+
+  handleOperation(connId: string, msg: { op: Op; revision?: number }): void {
+    const client = this.clients.get(connId);
+    if (!client) return;
+
+    const { op, revision } = msg;
+
+    // Validate operation
+    if (!op || (op.type !== 'insert' && op.type !== 'delete')) {
+      this.sendToClient(client.ws, { type: 'error', message: `Unknown operation type: ${(op as Record<string, unknown>)?.type ?? 'undefined'}` });
+      return;
+    }
+
+    if (op.type === 'insert') {
+      if (typeof op.pos !== 'number' || typeof op.text !== 'string') {
+        this.sendToClient(client.ws, { type: 'error', message: 'Invalid insert operation' });
+        return;
+      }
+      if (op.pos < 0 || op.pos > this.content.length) {
+        this.sendToClient(client.ws, { type: 'error', message: 'Insert position out of bounds' });
+        return;
+      }
+    } else {
+      if (typeof op.pos !== 'number' || typeof op.length !== 'number') {
+        this.sendToClient(client.ws, { type: 'error', message: 'Invalid delete operation' });
+        return;
+      }
+      if (op.pos < 0 || op.pos >= this.content.length) {
+        this.sendToClient(client.ws, { type: 'error', message: 'Delete position out of bounds' });
+        return;
+      }
+    }
+
+    const fromRev = revision ?? this.history.length;
+
+    // Transform against concurrent ops
+    const transformedOps = transformAgainstHistory(op, this.history, fromRev);
+
+    // Apply to document
+    this.content = applyOps(this.content, transformedOps);
+
+    // Store each transformed op in history
+    const newRevStart = this.history.length;
+    for (const top of transformedOps) {
+      this.history.push(top);
+    }
+    const newRev = this.history.length;
+
+    // Persist
+    this.db.updateDocument(this.documentId, undefined, this.content);
+    for (let i = 0; i < transformedOps.length; i++) {
+      this.db.addVersion(this.documentId, newRevStart + i + 1, this.content, transformedOps[i]);
+    }
+
+    // Acknowledge to sender
+    this.sendToClient(client.ws, {
+      type: 'ack',
+      revision: newRev,
+    });
+
+    // Broadcast to other clients
+    for (const [cid, c] of this.clients) {
+      if (cid !== connId) {
+        // Each other client may be at a different revision; we send the transformed ops
+        // with the revision they apply from
+        this.sendToClient(c.ws, {
+          type: 'op',
+          ops: transformedOps,
+          revision: newRevStart,
+        });
+      }
+    }
+  }
+
+  private sendToClient(ws: WebSocket, data: unknown): void {
+    if (ws.readyState === ws.OPEN) {
+      ws.send(JSON.stringify(data));
+    }
+  }
+}
