+{"type":"assistant","message":{"id":"chatcmpl-a0e40655223bfd70","content":[{"type":"tool_use","id":"chatcmpl-tool-9b907bba02e7357a","name":"Write","input":{"file_path":"/workspace/tests/test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport request from 'supertest';\nimport { WebSocket } from 'ws';\nimport { createApp } from '../src/server.js';\nimport { applyOp, applyOps, transform, transformAgainstHistory, type Op } from '../src/ot.js';\n\n// ---- OT Unit Tests ----\n\ndescribe('OT: applyOp', () => {\n  it('applies insert at beginning', () => {\n    expect(applyOp('world', { type: 'insert', pos: 0, text: 'hello ' })).toBe('hello world');\n  });\n\n  it('applies insert at end', () => {\n    expect(applyOp('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');\n  });\n\n  it('applies insert in middle', () => {\n    expect(applyOp('hllo', { type: 'insert', pos: 1, text: 'e' })).toBe('hello');\n  });\n\n  it('applies delete at beginning', () => {\n    expect(applyOp('hello world', { type: 'delete', pos: 0, length: 6 })).toBe('world');\n  });\n\n  it('applies delete at end', () => {\n    expect(applyOp('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');\n  });\n\n  it('applies delete in middle', () => {\n    expect(applyOp('hello world', { type: 'delete', pos: 5, length: 1 })).toBe('helloworld');\n  });\n});\n\ndescribe('OT: transform insert/insert', () => {\n  it('shifts right when op2 inserts before op1', () => {\n    const result = transform(\n      { type: 'insert', pos: 5, text: 'B' },\n      { type: 'insert', pos: 2, text: 'A' }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 6, text: 'B' }]);\n  });\n\n  it('no shift when op2 inserts after op1', () => {\n    const result = transform(\n      { type: 'insert', pos: 2, text: 'A' },\n      { type: 'insert', pos: 5, text: 'B' }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 2, text: 'A' }]);\n  });\n\n  it('same position: op2 wins, op1 goes after', () => {\n    const result = transform(\n      { type: 'insert', pos: 3, text: 'B' },\n      { type: 'insert', pos: 3, text: 'A' }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 4, text: 'B' }]);\n  });\n});\n\ndescribe('OT: transform insert/delete', () => {\n  it('insert before delete: no shift', () => {\n    const result = transform(\n      { type: 'insert', pos: 1, text: 'X' },\n      { type: 'delete', pos: 3, length: 2 }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 1, text: 'X' }]);\n  });\n\n  it('insert after delete: shift left', () => {\n    const result = transform(\n      { type: 'insert', pos: 7, text: 'X' },\n      { type: 'delete', pos: 2, length: 3 }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 4, text: 'X' }]);\n  });\n});\n\ndescribe('OT: transform delete/insert', () => {\n  it('delete before insert: no split', () => {\n    const result = transform(\n      { type: 'delete', pos: 1, length: 2 },\n      { type: 'insert', pos: 5, text: 'X' }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 1, length: 2 }]);\n  });\n\n  it('delete after insert: shift right', () => {\n    const result = transform(\n      { type: 'delete', pos: 5, length: 2 },\n      { type: 'insert', pos: 2, text: 'XX' }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 7, length: 2 }]);\n  });\n});\n\ndescribe('OT: transform delete/delete', () => {\n  it('non-overlapping deletes: shift second', () => {\n    const result = transform(\n      { type: 'delete', pos: 6, length: 2 },\n      { type: 'delete', pos: 1, length: 2 }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 4, length: 2 }]);\n  });\n\n  it('second entirely within first: shrink first', () => {\n    const result = transform(\n      { type: 'delete', pos: 1, length: 5 },\n      { type: 'delete', pos: 2, length: 2 }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 1, length: 3 }]);\n  });\n\n  it('first entirely within second: removed', () => {\n    const result = transform(\n      { type: 'delete', pos: 2, length: 2 },\n      { type: 'delete', pos: 1, length: 5 }\n    );\n    expect(result).toEqual([]);\n  });\n});\n\ndescribe('OT: convergence with two clients', () => {\n  it('concurrent inserts converge', () => {\n    const base = 'abc';\n    const op1: Op = { type: 'insert', pos: 1, text: 'X' };\n    const op2: Op = { type: 'insert', pos: 2, text: 'Y' };\n\n    // Client 1 applies op1, then transformed op2\n    const s1 = applyOps(base, [op1, ...transform(op2, op1)]);\n    // Client 2 applies op2, then transformed op1\n    const s2 = applyOps(base, [op2, ...transform(op1, op2)]);\n\n    expect(s1).toBe(s2);\n    expect(s1).toContain('X');\n    expect(s1).toContain('Y');\n  });\n\n  it('concurrent insert and delete converge', () => {\n    const base = 'abcdef';\n    const op1: Op = { type: 'insert', pos: 2, text: 'XY' };\n    const op2: Op = { type: 'delete', pos: 3, length: 2 };\n\n    const s1 = applyOps(base, [op1, ...transform(op2, op1)]);\n    const s2 = applyOps(base, [op2, ...transform(op1, op2)]);\n\n    expect(s1).toBe(s2);\n  });\n});\n\ndescribe('OT: transformAgainstHistory', () => {\n  it('transforms op against empty history', () => {\n    const op: Op = { type: 'insert', pos: 0, text: 'hi' };\n    const result = transformAgainstHistory(op, [], 0);\n    expect(result).toEqual([op]);\n  });\n\n  it('transforms op against single history entry', () => {\n    const history: Op[] = [{ type: 'insert', pos: 0, text: 'ab' }];\n    const op: Op = { type: 'insert', pos: 3, text: 'X' };\n    const result = transformAgainstHistory(op, history, 0);\n    expect(result).toEqual([{ type: 'insert', pos: 5, text: 'X' }]);\n  });\n});\n\n// ---- REST API Tests ----\n\ndescribe('REST API: CRUD', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('creates a document', async () => {\n    const res = await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'Test Doc', content: 'hello' });\n    expect(res.status).toBe(201);\n    expect(res.body.id).toBe('doc1');\n    expect(res.body.title).toBe('Test Doc');\n    expect(res.body.content).toBe('hello');\n  });\n\n  it('rejects creation without id or title', async () => {\n    const res = await request(app.app)\n      .post('/api/documents')\n      .send({ title: 'No ID' });\n    expect(res.status).toBe(400);\n\n    const res2 = await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1' });\n    expect(res2.status).toBe(400);\n  });\n\n  it('rejects duplicate document id', async () => {\n    await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'First' });\n    const res = await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'Second' });\n    expect(res.status).toBe(409);\n  });\n\n  it('gets a document by id', async () => {\n    await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'Test', content: 'hello' });\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.status).toBe(200);\n    expect(res.body.content).toBe('hello');\n  });\n\n  it('returns 404 for missing document', async () => {\n    const res = await request(app.app).get('/api/documents/missing');\n    expect(res.status).toBe(404);\n  });\n\n  it('lists all documents', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'd1', title: 'A' });\n    await request(app.app).post('/api/documents').send({ id: 'd2', title: 'B' });\n    const res = await request(app.app).get('/api/documents');\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(2);\n  });\n\n  it('updates a document', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Old' });\n    const res = await request(app.app)\n      .put('/api/documents/doc1')\n      .send({ title: 'New', content: 'updated' });\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('New');\n    expect(res.body.content).toBe('updated');\n  });\n\n  it('deletes a document', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Del' });\n    const res = await request(app.app).delete('/api/documents/doc1');\n    expect(res.status).toBe(204);\n    const getRes = await request(app.app).get('/api/documents/doc1');\n    expect(getRes.status).toBe(404);\n  });\n\n  it('returns 404 when deleting missing document', async () => {\n    const res = await request(app.app).delete('/api/documents/missing');\n    expect(res.status).toBe(404);\n  });\n});\n\ndescribe('REST API: Version History', () => {\n  let app: ReturnType<typeof createApp>;\n\n  beforeEach(() => {\n    app = createApp();\n    app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('returns empty versions for new document', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test' });\n    const res = await request(app.app).get('/api/documents/doc1/versions');\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(0);\n  });\n\n  it('returns versions after WebSocket edits', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'hello' });\n    const port = (app.app.listen(0).address() as any)?.port;\n    app.app.close();\n\n    // Use the real server port\n    const addr = (app as any);\n    // We'll test versions through WebSocket edits in the WS tests\n    const res = await request(app.app).get('/api/documents/doc1/versions');\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body)).toBe(true);\n  });\n});\n\n// ---- WebSocket Tests ----\n\nfunction wsUrl(port: number, docId: string): string {\n  return `ws://localhost:${port}/ws/${docId}`;\n}\n\nfunction connectWs(port: number, docId: string): Promise<WebSocket> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(wsUrl(port, docId));\n    ws.on('open', () => resolve(ws));\n    ws.on('error', reject);\n    setTimeout(() => reject(new Error('WS connect timeout')), 3000);\n  });\n}\n\nfunction waitForMessage(ws: WebSocket, type?: string, timeout = 3000): Promise<any> {\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => reject(new Error('Message timeout')), timeout);\n    const handler = (data: any) => {\n      try {\n        const msg = JSON.parse(data.toString());\n        if (!type || msg.type === type) {\n          clearTimeout(timer);\n          ws.removeListener('message', handler);\n          resolve(msg);\n        }\n      } catch {\n        // ignore non-JSON\n      }\n    };\n    ws.on('message', handler);\n  });\n}\n\nfunction closeWs(ws: WebSocket): Promise<void> {\n  return new Promise(resolve => {\n    if (ws.readyState === WebSocket.CLOSED) {\n      resolve();\n      return;\n    }\n    ws.on('close', () => resolve());\n    ws.close();\n  });\n}\n\ndescribe('WebSocket: connection lifecycle', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('receives sync message on connect', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'hello' });\n    const ws = await connectWs(port, 'doc1');\n    const msg = await waitForMessage(ws, 'sync');\n    expect(msg.type).toBe('sync');\n    expect(msg.content).toBe('hello');\n    expect(typeof msg.revision).toBe('number');\n    await closeWs(ws);\n  });\n\n  it('rejects connection to missing document', async () => {\n    await expect(connectWs(port, 'nonexistent')).rejects.toThrow();\n  });\n\n  it('receives ack after sending operation', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'insert', pos: 3, text: 'XYZ' },\n      revision: 0,\n    }));\n\n    const ack = await waitForMessage(ws, 'ack');\n    expect(ack.type).toBe('ack');\n    expect(typeof ack.revision).toBe('number');\n    await closeWs(ws);\n  });\n\n  it('broadcasts operations to other clients', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws1 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws2, 'sync');\n\n    ws1.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'insert', pos: 3, text: 'XYZ' },\n      revision: 0,\n    }));\n\n    const broadcast = await waitForMessage(ws2, 'op');\n    expect(broadcast.type).toBe('op');\n    expect(broadcast.ops).toBeDefined();\n    expect(broadcast.ops[0].type).toBe('insert');\n\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('handles disconnection gracefully', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n    await closeWs(ws);\n    // Server should not crash - verify by making another request\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.status).toBe(200);\n  });\n});\n\ndescribe('WebSocket: single client editing', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('inserts text via WebSocket', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'insert', pos: 3, text: 'XYZ' },\n      revision: 0,\n    }));\n    await waitForMessage(ws, 'ack');\n\n    // Verify via REST\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abcXYZ');\n    await closeWs(ws);\n  });\n\n  it('deletes text via WebSocket', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abcdef' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'delete', pos: 3, length: 3 },\n      revision: 0,\n    }));\n    await waitForMessage(ws, 'ack');\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abc');\n    await closeWs(ws);\n  });\n\n  it('handles multiple sequential edits', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: '' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 0, text: 'a' }, revision: 0 }));\n    const ack1 = await waitForMessage(ws, 'ack');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'b' }, revision: ack1.revision }));\n    const ack2 = await waitForMessage(ws, 'ack');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 2, text: 'c' }, revision: ack2.revision }));\n    await waitForMessage(ws, 'ack');\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abc');\n    await closeWs(ws);\n  });\n});\n\ndescribe('WebSocket: two client convergence', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('concurrent inserts at different positions converge', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abcdef' });\n    const ws1 = await connectWs(port, 'doc1');\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n    await waitForMessage(ws2, 'sync');\n\n    // Both send inserts at revision 0\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 2, text: '1' }, revision: 0 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 4, text: '2' }, revision: 0 }));\n\n    // Wait for acks and broadcasts\n    await waitForMessage(ws1, 'ack');\n    await waitForMessage(ws2, 'ack');\n    await waitForMessage(ws1, 'op');\n    await waitForMessage(ws2, 'op');\n\n    // Both should converge to the same state via REST\n    const res = await request(app.app).get('/api/documents/doc1');\n    const content = res.body.content;\n    expect(content).toContain('1');\n    expect(content).toContain('2');\n    // Both inserts should be present\n    expect(content.length).toBe(8); // 6 original + 2 inserts\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('concurrent insert and delete converge', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abcdef' });\n    const ws1 = await connectWs(port, 'doc1');\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n    await waitForMessage(ws2, 'sync');\n\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 2, text: 'XX' }, revision: 0 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 3, length: 2 }, revision: 0 }));\n\n    await waitForMessage(ws1, 'ack');\n    await waitForMessage(ws2, 'ack');\n    // May get broadcast messages\n    try { await waitForMessage(ws1, 'op', 1000); } catch { /* might have already processed */ }\n    try { await waitForMessage(ws2, 'op', 1000); } catch { /* might have already processed */ }\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toContain('XX');\n    // de should be deleted\n    expect(res.body.content).not.toContain('de');\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('concurrent inserts at same position both preserved', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'ab' });\n    const ws1 = await connectWs(port, 'doc1');\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n    await waitForMessage(ws2, 'sync');\n\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'X' }, revision: 0 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'Y' }, revision: 0 }));\n\n    await waitForMessage(ws1, 'ack');\n    await waitForMessage(ws2, 'ack');\n    try { await waitForMessage(ws1, 'op', 1000); } catch { /* */ }\n    try { await waitForMessage(ws2, 'op', 1000); } catch { /* */ }\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toContain('X');\n    expect(res.body.content).toContain('Y');\n    expect(res.body.content.length).toBe(4); // ab + X + Y\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n});\n\ndescribe('WebSocket: stress test with 10 concurrent clients', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('10 clients editing simultaneously converge to consistent state', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Stress', content: '' });\n    const clients: WebSocket[] = [];\n\n    // Connect 10 clients\n    for (let i = 0; i < 10; i++) {\n      const ws = await connectWs(port, 'doc1');\n      await waitForMessage(ws, 'sync');\n      clients.push(ws);\n    }\n\n    // Each client sends an insert at position 0 with their index\n    for (let i = 0; i < 10; i++) {\n      clients[i].send(JSON.stringify({\n        type: 'op',\n        op: { type: 'insert', pos: 0, text: String(i) },\n        revision: 0,\n      }));\n    }\n\n    // Wait for all acks and broadcasts to settle\n    await new Promise(resolve => setTimeout(resolve, 2000));\n\n    // Verify via REST\n    const res = await request(app.app).get('/api/documents/doc1');\n    const content = res.body.content;\n\n    // All 10 characters should be present\n    expect(content.length).toBe(10);\n    for (let i = 0; i < 10; i++) {\n      expect(content).toContain(String(i));\n    }\n\n    for (const ws of clients) {\n      await closeWs(ws);\n    }\n  });\n\n  it('10 clients insert at different positions without corruption', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Stress', content: 'abcdefghij' });\n    const clients: WebSocket[] = [];\n\n    for (let i = 0; i < 10; i++) {\n      const ws = await connectWs(port, 'doc1');\n      await waitForMessage(ws, 'sync');\n      clients.push(ws);\n    }\n\n    // Each client inserts at a different position\n    for (let i = 0; i < 10; i++) {\n      clients[i].send(JSON.stringify({\n        type: 'op',\n        op: { type: 'insert', pos: i, text: String(i) },\n        revision: 0,\n      }));\n    }\n\n    await new Promise(resolve => setTimeout(resolve, 2000));\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    const content = res.body.content;\n    // All inserts should be present\n    for (let i = 0; i < 10; i++) {\n      expect(content).toContain(String(i));\n    }\n\n    for (const ws of clients) {\n      await closeWs(ws);\n    }\n  });\n});\n\ndescribe('WebSocket: error handling', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('rejects invalid JSON', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send('not json');\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('Invalid JSON');\n    await closeWs(ws);\n  });\n\n  it('rejects unknown message type', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'unknown' }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('Unknown message type');\n    await closeWs(ws);\n  });\n\n  it('rejects invalid operation format', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'bad' } }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('Unknown operation type');\n    await closeWs(ws);\n  });\n\n  it('rejects insert with out-of-bounds position', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 100, text: 'X' }, revision: 0 }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('out of bounds');\n    await closeWs(ws);\n  });\n\n  it('rejects delete with out-of-bounds position', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 100, length: 1 }, revision: 0 }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('out of bounds');\n    await closeWs(ws);\n  });\n});\n\ndescribe('Persistence', () => {\n  it('documents survive server restart', async () => {\n    const dbPath = `/tmp/test-persist-${Date.now()}.db`;\n    const app1 = createApp(dbPath);\n    app1.start(0);\n\n    await request(app1.app).post('/api/documents').send({ id: 'doc1', title: 'Persistent', content: 'survived' });\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    app2.start(0);\n\n    const res = await request(app2.app).get('/api/documents/doc1');\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Persistent');\n    expect(res.body.content).toBe('survived');\n\n    await app2.stop();\n  });\n\n  it('WebSocket edits persist across restart', async () => {\n    const dbPath = `/tmp/test-ws-persist-${Date.now()}.db`;\n    const app1 = createApp(dbPath);\n    const port1 = app1.start(0);\n\n    await request(app1.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port1, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 3, text: 'XYZ' }, revision: 0 }));\n    await waitForMessage(ws, 'ack');\n    await closeWs(ws);\n\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    app2.start(0);\n\n    const res = await request(app2.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abcXYZ');\n\n    await app2.stop();\n  });\n});\n"}}],"model":"zai-org/GLM-5.1-FP8","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":23744,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b0ad31f0-ad1a-4424-81c3-6607eb9e5527","uuid":"7c4c1aea-d872-4e1c-886f-55b749a28ba9"}
+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"chatcmpl-tool-9b907bba02e7357a","type":"tool_result","content":"File created successfully at: /workspace/tests/test.ts"}]},"parent_tool_use_id":null,"session_id":"b0ad31f0-ad1a-4424-81c3-6607eb9e5527","uuid":"e123dc31-15e0-4434-97eb-43554a763ffe","tool_use_result":{"type":"create","filePath":"/workspace/tests/test.ts","content":"import { describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport request from 'supertest';\nimport { WebSocket } from 'ws';\nimport { createApp } from '../src/server.js';\nimport { applyOp, applyOps, transform, transformAgainstHistory, type Op } from '../src/ot.js';\n\n// ---- OT Unit Tests ----\n\ndescribe('OT: applyOp', () => {\n  it('applies insert at beginning', () => {\n    expect(applyOp('world', { type: 'insert', pos: 0, text: 'hello ' })).toBe('hello world');\n  });\n\n  it('applies insert at end', () => {\n    expect(applyOp('hello', { type: 'insert', pos: 5, text: ' world' })).toBe('hello world');\n  });\n\n  it('applies insert in middle', () => {\n    expect(applyOp('hllo', { type: 'insert', pos: 1, text: 'e' })).toBe('hello');\n  });\n\n  it('applies delete at beginning', () => {\n    expect(applyOp('hello world', { type: 'delete', pos: 0, length: 6 })).toBe('world');\n  });\n\n  it('applies delete at end', () => {\n    expect(applyOp('hello world', { type: 'delete', pos: 5, length: 6 })).toBe('hello');\n  });\n\n  it('applies delete in middle', () => {\n    expect(applyOp('hello world', { type: 'delete', pos: 5, length: 1 })).toBe('helloworld');\n  });\n});\n\ndescribe('OT: transform insert/insert', () => {\n  it('shifts right when op2 inserts before op1', () => {\n    const result = transform(\n      { type: 'insert', pos: 5, text: 'B' },\n      { type: 'insert', pos: 2, text: 'A' }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 6, text: 'B' }]);\n  });\n\n  it('no shift when op2 inserts after op1', () => {\n    const result = transform(\n      { type: 'insert', pos: 2, text: 'A' },\n      { type: 'insert', pos: 5, text: 'B' }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 2, text: 'A' }]);\n  });\n\n  it('same position: op2 wins, op1 goes after', () => {\n    const result = transform(\n      { type: 'insert', pos: 3, text: 'B' },\n      { type: 'insert', pos: 3, text: 'A' }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 4, text: 'B' }]);\n  });\n});\n\ndescribe('OT: transform insert/delete', () => {\n  it('insert before delete: no shift', () => {\n    const result = transform(\n      { type: 'insert', pos: 1, text: 'X' },\n      { type: 'delete', pos: 3, length: 2 }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 1, text: 'X' }]);\n  });\n\n  it('insert after delete: shift left', () => {\n    const result = transform(\n      { type: 'insert', pos: 7, text: 'X' },\n      { type: 'delete', pos: 2, length: 3 }\n    );\n    expect(result).toEqual([{ type: 'insert', pos: 4, text: 'X' }]);\n  });\n});\n\ndescribe('OT: transform delete/insert', () => {\n  it('delete before insert: no split', () => {\n    const result = transform(\n      { type: 'delete', pos: 1, length: 2 },\n      { type: 'insert', pos: 5, text: 'X' }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 1, length: 2 }]);\n  });\n\n  it('delete after insert: shift right', () => {\n    const result = transform(\n      { type: 'delete', pos: 5, length: 2 },\n      { type: 'insert', pos: 2, text: 'XX' }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 7, length: 2 }]);\n  });\n});\n\ndescribe('OT: transform delete/delete', () => {\n  it('non-overlapping deletes: shift second', () => {\n    const result = transform(\n      { type: 'delete', pos: 6, length: 2 },\n      { type: 'delete', pos: 1, length: 2 }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 4, length: 2 }]);\n  });\n\n  it('second entirely within first: shrink first', () => {\n    const result = transform(\n      { type: 'delete', pos: 1, length: 5 },\n      { type: 'delete', pos: 2, length: 2 }\n    );\n    expect(result).toEqual([{ type: 'delete', pos: 1, length: 3 }]);\n  });\n\n  it('first entirely within second: removed', () => {\n    const result = transform(\n      { type: 'delete', pos: 2, length: 2 },\n      { type: 'delete', pos: 1, length: 5 }\n    );\n    expect(result).toEqual([]);\n  });\n});\n\ndescribe('OT: convergence with two clients', () => {\n  it('concurrent inserts converge', () => {\n    const base = 'abc';\n    const op1: Op = { type: 'insert', pos: 1, text: 'X' };\n    const op2: Op = { type: 'insert', pos: 2, text: 'Y' };\n\n    // Client 1 applies op1, then transformed op2\n    const s1 = applyOps(base, [op1, ...transform(op2, op1)]);\n    // Client 2 applies op2, then transformed op1\n    const s2 = applyOps(base, [op2, ...transform(op1, op2)]);\n\n    expect(s1).toBe(s2);\n    expect(s1).toContain('X');\n    expect(s1).toContain('Y');\n  });\n\n  it('concurrent insert and delete converge', () => {\n    const base = 'abcdef';\n    const op1: Op = { type: 'insert', pos: 2, text: 'XY' };\n    const op2: Op = { type: 'delete', pos: 3, length: 2 };\n\n    const s1 = applyOps(base, [op1, ...transform(op2, op1)]);\n    const s2 = applyOps(base, [op2, ...transform(op1, op2)]);\n\n    expect(s1).toBe(s2);\n  });\n});\n\ndescribe('OT: transformAgainstHistory', () => {\n  it('transforms op against empty history', () => {\n    const op: Op = { type: 'insert', pos: 0, text: 'hi' };\n    const result = transformAgainstHistory(op, [], 0);\n    expect(result).toEqual([op]);\n  });\n\n  it('transforms op against single history entry', () => {\n    const history: Op[] = [{ type: 'insert', pos: 0, text: 'ab' }];\n    const op: Op = { type: 'insert', pos: 3, text: 'X' };\n    const result = transformAgainstHistory(op, history, 0);\n    expect(result).toEqual([{ type: 'insert', pos: 5, text: 'X' }]);\n  });\n});\n\n// ---- REST API Tests ----\n\ndescribe('REST API: CRUD', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('creates a document', async () => {\n    const res = await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'Test Doc', content: 'hello' });\n    expect(res.status).toBe(201);\n    expect(res.body.id).toBe('doc1');\n    expect(res.body.title).toBe('Test Doc');\n    expect(res.body.content).toBe('hello');\n  });\n\n  it('rejects creation without id or title', async () => {\n    const res = await request(app.app)\n      .post('/api/documents')\n      .send({ title: 'No ID' });\n    expect(res.status).toBe(400);\n\n    const res2 = await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1' });\n    expect(res2.status).toBe(400);\n  });\n\n  it('rejects duplicate document id', async () => {\n    await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'First' });\n    const res = await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'Second' });\n    expect(res.status).toBe(409);\n  });\n\n  it('gets a document by id', async () => {\n    await request(app.app)\n      .post('/api/documents')\n      .send({ id: 'doc1', title: 'Test', content: 'hello' });\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.status).toBe(200);\n    expect(res.body.content).toBe('hello');\n  });\n\n  it('returns 404 for missing document', async () => {\n    const res = await request(app.app).get('/api/documents/missing');\n    expect(res.status).toBe(404);\n  });\n\n  it('lists all documents', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'd1', title: 'A' });\n    await request(app.app).post('/api/documents').send({ id: 'd2', title: 'B' });\n    const res = await request(app.app).get('/api/documents');\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(2);\n  });\n\n  it('updates a document', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Old' });\n    const res = await request(app.app)\n      .put('/api/documents/doc1')\n      .send({ title: 'New', content: 'updated' });\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('New');\n    expect(res.body.content).toBe('updated');\n  });\n\n  it('deletes a document', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Del' });\n    const res = await request(app.app).delete('/api/documents/doc1');\n    expect(res.status).toBe(204);\n    const getRes = await request(app.app).get('/api/documents/doc1');\n    expect(getRes.status).toBe(404);\n  });\n\n  it('returns 404 when deleting missing document', async () => {\n    const res = await request(app.app).delete('/api/documents/missing');\n    expect(res.status).toBe(404);\n  });\n});\n\ndescribe('REST API: Version History', () => {\n  let app: ReturnType<typeof createApp>;\n\n  beforeEach(() => {\n    app = createApp();\n    app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('returns empty versions for new document', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test' });\n    const res = await request(app.app).get('/api/documents/doc1/versions');\n    expect(res.status).toBe(200);\n    expect(res.body).toHaveLength(0);\n  });\n\n  it('returns versions after WebSocket edits', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'hello' });\n    const port = (app.app.listen(0).address() as any)?.port;\n    app.app.close();\n\n    // Use the real server port\n    const addr = (app as any);\n    // We'll test versions through WebSocket edits in the WS tests\n    const res = await request(app.app).get('/api/documents/doc1/versions');\n    expect(res.status).toBe(200);\n    expect(Array.isArray(res.body)).toBe(true);\n  });\n});\n\n// ---- WebSocket Tests ----\n\nfunction wsUrl(port: number, docId: string): string {\n  return `ws://localhost:${port}/ws/${docId}`;\n}\n\nfunction connectWs(port: number, docId: string): Promise<WebSocket> {\n  return new Promise((resolve, reject) => {\n    const ws = new WebSocket(wsUrl(port, docId));\n    ws.on('open', () => resolve(ws));\n    ws.on('error', reject);\n    setTimeout(() => reject(new Error('WS connect timeout')), 3000);\n  });\n}\n\nfunction waitForMessage(ws: WebSocket, type?: string, timeout = 3000): Promise<any> {\n  return new Promise((resolve, reject) => {\n    const timer = setTimeout(() => reject(new Error('Message timeout')), timeout);\n    const handler = (data: any) => {\n      try {\n        const msg = JSON.parse(data.toString());\n        if (!type || msg.type === type) {\n          clearTimeout(timer);\n          ws.removeListener('message', handler);\n          resolve(msg);\n        }\n      } catch {\n        // ignore non-JSON\n      }\n    };\n    ws.on('message', handler);\n  });\n}\n\nfunction closeWs(ws: WebSocket): Promise<void> {\n  return new Promise(resolve => {\n    if (ws.readyState === WebSocket.CLOSED) {\n      resolve();\n      return;\n    }\n    ws.on('close', () => resolve());\n    ws.close();\n  });\n}\n\ndescribe('WebSocket: connection lifecycle', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('receives sync message on connect', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'hello' });\n    const ws = await connectWs(port, 'doc1');\n    const msg = await waitForMessage(ws, 'sync');\n    expect(msg.type).toBe('sync');\n    expect(msg.content).toBe('hello');\n    expect(typeof msg.revision).toBe('number');\n    await closeWs(ws);\n  });\n\n  it('rejects connection to missing document', async () => {\n    await expect(connectWs(port, 'nonexistent')).rejects.toThrow();\n  });\n\n  it('receives ack after sending operation', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'insert', pos: 3, text: 'XYZ' },\n      revision: 0,\n    }));\n\n    const ack = await waitForMessage(ws, 'ack');\n    expect(ack.type).toBe('ack');\n    expect(typeof ack.revision).toBe('number');\n    await closeWs(ws);\n  });\n\n  it('broadcasts operations to other clients', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws1 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws2, 'sync');\n\n    ws1.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'insert', pos: 3, text: 'XYZ' },\n      revision: 0,\n    }));\n\n    const broadcast = await waitForMessage(ws2, 'op');\n    expect(broadcast.type).toBe('op');\n    expect(broadcast.ops).toBeDefined();\n    expect(broadcast.ops[0].type).toBe('insert');\n\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('handles disconnection gracefully', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n    await closeWs(ws);\n    // Server should not crash - verify by making another request\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.status).toBe(200);\n  });\n});\n\ndescribe('WebSocket: single client editing', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('inserts text via WebSocket', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'insert', pos: 3, text: 'XYZ' },\n      revision: 0,\n    }));\n    await waitForMessage(ws, 'ack');\n\n    // Verify via REST\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abcXYZ');\n    await closeWs(ws);\n  });\n\n  it('deletes text via WebSocket', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abcdef' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({\n      type: 'op',\n      op: { type: 'delete', pos: 3, length: 3 },\n      revision: 0,\n    }));\n    await waitForMessage(ws, 'ack');\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abc');\n    await closeWs(ws);\n  });\n\n  it('handles multiple sequential edits', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: '' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 0, text: 'a' }, revision: 0 }));\n    const ack1 = await waitForMessage(ws, 'ack');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'b' }, revision: ack1.revision }));\n    const ack2 = await waitForMessage(ws, 'ack');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 2, text: 'c' }, revision: ack2.revision }));\n    await waitForMessage(ws, 'ack');\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abc');\n    await closeWs(ws);\n  });\n});\n\ndescribe('WebSocket: two client convergence', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('concurrent inserts at different positions converge', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abcdef' });\n    const ws1 = await connectWs(port, 'doc1');\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n    await waitForMessage(ws2, 'sync');\n\n    // Both send inserts at revision 0\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 2, text: '1' }, revision: 0 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 4, text: '2' }, revision: 0 }));\n\n    // Wait for acks and broadcasts\n    await waitForMessage(ws1, 'ack');\n    await waitForMessage(ws2, 'ack');\n    await waitForMessage(ws1, 'op');\n    await waitForMessage(ws2, 'op');\n\n    // Both should converge to the same state via REST\n    const res = await request(app.app).get('/api/documents/doc1');\n    const content = res.body.content;\n    expect(content).toContain('1');\n    expect(content).toContain('2');\n    // Both inserts should be present\n    expect(content.length).toBe(8); // 6 original + 2 inserts\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('concurrent insert and delete converge', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abcdef' });\n    const ws1 = await connectWs(port, 'doc1');\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n    await waitForMessage(ws2, 'sync');\n\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 2, text: 'XX' }, revision: 0 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 3, length: 2 }, revision: 0 }));\n\n    await waitForMessage(ws1, 'ack');\n    await waitForMessage(ws2, 'ack');\n    // May get broadcast messages\n    try { await waitForMessage(ws1, 'op', 1000); } catch { /* might have already processed */ }\n    try { await waitForMessage(ws2, 'op', 1000); } catch { /* might have already processed */ }\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toContain('XX');\n    // de should be deleted\n    expect(res.body.content).not.toContain('de');\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n\n  it('concurrent inserts at same position both preserved', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'ab' });\n    const ws1 = await connectWs(port, 'doc1');\n    const ws2 = await connectWs(port, 'doc1');\n    await waitForMessage(ws1, 'sync');\n    await waitForMessage(ws2, 'sync');\n\n    ws1.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'X' }, revision: 0 }));\n    ws2.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 1, text: 'Y' }, revision: 0 }));\n\n    await waitForMessage(ws1, 'ack');\n    await waitForMessage(ws2, 'ack');\n    try { await waitForMessage(ws1, 'op', 1000); } catch { /* */ }\n    try { await waitForMessage(ws2, 'op', 1000); } catch { /* */ }\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    expect(res.body.content).toContain('X');\n    expect(res.body.content).toContain('Y');\n    expect(res.body.content.length).toBe(4); // ab + X + Y\n    await closeWs(ws1);\n    await closeWs(ws2);\n  });\n});\n\ndescribe('WebSocket: stress test with 10 concurrent clients', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('10 clients editing simultaneously converge to consistent state', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Stress', content: '' });\n    const clients: WebSocket[] = [];\n\n    // Connect 10 clients\n    for (let i = 0; i < 10; i++) {\n      const ws = await connectWs(port, 'doc1');\n      await waitForMessage(ws, 'sync');\n      clients.push(ws);\n    }\n\n    // Each client sends an insert at position 0 with their index\n    for (let i = 0; i < 10; i++) {\n      clients[i].send(JSON.stringify({\n        type: 'op',\n        op: { type: 'insert', pos: 0, text: String(i) },\n        revision: 0,\n      }));\n    }\n\n    // Wait for all acks and broadcasts to settle\n    await new Promise(resolve => setTimeout(resolve, 2000));\n\n    // Verify via REST\n    const res = await request(app.app).get('/api/documents/doc1');\n    const content = res.body.content;\n\n    // All 10 characters should be present\n    expect(content.length).toBe(10);\n    for (let i = 0; i < 10; i++) {\n      expect(content).toContain(String(i));\n    }\n\n    for (const ws of clients) {\n      await closeWs(ws);\n    }\n  });\n\n  it('10 clients insert at different positions without corruption', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Stress', content: 'abcdefghij' });\n    const clients: WebSocket[] = [];\n\n    for (let i = 0; i < 10; i++) {\n      const ws = await connectWs(port, 'doc1');\n      await waitForMessage(ws, 'sync');\n      clients.push(ws);\n    }\n\n    // Each client inserts at a different position\n    for (let i = 0; i < 10; i++) {\n      clients[i].send(JSON.stringify({\n        type: 'op',\n        op: { type: 'insert', pos: i, text: String(i) },\n        revision: 0,\n      }));\n    }\n\n    await new Promise(resolve => setTimeout(resolve, 2000));\n\n    const res = await request(app.app).get('/api/documents/doc1');\n    const content = res.body.content;\n    // All inserts should be present\n    for (let i = 0; i < 10; i++) {\n      expect(content).toContain(String(i));\n    }\n\n    for (const ws of clients) {\n      await closeWs(ws);\n    }\n  });\n});\n\ndescribe('WebSocket: error handling', () => {\n  let app: ReturnType<typeof createApp>;\n  let port: number;\n\n  beforeEach(() => {\n    app = createApp();\n    port = app.start(0);\n  });\n\n  afterEach(async () => {\n    await app.stop();\n  });\n\n  it('rejects invalid JSON', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send('not json');\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('Invalid JSON');\n    await closeWs(ws);\n  });\n\n  it('rejects unknown message type', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'unknown' }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('Unknown message type');\n    await closeWs(ws);\n  });\n\n  it('rejects invalid operation format', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'bad' } }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('Unknown operation type');\n    await closeWs(ws);\n  });\n\n  it('rejects insert with out-of-bounds position', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 100, text: 'X' }, revision: 0 }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('out of bounds');\n    await closeWs(ws);\n  });\n\n  it('rejects delete with out-of-bounds position', async () => {\n    await request(app.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'delete', pos: 100, length: 1 }, revision: 0 }));\n    const errMsg = await waitForMessage(ws, 'error');\n    expect(errMsg.type).toBe('error');\n    expect(errMsg.message).toContain('out of bounds');\n    await closeWs(ws);\n  });\n});\n\ndescribe('Persistence', () => {\n  it('documents survive server restart', async () => {\n    const dbPath = `/tmp/test-persist-${Date.now()}.db`;\n    const app1 = createApp(dbPath);\n    app1.start(0);\n\n    await request(app1.app).post('/api/documents').send({ id: 'doc1', title: 'Persistent', content: 'survived' });\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    app2.start(0);\n\n    const res = await request(app2.app).get('/api/documents/doc1');\n    expect(res.status).toBe(200);\n    expect(res.body.title).toBe('Persistent');\n    expect(res.body.content).toBe('survived');\n\n    await app2.stop();\n  });\n\n  it('WebSocket edits persist across restart', async () => {\n    const dbPath = `/tmp/test-ws-persist-${Date.now()}.db`;\n    const app1 = createApp(dbPath);\n    const port1 = app1.start(0);\n\n    await request(app1.app).post('/api/documents').send({ id: 'doc1', title: 'Test', content: 'abc' });\n    const ws = await connectWs(port1, 'doc1');\n    await waitForMessage(ws, 'sync');\n\n    ws.send(JSON.stringify({ type: 'op', op: { type: 'insert', pos: 3, text: 'XYZ' }, revision: 0 }));\n    await waitForMessage(ws, 'ack');\n    await closeWs(ws);\n\n    await app1.stop();\n\n    const app2 = createApp(dbPath);\n    app2.start(0);\n\n    const res = await request(app2.app).get('/api/documents/doc1');\n    expect(res.body.content).toBe('abcXYZ');\n\n    await app2.stop();\n  });\n});\n","structuredPatch":[],"originalFile":null}}
