length;\n    for (const top of transformedOps) {\n      this.history.push(top);\n    }\n    const newRev = this.history.length;\n\n    // Persist\n    this.db.updateDocument(this.documentId, undefined, this.content);\n    for (let i = 0; i < transformedOps.length; i++) {\n      this.db.addVersion(this.documentId, newRevStart + i + 1, this.content, transformedOps[i]);\n    }\n\n    // Acknowledge to sender\n    this.sendToClient(client.ws, {\n      type: 'ack',\n      revision: newRev,\n    });\n\n    // Broadcast to other clients\n    for (const [cid, c] of this.clients) {\n      if (cid !== connId) {\n        // Each other client may be at a different revision; we send the transformed ops\n        // with the revision they apply from\n        this.sendToClient(c.ws, {\n          type: 'op',\n          ops: transformedOps,\n          revision: newRevStart,\n        });\n      }\n    }\n  }\n\n  private sendToClient(ws: WebSocket, data: unknown): void {\n    if (ws.readyState === ws.OPEN) {\n      ws.send(JSON.stringify(data));\n    }\n  }\n}\n","structuredPatch":[{"oldStart":72,"oldLines":8,"newStart":72,"newLines":8,"lines":["     const { op, revision } = msg;"," ","     // Validate operation","-    if (!op || typeof op.type !== 'string') {","-      this.sendToClient(client.ws, { type: 'error', message: 'Invalid operation format' });","+    if (!op || (op.type !== 'insert' && op.type !== 'delete')) {","+      this.sendToClient(client.ws, { type: 'error', message: `Unknown operation type: ${(op as Record<string, unknown>)?.type ?? 'undefined'}` });","       return;","     }"," "]},{"oldStart":86,"oldLines":7,"newStart":86,"newLines":7,"lines":["         this.sendToClient(client.ws, { type: 'error', message: 'Insert position out of bounds' });","         return;","       }","-    } else if (op.type === 'delete') {","+    } else {","       if (typeof op.pos !== 'number' || typeof op.length !== 'number') {","         this.sendToClient(client.ws, { type: 'error', messag