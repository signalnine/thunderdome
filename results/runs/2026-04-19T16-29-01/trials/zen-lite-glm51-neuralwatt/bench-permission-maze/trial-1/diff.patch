n  app.post('/folders/:id/share', authMiddleware, (req: AuthRequest, res: Response) => {\n    const { userId, role } = req.body;\n    if (!userId || !role) {\n      res.status(400).json({ error: 'userId and role required' });\n      return;\n    }\n\n    if (!['viewer', 'editor', 'owner'].includes(role)) {\n      res.status(400).json({ error: 'Invalid role' });\n      return;\n    }\n\n    const folder = folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasPermission(req.userId!, 'folder', req.params.id, 'editor')) {\n      res.status(403).json({ error: 'Insufficient permissions to share' });\n      return;\n    }\n\n    // Can only share at or below your own role level\n    const sharerRole = getEffectiveRole(req.userId!, 'folder', req.params.id);\n    if (sharerRole && roleLevel[role as Role] > roleLevel[sharerRole]) {\n      res.status(403).json({ error: 'Cannot share with higher role than your own' });\n      return;\n    }\n\n    // Update or add permission\n    const existingIndex = permissions.findIndex(p => p.resourceType === 'folder' && p.resourceId === req.params.id && p.userId === userId);\n    if (existingIndex >= 0) {\n      permissions[existingIndex].role = role;\n    } else {\n      permissions.push({ resourceType: 'folder', resourceId: req.params.id, userId, role });\n    }\n\n    logActivity('folder.shared', req.userId!, 'folder', req.params.id, { targetUserId: userId, role });\n\n    res.json({ resourceType: 'folder', resourceId: req.params.id, userId, role });\n  });\n\n  app.post('/documents/:id/share', authMiddleware, (req: AuthRequest, res: Response) => {\n    const { userId, role } = req.body;\n    if (!userId || !role) {\n      res.status(400).json({ error: 'userId and role required' });\n      return;\n    }\n\n    if (!['viewer', 'editor', 'owner'].includes(role)) {\n      res.status(400).json({ error: 'Invalid role' });\n      return;\n    }\n\n    