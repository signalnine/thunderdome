[];\nlet idCounter = 0;\n\nfunction generateId(): string {\n  return String(++idCounter);\n}\n\n// Role hierarchy\nconst roleLevel: Record<Role, number> = {\n  viewer: 1,\n  editor: 2,\n  owner: 3,\n};\n\nfunction getEffectiveRole(userId: string, resourceType: 'folder' | 'document', resourceId: string): Role | null {\n  let bestRole: Role | null = null;\n\n  // Check direct permissions on the resource\n  for (const perm of permissions) {\n    if (perm.resourceType === resourceType && perm.resourceId === resourceId && perm.userId === userId) {\n      if (!bestRole || roleLevel[perm.role] > roleLevel[bestRole]) {\n        bestRole = perm.role;\n      }\n    }\n  }\n\n  // Check inherited permissions from parent folder\n  if (resourceType === 'document') {\n    const doc = documents.get(resourceId);\n    if (doc) {\n      const folderRole = getEffectiveRole(userId, 'folder', doc.folderId);\n      if (folderRole && (!bestRole || roleLevel[folderRole] > roleLevel[bestRole])) {\n        bestRole = folderRole;\n      }\n    }\n  } else if (resourceType === 'folder') {\n    const folder = folders.get(resourceId);\n    if (folder && folder.parentId) {\n      const parentRole = getEffectiveRole(userId, 'folder', folder.parentId);\n      if (parentRole && (!bestRole || roleLevel[parentRole] > roleLevel[bestRole])) {\n        bestRole = parentRole;\n      }\n    }\n  }\n\n  return bestRole;\n}\n\nfunction hasPermission(userId: string, resourceType: 'folder' | 'document', resourceId: string, requiredRole: Role): boolean {\n  const effectiveRole = getEffectiveRole(userId, resourceType, resourceId);\n  if (!effectiveRole) return false;\n  return roleLevel[effectiveRole] >= roleLevel[requiredRole];\n}\n\nfunction logActivity(action: string, userId: string, resourceType: string, resourceId: string, details?: Record<string, unknown>) {\n  activityLog.push({\n    id: generateId(),\n    action,\n    userId,\n    resourceType,\n    resourceId,\n    timestamp: new Date().toISOString(),\n    details,\n  });\n}\n\n// Auth middleware\ninterface AuthRequest extends Request {\n  userId?: string;\n}\n\nfunction authMiddleware(req: AuthRequest, res: Response, next: NextFunction) {\n  const authHeader = req.headers.authorization;\n  if (!authHeader || !authHeader.startsWith('Bearer ')) {\n    res.status(401).json({ error: 'Authentication required' });\n    return;\n  }\n\n  const token = authHeader.substring(7);\n  const userId = tokens.get(token);\n  if (!userId) {\n    res.status(401).json({ error: 'Invalid token' });\n    return;\n  }\n\n  req.userId = userId;\n  next();\n}\n\n// Reset function for testing\nexport function resetStores() {\n  users = new Map();\n  tokens = new Map();\n  folders = new Map();\n  documents = new Map();\n  permissions = [];\n  activityLog = [];\n  idCounter = 0;\n}\n\nexport function createApp() {\n  const app = express();\n  app.use(express.json());\n\n  // Auth routes\n  app.post('/auth/register', (req: AuthRequest, res: Response) => {\n    const { username, password } = req.body;\n    if (!username || !password) {\n      res.status(400).json({ error: 'Username and password required' });\n      return;\n    }\n\n    // Check if username exists\n    for (const user of users.values()) {\n      if (user.username === username) {\n        res.status(409).json({ error: 'Username already exists' });\n        return;\n      }\n    }\n\n    const id = generateId();\n    const user: User = { id, username, password };\n    users.set(id, user);\n\n    const token = generateId();\n    tokens.set(token, id);\n\n    res.status(201).json({ user: { id, username }, token });\n  });\n\n  app.post('/auth/login', (req: AuthRequest, res: Response) => {\n    const { username, password } = req.body;\n    if (!username || !password) {\n      res.status(400).json({ error: 'Username and password required' });\n      return;\n    }\n\n    let foundUser: User | null = null;\n    for (const user of users.values()) {\n      if (user.username === username && user.password === password) {\n        foundUser = user;\n        break;\n      }\n    }\n\n    if (!foundUser) {\n      res.status(401).json({ error: 'Invalid credentials' });\n      return;\n    }\n\n    const token = generateId();\n    tokens.set(token, foundUser.id);\n\n    res.json({ user: { id: foundUser.id, username: foundUser.username }, token });\n  });\n\n  // Folder routes\n  app.post('/folders', authMiddleware, (req: AuthRequest, res: Response) => {\n    const { name, parentId } = req.body;\n    if (!name) {\n      res.status(400).json({ error: 'Folder name required' });\n      return;\n    }\n\n    if (parentId) {\n      const parent = folders.get(parentId);\n      if (!parent) {\n        res.status(404).json({ error: 'Parent folder not found' });\n        return;\n      }\n      // Check write access to parent\n      if (!hasPermission(req.userId!, 'folder', parentId, 'editor')) {\n        res.status(403).json({ error: 'Insufficient permissions' });\n        return;\n      }\n    }\n\n    const id = generateId();\n    const now = new Date().toISOString();\n    const folder: Folder = { id, name, parentId: parentId || null, createdBy: req.userId!, createdAt: now, updatedAt: now };\n    folders.set(id, folder);\n\n    // Creator is automatically owner\n    permissions.push({ resourceType: 'folder', resourceId: id, userId: req.userId!, role: 'owner' });\n\n    logActivity('folder.created', req.userId!, 'folder', id, { name, parentId });\n\n    res.status(201).json({ folder });\n  });\n\n  app.get('/folders/:id', authMiddleware, (req: AuthRequest, res: Response) => {\n    const folder = folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasPermission(req.userId!, 'folder', req.params.id, 'viewer')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    // Include children\n    const childFolders = [...folders.values()].filter(f => f.parentId === folder.id);\n    const childDocuments = [...documents.values()].filter(d => d.folderId === folder.id);\n\n    res.json({ folder, childFolders, childDocuments });\n  });\n\n  app.put('/folders/:id', authMiddleware, (req: AuthRequest, res: Response) => {\n    const folder = folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasPermission(req.userId!, 'folder', req.params.id, 'editor')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    const { name, parentId } = req.body;\n    if (name !== undefined) folder.name = name;\n    if (parentId !== undefined) {\n      if (parentId !== null) {\n        const parent = folders.get(parentId);\n        if (!parent) {\n          res.status(404).json({ error: 'Parent folder not found' });\n          return;\n        }\n      }\n      folder.parentId = parentId;\n    }\n    folder.updatedAt = new Date().toISOString();\n\n    logActivity('folder.updated', req.userId!, 'folder', folder.id, { name, parentId });\n\n    res.json({ folder });\n  });\n\n  app.delete('/folders/:id', authMiddleware, (req: AuthRequest, res: Response) => {\n    const folder = folders.get(req.params.id);\n    if (!folder) {\n      res.status(404).json({ error: 'Folder not found' });\n      return;\n    }\n\n    if (!hasPermission(req.userId!, 'folder', req.params.id, 'owner')) {\n      res.status(403).json({ error: 'Insufficient permissions' });\n      return;\n    }\n\n    // Cascade delete\n    deleteFolderRecursive(folder.id, req.userId!);\n\n    res.status(204).send();\n  });\n\n  function deleteFolderRecursive(folderId: string, userId: string) {\n    // Delete child folders\n    const childFolders = [...folders.values()].filter(f => f.parentId === folderId);\n    for (const child of childFolders) {\n      deleteFolderRecursive(child.id, userId);\n    }\n\n    // Delete documents in this folder